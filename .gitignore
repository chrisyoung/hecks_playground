# Training artifacts — live on Modal, not in git
*.safetensors
__pycache__/
summer/target/
hecks_playground_conception/summer/__pycache__/
hecks_playground_conception/autumn/.wrangler/
hecks_playground_conception/.wrangler/
hecks_playground_conception/information/.*.pid
hecks_playground_conception/.DS_Store

# Worker build dir — generated by `storehouse compile`. No source
# under it ; src/embedded.rs is regenerated, build/ + .wrangler/ +
# node_modules/ are all tooling output.
rust/worker/

# Daemon PID files — process IDs, not state. Always ephemeral.
hecks_playground_conception/information/.mindstream.pid
hecks_playground_conception/information/.*.pid

# Runtime sidecars created by status_coherence.sh — tick-cadence baseline
# (cached per-render to detect non-monotonic cycle jumps) and append-only
# violation log. Both are regenerated at runtime; never committed.
hecks_playground_conception/information/.coherence.log
hecks_playground_conception/information/.tick_baseline


# ── Miette's lived state — moved to a private miette-state repo ──
# See hecks_playground_conception/information/README.md. inbox.heki is the
# public exception — framework dev notes referenced by the paper.
# i142 Tier 2 — heki paths now context-prefixed (information/<ctx>/<agg>.heki)
# so the rules cover both flat (legacy) and context-prefixed forms.
hecks_playground_conception/information/*.heki
hecks_playground_conception/information/**/*.heki
!hecks_playground_conception/information/inbox.heki
!hecks_playground_conception/information/inbox/inbox.heki
!hecks_playground_conception/information/inbox/inbox_archive.heki
!hecks_playground_conception/information/exempt_registry.heki
!hecks_playground_conception/information/antibody/exempt_registry.heki
!hecks_playground_conception/information/subcommand.heki
!hecks_playground_conception/information/subcommand_registry/subcommand.heki
hecks_playground_conception/information/.prev_consciousness_state
hecks_playground_conception/information/.dream_seeded
hecks_playground_conception/information/.daydream.last
hecks_playground_conception/information/.mindstream.pid
hecks_playground_conception/information/.last_dispatch
hecks_playground_conception/information/Attention/
hecks_playground_conception/information/Intention/
hecks_playground_conception/information/Perception/
hecks_playground_conception/information/Sensation/
hecks_playground_conception/information/WordClassifier/
hecks_playground_conception/information/inbox.md

# Heki snapshots — auto-created backups before destructive heki ops
# (delete/mark/migration). Users can clean them manually.
.heki-snapshots/

# Boot capability runner runtime artifact — Boot aggregate state
# rewritten on each boot. Mirrors how runtime .heki under information/
# is already excluded above.
hecks_playground_conception/capabilities/boot/data/

# Governance runtime sqlite store (i-gov) — runtime state, not source
hecks_playground_conception/aggregates/framework/governance/data/

# Runtime dispatch store (bin-buddy.db, web_debug/, .last_dispatch) — runtime state, not source
hecks_playground_conception/data/

# Runtime heki stores under aggregates (per-domain .heki dirs) — runtime state, not source.
hecks_playground_conception/aggregates/**/.heki/

# Same thing, un-dotted : the storehouse door's FileTool/ShellTool audit
# trail and any Heki-persisted aggregate write a plain `data/` dir next
# to `bluebook/`, not `.heki/` — the rule above never matched it (caught
# committing test_automation/data/ by accident, i759). Runtime state,
# never source, wherever it appears under aggregates.
hecks_playground_conception/aggregates/**/data/
hecks_playground_conception/drafting/
hecks_playground_conception/clients/

# Exploratory / parked scratch — not source, kept local (Chris, 2026-06-18).
.parked/
hecks_playground_conception/spikes/

# Example-app runtime stores — the .heki dirs an example writes when it is RUN
# (pizzas, workshop_demo, …). Runtime state, never source.
examples/*/data/
.DS_Store
rust/hecks_playground_conception/
