#!/usr/bin/env bash
# adapter-host — the ONE shared, generic standalone-adapter host.
#
# Hexagonal ports-and-adapters : the core (storehouse runtime) owns the ports ;
# this host runs OUTSIDE it, as a separate process, and speaks ONLY the public
# door — the query port (OutboundEvent.pending) and the command port (dispatch).
# It is generic : parameterised by an adapter name + a thin handler command, it
# reimplements NO subscribe/dispatch plumbing per adapter. Many adapters (Stripe,
# email, ...) are just different handlers plugged into this one loop.
#
# The loop (the standalone-adapter contract, OutboundEvent.bluebook):
#   1. poll     OutboundEvent.pending(adapter)        — the durable event-out port
#   2. claim    OutboundEvent.Claim                   — at-least-once guard
#   3. handle   $HANDLER <payload-on-stdin>           — the async charge, OFF-CORE
#               exit 0 -> success verdict ; non-zero -> failure verdict.
#               Retries / timeout / backoff live HERE or in the handler, never
#               in the core — non-blocking by construction.
#   4. dispatch <success_command|failure_command> id=<source_id>  — verdict re-entry
#   5. ack      OutboundEvent.MarkDelivered           — close the delivery
#
# Usage: adapter-host <root> <adapter> [--once]
#   The handler is resolved DECLARATIVELY from <root>/<adapter>.adapter's
#   `handler "..."` line — no CLI arg. Which binary IS this adapter lives in
#   the bluebook, not the invocation.
#   STOREHOUSE=/path/to/storehouse  POLL_INTERVAL=2  (env overrides)
set -euo pipefail

ROOT="${1:?usage: adapter-host <root> <adapter> [--once]}"
ADAPTER="${2:?adapter name required}"
ONCE="${3:-}"
SH="${STOREHOUSE:-storehouse}"

# Resolve the handler DECLARATIVELY from the adapter's *.adapter file. Find it
# ANYWHERE under ROOT by the declared adapter name (nested bluebook trees like
# miette's body/dream/, not just a flat $ROOT/<name>.adapter) — the file layout
# is the domain's business, the host only needs the declaration.
ADAPTER_FILE=$(grep -rlF "Hecks.adapter \"$ADAPTER\"" "$ROOT" --include='*.adapter' 2>/dev/null | head -1)
[ -n "$ADAPTER_FILE" ] || { echo "[adapter-host] no *.adapter under $ROOT declares adapter \"$ADAPTER\"" >&2; exit 1; }
HANDLER=$("$SH" dump-hecksagon "$ADAPTER_FILE" | jq -r '.adapters[0].handler // empty')

# Fail LOUD. An empty handler would make bash exec "" (exit 127) and silently
# take the FAILURE branch — every delivery would fail while the host looked
# healthy. A non-executable handler is the same class of silent-wrong. Refuse
# to poll until the declaration is real.
[ -n "$HANDLER" ] || { echo "[adapter-host] adapter '$ADAPTER' declares no handler (handler \"...\") in $ADAPTER_FILE" >&2; exit 1; }
# A relative handler path is resolved against ROOT (the bluebook tree), not cwd.
case "$HANDLER" in /*) ;; *) HANDLER="$ROOT/$HANDLER" ;; esac
[ -x "$HANDLER" ] || { echo "[adapter-host] handler '$HANDLER' for '$ADAPTER' is not executable (cwd $PWD)" >&2; exit 1; }

process_one() {
  local d="$1" did src success failure payload verdict
  did=$(echo "$d"      | jq -r .delivery_id)
  src=$(echo "$d"      | jq -r .source_id)
  success=$(echo "$d"  | jq -r .success_command)
  failure=$(echo "$d"  | jq -r .failure_command)
  payload=$(echo "$d"  | jq -r .payload)

  "$SH" "$ROOT" OutboundEvent::OutboundEvent.Claim delivery_id="$did" >/dev/null

  # The thin handler does the impure async work. Its STDOUT is the verdict DATA
  # (key=value lines, e.g. payment_ref=ch_x) that the verdict command carries ;
  # its EXIT CODE picks the branch. Discrimination + data both live off-core, in
  # the adapter, exactly as designed.
  # The handler may need to read live domain state (e.g. an LLM handler reading
  # the Seed aggregate) or .world config — it reaches back through the SAME
  # public door, so pass it the root + the storehouse binary by env. It still
  # gets the event payload on stdin ; ADAPTER_ROOT/STOREHOUSE are how it queries.
  local data
  if data=$(echo "$payload" | ADAPTER_ROOT="$ROOT" STOREHOUSE="$SH" ADAPTER_NAME="$ADAPTER" "$HANDLER"); then verdict="$success"; else verdict="$failure"; fi

  # Thread the handler's stdout as verdict attrs. Each LINE is one k=v whose
  # value may contain spaces (an LLM `reading=`, a multi-word note) — so read
  # line-by-line into an array and pass each as ONE quoted arg, never word-split.
  local verdict_args=()
  while IFS= read -r line; do [ -n "$line" ] && verdict_args+=("$line"); done <<< "$data"
  "$SH" "$ROOT" "$verdict" id="$src" "${verdict_args[@]}" >/dev/null
  "$SH" "$ROOT" OutboundEvent::OutboundEvent.MarkDelivered delivery_id="$did" >/dev/null
  echo "[adapter-host] $ADAPTER : $did -> $verdict ${data:+($data)}"
}

poll() {
  local result state
  result=$("$SH" query "$ROOT" OutboundEvent::OutboundEvent.pending adapter="$ADAPTER")
  state=$(echo "$result" | jq -c '.state // empty')
  [ -z "$state" ] && return 0
  [ "$state" = "[]" ] && return 0
  if echo "$state" | jq -e 'type == "array"' >/dev/null; then
    echo "$state" | jq -c '.[]' | while read -r d; do process_one "$d"; done
  else
    process_one "$state"
  fi
}

if [ "$ONCE" = "--once" ]; then
  poll
else
  while true; do poll; sleep "${POLL_INTERVAL:-2}"; done
fi
