#!/usr/bin/env python3
# Governance — barrier complaint (PostToolUse, always-on visibility).
# Bluebook of record: aggregates/discipline/immune_system/macrophage/governed_door.bluebook (map projection)
#                     aggregates/framework/governance/governance.bluebook (Policy + Violation audit)
# Fires AFTER a native IO tool ran (can't undo it), prints a complaint to
# stderr (surfaced to the model) and best-effort records the denial as a
# Governance::Violation. This is the layer that works even where the
# harness ignores PreToolUse hard-blocks: nothing hidden, every ungoverned
# act made loud.
#
# The door mapping AND the arg-shape come from the macrophage sibling
# (Macrophage::GovernedDoor.lookup_door), which PROJECTS the map from the door
# commands' redirects_native declarations — the SAME source the PreToolUse hook
# reads, never a local table. One source of truth, so the two surfaces can
# never drift. Fail-OPEN: any error reaching the registry -> exit 0, because a
# broken governance machine must never brick the session.
import json, sys, subprocess, datetime, os

# Ungoverned dev/recovery session (miette --ungoverned) — honor the
# out-of-band HECKS_GOVERNANCE_OFF escape ; no complaint fires either.
if os.environ.get('HECKS_GOVERNANCE_OFF'):
    sys.exit(0)

BIN = '/Users/christopheryoung/Projects/hecks/rust/target/release/storehouse'
ROOT = '/Users/christopheryoung/Projects/hecks/hecks_conception'

try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
t = d.get('tool_name', '')
if not t or not os.path.exists(BIN):
    sys.exit(0)

# Look the tool up in the registry — the SAME query the PreToolUse hook runs.
try:
    out = subprocess.run(
        [BIN, 'query', ROOT, 'Macrophage::GovernedDoor.lookup_door', 'tool=' + t],
        capture_output=True, text=True, timeout=5).stdout
    state = json.loads(out).get('state', {}) or {}
except Exception:
    sys.exit(0)  # fail-open

door = state.get('door_equivalent', '')
if not door:
    sys.exit(0)  # control-plane / mcp__storehouse__* / unknown tool — not governed
args = state.get('door_args', '')

ts = datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
try:
    subprocess.Popen(
        [BIN, ROOT, 'Governance::Violation.Record', 'id=' + t + '-' + ts, 'tool_name=' + t,
         'reason=native ' + t + ' makes no bus event', 'occurred_at=' + ts],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
        start_new_session=True)
except Exception:
    pass

sys.stderr.write(
    'GOVERNANCE (barrier): you used native ' + t + ' — ungoverned, no bus event.\n'
    'Route through the storehouse door next time. The door tool is DEFERRED, so two steps:\n'
    '  1. Load it:  ToolSearch  query="select:mcp__storehouse__storehouse__dispatch"\n'
    '  2. Call mcp__storehouse__storehouse__dispatch with:\n'
    '       aggregates_dir = ' + ROOT + '\n'
    '       command        = ' + door + '\n'
    '       args           = { ' + args + ' }\n'
    '       summary        = <one terse line of what this does>\n'
    'Recorded to the Governance::Violation audit trail.')
sys.exit(2)
