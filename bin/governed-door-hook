#!/usr/bin/env bash
# Governance — the BARRIER (the skin). PreToolUse HARD-BLOCK of ungoverned
# native tools. The synchronous, pre-act first line of defense ; upstream of
# the asynchronous immune cells (macrophage/fibroblast) that only respond
# AFTER a breach.
# Bluebook of record :
#   hecks_conception/aggregates/discipline/immune_system/macrophage/governed_door.bluebook (the map projection + denial audit)
#
# A native IO tool (Bash/Edit/Write/Read/Grep/Glob/MultiEdit/NotebookEdit/
# WebFetch/WebSearch) emits NO bus event -> the act is ungoverned, invisible to
# the dispatch log, outside the Transparency vow. This PreToolUse hook looks up
# the door equivalent via Macrophage::GovernedDoor.lookup_door (the macrophage
# sibling that PROJECTS the native->door map from the door commands'
# redirects_native declarations) and, when one exists, RECORDS the denial as
# a Macrophage::GovernedDoor record AND hard-blocks (exit 2).
# Control-plane tools (Agent/Task/advisor/AskUserQuestion/ToolSearch) and
# mcp__storehouse__* return no door -> allowed (exit 0). They orchestrate; they
# do not act on the world.
#
# FAIL MODE : fail OPEN. When the redirect registry is UNREACHABLE (the lookup
# query errors), the hook ALLOWS the call rather than blocking — a wedged
# governance machine must never brick the session. (The deny-by-default Policy
# that once made this configurable is retired ; authorization-at-the-door is
# being conceived as the inbound Gate.)
#
# Admin escape (OPERATIONAL, out-of-band): launch claude with
#   HECKS_GOVERNANCE_OFF=1
# to disable all blocking — for an upgrade that needs native tools, or recovery.
# Re-lock by restarting without it. There is no in-band allowlist; the governed
# agent cannot disable its own governance mid-session.
# REPOINTED (hecksagain cutover, 2026-08-11, Chris's explicit sign-off):
# was the retired Rust `storehouse` binary's `query ... lookup_door`
# call ; hecksagain-cli has a dedicated `governed-door` subcommand for
# exactly this (a flat {door, door_equivalent, door_args} JSON answer,
# no `..` recursive-descent needed the way the old nested query shape
# did — kept it anyway, harmless on a flat object, one less thing to
# get wrong swapping binaries). The Record dispatch below now needs the
# explicit `dispatch` keyword hecksagain-cli requires (the old binary
# defaulted to it when the second positional arg wasn't a known
# subcommand).
[ -n "$HECKS_GOVERNANCE_OFF" ] && exit 0
tool=$(jq -r '.tool_name // empty' 2>/dev/null || true)
[ -z "$tool" ] && exit 0
SH=/Users/christopheryoung/Projects/hecks/hecksagain_runtime/bin/hecksagain-cli
ROOT=/Users/christopheryoung/Projects/hecks/hecks_conception
result=$("$SH" governed-door "$ROOT" "$tool" 2>/dev/null)
qexit=$?
door=$(echo "$result" | jq -r '.. | .door_equivalent? // empty' 2>/dev/null | head -1 || true)
args=$(echo "$result" | jq -r '(.. | .door_args? // empty) | if type=="array" then join(", ") else . end' 2>/dev/null | head -1 || true)
if [ -n "$door" ]; then
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  "$SH" dispatch "$ROOT" Macrophage::GovernedDoor.Record id="$tool-$ts" tool_name="$tool" door="$door" reason="native $tool makes no bus event" occurred_at="$ts" >/dev/null 2>&1 || true
  {
    echo "GOVERNANCE (barrier): native $tool makes no bus event — it is ungoverned."
    echo "Route through the storehouse door. The door tool is DEFERRED, so two steps:"
    echo "  1. Load it:  ToolSearch  query=\"select:mcp__storehouse__storehouse__dispatch\""
    echo "  2. Call mcp__storehouse__storehouse__dispatch with:"
    echo "       aggregates_dir = $ROOT"
    echo "       command        = $door"
    echo "       args           = { $args }"
    echo "       summary        = <one terse line of what this does>"
    echo "Every act a bus event."
  } >&2
  exit 2
fi
# No door : either the tool is ungoverned (query OK, empty state) or the registry
# was unreachable (query errored). Either way, fail OPEN — allow — so a wedged
# governance machine never bricks the session. (qexit is intentionally unused.)
exit 0
