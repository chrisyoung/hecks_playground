#!/usr/bin/env python3
# Macrophage — GovernedDoor enforcement (PreToolUse hard block).
# Bluebook of record: aggregates/discipline/immune_system/macrophage/macrophage.bluebook
# A native IO tool emits no bus event, so it cannot be governed. Block it with
# exit code 2 (the hard PreToolUse block; stderr is surfaced to the model) and
# redirect to the storehouse door equivalent. Deny-LIST: only the IO tools that
# have door equivalents are blocked; control-plane tools (Agent, Task*, advisor,
# AskUserQuestion, ToolSearch) and mcp__storehouse__* pass through untouched.
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
t = d.get('tool_name', '')
door = {
    'Bash': 'Tools::ShellTool.Bash',
    'Edit': 'Tools::FileTool.Edit',
    'Write': 'Tools::FileTool.Update (or ShellTool.Bash heredoc)',
    'Read': 'Tools::FileTool.Read',
    'MultiEdit': 'Tools::FileTool.Edit',
    'NotebookEdit': 'Tools::FileTool.Edit',
    'Grep': 'Tools::SearchTool.Grep',
    'Glob': 'Tools::SearchTool.Glob',
    'WebFetch': 'Tools::WebTool.WebFetch',
    'WebSearch': 'Tools::WebTool.WebSearch',
}
if t in door:
    sys.stderr.write(
        'GOVERNANCE (macrophage): native ' + t + ' makes no bus event — it is '
        'ungoverned and BLOCKED. Route through the storehouse door: '
        'mcp__storehouse__storehouse__dispatch with command=' + door[t] + '. '
        'Every act a bus event.')
    sys.exit(2)
sys.exit(0)
