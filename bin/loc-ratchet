#!/usr/bin/env ruby
# loc-ratchet — gate each counted tree (CONCERN) by its DIRECTION.
#
# The concerns are no longer hard-coded here. They live in a
# bluebook — hecks_conception/aggregates/discipline/loc_ratchet/
# loc_ratchet.bluebook (the Concern aggregate) seeded by its sibling
# loc_ratchet.fixtures. The gate that enforces bluebook-first is now
# itself bluebook-configured : "split it by concern" done bluebook-
# first. Each Concern carries :
#
#   name        stable slug (e.g. core_runtime)
#   path        repo-relative tree anchor (e.g. rust/src)
#   extensions  comma-separated, no dots (e.g. rs)
#   direction   shrink | hold | grow
#   baseline    optional pinned floor ("" = compare against base ref)
#
# Direction is the per-concern pressure on the delta (head - base) :
#   shrink — delta may not increase (delta > 0 fails)  ← today's rule
#   hold   — delta must stay equal  (delta != 0 fails)
#   grow   — increases allowed       (positive delta never fails)
#
# ── Classification : longest-prefix-match wins ──
#
# Concerns are DISJOINT. A scanned file belongs to the concern whose
# `path` is the LONGEST matching prefix of its own path. So with
# core_runtime (rust/src, shrink) and codegen (rust/src/specializer,
# grow), a specializer .rs lands in CODEGEN — it carves itself out of
# core_runtime by being a longer anchor. That is the root-cause fix
# for codegen tripping the ratchet : specializer emitters are
# mechanical projections of bluebook shapes (codegen/*_shape/*.bluebook
# is the contract), so emitter Rust must not fight the shrink gate.
#
# ── Reading the concerns ──
#
# The script reads the Concern fixtures via the storehouse binary,
# naming a DOMAIN rather than a path :
#   storehouse dump-fixtures --domain LocRatchet --corpus <repo>  → JSON
# The fixtures file IS the source of truth ; dump-fixtures is the
# IR-aware read of it (the behaviors runner reads the same file for
# the ListConcerns spec). Asking by DOMAIN keeps bluebook layout out of
# this script entirely — the corpus is the only thing entitled to know
# where a domain's files live, and moving them can no longer strand the
# gate. If the binary is missing, no .fixtures file declares the domain,
# the dump fails to parse, or it yields no Concern records, the script
# FALLS BACK to the historical hard-coded concerns so the gate never
# silently no-ops on a fresh clone. Fallback is announced on stderr.
#
# In a worktree without a built binary, point HECKS_BIN at the main
# checkout's storehouse (rust/target/release/storehouse) — that is the
# worktree-development read path.
#
# An i122 `ir_claimed?` skip still drops files the corpus claims (a
# hecksagon adapter / specializer dispatches them) from the count, and
# a [loc-ratchet-override: <reason>] commit marker still authorises
# ANY concern's failure. The marker is honoured from committed branch
# messages (git log base..HEAD) AND — via --message-file — from the
# in-flight commit message at commit-msg time, so the marker-carrying
# commit can authorise itself (bootstrap fix, 2026-07-02).
#
# Usage:
#   bin/loc-ratchet --base origin/main
#   bin/loc-ratchet --base origin/main --verbose
#
# Exit codes:
#   0  every concern satisfies its direction (or override present)
#   1  some concern violated its direction without an override
#   2  git / filesystem error during counting

require "optparse"
require "open3"
require "json"

# Paths the ratchet IGNORES even under the counted trees. Tests don't
# count toward deletion pressure (discipline, not runtime) ; vendor /
# target / node_modules are build artefacts.
IGNORED_SEGMENTS = %w[
  tests/
  /target/
  /node_modules/
  /vendor/
].freeze

# The historical hard-coded concerns — the fallback set used when the
# bluebook-seeded concerns can't be read. Preserves pre-bluebook
# behavior exactly : rust/src .rs and hecks_conception .sh, both shrink.
FALLBACK_CONCERNS = [
  { "name" => "core_runtime", "path" => "rust/src",         "extensions" => "rs", "direction" => "shrink", "baseline" => "" },
  { "name" => "shell",        "path" => "hecks_conception", "extensions" => "sh", "direction" => "shrink", "baseline" => "" },
].freeze

# The DOMAIN whose Concern fixtures configure this gate, and the corpus root
# to resolve it against. This script does NOT know where that domain's files
# live — `dump-fixtures --domain` asks the corpus, which is the only thing
# entitled to know bluebook layout.
#
# It used to hard-code the full path. When the tree moved under it (domains
# conformed to a `bluebook/` subdir), the path silently went stale and the
# gate fell back to its hard-coded concerns on every run — for long enough
# that the declared fixtures drifted to the OPPOSITE of what they documented
# without anyone noticing, because nothing was reading them. A stale path
# cannot fail loudly. An unresolvable DOMAIN NAME can, and does.
CONCERN_DOMAIN = "LocRatchet"
REPO_ROOT      = File.expand_path("..", __dir__)

# Locate the storehouse binary — same lookup the i122 ir_claimed? path
# uses. Reused here to ALSO read the Concern fixtures via dump-fixtures.
# Without it we fall back to counting every file under the hard-coded
# concerns (preserves pre-i122 behavior on a fresh clone).
STOREHOUSE_BIN = [
  ENV["HECKS_BIN"],
  File.expand_path("../rust/target/release/storehouse", __dir__),
  File.expand_path("../rust/target/debug/storehouse",   __dir__),
].compact.find { |p| File.executable?(p) }

def run(cmd)
  out, _, status = Open3.capture3(*cmd)
  [out.strip, status.success?]
end

def ignored?(path)
  IGNORED_SEGMENTS.any? { |seg| path.include?(seg) }
end

def fallback(reason)
  warn "loc-ratchet: falling back to hard-coded concerns — #{reason}"
  FALLBACK_CONCERNS
end

# Read the seeded concerns from the bluebook fixtures via the IR.
# Returns the FALLBACK_CONCERNS (announced on stderr) on any failure so
# the gate never silently no-ops. Normalises baseline to "" when absent.
def load_concerns
  return fallback("no storehouse binary (set HECKS_BIN?)") if STOREHOUSE_BIN.nil?

  out, ok = run(
    [STOREHOUSE_BIN, "dump-fixtures", "--domain", CONCERN_DOMAIN, "--corpus", REPO_ROOT]
  )
  return fallback("no .fixtures file declares domain #{CONCERN_DOMAIN}") unless ok

  parsed = begin
    JSON.parse(out)
  rescue JSON::ParserError
    nil
  end
  return fallback("dump-fixtures output was not valid JSON") if parsed.nil?

  concerns = (parsed["fixtures"] || [])
             .select { |f| f["aggregate"] == "Concern" }
             .map { |f| f["attrs"] || {} }
             .map { |a| a.merge("baseline" => a.fetch("baseline", "")) }
  return fallback("no Concern records in fixtures") if concerns.empty?
  concerns
end

# Memo cache : file path → boolean. The CLI is fast (~5ms/call) but a
# full run touches hundreds of files across two treeish snapshots ;
# caching cuts that in half (same path appears in base and head).
$dispatch_cache = {}

def ir_claimed?(path)
  return false unless STOREHOUSE_BIN
  return $dispatch_cache[path] if $dispatch_cache.key?(path)
  _out, _err, status = Open3.capture3(STOREHOUSE_BIN, "is-dispatched", path)
  $dispatch_cache[path] = status.exitstatus == 0
end

# Classify a file path into the concern whose `path` is its LONGEST
# matching prefix AND whose extension list includes the file's ext.
# Returns the concern's name, or nil if no concern claims the file.
def concern_for(path, concerns)
  ext = File.extname(path).delete_prefix(".").downcase
  candidates = concerns.select do |c|
    exts = c["extensions"].to_s.split(",").map { |e| e.strip.downcase }
    exts.include?(ext) && path.start_with?("#{c["path"]}/")
  end
  return nil if candidates.empty?
  candidates.max_by { |c| c["path"].length }["name"]
end

# Count non-blank LoC per concern at the given treeish, classifying each
# scanned file by longest-prefix-match. One git ls-tree per distinct
# concern path keeps the walk narrow ; a file is only counted once,
# against its winning concern.
def counts_at(concerns, treeish)
  totals = Hash.new(0)
  seen = {}
  concerns.map { |c| c["path"] }.uniq.each do |tree|
    out, ok = run(["git", "ls-tree", "--name-only", "-r", treeish, "--", tree])
    next unless ok
    out.lines.map(&:strip).reject(&:empty?).each do |path|
      next if seen[path]
      seen[path] = true
      next if ignored?(path)
      name = concern_for(path, concerns)
      next if name.nil?
      next if ir_claimed?(path)
      content, cok = run(["git", "show", "#{treeish}:#{path}"])
      next unless cok
      totals[name] += content.lines.count { |l| !l.strip.empty? }
    end
  end
  totals
end

# WHOSE justification authorises this growth?
#
# With a --message-file (the commit-msg hook, gating ONE commit) the answer is
# THIS COMMIT'S message and nothing else. This used to ALSO scan `base..HEAD`,
# so a single override anywhere on an unmerged branch authorised every later
# commit on it — on a long-lived arc that silently waved through unbounded
# growth of a shrink concern, with nobody ever arguing for it. (Found riding a
# marker written ~10 commits earlier, waving through +568 lines of core_runtime
# across three commits that never mentioned it.) A per-commit gate must judge
# the commit in front of it.
#
# With no message file (CI, judging a whole PR) the RANGE is the unit of work,
# so any commit in the PR may carry the override for the PR's net delta.
def overrides_present?(base_ref, message_file = nil)
  rx = /^\s*\[loc-ratchet-override:\s*[^\]]+\]/i
  if message_file
    return File.exist?(message_file) && File.read(message_file).match?(rx)
  end
  out, ok = run(["git", "log", "--format=%B", "#{base_ref}..HEAD"])
  ok && out.to_s.match?(rx)
end

# Does this concern's delta violate its direction?
#   shrink → delta > 0   hold → delta != 0   grow → never
def violates?(direction, delta)
  case direction
  when "shrink" then delta > 0
  when "hold"   then delta != 0
  when "grow"   then false
  else delta > 0 # unknown direction defaults to shrink — fail closed
  end
end

options = { base: nil, verbose: false, message_file: nil }
OptionParser.new do |opts|
  opts.on("--base REF",   "Base ref to compare HEAD against")        { |v| options[:base] = v }
  opts.on("--verbose",    "Print per-concern counts + directions")    { options[:verbose] = true }
  opts.on("--message-file PATH", "Also honor an override marker in this in-flight commit message") { |v| options[:message_file] = v }
end.parse!

base_ref = options[:base] || "origin/main"
concerns = load_concerns

base = counts_at(concerns, base_ref)
head = counts_at(concerns, "HEAD")

rows = concerns.map do |c|
  name = c["name"]
  b = c["baseline"].to_s.empty? ? base[name] : c["baseline"].to_i
  h = head[name]
  { name: name, dir: c["direction"], base: b, head: h, delta: h - b }
end

if options[:verbose]
  puts "ratchet report (base #{base_ref} vs HEAD) — per concern, gated by direction"
  rows.each do |r|
    flag = violates?(r[:dir], r[:delta]) ? "✗" : "✓"
    puts "  #{flag} #{r[:name].ljust(16)} #{r[:dir].ljust(7)} base=#{r[:base].to_s.rjust(6)} head=#{r[:head].to_s.rjust(6)} delta=#{r[:delta].to_s.rjust(5)}"
  end
end

failures = rows.select { |r| violates?(r[:dir], r[:delta]) }

if failures.empty?
  puts "✓ loc-ratchet: every concern satisfies its direction"
  exit 0
end

if overrides_present?(base_ref, options[:message_file])
  summary = failures.map { |r| "#{r[:name]} (#{r[:dir]} +#{r[:delta]})" }.join(", ")
  puts "✓ loc-ratchet: #{summary} — authorised by [loc-ratchet-override]"
  exit 0
end

puts "✗ loc-ratchet: #{failures.size} concern(s) violated their direction without an override"
failures.each do |r|
  puts "    #{r[:name]} (#{r[:dir]}): base=#{r[:base]} head=#{r[:head]} delta=#{r[:delta]}"
end
puts ""
puts "  Each concern has a direction. A 'shrink' concern may not grow ; a 'hold'"
puts "  concern must stay equal. If this PR legitimately adds non-bluebook code to"
puts "  a shrink/hold concern (e.g. a kernel primitive, a transitional adapter),"
puts "  add a commit on the branch whose message contains"
puts "  [loc-ratchet-override: <concrete reason>]. To let a tree grow by design,"
puts "  set its Concern direction to 'grow' in loc_ratchet.fixtures."
puts ""
puts "  Run bin/loc-ratchet --base #{base_ref} --verbose for per-concern counts."
exit 1
