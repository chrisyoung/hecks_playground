#!/bin/sh
# bin/pr_delivery_merge — spawn-effect-port handler for PrDeliveryMerge
# (i787), re-expressing pr_delivery.hecksagon's 3rd binding — the last of
# the five bare `run "shell cmd"` driven-block leaves i782 surveyed, and
# the one it deliberately left unconverted — onto the proven spawned_by
# mechanism (i780 design, i781/i782 proven E2E).
#
# MUTATING, and the most consequential handler in this corpus: it squash-
# merges a real PR and deletes its branch. `DrivenCapture#run` is a hard
# no-op in the vendored gem, so this command has NEVER actually executed;
# wiring it here turns the automation ON. Converted with Chris's explicit
# sign-off (i782 -> /goal execute 1-3, which named this consequence).
#
# INVOKED BY bin/adapter-host: no CLI args; ADAPTER_ROOT/STOREHOUSE/
# ADAPTER_NAME in env (AGG_ID is NOT set — measured, i782). The triggering
# MergeQueue.MergeStarted payload arrives as clean, VO-unwrapped JSON on
# stdin, carrying `story_ref` (StartMerge declares it and sets :current
# from it) — that is the branch name this builds: sq/<story_ref>.
#
# STDOUT IS STRUCTURED, STDERR IS DIAGNOSTIC — this split is load-bearing,
# not style. adapter-host layers EVERY stdout line matching
# `^[A-Za-z_][A-Za-z0-9_]*=` onto the verdict dispatch as an argument, and
# CommandInterpreter#step_refuse_unknown_arguments refuses any argument the
# target command does not declare. Letting `gh`'s own chatter reach stdout
# would risk injecting a bogus key, refusing the CompleteMerge dispatch,
# and wedging the queue in `state: merging` forever — exactly the failure
# mode this whole conversion exists to avoid. So gh's output goes to
# stderr (adapter-host folds it into `output` on the failure path, which is
# the path where it is the only diagnostic that survives) and stdout
# carries nothing but the one field CompleteMerge needs back.
set -eu

payload=$(cat)
story_ref=$(printf '%s' "$payload" | jq -r '.story_ref // empty')

if [ -z "$story_ref" ]; then
  echo "pr_delivery_merge: no story_ref in triggering event payload" >&2
  exit 2
fi

# Redirected to stderr on BOTH paths (see the stdout/stderr note above).
if gh pr merge "sq/${story_ref}" --squash --delete-branch >&2; then
  # Success only. adapter-host layers handler-supplied fields onto the
  # verdict dispatch exclusively when the exit code is 0, so this line is
  # meaningful on the CompleteMerge path and impossible on the FailMerge
  # one — which is precisely why CompleteMerge/FailMerge declare
  # story_ref `optional: true` (merge_queue.bluebook, i787).
  echo "story_ref=${story_ref}"
else
  code=$?
  echo "pr_delivery_merge: gh pr merge failed for sq/${story_ref} (exit ${code})" >&2
  exit "$code"
fi
