#!/usr/bin/env bash
# seed-subcommand-registry — materialise SubcommandRegistry heki from fixtures.
#
# Reads: cli/subcommand/subcommand.fixtures (the source of truth for all
#   known storehouse subcommands — 30 rows as of i80 Unit D).
# Writes: hecks_conception/information/subcommand_registry/subcommand.heki
#   (the heki store that fn main()'s load_cli_routes() reads at runtime).
#
# This is the fixtures→heki materialiser for i80 Unit D. It replaces the
# stale April-28 heki (39 rows, wrong schema, wrong keys) with the
# authoritative set derived from subcommand.fixtures. Each row is upserted
# with id=<name> so routes.get(command) in main.rs resolves correctly.
#
# Usage:
#   bin/seed-subcommand-registry            # uses HECKS_HOME or ~/Projects/hecks
#   HECKS_HOME=/path/to/hecks bin/seed-subcommand-registry

set -euo pipefail

REPO="${HECKS_HOME:-$HOME/Projects/hecks}"
HEKI="${REPO}/hecks_conception/information/subcommand_registry/subcommand.heki"
REASON="seed SubcommandRegistry from cli/subcommand/subcommand.fixtures (i80 Unit D)"

# Wipe stale heki before re-seeding so no orphaned rows survive.
# The file is regenerated fully from subcommand.fixtures on every run.
[ -f "$HEKI" ] && rm "$HEKI"

upsert() {
  local name="$1" handler="$2" exit_kind="$3" deprecated="$4"
  local dispatch_address="${5:-}"
  storehouse heki upsert "$HEKI" --reason "$REASON" \
    id="$name" name="$name" handler="$handler" \
    exit_kind_default="$exit_kind" deprecated="$deprecated" \
    dispatch_address="$dispatch_address"
}

echo "[seed-subcommand-registry] writing ${HEKI}"

# order 0 — storehouse generic dispatcher (i484)
upsert storehouse          run_storehouse         ok no

# order 1 — hecksagon-driven lexicon query
upsert lexicon             run_lexicon            ok no

# order 2 — interactive terminal
upsert terminal            run_terminal           ok no

# order 3 — four-into-one transitional redirect (speak/status/musings/boot)
upsert transitional_print  run_transitional_print ok yes

# order 4 — heki binary store read/write
upsert heki                run_heki               ok no

# order 5 — generate a new domain from corpus archetypes
upsert conceive            run_conceive           ok no

# order 6 — develop features in an existing domain
upsert develop             run_develop            ok no

# order 7 — conceive behaviors for an existing domain
upsert conceive-behaviors  run_conceive_behaviors ok no

# order 8 — run behaviors / test suite (alias: test)
upsert behaviors           run_behaviors          ok no

# order 9 — universal .behaviors runner (i500 alias for behaviors)
upsert test                run_behaviors          ok no

# order 10 — parse a .fixtures file and emit canonical JSON
upsert dump-fixtures       run_dump_fixtures      ok no

# order 11 — parse a .world file and emit canonical JSON
upsert dump-world          run_dump_world         ok no

# order 12 — parse a .hecksagon file and emit canonical JSON
upsert dump-hecksagon      run_dump_hecksagon     ok no

# order 13 — run the specializer
upsert specialize          run_specialize         ok no

# order 14 — print cascade_emits chains for every aggregate command
upsert cascade             run_cascade            ok no

# order 15 — run check-io validation
upsert check-io            run_check_io           ok no

# order 16 — run check-lifecycle validation
upsert check-lifecycle     run_check_lifecycle    ok no

# order 17 — run check-duplicate-policies validation
upsert check-duplicate-policies run_check_duplicate_policies ok no

# order 18 — run all checks
upsert check-all           run_check_all          ok no

# order 19 — script-mode execution (shebang-run)
upsert run                 run_script             ok no

# order 20 — cadence loop (dispatch_address empty; address comes from argv)
upsert loop                run_loop               ok no

# order 21 — PM-loop daemon (dispatch_address empty; address comes from argv)
upsert run-loop            run_pm_loop            ok no

# order 22 — process-lifecycle daemon (dispatch_address empty; address from argv)
upsert daemon              run_daemon             ok no

# order 23 — PostToolUse antibody listener (canonical name as of i553)
upsert macrophage          run_macrophage         ok no

# order 23b — deprecated alias for macrophage
upsert enforce-edit        run_macrophage         ok yes

# order 24 — statusline capability runner
upsert statusline          run_statusline         ok no

# order 25 — IR-query subcommand
upsert is-dispatched       run_is_dispatched      ok no

# order 26 — wall-clock segment trigger (dispatch_address empty; from argv)
upsert clock               run_clock              ok no

# order 27 — sleep dispatch (dispatch_address empty; dispatches EnterSleep internally)
upsert sleep               run_sleep              ok no

# order 28 — interactive REPL (legacy `run`)
upsert repl                run_repl               ok no

echo "[seed-subcommand-registry] done"
storehouse heki read "$HEKI" 2>/dev/null \
  | python3 -c "import sys,json; d=json.load(sys.stdin); print('[seed-subcommand-registry] rows seeded:', len(d), '| keys:', sorted(d.keys()))"
