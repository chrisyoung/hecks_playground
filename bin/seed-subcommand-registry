#!/usr/bin/env bash
# seed-subcommand-registry — re-assert the SubcommandRegistry catalog.
#
# [antibody-exempt: bin/seed-subcommand-registry — one-line shell glue over
#  the `storehouse establish` verb ; the catalog itself lives as bluebook
#  policy, not in this script.]
#
# fixtures→policies (2026-07-26) : the 30 catalog rows moved from
# subcommand.fixtures into `on "BootCompleted"` establishment policies in
# cli/subcommand/bluebook/subcommand.bluebook (one Establish*Subcommand
# policy per row — Register upserts on :name). This script is now a thin
# wrapper over the boot-establishment keystone verb : it routes
# BootCompleted through the cli/subcommand corpus and PERSISTS the
# establishment writes to the root's world store. Idempotent — run it any
# time to re-assert the catalog.
#
# Bite : rust/tests/subcommand_registry_establishment_test.rs.
#
# Usage:
#   bin/seed-subcommand-registry            # uses HECKS_HOME or ~/Projects/hecks
#   HECKS_HOME=/path/to/hecks bin/seed-subcommand-registry

set -euo pipefail

REPO="${HECKS_HOME:-$HOME/Projects/hecks}"
HECKS="${STOREHOUSE:-$(command -v storehouse || echo "$REPO/rust/target/release/storehouse")}"

if [ ! -x "$HECKS" ]; then
  echo "[seed-subcommand-registry] storehouse not executable at $HECKS" >&2
  exit 2
fi

# The bluebook/ dir is the establish root — subcommand.world (dir :default)
# lives there, and resolve_world_store_dir only probes the root + its parent.
exec "$HECKS" establish "$REPO/cli/subcommand/bluebook"
