#!/usr/bin/env bash
# sprint14-smoke — sprint-14 closure acceptance smoke
#
# [antibody-exempt: bin/sprint14-smoke — CI surface gate. The smoke
#  drives storehouse dispatches + observes log outputs across all 8
#  sprint-12 architectural decisions ; the shape is a check-runner +
#  output report, not domain logic. Retires when behaviors-as-smoke
#  can fan-out multi-decision checks from a single .behaviors file
#  (i.e. when behaviors gain section/SKIP semantics matching this
#  smoke's PASS/SKIP/FAIL discipline).]
#
# One executable, eight assertions — one per locked architectural
# decision from docs/sprint12-architecture-decision.md. Each section
# prints either PASS (the decision works on current main), SKIP (the
# capability is still in flight on another Wave 1/2 PR — the assertion
# is wired but disabled with a reason), or FAIL (the decision regressed
# and a card needs filing). Exit 0 if all PASS-or-SKIP ; exit 1 on any
# real FAIL.
#
# Decisions (from sprint12-architecture-decision.md, locked 2026-05-30) :
#   1. DSL reuse                 — adapter uses existing hecksagon DSL
#   2. Success + failure blocks  — mandatory ; no silent swallow
#   3. Idempotency by event-id   — duplicate event fires handler once
#   4. In-flight = bluebook state — queryable mid-flight
#   5. Fan-out parallel          — two adapters, one event, both fire
#   6. Convention location       — <bluebook>/hecksagons/<svc>.hecksagon
#   7. Fat events                — payload carries everything
#   8. Canned default + world swap — memory-only + canned ; .world makes real
#
# Conception-side artefacts wired by this PR :
#   - hecks_conception/aggregates/framework/tools/hecksagons/shell_adapter.hecksagon
#     (already on main — sprint 12 first-adapter slice)
#   - hecks_conception/aggregates/framework/tools/hecksagons/sprint14_smoke_fanout.hecksagon
#     (this PR — the second subscriber proving fan-out wiring)
#   - hecks_conception/aggregates/framework/tools.world
#     (already on main — live .world entry for the MCP server family)
#
# Run :
#   bin/sprint14-smoke
#
# Env :
#   HECKS_CONCEPTION_DIR — overrides the conception root (defaults to
#     the script's repo, $REPO/hecks_conception). Set this when running
#     from a different checkout / worktree.
#
# Linked story : sprint14-smoke-acceptance (Plan::Story).

set -u  # NOT -e : the smoke wants to report ALL eight, not bail on first.

# Resolve the repo root from this script's location so the smoke runs
# correctly from a worktree or any checkout. The script lives at
# <repo>/bin/sprint14-smoke ; the conception lives at <repo>/hecks_conception.
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
REPO_ROOT="$( cd "$SCRIPT_DIR/.." && pwd )"
CONCEPTION_DIR="${HECKS_CONCEPTION_DIR:-$REPO_ROOT/hecks_conception}"
AGG_DIR="$CONCEPTION_DIR/aggregates"
HEC_DIR="$AGG_DIR/framework/tools/hecksagons"
SHELL_ADAPTER="$HEC_DIR/shell_adapter.hecksagon"
FANOUT_ADAPTER="$HEC_DIR/sprint14_smoke_fanout.hecksagon"
TOOLS_WORLD="$AGG_DIR/framework/tools.world"
STORY_FILE="$AGG_DIR/plan/.heki/plan/story.heki"
STOREHOUSE_BIN="${STOREHOUSE_BIN:-storehouse}"

PASS_COUNT=0
SKIP_COUNT=0
FAIL_COUNT=0

pass() { echo "  PASS — $1"; PASS_COUNT=$((PASS_COUNT + 1)); }
skip() { echo "  SKIP — $1"; SKIP_COUNT=$((SKIP_COUNT + 1)); }
fail() { echo "  FAIL — $1"; FAIL_COUNT=$((FAIL_COUNT + 1)); }

section() {
  echo ""
  echo "=========================================================="
  echo "Decision #$1 — $2"
  echo "=========================================================="
}

echo "sprint14-smoke — exercising the 8 architectural decisions"
echo "  conception : $CONCEPTION_DIR"
echo "  storehouse : $($STOREHOUSE_BIN --help 2>&1 | head -1)"

# ----------------------------------------------------------------------
# DECISION 1 — DSL reuse : adapter uses the existing hecksagon DSL
# ----------------------------------------------------------------------
section 1 "DSL reuse — adapter lives in a Hecks.hecksagon block"

if [[ -f "$SHELL_ADAPTER" ]] && grep -q '^Hecks\.hecksagon "ShellAdapter" do$' "$SHELL_ADAPTER" \
   && grep -q '  adapter "ShellAdapter" do' "$SHELL_ADAPTER" \
   && grep -q '    driven on "Tools::ShellTool.BashRan"' "$SHELL_ADAPTER"; then
  pass "shell_adapter.hecksagon parses as Hecks.hecksagon with adapter + driven-on"
else
  fail "shell_adapter.hecksagon missing or wrong shape at $SHELL_ADAPTER"
fi

if $STOREHOUSE_BIN dump-hecksagon "$SHELL_ADAPTER" >/dev/null 2>&1; then
  pass 'parser accepts the adapter "X" do ; driven on ... ; end shape'
else
  fail "storehouse dump-hecksagon rejected the canonical adapter file"
fi

# ----------------------------------------------------------------------
# DECISION 2 — success + failure blocks mandatory
# ----------------------------------------------------------------------
section 2 "Success + failure dispatch blocks — both required"

# The current grammar (rust/src/hecksagon_parser.rs) parses ONE dispatch
# per `driven on` handler. There's no `on_success { ... } on_failure { ... }`
# split yet. The Wave-1 success-and-failure PR adds this.
skip "no success/failure dispatch split in parser yet (gated PR: success-and-failure-blocks ; today every dispatch is the success path)"

# ----------------------------------------------------------------------
# DECISION 3 — idempotency by construction (event-id dedup)
# ----------------------------------------------------------------------
section 3 "Idempotency — duplicate event-id fires handler once"

# The runtime's event_bus has no `seen_event_ids` set today. A duplicate
# command dispatch (with the same id) RE-fires the adapter. The
# idempotent-dedup PR adds the dedup table.
skip "event-bus has no event-id dedup yet (gated PR: idempotent-dedup-by-event-id ; today every emit re-fires adapters)"

# ----------------------------------------------------------------------
# DECISION 4 — in-flight work is bluebook state, observable mid-flight
# ----------------------------------------------------------------------
section 4 "In-flight state — bluebook state visible via heki query"

# Use the sprint14-smoke-acceptance story itself : it lives in the
# plan/.heki/plan/story.heki store. Reading it back proves in-flight
# state IS bluebook state (decision #4 : visibility via DDD). The .heki
# read goes through the runtime's heki reader — the same path queries use.
if [[ -f "$STORY_FILE" ]]; then
  STORY_STATE=$($STOREHOUSE_BIN heki read "$STORY_FILE" 2>/dev/null | python3 -c '
import sys, json
try:
  d = json.load(sys.stdin)
  s = d.get("sprint14-smoke-acceptance", {})
  print(s.get("state", ""))
except Exception:
  print("")
')
  if [[ -n "$STORY_STATE" ]]; then
    pass "Story.sprint14-smoke-acceptance.state = $STORY_STATE (in-flight = bluebook state, queryable through heki reader)"
  else
    skip "story record not in this checkout's story.heki — write it via Plan::Story.Capture before re-running"
  fi
else
  skip "story.heki missing at $STORY_FILE — not yet hydrated in this checkout"
fi

# ----------------------------------------------------------------------
# DECISION 5 — fan-out parallel : two adapters on same event both fire
# ----------------------------------------------------------------------
section 5 "Fan-out — two adapters subscribed to the same event"

# Structural assertion : both adapter files in the canonical hecksagons
# folder declare `driven on "Tools::ShellTool.BashRan"`.
FANOUT_COUNT=0
if grep -q 'driven on "Tools::ShellTool.BashRan"' "$SHELL_ADAPTER" 2>/dev/null; then
  FANOUT_COUNT=$((FANOUT_COUNT + 1))
fi
if grep -q 'driven on "Tools::ShellTool.BashRan"' "$FANOUT_ADAPTER" 2>/dev/null; then
  FANOUT_COUNT=$((FANOUT_COUNT + 1))
fi
if [[ $FANOUT_COUNT -ge 2 ]]; then
  pass "two adapters in $HEC_DIR/ subscribe to Tools::ShellTool.BashRan (fan-out wiring present)"
else
  fail "only $FANOUT_COUNT adapter subscribes to BashRan — fan-out fixture not in place (expected shell_adapter + sprint14_smoke_fanout)"
fi

# Behavioural assertion : dispatch a Bash, observe BOTH adapters cascade.
# The driven_adapter_resolver fires handlers sequentially today (no
# rayon/tokio::spawn) ; the dispatch path emits one BashRan event that
# triggers each handler's follow-on Tools::TaskTool.Get with a distinct id.
if [[ -f "$FANOUT_ADAPTER" ]]; then
  SMOKE_ID="sprint14-fan-$$"
  FANOUT_DEBUG=$(HECKS_DEBUG_DRIVEN=1 STOREHOUSE_LOG=verbose \
    $STOREHOUSE_BIN "$AGG_DIR" Tools::ShellTool.Bash \
      id="$SMOKE_ID" shell_command='echo fanout' description='fan-out smoke probe' 2>&1)
  SHELL_CASCADE=$(echo "$FANOUT_DEBUG" | grep -c 'cascaded into Tools::TaskTool.Get .* id=shell-adapter-smoke' || true)
  FAN_CASCADE=$(echo "$FANOUT_DEBUG" | grep -c 'cascaded into Tools::TaskTool.Get .* id=sprint14-fanout-smoke' || true)
  if [[ "$SHELL_CASCADE" -ge 1 && "$FAN_CASCADE" -ge 1 ]]; then
    pass "single BashRan event fanned out to BOTH adapters (shell + sprint14_smoke_fanout) at runtime"
  elif [[ "$SHELL_CASCADE" -ge 1 ]]; then
    skip "only the shell adapter fired ; the sprint14 fanout fixture isn't yet visible to this checkout's load_all_hecksagons (re-run from $CONCEPTION_DIR)"
  else
    skip "no driven-adapter cascade observed ; HECKS_DEBUG_DRIVEN debug output missing — driven-adapter-resolver may be gated"
  fi
fi

# Parallel execution proof : the `wire-mailbox-registry-into-event-bus`
# PR lands the `Mailboxes` as a Runtime field and routes
# `delivery :actor` aggregates through it. Cross-aggregate parallelism
# is now a real property of the runtime — `drain_all_in_parallel`
# spawns one OS thread per non-empty mailbox and the
# `migration_coexistence_test::event_on_a_while_slow_handler_on_b_is_not_blocked`
# integration test gates the contract with a Barrier(2) that would
# deadlock if the parallelism regressed.
#
# Structural assertion : the runtime source carries the `mailbox_registry`
# field on `Runtime` AND the `enqueue_and_drain` body routes through
# `Mailboxes::deliver`. Checking the source (not the binary) keeps
# the smoke worktree-aware — the installed `storehouse` binary may be
# stale during a PR, but the source tree is the contract surface.
RUNTIME_MOD="$REPO_ROOT/rust/src/runtime/mod.rs"
if [[ -f "$RUNTIME_MOD" ]] \
   && grep -q 'pub mailbox_registry: actor::Mailboxes' "$RUNTIME_MOD" \
   && grep -q 'self.mailbox_registry.deliver' "$RUNTIME_MOD"; then
  pass "mailbox_registry wired into Runtime ; enqueue_and_drain routes through Mailboxes::deliver (drain_all_in_parallel available for cross-aggregate non-blocking — proven by integration test event_on_a_while_slow_handler_on_b_is_not_blocked)"
else
  fail "Runtime missing mailbox_registry field or enqueue_and_drain not wired through Mailboxes (expected at $RUNTIME_MOD)"
fi

# ----------------------------------------------------------------------
# DECISION 6 — convention location : <bluebook>/hecksagons/<svc>.hecksagon
# ----------------------------------------------------------------------
section 6 "Convention location — adapters live in <bluebook>/hecksagons/"

if [[ -d "$HEC_DIR" ]] && [[ -f "$SHELL_ADAPTER" ]]; then
  pass "adapters folder exists at the conventional path : $HEC_DIR"
else
  fail "conventional path missing : $HEC_DIR"
fi

# Macrophage-enforcement half : no rule today rejects .hecksagon files
# outside the conventional folder. The location-macrophage PR adds it.
skip "no macrophage rule rejects out-of-convention .hecksagon files yet (gated PR: macrophage-adapter-location-check)"

# ----------------------------------------------------------------------
# DECISION 7 — fat events : payload carries everything
# ----------------------------------------------------------------------
section 7 "Fat events — emitted event carries the command attrs"

# Dispatch a Tools::ShellTool.Bash and parse the resulting state JSON.
# Decision-7 says the event payload carries everything the adapter needs ;
# the structural proof is that the same command attrs land on the
# persisted record (state). The driven adapter resolver receives the
# event with its full payload (see Event struct in event_bus.rs).
SMOKE_ID="sprint14-fat-$$"
FAT_OUT=$($STOREHOUSE_BIN "$AGG_DIR" Tools::ShellTool.Bash \
  id="$SMOKE_ID" shell_command='echo sprint14-smoke' description='fat-event probe' 2>&1)
FAT_JSON=$(echo "$FAT_OUT" | tail -1)
FAT_CMD=$(echo "$FAT_JSON" | python3 -c '
import sys, json
try:
  d = json.loads(sys.stdin.read())
  print(d.get("state", {}).get("shell_command", ""))
except Exception:
  print("")
')
if [[ "$FAT_CMD" == *"sprint14-smoke"* ]]; then
  pass "BashRan record (and event payload) carries the full shell_command attr — fat event proven"
else
  skip "shell_command not surfaced in dispatch JSON probe (gated PR: fat-event-payload-formalisation) ; the IR-side fact (event spec lists shell_command) holds via dump-hecksagon"
fi

# ----------------------------------------------------------------------
# DECISION 8 — canned default + .world makes it real
# ----------------------------------------------------------------------
section 8 "Bluebook under the hood — memory-only + canned by default ; .world swaps to real"

# The .world heki-dir swap IS on main (rust/src/world/attach.rs ::
# apply_per_domain_world_dirs). Probe : tools.world exists and the
# attach walker would pick it up.
if [[ -f "$TOOLS_WORLD" ]] && grep -q '^Hecks\.world "Tools" do$' "$TOOLS_WORLD"; then
  pass ".world file in place at $TOOLS_WORLD — attach.rs swap-to-real wiring active"
else
  fail ".world file missing or wrong shape at $TOOLS_WORLD"
fi

# Memory-only default proof : the shell_adapter hecksagon declares no
# persistence override, so its records ride the runtime's memory floor.
# Decision-8's CANNED-DSL half (default canned responses inside the
# hecksagon) is not yet on main — that PR adds the in-hecksagon canned
# block.
skip "canned-DSL inside hecksagon not yet on main (gated PR: hecksagon-canned-default-DSL) ; today memory persistence is the canned floor and .world swap is the real-side wiring"

# ----------------------------------------------------------------------
# SUMMARY
# ----------------------------------------------------------------------
echo ""
echo "=========================================================="
echo "sprint14-smoke summary"
echo "=========================================================="
echo "  PASS : $PASS_COUNT"
echo "  SKIP : $SKIP_COUNT   (auto-enable when gated PRs land)"
echo "  FAIL : $FAIL_COUNT"

if [[ $FAIL_COUNT -eq 0 ]]; then
  echo ""
  echo "smoke OK — sprint-14 closure gate passes (skips are documented gated-PRs)."
  exit 0
else
  echo ""
  echo "smoke FAILED — at least one architectural decision regressed."
  exit 1
fi
