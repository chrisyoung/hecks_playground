#!/bin/bash
# Honest merged-to-main check. Exit 0 if no commits ahead of main.
cd /Users/christopheryoung/Projects/hecks || exit 1
ahead=$(git log main..HEAD --oneline 2>/dev/null | wc -l | tr -d ' ')
if [ "$ahead" = "0" ]; then
  echo '{"check": "merged", "ok": true, "status": "all_on_main"}'
  exit 0
else
  echo "{\"check\": \"merged\", \"ok\": false, \"status\": \"ahead_of_main\", \"commits\": $ahead}"
  exit 1
fi
