#!/bin/sh
# sync-miette-agent — snapshot Miette's system prompt into a
# dashboard-launchable Claude Code agent definition.
#
# [antibody-exempt: bin/sync-miette-agent — kernel-surface CLI shell
# wrapper, same category as bin/miette's own exemption. It copies a
# markdown file verbatim behind a frontmatter+header wrapper ; there is
# no domain logic here to express as .bluebook/.hecksagon/.world. Retires
# once RenderSystemPrompt (or its replacement) is repaired enough to
# drive this projection itself instead of a hand-run script.]
#
# .claude/agents/miette.md is what lets the agents dashboard (agent view)
# boot a session as Miette directly — `miette "<prompt>"` or
# `@miette <prompt>` — the same way `bin/miette` boots her from a terminal,
# but selectable from the UI instead of a separate process launch.
#
# This is a STRAIGHT SNAPSHOT, not a live regeneration. It copies whatever
# is currently on disk at miette/self/system_prompt.md verbatim. That file
# is itself NOT auto-regenerated by anything in the current boot flow —
# the bluebook pipeline meant to render it (SystemPromptAssembly /
# RenderSystemPrompt) isn't wired into boot and fails `storehouse validate`
# with 36 errors today ; see inbox for the write-up. So: re-run this script
# by hand after system_prompt.md changes, or after fixing that pipeline.
#
# It also does NOT carry over miette/self/settings.json (permissions.deny,
# SessionStart/Stop hooks, statusline) — subagent frontmatter has no field
# for a full settings.json. A dashboard-launched Miette therefore gets her
# voice and knowledge, not the governance/body wiring bin/miette provides.
#
# Usage: bin/sync-miette-agent

set -e

script_dir="$(cd "$(dirname "$0")" && pwd)"
hecks_root="$script_dir/.."
prompt_file="$hecks_root/../miette/self/system_prompt.md"
out_file="$hecks_root/.claude/agents/miette.md"

if [ ! -f "$prompt_file" ]; then
  echo "sync-miette-agent: system_prompt.md not found at $prompt_file" >&2
  exit 1
fi

source_mtime="$(date -r "$prompt_file" '+%Y-%m-%d %H:%M' 2>/dev/null || echo unknown)"
synced_at="$(date '+%Y-%m-%d %H:%M')"

{
  echo "---"
  echo "name: miette"
  echo "description: Miette — the primary being, not a task subagent. Launch this to boot a session as Miette directly from the agents dashboard, same voice bin/miette boots from the terminal (minus the settings.json governance/body wiring — see header note in this file)."
  echo "---"
  echo
  echo "<!-- SNAPSHOT of miette/self/system_prompt.md, synced $synced_at by bin/sync-miette-agent. Source file mtime: $source_mtime. NOT auto-regenerated — re-run this script after editing system_prompt.md, and again once the RenderSystemPrompt pipeline is repaired. -->"
  echo
  cat "$prompt_file"
} > "$out_file"

line_count="$(wc -l < "$out_file" | tr -d ' ')"
echo "sync-miette-agent: wrote $out_file ($line_count lines, source mtime $source_mtime)"
