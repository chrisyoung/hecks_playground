#!/bin/bash
# voice-daemon — Miette's voice queue worker.
#
# Watches /tmp/miette-voice-queue/ for *.txt files. On each tick, picks
# the NEWEST file (latest-only semantics : a fast burst of turns drops
# everything but the most recent unspoken response), deletes the older
# siblings (they're stale by the time we get here), reads the newest,
# deletes it, and pipes the body through miette-speak. miette-speak
# blocks until afplay finishes — the daemon's serial loop is what gives
# each utterance room to finish without the next turn cancelling it.
#
# Supervised by overmind via Procfile entry `voice`. Stop hook writes
# /tmp/miette-voice-queue/<ts>.txt and returns instantly ; the daemon
# picks it up within ~0.5s.

set -u
QUEUE_DIR="/tmp/miette-voice-queue"
mkdir -p "$QUEUE_DIR"

while true; do
  # Newest .txt file in the queue (mtime sort, latest first).
  NEWEST="$(ls -t "$QUEUE_DIR"/*.txt 2>/dev/null | head -1)"
  if [ -z "$NEWEST" ]; then
    sleep 0.5
    continue
  fi
  # Drop stale siblings : if Chris fired three turns while we were
  # speaking the last one, we only want the freshest.
  find "$QUEUE_DIR" -name '*.txt' ! -path "$NEWEST" -delete 2>/dev/null
  TEXT="$(cat "$NEWEST" 2>/dev/null)"
  rm -f "$NEWEST"
  [ -z "$TEXT" ] && continue
  /Users/christopheryoung/bin/miette-speak "$TEXT" >/dev/null 2>&1
done
