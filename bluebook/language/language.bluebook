Hecks.bluebook "Language", version: "2026.05.12.1" do
  vision "Grammar as a domain — determine if a word is a verb, noun, adjective without a static list"
  category "capability"

  # ============================================================
  # LANGUAGE
  # ============================================================
  #
  # No verbs.txt. No static lists. The domain understands language
  # by structure, not by lookup.
  #
  # A command name is a verb phrase if:
  #   - It starts with an action word (morphological rules)
  #   - English verbs follow patterns: Create, Add, Start, Remove...
  #   - Verb suffixes: -ate, -ify, -ize, -ise, -mit, -ect, -ude
  #   - Verb prefixes: Re-, Un-, De-, Over-, Out-, Pre-, Post-
  #   - Imperative mood: the command form IS the verb
  #
  # A word is NOT a verb if:
  #   - It ends in -tion, -ment, -ness, -ity (nominalization)
  #   - It ends in -able, -ible, -ous, -ive (adjective)
  #   - It ends in -er, -or, -ist (agent noun)
  #
  # This replaces verbs.txt entirely.

  aggregate "WordClassifier", "Determines if a word is a verb, noun, adjective, or other" do
    value_object "Word" do
      # The word being classified. Surface form — a single token,
      # any case ; the classifier inspects suffix/prefix/structure.
      attribute :value, String
      invariant "must be non-empty" do
        !value.empty?
      end
    end

    value_object "Classification" do
      # Word class label produced by the classifier — typically
      # "verb", "noun", "adjective", or "other". Free-form string ;
      # the meta-bluebook does not enumerate the closed set so the
      # runtime can grow new classes without a bluebook revision.
      attribute :value, String
      invariant "must be non-empty" do
        !value.empty?
      end
    end

    value_object "Confidence" do
      # Likelihood that the classification is correct, 0.0 to 1.0.
      # Morphological matches with multiple corroborating signals
      # score high ; lone suffix matches score low.
      attribute :value, Float
      invariant "must be between 0 and 1" do
        value >= 0.0 && value <= 1.0
      end
    end

    value_object "Reason" do
      # Human-readable explanation of why the word was classified
      # this way — typically the pattern that matched, e.g. "ends
      # in -ate (verb suffix)" or "ends in -tion (nominalization)".
      attribute :value, String
    end

    attribute :word, Word
    attribute :classification, Classification
    attribute :confidence, Confidence
    attribute :reason, Reason

    command "ClassifyWord" do
      role "System"
      description "Determine word class from morphological patterns"
      attribute :word, Word
      emits "WordClassified"
      then_set :word, to: :word
    end
  end

  # === Morphological Rules ===

  aggregate "VerbPattern", "A pattern that identifies verbs by structure" do
    value_object "PatternType" do
      # The kind of morphological signal — "suffix", "prefix",
      # "exact", "compound". Free-form string ; the runtime
      # branches on the kind when matching a candidate word.
      attribute :value, String
      invariant "must be non-empty" do
        !value.empty?
      end
    end

    value_object "Pattern" do
      # The pattern body — the suffix, prefix, or literal word.
      # For "-ate" the value is "ate" ; for "Re-" the value is
      # "Re" ; for "Create" the value is "Create".
      attribute :value, String
      invariant "must be non-empty" do
        !value.empty?
      end
    end

    value_object "Confidence" do
      # How much weight this pattern carries when computing the
      # classifier's overall confidence. Higher means more decisive.
      attribute :value, Float
      invariant "must be between 0 and 1" do
        value >= 0.0 && value <= 1.0
      end
    end

    value_object "Example" do
      # A sample word that matches this pattern, kept for docs and
      # for sanity-checking pattern regressions.
      attribute :value, String
      invariant "must be non-empty" do
        !value.empty?
      end
    end

    attribute :pattern_type, PatternType
    attribute :pattern, Pattern
    attribute :confidence, Confidence
    attribute :examples, list_of(Example)

    command "RegisterPattern" do
      role "System"
      description "Add a morphological pattern for verb detection"
      attribute :pattern_type, PatternType
      attribute :pattern, Pattern
      attribute :confidence, Confidence
      emits "PatternRegistered"
      then_set :pattern_type, to: :pattern_type
      then_set :pattern, to: :pattern
      then_set :confidence, to: :confidence
    end
  end

  # Verb suffixes — high confidence

  # Verb prefixes — boost confidence when combined with other signals

  # Common short verbs — exact match, high confidence

  # Compound verb patterns — PascalCase splits

  # === Non-verb patterns — things that look like verbs but aren't ===

  aggregate "NonVerbPattern", "Patterns that indicate a word is NOT a verb" do
    value_object "PatternType" do
      # The kind of morphological signal — "suffix", "prefix",
      # "exact". Free-form ; the runtime branches on the kind
      # when matching a candidate word.
      attribute :value, String
      invariant "must be non-empty" do
        !value.empty?
      end
    end

    value_object "Pattern" do
      # The pattern body — the suffix, prefix, or literal word
      # that rules out verb classification. e.g. "tion", "ment",
      # "ness".
      attribute :value, String
      invariant "must be non-empty" do
        !value.empty?
      end
    end

    value_object "Indicates" do
      # What part of speech the pattern indicates instead of verb
      # — typically "noun" or "adjective". Used so the classifier
      # can hand back a useful classification, not just "not a verb".
      attribute :value, String
      invariant "must be non-empty" do
        !value.empty?
      end
    end

    attribute :pattern_type, PatternType
    attribute :pattern, Pattern
    attribute :indicates, Indicates

    command "RegisterNonVerb" do
      role "System"
      description "Add a pattern that rules out verb classification"
      attribute :pattern_type, PatternType
      attribute :pattern, Pattern
      attribute :indicates, Indicates
      emits "NonVerbRegistered"
      then_set :pattern_type, to: :pattern_type
      then_set :pattern, to: :pattern
      then_set :indicates, to: :indicates
    end
  end

  # === Command name validation ===

  aggregate "CommandValidator", "Validates that a command name starts with a verb" do
    value_object "CommandName" do
      # The candidate command name being validated — usually a
      # PascalCase phrase like "CreatePizza" or "AddTopping".
      attribute :value, String
      invariant "must be non-empty" do
        !value.empty?
      end
    end

    value_object "IsVerb" do
      # Verdict label — "yes", "no", "ambiguous". Free-form so
      # callers can branch on it without a bluebook revision when
      # new verdicts emerge.
      attribute :value, String
      invariant "must be non-empty" do
        !value.empty?
      end
    end

    value_object "Confidence" do
      # Confidence in the verdict, 0.0 to 1.0. Composed from the
      # patterns that fired plus the non-verb patterns that ruled
      # out alternatives.
      attribute :value, Float
      invariant "must be between 0 and 1" do
        value >= 0.0 && value <= 1.0
      end
    end

    value_object "FirstWord" do
      # The first PascalCase chunk of the command name — the
      # candidate verb. "CreatePizza" → "Create", "AddTopping"
      # → "Add".
      attribute :value, String
      invariant "must be non-empty" do
        !value.empty?
      end
    end

    attribute :command_name, CommandName
    attribute :is_verb, IsVerb
    attribute :confidence, Confidence
    attribute :first_word, FirstWord

    command "ValidateCommandName" do
      role "System"
      description "Check if a command name starts with a verb — using patterns, not a list"
      attribute :command_name, CommandName
      emits "CommandNameValidated"
      then_set :command_name, to: :command_name
    end
  end

  # === Policies ===

  policy "RevalidateOnNonVerb" do
    on "NonVerbRegistered"
    trigger "ValidateCommandName"
  end

  # ============================================================
  # GLOSSARY
  # ============================================================

  glossary do
    define "morphological pattern", as: "A suffix, prefix, or structure that indicates word class"
    define "verb pattern", as: "A pattern that identifies a word as a verb — -ate, -ify, Re-, etc."
    define "non-verb pattern", as: "A pattern that rules out verb classification — -tion, -ment, -ness"
    define "confidence", as: "How likely the classification is correct, 0.0 to 1.0"
    define "compound verb", as: "A PascalCase command name where the first word is the verb"
    prefer "classify", not: ["detect", "parse", "analyze"]
    prefer "pattern", not: ["rule", "regex", "heuristic"]
  end
end
