Hecks.bluebook "Cli", version: "2026.05.12.1" do
  vision "The storehouse invocation as a domain — being detection, argv parsing, subcommand routing, handler dispatch, exit reporting, all expressed as one aggregate walking a five-phase lifecycle"
  category "runtime"

  # ============================================================
  # CLI — Phase F-11 — the subcommand dispatch as domain
  # ============================================================
  #
  # Eleventh file of the Phase F arc. The partial-extraction target :
  #
  #   storehouse/src/main.rs  — 1,566 LOC total ; ~500 LOC of
  #                             subcommand dispatch is natural-fit.
  #
  # main.rs walks a big if/else-if chain on argv[1] : help, lexicon,
  # terminal, heki, conceive, develop, conceive-behaviors, behaviors,
  # dump-fixtures, dump-world, dump-hecksagon, specialize, cascade,
  # check-io, check-lifecycle, check-duplicate-policies, check-all,
  # run, repl, serve, plus the bluebook-file operations (parse, dump,
  # validate, inspect, tree, list). Each branch routes to a specific
  # handler. THAT routing — which subcommand maps to what — is what
  # fits naturally.
  #
  # What does NOT fit (declared residue in the sibling hecksagon) :
  #
  #   argv parsing          — env::args() + string matching,
  #                           kernel-floor shape primitive
  #   help text printing    — free-form operator-facing prose,
  #                           same residue category as HTML templates
  #                           from F-5 Server
  #   per-handler bodies    — each subcommand is its own capability
  #                           (heki → heki_query F-10, behaviors →
  #                           BehaviorsRunner F-6, specialize →
  #                           specializer F-7-adjacent, conceive →
  #                           Conception F-9, etc.). main.rs holds the
  #                           glue ; this bluebook declares the glue
  #                           pattern without duplicating what each
  #                           capability already declares.

  # ============================================================
  # INVOCATION — one run of storehouse / miette / summer
  # ============================================================

  aggregate "Invocation", "One invocation of the binary — detects the being name from argv[0], parses the subcommand from argv[1], routes to the matching handler, reports an exit code back to the OS" do
    identified_by :pid_started_at
    # pid_started_at : <pid>-<unix_seconds> — natural key per process.
    # Lets the audit channel keep one record per binary fire without
    # collisions across concurrent invocations (rare but possible).
    attribute :pid_started_at, InvocationKey

    # argv0 : the binary name as invoked. "storehouse", "miette",
    # "summer" all land here ; the being detector reads this.
    attribute :argv0, BinaryName
    # being : the detected being name. miette → "Miette", summer →
    # "Summer", otherwise the default from the binary-name table.
    attribute :being, BeingName
    # is_named_being : yes | no. When yes and argv has no subcommand,
    # the default is to drop into the terminal rather than print
    # usage.
    attribute :is_named_being, Flag
    # subcommand : the dispatched command name. Read from argv[1],
    # or "parse" when argv[1] looks like a filename (has a dot) and
    # there are no further args (backwards-compat shim).
    attribute :subcommand, SubcommandName
    # path_arg : argv[2], when present. Many subcommands take a path
    # as their first positional arg (parse, dump-world, specialize,
    # behaviors, run, serve, etc.).
    attribute :path_arg, PathArg
    # handler : the resolved handler name — the Subcommand catalog's
    # `handler` column for the matched subcommand. Empty when no
    # subcommand matched (fall-through to print_usage + exit 1).
    attribute :handler, HandlerName
    # exit_code : 0 for clean, non-zero per each handler's code table.
    attribute :exit_code, ExitCode
    # exit_kind : symbolic form of exit_code (ok | parse_failure |
    # guard_failure | adapter_failure | command_not_found | unknown_
    # subcommand).
    attribute :exit_kind, ExitKindName
    # phase : pending | being_detected | parsed | routed | dispatched
    #         | complete | failed.
    attribute :phase, PhaseName, default: "pending"

    # ── Value-objects : the invocation's vocabulary ──
    #
    # 2026-05-12 : wrapped every primitive per the no-primitive-envy
    # discipline. Each VO names the concept ; duplication across the
    # sibling argv / subcommand bluebooks is fine.

    value_object "InvocationKey" do
      # Composite natural key : <pid>-<unix_seconds>. One row per
      # binary fire, collision-free across concurrent invocations.
      attribute :value, String
    end

    value_object "BinaryName" do
      # The basename of argv[0] ("storehouse" / "miette" / "summer").
      attribute :value, String
    end

    value_object "BeingName" do
      # The detected being ("Miette" / "Summer" / default) — the
      # face presented at the terminal.
      attribute :value, String
    end

    value_object "Flag" do
      # Yes/no token — recorded as "yes" or "no" rather than a
      # native bool so it stays grep-friendly in event logs.
      attribute :value, String
    end

    value_object "SubcommandName" do
      # The dispatched command name ("parse" / "run" / "serve" / …).
      attribute :value, String
    end

    value_object "PathArg" do
      # argv[2] — usually a path to a bluebook or corpus directory.
      attribute :value, String
    end

    value_object "HandlerName" do
      # The resolved handler name from the Subcommand catalog ;
      # empty when no subcommand matched.
      attribute :value, String
    end

    value_object "ExitCode" do
      # The OS-visible exit code — 0 for clean, non-zero per the
      # five-kind table shared with Runner.
      attribute :value, Integer
    end

    value_object "ExitKindName" do
      # The symbolic form of the exit code (ok / parse_failure /
      # guard_failure / adapter_failure / command_not_found /
      # unknown_subcommand).
      attribute :value, String
    end

    value_object "PhaseName" do
      # Pipeline phase token — pending / being_detected / parsed /
      # routed / dispatched / complete / failed. Enumerated by the
      # lifecycle below.
      attribute :value, String
    end

    # ---- ExitKind -------------------------------------------------
    #
    # The set of outcomes every invocation collapses to. Mirror of
    # the ExitKind carried by F-4 Runner for bluebook-run scripts ;
    # the Cli surface has a wider set because its handlers include
    # corpus scans, shell dispatches, and dump tools, each with their
    # own failure modes.

    value_object "ExitKind" do
      attribute :code, Integer
      attribute :kind_name, String
    end

    # ---- Phase ----------------------------------------------------
    #
    # One row per pipeline phase the runtime walks. Today the trace
    # is a single `phase: String` attribute that overwrites with each
    # transition ; growing into a Phase entity lets us track per-phase
    # timing, errors, and retry state without conflating them.
    #
    # Phase is a non-root entity : it has identity within the parent
    # Invocation (the `name` field — "detect_being", "parse_argv", …)
    # and mutates through its lifecycle (started_at set when it begins,
    # ended_at + status set when it finishes ; an errored phase carries
    # an error_message). The lifecycle is bounded by the parent : when
    # the Invocation is retired, its phases go with it. Distinct from
    # ExitKind above — that's an immutable categorisation, no identity.

    entity "Phase" do
      # name : detect_being | parse_argv | route_subcommand |
      #        dispatch_handler | report_exit
      attribute :name,            String
      attribute :started_at,      String
      attribute :ended_at,        String, default: ""
      # status : in_progress | ended | errored | skipped
      attribute :status,          String, default: "in_progress"
      attribute :error_message,   String, default: ""
    end

    # ---- Commands -------------------------------------------------

    command "DetectBeing" do
      role "System"
      description "Read argv[0]'s basename. 'miette' resolves to being='Miette' ; 'summer' to 'Summer' ; anything else uses the default 'Miette'. The boolean is_named_being is yes when argv[0] is exactly miette or summer — that branch changes the no-subcommand behaviour from print_usage to drop-into-terminal."
      attribute :argv0, BinaryName
      attribute :being, BeingName
      attribute :is_named_being, Flag
      then_set :argv0, to: :argv0
      then_set :being, to: :being
      then_set :is_named_being, to: :is_named_being
      then_set :phase, to: "being_detected"
      emits "BeingDetected"
    end

    command "ParseArgv" do
      role "System"
      description "Decide the subcommand from argv[1] and the path arg from argv[2]. Backwards-compat shim : when argv has exactly 2 elements and argv[1] contains a dot, treat it as a parse invocation — lets `storehouse pizzas.bluebook` work without the `parse` subcommand. When argv has only 1 element and is_named_being is yes, the subcommand resolves to 'terminal' ; otherwise 'help' with exit code 1."
      attribute :subcommand, SubcommandName
      attribute :path_arg, PathArg
      then_set :subcommand, to: :subcommand
      then_set :path_arg, to: :path_arg
      then_set :phase, to: "parsed"
      emits "ArgvParsed"
    end

    command "RouteSubcommand" do
      role "System"
      description "Resolve the handler for the parsed subcommand. The concrete registry is main.rs's if / else-if chain ; matches are exact, no fuzzy matching. When the subcommand is not recognized, move to failed with exit_kind=unknown_subcommand ; when it is, record the handler name and move to routed."
      attribute :handler, HandlerName
      then_set :handler, to: :handler
      then_set :phase, to: "routed"
      emits "SubcommandRouted"
    end

    command "DispatchHandler" do
      role "System"
      description "Invoke the resolved handler. Each handler is the responsibility of a sibling capability (F-1 through F-10) or a kernel-floor tool (dump-fixtures, dump-world, dump-hecksagon). The dispatch hands over argv and waits for the handler's exit code."
      then_set :phase, to: "dispatched"
      emits "HandlerDispatched"
    end

    command "ReportExit" do
      role "System"
      description "Record the handler's outcome as an ExitKind and propagate the code back to the OS. Zero for clean ; non-zero per the handler's own table (1 for parse failure, 2 for guard failure, 3 for adapter failure, 4 for command not found, etc. — the shared five-kind vocabulary from Runner)."
      attribute :exit_code, ExitCode
      attribute :exit_kind, ExitKindName
      then_set :exit_code, to: :exit_code
      then_set :exit_kind, to: :exit_kind
      then_set :phase, to: "complete"
      emits "ExitReported"
    end

    command "FailInvocation" do
      role "System"
      description "Unknown subcommand, invalid argv shape, or handler-side failure that did not surface a clean ExitKind. Records the failing kind and moves to failed — the OS sees a non-zero exit and the operator sees the error printed to stderr."
      attribute :exit_kind, ExitKindName
      attribute :exit_code, ExitCode
      then_set :exit_kind, to: :exit_kind
      then_set :exit_code, to: :exit_code
      then_set :phase, to: "failed"
      emits "InvocationFailed"
    end

    lifecycle :phase, default: "pending" do
      transition "DetectBeing"     => "being_detected", from: "pending"
      transition "ParseArgv"       => "parsed",         from: "being_detected"
      transition "RouteSubcommand" => "routed",         from: "parsed"
      transition "DispatchHandler" => "dispatched",     from: "routed"
      transition "ReportExit"      => "complete",       from: "dispatched"
      transition "FailInvocation"  => "failed",         from: ["pending", "being_detected", "parsed", "routed", "dispatched"]
    end
  end

  # ============================================================
  # SUBCOMMAND REGISTRY — moved to sibling capability
  # ============================================================
  #
  # Earlier drafts of this bluebook ruled the registry out as a
  # catalog, on the grounds that nothing in cli.bluebook actually
  # walked it ; the Rust if/else chain in main.rs was the only true
  # consumer. That ruling was right *while Cli was a small phase-
  # tracer*. As main.rs's behavior moves into bluebook, RouteSubcommand
  # genuinely needs to consult a queryable registry — so the catalog
  # earns its keep, and lives next door rather than inside Invocation.
  #
  # The split — three capabilities, each owning one concern :
  #
  #   capabilities/cli/cli.bluebook            — Invocation lifecycle
  #                                              (this file)
  #   capabilities/argv/argv.bluebook          — Argv parsing : raw
  #                                              argv → typed Token
  #                                              stream (positional /
  #                                              kwarg / flag)
  #   capabilities/subcommand/subcommand.bluebook
  #                                            — Subcommand catalog
  #                                              and Handler resolution
  #
  # Multi-domain by design : each domain owns one shape, communicates
  # through events, grows independently. A new subcommand is one row
  # in the Subcommand catalog ; a new argv form is one rule in argv ;
  # a new lifecycle phase is one transition here in cli. None of the
  # three has to know the others' internals.
  #
  # `RouteSubcommand` (below) carries `subcommand_ref` referencing a
  # Subcommand record ; the runtime's reference-resolution finds the
  # row, the handler's name flows back as `handler` on Invocation.

  # ============================================================
  # POLICIES — the invocation chain
  # ============================================================

  policy "ParseAfterDetect" do
    on "BeingDetected"
    trigger "ParseArgv"
  end

  policy "RouteAfterParse" do
    on "ArgvParsed"
    trigger "RouteSubcommand"
  end

  policy "DispatchAfterRoute" do
    on "SubcommandRouted"
    trigger "DispatchHandler"
  end

  policy "ReportAfterDispatch" do
    on "HandlerDispatched"
    trigger "ReportExit"
  end
end
