Hecks.bluebook "StatusBar", version: "2026.04.16.1" do
  vision "Miette's presence in the terminal — what the world sees of the inner state"
  category "capability"

  # ============================================================
  # STATUS BAR
  # ============================================================
  #
  # The statusline shows Miette's state. It has two modes
  # driven by the consciousness store:
  #
  #   attentive — full details: name, heartbeat, mood, fatigue,
  #               invention count
  #   sleeping  — moon animation + sleep narrative
  #
  # The pulse daemon sets consciousness to "attentive" on every beat.
  #
  # Refresh: 1s interval, reads consciousness.heki via statusline-command.sh
  # Symlinked from ~/.claude/statusline-command.sh
  #
  # The musing mode + MusingLayout aggregate + SetMusing command +
  # MusingOnIdle policy were retired 2026-05-08 alongside the Musing
  # system.

  aggregate "Mode", "Which mode the statusline is in" do
    attribute :current, String
    attribute :idle_threshold_seconds, Integer
    attribute :refresh_interval_seconds, Integer

    command "SetAttentive" do
      role "Daemon"
      description "Pulse fired — show full details"
      emits "StatusAttentive"
      then_set :current, to: "attentive"
    end

    command "SetSleeping" do
      role "Daemon"
      description "Sleep entered — show moon and sleep narrative"
      emits "StatusSleeping"
      then_set :current, to: "sleeping"
    end
  end

  aggregate "AttentiveLayout", "What shows when active" do
    attribute :name, String
    attribute :show_heartbeat, TrueClass
    attribute :show_mood, TrueClass
    attribute :show_fatigue, TrueClass
    attribute :show_invention_count, TrueClass

    command "Configure" do
      role "Self"
      description "Set which elements appear in the attentive statusline"
      emits "AttentiveLayoutConfigured"
    end
  end

  # Default: show everything

  aggregate "SleepLayout", "What shows during sleep" do
    attribute :icon_set, String
    attribute :show_stage, TrueClass
    attribute :show_cycle, TrueClass

    command "Configure" do
      role "Self"
      description "Set sleep display format"
      emits "SleepLayoutConfigured"
    end
  end

  # Transitions
  policy "AttentiveOnPulse" do
    on "BodyPulse"
    trigger "SetAttentive"
    description "Every body pulse (= heartbeat) restores full details"
  end

  policy "SleepOnSleepEntered" do
    on "SleepEntered"
    trigger "SetSleeping"
    description "Sleep mode shows moon and narrative"
  end
end
