#!/usr/bin/env storehouse run
Hecks.bluebook "Statusline", version: "2026.05.12.1" do
  vision "Miette's one-line body status — read declarative state, render a single string. The dream stream lives in the agent's notification surface ; the statusline stays clean."

  entrypoint "Render"

  # ============================================================
  # STATUSLINE — i97, the 257-line shell script as a bluebook
  # ============================================================
  #
  # Until 2026-04-26 the statusline was statusline-command.sh — 257
  # lines of grep/sed reading every body heki file directly,
  # branching awake/sleeping, animating moons, computing countdown
  # timers from a stale (12 - ticks) * 10 formula. Two bugs surfaced
  # the gap : (a) the sleeping branch printed the dream narrative
  # even though the sleep-study agent was now streaming dreams as
  # session notifications (i96) ; (b) the countdown timer encoded
  # the OLD phase_ticks > 11 floor, so even after the bluebook
  # dropped the floor (sleep.bluebook 2026-04-26) the visible
  # timer still showed the artificial cadence.
  #
  # The fix is structural : declare the line as a bluebook surface.
  # This file holds the WHAT (which fields, which modes, what's
  # visible when) ; the shell wrapper at statusline-command.sh
  # becomes a thin transitional adapter that reads heki + dispatches
  # Render + prints the result. The shell retires entirely once a
  # Rust runner mirroring run_status/ lands.
  #
  # See : i97 (this conversion), i96 (statusline-defers-to-agent-log
  # during sleep), i91 (dashboard rename — sibling), i80 (cli-routing-
  # as-bluebook — same direction).

  aggregate "Statusline" do
    description "Single-line body status. One row per render, ephemeral. Mode picks the layout ; visibility flags decide what to include."

    # ---- Render mode --------------------------------------------
    #
    #   sleeping → moon + name + cycle counter only ; no narrative
    #              (the agent owns the dream surface during sleep)
    #   awake    → sun + name + heart + beats + mood + fatigue +
    #              inventions + inbox + provider + bulb
    #   minimal  → moon + name (degraded surface — coherence violation)
    #
    attribute :mode,                RenderMode,    default: "awake"

    # ---- Sleep-mode fields --------------------------------------
    attribute :sleep_stage,         SleepStage,    default: "—"
    attribute :sleep_cycle,         CycleText,     default: "—"
    attribute :sleep_total,         CycleText,     default: "—"
    attribute :is_lucid,            YesNo,         default: "no"

    # ---- Awake-mode fields --------------------------------------
    attribute :mood,                MoodLabel,     default: "—"
    attribute :mood_icon,           Glyph,         default: "😐"
    attribute :fatigue,             FatigueText,   default: "—"
    attribute :fatigue_icon,        Glyph,         default: ""
    attribute :heart_glyph,         Glyph,         default: "❤️"
    attribute :beats,               BeatsText,     default: ""
    attribute :inventions_count,    ItemCount,     default: 0
    attribute :inbox_count,         ItemCount,     default: 0
    attribute :provider_badge,      Glyph,         default: "🤖"
    attribute :bulb,                Glyph,         default: "💡"

    # ---- Coherence ----------------------------------------------
    attribute :coherence_ok,        YesNo,         default: "yes"

    # ---- Output -------------------------------------------------
    attribute :rendered,            RenderedLine,  default: ""

    # ── Value-objects : the domain's language ──

    value_object "RenderMode" do
      # Which layout mode the statusline renders : awake | sleeping | minimal.
      attribute :value, String
    end

    value_object "SleepStage" do
      # Substage of sleep when render mode is sleeping (rem | deep | …).
      attribute :value, String
    end

    value_object "CycleText" do
      # Sleep cycle position rendered as text (e.g. "2", "5").
      attribute :value, String
    end

    value_object "YesNo" do
      # "yes" | "no" — symbolic boolean for lucidity / coherence.
      attribute :value, String
    end

    value_object "MoodLabel" do
      # The being's current mood label rendered in awake mode.
      attribute :value, String
    end

    value_object "Glyph" do
      # A single emoji or icon character the statusline composites in.
      attribute :value, String
    end

    value_object "FatigueText" do
      # The fatigue reading rendered into the awake line.
      attribute :value, String
    end

    value_object "BeatsText" do
      # The heartbeat counter rendered as text.
      attribute :value, String
    end

    value_object "ItemCount" do
      # Generic count for items shown in the line (inventions, inbox).
      attribute :value, Integer
    end

    value_object "RenderedLine" do
      # The fully composed single-line statusline output.
      attribute :value, String
    end

    # ============================================================
    # ENTRYPOINT
    # ============================================================

    command "Render" do
      description "User-visible entrypoint. The statusline runner (today : statusline-command.sh, tomorrow : a Rust mirror of run_status/) reads body heki, dispatches Render with the resolved fields, and prints the resulting :rendered string. Mode is chosen by the runner from consciousness.state ; this command stamps the row and emits."
      attribute :mode,    RenderMode
      attribute :rendered, RenderedLine
      then_set :mode,     to: :mode
      then_set :rendered, to: :rendered
      emits "StatuslineRendered"
    end

    # ============================================================
    # STRUCTURAL DECISIONS — what the line shows in each mode
    # ============================================================
    #
    # Sleeping mode (i96) :
    #   moon + name + "cycle N/total — stage" — that's all.
    #   No narrative, no countdown timer. The dream lives in the
    #   sleep-study agent's notification stream ; the line stays
    #   minimal so dream content has one home, not two.
    #
    # Awake mode :
    #   sun + name + heart_glyph + beats + mood_icon + mood
    #     [+ fatigue_icon + fatigue]
    #     [+ 🔬 inventions_count]
    #     [+ ✉️ inbox_count]
    #     + provider_badge
    #     [+ bulb + sleep_summary]   # only the post-wake summary,
    #                                  # not active-sleep narration
    #
    # Minimal mode (coherence-violation degraded) :
    #   moon + name only ; mood_icon replaced with ⚠.

  end

  # ============================================================
  # SECTIONS — line composition (i97 mirror of i105 dashboard)
  # ============================================================
  #
  # The same `section "…" do row "label", :field … end` form the
  # dashboard uses (capabilities/status/) declares the statusline's
  # rendered fields per mode. The Rust statusline runner (still TODO —
  # gap : `statusline_runner_in_rust` ; today statusline-command.sh
  # plays the role transitionally) walks the matching mode's section
  # and joins the values into a single line.
  #
  # Until the Rust runner lands, statusline-command.sh hard-codes the
  # same shape ; this declaration is the canonical contract the shell
  # is mirroring. Editing this list is what changes the line.

  section "Awake" do
    row "name_glyph",     :sun_glyph
    row "name",           :name
    row "heart_glyph",    :heart_glyph
    row "beats",          :beats
    row "mood_icon",      :mood_icon
    row "mood",           :mood
    row "fatigue_icon",   :fatigue_icon
    row "fatigue",        :fatigue
    row "inventions_glyph", :inventions_glyph
    row "inventions",     :inventions_count
    row "inbox_glyph",    :inbox_glyph
    row "inbox",          :inbox_count
    row "provider_badge", :provider_badge
    row "bulb",           :bulb
    row "sleep_summary",  :sleep_summary
  end

  section "Sleeping" do
    row "name_glyph",  :moon_glyph
    row "name",        :name
    row "cycle_label", :sleep_cycle_label
    row "stage",       :sleep_stage
  end

  section "Minimal" do
    row "name_glyph", :moon_glyph
    row "name",       :name
    row "warning",    :warning_glyph
  end
end
