    # order 26 — wall-clock segment trigger
    # dispatch_address is empty because the address comes from --segment flags in argv
    fixture "Clock",
      name: "clock",
      handler: "run_clock",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 1, max_positional: -1, allowed_kwargs: "*", allowed_flags: "*" },
