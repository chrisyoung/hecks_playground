      argv_shape: { min_positional: 1, max_positional: -1, allowed_kwargs: "", allowed_flags: "" },
      dispatch_address: { value: "" }

    # order 20 — cadence loop : dispatch one or more commands every <dur>
    # dispatch_address is empty because the address comes from argv
    fixture "Loop",
      name: "loop",
      handler: "run_loop",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 2, max_positional: -1, allowed_kwargs: "*", allowed_flags: "*" },
      dispatch_address: { value: "" }

    # order 21 — PM-loop daemon (run-loop)
    # dispatch_address is empty because the address comes from argv
    fixture "RunLoop",
      name: "run-loop",
      handler: "run_pm_loop",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 1, max_positional: -1, allowed_kwargs: "*", allowed_flags: "*" },
      dispatch_address: { value: "" }

    # order 22 — process-lifecycle daemon
    # dispatch_address is empty because the address comes from argv
    fixture "Daemon",
