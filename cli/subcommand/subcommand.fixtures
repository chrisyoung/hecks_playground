    # order 28 — interactive REPL (legacy `run`)
    fixture "Repl",
      name: "repl",
      handler: "run_repl",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 0, max_positional: -1, allowed_kwargs: "", allowed_flags: "" },
