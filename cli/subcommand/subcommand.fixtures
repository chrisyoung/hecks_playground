    # order 10 — parse a .fixtures file and emit canonical JSON
    fixture "DumpFixtures",
      name: "dump-fixtures",
      handler: "run_dump_fixtures",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 1, max_positional: 2, allowed_kwargs: "", allowed_flags: "" },
      dispatch_address: { value: "" }

    # order 11 — parse a .world file and emit canonical JSON
    fixture "DumpWorld",
      name: "dump-world",
      handler: "run_dump_world",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 1, max_positional: 1, allowed_kwargs: "", allowed_flags: "" },
      dispatch_address: { value: "" }

    # order 12 — parse a .hecksagon file and emit canonical JSON
    fixture "DumpHecksagon",
      name: "dump-hecksagon",
      handler: "run_dump_hecksagon",
      exit_kind_default: "ok",
