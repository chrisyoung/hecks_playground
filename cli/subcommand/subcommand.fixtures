Hecks.fixtures "SubcommandRegistry" do
  # Complete catalog of CLI subcommands for `storehouse` (and its being
  # aliases miette / summer). One fixture row per subcommand, matching
  # the if-chain in rust/src/main.rs fn main() as of i630.
  #
  # dispatch_address : empty string for subcommands whose address comes
  # from argv (cadence handlers) or from invocation-time Rust dispatch
  # (internal handlers). A non-empty value here MUST be a fully-qualified
  # FQN (contains '::') — enforced by the DispatchAddress invariant.
  # Rows will be filled in progressively as handlers port to domain
  # dispatch (i80 retirement arc).
  #
  # argv_shape notes :
  #   max_positional: -1 means unbounded
  #   allowed_kwargs / allowed_flags : "" means none, "*" means any

  aggregate "Subcommand" do
    # order 0 — storehouse generic dispatcher (i484)
    fixture "Storehouse",
      name: "storehouse",
      handler: "run_storehouse",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 1, max_positional: -1, allowed_kwargs: "", allowed_flags: "" },
      dispatch_address: { value: "" }

    # order 1 — hecksagon-driven lexicon query
    fixture "Lexicon",
      name: "lexicon",
      handler: "run_lexicon",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 0, max_positional: 2, allowed_kwargs: "", allowed_flags: "" },
      dispatch_address: { value: "" }

    # order 2 — interactive terminal
    fixture "Terminal",
      name: "terminal",
      handler: "run_terminal",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 0, max_positional: 0, allowed_kwargs: "", allowed_flags: "" },
      dispatch_address: { value: "" }

    # order 3 — four-into-one transitional redirect (speak/status/musings/boot)
    fixture "TransitionalPrint",
      name: "transitional_print",
      handler: "run_transitional_print",
      exit_kind_default: "ok",
      deprecated: "yes",
      argv_shape: { min_positional: 0, max_positional: 0, allowed_kwargs: "", allowed_flags: "" },
      dispatch_address: { value: "" }

    # order 4 — heki binary store read/write
    fixture "Heki",
      name: "heki",
      handler: "run_heki",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 1, max_positional: -1, allowed_kwargs: "", allowed_flags: "" },
      dispatch_address: { value: "" }

    # order 5 — generate a new domain from corpus archetypes
    fixture "Conceive",
      name: "conceive",
      handler: "run_conceive",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 1, max_positional: -1, allowed_kwargs: "", allowed_flags: "" },
      dispatch_address: { value: "" }

    # order 6 — develop features in an existing domain
    fixture "Develop",
      name: "develop",
      handler: "run_develop",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 1, max_positional: -1, allowed_kwargs: "", allowed_flags: "" },
      dispatch_address: { value: "" }

    # order 7 — conceive behaviors for an existing domain
    fixture "ConceiveBehaviors",
      name: "conceive-behaviors",
      handler: "run_conceive_behaviors",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 1, max_positional: -1, allowed_kwargs: "", allowed_flags: "" },
      dispatch_address: { value: "" }

    # order 8 — run behaviors / test suite (alias: test)
    fixture "Behaviors",
      name: "behaviors",
      handler: "run_behaviors",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 1, max_positional: -1, allowed_kwargs: "", allowed_flags: "" },
      dispatch_address: { value: "" }

    # order 9 — universal .behaviors runner (i500 alias for behaviors)
    fixture "Test",
