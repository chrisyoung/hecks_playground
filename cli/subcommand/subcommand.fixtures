      handler: "run_daemon",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 1, max_positional: -1, allowed_kwargs: "*", allowed_flags: "*" },
      dispatch_address: { value: "" }

    # order 23 — PostToolUse antibody listener (canonical name as of i553)
    # enforce-edit is the deprecated alias kept for backward compat
    # dispatch_address is empty: macrophage dispatches to different
    # commands based on file kind (RecordBluebookEdit / RecordImperativeEdit
    # / RecordExemptedEdit / RecordSupportEdit / RecordOtherEdit)
    fixture "Macrophage",
      name: "macrophage",
      handler: "run_macrophage",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 0, max_positional: 0, allowed_kwargs: "", allowed_flags: "" },
      dispatch_address: { value: "" }

    # deprecated alias for macrophage (order 23b)
    fixture "EnforceEdit",
      name: "enforce-edit",
      handler: "run_macrophage",
      exit_kind_default: "ok",
      deprecated: "yes",
      argv_shape: { min_positional: 0, max_positional: 0, allowed_kwargs: "", allowed_flags: "" },
      dispatch_address: { value: "" }

    # order 24 — statusline capability runner
    fixture "Statusline",
      name: "statusline",
      handler: "run_statusline",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 0, max_positional: -1, allowed_kwargs: "", allowed_flags: "" },
      dispatch_address: { value: "" }

    # order 25 — IR-query subcommand (exit 0 + stdout if dispatched, exit 1 if not)
    fixture "IsDispatched",
      name: "is-dispatched",
      handler: "run_is_dispatched",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 1, max_positional: 2, allowed_kwargs: "", allowed_flags: "" },
