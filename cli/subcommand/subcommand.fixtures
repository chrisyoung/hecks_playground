    # order 14 — print cascade_emits chains for every aggregate command
    fixture "Cascade",
      name: "cascade",
      handler: "run_cascade",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 1, max_positional: 1, allowed_kwargs: "", allowed_flags: "" },
