    fixture "CheckDuplicatePolicies",
      name: "check-duplicate-policies",
      handler: "run_check_duplicate_policies",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 1, max_positional: -1, allowed_kwargs: "", allowed_flags: "" },
      dispatch_address: { value: "" }

    # order 18 — run all checks
    fixture "CheckAll",
      name: "check-all",
      handler: "run_check_all",
      exit_kind_default: "ok",
      deprecated: "no",
      argv_shape: { min_positional: 1, max_positional: -1, allowed_kwargs: "", allowed_flags: "" },
