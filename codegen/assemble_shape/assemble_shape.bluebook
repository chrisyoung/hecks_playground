Hecks.bluebook "AssembleShape", version: "2026.05.01.1" do
  vision "The shape of rust/src/run_status/assemble.rs as a bluebook — the pure read layer that flattens heki stores + filesystem state into a Report struct for the StatusReport renderer. Decomposes into three ordered Section rows (structs / build / helpers) emitted as verbatim_section snippets under a HEADER const that carries the doc comment + use lines. body_kind decision : verbatim_section (reuse). Considered a new heki_field_loader kind for the str_field / first_present / load / latest helpers, but they are one-time helper definitions, not a repeated declarative pattern — the repetition is at expression call sites inside build(), where breaking into per-row fixtures would explode count for marginal gain. verbatim_section keeps the shape uniform with discover_shape, behaviors_fixtures_shape, parser_shape, parse_blocks_shape — every section-as-snippet sibling. The heki-loader idiom stays inline for now ; promote to a body_kind when a second consumer arrives."
  category "autophagy"

  # ============================================================
  # ASSEMBLE SHAPE — i147 Wave 8 target
  # ============================================================
  #
  # rust/src/run_status/assemble.rs is the pure read layer for
  # the StatusReport capability. Every `storehouse status` (or
  # status-runner-fired) invocation walks the declared heki stores
  # + on-disk bluebook count + pidfile state, produces a flat
  # Report struct, and hands it to render::render_with_sections.
  # No aggregate writes happen here — the caller stamps Report
  # into StatusReport state and dispatches GenerateReport.
  #
  # Wave 8 retires the AUTHORED Rust file — the runtime stays
  # at rust/src/run_status/assemble.rs but is regenerated byte-
  # for-byte from this shape's fixtures + snippets.
  #
  # Layer mapping :
  #   L0 = this file + fixtures/assemble_shape.fixtures
  #        + snippets/*.rs.frag
  #   L1 = canonical_ir representation of this file
  #   L7 = rust/src/run_status/assemble.rs (generated)
  #
  # One aggregate :
  #
  #   Section — one row per ordered top-level partition in
  #             assemble.rs. body_kind picks the emitter ;
  #             today only verbatim_section is used :
  #
  #               verbatim_section — read snippet_path raw,
  #                                  preserves trailing blank
  #                                  line as the section
  #                                  separator. Mirrors
  #                                  discover_shape's pattern.
  #
  #             The HEADER const inside the specializer
  #             carries the doc comment + use lines (lines
  #             1-14 of the source). Three Section rows
  #             cover the rest :
  #
  #               1. structs  (DaemonRow + Report)
  #               2. build    (the build() entrypoint)
  #               3. helpers  (daemon_row, wish_summary,
  #                            recent_commits, humanize_age,
  #                            humanize_age_from_born,
  #                            parse_utc_seconds, load,
  #                            latest, timestamp, str_field,
  #                            first_present, dream_text,
  #                            turn_text, mindstream_alive,
  #                            count_bluebooks)
  #
  # Body_kind decision (recorded in `vision` above) : reuse
  # verbatim_section rather than invent heki_field_loader. The
  # str_field / first_present / load / latest helpers ARE the
  # heki-loading idiom, but they're each defined ONCE at the
  # bottom of the file ; the repetition is at the call site
  # inside build() (`str_field(&consciousness, "state", "—")`
  # × N) which is expression-level, not section-level. Per-call
  # fixturisation would explode row count for no compression.
  # When a second heki-reading file arrives that needs the SAME
  # helper bodies, lift them into a shared snippet pool ; today
  # they live verbatim under section 3.
  #
  # REAL compression today : modest — three section rows + a
  # HEADER const replace 409 hand-edited LoC with three stable
  # .rs.frag files. Adding a new top-level helper is a snippet
  # edit ; reordering the structs / build / helpers grouping is
  # a fixture-row reorder. Real compression arrives when the
  # heki-loader idiom moves out into its own body_kind shared
  # across run_status/, run_statusline.rs, and any future
  # heki-reading file — that's the W9+ payoff.

  aggregate "Section", "One ordered top-level partition in assemble.rs" do
    attribute :name,         String
    # order: ascending integer ; specializer sorts before concatenating.
    attribute :order,        Integer
    # body_kind: verbatim_section (today's only kind).
    attribute :body_kind,    String
    # snippet_path: required for verbatim_section ; path is repo-rooted.
    attribute :snippet_path, String, default: ""
    # description: prose for humans reading the bluebook ; not emitted.
    attribute :description,  String, default: ""
  end
end
