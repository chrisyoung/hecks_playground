      body_kind: "suite_overload",
      fn_name: "run_suite_with_fixtures",
      doc_path: "codegen/behaviors_runner_shape/docs/run_suite_with_fixtures.frag",
      kind: "iter",
      has_fixtures: "true",
      description: "run_suite_with_fixtures — fixture-aware variant ; iter().map(run_one).collect()"

    fixture "RunSuiteWithDomainSection",
      name: "run_suite_with_domain",
      order: 4,
      body_kind: "suite_overload",
      fn_name: "run_suite_with_domain",
      doc_path: "codegen/behaviors_runner_shape/docs/run_suite_with_domain.frag",
      kind: "iter",
      has_domain: "true",
      has_fixtures: "true",
