Hecks.fixtures "BehaviorsRunnerShape" do
  # One row per ordered code section in behaviors_runner.rs. Specializer
  # concatenates HEADER (doc + use lines, hardcoded in the emitter) +
  # each section body in `order` ascending.
  #
  # Body kinds :
  #   verbatim_section — read snippet_path raw, emit unchanged.
  #   suite_overload   — emit one of the three suite-entry overloads
  #                      (run_suite / run_suite_with_fixtures /
  #                      run_suite_with_domain) from knobs : fn_name,
  #                      doc_path, kind (delegate | iter), has_domain,
  #                      has_fixtures.
  #
  # The three suite_overload rows compress the entry-point family :
  # ~38 lines of source → 3 fixture rows + 3 small doc fragments.
  # Adding a fourth overload (e.g. streaming, parallel) is a new row.

  aggregate "Section" do
    fixture "TypesSection",
      name: "types",
      order: 1,
      body_kind: "verbatim_section",
      snippet_path: "codegen/behaviors_runner_shape/snippets/01_types.rs.frag",
      description: "TestStatus enum + TestRun struct + SuiteResult struct + their impls"

    fixture "RunSuiteSection",
      name: "run_suite",
      order: 2,
      body_kind: "suite_overload",
      fn_name: "run_suite",
      doc_path: "codegen/behaviors_runner_shape/docs/run_suite.frag",
      kind: "delegate",
      description: "run_suite — delegating shim, calls run_suite_with_fixtures with None"

    fixture "RunSuiteWithFixturesSection",
