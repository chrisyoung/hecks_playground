Hecks.bluebook "CliDispatchShape", version: "2026.05.12.2" do
  vision "The shape of rust/src/main.rs as a bluebook — the CLI dispatch chain and usage help made declarative. Each `if command == \"X\"` arm is a Subcommand row ; the help-text Commands: list is HelpRow rows. Adding or reordering a subcommand becomes a fixture-row edit, not a hand-edit to main.rs."
  category "autophagy"

  # ============================================================
  # CLI DISPATCH SHAPE — i147 Wave 6 target
  # ============================================================
  #
  # rust/src/main.rs is THE CLI entry-point. Every `storehouse X`
  # invocation lands in fn main(), threads through the if-chain on
  # argv[1], and either dispatches to a handler (run_X) or runs a
  # short inline body. Wave 6 retires the dispatch ROUTING — the
  # if-chain + the print_usage Commands: list — while leaving the
  # handler function bodies intact (those are filed as a follow-on
  # arc when each handler family migrates to its own per-family
  # sub-shape).
  #
  # Layer mapping :
  #   L0 = this file + fixtures/cli_dispatch_shape.fixtures
  #        + snippets/*.rs.frag
  #   L1 = canonical_ir representation of this file
  #   L7 = rust/src/main.rs (generated)
  #
  # Three row-types (value_objects on the collapsed root) :
  #
  #   Section    — one row per ordered top-level partition in main.rs.
  #                body_kind picks the emitter :
  #                  verbatim_section — read snippet_path raw, emit
  #                                     unchanged. Used for the fn main
  #                                     opening (argv parsing + subcommand
  #                                     catalog gate), the post-chain tail
  #                                     (batch / bluebook-dispatch / serve /
  #                                     parse-match / close brace), the big
  #                                     helper-functions block (run_batch
  #                                     through dirs), and the helpers tail
  #                                     (emit_validator_warnings_to_stderr).
  #                  dispatch_chain   — synthetic ; assemble from
  #                                     Subcommand rows in `order`
  #                                     ascending. Snippets are read raw
  #                                     and concatenated.
  #                  usage_help       — synthetic ; emit print_usage
  #                                     skeleton with the Commands: list
  #                                     assembled from HelpRow rows in
  #                                     `order` ascending.
  #
  #   Subcommand — one row per `if command == "X" { ... ; return; }` arm
  #                in fn main()'s dispatch chain (lines 116-435 of the
  #                pre-i147-W6 main.rs). 26 rows :
  #
  #                  lexicon, terminal, transitional_print
  #                  (speak|status|musings|boot — the four-into-one
  #                  hecksagon-redirect arm), heki, conceive, develop,
  #                  conceive_behaviors, behaviors, dump_fixtures,
  #                  dump_world, dump_hecksagon, specialize, cascade,
  #                  check_io, check_lifecycle, check_duplicate_policies,
  #                  check_all, run, loop, daemon, enforce_edit,
  #                  statusline, is_dispatched, clock, sleep, repl
  #
  #                Each row points at a per-arm `.rs.frag` snippet that
  #                carries the arm body verbatim (leading blank-line
  #                separator + leading comment block + the
  #                `if command == "X" { ... return; }` block). The
  #                specializer concatenates these snippets in order.
  #
  #                Why per-arm snippets rather than knob-driven templates :
  #                although several arms ARE shape-identical (the
  #                delegate_run family : `run_X(&args); return;`) and
  #                others share a transitional-print pattern, several arms
  #                carry sui-generis logic (lexicon's hecksagon dispatch,
  #                dump_fixtures' catalog payload assembly, is_dispatched's
  #                early-exit branching, sleep's blocking polling stream).
  #                Per-arm snippets keep each arm's semantics readable in
  #                isolation while the shape encodes what matters
  #                declaratively : the ORDER and the SET of arms.
  #
  #   HelpRow    — one row per command listed in print_usage's Commands:
  #                section. Decoupled from Subcommand because the help
  #                listing curates a different ordering AND includes
  #                commands handled by the `match command` block at the
  #                bottom of fn main (parse, validate, inspect, tree, list,
  #                serve, hydrate) which never appear in the if-chain.
  #
  # REAL compression : the dispatch contract — the ORDER of subcommands
  # and the ROUTE each one takes — is now data, not code. Adding a new
  # CLI subcommand is a (1) Subcommand fixture row + (2) per-arm .rs.frag
  # snippet + (3) optional HelpRow for the usage listing.
  #
  # ============================================================
  # Single-aggregate shape per Chris's "no bluebooks without commands"
  # principle (2026-05-12). The three row-types collapse to
  # value_objects on the CliDispatchShape root ; the row catalog lives
  # in the sibling fixtures file. EmitMainRs is the semantic command —
  # given the row set, emit rust/src/main.rs as a single Rust source
  # string.

  aggregate "CliDispatchShape", "Static schema for the main.rs codegen target — Section + Subcommand + HelpRow rows live in the sibling fixtures file" do
    identified_by :target_rs

    # ---- TargetRs ----------------------------------------------------

    value_object "TargetRs" do
      attribute :value, String
      invariant "must end in .rs" do
        value.end_with?(".rs")
      end
    end

    # ---- EmittedRs ---------------------------------------------------

    value_object "EmittedRs" do
      attribute :value, String
    end

    # ---- Section -----------------------------------------------------
    #
    # One ordered top-level partition in main.rs ; body_kind picks
    # emission.

    value_object "Section" do
      description "One ordered top-level partition in main.rs ; body_kind picks emission"
      attribute :name,         String
      # order: ascending integer ; specializer sorts before concatenating.
      attribute :order,        Integer
      # body_kind: verbatim_section | dispatch_chain | usage_help
      attribute :body_kind,    String
      # snippet_path: required for verbatim_section ; ignored for the
      # synthetic dispatch_chain and usage_help kinds.
      attribute :snippet_path, String
      # description: prose for humans reading the bluebook ; not emitted.
      attribute :description,  String
    end

    # ---- Subcommand --------------------------------------------------
    #
    # One arm in main.rs's CLI dispatch if-chain.

    value_object "Subcommand" do
      description "One arm in main.rs's CLI dispatch if-chain"
      attribute :name,         String
      # order: ascending integer ; specializer sorts before concatenating
      # arm snippets so the if-chain order is stable across edits to row text.
      attribute :order,        Integer
      # snippet_path: relative to repo root. The .rs.frag file containing
      # this arm's body — leading blank line + leading comment block (when
      # present) + `if command == "X" { ... return; }`. Read raw.
      attribute :snippet_path, String
      # description: prose for humans reading the bluebook ; not emitted.
      attribute :description,  String
    end

    # ---- HelpRow -----------------------------------------------------
    #
    # One row in print_usage's Commands: listing.

    value_object "HelpRow" do
      description "One row in print_usage's Commands: listing"
      attribute :name,             String
      # order: ascending integer ; specializer sorts before emitting the
      # eprintln lines so help-listing order is stable.
      attribute :order,            Integer
      # command: the literal subcommand name as shown in help (e.g. "parse",
      # "dump-hecksagon").
      attribute :command,          String
      # description: the help-text description shown after the command name.
      attribute :description,      String
      # padded_width: the column width the command name is padded to in the
      # help output. The pre-i147-W6 main.rs uses 11 for most rows but 16
      # for "dump-hecksagon" because it's longer ; we capture the column
      # width per-row to preserve byte-identity without hard-coding logic.
      attribute :padded_width,     Integer
      # trailing_newline: whether to append a literal "\n" inside the
      # eprintln string (used by the last command in a logical group :
      # "dump-hecksagon" gets one, the visual cluster separator before
      # "Heki subcommands:"). "yes" | "no".
      attribute :trailing_newline, String
    end

    attribute :target_rs, TargetRs

    # ── Commands ───────────────────────────────────────────────

    command "EmitMainRs" do
      role "Autophagy"
      description "Walk Section rows in `order` ascending. For verbatim_section rows, read snippet_path raw. For dispatch_chain rows, fold Subcommand rows in `order` ascending and concatenate each row's snippet_path body (leading blank + optional comment block + `if command == \"X\" { ... return; }` block). For usage_help rows, emit the print_usage fn skeleton with the Commands: list folded from HelpRow rows in `order` ascending, each row rendered as an `eprintln!(\"  <padded-command>  <description>\")` line (using HelpRow.padded_width for the column padding) with an optional trailing `\\n` when HelpRow.trailing_newline == \"yes\". Concatenate the rendered sections and return the bytes the caller writes to TargetRs. Byte-identical against the hand-written rust/src/main.rs at i147 W6."
      attribute :target_rs, TargetRs
      emits "MainRsEmitted"
      then_set :target_rs, to: :target_rs
    end
  end
end
