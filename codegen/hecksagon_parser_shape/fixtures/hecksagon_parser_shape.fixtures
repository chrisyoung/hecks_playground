Hecks.fixtures "HecksagonParserShape" do
  # Single-line fixtures per i57 parser limitation.

  # ── LineParser — the module's outer contract ────────────────────
  # detector_keyword carries the four top-level forms the parser
  # recognises : the legacy `Hecks.hecksagon` plus the Phase 1 adapter-
  # family meta-layer trio (Hecks.adapter_family / Hecks.provider /
  # Hecks.behavior_kind). Comma-separated ; the specializer emits a
  # chained `t.starts_with("X") || t.starts_with("Y") || ...` detector
  # when more than one keyword is declared.
  aggregate "LineParser" do
    fixture "HecksagonParser", module: "hecksagon_parser", doc_snippet: "codegen/hecksagon_parser_shape/snippets/doc.rs.frag", imports: "crate::hecksagon_helpers::*\ncrate::hecksagon_ir::*", root_fn_name: "parse", root_signature: "pub fn parse(source: &str) -> Hecksagon", detector_fn_name: "is_hecksagon_source", detector_keyword: "Hecks.hecksagon,Hecks.adapter_family,Hecks.provider,Hecks.behavior_kind"
  end

  # ── LineDispatch — one row per line-leading token in the parse() loop ──
  # Phase 1 of adapter-family activation adds three rows (orders 5/6/7)
  # for the meta-layer top-level forms. Each uses the new handler_kind
  # `capture_quoted_with_framework_kind` and carries the kind value in
  # `framework_kind` so the generated parser stamps it on the IR.
  aggregate "LineDispatch" do
    fixture "HexName",        parser: "hecksagon_parser", starts_with: "Hecks.hecksagon",      handler_kind: "capture_quoted_into",                target_field: "name",          helper_fn: "",               order: 1
    fixture "AdapterFamily",  parser: "hecksagon_parser", starts_with: "Hecks.adapter_family", handler_kind: "capture_quoted_with_framework_kind", target_field: "name",          helper_fn: "", framework_kind: "adapter_family", dispatch_comment: "Phase 1 of adapter-family activation : the meta-layer top-level\nforms set both `name` (the family / provider / behavior name)\nand `framework_kind` (the discriminator). Inner DSL is skipped\nhere ; Phase 2 will capture fields / providers / request_body\ninto a richer payload.", order: 2
    fixture "Provider",       parser: "hecksagon_parser", starts_with: "Hecks.provider",       handler_kind: "capture_quoted_with_framework_kind", target_field: "name",          helper_fn: "", framework_kind: "provider",                                                                                                                                                                                                                                                              order: 3
    fixture "BehaviorKind",   parser: "hecksagon_parser", starts_with: "Hecks.behavior_kind",  handler_kind: "capture_quoted_with_framework_kind", target_field: "name",          helper_fn: "", framework_kind: "behavior_kind",                                                                                                                                                                                                                                                         order: 4
    fixture "Subscribe",      parser: "hecksagon_parser", starts_with: "subscribe",            handler_kind: "push_quoted_onto",                   target_field: "subscriptions", helper_fn: "",               order: 5
    fixture "Gate",           parser: "hecksagon_parser", starts_with: "gate ",                handler_kind: "multiline_block",                    target_field: "gates",         helper_fn: "parse_gate",     order: 6
    fixture "DrivenAdapter",  parser: "hecksagon_parser", starts_with: "adapter \"",           handler_kind: "multiline_block",                    target_field: "driven_adapters", helper_fn: "parse_driven_adapter", dispatch_comment: "Sprint 14 first-adapter slice — the event-subscription form\n  adapter \"Name\" do\n    driven on \"Context::Aggregate.Event\" do |event|\n      dispatch \"Context::Aggregate.Command\", attr: value\n    end\n  end\nStarts with `adapter \"` (quoted name). Captured as a typed\nDrivenAdapter so the runtime's `resolve_driven_adapters` can\nfire the follow-on dispatch when the bus publishes the named\nevent. Coexists with the legacy `adapter :symbol, ...` form\nhandled by `absorb_adapter` below ; the two are dispatched on\nthe very first character after `adapter ` (quote vs colon).", order: 7
    fixture "Adapter",        parser: "hecksagon_parser", starts_with: "adapter ,adapter(",    handler_kind: "multiline_adapter",                  target_field: "",              helper_fn: "absorb_adapter", order: 8
  end

  # ── ParserHelper — private helpers emitted verbatim via body_snippet ──
  aggregate "ParserHelper" do
    fixture "AbsorbAdapter",     parser: "hecksagon_parser", name: "absorb_adapter",     doc_comment: "/// Take one joined `adapter …` invocation and sort it into the right\n/// bucket: persistence, io adapter, or shell adapter.", signature: "fn absorb_adapter(joined: &str, hex: &mut Hecksagon)", body_snippet: "codegen/hecksagon_parser_shape/snippets/absorb_adapter_body.rs.frag", order: 1
    fixture "ParseLlmAdapter",   parser: "hecksagon_parser", name: "parse_llm_adapter",   doc_comment: "/// Map `name:, prompt_template:, model:, max_tokens:, trigger_on:,\n/// response_into:, attr:, backend:` into an LlmAdapter. Returns None\n/// when no `name:` is declared — that lets the caller fall back to\n/// io_adapter routing for the bare `adapter :llm, backend: :X` form\n/// already in production.\n///\n/// i228 — `trigger_on \"Aggregate.Command\"` decouples the dispatch\n/// target that fires the adapter from `response_into` (which routes\n/// the LLM's reply). Falls back to `response_into_target` at runtime\n/// when absent, preserving the historical self-triggering shape.", signature: "fn parse_llm_adapter(rest: &str) -> Option<LlmAdapter>", body_snippet: "codegen/hecksagon_parser_shape/snippets/parse_llm_adapter_body.rs.frag", order: 2
    fixture "ParseComputeAdapter", parser: "hecksagon_parser", name: "parse_compute_adapter", doc_comment: "/// i220 sub-gap 5 (compute-adapter-primitive) — parse the named-adapter form\n/// `adapter :compute, name: :foo, function: \"fn_name\", trigger_on:,\n/// response_into:, attr:` into a ComputeAdapter. Returns None when\n/// `name:` is absent — the caller falls back to io_adapter routing\n/// for any bare `:compute` form (forwards-compat, mirrors\n/// parse_llm_adapter's contract).", signature: "fn parse_compute_adapter(rest: &str) -> Option<ComputeAdapter>", body_snippet: "codegen/hecksagon_parser_shape/snippets/parse_compute_adapter_body.rs.frag", order: 3
    fixture "ParseTtsAdapter",   parser: "hecksagon_parser", name: "parse_tts_adapter",   doc_comment: "/// i-tts — sibling of parse_llm_adapter / parse_compute_adapter. Parse the named-adapter form `adapter :tts, name: :foo, provider: :elevenlabs, voice_id:, model:, speed:, stability:, similarity_boost:, style:, trigger_on:, cache_dir:, auto_play:` into a TtsAdapter. Returns None when `name:` is absent — the caller falls back to io_adapter routing for any bare `:tts` form (forwards-compat, mirrors parse_compute_adapter). `:tts` is fire-and-forget (`response_field :none`) so there is no response_into / attr pair.", signature: "fn parse_tts_adapter(rest: &str) -> Option<TtsAdapter>", body_snippet: "codegen/hecksagon_parser_shape/snippets/parse_tts_adapter_body.rs.frag", order: 4
    fixture "ParseShellAdapter", parser: "hecksagon_parser", name: "parse_shell_adapter", doc_comment: "/// Map `name:, command:, args:, output_format:, timeout:, working_dir:,\n/// env:, ok_exit:` into a ShellAdapter. Handles the convenience form\n/// `command: \"git rev-parse {{ref}}\"` (no separate args vector) by\n/// splitting on whitespace.", signature: "fn parse_shell_adapter(rest: &str) -> Option<ShellAdapter>", body_snippet: "codegen/hecksagon_parser_shape/snippets/parse_shell_adapter_body.rs.frag", order: 5
    fixture "ParseGate",         parser: "hecksagon_parser", name: "parse_gate",         doc_comment: "/// `gate \"Agg\", :role do allow :A, :B end` — single-line or block form.", signature: "fn parse_gate(lines: &[&str]) -> (Option<Gate>, usize)", body_snippet: "codegen/hecksagon_parser_shape/snippets/parse_gate_body.rs.frag", order: 6
    fixture "JoinAdapterLines",  parser: "hecksagon_parser", name: "join_adapter_lines", doc_comment: "/// Join `adapter …` lines until the parens/brackets balance. Returns\n/// the joined one-line form and the number of source lines consumed.", signature: "fn join_adapter_lines(lines: &[&str]) -> (String, usize)", body_snippet: "codegen/hecksagon_parser_shape/snippets/join_adapter_lines_body.rs.frag", order: 7
    fixture "ParseDrivenAdapter", parser: "hecksagon_parser", name: "parse_driven_adapter", doc_comment: "/// Sprint 14 first-adapter slice — parse the block form :\n///\n/// ```text\n/// adapter \"Name\" do\n///   driven on \"Context::Aggregate.Event\" do |event|\n///     dispatch \"Context::Aggregate.Command\", attr: \"value\"\n///   end\n/// end\n/// ```\n///\n/// Returns (Some(DrivenAdapter), lines_consumed). When the block is\n/// malformed (no name, no closing end) returns None plus a best-effort\n/// consumed count so the caller advances past the noise.", signature: "fn parse_driven_adapter(lines: &[&str]) -> (Option<DrivenAdapter>, usize)", body_snippet: "codegen/hecksagon_parser_shape/snippets/parse_driven_adapter_body.rs.frag", order: 8
    fixture "ParseDrivenHandler", parser: "hecksagon_parser", name: "parse_driven_handler", doc_comment: "/// Parse one `driven on \"Event\" do |e| dispatch \"X.Y\", k: v ... end`\n/// block. Returns (Some(DrivenHandler), lines_consumed).", signature: "fn parse_driven_handler(lines: &[&str]) -> (Option<DrivenHandler>, usize)", body_snippet: "codegen/hecksagon_parser_shape/snippets/parse_driven_handler_body.rs.frag", order: 9
    fixture "JoinDispatchLines",  parser: "hecksagon_parser", name: "join_dispatch_lines", doc_comment: "/// Join continuation lines for a `dispatch` call until a top-level\n/// non-comma terminator. Mirrors `join_adapter_lines` but stops at the\n/// natural end of one call (no `do`/`end` block ; dispatch is a single\n/// expression).", signature: "fn join_dispatch_lines(lines: &[&str]) -> (String, usize)", body_snippet: "codegen/hecksagon_parser_shape/snippets/join_dispatch_lines_body.rs.frag", order: 10
    fixture "ParseDrivenDispatch", parser: "hecksagon_parser", name: "parse_driven_dispatch", doc_comment: "/// Parse a joined `dispatch \"FQN\", k1: v1, k2: v2` line into a\n/// DrivenDispatch. The first quoted string is the command FQN ; the\n/// remaining options are the static attrs. Returns None when no FQN.", signature: "fn parse_driven_dispatch(joined: &str) -> Option<DrivenDispatch>", body_snippet: "codegen/hecksagon_parser_shape/snippets/parse_driven_dispatch_body.rs.frag", order: 11
    fixture "ParseCannedBlock", parser: "hecksagon_parser", name: "parse_canned_block", doc_comment: "/// Sprint 14 memory-canned-defaults — parse a `canned do ... end`\n/// block inside a `driven on` handler. Captures inner `key value` lines\n/// (e.g. `output \"ack\"`, `exit_code 0`) into CannedResponse.values\n/// verbatim ; the resolver translates per-attr at fire time.", signature: "fn parse_canned_block(lines: &[&str]) -> (Option<CannedResponse>, usize)", body_snippet: "codegen/hecksagon_parser_shape/snippets/parse_canned_block_body.rs.frag", order: 12
    fixture "ParseCannedKv",    parser: "hecksagon_parser", name: "parse_canned_kv",    doc_comment: "/// Sprint 14 memory-canned-defaults — parse one `key value` line\n/// from inside a `canned do ... end` block. Keeps the raw value-token\n/// so the resolver's build_attr_map applies the same conversion rule\n/// the dispatch attrs already use.", signature: "fn parse_canned_kv(line: &str) -> Option<(String, String)>", body_snippet: "codegen/hecksagon_parser_shape/snippets/parse_canned_kv_body.rs.frag", order: 13
  end
end
