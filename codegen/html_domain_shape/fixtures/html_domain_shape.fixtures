    fixture "LegacyModulesSection", name: "legacy_modules",  order: 4, body_kind: "verbatim_section", snippet_path: "codegen/html_domain_shape/snippets/04_legacy_modules.rs.frag", description: "Legacy module-card system — module_navbar, module_card, command_section, wizard_button, inline_form. The earlier per-aggregate accordion UI ; kept around for re-introduction even though the live page now uses creation_cards instead"
