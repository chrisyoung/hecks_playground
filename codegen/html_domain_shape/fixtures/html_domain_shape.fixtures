  # for all four sections today (mirrors assemble_shape /
  # discover_shape / behaviors_fixtures_shape / parser_shape).

  aggregate "Section" do
    fixture "PageSection",          name: "page",            order: 1, body_kind: "verbatim_section", snippet_path: "codegen/html_domain_shape/snippets/01_page.rs.frag",            description: "generate_domain_page (top-level entry — title, vision, usage, creation cards, divider, records) + creation_cards (grid of per-aggregate cards) + aggregate_form (unified form merging entity-create and value-object child commands)"
    fixture "HelpersSection",       name: "helpers",         order: 2, body_kind: "verbatim_section", snippet_path: "codegen/html_domain_shape/snippets/02_helpers.rs.frag",         description: "field_input (one input element per command attribute) + command_palette (#[allow(dead_code)] Glass palette — fuzzy command search with inline form ; kept verbatim for future re-introduction)"
