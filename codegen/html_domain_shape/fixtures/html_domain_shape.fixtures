  # each snippet's raw body in `order` ascending. read_snippet_raw is
  # used (not read_snippet_body) so the trailing blank line at each
  # snippet's end is preserved verbatim — that's how the section
  # separators land in the emitted file. body_kind = verbatim_section
  # for all three sections today (mirrors assemble_shape /
  # discover_shape / behaviors_fixtures_shape / parser_shape).
  #
  # 2026-05-11 : LegacyModulesSection retired. The earlier per-
  # aggregate accordion UI (module_navbar, module_card,
  # command_section, wizard_button, inline_form) was hand-removed
  # from the tracked rust/src/server/html_domain.rs ; specializer
  # output now matches.

  aggregate "Section" do
    fixture "PageSection",          name: "page",            order: 1, body_kind: "verbatim_section", snippet_path: "codegen/html_domain_shape/snippets/01_page.rs.frag",            description: "generate_domain_page (top-level entry — title, vision, usage, creation cards, divider, records) + creation_cards (grid of per-aggregate cards) + aggregate_form (unified form merging entity-create and value-object child commands)"
    fixture "HelpersSection",       name: "helpers",         order: 2, body_kind: "verbatim_section", snippet_path: "codegen/html_domain_shape/snippets/02_helpers.rs.frag",         description: "field_input (one input element per command attribute) + command_palette (#[allow(dead_code)] Glass palette — fuzzy command search with inline form ; kept verbatim for future re-introduction)"
    fixture "RecordsTableSection",  name: "records_table",   order: 3, body_kind: "verbatim_section", snippet_path: "codegen/html_domain_shape/snippets/03_records.rs.frag",         description: "records_table — wraps html_fixtures::fixtures_section with an empty-state placeholder when the domain has no records yet"
  end
