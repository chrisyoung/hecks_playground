    # i254 — views per role. View carries a name + an ordered list of
    # field projections ; `show_all` flag means "include every aggregate
    # attribute, then append the listed extras". Different portals
    # (customer / driver / admin) read the same aggregate through
    # different views without per-portal field-list drift.
    fixture "View", name: "View", order: 36, body_kind: "struct", derives: "Debug, Clone", impl_target: "", body_snippet: "", doc_snippet: "codegen/ir_shape/snippets/docs/view_type.rs.frag", description: "Named view — ordered field projection of an aggregate, scoped by role"

