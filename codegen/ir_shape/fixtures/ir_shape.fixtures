Hecks.fixtures "IrShape" do
  # Single-line fixtures per i57 parser limitation.

  # ── Type — 20 top-level items in ir.rs (18 structs + 1 enum + 1 impl) ──
  aggregate "Type" do
    # Domain — root of the parsed bluebook tree, holds aggregates / policies / fixtures / sections / process_managers.
    fixture "Domain", name: "Domain", order: 1, body_kind: "struct", derives: "Debug, Clone", impl_target: "", body_snippet: "", doc_snippet: "", description: "Root IR node — holds the parsed bluebook tree"

    # i76 cadence + i218 block_grammar — Cadence / CadenceDispatch /
    # BlockGrammar / BlockGrammarEntry / BlockParser. impl BlockParser
    # supplies from_name + name() ; impl BlockGrammar supplies the
    # canonical_bluebook() bootstrap. The free `fn entry()` helper sits
    # between the two impls and the next struct ; it lands as a
    # verbatim_section row.
    fixture "Cadence",            name: "Cadence",            order: 2, body_kind: "struct", derives: "Debug, Clone", impl_target: "", body_snippet: "", doc_snippet: "codegen/ir_shape/snippets/docs/cadence_type.rs.frag",            description: "One declared cadence — interval + ordered dispatches"
    fixture "CadenceDispatch",    name: "CadenceDispatch",    order: 3, body_kind: "struct", derives: "Debug, Clone", impl_target: "", body_snippet: "", doc_snippet: "codegen/ir_shape/snippets/docs/cadence_dispatch_type.rs.frag",   description: "One scheduled dispatch within a cadence"
    fixture "BlockGrammar",       name: "BlockGrammar",       order: 4, body_kind: "struct", derives: "Debug, Clone", impl_target: "", body_snippet: "", doc_snippet: "codegen/ir_shape/snippets/docs/block_grammar_type.rs.frag",       description: "One declared block grammar — keyword routing for the parser"
    fixture "BlockGrammarEntry",  name: "BlockGrammarEntry",  order: 5, body_kind: "struct", derives: "Debug, Clone", impl_target: "", body_snippet: "", doc_snippet: "codegen/ir_shape/snippets/docs/block_grammar_entry_type.rs.frag", description: "One keyword -> parser binding"
    fixture "BlockParser",        name: "BlockParser",        order: 6, body_kind: "enum",   derives: "Debug, Clone, Copy, PartialEq, Eq", impl_target: "", body_snippet: "", doc_snippet: "codegen/ir_shape/snippets/docs/block_parser_type.rs.frag", description: "Enum-keyed dispatch for block_grammar"
    fixture "ImplBlockParser",    name: "ImplBlockParser",    order: 7, body_kind: "impl",   derives: "", impl_target: "BlockParser",  body_snippet: "codegen/ir_shape/snippets/impls/block_parser.rs.frag",  doc_snippet: "", description: "from_name + name() round-trip"
    fixture "ImplBlockGrammar",   name: "ImplBlockGrammar",   order: 8, body_kind: "impl",   derives: "", impl_target: "BlockGrammar", body_snippet: "codegen/ir_shape/snippets/impls/block_grammar.rs.frag", doc_snippet: "", description: "canonical_bluebook bootstrap"
    fixture "FnEntry",            name: "FnEntry",            order: 9, body_kind: "verbatim_section", derives: "", impl_target: "", body_snippet: "codegen/ir_shape/snippets/impls/fn_entry.rs.frag", doc_snippet: "", description: "Free fn entry() helper for canonical_bluebook"

    # ProcessManager — Phase 3 dream-study addition. Static shape of an
    # event-driven state machine ; runtime instantiation is Ruby-side.
    fixture "ProcessManager", name: "ProcessManager", order: 10, body_kind: "struct", derives: "Debug, Clone", impl_target: "", body_snippet: "", doc_snippet: "codegen/ir_shape/snippets/docs/process_manager_type.rs.frag", description: "One declared process manager — name, correlates_by, starts/ends, states, handlers"

    # ProcessManagerHandler — one on-event handler inside a PM, with from→to transition.
    fixture "ProcessManagerHandler", name: "ProcessManagerHandler", order: 11, body_kind: "struct", derives: "Debug, Clone", impl_target: "", body_snippet: "", doc_snippet: "codegen/ir_shape/snippets/docs/process_manager_handler_type.rs.frag", description: "PM on-event handler — event_type + from_state + to_state"

    # i221 :llm adapter Phase 2 + Phase 2.b/2.c PM enrichment —
    # DispatchSpec + ValueSpec carry per-call attribute flow into
    # PM-driven dispatches. i221-A adds ForEachSpec as a sibling
    # struct ; DispatchSpec gains a `for_each: Option<ForEachSpec>`
    # field, ValueSpec gains a `FromIter` variant.
    fixture "DispatchSpec",  name: "DispatchSpec",  order: 12, body_kind: "struct", derives: "Debug, Clone", impl_target: "", body_snippet: "", doc_snippet: "codegen/ir_shape/snippets/docs/dispatch_spec_type.rs.frag", description: "One declarative dispatch with structured with-spec"
    fixture "ForEachSpec",   name: "ForEachSpec",   order: 13, body_kind: "struct", derives: "Debug, Clone", impl_target: "", body_snippet: "", doc_snippet: "codegen/ir_shape/snippets/docs/for_each_spec_type.rs.frag", description: "i221-A — sweep source on a DispatchSpec ; qualified Aggregate.query halves"
    fixture "ValueSpec",     name: "ValueSpec",     order: 14, body_kind: "enum",   derives: "Debug, Clone", impl_target: "", body_snippet: "", doc_snippet: "codegen/ir_shape/snippets/docs/value_spec_type.rs.frag",    description: "How a single with-attribute resolves at dispatch time"

    # Section — named section in a capability dashboard ; struct-level doc above the derive.
    fixture "Section", name: "Section", order: 15, body_kind: "struct", derives: "Debug, Clone", impl_target: "", body_snippet: "", doc_snippet: "codegen/ir_shape/snippets/docs/section_type.rs.frag", description: "One named section in a capability dashboard"

    # SectionRow — one (label, field) row inside a Section ; struct-level doc above the derive.
