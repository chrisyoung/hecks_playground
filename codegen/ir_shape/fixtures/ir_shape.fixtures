    fixture "Reference", name: "Reference", order: 26, body_kind: "struct", derives: "Debug, Clone", impl_target: "", body_snippet: "", doc_snippet: "", description: "Reference to another aggregate / entity"

    # Policy — event → command trigger.
    fixture "Policy", name: "Policy", order: 27, body_kind: "struct", derives: "Debug, Clone", impl_target: "", body_snippet: "", doc_snippet: "", description: "Policy — on event, trigger command"

    # Lifecycle — state field + default + transitions list.
    fixture "Lifecycle", name: "Lifecycle", order: 28, body_kind: "struct", derives: "Debug, Clone", impl_target: "", body_snippet: "", doc_snippet: "", description: "Lifecycle — state field, default state, transitions"

