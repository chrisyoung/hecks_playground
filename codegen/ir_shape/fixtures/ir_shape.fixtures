    fixture "Transition", name: "Transition", order: 29, body_kind: "struct", derives: "Debug, Clone", impl_target: "", body_snippet: "", doc_snippet: "", description: "Lifecycle transition — command takes the aggregate from from_state to to_state"

    # Fixture — seeded data record bound to an aggregate.
    fixture "Fixture", name: "Fixture", order: 30, body_kind: "struct", derives: "Debug, Clone", impl_target: "", body_snippet: "", doc_snippet: "", description: "Seeded data record"

    # i101 — first-class query IR. WhereClause / WhereOp / OrderBy /
    # Direction / LimitSpec extend Query with structured filter / sort /
    # cap fields so the runtime executor can walk repo.all() without
