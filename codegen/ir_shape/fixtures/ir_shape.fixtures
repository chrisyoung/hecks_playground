    # Attribute — name + Rust type (string) + default + list flag.
    fixture "Attribute", name: "Attribute", order: 18, body_kind: "struct", derives: "Debug, Clone", impl_target: "", body_snippet: "", doc_snippet: "", description: "Single attribute on an aggregate / value object / entity"

