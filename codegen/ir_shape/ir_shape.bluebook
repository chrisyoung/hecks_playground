Hecks.bluebook "IrShape", version: "2026.05.12.2" do
  vision "The shape of storehouse/src/ir.rs as a bluebook — i147 Wave 4-C target. The canonical IR struct vocabulary that every downstream specializer (parser, dump, behaviors_parser, hecksagon_parser, fixtures_parser) reads to bind against field names and types. Making this declarative closes the stale-coupling risk : adding a struct field is a fixture-row edit, not a Rust hand-edit + cascading specializer chase."
  category "autophagy"

  # ============================================================
  # IR SHAPE — i147 Wave 4-C target (REAL compression)
  # ============================================================
  #
  # ir.rs defines the Domain IR — 16 structs + 1 enum + 1 impl that
  # form the canonical vocabulary of a parsed bluebook. Every other
  # Rust file in storehouse ultimately reads or writes one of these
  # structs : the parser builds them, dump.rs serializes them, the
  # validators inspect them, the runtime mutates them.
  #
  # That central position is exactly why this retirement matters and
  # why it had to wait until Wave 4 : a typo in any field name or type
  # ripples across every downstream consumer at compile time. The W4-C
  # discipline says : encode every struct as a Type row + N Field rows,
  # every enum as a Type row + N Variant rows, every impl as a Type row
  # + verbatim body snippet. The specializer walks the rows and emits.
  #
  # Layer mapping (mirrors dump_shape / driven_adapter_shape) :
  #   L0 = this file + fixtures/ir_shape.fixtures + snippets/**/*.rs.frag
  #   L1 = canonical_ir representation of this file
  #   L7 = storehouse/src/ir.rs (generated target)
  #
  # Body_kind vocabulary :
  #
  #   struct          — emit `#[derive(<derives>)]\npub struct <Name> {\n
  #                     <fields>\n}\n`. Fields come from Field rows
  #                     filtered by type_name == this row's name, sorted
  #                     by order. Each field's optional doc_snippet is
  #                     prepended verbatim before the field declaration.
  #
  #   enum            — emit `#[derive(<derives>)]\npub enum <Name> {\n
  #                     <variants>\n}\n`. Variants come from Variant
  #                     rows filtered by type_name. Each variant's
  #                     optional doc_snippet is prepended verbatim.
  #
  #   impl            — emit `impl <impl_target> {\n<body_snippet>\n}\n`.
  #                     Body comes verbatim from the snippet ; impl
  #                     bodies are too bespoke to compress further. (This
  #                     differs from `verbatim_section` because it carries
  #                     impl-specific knobs : impl_target picks the trait
  #                     and the type. One impl row per impl block.)
  #
  #   verbatim_section — emit body_snippet contents verbatim, with no
  #                     wrapping. Used for free functions / other items
  #                     that don't fit struct/enum/impl (e.g. the
  #                     `fn entry()` helper between BlockGrammar's impl
  #                     and ProcessManager's struct definition).
  #
  # Type-level doc comments (above the `#[derive(...)]` line) are an
  # optional doc_snippet on the Type row itself. Most structs don't have
  # one ; Section and SectionRow do.
  #
  # Cross-consumer stale-coupling closure (door this opens) :
  # downstream specializers that today bind to Rust struct field names
  # by string literal (e.g., `dump_aggregate` rows reference "context"
  # and "identified_by") could in principle consult ir_shape's Field
  # rows to derive their own field knowledge. That refactor is out of
  # scope for this PR but the IR-as-data IS the prerequisite.
  #
  # ============================================================
  # Single-aggregate shape per Chris's "no bluebooks without commands"
  # principle (2026-05-12). The three row-types — Type, Field,
  # Variant — collapse to value_objects on the IrShape root ; the row
  # catalog lives in the sibling fixtures file. EmitIr is the
  # semantic command — given the row set, emit storehouse/src/ir.rs as
  # a single Rust source string.

  aggregate "IrShape", "Static schema for the ir.rs codegen target — Type + Field + Variant rows live in the sibling fixtures file" do
    identified_by :target_rs

    # ---- TargetRs ----------------------------------------------------

    value_object "TargetRs" do
      attribute :value, String
      invariant "must end in .rs" do
        value.end_with?(".rs")
      end
    end

    # ---- EmittedRs ---------------------------------------------------

    value_object "EmittedRs" do
      attribute :value, String
    end

    # ---- Type --------------------------------------------------------
    #
    # One top-level item in ir.rs — struct / enum / impl.

    value_object "Type" do
      description "One top-level item in ir.rs — struct / enum / impl"
      attribute :name,         String
      # order: emission order in the .rs file
      attribute :order,        Integer
      # body_kind: struct | enum | impl
      attribute :body_kind,    String
      # derives: comma-separated list inside `#[derive(...)]` ; empty for impl
      attribute :derives,      String
      # impl_target: for body_kind=impl ; the `impl <X> for <Y>` portion,
      # written verbatim (e.g. "fmt::Display for Domain"). Empty for
      # struct / enum rows.
      attribute :impl_target,  String
      # body_snippet: for body_kind=impl only ; relative path (under repo
      # root) to a .rs.frag holding the impl body — everything between the
      # opening `{` and closing `}`, indented as it should appear, NOT
      # including the braces themselves.
      attribute :body_snippet, String
      # doc_snippet: optional ; relative path to a .rs.frag holding the
      # doc comment that precedes `#[derive(...)]` (or `impl`) for this
      # Type. Verbatim — including trailing newline. Empty when no doc.
      attribute :doc_snippet,  String
      # description: prose for humans reading the bluebook ; not emitted.
      attribute :description,  String
    end

    # ---- Field -------------------------------------------------------
    #
    # One pub field inside a struct row — order driven by 'order'.

    value_object "Field" do
      description "One pub field inside a struct row — order driven by 'order'"
      # type_name: foreign-key-like link to Type.name (struct name)
      attribute :type_name,    String
      # order: position within the struct's field list (1-based)
      attribute :order,        Integer
      # name: field name (snake_case)
      attribute :name,         String
      # field_type: Rust type written verbatim — e.g. "String",
      # "Option<String>", "Vec<Aggregate>", "Vec<(String, String)>"
      attribute :field_type,   String
      # doc_snippet: optional ; relative path to a .rs.frag holding the
      # doc comment that precedes this field. Already 4-space indented to
      # match the field. Verbatim. Empty when no doc.
      attribute :doc_snippet,  String
    end

    # ---- Variant -----------------------------------------------------
    #
    # One variant in an enum row.

    value_object "Variant" do
      description "One variant in an enum row"
      # type_name: foreign-key-like link to Type.name (enum name)
      attribute :type_name,    String
      # order: position within the enum's variant list (1-based)
      attribute :order,        Integer
      # name: variant identifier
      attribute :name,         String
      # body: optional struct-variant payload, written verbatim — e.g.
      # `{ value: String }`. The specializer emits `Name <body>,` when
      # body is non-empty, `Name,` otherwise. Empty by default for the
      # common bare-variant case.
      attribute :body,         String
      # doc_snippet: optional ; relative path to a .rs.frag holding the
      # doc comment that precedes this variant. Already 4-space indented.
      # Empty when no doc.
      attribute :doc_snippet,  String
    end

    attribute :target_rs, TargetRs

    # ── Commands ───────────────────────────────────────────────

    command "EmitIr" do
      role "Autophagy"
      description "Walk Type rows in `order` ascending. For struct rows, emit `#[derive(<derives>)] pub struct <name> { <fields> }` where fields come from Field rows filtered by type_name == this Type.name, sorted by order. For enum rows, emit `#[derive(<derives>)] pub enum <name> { <variants> }` where variants come from Variant rows filtered by type_name. For impl rows, emit `impl <impl_target> { <body_snippet contents> }`. For verbatim_section rows, emit body_snippet contents raw. Prepend each Type/Field/Variant row's doc_snippet when present. Concatenate the rendered types and return the bytes the caller writes to TargetRs. Byte-identical against the hand-written storehouse/src/ir.rs at i147 W4-C."
      attribute :target_rs, TargetRs
      emits "IrEmitted"
      then_set :target_rs, to: :target_rs
    end
  end
end
