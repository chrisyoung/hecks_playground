Hecks.bluebook "ParserHelpersShape", version: "2026.05.01.1" do
  vision "The shape of rust/src/parser_helpers.rs as a bluebook — the string-extraction + snake_case + shorthand-detection helper grab-bag the bluebook parser leans on. Decomposes into five ordered Section rows (extract helpers / to_snake_case / snake_case_tests / shorthand tables / shorthand parsers) emitted as verbatim_section snippets under a HEADER const that carries the 4-line doc comment. body_kind decision : verbatim_section (reuse) — every section is a partition of related fns / consts / tests, the repetition is at expression-level inside each fn (the find('\"') / `.trim()` idiom) which is too fine-grained to fixturise without exploding row count for marginal gain. Mirrors discover_shape, behaviors_fixtures_shape, parser_shape, parse_blocks_shape, assemble_shape — every section-as-snippet sibling. Promote to a body_kind when a second consumer arrives that wants the SAME helper bodies."
  category "autophagy"

  # ============================================================
  # PARSER HELPERS SHAPE — i147 Wave 9-B target
  # ============================================================
  #
  # rust/src/parser_helpers.rs is the helper grab-bag the bluebook
  # parser uses : string extraction primitives (extract_string,
  # extract_symbol, extract_block, …), the to_snake_case routine
  # plus its #[cfg(test)] tests, and the shorthand-syntax detector
  # + parser family (is_shorthand_line / is_shorthand_command /
  # parse_shorthand_attribute / parse_shorthand_reference, plus the
  # ShorthandResult enum + parse_shorthand dispatcher).
  #
  # Wave 9-B retires the AUTHORED Rust file — the runtime stays at
  # rust/src/parser_helpers.rs but is regenerated byte-for-byte
  # from this shape's fixtures + snippets.
  #
  # Layer mapping :
  #   L0 = this file + fixtures/parser_helpers_shape.fixtures
  #        + snippets/*.rs.frag
  #   L1 = canonical_ir representation of this file
  #   L7 = rust/src/parser_helpers.rs (generated)
  #
  # One aggregate :
  #
  #   Section — one row per ordered top-level partition in
  #             parser_helpers.rs. body_kind picks the emitter ;
  #             today only verbatim_section is used :
  #
  #               verbatim_section — read snippet_path raw,
  #                                  preserves trailing blank
  #                                  line as the section
  #                                  separator. Mirrors
  #                                  assemble_shape's pattern.
  #
  #             The HEADER const inside the specializer carries
  #             the 4-line doc comment (lines 1-5 of the source,
  #             ending with the blank line that follows the
  #             closing `//!`). Five Section rows cover the
  #             rest :
  #
  #               1. extract_helpers     (extract_string,
  #                                       extract_second_string,
  #                                       extract_symbol,
  #                                       extract_word_after,
  #                                       extract_block,
  #                                       extract_after,
  #                                       extract_state_token,
  #                                       ends_with_do_block)
  #               2. to_snake_case       (the case-conversion fn
  #                                       with its acronym-handling
  #                                       doc comment)
  #               3. snake_case_tests    (the #[cfg(test)] mod
  #                                       block with 14 case rows)
  #               4. shorthand_tables    (the section header
  #                                       comment + SHORTHAND_TYPES
  #                                       + KEYWORDS const tables)
  #               5. shorthand_parsers   (is_shorthand_line,
  #                                       is_shorthand_command,
  #                                       parse_shorthand_attribute,
  #                                       parse_shorthand_reference,
  #                                       ShorthandResult enum,
  #                                       parse_shorthand dispatcher)
  #
  # Body_kind decision (recorded in `vision` above) : reuse
  # verbatim_section rather than invent extract_helper or
  # shorthand_parser kinds. The string-extraction idiom is
  # genuine repetition (find quote, slice between quotes, …) but
  # each fn diverges enough at the edges (default kwarg parsing,
  # acronym detection, role-vs-as kwarg disambiguation) that
  # parameterising it would balloon the body_kind into a
  # mini-language. When a second consumer of these helpers shows
  # up — most likely a future behaviors_parser successor or a new
  # mini-DSL parser — promote the most-reused chunks (the
  # find-then-slice quote pair) into a shared snippet pool ;
  # today they live verbatim under sections 1 and 5.
  #
  # REAL compression today : modest — five section rows + a
  # HEADER const replace 328 hand-edited LoC with five stable
  # .rs.frag files. Adding a new extract helper is a snippet
  # edit ; reordering the to_snake_case / tests / shorthand
  # grouping is a fixture-row reorder. Real compression arrives
  # when the find-then-slice idiom moves out into its own
  # body_kind shared across parser_helpers, the runtime
  # coercers, and any future micro-parser — that's the W10+
  # payoff.

  aggregate "Section", "One ordered top-level partition in parser_helpers.rs" do
    attribute :name,         String
    # order: ascending integer ; specializer sorts before concatenating.
    attribute :order,        Integer
    # body_kind: verbatim_section (today's only kind).
    attribute :body_kind,    String
    # snippet_path: required for verbatim_section ; path is repo-rooted.
    attribute :snippet_path, String, default: ""
    # description: prose for humans reading the bluebook ; not emitted.
    attribute :description,  String, default: ""
  end
end
