Hecks.bluebook "RepositoryShape", version: "2026.05.01.1" do
  vision "Shape of rust/src/runtime/repository.rs — in-memory aggregate store with heki persistence. Id dispatch is driven by identified_by from the aggregate's own IR: when set, id_for_command reads attrs[identified_by] as the natural key; when absent, mints a u64 counter. The trivial-accessor family (find, find_mut, all, count) compresses into a single store_accessor_block body_kind plus four Accessor rows — REAL compression on the shape's most uniform surface."
  category "autophagy"

  # ============================================================
  # REPOSITORY SHAPE — i147 Wave 1 + Wave 5-C
  # ============================================================
  #
  # The Repository stores AggregateState instances keyed by id
  # and persists them to a .heki store on every save.
  #
  # Id dispatch — id_for_command(attrs):
  #
  #   natural_key   — aggregate declares `identified_by :field`.
  #                   id_for_command reads attrs[field] and returns
  #                   it as the id. Enables find-or-create by natural
  #                   key (e.g. inbox.Item identified_by :ref).
  #
  #   singleton     — aggregate has no identified_by AND the store is
  #                   non-empty. id_for_command returns the first
  #                   existing key, so all dispatches land on the same
  #                   record. This is the correct behavior for organ
  #                   aggregates (Heartbeat, Tick, Pulse) that have
  #                   exactly one record and no natural key.
  #
  #   counter_mint  — aggregate has no identified_by AND the store is
  #                   empty. id_for_command mints a fresh u64 counter
  #                   value. The first dispatch creates the singleton
  #                   record; subsequent dispatches hit singleton mode.
  #
  # All three branches live in id_for_command. The Repository struct
  # carries `identified_by: Option<String>` set at construction time
  # from agg.identified_by in the aggregate IR. No adapter option
  # read, no fixture rows — the aggregate's own bluebook is the
  # adapter. Declaring `identified_by` is the upgrade path from
  # singleton to natural-key dispatch; absence means singleton.
  #
  # ## Wave 5-C : the trivial-accessor compression
  #
  # Four read-only methods — find, find_mut, all, count — share one
  # honest shape :
  #
  #   pub fn <name>(<receiver>[, <arg>]) -> <ret> {
  #       self.store.<call>
  #   }
  #
  # Wave 5-C captures that uniformity by introducing one body_kind
  # (`store_accessor_block`) that the specializer reads from four
  # `Accessor` rows. Each row carries the per-method knobs (name,
  # receiver, arg, ret, accessor_kind) ; the specializer assembles the
  # method bodies from the kind vocabulary :
  #
  #   value_get        — `self.store.get(id)`         (find)
  #   value_get_mut    — `self.store.get_mut(id)`     (find_mut)
  #   values_collect   — `self.store.values().collect()`  (all)
  #   len              — `self.store.len()`           (count)
  #
  # 4 methods → 1 body_kind handler with 4 row entries. The 4 dedicated
  # `.rs.frag` files retire — bodies live as 4 lines of Rust template
  # inside the specializer, parameterized by the row knobs.
  #
  # The load-bearing I/O methods (load_persisted, save, delete,
  # id_for_command, new_with_context, heki_path_self) keep their
  # per-method snippets because their bodies are honestly sui-generis :
  # heki migration logic, snapshot orchestration, natural-key dispatch,
  # context-prefixed path resolution. Compressing them would be
  # over-fitting ; their per-method snippets are correct.
  #
  # Layer mapping:
  #   L0 = this file + fixtures/repository_shape.fixtures + snippets/*.rs.frag
  #   L1 = canonical_ir of this file
  #   L7 = rust/src/runtime/repository.rs (specializer target)

  aggregate "RepositoryConfig", "Fixed surface of the Repository struct — field and method names consumed by the specializer to emit repository.rs" do
    attribute :struct_name,          String, default: "Repository"
    # id_fn_name: the public method that resolves an id from command attrs
    attribute :id_fn_name,           String, default: "id_for_command"
    # counter_field: the u64 struct field that mints ids when identified_by is absent
    attribute :counter_field,        String, default: "next_id"
    # store_field: the HashMap<String, AggregateState> field
    attribute :store_field,          String, default: "store"
    # identified_by_field: the Option<String> struct field carrying the natural-key attr name
    attribute :identified_by_field,  String, default: "identified_by"
  end

  aggregate "Accessor", "One trivial accessor on Repository ; emitted by the store_accessor_block body_kind" do
    # name: method name as it appears in `pub fn <name>(…)`. find,
    # find_mut, all, count.
    attribute :name,           String
    # order: ascending integer ; specializer sorts before emitting so
    # the method order stays stable across edits to row text.
    attribute :order,          Integer
    # accessor_kind: picks the one-liner body template.
    #   value_get        — `self.store.get(id)`
    #   value_get_mut    — `self.store.get_mut(id)`
    #   values_collect   — `self.store.values().collect()`
    #   len              — `self.store.len()`
    attribute :accessor_kind,  String
    # receiver: the `self` form. `&self` or `&mut self`.
    attribute :receiver,       String
    # arg: the argument list excluding the receiver. `id: &str` for
    # find / find_mut ; empty string for all / count (no args).
    attribute :arg,            String, default: ""
    # ret: the return type after the `->` arrow. e.g.
    # `Option<&AggregateState>`, `Vec<&AggregateState>`, `usize`.
    attribute :ret,            String
  end
end
