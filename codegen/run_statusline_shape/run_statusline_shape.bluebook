Hecks.bluebook "RunStatuslineShape", version: "2026.05.01.1" do
  vision "The shape of rust/src/run_statusline.rs as a bluebook — Miette's one-line body status runner made declarative. Each top-level partition (header / imports / runtime / icon tables / format helpers / tests) is a Phase row ; the three glyph-lookup functions (mood_icon_for / fatigue_icon_for / provider_badge_for) emit from StringMatchArm rows. Adding a new mood glyph or reordering a phase becomes a fixture-row edit, not a hand-edit to run_statusline.rs."
  category "autophagy"

  # ============================================================
  # RUN STATUSLINE SHAPE — i147 Wave 7 target
  # ============================================================
  #
  # rust/src/run_statusline.rs is THE statusline runner. Every
  # `storehouse statusline` invocation reads body heki via :fs,
  # branches on consciousness state (sleep / awake / coherence-
  # degraded), composes a single line, and prints to :stdout.
  # Wave 7 retires the AUTHORED Rust file — the runtime stays at
  # rust/src/run_statusline.rs, but is regenerated byte-for-byte
  # from this shape's fixtures + snippets.
  #
  # Layer mapping :
  #   L0 = this file + fixtures/run_statusline_shape.fixtures
  #        + snippets/*.rs.frag
  #   L1 = canonical_ir representation of this file
  #   L7 = rust/src/run_statusline.rs (generated)
  #
  # Three aggregates :
  #
  #   CapabilityDetector — single row describing the runner gate :
  #                        which adapters this runner uses (fs +
  #                        stdout) and which capability it satisfies
  #                        (Statusline.Render). Carried for parity
  #                        with capability_runner_shape's contract ;
  #                        not consulted by the byte-identity emitter
  #                        today, but documents WHAT the runner is.
  #
  #   Phase    — one row per ordered top-level partition in
  #              run_statusline.rs. body_kind picks the emitter :
  #
  #                doc_block      — read snippet_path raw ; preserves
  #                                 leading `//!` lines (no comment
  #                                 strip pass). Used today by header.
  #
  #                imports_block  — read snippet_path raw, leading
  #                                 blank + `use ...;` lines. Used by
  #                                 imports phase.
  #
  #                verbatim_body  — read snippet_path raw ; bulk
  #                                 runtime body. Used by runtime
  #                                 (run + paths + State + read_state
  #                                 + coherence + animation tables +
  #                                 render_sleep + render_awake) and
  #                                 format_helpers (format_beats +
  #                                 read_last_dispatch).
  #
  #                string_match   — declarative `match <param> { … }`
  #                                 body with padded arms ; arms read
  #                                 from StringMatchArm rows whose
  #                                 `function` matches Phase.name.
  #                                 Used by mood_icon_for,
  #                                 fatigue_icon_for, and
  #                                 provider_badge_for.
  #
  #                tests_block    — read snippet_path raw ; the
  #                                 trailing `#[cfg(test)] mod tests
  #                                 { … }` block.
  #
  #              The four snippet body_kinds (doc_block, imports_block,
  #              verbatim_body, tests_block) collapse to one emitter
  #              today (read raw, no transform). They stay distinct in
  #              the bluebook so the taxonomy is explicit ; future
  #              refactors split verbatim_body further (read_heki,
  #              compose_template, static_data, branch_compose) so the
  #              animation tables and render branches become first-
  #              class body_kinds rather than inline source.
  #
  #   StringMatchArm — one row per match arm in the three icon-lookup
  #                    functions. `function` selects which fn the arm
  #                    belongs to ; `pattern` is the literal to match
  #                    (or "_" for the wildcard) ; `result` is the
  #                    returned `&'static str` content (without
  #                    surrounding quotes — the specializer wraps them
  #                    at emit time) ; optional `comment` appends a
  #                    trailing `// …` after the arm value. The
  #                    matching Phase row carries a `min_gap` knob :
  #                    per-fn whitespace gap between widest pattern
  #                    and `=>`. Hand-formatted source chose 1 for
  #                    mood/provider, 2 for fatigue ; declared
  #                    explicitly so the layout choice survives
  #                    codegen. Padding aligns each arm's `=>` so the
  #                    longest pattern's quoted form sets the column.
  #
  # REAL compression : the runner's structure — the ORDER of phases
  # and the SET of icon-table arms — is now data, not code. Adding a
  # new mood glyph is a single StringMatchArm row ; reordering the
  # render-sleep / render-awake split is a Phase row reorder.
  #
  # Relocation note (i147 W7) : the shape lived at cli/statusline/
  # for the capability_runner_shape pilot ; W7 relocates it to
  # codegen/run_statusline_shape/ to match the i147 wave-by-wave
  # convention (cli_dispatch_shape, behaviors_runner_shape,
  # repository_shape, etc. — every retired Rust file's shape lives
  # at codegen/<name>_shape/). The runtime Statusline domain
  # (cli/statusline/statusline.bluebook + statusline.hecksagon)
  # stays where it is — that describes the runtime capability, not
  # the codegen shape.

  aggregate "CapabilityDetector", "One row describing the runner gate ; adapters + capability it satisfies" do
    attribute :name,                String
    # required_adapters: comma-separated adapter names this runner uses
    # (fs, stdout). Carried for parity with capability_runner_shape's
    # detector contract ; not consulted by the byte-identity emitter.
    attribute :required_adapters,   String, default: ""
    # required_aggregates: comma-separated aggregate names this runner
    # satisfies (Statusline).
    attribute :required_aggregates, String, default: ""
    # required_commands: comma-separated command names this runner
    # implements (Render).
    attribute :required_commands,   String, default: ""
    # description: prose for humans reading the bluebook ; not emitted.
    attribute :description,         String, default: ""
  end

  aggregate "Phase", "One ordered top-level partition in run_statusline.rs ; body_kind picks emission" do
    attribute :name,           String
    # order: ascending integer ; specializer sorts before concatenating.
    attribute :order,          Integer
    # body_kind: doc_block | imports_block | verbatim_body | string_match | tests_block
    attribute :body_kind,      String
    # source_command: optional ; the bluebook command this phase
    # implements (today only the runtime phase carries Render). Not
    # consulted by the emitter ; documents the phase's domain
    # responsibility.
    attribute :source_command, String, default: ""
    # adapter_used: optional ; the adapter this phase touches at
    # runtime (fs / stdout / none). Not consulted by the emitter ;
    # documents the phase's adapter contract.
    attribute :adapter_used,   String, default: "none"
    # snippet_path: required for doc_block / imports_block /
    # verbatim_body / tests_block ; ignored for string_match.
    attribute :snippet_path,   String, default: ""
    # min_gap: per-fn whitespace gap between widest pattern and `=>`
    # for string_match phases. Hand-formatted source chose 1 for
    # mood/provider, 2 for fatigue ; declared per-row so the layout
    # choice survives codegen.
    attribute :min_gap,        Integer, default: 1
    # description: prose for humans reading the bluebook ; not emitted.
    attribute :description,    String, default: ""
  end

  aggregate "StringMatchArm", "One arm in an icon-lookup match block ; function selects fn membership" do
    # function: which fn this arm belongs to (mood_icon_for /
    # fatigue_icon_for / provider_badge_for). Matches the Phase.name
    # of the string_match phase that emits this fn.
    attribute :function, String
    # order: ascending integer ; specializer sorts before emitting
    # so arm order is stable across edits to row text.
    attribute :order,    Integer
    # pattern: the literal string to match (e.g. "refreshed", "alert")
    # or "_" for the wildcard. Specializer wraps literals in quotes
    # at emit time ; "_" is bare.
    attribute :pattern,  String
    # result: the returned `&'static str` content WITHOUT surrounding
    # quotes (specializer wraps them). Note : escape sequences like
    # \u{200d} ZWJ are stored escaped (\\u) so the parser emits a
    # literal backslash + u, which round-trips through Rust string
    # quoting back to the source's \u{200d} form.
    attribute :result,   String
    # comment: optional trailing `// <comment>` after the arm value.
    # Used today only by provider_badge_for's claude-default arm.
    attribute :comment,  String, default: ""
  end
end
