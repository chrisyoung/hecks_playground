  aggregate "BootPhase" do
    fixture "WireRepositories",
      name: "wire_repositories",
      order: 1,
      snippet_path: "codegen/runtime_shape/snippets/phase_1_wire_repositories.rs.frag",
      description: "Phase 1 — for-loop over domain.aggregates : compose (context, name) → key via repo_key, build Repository::new_with_context entries into the local repositories HashMap (i142 Tier 2)"

    fixture "WirePolicies",
