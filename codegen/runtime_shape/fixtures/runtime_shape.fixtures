    fixture "QueryProjection",
      name: "query_projection",
      order: 13,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_10_query_projection.rs.frag",
      description: "query_projection — runs a named query against the named projection ; returns Vec<HashMap<String,Value>>. Note : in source there is NO blank line between query_projection's closing brace and resolve_query's leading doc comment, so this snippet has no trailing blank"

    fixture "ResolveQuery",
      name: "resolve_query",
      order: 14,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_11_resolve_query.rs.frag",
