      order: 6,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_04a_pm_helpers.rs.frag",
      description: "publish_synthetic_event + resolve_llm_adapters — substrate for the PM loop driver and the i221 LLM dispatcher hook"

    fixture "Find",
      name: "find",
      order: 7,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_05_find.rs.frag",
      description: "find — exact-key fast path then context-disambiguation suffix walk ; returns the AggregateState for (aggregate_name, id)"

    fixture "All",
      name: "all",
      order: 8,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_06_all.rs.frag",
      description: "all — returns every AggregateState for an aggregate name via repo_lookup_key"

    fixture "DrainPolicies",
      name: "drain_policies",
      order: 9,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_07_drain_policies.rs.frag",
      description: "drain_policies — recursive policy-trigger cascade ; injects refs (self-ref + singleton fallback), passes upstream type+id as cascade hint, completes each policy. Phase 2.b/2.c walks PM dispatches with structured ValueSpec resolution."

    # Phase 2.b/2.c — ValueSpec evaluation + set-pairs evaluation
    # live between drain_policies and inject_refs.
    fixture "PmValueHelpers",
      name: "pm_value_helpers",
      order: 10,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_07a_pm_value_helpers.rs.frag",
      description: "evaluate_value_spec + pm_set_pairs — runtime ValueSpec resolution for PM dispatch"

    fixture "InjectRefs",
      name: "inject_refs",
      order: 11,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_08_inject_refs.rs.frag",
      description: "inject_refs — for each reference on the triggered command, inject an id under its kwarg name (upstream-type match → upstream id ; singleton fallback) ; also injects identified_by key for natural-key singletons"

    fixture "AddProjection",
      name: "add_projection",
      order: 12,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_09_add_projection.rs.frag",
