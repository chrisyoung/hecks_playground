    fixture "BootFramework",
      name: "boot_with_framework_dir",
      order: 4,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_01b_boot_framework.rs.frag",
      description: "boot_with_framework_dir — i557 part 1 ; boots with hecksagons + walks framework dir to populate FrameworkRegistry ; falls back gracefully when dir doesn't exist"

    fixture "Dispatch",
      name: "dispatch",
      order: 5,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_03_dispatch.rs.frag",
      description: "dispatch — entry point for top-level command dispatch ; runs middleware, calls command_dispatch::dispatch, writes the .last_dispatch breadcrumb (non-daemon only), runs after-middleware, applies projections, drains policy cascades"

    # i577 — breadcrumb phrase helper. Renders the two-segment-plus-
    # dot statusline format `Domain::Aggregate.Command` from a
    # CommandResult + the dispatched command name. Lives between
    # dispatch and dispatch_isolated ; called from dispatch's
    # .last_dispatch write path.
    fixture "FormatBreadcrumbPhrase",
      name: "format_breadcrumb_phrase",
      order: 6,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_03a_format_breadcrumb_phrase.rs.frag",
      description: "format_breadcrumb_phrase — i577 statusline breadcrumb phrase composer ; renders `Domain::Aggregate.Command` by looking up the aggregate's context (two segments + dot, no entity slot)"

    fixture "DispatchIsolated",
      name: "dispatch_isolated",
      order: 7,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_04_dispatch_isolated.rs.frag",
      description: "dispatch_isolated — dispatch without firing policy cascades ; used for SETUP commands in behavior tests"

    # i221 — publish_synthetic_event + resolve_llm_adapters. Live
    # between dispatch_isolated and find.
    fixture "PmHelpers",
      name: "pm_helpers",
      order: 8,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_04a_pm_helpers.rs.frag",
      description: "publish_synthetic_event + resolve_llm_adapters + resolve_claude_tool_adapters + resolve_compute_adapters — substrate for the PM loop driver, i221 LLM dispatcher hook, i551 claude_tool hook, i220 compute hook"

    fixture "Find",
      name: "find",
      order: 9,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_05_find.rs.frag",
      description: "find — exact-key fast path then context-disambiguation suffix walk ; returns the AggregateState for (aggregate_name, id)"

    fixture "All",
      name: "all",
      order: 10,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_06_all.rs.frag",
      description: "all — returns every AggregateState for an aggregate name via repo_lookup_key"

    fixture "DrainPolicies",
      name: "drain_policies",
      order: 11,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_07_drain_policies.rs.frag",
      description: "drain_policies — recursive policy-trigger cascade ; injects refs (self-ref + singleton fallback), passes upstream type+id as cascade hint, completes each policy. Phase 2.b/2.c walks PM dispatches with structured ValueSpec resolution."

    # Phase 2.b/2.c — ValueSpec evaluation + set-pairs evaluation
