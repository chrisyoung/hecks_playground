      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_01a_boot_helpers.rs.frag",
      description: "boot_with_hecksagons + register_llm_provider — i221 hooks for LLM dispatcher"

    fixture "BootWithDataDir",
      name: "boot_with_data_dir",
      order: 3,
      body_kind: "boot_pipeline",
      description: "boot_with_data_dir — synthetic ; emits the full Domain → wired Runtime pipeline by walking BootPhase rows in order"

    # i557 part 1 — boot_with_framework_dir. Wires the framework registry
