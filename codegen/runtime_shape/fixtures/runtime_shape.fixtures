    # from_iter(:field) reads land in the right shape during sweep
    # dispatch. Lives at the bottom of the file, after strip_quotes_or_colon.
    fixture "JsonObjToValueMapFn",
      name: "json_obj_to_value_map_fn",
      order: 15,
      body_kind: "verbatim_section",
      snippet_path: "codegen/runtime_shape/snippets/41_json_obj_to_value_map_fn.rs.frag",
      description: "json_obj_to_value_map — converts serde_json::Map<String, serde_json::Value> into HashMap<String, Value> for sweep_records iter_data ; i221-B free helper at file bottom"
  end

  aggregate "RuntimeMethod" do
    fixture "Boot",
      name: "boot",
      order: 1,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_01_boot.rs.frag",
