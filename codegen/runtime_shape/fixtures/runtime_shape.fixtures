    fixture "PmValueHelpers",
      name: "pm_value_helpers",
      order: 12,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_07a_pm_value_helpers.rs.frag",
      description: "evaluate_value_spec + pm_set_pairs — runtime ValueSpec resolution for PM dispatch"

    fixture "InjectRefs",
      name: "inject_refs",
      order: 13,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_08_inject_refs.rs.frag",
      description: "inject_refs — for each reference on the triggered command, inject an id under its kwarg name (upstream-type match → upstream id ; singleton fallback) ; also injects identified_by key for natural-key singletons"

    fixture "AddProjection",
      name: "add_projection",
      order: 14,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_09_add_projection.rs.frag",
      description: "add_projection — public API for tests / Rails integration to push a Projection onto the runtime"

    fixture "QueryProjection",
      name: "query_projection",
      order: 15,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_10_query_projection.rs.frag",
      description: "query_projection — runs a named query against the named projection ; returns Vec<HashMap<String,Value>>. Note : in source there is NO blank line between query_projection's closing brace and resolve_query's leading doc comment, so this snippet has no trailing blank"

    fixture "ResolveQuery",
      name: "resolve_query",
      order: 16,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/method_11_resolve_query.rs.frag",
