Hecks.fixtures "RuntimeShape" do
  # i147 Wave 5-B — runtime kernel root. Three aggregates encode the
  # file's three levels of structure :
  #
  #   Section        — 12 top-level partitions in source order. The
  #                    `runtime_impl` row emits the impl Runtime { … }
  #                    block by walking RuntimeMethod rows ; the
  #                    remaining 11 are verbatim_section snippets.
  #
  #   RuntimeMethod  — 12 methods inside impl Runtime { … } in source
  #                    order. The `boot_with_data_dir` row uses the
  #                    boot_pipeline body_kind (walks BootPhase rows) ;
  #                    the remaining 11 are verbatim_method snippets.
  #
  #   BootPhase      — 4 phases in the boot pipeline : wire_repositories,
  #                    wire_policies, wire_projections, assemble_runtime.

  aggregate "Section" do
    fixture "Header",
      name: "header",
      order: 0,
      body_kind: "verbatim_section",
      snippet_path: "codegen/runtime_shape/snippets/00_header.rs.frag",
      description: "module doc-comment + antibody-exempt headers + mod / pub-use declarations + crate imports — everything before `pub struct Runtime`. i630 follow-up : lifted out of the root.rs HEADER const so the runtime header is declared section data like every other section, not ~100 lines of hardcoded Rust (same i80 / autophagy retirement direction ; removes the non-bluebook .rs surface instead of overriding the LoC ratchet)."

    fixture "BackendInfo",
      name: "backend_info",
      order: 1,
      body_kind: "struct_from_fields",
      struct_name: "BackendInfo",
      derives: "Debug, Clone",
      doc: "/// One row of the backend-map projection (i728) — which backend each repository\n/// resolved to, without hydrating it. `Runtime::dump_backend_map` builds the Vec ;\n/// the Phase-A enforcement gate diffs it before/after a change and treats any\n/// unexpected backend flip as an automatic stop.",
      description: "pub struct BackendInfo (i728) — the backend-map projection row. STRUCTURE-from-data : emitted from Field rows + this row's struct_name/derives/doc, the first struct_from_fields body_kind (runtime-as-bluebook strangler Step 1). Byte-identity oracle : codegen/runtime_shape/snippets/02_struct_backend_info.rs.frag."

    fixture "StructRuntime",
      name: "struct_runtime",
      order: 2,
      body_kind: "verbatim_section",
      snippet_path: "codegen/runtime_shape/snippets/01_struct_runtime.rs.frag",
      description: "pub struct Runtime — seven fields (domain, repositories, event_bus, policy_engine, projections, middleware, data_dir) ; preceded by a leading blank-line separator from HEADER's last `use` line, terminated by a trailing blank-line separator before impl Runtime"

    fixture "ImplRuntime",
      name: "impl_runtime",
      order: 3,
      body_kind: "runtime_impl",
      description: "impl Runtime { … } — emits the impl block by walking RuntimeMethod rows in `order` ascending"

    fixture "ValueEnum",
      name: "value_enum",
      order: 3,
      body_kind: "verbatim_section",
      snippet_path: "codegen/runtime_shape/snippets/30_value_enum.rs.frag",
      description: "pub enum Value — Str / Int / Bool / List / Map / Null ; the dynamic field-bag value type aggregates carry"

    fixture "ValueImpl",
      name: "value_impl",
      order: 4,
      body_kind: "verbatim_section",
      snippet_path: "codegen/runtime_shape/snippets/31_value_impl.rs.frag",
      description: "impl Value — as_str / as_int / as_bool / as_list accessors used across the runtime"

    fixture "ValueDisplay",
      name: "value_display",
      order: 5,
      body_kind: "verbatim_section",
      snippet_path: "codegen/runtime_shape/snippets/32_value_display.rs.frag",
      description: "impl std::fmt::Display for Value — used by inbox/CLI rendering"

    fixture "RuntimeErrorEnum",
      name: "runtime_error_enum",
      order: 6,
      body_kind: "verbatim_section",
      snippet_path: "codegen/runtime_shape/snippets/33_runtime_error_enum.rs.frag",
      description: "pub enum RuntimeError — UnknownCommand / UnknownAggregate / GivenFailed / AggregateNotFound / MissingAttribute / LifecycleViolation / AmbiguousCommand"

    fixture "RuntimeErrorDisplay",
      name: "runtime_error_display",
      order: 7,
      body_kind: "verbatim_section",
      snippet_path: "codegen/runtime_shape/snippets/34_runtime_error_display.rs.frag",
      description: "impl std::fmt::Display for RuntimeError — human-readable form for each variant"

    fixture "AttrsMacro",
      name: "attrs_macro",
      order: 8,
      body_kind: "verbatim_section",
      snippet_path: "codegen/runtime_shape/snippets/35_attrs_macro.rs.frag",
      description: "attrs! macro — convenience HashMap<String, Value> builder used by tests and CLI dispatch"

    fixture "RepoKeyFn",
      name: "repo_key_fn",
      order: 9,
      body_kind: "verbatim_section",
      snippet_path: "codegen/runtime_shape/snippets/36_repo_key_fn.rs.frag",
      description: "repo_key — i142 Tier 2 (context, name) → HashMap key composer ; bare name when context is None, `<ctx>::<name>` otherwise"

    fixture "RepoLookupKeyFn",
      name: "repo_lookup_key_fn",
      order: 10,
      body_kind: "verbatim_section",
      snippet_path: "codegen/runtime_shape/snippets/37_repo_lookup_key_fn.rs.frag",
      description: "repo_lookup_key — name-only HashMap lookup helper for callers that don't yet carry context info"

    fixture "QueryExecutorFns",
      name: "query_executor_fns",
      order: 11,
      body_kind: "verbatim_section",
      snippet_path: "codegen/runtime_shape/snippets/40_query_executor_fns.rs.frag",
      description: "i101 — where_matches / compare_strings / resolve_where_value / resolve_limit_value : runtime query executor helpers for first-class IR queries"

    fixture "PascalToPhraseFn",
      name: "pascal_to_phrase_fn",
      order: 12,
      body_kind: "verbatim_section",
      snippet_path: "codegen/runtime_shape/snippets/38_pascal_to_phrase_fn.rs.frag",
      description: "pascal_to_phrase — converts CamelCase command names to lowercase phrases for trigram matching"

    fixture "TrigramSimFn",
      name: "trigram_sim_fn",
      order: 13,
      body_kind: "verbatim_section",
      snippet_path: "codegen/runtime_shape/snippets/39_trigram_sim_fn.rs.frag",
      description: "trigram_sim — Sørensen-Dice-like trigram similarity scoring used by resolve_query's MatchInput"

    # i551 — strip_quotes_or_colon free helper. Reduces hecksagon-option
    # values (raw source tokens with surrounding quotes or leading colons)
    # to their bare identifier before matching against runtime targets.
    # Lives after trigram_sim and before json_obj_to_value_map.
    fixture "StripQuotesOrColonFn",
      name: "strip_quotes_or_colon_fn",
      order: 14,
      body_kind: "verbatim_section",
      snippet_path: "codegen/runtime_shape/snippets/42_strip_quotes_or_colon_fn.rs.frag",
      description: "strip_quotes_or_colon — strips surrounding quotes or leading colon from raw hecksagon option values ; i551 free helper used by resolve_claude_tool_adapters"

    # i221-B — converts serde_json::Map (from resolve_query's JSON dump
