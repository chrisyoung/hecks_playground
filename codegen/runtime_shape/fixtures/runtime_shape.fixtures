  end

  # i728 runtime-as-bluebook strangler — STRUCTURE-from-data. Each Field row
  # is one field of a `struct_from_fields` Section, joined by its `struct`
  # attr (the struct_name). Emitted in `order` ascending as
  # `    pub <name>: <rust_type>,`. The grammar has no struct/variant
  # concept, so the runtime's plain-Rust types are carried as rows here
  # (the command_dispatch "pipeline as rows" precedent), NOT a .rs.frag.
  aggregate "Field" do
    fixture "BackendInfoRepoKey",
      struct: "BackendInfo",
      name: "repo_key",
      rust_type: "String",
      order: 0,
      description: "BackendInfo.repo_key — the repo_key the backend resolved for."

    fixture "BackendInfoKind",
      struct: "BackendInfo",
      name: "kind",
      rust_type: "BackendKind",
      order: 1,
      description: "BackendInfo.kind — which backend (memory/heki/sqlite) the repo_key resolved to."

    fixture "BackendInfoHekiPath",
      struct: "BackendInfo",
      name: "heki_path",
      rust_type: "Option<String>",
      order: 2,
      description: "BackendInfo.heki_path — the on-disk .heki path when kind is heki ; None otherwise."
  end

  # i728 runtime-as-bluebook strangler — the FILE-SPLIT (machinery cost #2).
  # Each ResolutionMethod is an inherent `impl Runtime` method that moves OUT
  # of runtime/mod.rs into its own generated, golden-gated file
  # rust/src/runtime/persistence_resolution.rs (`storehouse specialize
  # persistence_resolution`). The method lives ONLY in the generated file —
  # no 2nd copy, no drift surface. Emitted in `order` ascending inside one
  # `impl Runtime { … }` block, separated by blank lines. verbatim_method :
  # body is the snippet (genuinely-complex logic stays Rust) ; the STRUCTURE
  # (which methods, what order, which file) is the row data here.
  aggregate "SplitMethod" do
    fixture "DumpBackendMap",
      name: "dump_backend_map",
      file: "persistence_resolution",
      order: 0,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/resolution_dump_backend_map.rs.frag",
      description: "Runtime::dump_backend_map — snapshot every repository's resolved backend (i728 Phase-A enforcement read). Returns Vec<BackendInfo>."

    fixture "UnwiredAggregates",
      name: "unwired_aggregates",
      file: "persistence_resolution",
      order: 1,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/resolution_unwired_aggregates.rs.frag",
      description: "Runtime::unwired_aggregates — i728 DORMANT is-wired check ; repo_keys of aggregates whose governing hecksagon declares no persistence adapter. Returns Vec<String>."

    fixture "ForceMemoryRepositories",
      name: "force_memory_repositories",
      file: "persistence_resolution",
      order: 2,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/resolution_force_memory_repositories.rs.frag",
      description: "Runtime::force_memory_repositories — swap every repository for an explicit Backend::Memory wrapper (the behaviors harness path). Safe pre-hydration."

    fixture "ApplySqlitePersistence",
      name: "apply_sqlite_persistence",
      file: "persistence_resolution",
      order: 3,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/resolution_apply_sqlite_persistence.rs.frag",
      description: "Runtime::apply_sqlite_persistence — the keystone i735 resolver : rebuild on the SQL backend ONLY aggregates whose governing hecksagon declares :sqlite (scoped by context). EAGER, fallible, refuses LOUDLY. THE method Phase C edits. #[cfg(not(wasm32))] — its HashMap + lazy_repository imports are cfg-gated in the file header to match."

    fixture "RefreshRepositoriesFromHeki",
      name: "refresh_repositories_from_heki",
      file: "persistence_resolution",
      order: 4,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/resolution_refresh_repositories_from_heki.rs.frag",
      description: "Runtime::refresh_repositories_from_heki — RefreshOnPulse policy floor ; reload every repo from disk when a sibling process advanced its heki mtime. Opt-in via HECKS_REFRESH_REPOS=1."

    fixture "RefreshHydratedRepositoriesFromHeki",
      name: "refresh_hydrated_repositories_from_heki",
      file: "persistence_resolution",
      order: 5,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/resolution_refresh_hydrated_repositories_from_heki.rs.frag",
      description: "Runtime::refresh_hydrated_repositories_from_heki — warm-serve freshness sweep ; refresh ONLY already-hydrated repos (no env gate, no cold-repo hydration). THE correctness crux of warm serve."

    fixture "ApplyMemoryPersistence",
      name: "apply_memory_persistence",
      file: "persistence_resolution",
      order: 6,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/resolution_apply_memory_persistence.rs.frag",
      description: "Runtime::apply_memory_persistence — the keystone : rebuild on the explicit Backend::Memory ONLY aggregates whose hecksagon declares :memory (scoped by context, mirroring apply_sqlite_persistence). Makes :memory actually select memory (was INERT, fell through to the heki default). NOT cfg-gated — memory is host- and wasm-valid."

    fixture "ApplyHexagonPersistence",
      name: "apply_hexagon_persistence",
      file: "persistence_resolution",
      order: 7,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/resolution_apply_hexagon_persistence.rs.frag",
      description: "Runtime::apply_hexagon_persistence — bucket-3 step 4, the hexagon-binding CONSULT. Reads the NEW port-verb binding surface (Pizzas::Order.persisted_by(\"Heki\")) via resolve_bindings and rebuilds each persistence-family-bound aggregate's repository on the backend its adapter names (Heki->heki at data_dir, Memory->Backend::Memory). Additive over boot_with_data_dir ; runs LAST so a binding wins over a legacy block. Ungated — heki/memory constructors are host- and wasm-valid."

    # file: event_driving — cluster 4 (event/outbox driving). The runtime's
    # event-advancement surface OUTSIDE the main dispatch path.
    fixture "EnqueueAndDrain",
      name: "enqueue_and_drain",
      file: "event_driving",
      order: 0,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/event_driving_enqueue_and_drain.rs.frag",
      description: "Runtime::enqueue_and_drain — Sprint 14 actor path : wrap the event in an Envelope, deliver to the per-aggregate mailbox, drain it FIFO through the event bus."

    fixture "FireDrivingCronTicks",
      name: "fire_driving_cron_ticks",
      file: "event_driving",
      order: 1,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/event_driving_fire_driving_cron_ticks.rs.frag",
      description: "Runtime::fire_driving_cron_ticks — fire every `driving on cron` adapter handler ; pure delegation to driving_adapter_resolver. Called by LoopDriver::tick_once."

    # file: reaction — cluster 4b. Phase-3 reaction delivery : run the
    # impure adapter edge + policy/PM/driven cascade for a dispatched result.
    fixture "React",
      name: "react",
      file: "reaction",
      order: 0,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/reaction_react.rs.frag",
      description: "Runtime::react — Phase 3 : run every reaction for one dispatched result (compute/policy/PM cascade, IO-edge adapters, driven-on adapters). Invoked only by pump(). pub(super) : called from mod.rs dispatch paths."

    fixture "ReactPorts",
      name: "react_ports",
      file: "reaction",
      order: 1,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/reaction_react_ports.rs.frag",
      description: "Runtime::react_ports — the IMPURE hexagonal edge : adapters that talk to the outside world, fired eagerly even on the deferred path. pub(super) : called from mod.rs."

    fixture "Pump",
      name: "pump",
      file: "reaction",
      order: 2,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/reaction_pump.rs.frag",
      description: "Runtime::pump — drain enqueued reactions to quiescence so eager callers see a settled cascade."

    fixture "PumpOutbox",
      name: "pump_outbox",
      file: "reaction",
      order: 3,
      body_kind: "verbatim_method",
      snippet_path: "codegen/runtime_shape/snippets/reaction_pump_outbox.rs.frag",
      description: "Runtime::pump_outbox — drain the persistent CascadeRun outbox: deliver each Active run's steps as their own transactions AND fire react_ports per delivered step so PM/policy steps that target :llm/compute/tool ports (e.g. the Dream PM's Dream.ProduceImage -> :dream_image) actually fire their adapter when delivered via the outbox pump, not just mutate state."
  end
end
