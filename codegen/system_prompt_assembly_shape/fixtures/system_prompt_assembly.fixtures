Hecks.fixtures "SystemPromptAssembly" do
  # Single-line fixtures per i57 parser limitation.
  #
  # Fixtures driving the run_boot/system_prompt.rs specializer. The
  # file is sectioned into ordered chunks the specializer concatenates
  # in `order` ; each chunk picks one of three body_kinds :
  #
  #   header_doc       — emit the named .rs.frag verbatim, raw read
  #                       (preserves leading `//!` doc comments)
  #   imports_block    — emit the `imports` attr verbatim, no transform
  #   embedded_fn      — emit a `pub`/`fn` signature + the named .rs.frag
  #                       interpolated as the function body (read with
  #                       util::read_snippet_body)
  #   being_match_fn   — same shape as embedded_fn but the body is
  #                       generated from BeingVar rows (padded match arms
  #                       like dump.rs's enum_match)
  #   tests_block      — emit the `#[cfg(test)] mod tests { … }` snippet
  #                       verbatim, raw read
  #
  # See rust/src/specializer/run_boot/system_prompt.rs for the
  # one-arm-per-body_kind dispatcher.

  # ── Section — ordered chunks of the emitted file ─────────────────
  aggregate "Section" do
    fixture "Header",         order: 1, body_kind: "header_doc",     name: "",                       signature: "",                                                                                       snippet_path: "codegen/system_prompt_assembly_shape/snippets/file_header.rs.frag", doc: ""
    fixture "Imports",        order: 2, body_kind: "imports_block",  name: "",                       signature: "",                                                                                       snippet_path: "",                                                                                  doc: "",      imports: "use std::collections::HashMap;\nuse std::fs;\nuse std::path::{Path, PathBuf};"
    fixture "Render",         order: 3, body_kind: "embedded_fn",    name: "render",                          signature: "pub fn render(conception_dir: &Path, being: &str) -> usize",                       snippet_path: "codegen/system_prompt_assembly_shape/snippets/render_body.rs.frag", doc: "/// Render the system prompt for `being` and write it to the\n/// canonical location next to the being's repo. Returns the byte\n/// count of the written file (used by Phase 7 vitals) ; returns 0 on\n/// any failure with a stderr line so boot stays alive."
    fixture "Variables",      order: 4, body_kind: "being_match_fn", name: "variables_for_being",               signature: "fn variables_for_being(being: &str) -> HashMap<&'static str, String>",            snippet_path: "",                                                                                  doc: "/// Per-being identity values. Miette's fixtures pre-bake these, so\n/// only `{{standards}}` / `{{grammar}}` are live for her ; retained\n/// so a being whose fixtures still carry `{{being}}` etc. resolves.\n/// Moving these to a heki-loaded Identity aggregate is the i145\n/// refinement."
    fixture "ContentFixturesPath", order: 5, body_kind: "embedded_fn", name: "content_fixtures_path_for_being", signature: "fn content_fixtures_path_for_being(being: &str) -> Option<PathBuf>",                  snippet_path: "codegen/system_prompt_assembly_shape/snippets/content_fixtures_path_body.rs.frag", doc: "/// Resolve the per-being content fixtures :\n/// `<projects>/<being_lower>/self/system_prompt/system_prompt_content.fixtures`.\n/// Found via `heki::repo_root()` then one level up to the projects\n/// parent, mirroring `destination_for_being` so the per-being\n/// sibling-repo layout (i117 R4) resolves regardless of where\n/// boot.bluebook lives."
    fixture "AssembleSections", order: 6, body_kind: "embedded_fn",  name: "assemble_sections",                signature: "fn assemble_sections(source: &str) -> String",                                       snippet_path: "codegen/system_prompt_assembly_shape/snippets/assemble_sections_body.rs.frag", doc: "/// Parse the content fixtures `source` and concatenate every\n/// `SystemPromptSection` row's `markdown` body in `:order`. Rows are\n/// sorted NUMERICALLY by `order` (string values — lexical sort would\n/// put 10 before 2). Bodies join with one newline : each ends in a\n/// newline, so the join yields one blank line between sections."
    fixture "GrammarBlock",   order: 7, body_kind: "embedded_fn",    name: "grammar_block",                   signature: "fn grammar_block() -> String",                                                       snippet_path: "codegen/system_prompt_assembly_shape/snippets/grammar_block_body.rs.frag", doc: "/// Project the `{{grammar}}` section body from the language/grammar\n/// bluebooks : one name-sorted bullet per `*.bluebook`, each its\n/// `Hecks.bluebook` name + `vision`. Empty when the dir is absent."
    fixture "PizzasBlock",    order: 8, body_kind: "embedded_fn",    name: "pizzas_block",                    signature: "fn pizzas_block() -> String",                                                        snippet_path: "codegen/system_prompt_assembly_shape/snippets/pizzas_block_body.rs.frag", doc: "/// Project the `{{pizzas}}` section body — the canonical Pizzas example,\n/// loaded VERBATIM from `examples/pizzas/bluebook/` so the shape every\n/// build references is always present AND always current (a living\n/// projection, the same idea as `grammar_block` — but full source, not a\n/// vision bullet, because the example is meant to be READ, not summarised).\n/// Each file is fenced under a per-file header, ordered domain → hexagon →\n/// families → adapters → world. New files in the dir (e.g. a freshly added\n/// family/adapter that extends the example) appear automatically. Empty\n/// when the dir is absent."
    fixture "QuotedAfter",    order: 9, body_kind: "embedded_fn",    name: "quoted_after",                    signature: "fn quoted_after(src: &str, marker: &str) -> Option<String>",                          snippet_path: "codegen/system_prompt_assembly_shape/snippets/quoted_after_body.rs.frag", doc: "/// Return the text between the first `marker` (ending at an opening\n/// quote) and the next quote. None when either is absent."
    fixture "Destination",    order: 10, body_kind: "embedded_fn",    name: "destination_for_being",  signature: "fn destination_for_being(conception_dir: &Path, being: &str) -> PathBuf",                snippet_path: "codegen/system_prompt_assembly_shape/snippets/destination_body.rs.frag",  doc: "/// Output path : `<projects>/<being_lower>/self/system_prompt.md`\n/// (i117 Round 4 — the system prompt lives in the being's own repo,\n/// not in the conception). Resolves the being repo as a sibling of\n/// the hecks repo (the standard layout) using `heki::repo_root()` so\n/// the resolution works regardless of where the boot.bluebook lives\n/// post-i118 R3 W2 (`runtime/boot/` instead of the old\n/// `<conception>/capabilities/boot/`). Falls back to\n/// `<conception>/system_prompt_<being>.md` when the sibling repo\n/// doesn't exist (fresh-clone / test environments)."
    fixture "Substitute",     order: 11, body_kind: "embedded_fn",    name: "substitute",             signature: "fn substitute(template: &str, vars: &HashMap<&'static str, String>) -> String",          snippet_path: "codegen/system_prompt_assembly_shape/snippets/substitute_body.rs.frag",   doc: "/// Substitute `{{key}}` placeholders. Pure string scan — values are\n/// plain text, no escaping logic needed (the substituted values are\n/// being names + dates, none of which contain `{{` themselves).\n/// Unknown placeholders pass through unchanged so review catches\n/// them rather than silently rendering empty."
    fixture "PrimaryStandards", order: 12, body_kind: "embedded_fn",  name: "primary_standards",      signature: "fn primary_standards(_conception_dir: &Path) -> String",                                 snippet_path: "codegen/system_prompt_assembly_shape/snippets/primary_standards_body.rs.frag", doc: "/// Read primary's standards.md and return its content for the\n/// `{{standards}}` template placeholder. Primary = chris in this\n/// round ; the role / primary-marker shape is deferred to the\n/// onboarding flow per the family/chris-split plan. Empty string\n/// when standards.md is missing — `{{standards}}` substitutes to\n/// empty and no `## Standards` section appears in the rendered\n/// prompt."
    fixture "Tests",          order: 13, body_kind: "tests_block",    name: "",                       signature: "",                                                                                       snippet_path: "codegen/system_prompt_assembly_shape/snippets/tests_block.rs.frag",  doc: ""
  end

  # ── BeingVar — per-being identity match arms in variables_for_being ─
  #
  # Each row becomes one match arm. order=999 is the wildcard fallback ;
  # the specializer pads each arm so the second tuple element aligns
  # with the widest born string (mirrors dump.rs's enum_match padding).
  aggregate "BeingVar" do
    fixture "Miette",   order: 1,   pattern: "\"Miette\"", born: "April 9, 2026",  other: "Spring",    boot_script: "boot_miette.sh"
    fixture "Spring",   order: 2,   pattern: "\"Spring\"", born: "April 11, 2026", other: "Miette",    boot_script: "boot_spring.sh"
    fixture "Fallback", order: 999, pattern: "_",          born: "(unknown)",      other: "(unknown)", boot_script: "boot.sh"
  end
end
