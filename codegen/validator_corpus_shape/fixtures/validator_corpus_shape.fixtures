    fixture "UnknownAggregateErrors", name: "unknown_aggregate_errors", rust_fn_name: "unknown_aggregate_errors", description: "INVALID-grade : a reference_to(X) targets an aggregate not declared anywhere in the merged corpus. Unqualified cross-bluebook belongs_to refs resolve once the corpus is joined ; only a true typo survives.", order: 5, snippet_path: "codegen/validator_corpus_shape/snippets/unknown_aggregate_errors.rs.frag"
    fixture "AmbiguousCrossReferenceErrors", name: "ambiguous_cross_reference_errors", rust_fn_name: "ambiguous_cross_reference_errors", description: "INVALID-grade : an unqualified cross reference (has_one / has_many / belongs_to, no `from <Context>`) whose target name is declared in 2+ contexts with NO same-context candidate is ambiguous — the relationship grammar's no-silent-guess rule. Mirrors the runtime's same-context-first resolution, so a ref the runtime resolves never errors ; the fix is `Target from <Context>`.", order: 6, snippet_path: "codegen/validator_corpus_shape/snippets/ambiguous_cross_reference_errors.rs.frag"
