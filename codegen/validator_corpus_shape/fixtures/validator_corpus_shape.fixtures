    fixture "PolicyEventWarnings", name: "policy_event_warnings", rust_fn_name: "policy_event_warnings", description: "Advisory : a policy subscribes to an event that no command emits anywhere in the corpus. The policy is dangling — placeholder, or a typo.", order: 3, snippet_path: "codegen/validator_corpus_shape/snippets/policy_event_warnings.rs.frag"
