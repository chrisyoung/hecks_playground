Hecks.behaviors "WasmWorkerShape" do
  vision "Shape-layer happy-paths for the WASM Cloudflare-Worker emitter — confirms the EmitLibRs and EmitCargoToml command tuples plumb through. The actual rendering logic is exercised by rust/tests/wasm_worker_test.rs against bin-buddy's world+bluebook tree ; this file proves the bluebook-layer contract."

  test "EmitLibRs accepts the (app, host, auth_scheme, auth_secret_env) tuple" do
    tests "EmitLibRs", on: "WasmWorker"
    input  app: "bin-buddy",
           host: "cf_worker",
           auth_scheme: "bearer",
           auth_secret_env: "BIN_BUDDY_API_KEY"
    expect app: "bin-buddy",
           host: "cf_worker",
           auth_scheme: "bearer",
           auth_secret_env: "BIN_BUDDY_API_KEY"
  end

  test "EmitCargoToml accepts the (app, storehouse_path) tuple" do
    tests "EmitCargoToml", on: "WasmWorker"
    input  app: "bin-buddy",
           storehouse_path: "../../hecks/rust"
    expect app: "bin-buddy",
           storehouse_path: "../../hecks/rust"
  end
end
