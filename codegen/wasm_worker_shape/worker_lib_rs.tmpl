//! __APP_TITLE__ Worker
//!
//! Exposes the __APP__ bluebook command bus over HTTP, plus the
//! Living Diagram + walking skeleton surfaces the dev server serves
//! locally.
//!
//!   POST /route                       — Route command : { phrase, params } → event
//!   GET  /lexicon                     — ListPhrases query : the materialized scope set
//!   GET  /query                       — Query.Run / Query.Read dispatch
//!   GET  /health                      — HealthCheck query : status + scope size
//!   GET  /                            — Dashboard
//!   GET  /diagram                     — Living Diagram (universe view)
//!   GET  /diagram/:domain             — Living Diagram (single-domain)
//!   GET  /diagram/_all/graph.json     — Universe graph data
//!   GET  /diagram/:domain/graph.json  — Graph data for Cytoscape
//!   GET  /diagram/flows.json          — Inbox cards as user-flow stories
//!   GET  /domains                     — JSON list of loaded domains
//!   GET  /domains/:domain             — Walking skeleton (browse-by-aggregate)
//!   POST /domains/:domain/dispatch    — Dispatch a command through the live Runtime
//!
//! Auth (POST /route only) : carried by the auth_scheme value the
//! world file picks ; the auth secret reads through
//! `ctx.env.secret("__AUTH_SECRET_ENV__")`.
//!
//! POST /route appends every routed command to the R2 object
//! `dispatch.heki` via `storehouse::heki_r2::append_record`
//! (i528 R2 storage adapter).
//!
//! POST /domains/:domain/dispatch is the live-cascade path : the
//! worker parses every embedded bluebook into a Runtime at request
//! time, seeds each aggregate's records from R2 + fixtures, runs the
//! command through `Runtime::dispatch`, persists every modified repo
//! back to R2, returns the event JSON plus the cascade trail.
//!
//! ## R2 state layout (i114)
//!
//! For every aggregate, records live at the R2 key
//! `state/<aggregate_snake>.heki` in the bucket bound as
//! `__R2_BINDING__`. The next-id counter manifest lives at
//! `state/_counters.heki` keyed by aggregate name. Fixtures from
//! every embedded `.fixtures` file seed the repositories at boot
//! BEFORE R2 state is layered on top — R2 always wins for the same
//! aggregate, so demo seeds become the empty-bucket starting point.

use worker::*;
use std::cell::RefCell;
use std::collections::HashMap;

mod embedded;

// ── Runtime boot ────────────────────────────────────────────
// Mirror of `multi::load_all_domains` but reading from the embedded
// bluebook strings instead of walking the filesystem. PRIMARY_BASENAME
// is the root bluebook (e.g. "__APP__.bluebook") ; every other
// .bluebook entry contributes its aggregates / policies / fixtures /
// sections / process_managers / cadences / block_grammars into the
// merged Domain. Hecksagons load alongside so the runtime sees the
// :web / :email / :stripe adapter bindings. `.fixtures` files merge
// their declared `Fixture` rows into the same Domain so the boot path
// can seed each repo with demo data before R2 state layers on top.
//
// Booted fresh per request today. Each parse + IR build is a few ms
// per bluebook ; with 27 embedded files, cold start is ~50ms. Move
// to a cached thread_local OnceCell when latency matters.
async fn boot_runtimes(
    bucket: Option<&Bucket>,
) -> (HashMap<String, RefCell<storehouse::runtime::Runtime>>, String) {
    let primary_src = embedded::EMBEDDED_BLUEBOOKS.iter()
        .find(|(name, _)| *name == embedded::PRIMARY_BASENAME)
        .map(|(_, src)| *src)
        .unwrap_or("");
    let mut merged: storehouse::ir::Domain = storehouse::parser::parse(primary_src);
    for (name, source) in embedded::EMBEDDED_BLUEBOOKS {
        if *name == embedded::PRIMARY_BASENAME { continue; }
        if name.ends_with(".bluebook") {
            let child = storehouse::parser::parse(source);
            // Requires-only primary bluebooks parse nameless ; adopt a child
            // domain name so the worker can key + route the domain.
            if merged.name.is_empty() && !child.name.is_empty() {
                merged.name = child.name.clone();
            }
            merged.aggregates.extend(child.aggregates);
            merged.policies.extend(child.policies);
            merged.fixtures.extend(child.fixtures);
            merged.sections.extend(child.sections);
            merged.process_managers.extend(child.process_managers);
            merged.cadences.extend(child.cadences);
            merged.block_grammars.extend(child.block_grammars);
        }
    }
    // .fixtures files — sibling `Hecks.fixtures` DSL declarations. Parse
    // each into a FixturesFile and fold its rows into merged.fixtures
    // so the boot seed path below sees them alongside any in-bluebook
    // fixture rows.
    for (name, source) in embedded::EMBEDDED_BLUEBOOKS {
        if name.ends_with(".fixtures") {
            let f = storehouse::fixtures_parser::parse(source);
            merged.fixtures.extend(f.fixtures);
        }
    }
    let mut hecksagons: Vec<storehouse::hecksagon_ir::Hecksagon> = Vec::new();
    for (name, source) in embedded::EMBEDDED_BLUEBOOKS {
        if name.ends_with(".hecksagon") {
            hecksagons.push(storehouse::hecksagon_parser::parse(source));
        }
    }
    let primary_name = merged.name.clone();
    let mut rt = storehouse::runtime::Runtime::boot_with_hecksagons(merged, None, hecksagons);

    // ── Fixture seed (companion to __APP__/i105) ────────────────
    // The Domain holds every fixture row declared across the embedded
    // .bluebook + .fixtures files. The runtime's boot path leaves
    // them in the IR — nothing else pushes them into repositories.
    // Seed them here as AggregateState so the demo world is non-empty
    // on the first request to a fresh bucket. R2 state (read below)
    // overwrites by id so live data always wins over seed data.
    seed_fixtures(&mut rt);

    // ── R2 state hydration (i114) ─────────────────────────────────
    // For every aggregate, read `state/<aggregate_snake>.heki` and
    // upsert each record into the repository. Empty / missing objects
    // are a no-op (the R2 read_record adapter maps missing keys to an
    // empty Store).
    if let Some(bucket) = bucket {
        hydrate_from_r2(&mut rt, bucket).await;
    }

    let mut map = HashMap::new();
    map.insert(primary_name.clone(), RefCell::new(rt));
    (map, primary_name)
}

/// Walk every fixture in the merged Domain and inject it into the
/// matching repository as an AggregateState. The fixture's `name`
/// field becomes the record id when the aggregate has no
/// `identified_by` ; when `identified_by` is set, the matching
/// attribute (e.g. `account_email`) becomes the id.
fn seed_fixtures(rt: &mut storehouse::runtime::Runtime) {
    use storehouse::runtime::{AggregateState, repo_lookup_key};
    // Snapshot identified_by lookup per aggregate (avoid borrow conflicts).
    let identified_by: HashMap<String, Option<String>> = rt
        .domain
        .aggregates
        .iter()
        .map(|a| (a.name.clone(), a.identified_by.clone()))
        .collect();
    let fixtures = rt.domain.fixtures.clone();
    for fix in &fixtures {
        let Some(repo_key) = repo_lookup_key(&rt.repositories, &fix.aggregate_name) else {
            continue;
        };
        let id_field = identified_by.get(&fix.aggregate_name).cloned().flatten();
        let id = if let Some(ref key) = id_field {
            fix.attributes.iter().find(|(k, _)| k == key).map(|(_, v)| v.clone())
                .or_else(|| fix.name.clone())
                .unwrap_or_else(|| format!("fixture_{}", fix.aggregate_name))
        } else {
            fix.name.clone().unwrap_or_else(|| format!("fixture_{}", fix.aggregate_name))
        };
        let mut state = AggregateState::new(&id);
        for (k, v) in &fix.attributes {
            state.set(k, infer_value(v));
        }
        if let Some(repo) = rt.repositories.get_mut(&repo_key) {
            repo.seed_record(state);
        }
    }
}

/// Light type inference for fixture attribute values (currently
/// stringly-typed in the IR). Integers and booleans get coerced ;
/// everything else stays a `Str`.
fn infer_value(raw: &str) -> storehouse::runtime::Value {
    use storehouse::runtime::Value;
    if let Ok(n) = raw.parse::<i64>() {
        return Value::Int(n);
    }
    match raw {
        "true"  => Value::Bool(true),
        "false" => Value::Bool(false),
        _       => Value::Str(raw.to_string()),
    }
}

/// Pull every persisted record out of R2 and inject it into the
/// matching repository. Counters layer in via `state/_counters.heki`
/// so counter-minted aggregates resume their id sequence rather than
/// colliding with seeded fixture rows.
async fn hydrate_from_r2(rt: &mut storehouse::runtime::Runtime, bucket: &Bucket) {
    use storehouse::runtime::{AggregateState, Value, repo_lookup_key};
    let agg_names: Vec<String> = rt.domain.aggregates.iter().map(|a| a.name.clone()).collect();
    for agg_name in &agg_names {
        let snake = storehouse::heki::snake_case(agg_name);
        let key = format!("state/{}.heki", snake);
        let store = match storehouse::heki_r2::read_record(bucket, &key).await {
            Ok(s) => s,
            Err(_) => continue,
        };
        let Some(repo_key) = repo_lookup_key(&rt.repositories, agg_name) else {
            continue;
        };
        let Some(repo) = rt.repositories.get_mut(&repo_key) else { continue };
        for (_, rec) in &store {
            let id = rec.get("id")
                .and_then(|v| v.as_str())
                .unwrap_or("1")
                .to_string();
            let mut state = AggregateState::new(&id);
            for (k, v) in rec {
                if k != "id" && k != "created_at" && k != "updated_at" {
                    state.set(k, json_value_to_runtime(v));
                }
            }
            repo.seed_record(state);
        }
    }
    // Counter manifest — single object keyed by aggregate name.
    if let Ok(counters) = storehouse::heki_r2::read_record(bucket, "state/_counters.heki").await {
        if let Some(rec) = counters.values().next() {
            for (k, v) in rec {
                if k == "id" || k == "created_at" || k == "updated_at" { continue; }
                let Some(repo_key) = repo_lookup_key(&rt.repositories, k) else { continue };
                if let Some(n) = v.as_i64() {
                    if let Some(repo) = rt.repositories.get_mut(&repo_key) {
                        repo.set_next_id(n as u64);
                    }
                }
            }
        }
    }
    // Quiet the unused-variable lint paths that the runtime-Value
    // shape would catch — kept here so the helper compiles cleanly.
    let _ = Value::Null;
}

/// Persist every repository's records back to R2 plus the counter
/// manifest. Called after every successful dispatch so the next
/// cold boot reads back the same world.
async fn persist_runtime_to_r2(
    rt: &storehouse::runtime::Runtime,
    bucket: &Bucket,
) -> Result<()> {
    use storehouse::heki::Store;
    let mut counters = serde_json::Map::new();
    for agg in &rt.domain.aggregates {
        let snake = storehouse::heki::snake_case(&agg.name);
        let r2_key = format!("state/{}.heki", snake);
        let Some(repo_key) = storehouse::runtime::repo_lookup_key(&rt.repositories, &agg.name) else { continue };
        let Some(repo) = rt.repositories.get(&repo_key) else { continue };
        let mut store: Store = Store::new();
        for state in repo.all() {
            let mut rec = storehouse::heki::Record::new();
            rec.insert("id".into(), serde_json::Value::String(state.id.clone()));
            for (k, v) in &state.fields {
                rec.insert(k.clone(), runtime_value_to_json(v));
            }
            store.insert(state.id.clone(), rec);
        }
        // Best-effort write : we let upsert_record handle empty-Store
        // semantics for empty repos by just skipping them entirely
        // (no point overwriting with empty).
        if !store.is_empty() {
            // Use put_store equivalent via the raw bucket put : encode
            // through the same HEKI wire format heki_r2 emits. Since
            // heki_r2 only exposes per-record upsert / append, we use
            // upsert in a loop — but to avoid N round trips we use a
            // direct bucket write of a freshly-encoded blob via the
            // public helpers.
            let _ = write_store_to_r2(bucket, &r2_key, &store).await;
        }
        counters.insert(agg.name.clone(), serde_json::Value::Number(repo.next_id_value().into()));
    }
    // Counter manifest — single record under the well-known id "_".
    if !counters.is_empty() {
        let mut counter_rec = storehouse::heki::Record::new();
        counter_rec.insert("id".into(), serde_json::Value::String("_".into()));
        for (k, v) in counters {
            counter_rec.insert(k, v);
        }
        let _ = storehouse::heki_r2::upsert_record(bucket, "state/_counters.heki", &counter_rec).await;
    }
    Ok(())
}

/// Encode a Store into the HEKI wire format and PUT it back to R2.
/// heki_r2 exposes per-record upsert / append but not whole-Store
/// writes, so we go through the public read_record decode pattern
/// inversely : encode by hand, PUT via the bucket binding.
async fn write_store_to_r2(
    bucket: &Bucket,
    key: &str,
    store: &storehouse::heki::Store,
) -> std::result::Result<(), String> {
    // Reuse the public encode via a stand-in record set : the heki_r2
    // module gives us upsert_record (which round-trips one record at a
    // time). To write a whole Store atomically, we do one upsert per
    // record. Cost : N round trips per dispatch. Acceptable for the
    // walking-skeleton scale ; revisit when a domain has thousands of
    // records per aggregate.
    for (_, rec) in store {
        let mut attrs = storehouse::heki::Record::new();
        for (k, v) in rec {
            attrs.insert(k.clone(), v.clone());
        }
        storehouse::heki_r2::upsert_record(bucket, key, &attrs).await?;
    }
    Ok(())
}

#[event(fetch)]
pub async fn main(req: Request, env: Env, _ctx: Context) -> Result<Response> {
    console_error_panic_hook::set_once();
    Router::new()
        .get("/health", health)
        .get("/lexicon", lexicon)
        .get_async("/query", query)
        .post_async("/route", route)
        .get_async("/diagram", diagram_universe)
        .get_async("/diagram/_all/graph.json", diagram_universe_graph_json)
        .get_async("/diagram/flows.json", diagram_flows_json)
        .get_async("/diagram/:domain", diagram_domain)
        .get_async("/diagram/:domain/graph.json", diagram_graph_json)
        .get_async("/domains", domains_index)
        .get_async("/domains/:domain", walking_skeleton)
        .post_async("/domains/:domain/dispatch", walking_skeleton_dispatch)
        .run(req, env)
        .await
}

fn health(_req: Request, _ctx: RouteContext<()>) -> Result<Response> {
    let body = serde_json::json!({
        "service":            "__APP__-worker",
