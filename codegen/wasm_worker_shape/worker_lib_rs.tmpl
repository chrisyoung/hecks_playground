async fn walking_skeleton_dispatch(mut req: Request, ctx: RouteContext<()>) -> Result<Response> {
    let name = ctx.param("domain").cloned().unwrap_or_default();
    let body: serde_json::Value = match req.json().await {
        Ok(v) => v,
        Err(e) => return Response::error(format!("bad JSON body : {}", e), 400),
    };
    let command = body.get("command").and_then(|v| v.as_str()).unwrap_or("").to_string();
    let attrs_json = body.get("attrs").cloned().unwrap_or(serde_json::Value::Object(serde_json::Map::new()));
    if command.is_empty() {
        return Response::error("missing 'command' field", 400);
    }
    let attrs = json_to_runtime_attrs(&attrs_json);
    let bucket = ctx.env.bucket("__R2_BINDING__").ok();
    let (runtimes, _) = boot_runtimes(bucket.as_ref()).await;
    let rt = match runtimes.get(&name) {
        Some(r) => r,
        None => return Response::error(format!("unknown domain : {}", name), 404),
    };

    // i115 — slice every event published during THIS dispatch so the
    // response can surface the cascade tail (policy fires → triggered
    // command → its event, recursively). Boot leaves the EventBus
    // empty, so this index is normally 0 ; preserving the pattern
    // means we still work if a future boot path replays history.
    let pre_count = rt.borrow().event_bus.events().len();

    let result = {
        let mut rt_mut = rt.borrow_mut();
        rt_mut.dispatch(&command, attrs)
    };

    match result {
        Ok(result) => {
            let event_name = result.event.as_ref().map(|e| e.name.clone()).unwrap_or_default();
            let cascade: Vec<serde_json::Value> = {
                let rt_ref = rt.borrow();
                let events = rt_ref.event_bus.events();
                events.iter().skip(pre_count).map(event_to_json).collect()
            };
            // i114 — persist every modified repo back to R2 so the
            // next cold boot sees the new state. Best-effort : a
            // failed write is logged via the response body, not raised.
            let persist_result = if let Some(ref bucket) = bucket {
                persist_runtime_to_r2(&rt.borrow(), bucket).await
            } else {
                Ok(())
            };
            let persisted = persist_result.is_ok();
            Response::from_json(&serde_json::json!({
                "ok":             true,
                "event":          event_name,
                "aggregate_type": result.aggregate_type,
                "aggregate_id":   result.aggregate_id,
                "cascade":        cascade,
                "persisted":      persisted,
            }))
        }
        Err(e) => {
            let humanized = humanize_runtime_error(&e);
            Response::from_json(&serde_json::json!({
                "ok":         false,
                "error":      humanized.message,
                "suggestion": humanized.suggestion,
                "field":      humanized.field,
            }))
        }
    }
}

/// One event from EventBus history → JSON for the cascade response.
fn event_to_json(e: &storehouse::runtime::Event) -> serde_json::Value {
    let mut data = serde_json::Map::new();
    for (k, v) in &e.data {
        data.insert(k.clone(), runtime_value_to_json(v));
    }
    serde_json::json!({
        "name":           e.name,
        "aggregate_type": e.aggregate_type,
        "aggregate_id":   e.aggregate_id,
        "data":           data,
    })
}

/// i110 — humanize a RuntimeError into operator-friendly text.
/// The walking-skeleton dispatch response carries this directly so
/// the diagram's panel can surface it inline without needing to
/// parse Rust debug formatting.
struct HumanizedError {
    message: String,
    suggestion: Option<String>,
    field: Option<String>,
}

fn humanize_runtime_error(err: &storehouse::runtime::RuntimeError) -> HumanizedError {
    use storehouse::runtime::RuntimeError as E;
    match err {
        E::UnknownCommand(name) => HumanizedError {
            message: format!("No command named `{}`.", name),
            suggestion: Some("Check the spelling — commands are `Aggregate.Command` or just `Command`.".into()),
            field: None,
        },
        E::UnknownAggregate(name) => HumanizedError {
            message: format!("No aggregate named `{}`.", name),
            suggestion: Some("Browse /domains/:domain to see the loaded aggregate names.".into()),
            field: None,
        },
        E::MissingAttribute(name) => HumanizedError {
            message: format!("The field `{}` is required.", name),
            suggestion: Some(format!("Add `{}` to the command form.", name)),
            field: Some(name.clone()),
        },
        E::LifecycleViolation { command, field, current, allowed } => HumanizedError {
            message: format!(
                "Cannot `{}` from state `{}` — it needs `{}`.",
                command,
                current,
                allowed.join(" or "),
            ),
            suggestion: Some(format!(
                "Transition the aggregate's `{}` to one of [{}] first.",
                field,
                allowed.join(", "),
            )),
            field: Some(field.clone()),
        },
        E::AggregateNotFound(id) => HumanizedError {
            message: format!("Aggregate `{}` not found.", id),
            suggestion: Some("Create it first, or check the id you passed.".into()),
            field: None,
        },
        E::GivenFailed { message, expression } => HumanizedError {
            message: format!("Precondition failed : {}", message),
            suggestion: Some(format!("The check `{}` did not hold for this command.", expression)),
            field: None,
        },
        E::AmbiguousCommand { name, candidates } => HumanizedError {
            message: format!(
                "Command `{}` is declared on multiple aggregates : {}.",
                name,
                candidates.join(", "),
            ),
            suggestion: Some(format!(
                "Qualify the dispatch with the aggregate name, e.g. `{}.{}`.",
                candidates.first().cloned().unwrap_or_default(),
                name,
            )),
            field: None,
        },
    }
}

