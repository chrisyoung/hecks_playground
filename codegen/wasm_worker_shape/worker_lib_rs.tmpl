  </div>
  <script>
    const GRAPH = {graph};
    const cy = cytoscape({{
      container: document.getElementById('cy'),
      elements: GRAPH,
      style: [
        {{ selector: 'node', style: {{ 'label': 'data(label)', 'font-size': 11, 'color': '#fff', 'text-outline-width': 2, 'text-outline-color': '#0a0a0a' }} }},
