async fn domains_index(_req: Request, ctx: RouteContext<()>) -> Result<Response> {
    // Render the same dashboard the root `/` uses — a clickable
    // card per loaded domain — so visitors to /domains land on a
    // navigable HTML index rather than a raw JSON dump. The JSON
    // shape stays available with ?format=json for tools that need
    // it (per existing /domains contract).
    let wants_json = _req
        .url()
        .ok()
        .map(|u| u.query_pairs().any(|(k, v)| k == "format" && v == "json"))
        .unwrap_or(false);

    let bucket = ctx.env.bucket("__R2_BINDING__").ok();
    let (runtimes, _) = boot_runtimes(bucket.as_ref()).await;

    if wants_json {
        let names: Vec<&String> = runtimes.keys().collect();
        let body = serde_json::json!({
            "count":   names.len(),
            "domains": names,
        });
        return Response::from_json(&body);
    }
    let html = storehouse::server::html::generate_index(&runtimes);
    Response::from_html(html)
}

