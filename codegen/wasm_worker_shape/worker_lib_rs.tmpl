/// serde_json::Value (request body) → HashMap<String, runtime::Value>
/// (what Runtime::dispatch expects for command attrs). Mirrors the
/// private `json_to_value` helper in runtime/command_dispatch.rs.
fn json_to_runtime_attrs(v: &serde_json::Value) -> HashMap<String, storehouse::runtime::Value> {
    let mut out = HashMap::new();
    if let serde_json::Value::Object(map) = v {
        for (k, val) in map {
            out.insert(k.clone(), json_value_to_runtime(val));
        }
    }
    out
}

fn json_value_to_runtime(v: &serde_json::Value) -> storehouse::runtime::Value {
    use storehouse::runtime::Value;
    match v {
        serde_json::Value::Null => Value::Null,
        serde_json::Value::Bool(b) => Value::Bool(*b),
        serde_json::Value::Number(n) => n.as_i64().map(Value::Int)
            .unwrap_or_else(|| Value::Str(n.to_string())),
        serde_json::Value::String(s) => Value::Str(s.clone()),
        serde_json::Value::Array(a) => Value::List(a.iter().map(json_value_to_runtime).collect()),
        serde_json::Value::Object(m) => {
            let mut hm = HashMap::new();
            for (k, vv) in m { hm.insert(k.clone(), json_value_to_runtime(vv)); }
            Value::Map(hm)
        }
    }
}

fn runtime_value_to_json(v: &storehouse::runtime::Value) -> serde_json::Value {
    use storehouse::runtime::Value;
    match v {
        Value::Null => serde_json::Value::Null,
        Value::Bool(b) => serde_json::Value::Bool(*b),
        Value::Int(n) => serde_json::json!(*n),
        Value::Str(s) => serde_json::Value::String(s.clone()),
        Value::List(items) => serde_json::Value::Array(items.iter().map(runtime_value_to_json).collect()),
        Value::Map(m) => {
            let obj: serde_json::Map<String, serde_json::Value> =
                m.iter().map(|(k, v)| (k.clone(), runtime_value_to_json(v))).collect();
            serde_json::Value::Object(obj)
        }
    }
}

fn json_headers() -> Headers {
    let h = Headers::new();
    let _ = h.set("content-type", "application/json");
    h
}
