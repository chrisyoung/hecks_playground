/// Read-only twin of `walking_skeleton_dispatch` : boot + seed +
/// hydrate the Runtime exactly the same way, then resolve a query
/// instead of dispatching a command. A query never mutates, so R2 is
/// read (through boot) but never written back. Verb form is
/// `[Domain::]Aggregate.query_name` ; extra ?k=v pairs are the query
/// attrs (i101 structured wheres). e.g.
///   GET /query?verb=VinDiction::Product.fits&make=BMW&model=5%20Series
async fn query(req: Request, ctx: RouteContext<()>) -> Result<Response> {
    let url = match req.url() {
        Ok(u)  => u,
        Err(e) => return Response::error(format!("bad url : {}", e), 400),
    };
    let mut domain = String::new();
    let mut verb = String::new();
    let mut attrs: std::collections::HashMap<String, String> = std::collections::HashMap::new();
    for (k, v) in url.query_pairs() {
        match k.as_ref() {
            "domain" => domain = v.into_owned(),
            "verb"   => verb   = v.into_owned(),
            _        => { attrs.insert(k.into_owned(), v.into_owned()); }
        }
    }
    if verb.is_empty() {
        return Response::error(
            "missing 'verb' query param — expected '[Domain::]Aggregate.query_name'",
            400,
        );
    }
    let core = match verb.split_once("::") {
        Some((dom, rest)) => {
            if domain.is_empty() { domain = dom.to_string(); }
            rest.to_string()
        }
        None => verb.clone(),
    };
    let (aggregate, query_name) = match core.split_once('.') {
        Some((a, q)) => (a.to_string(), q.to_string()),
        None         => (String::new(), core.clone()),
    };
    let bucket = ctx.env.bucket("__R2_BINDING__").ok();
    let (runtimes, _) = boot_runtimes(bucket.as_ref()).await;
    let rt = if domain.is_empty() {
        runtimes.values().next()
    } else {
        runtimes.get(&domain)
    };
    let rt = match rt {
        Some(r) => r,
        None    => return Response::error(format!("unknown domain : {}", domain), 404),
    };
    let result = rt.borrow().resolve_query_qualified(None, &aggregate, &query_name, &attrs);
    Response::from_json(&serde_json::json!({
        "ok":     true,
        "verb":   verb,
        "domain": domain,
        "result": result,
    }))
}

async fn route(mut req: Request, ctx: RouteContext<()>) -> Result<Response> {
    // ── Auth ─────────────────────────────────────────────────
    let expected_token = ctx
        .env
        .secret("__AUTH_SECRET_ENV__")
        .map(|s| s.to_string())
        .unwrap_or_default();
    let header_token = req
        .headers()
        .get("Authorization")
        .ok()
        .flatten()
        .and_then(|h| h.strip_prefix("Bearer ").map(|t| t.to_string()))
        .unwrap_or_default();
    if expected_token.is_empty() || header_token != expected_token {
        return Response::error("unauthorized — Bearer token mismatch", 401);
    }

    let body: serde_json::Value = match req.json().await {
        Ok(v) => v,
        Err(e) => return Response::error(format!("bad JSON body : {}", e), 400),
    };
    let phrase = body.get("phrase").and_then(|v| v.as_str()).unwrap_or("").to_string();
    let params = body.get("params").cloned().unwrap_or(serde_json::Value::Object(serde_json::Map::new()));
    if phrase.is_empty() {
        return Response::error("missing 'phrase' field — expected 'app::domain::Aggregate::Command'", 400);
    }

    let bucket = match ctx.env.bucket("__R2_BINDING__") {
        Ok(b)  => b,
        Err(e) => return Response::error(format!("r2 binding __R2_BINDING__ unavailable : {}", e), 500),
    };
    let mut attrs = storehouse::heki::Record::new();
    attrs.insert("phrase".into(), serde_json::Value::String(phrase.clone()));
    attrs.insert("params".into(), params.clone());
    let appended = match storehouse::heki_r2::append_record(&bucket, "dispatch.heki", &attrs).await {
        Ok(rec) => rec,
        Err(e)  => return Response::error(format!("r2 append : {}", e), 502),
    };
    let body = serde_json::json!({
        "ok":                 true,
        "stage":              "appended-to-r2",
        "record":             appended,
        "bluebooks_embedded": embedded::BLUEBOOK_COUNT,
    });
    Response::from_json(&body)
}

