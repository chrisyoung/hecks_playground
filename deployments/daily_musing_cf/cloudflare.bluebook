HecksPlayground.bluebook "DailyMusingCloudflare", version: "2026.05.23.1" do
  vision "The Cloudflare deploy config for the Daily Musing WASM Worker, expressed as a bluebook. The wrangler.toml beside this file is DERIVED from this declaration — the bluebook is the source of truth, the toml is the artifact (the way the Procfile derives from mindstream)."

  # ============================================================
  # CLOUDFLARE WORKER CONFIG — config-as-bluebook
  # ============================================================
  #
  # This is NOT the deploy lifecycle (that lives in
  # integrations/cloudflare_deploy/cloudflare_deploy.bluebook). This
  # is the static configuration a `wrangler.toml` carries : worker
  # name, compatibility date, account, build command, and the
  # R2 persistence binding (heki -> R2).
  #
  # Derivation is the SEAM (fixtures→policies, 2026-07-26) :
  # `storehouse project wrangler deployments/daily_musing_cf` routes
  # BootCompleted through this corpus, the EstablishDailyMusingWorker
  # policy asserts the WorkerConfig record, and projection::wrangler
  # renders worker/wrangler.toml from the ESTABLISHED record. Byte-identity
  # is enforced by rust/tests/worker_config_establishment_test.rs.

  aggregate "WorkerConfig", "One Cloudflare Worker's deploy configuration" do
    identified_by :name
    attribute :name, WorkerName, default: "daily-musing-worker"
    attribute :compatibility_date, CompatibilityDate, default: "2026-05-10"
    attribute :account_id, AccountId
    attribute :main_entrypoint, MainEntrypoint, default: "build/worker/shim.mjs"
    # worker-build is pinned to 0.8.3 (not floating) : an unpinned
    # `cargo install -q worker-build` silently upgrades to whatever is
    # newest on crates.io on every fresh install, and 0.8.5 passes
    # `--experimental-reset-state-function` to wasm-bindgen
    # unconditionally, which fails with "externref table required for
    # catch wrappers" against every wasm-bindgen version tried (0.2.121,
    # 0.2.126, 0.2.127) in this environment. Discovered + fixed during
    # i768 slice 2.2 (hecks-hecksagain storehouse cutover verification).
    attribute :build_command, BuildCommand, default: "cargo install -q worker-build --version 0.8.3 && worker-build --release"
    # Persisted (heki -> R2). r2_binding is the env binding name lib.rs
    # reads (env.bucket("DAILY_MUSING_R2_BUCKET")) ; r2_bucket is the
    # R2 bucket those bytes live in. The derived wrangler.toml carries
    # the matching [[r2_buckets]] block.
    attribute :r2_binding, R2Binding, default: ""
    attribute :r2_bucket, R2Bucket, default: ""
    attribute :observability, Observability, default: "enabled"

    value_object "WorkerName" do
      attribute :value, String
    end
    value_object "CompatibilityDate" do
      attribute :value, String
    end
    value_object "AccountId" do
      attribute :value, String
    end
    value_object "MainEntrypoint" do
      attribute :value, String
    end
    value_object "BuildCommand" do
      attribute :value, String
    end
    value_object "R2Binding" do
      attribute :value, String
    end
    value_object "R2Bucket" do
      attribute :value, String
    end
    value_object "Observability" do
      attribute :value, String
    end

    command "Declare" do
      role "System"
      description "Declare the worker config (worker name, account, build, R2 binding)"
      attribute :name, WorkerName
      attribute :compatibility_date, CompatibilityDate
      attribute :account_id, AccountId
      attribute :main_entrypoint, MainEntrypoint
      attribute :build_command, BuildCommand
      attribute :r2_binding, R2Binding
      attribute :r2_bucket, R2Bucket
      attribute :observability, Observability
      then_set :name, to: :name
      then_set :compatibility_date, to: :compatibility_date
      then_set :account_id, to: :account_id
      then_set :main_entrypoint, to: :main_entrypoint
      then_set :build_command, to: :build_command
      then_set :r2_binding, to: :r2_binding
      then_set :r2_bucket, to: :r2_bucket
      then_set :observability, to: :observability
      emits "ConfigDeclared"
    end

    query "WorkerConfigs" do
      description "Every declared Cloudflare Worker config"
    end
  end

  # The worker config as ESTABLISHMENT (fixtures→policies, 2026-07-26) —
  # `on "BootCompleted"` (the boot-establishment keystone) upserts the
  # WorkerConfig on :name ; `storehouse establish <root>` re-asserts on
  # demand. The derived wrangler.toml projects from the ESTABLISHED record
  # through the seam (`storehouse project wrangler <root>` →
  # projection::wrangler) — never by re-parsing this file, never by hand.
  policy "EstablishDailyMusingWorker" do
    on "BootCompleted"
    trigger "WorkerConfig.Declare"
    with "name", "daily-musing-worker"
    with "compatibility_date", "2026-05-10"
    with "account_id", "d64266851dc554da77687e13c058917c"
    with "main_entrypoint", "build/worker/shim.mjs"
    with "build_command", "cargo install -q worker-build --version 0.8.3 && worker-build --release"
    with "r2_binding", "DAILY_MUSING_R2_BUCKET"
    with "r2_bucket", "daily-musing-heki"
    with "observability", "enabled"
  end

  glossary do
    define "worker", as: "Cloudflare Worker — the WASM dispatch surface, the bluebook command bus over HTTP"
    define "compatibility date", as: "The Workers runtime API version the deploy pins to"
    define "memory-first", as: "No persistence binding ; each request boots a fresh in-memory runtime seeded from embedded fixtures"
    prefer "worker", not: ["function", "lambda"]
  end
end
