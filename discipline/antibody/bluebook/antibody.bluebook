Hecks.bluebook "Antibody", version: "2026.04.21.1" do
  vision "Miette's own immune system — every commit inspected, every un-triaged script rejected, every exemption auditable"

  # ============================================================
  # ANTIBODY
  # ============================================================
  #
  # Three modes of self-inspection, one per aggregate:
  #
  #   CommitCheck   — one historical commit in isolation
  #   BranchScan    — a sweep of base..HEAD (survey or per-commit)
  #   StagedCheck   — the in-flight commit (what git is about to write)
  #
  # Each mode is a one-shot validation. There are no cross-aggregate
  # policies: antibody fires from a hook or a CLI invocation, evaluates
  # once, and lets the caller read the verdict. The Rust shim (PR C
  # follow-up) drives the git shell-outs declared in antibody.hecksagon
  # and dispatches one of the verdict commands below per invocation.

  # ---- CommitCheck ------------------------------------------------

  aggregate "CommitCheck" do

    description "One commit validated in isolation against the antibody rules"
    identified_by :sha
    attribute :sha, CommitSha
    attribute :subject, CommitSubject
    attribute :touched_files, list_of(FilePath)
    attribute :flagged_files, list_of(FilePath)
    attribute :exemption_reasons, list_of(Reason)
    attribute :verdict, Verdict, default: { value: "pending" }


    value_object "FilePath" do
      # Filesystem path — touched / flagged file in this commit.
      attribute :value, String
    end

    value_object "CommitSha" do
      # Git commit SHA.
      attribute :value, String
    end

    value_object "CommitSubject" do
      # First line of the commit message — the title.
      attribute :value, String
    end

    value_object "BranchRef" do
      # Git ref name — the base commit of the scan.
      attribute :value, String
    end

    value_object "Verdict" do
      # Per-commit outcome : 'pass' | 'fail' | 'pending'.
      attribute :value, String
    end

    value_object "Reason" do
      # Exempt-marker text on a non-bluebook file.
      attribute :value, String
    end
    command "ValidateCommit" do
      role "System"
      goal "Survey the files and message of a commit — record it as a clean pass"
      attribute :sha, CommitSha
      attribute :subject, CommitSubject
      attribute :touched_files, list_of(FilePath)
      attribute :flagged_files, list_of(FilePath)
      sets :sha
      sets :subject
      sets :touched_files
      sets :flagged_files
      emits "CommitEvaluated"
    end

    command "ExemptCommit" do
      role "System"
      goal "A commit's message carries valid exemption markers covering every flagged file"
      attribute :sha, CommitSha
      attribute :subject, CommitSubject
      attribute :touched_files, list_of(FilePath)
      attribute :flagged_files, list_of(FilePath)
      attribute :exemption_reasons, list_of(Reason)
      sets :sha
      sets :subject
      sets :touched_files
      sets :flagged_files
      sets :exemption_reasons
      emits "CommitExempted"
    end

    command "RejectCommit" do
      role "System"
      goal "A commit has flagged files that no exemption marker covers"
      attribute :sha, CommitSha
      attribute :subject, CommitSubject
      attribute :touched_files, list_of(FilePath)
      attribute :flagged_files, list_of(FilePath)
      sets :sha
      sets :subject
      sets :touched_files
      sets :flagged_files
      emits "CommitRejected"
    end

    lifecycle :verdict, default: "pending" do
      transition "ValidateCommit" => "pass",      from: "pending"
      transition "ExemptCommit"   => "exempted",  from: "pending"
      transition "RejectCommit"   => "rejected",  from: "pending"
    end
  end

  # ---- BranchScan -------------------------------------------------

  aggregate "BranchScan" do

    description "A sweep of base..HEAD — either a single-diff survey or a per-commit walk"
    identified_by :base_ref
    attribute :base_ref, BranchRef
    attribute :touched_files, list_of(FilePath)
    attribute :flagged_files, list_of(FilePath)
    attribute :per_commit_verdicts, list_of(CommitVerdict)
    attribute :mode, Mode
    attribute :result, Result, default: { value: "pending" }

    value_object "CommitVerdict" do
      attribute :sha, CommitSha
      attribute :verdict, Verdict
      attribute :flagged_files, list_of(FilePath)
    end


    value_object "FilePath" do
      # Filesystem path — touched / flagged file in this scan.
      attribute :value, String
    end

    value_object "BranchRef" do
      # Git ref name — the base commit of the scan.
      attribute :value, String
    end

    value_object "Mode" do
      # Scan mode : 'single-diff' (one combined diff) or 'per-commit' (walk each commit individually).
      attribute :value, String
    end

    value_object "Result" do
      # Aggregate outcome of the scan : 'pass' | 'fail' | 'pending'.
      attribute :value, String
    end

    value_object "CommitSha" do
      # Git commit SHA — used by per-commit verdicts.
      attribute :value, String
    end

    value_object "Verdict" do
      # Per-commit outcome inside a CommitVerdict row.
      attribute :value, String
    end
    command "ScanBranch" do
      role "System"
      goal "Survey mode — diff base..HEAD, flag any extension in CODE_EXTS without an exemption"
      attribute :base_ref, BranchRef
      attribute :touched_files, list_of(FilePath)
      attribute :flagged_files, list_of(FilePath)
      sets :base_ref
      sets :touched_files
      sets :flagged_files
      sets :mode, to: "survey"
      emits "ScanCompleted"
    end

    command "ScanEachCommit" do
      role "System"
      goal "Per-commit mode — walk every commit in base..HEAD, each in isolation"
      attribute :base_ref, BranchRef
      attribute :per_commit_verdicts, list_of(CommitVerdict)
      sets :base_ref
      sets :per_commit_verdicts
      sets :mode, to: "each_commit"
      emits "EachCommitScanCompleted"
    end

    command "ScanUnresolvable" do
      role "System"
      goal "The declared base ref does not resolve — the scan cannot proceed"
      attribute :base_ref, BranchRef
      sets :base_ref
      emits "ScanUnresolvable"
    end

    lifecycle :result, default: "pending" do
      transition "ScanBranch"         => "clean",             from: "pending"
      transition "ScanEachCommit"     => "clean",             from: "pending"
      transition "ScanUnresolvable"   => "base_unresolvable", from: "pending"
    end
  end

  # ---- StagedCheck ------------------------------------------------

  aggregate "StagedCheck" do

    description "The in-flight commit — what the pre-commit hook is about to let through"
    identified_by :check_id
    attribute :check_id, CheckId
    attribute :staged_files, list_of(FilePath)
    attribute :flagged_files, list_of(FilePath)
    attribute :message_path, FilePath
    attribute :exemption_reasons, list_of(Reason)
    attribute :mode, Mode
    attribute :result, Result, default: { value: "pending" }


    value_object "CheckId" do
      # One hook invocation's identity : the caller names each in-flight check.
      attribute :value, String
    end

    value_object "FilePath" do
      # Filesystem path — staged / flagged file, or the commit-message path.
      attribute :value, String
    end

    value_object "Mode" do
      # Pre-commit check mode.
      attribute :value, String
    end

    value_object "Result" do
      # Outcome of the staged check : 'pass' | 'fail' | 'pending'.
      attribute :value, String
    end

    value_object "Reason" do
      # Exempt-marker text on a staged non-bluebook file.
      attribute :value, String
    end
    command "CheckStaged" do
      role "System"
      goal "List-only mode — enumerate flagged files, never block the commit"
      attribute :check_id, CheckId
      sets :check_id
      attribute :staged_files, list_of(FilePath)
      attribute :flagged_files, list_of(FilePath)
      sets :staged_files
      sets :flagged_files
      sets :mode, to: "list_only"
      emits "StagedListed"
    end

    command "EnforceStaged" do
      role "System"
      goal "Hook mode — the commit has no flagged files that lack exemption"
      attribute :check_id, CheckId
      sets :check_id
      attribute :staged_files, list_of(FilePath)
      attribute :flagged_files, list_of(FilePath)
      attribute :message_path, FilePath
      sets :staged_files
      sets :flagged_files
      sets :message_path
      sets :mode, to: "enforce"
      emits "StagedClean"
    end

    command "ExemptStaged" do
      role "System"
      goal "The staged message carries exemption markers that cover every flagged file"
      attribute :check_id, CheckId
      sets :check_id
      attribute :staged_files, list_of(FilePath)
      attribute :flagged_files, list_of(FilePath)
      attribute :message_path, FilePath
      attribute :exemption_reasons, list_of(Reason)
      sets :staged_files
      sets :flagged_files
      sets :message_path
      sets :exemption_reasons
      emits "StagedExempted"
    end

    command "RejectStaged" do
      role "System"
      goal "The staged commit has flagged files that no exemption covers — block the commit"
      attribute :check_id, CheckId
      sets :check_id
      attribute :staged_files, list_of(FilePath)
      attribute :flagged_files, list_of(FilePath)
      sets :staged_files
      sets :flagged_files
      emits "StagedRejected"
    end

    lifecycle :result, default: "pending" do
      transition "CheckStaged"   => "flagged_list", from: "pending"
      transition "EnforceStaged" => "clean",        from: "pending"
      transition "ExemptStaged"  => "exempted",     from: "pending"
      transition "RejectStaged"  => "rejected",     from: "pending"
    end
  end

  # ============================================================
  # EXEMPT REGISTRY — runtime-queried allowlist of non-bluebook files
  # ============================================================
  #
  # The macrophage hook (run_enforce_edit) consults the registry on every
  # PostToolUse Edit/Write event. A path that suffix-matches an entry's
  # `path` field is silently allowed ; any other non-bluebook file edit
  # raises the bluebook-first violation.
  #
  # Why this aggregate lives in the bluebook (not in antibody.fixtures
  # like its peers) : the registry is RUNTIME state, not test data.
  # Per the test-purity rule (capabilities/test_purity_shape) ,
  # .fixtures is build/test-time only ; runtime config goes through
  # commands → events → .heki via the standard adapter pipeline. The
  # row set lives in `information/exempt_registry.heki` and is mutated
  # by RegisterExemption / RetireExemption.

  aggregate "ExemptRegistry" do

    description "One non-bluebook file path allowed past the bluebook-first macrophage — kernel-surface or transitional"
    identified_by :path

    # Repo-relative path (suffix-matched against the edited file).
    attribute :path, FilePath
    # One-line rationale ; cited in the macrophage dashboard.
    attribute :reason, Reason

    # ExemptionSpec — one (path, reason) row in a bulk register call.
    # Used by RegisterExemptions to seed many rows in one dispatch ; the
    # runtime iterates the list and saves one ExemptRegistry record per
    # spec. Lives as a value_object on the aggregate so the bulk command
    # can declare `list_of(ExemptionSpec)` and the runtime can match the
    # VO's `path` field against the aggregate's `identified_by :path`.
    value_object "ExemptionSpec" do
      attribute :path, FilePath
      attribute :reason, Reason
    end


    value_object "FilePath" do
      # The exempted non-bluebook file path.
      attribute :value, String
    end

    value_object "Reason" do
      # Why this file is exempt — kernel-surface, transitional, etc.
      attribute :value, String
    end
    command "RegisterExemption" do
      role "Chris"
      goal "Add a kernel-surface or transitional file to the exemption list. The macrophage hook reads this on every Edit / Write event ; suffix-matching means relative or absolute paths both resolve. Idempotent — registering an existing path overwrites the reason."
      attribute :path, FilePath
      attribute :reason, Reason
      sets :path
      sets :reason
      emits "ExemptionRegistered"
    end

    command "RegisterExemptions" do
      role "Chris"
      goal "Bulk variant of RegisterExemption — one dispatch, N records saved. The runtime detects the bulk shape (single attribute, list_of value_object whose fields cover the aggregate's identity + value attrs) and iterates : for each ExemptionSpec it builds a per-row state and saves it through the standard save path. Upsert semantics carry through ; re-dispatching with overlapping specs overwrites the matching rows. Emits one `ExemptionsRegistered` fact for the batch: an event is one fact and the gem requires every emitter of a name to declare the same fields, so the batch cannot share `ExemptionRegistered` with the single form. The Many-form convention : every Register* command in the corpus that has a natural multi-row shape gets a Many sibling. Antibody is the proving ground (i113 / i116)."
      attribute :specs, list_of(ExemptionSpec)
      emits "ExemptionsRegistered"
    end

    command "ReviseExemption" do
      role "Chris"
      goal "Replace the reason on a path already in the registry. RegisterExemption is a creator and is refused when the path exists, so overwriting is its own command acting on the existing record."
      reference_to(ExemptRegistry)
      attribute :reason, Reason
      sets :reason
      emits "ExemptionRevised"
    end

    command "RetireExemption" do
      role "Chris"
      goal "Remove a path from the registry — the file is now bluebook-conceived (or has been deleted). The macrophage will start blocking edits to it again on the next hook fire. The published gem has no delete mutation word, so retirement is recorded as the ExemptionRetired event and the row removal itself is not expressible until the gem gains one."
      reference_to(ExemptRegistry)
      emits "ExemptionRetired"
    end
  end
end
