Hecks.bluebook "CorpusPruning", version: "2026.05.12.1" do
  vision "Shape training data for learning — split monsters, add missing features, deduplicate, balance categories"
  category "capability"

  # i111-C : pipeline-stage collapse — added a CorpusPruning root that
  # owns all four phase concepts (MonsterSplit / FeatureEnrichment /
  # Deduplicator / CategoryBalancer). None of the originals had
  # identified_by ; they were stages of one pruning workflow, not peers.
  # Their commands and attributes collapse into the root ; their
  # value_objects (Chunk, DuplicatePair, CategoryWeight) ride along.

  aggregate "CorpusPruning", "One full pruning sweep — split monsters, enrich features, dedupe, balance categories" do
    identified_by :domain_name
    # ── MonsterSplit phase ──
    attribute :source_domain, SourceDomain
    attribute :original_size, OriginalSize
    attribute :chunk_count, ChunkCount
    attribute :chunks, list_of(Chunk)
    # original_size is set by MeasureDomain so SplitMonster can gate on it.
    # The planner picks MeasureDomain as the producer.
    attribute :measured, Measured, default: false

    # ── FeatureEnrichment phase ──
    attribute :domain_name, DomainName
    attribute :feature_type, FeatureType
    attribute :additions_made, AdditionsMade
    attribute :still_valid, TrueClass

    # ── Deduplicator phase ──
    attribute :total_pairs, TotalPairs
    attribute :duplicates_found, DuplicatesFound
    attribute :matches, list_of(DuplicatePair)

    # ── CategoryBalancer phase ──
    attribute :weights, list_of(CategoryWeight)
    attribute :target_per_category, TargetPerCategory
    attribute :rebalanced_count, RebalancedCount

    value_object "SourceDomain" do
      attribute :value, String
    end
    value_object "OriginalSize" do
      attribute :value, Integer
    end
    value_object "ChunkCount" do
      attribute :value, Integer
    end
    value_object "Measured" do
      attribute :value, Boolean
    end
    value_object "DomainName" do
      attribute :value, String
    end
    value_object "FeatureType" do
      attribute :value, String
    end
    value_object "AdditionsMade" do
      attribute :value, Integer
    end
    value_object "TotalPairs" do
      attribute :value, Integer
    end
    value_object "DuplicatesFound" do
      attribute :value, Integer
    end
    value_object "TargetPerCategory" do
      attribute :value, Integer
    end
    value_object "RebalancedCount" do
      attribute :value, Integer
    end
    value_object "MaxAggregatesPerChunk" do
      attribute :value, Integer
    end
    value_object "JsonlPath" do
      attribute :value, String
    end
    value_object "SimilarityThreshold" do
      attribute :value, Float
    end
    value_object "Category" do
      attribute :value, String
    end
    value_object "MaxCount" do
      attribute :value, Integer
    end

    value_object "Chunk" do
      attribute :sub_domain_name, String
      attribute :aggregate_count, Integer
      attribute :command_count, Integer
      attribute :focus_description, String
    end

    value_object "DuplicatePair" do
      attribute :domain_a, String
      attribute :domain_b, String
      attribute :similarity, Float
    end

    value_object "CategoryWeight" do
      attribute :category, String
      attribute :count, Integer
      attribute :percentage, Float
      attribute :target, Integer
    end

    # ── MonsterSplit commands ──

    command "MeasureDomain" do
      description "Count aggregates in the source domain so SplitMonster knows whether it is large enough to chunk"
      attribute :source_domain, SourceDomain
      attribute :original_size, OriginalSize
      emits "DomainMeasured"
      then_set :original_size, to: :original_size
      then_set :measured, to: true
    end

    command "SplitMonster" do
      description "Break a domain with 10+ aggregates into 3-4 aggregate chunks"
      attribute :source_domain, SourceDomain
      attribute :max_aggregates_per_chunk, MaxAggregatesPerChunk
      given { measured == true }
      given { original_size > 8 }
      emits "MonsterSplit"
    end

    # ── FeatureEnrichment commands ──

    command "AddReferences" do
      description "Add reference_to to action commands that operate on existing aggregates"
      attribute :domain_name, DomainName
      emits "ReferencesAdded"
    end

    command "AddCollections" do
      description "Add list_of value objects where an aggregate logically owns many children"
      attribute :domain_name, DomainName
      emits "CollectionsAdded"
    end

    command "AddGivens" do
      description "Add preconditions to commands where domain logic requires them"
      attribute :domain_name, DomainName
      emits "GivensAdded"
    end

    command "Revalidate" do
      description "Confirm the domain still boots after enrichment"
      emits "EnrichmentValidated"
    end

    # ── Deduplicator commands ──

    command "FindDuplicates" do
      description "Compare all domain pairs by structural vector similarity — flag near-clones"
      attribute :jsonl_path, JsonlPath
      attribute :similarity_threshold, SimilarityThreshold
      emits "DuplicatesFound"
    end

    command "MergeDuplicates" do
      description "Keep the richer domain from each duplicate pair, discard the thinner one"
      emits "DuplicatesMerged"
    end

    # ── CategoryBalancer commands ──

    # Renamed AssessCategoryBalance + CategoryBalanceAssessed (was
    # AssessBalance + BalanceAssessed) to avoid event-name collision
    # with Proprioception.AssessBalance / Proprioception.BalanceAssessed
    # in Miette's body. CapAfterAssess now listens on the unique event
    # name. i117 Round 4 cross-corpus dispatch surfaced the collision —
    # both domains used the same generic name for two different concerns
    # (training-corpus category counts vs. body proprioception).
    command "AssessCategoryBalance" do
      description "Count domains per category, flag over and under-represented groups"
      attribute :jsonl_path, JsonlPath
      emits "CategoryBalanceAssessed"
    end

    command "CapCategory" do
      description "Randomly sample down an over-represented category to the target count"
      attribute :category, Category
      attribute :max_count, MaxCount
      emits "CategoryCapped"
    end
  end

  policy "ValidateAfterEnrich" do
    on "ReferencesAdded"
    trigger "Revalidate"
  end

  policy "ValidateAfterCollections" do
    on "CollectionsAdded"
    trigger "Revalidate"
  end

  policy "MergeAfterFind" do
    on "DuplicatesFound"
    trigger "MergeDuplicates"
  end

  policy "CapAfterAssess" do
    on "CategoryBalanceAssessed"
    trigger "CapCategory"
  end
end
