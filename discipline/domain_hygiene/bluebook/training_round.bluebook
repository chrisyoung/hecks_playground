Hecks.bluebook "TrainingRound", version: "2026.05.12.1" do
  vision "Run a complete training data cycle — grow, enrich, prune, extract, assess, repeat until quality target is met"
  category "capability"

  # i111-C : pipeline-stage collapse — Round is the sole aggregate root.
  # The five phase concepts (Growth / Enrichment / Pruning / Extraction /
  # Decision) used to be sibling aggregates ; per Evans's DDD they are
  # phases of one workflow on a single root, not peer aggregates with
  # their own identity. None had identified_by, none had a self-ref
  # lifecycle ; they were attribute-bags hanging off command names.
  # Their commands migrate to Round ; their descriptive attributes merge
  # into Round's state ; the workflow shape is preserved by the existing
  # `phases : list_of(Phase)` value_object collection.

  aggregate "Round", "One full cycle of corpus improvement — tracks what happened and what to do next" do
    # ── Round metrics ──
    attribute :round_number, RoundNumber
    attribute :starting_pairs, StartingPairs
    attribute :ending_pairs, EndingPairs
    attribute :strong_pairs, StrongPairs
    attribute :reference_coverage, ReferenceCoverage
    attribute :policy_coverage, PolicyCoverage
    attribute :status, Status
    attribute :complete, TrueClass, default: false
    attribute :phases, list_of(Phase)

    # ── Growth phase metrics (was GrowthPhase) ──
    attribute :target_count, TargetCount
    attribute :conceived, Conceived
    attribute :validated, Validated
    attribute :topics, list_of(Topic)

    # ── Enrichment phase metrics (was EnrichmentPhase) ──
    attribute :domains_scanned, DomainsScanned
    attribute :references_added, ReferencesAdded
    attribute :collections_added, CollectionsAdded
    attribute :givens_added, GivensAdded
    attribute :revalidated, Revalidated

    # ── Pruning phase metrics (was PruningPhase) ──
    attribute :monsters_split, MonstersSplit
    attribute :duplicates_merged, DuplicatesMerged
    attribute :categories_capped, CategoriesCapped
    attribute :final_pair_count, FinalPairCount

    # ── Extraction phase metrics (was ExtractionPhase) ──
    attribute :output_path, OutputPath
    attribute :total_pairs, TotalPairs
    attribute :reference_pct, ReferencePct
    attribute :policy_pct, PolicyPct
    attribute :gaps, list_of(Gap)

    # ── Decision metrics (was Decision) ──
    attribute :targets_met, TrueClass
    attribute :reference_gap, ReferenceGap
    attribute :policy_gap, PolicyGap
    attribute :pair_deficit, PairDeficit
    attribute :recommendation, Recommendation

    value_object "Phase" do
      attribute :name, String
      attribute :input_count, Integer
      attribute :output_count, Integer
      attribute :fixed, Integer
      attribute :rejected, Integer
      attribute :duration, String
    end

    value_object "RoundNumber" do
      attribute :value, Integer
    end
    value_object "StartingPairs" do
      attribute :value, Integer
    end
    value_object "EndingPairs" do
      attribute :value, Integer
    end
    value_object "StrongPairs" do
      attribute :value, Integer
    end
    value_object "ReferenceCoverage" do
      attribute :value, Float
    end
    value_object "PolicyCoverage" do
      attribute :value, Float
    end
    value_object "Status" do
      attribute :value, String
    end
    value_object "TargetCount" do
      attribute :value, Integer
    end
    value_object "Conceived" do
      attribute :value, Integer
    end
    value_object "Validated" do
      attribute :value, Integer
    end
    value_object "Topic" do
      attribute :value, String
    end
    value_object "DomainsScanned" do
      attribute :value, Integer
    end
    value_object "ReferencesAdded" do
      attribute :value, Integer
    end
    value_object "CollectionsAdded" do
      attribute :value, Integer
    end
    value_object "GivensAdded" do
      attribute :value, Integer
    end
    value_object "Revalidated" do
      attribute :value, Integer
    end
    value_object "MonstersSplit" do
      attribute :value, Integer
    end
    value_object "DuplicatesMerged" do
      attribute :value, Integer
    end
    value_object "CategoriesCapped" do
      attribute :value, Integer
    end
    value_object "FinalPairCount" do
      attribute :value, Integer
    end
    value_object "OutputPath" do
      attribute :value, String
    end
    value_object "TotalPairs" do
      attribute :value, Integer
    end
    value_object "ReferencePct" do
      attribute :value, Float
    end
    value_object "PolicyPct" do
      attribute :value, Float
    end
    value_object "Gap" do
      attribute :value, String
    end
    value_object "ReferenceGap" do
      attribute :value, Float
    end
    value_object "PolicyGap" do
      attribute :value, Float
    end
    value_object "PairDeficit" do
      attribute :value, Integer
    end
    value_object "Recommendation" do
      attribute :value, String
    end
    value_object "GrowthTarget" do
      attribute :value, Integer
    end
    value_object "MinReferencePct" do
      attribute :value, Float
    end
    value_object "MinPolicyPct" do
      attribute :value, Float
    end
    value_object "MaxCompletionSize" do
      attribute :value, Integer
    end
    value_object "SimilarityThreshold" do
      attribute :value, Float
    end

    command "StartRound" do
      description "Begin a training round — assess current corpus, set targets"
      attribute :round_number, RoundNumber
      attribute :growth_target, GrowthTarget
      attribute :min_reference_pct, MinReferencePct
      attribute :min_policy_pct, MinPolicyPct
      emits "RoundStarted"
    end

    command "CompleteRound" do
      description "Finalize a round — record metrics and decide if another is needed"
      emits "RoundCompleted"
    end

    command "RunGrowth" do
      description "Conceive domains across diverse topics, validate each one"
      attribute :target_count, TargetCount
      attribute :topics, list_of(Topic)
      emits "GrowthComplete"
    end

    command "RunEnrichment" do
      description "Scan all domains, add references, collections, and givens where missing"
      emits "EnrichmentComplete"
    end

    command "RunPruning" do
      description "Split monsters, merge duplicates, balance categories"
      attribute :max_completion_size, MaxCompletionSize
      attribute :similarity_threshold, SimilarityThreshold
      emits "PruningComplete"
    end

    command "RunExtraction" do
      description "Extract JSONL training pairs from all valid domains and assess quality"
      attribute :output_path, OutputPath
      emits "ExtractionComplete"
    end

    command "Evaluate" do
      description "Compare current metrics against targets — recommend continue or ship"
      emits "DecisionMade"
    end
  end

  # The pipeline: grow → enrich → prune → extract → decide
  policy "GrowOnStart" do
    on "RoundStarted"
    trigger "RunGrowth"
  end

  policy "EnrichOnGrowth" do
    on "GrowthComplete"
    trigger "RunEnrichment"
  end

  policy "PruneOnEnrich" do
    on "EnrichmentComplete"
    trigger "RunPruning"
  end

  policy "ExtractOnPrune" do
    on "PruningComplete"
    trigger "RunExtraction"
  end

  policy "DecideOnExtract" do
    on "ExtractionComplete"
    trigger "Evaluate"
  end

  policy "CompleteOnDecision" do
    on "DecisionMade"
    trigger "CompleteRound"
  end
end
