Hecks.behaviors "Restructure" do
  vision "Behavioral tests for the Restructure capability — exercises layout lifecycle, move event spine, post-move verification, and rewind via Revert"

  # ── Layout aggregate ────────────────────────────────────────

  test "Define seeds a draft layout at status=draft" do
    tests "Define", on: "Layout"
    input  name: "v1", version: "2026.04.30.1", description: "first cut"
    expect status: "draft", emits: ["LayoutDefined"]
  end

  test "Plan advances draft layout to planned" do
    tests "Plan", on: "Layout"
    setup  "Layout.Define", name: "v1", version: "2026.04.30.1", description: "first cut"
    input  name: "v1"
    expect status: "planned", emits: ["LayoutPlanned"]
  end

  test "Apply advances planned layout to applied" do
    tests "Apply", on: "Layout"
    setup  "Layout.Define", name: "v1", version: "2026.04.30.1", description: "first cut"
    setup  "Layout.Plan",   layout: "v1", name: "v1"
    input  name: "v1"
    expect status: "applied", emits: ["LayoutApplied"]
  end

  test "Show emits LayoutShown without mutating layout state" do
    tests "Show", on: "Layout"
    setup  "Layout.Define", name: "v1", version: "2026.04.30.1", description: "first cut"
    input  name: "v1"
    expect status: "draft", emits: ["LayoutShown"]
  end

  test "RevertTo advances applied layout to reverted" do
    tests "RevertTo", on: "Layout"
    setup  "Layout.Define", name: "v1", version: "2026.04.30.1", description: "first cut"
    setup  "Layout.Plan",   layout: "v1", name: "v1"
    setup  "Layout.Apply",  layout: "v1", name: "v1"
    input  name: "v1"
    expect status: "reverted", emits: ["LayoutReverted"]
  end

  # ── Placement aggregate ─────────────────────────────────────

  test "Add attaches a placement rule" do
    tests "Add", on: "Placement"
    input  pattern: "*.bluebook", destination: "aggregates/", reason: "domains live at the root of aggregates/"
    expect emits: ["PlacementAdded"]
  end

  # ── Move aggregate ──────────────────────────────────────────
  #
  # The event-source spine. Status walks planned → applied →
  # verified → reverted via the corresponding commands. The events
  # carry from + to so a Move.Revert log replay IS filesystem undo.

  test "Move.Plan queues a move at status=planned with layout linkage" do
    tests "Plan", on: "Move"
    input  move: "m1", move_id: "m1", from: "old/path.bluebook", to: "new/path.bluebook", layout: "v1"
    expect status: "planned", from: "old/path.bluebook", to: "new/path.bluebook", layout: "v1", emits: ["MovePlanned"]
  end

  test "Move.Apply advances planned to applied" do
    tests "Apply", on: "Move"
    setup  "Move.Plan", move_id: "m1", from: "old/path.bluebook", to: "new/path.bluebook", layout: "v1"
    input  move: "m1", move_id: "m1", applied_at: "2026-04-30T20:00:00Z"
    expect status: "applied", emits: ["MoveApplied"]
  end

  test "Move.Verify advances applied to verified" do
    tests "Verify", on: "Move"
    setup  "Move.Plan",  move_id: "m1", from: "old/path.bluebook", to: "new/path.bluebook", layout: "v1"
    setup  "Move.Apply", move: "m1", move_id: "m1", applied_at: "2026-04-30T20:00:00Z"
    input  move: "m1", move_id: "m1"
    expect status: "verified", emits: ["MoveVerified"]
  end

  test "Move.Revert advances applied to reverted" do
    tests "Revert", on: "Move"
    setup  "Move.Plan",  move_id: "m1", from: "old/path.bluebook", to: "new/path.bluebook", layout: "v1"
    setup  "Move.Apply", move: "m1", move_id: "m1", applied_at: "2026-04-30T20:00:00Z"
    input  move: "m1", move_id: "m1"
    expect status: "reverted", emits: ["MoveReverted"]
  end

  test "Move.Fail flips applied to failed" do
    tests "Fail", on: "Move"
    setup  "Move.Plan",  move_id: "m1", from: "old/path.bluebook", to: "new/path.bluebook", layout: "v1"
    setup  "Move.Apply", move: "m1", move_id: "m1", applied_at: "2026-04-30T20:00:00Z"
    input  move: "m1", move_id: "m1"
    expect status: "failed", emits: ["MoveFailed"]
  end

  # ── Convention aggregate ────────────────────────────────────

  test "Declare seeds a loading convention" do
    tests "Declare", on: "Convention"
    input  name: "bluebooks_at_root", from_position: "aggregates/", look_for: "*.bluebook", recursive: "true"
    expect emits: ["ConventionDeclared"]
  end

end
