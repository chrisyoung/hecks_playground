#       expect(pms.first.name).to eq("OrderFulfillment")
#
#       # Drive the state machine through the bus :
#       event = double("OrderPlaced", order_id: "ord_42")
#       def event.class; OrderPlaced ; end  # for const_short_name
#       bus.publish("OrderPlaced", event)
#
#       instance = pms.first.store.find("ord_42")
#       expect(instance[:state]).to eq(:started)
#       expect(instance[:pending_commands]).to eq(["ReserveInventory"])
#     end
#
#     it "is a no-op when domain has no process_managers attr" do
#       expect(described_class.load_all(double, Hecks::EventBus.new)).to eq([])
#     end
#
#     it "is a no-op when process_managers is empty" do
#       domain = double(process_managers: [])
#       expect(described_class.load_all(domain, Hecks::EventBus.new)).to eq([])
#     end
#   end
#
# === Smoke check (post-landing)
#
# +ruby -Iruby examples/pizzas/pizzas.rb+ — pizzas has no PMs, so it
# must boot identically to before (proves the loader is benign on
# domains that don't use the keyword).
#
# === SleepCycle integration (Phase 4 bridge)
#
# Once Phase 4's +sleep_cycle.bluebook+ declares the SleepCycle PM, the
# verification is end-to-end : boot Miette, send a +SleepEntered+
# event, confirm the PM transitions through its declared states by
# inspecting +runtime.process_managers.first.store.find(body_id)+.
#
# == Runtime gaps spotted (inbox-worthy)
#
# 1. +Runtime+ owns the event bus and the IR ; calling the loader from
#    inside +Runtime#initialize+ is the natural seam. +Hecks.boot+
#    itself does not need changes — the loader hooks below the boot
#    surface. (Sometimes Chris's prompt phrasing implies +Hecks.boot+
#    is the integration point ; in this codebase it isn't.)
# 2. +Hecks::SagaStore.new+ is in-memory only. PM instance state is
#    lost on process restart. Acceptable for Phase 2 (matches saga
#    behavior), but a follow-up inbox item should pair PM persistence
#    with saga persistence so they evolve together.
# 3. +pm.subscribe_to(event_bus)+ subscribes per declared event type.
#    If the same event type is declared on two PMs (e.g. both SleepCycle
#    and AwakeLife observe +PhaseElapsed+), both PMs receive the event
#    independently — confirmed by re-reading +EventBus#subscribe+ ;
#    that's the desired behavior, not a gap. Worth noting in the
#    glossary lock at Phase 10.
