#!/usr/bin/env python3
"""mock-gateway — a throwaway payment gateway for PROVING the stripe-handler's
off-core transport loop. This is a VERIFICATION FIXTURE for adapter_host_demo,
not runtime code : it exercises the four edges the handler must distinguish.

Modes (env MOCK_MODE) :
  authorize -> 200 {"id":"ch_mock_N","status":"authorized"}   (the happy path)
  decline   -> 402 {"id":"ch_mock_N","status":"declined"}     (a VERDICT — no retry)
  flaky     -> 500 for the first MOCK_FAILS requests, then 200 (proves retry RECOVERY)
  hang      -> sleep MOCK_HANG_S then 200                      (proves timeout -> retry)

Usage : MOCK_MODE=flaky MOCK_FAILS=2 mock-gateway 8787
"""
import os, sys, json, time
from http.server import BaseHTTPRequestHandler, HTTPServer

MODE = os.environ.get("MOCK_MODE", "authorize")
FAILS = int(os.environ.get("MOCK_FAILS", "2"))
HANG_S = float(os.environ.get("MOCK_HANG_S", "5"))
PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 8787
seen = {"n": 0}


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *_):
        pass

    def do_POST(self):
        self.rfile.read(int(self.headers.get("Content-Length", 0) or 0))
        seen["n"] += 1
        n = seen["n"]
        ref = "ch_mock_%d" % n
        if MODE == "hang":
            time.sleep(HANG_S)
            return self._send(200, ref, "authorized")
        if MODE == "flaky" and n <= FAILS:
            return self._send(500, ref, "gateway_error")
        if MODE == "decline":
            return self._send(402, ref, "declined")
        return self._send(200, ref, "authorized")

    def _send(self, code, ref, status):
        body = json.dumps({"id": ref, "status": status}).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
        sys.stderr.write("[mock-gateway] #%d -> %d %s\n" % (seen["n"], code, status))


if __name__ == "__main__":
    sys.stderr.write("[mock-gateway] mode=%s port=%d\n" % (MODE, PORT))
    HTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
