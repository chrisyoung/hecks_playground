# The Shop hexagon. ONE effect-port edge : Order is charged_by the Stripe
# adapter when OrderPlaced fires, and the async verdict re-enters as one of
# the `into:` union. This binding is the CONTRACT a standalone Stripe host
# reads (which event to watch, which verdicts to dispatch) ; it says nothing
# about transport — that the edge is satisfied out-of-process is a wiring
# choice (effect port -> separate program), not part of the binding.
Hecks.hecksagon "Shop" do
  Shop::Order.charged_by("Stripe", on: "OrderPlaced") do
    success "Order.Authorize"
    failure "Order.Decline"
  end
end
