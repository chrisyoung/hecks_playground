#!/usr/bin/env bash
# stripe-handler — a THIN payment handler plugged into the generic adapter-host.
#
# Contract with the host : read the charge PAYLOAD (the OrderPlaced event data)
# on stdin, perform the charge, exit 0 if AUTHORIZED, non-zero if DECLINED. The
# host maps exit 0 -> the delivery's success_command, non-zero -> failure_command.
# This is the ONLY adapter-specific code ; subscribe / claim / dispatch / ack all
# live in the shared host.
#
# Where the real gateway IO goes (and why it is safe here, never in the core):
#   - read endpoint / token / retries / timeout_ms / backoff from .world
#     (config_for "stripe") ;
#   - POST the charge to the gateway ;
#   - RETRY transport failures within that budget — this is a separate process,
#     so a slow/looping charge never blocks the synchronous domain core.
# A declined charge is a VERDICT (exit 1), never a retry : recovery is a new
# command, per the no-silent-retry standard.
set -euo pipefail

payload=$(cat)

# Demo: authorize every charge (exit 0). Set STRIPE_DECLINE=1 to exercise the
# failure branch (the host then dispatches Decline). Real IO replaces this block.
if [ "${STRIPE_DECLINE:-0}" = "1" ]; then
  echo "[stripe-handler] DECLINED $payload" >&2
  exit 1
fi
echo "[stripe-handler] AUTHORIZED $payload" >&2
exit 0
