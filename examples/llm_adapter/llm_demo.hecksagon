Hecks.hecksagon "LlmDemo" do
  # Synthetic parity fixture for the :llm hecksagon adapter (Phase 1).
  #
  # Declares one named LLM-binding adapter with the structured fields
  # the hecksagon DSL surfaces : prompt_template, model, max_tokens,
  # response_into (target + attr keyword), backend. Phase 1 lands the
  # parser pair + IR + canonical mirror only ; Phase 2 wires the
  # runtime adapter that actually calls Claude with the prompt and
  # routes the response into the named command on the named aggregate.
  #
  # The fixture stays single-line for prompt_template (no heredoc) so
  # the existing block-form join in hecksagon_parser.rs absorbs it
  # cleanly. Heredocs are still legal in real-world hecksagons (Ruby
  # eval handles them) ; the parity contract just locks the canonical
  # shape both halves must agree on.
  #
  # Belongs to no real domain — purely a parity probe.

  adapter :llm, name: :dream_image do
    prompt_template "You are Miette dreaming. Seed: {{seed_image}}"
    model "claude-sonnet-4"
    max_tokens 200
    response_into "Dream.ProduceImage", attr: :text_fr
    backend :claude
  end
end
