Hecks.behaviors "Pizzas" do
  vision "Behavioral tests for the Pizzas domain — exercises every command and query in memory"

  # ── Pizza aggregate ──────────────────────────────────────────

  test "CreatePizza runs" do
    tests "CreatePizza", on: "Pizza"
    input  name: "sample_name", description: "sample_description", price: "sample_price"
    expect name: "sample_name", description: "sample_description"
  end

  test "AddTopping runs" do
    tests "AddTopping", on: "Pizza"
    setup  "CreatePizza", name: "sample_name", description: "sample_description"
    input  name: "sample_name", amount: "sample_amount"
    expect name: "sample_name", toppings_size: 1
  end

  test "ByDescription returns matching records" do
    tests "ByDescription", on: "Pizza", kind: :query
    setup  "CreatePizza", name: "sample_name", description: "sample_description"
    input  desc: "sample_description"
    expect count: 1
  end


  # ── Order aggregate ──────────────────────────────────────────

  test "PlaceOrder runs" do
    tests "PlaceOrder", on: "Order"
    setup  "CreatePizza", name: "sample_name", description: "sample_description"
    input  customer_name: "sample_customername", quantity: "sample_quantity"
    expect customer_name: "sample_customername", status: "pending", items_size: 1, emits: ["OrderPlaced"]
  end

  test "Authorize runs" do
    tests "Authorize", on: "Order"
    setup  "PlaceOrder", customer_name: "sample_customername", quantity: "sample_quantity"
    input  payment_ref: "sample_paymentref"
    expect payment_ref: "sample_paymentref", status: "authorized", emits: ["OrderAuthorized"]
  end

  test "Decline runs" do
    tests "Decline", on: "Order"
    setup  "PlaceOrder", customer_name: "sample_customername", quantity: "sample_quantity"
    input  payment_ref: "sample_paymentref"
    expect payment_ref: "sample_paymentref", status: "declined", emits: ["OrderDeclined"]
  end

  test "CancelOrder runs" do
    tests "CancelOrder", on: "Order"
    setup  "PlaceOrder", customer_name: "sample_customername", quantity: "sample_quantity"
    expect status: "cancelled"
  end

  test "Pending returns matching records" do
    tests "Pending", on: "Order", kind: :query
    setup  "PlaceOrder", customer_name: "sample_customername", quantity: "sample_quantity"
    expect count: 1
  end

end
