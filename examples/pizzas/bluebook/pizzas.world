Hecks.world "Pizzas" do
  # The per-deployment VALUES the bound adapters need — and ONLY values. The
  # .hecksagon names WHICH adapter fills each port ; this file says WHERE and
  # HOW HARD : the knobs the synchronous domain must never see. Swap this world
  # — same domain, same composition, different deployment. Each block is keyed
  # by the adapter it configures.

  # The Heki persistence adapter  (Pizzas::Pizza / Pizzas::Order persisted_by "Heki").
  #
  # The .world is the SINGLE source of the store location — there is no
  # environment variable. The adapter writes <dir>/<domain>/<aggregate>.heki,
  # so this deployment lands at
  #   ~/.heki/pizzas/pizza.heki   and   ~/.heki/pizzas/order.heki
  # (Behaviors run in memory — no disk — because no world is loaded under
  # test ; this is the production location.)
  heki do
    dir "~/.heki"
  end

  # The Stripe payment adapter  (Pizzas::Order charged_by "Stripe").
  #
  # WHERE the gateway is, the ENV NAME of the secret token (the secret itself
  # never lives in a bluebook — only its name does), and how hard the async
  # adapter tries. latency / retries / backoff are edge-only concerns ; the
  # domain's Authorize / Decline commands know none of them.
  stripe do
    endpoint_env "PIZZAS_PAYMENT_ENDPOINT"
    token_env    "PIZZAS_PAYMENT_TOKEN"
    timeout_ms   3000
    retries      3
    backoff      "exponential"
  end
end
