Hecks.bluebook "ToolShed" do
  vision "A neighborhood tool-rental shop. Members borrow tools, a deposit is held, and overdue loans get flagged so the late fee can be charged. Community over consumption : one good drill serves a whole street."
  core

  aggregate "Tool" do
    description "A tool on the shelf with its category, daily fee, and deposit"
    attribute :name, ToolName
    attribute :category, Category
    attribute :daily_fee, Fee
    attribute :deposit, Deposit

    value_object "ToolName" do
      attribute :value, String
    end

    value_object "Category" do
      attribute :value, String
    end

    value_object "Fee" do
      attribute :cents, Integer
      invariant "must be non-negative" do
        cents >= 0
      end
    end

    value_object "Deposit" do
      attribute :cents, Integer
      invariant "must be at least $1 (100 cents)" do
        cents >= 100
      end
    end

    value_object "Currency" do
      attribute :code,        String
      attribute :symbol,      String
      attribute :minor_units, Integer
      one_of do
        member code: "USD", symbol: "$", minor_units: 2
        member code: "CAD", symbol: "C$", minor_units: 2
        member code: "JPY", symbol: "¥", minor_units: 0
      end
    end

    attribute :currency, Currency

    command "AddTool" do
      role "Owner"
      goal "Put a tool on the shelf for members to borrow"
      attribute :name, ToolName, required: true
      attribute :category, Category, required: true
      attribute :daily_fee, Fee, required: true
      attribute :deposit, Deposit, required: true
      attribute :currency, Currency, default: "USD"
    end

    query "ByCategory" do |cat|
      where(category: cat)
    end

    # A tool is on the shelf (available) or out in a member's hands.
    # "available" / "out" are the shop owner's own words ; the shelf list
    # shows only available tools, and the borrow/return lifecycle flips
    # this — the customer never thinks about it.
    attribute :availability, one_of("available", "out"), default: "available" do
      transition "CheckOut" => "out"
      transition "CheckIn"  => "available"
    end

    command "CheckOut" do
      role "System"
      goal "Take a tool off the shelf when a member borrows it — driven by ToolBorrowed, never dispatched by hand"
      reference_to Tool
    end

    command "CheckIn" do
      role "System"
      goal "Return a tool to the shelf when its loan comes back"
      reference_to Tool
    end

    query "Available" do
      where(availability: "available")
    end
  end

  aggregate "Member" do
    description "A neighbor enrolled in the shop, allowed to borrow tools"
    attribute :name, MemberName
    attribute :email, Email

    attribute :standing, one_of("good", "suspended", "banned"), default: "good"

    value_object "MemberName" do
      attribute :value, String
    end

    value_object "Email" do
      # The SHAPE is part of the domain, so it is declared here rather than
      # re-implemented in a form validator, a gate check and a test. One
      # declaration reaches the JSON Schema (`pattern`), the served form (the
      # input's `pattern` attribute) and the payload gate, which is what makes
      # the browser and `curl` refuse the same values.
      #
      # Deliberately permissive : anything with a local part, an @, and a
      # dotted domain. Email is famously under-specified and an over-strict
      # pattern rejects valid addresses — a refusal a user cannot argue with.
      attribute :value, String, pattern: '^[^@\s]+@[^@\s]+\.[^@\s]+$'
    end

    command "EnrollMember" do
      role "Owner"
      goal "Welcome a neighbor into the shop"
      attribute :name, MemberName, required: true
      attribute :email, Email, required: true
      attribute :standing, one_of("good", "suspended", "banned"), default: "good"
    end
  end

  aggregate "Loan" do
    description "One tool in one member's hands — active until returned, flagged when overdue"
    # belongs_to (not reference_to) so the runtime injects the tool + member
    # ids from Loan state into the emitted events. Without this, ToolReturned
    # carries only `loan`, and CheckInOnReturn's Tool.CheckIn falls to the
    # singleton fallback — checking in an ARBITRARY tool, not this loan's.
    belongs_to Tool
    belongs_to Member
    attribute :due_on, DueDate

    value_object "DueDate" do
      attribute :value, String
    end

    value_object "LoanStatus" do
      attribute :value, String
    end

    attribute :status, LoanStatus, default: "active" do
      transition "ReturnTool" => "returned"
      transition "MarkLate"  => "late"
    end

    command "BorrowTool" do
      role "Member"
      goal "Take a tool home — the deposit is held until it comes back"
      reference_to Tool
      reference_to Member
      attribute :due_on, DueDate, required: true
      emits "ToolBorrowed"
    end

    command "ReturnTool" do
      role "Member"
      goal "Bring the tool back and release the deposit"
      reference_to Loan
      emits "ToolReturned"
    end

    command "MarkLate" do
      role "System"
      goal "Flag an overdue loan so the late fee can be charged"
      reference_to Loan
      emits "LoanMarkedLate"
    end

    query "Active" do
      where(status: "active")
    end

    query "Late" do
      where(status: "late")
    end
  end

  # The borrow/return lifecycle flips a tool's availability. Cross-aggregate
  # cascade : a Loan event drives a Tool command, so the shelf reflects
  # reality — the Available query never lists a tool that's out.
  policy "CheckOutOnBorrow" do
    on "Loan.ToolBorrowed"
    trigger "Tool.CheckOut"
  end

  policy "CheckInOnReturn" do
    on "Loan.ToolReturned"
    trigger "Tool.CheckIn"
  end
end
