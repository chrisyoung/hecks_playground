# .env.storehouse.template — environment variables for the warm storehouse runtime
#
# Copy to .env.storehouse (git-ignored) and fill in before deploying.
# The deploy script sources this file if present.
#
# For the Mac Studio (overmind) target:
#   cp .env.storehouse.template .env.storehouse
#   # Most defaults work; no secrets needed for local-host deploy.
#
# For the Docker/PaaS target:
#   Fill in all variables; pass to docker run --env-file or PaaS env panel.

# ── Runtime identity ──────────────────────────────────────────────────────

# Aggregates root the serve-socket daemon serves.
# On Mac Studio this is the hecks_conception dir on disk.
# In a container this is the volume-mounted path (e.g. /conception).
STOREHOUSE_AGGREGATES_ROOT=/Users/christopheryoung/Projects/hecks/hecks_conception

# Path to the storehouse binary.
# In a container this is /usr/local/bin/storehouse (set by Dockerfile).
STOREHOUSE_BINARY=/Users/christopheryoung/Projects/hecks/rust/target/release/storehouse

# ── Socket ────────────────────────────────────────────────────────────────

# Directory where per-root unix-domain sockets are written.
# Must be the same for both the daemon and the MCP client process.
# Default: ~/.config/miette/sockets
STOREHOUSE_SOCKET_DIR=${HOME}/.config/miette/sockets

# ── Heki (persistent state) ───────────────────────────────────────────────

# Path to the information/ tree (.heki stores).
# In a container, mount this as a volume for persistence:
#   -v /host/path/information:/conception/information
STOREHOUSE_HEKI_DIR=${STOREHOUSE_AGGREGATES_ROOT}/information

# ── Deployment target ─────────────────────────────────────────────────────

# Target platform for deploy-storehouse script: "mac" or "docker"
DEPLOY_TARGET=mac

# ── PaaS secrets (Docker / Fly / Render — leave blank for Mac target) ─────

# Fly.io app name (if deploying to Fly)
FLY_APP_NAME=

# Docker image tag
DOCKER_IMAGE_TAG=storehouse:latest

# ── Reminder: TCP transport is NOT available ──────────────────────────────
# serve-socket binds a unix-domain socket. Remote clients cannot reach it
# over a network. If your MCP client is not on the same host as the daemon,
# deployment will silently fail at the Verify step. Track this against the
# TCP transport ticket before attempting a remote/PaaS deploy.
