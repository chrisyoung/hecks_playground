Hecks.bluebook "Conductor", version: "2026.06.28.1" do
  vision "The Conductor domain : workforce orchestration. The MergeQueue aggregate serialises story merges. One queue per target branch (default: main). Enqueued stories wait ; the queue admits exactly one merge at a time (invariant). An Approve adapter enqueues ; a CompleteMerge adapter marks story done."
  category "framework"

  aggregate "MergeQueue" do
    description "Serialised merge-on-accept for one target branch. Has many queued stories and at most one current (the merging story). State transitions idle → merging → idle. Default branch is main."
    identified_by :branch

    attribute :branch,   Branch,  default: { value: "main" }
    attribute :state,    State,   default: { value: "idle" }

    # Migration plan task 4: was `has_many Stories, as: :queued` / `has_one
    # Story, as: :current` -- STRUCTURAL cross-aggregate references, but
    # "Story" is not an aggregate in the Conductor domain (it lives
    # elsewhere -- Plan::Story, Story::Story -- and hecksagain's has_many/
    # has_one/belongs_to/reference_to only ever resolve WITHIN the
    # declaring aggregate's own domain, confirmed via aggregate_builder.rb
    # -- there is no cross-domain structural reference mechanism).
    # `Claim` (claim.bluebook, same Conductor domain) already carries
    # Story cross-domain the RIGHT way -- a plain VO-wrapped identity
    # string (`attribute :story, Story` where Story wraps :value, String),
    # never a structural reference. Every COMMAND here already followed
    # that same pattern (`attribute :story_ref, StoryRef`,
    # `then_set :queued, append: :story_ref`) -- only these two aggregate-
    # level attributes were still the old structural form, never updated
    # to match. Aligned to what the commands actually write.
    attribute :queued,  list_of(StoryRef)
    attribute :current, StoryRef, default: { value: "" }

    value_object "Branch" do
      # Target branch name, e.g. "main".
      attribute :value, String
    end

    value_object "State" do
      # idle | merging | retired (terminal — soft-deleted, drops out of all views)
      attribute :value, String
    end

    value_object "StoryRef" do
      attribute :value, String
    end

    value_object "Reason" do
      attribute :value, String
    end

    # ------------------------------------------------------------------
    # adapter-host's verdict shape (i787). CompleteMerge / FailMerge are
    # the spawned_by success/failure ports of the PrDeliveryMerge adapter,
    # so they have to accept the five keys bin/adapter-host sends on every
    # verdict dispatch (id/tool/output/exit_code/ok) or be refused by
    # CommandInterpreter#step_refuse_unknown_arguments. Same widen i782
    # applied to Plan::Story's RecordPrMergeableCheckResult /
    # RecordMainUpToDateCheckResult (ToolKind/CheckOutput/CheckExitCode
    # there) -- deliberately NOT the unbuilt Cascade.ResultRecorded ->
    # aggregate bridge, which still has no consumer anywhere in the corpus.
    # Declared per-aggregate because VOs live inside the aggregate that
    # uses them ; duplication across aggregates is the convention here.
    # ------------------------------------------------------------------

    value_object "ToolKind" do
      # Which adapter produced the verdict -- "PrDeliveryMerge", matching
      # adapter-host's ADAPTER_NAME.
      attribute :value, String
    end

    value_object "MergeOutput" do
      # Combined stdout+stderr of the `gh pr merge` invocation. On the
      # failure path this is the ONLY diagnostic that survives (see
      # FailMerge's goal), so it is the field to read when a merge wedges.
      attribute :value, String
    end

    value_object "MergeExitCode" do
      # Process exit code from `gh pr merge`. 0 routes to CompleteMerge ;
      # non-zero routes to FailMerge and carries no further meaning.
      attribute :value, Integer
    end

    value_object "MergeOk" do
      # adapter-host's own success/failure boolean, mirroring exit_code == 0.
      # Redundant with the port that was chosen, recorded for symmetry with
      # every other spawned_by verdict target in this corpus.
      attribute :value, Boolean
    end

    command "Open" do
      role "System"
      goal "Open a merge queue for a target branch. The creation command."
      attribute :branch, Branch
      sets :branch
      sets :state,  to: "idle"
      emits "MergeQueueOpened"
    end

    command "Enqueue" do
      role "System"
      goal "Add a story to the back of the queue. Fired by an Approve adapter."
      reference_to(MergeQueue)
      attribute :story_ref, StoryRef
      sets :queued, append: { value: :story_ref }
      emits "MergeEnqueued"
    end

    command "StartMerge" do
      role "System"
      goal "Begin merging the next queued story. Transitions state to merging. Guard: queue must be idle."
      reference_to(MergeQueue)
      attribute :story_ref, StoryRef
      given("queue must be idle to start a merge") { state == "idle" }
      sets :state,   to: "merging"
      sets :current, to: :story_ref
      emits "MergeStarted"
    end

    command "CompleteMerge" do
      role "System"
      goal "Record a successful merge. Returns the queue to idle. Fired directly as the spawned_by SUCCESS target of the PrDeliveryMerge adapter (i787), which runs the real `gh pr merge sq/<story> --squash --delete-branch`. tool/output/exit_code/ok carry adapter-host's own unconditional verdict shape -- recorded for debugging a merge, not otherwise consumed. Also dispatched manually to close a merge by hand."
      reference_to(MergeQueue)
      # OPTIONAL, all of them (i787). adapter-host sends exactly
      # id/tool/output/exit_code/ok on EVERY verdict and layers a handler's
      # own extra key=value stdout lines on top ONLY when the handler exited
      # 0 (bin/adapter-host, `if [ "$code" -eq 0 ]` gates that block). So
      # `story_ref` arrives here on the success path -- bin/pr_delivery_merge
      # echoes it -- but could never arrive on FailMerge's failure path, and
      # a required attribute that cannot be delivered is a queue wedged in
      # `state: merging` forever the first time `gh pr merge` genuinely
      # fails. Optional is what makes the failure port actually dispatchable.
      # Nothing here MUTATES from story_ref (it only rides into the emitted
      # event), and no policy or driven block consumes MergeCompleted /
      # MergeFailed -- searched corpus-wide, they are audit trail only -- so
      # relaxing them costs no wiring.
      attribute :story_ref, StoryRef,      optional: true
      attribute :tool,      ToolKind,      optional: true
      attribute :output,    MergeOutput,   optional: true
      attribute :exit_code, MergeExitCode, optional: true
      attribute :ok,        MergeOk,       optional: true
      sets :state,   to: "idle"
      sets :current, to: ""
      emits "MergeCompleted"
    end

    command "FailMerge" do
      role "System"
      goal "Record a failed merge. Returns the queue to idle so the next story can proceed. Fired directly as the spawned_by FAILURE target of the PrDeliveryMerge adapter (i787). On that path `reason` is absent by construction -- adapter-host layers no handler-supplied fields on a non-zero exit -- and `output` carries the real diagnostic instead: the failed `gh pr merge` invocation's combined stdout+stderr, which is strictly more informative than a canned reason string. `reason` stays for the manual/projection path (e.g. reason=conflict)."
      reference_to(MergeQueue)
      # See CompleteMerge's note -- same reasoning, and this is the command
      # the wedged-queue risk was actually about.
      attribute :story_ref, StoryRef,      optional: true
      attribute :reason,    Reason,        optional: true
      attribute :tool,      ToolKind,      optional: true
      attribute :output,    MergeOutput,   optional: true
      attribute :exit_code, MergeExitCode, optional: true
      attribute :ok,        MergeOk,       optional: true
      sets :state,   to: "idle"
      sets :current, to: ""
      emits "MergeFailed"
    end

    command "Retire" do
      role "System"
      goal "Retire a merge queue — soft-delete to the terminal `retired` state. For removing phantom or demo queues left in the live store (e.g. a demo flow run against the prod store, like the demo-main queue that dangled a current ref to an unstored story). Valid from any state. Retired queues drop out of both Active (merging) and Idle (idle), so they vanish from the Merge View and the PR-Acceptance views. Mirrors the framework Retire convention (authorization / agent / role) ; hard record removal stays a separate runtime concern (no Delete primitive yet)."
      reference_to(MergeQueue)
      sets :state, to: "retired"
      emits "MergeQueueRetired"
    end

    # ============================================================
    # QUERIES — fleet observability (conductor-observability card)
    # ============================================================

    query "Active" do
      description "All queues currently in state=merging — one merge is in flight. SEMANTIC : state == merging. Used by the Merge View (view-3) to show which branch is merging and which story is current. The current story identity is the has_one :current field on the record. Queued stories (has_many :queued) are returned as part of the record — the Merge View renders them as the waiting list. IMPORTANT : there is no \"conflicted\" lifecycle state — MergeQueue only knows idle and merging ; a failed merge (FailMerge) returns the queue to idle with a MergeFailed event carrying a reason payload. Conflict detection is projection-side : the view may inspect recent MergeFailed events for reason=conflict but that filter is not expressible as a where clause today (gap : runtime-event-history-where)."
      where state: "merging"
    end

    query "Idle" do
      description "All queues currently idle — ready to accept the next merge. SEMANTIC : state == idle. Used by the PR-Acceptance-Queue View (view-2) to confirm the queue is open before the projection layer annotates Story.ReadyForReview stories with mergeable-vs-stale status. The mergeable annotation (does the story branch rebase cleanly onto current main?) is a projection-side computation reading the git adapter — not expressible as a where clause (gap : runtime-cross-aggregate-where for story + queue join, and runtime-git-adapter-query for the merge-safety check). Story.ReadyForReview is the query that enumerates the candidate stories ; this query establishes the queue readiness prerequisite."
      where state: "idle"
    end
  end
end
