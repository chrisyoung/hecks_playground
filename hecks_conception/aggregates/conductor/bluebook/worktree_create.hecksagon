Hecks.hecksagon "Conductor" do
  # worktree-pool-lease-reclaim : create a REAL git worktree when a Lease is
  # granted. Re-expressed (i782) from the retired `run` driven-block leaf --
  # confirmed a hard no-op in the vendored gem (`DrivenCapture#run(_cmd,
  # result_into: nil) = nil` is an explicit stub ; this has never actually
  # fired) -- onto the proven spawned_by mechanism i780 landed for the
  # sibling :exec sites. MUTATING : this turns on real automation (a git
  # worktree is genuinely created for every LeaseGranted). Converted only
  # with Chris's explicit sign-off (i782 -> /goal execute 1-3).
  #
  # Lease.identified_by :worktree_path -- the Lease's own id IS the path
  # ({worktree_path} in the old run leaf's token interpolation), so
  # adapter-host's automatic id=<source_id> on the verdict dispatch is
  # already the right value ; bin/worktree_create reads it straight off
  # the triggering event's payload. success == failure -> Cascade
  # ::Cascade.RecordResult, matching every other spawned_by conversion in
  # this corpus -- the audit trail, not a domain state change (Lease
  # itself records no worktree-creation flag).
  Conductor::Lease.spawned_by("WorktreeCreate", on: "LeaseGranted") do
    success "Cascade::Cascade.RecordResult"
    failure "Cascade::Cascade.RecordResult"
  end
end
