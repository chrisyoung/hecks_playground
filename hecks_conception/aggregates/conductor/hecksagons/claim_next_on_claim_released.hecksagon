Hecks.hecksagon "Conductor" do
  # SEAM 1 continuous retrigger. When a worker finishes a story its Claim is
  # released ; belongs_to-on-event rides the freed worker on ClaimReleased
  # (the Claim's stored belongs_to Worker FK), so the worker can immediately
  # pull the next claimable story — the loop continues without waiting for a
  # new Worker.Register. Same single-select shape as
  # claim_next_on_worker_registered : sweep NextClaimable (one match) and
  # Acquire it for the now-free worker.
  adapter "ClaimNextOnClaimReleased" do
    driven on "Hecks::Conductor::Conductor::Claim.ClaimReleased" do |event|
      dispatch "Hecks::Conductor::Conductor::Claim.Acquire", for_each: { from: "Hecks::Plan::Story.NextClaimable", where: {} }, with: { story: "{ref}", worker: "{worker}", claimed_at: "{now}" }
    end
  end
end
