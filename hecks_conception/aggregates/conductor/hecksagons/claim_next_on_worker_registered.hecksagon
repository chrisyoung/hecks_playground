Hecks.hecksagon "Conductor" do
  # SEAM 1 (REAL) : a Worker registers -> self-select the next claimable story and
  # Acquire a Claim on it. Fires on a GENUINE Worker.WorkerRegistered (Register ->
  # WorkerRegistered ; the event's aggregate_id IS the worker_id, also carried as
  # event.data.worker_id). The where-fan-out sweeps Plan::Story.NextClaimable
  # (state tasked + deps resolved + NO held Claim, via the none_in_state anti-join)
  # and fires Claim.Acquire once per matched story — limit 1 in the query means at
  # most one. {ref} resolves RECORD-first (the matched Story's id) ; {worker_id}
  # resolves from event.data (it is not a record field, so it survives the record
  # pass). The Acquire mutex (given state != held) is the final serialiser against
  # a story another worker grabbed in the same beat. ClaimAcquired then cascades
  # into volunteer_pull's SEAM 2a/2b (Start -> Grant). Driven adapters only fire
  # on REAL command events, never on synthetic ones.
  adapter "ClaimNextOnWorkerRegistered" do
    driven on "Conductor::Worker.WorkerRegistered" do |event|
      dispatch "Conductor::Claim.Acquire", for_each: { from: "Plan::Story.NextClaimable", where: {} }, story: "{ref}", worker: "{worker_id}", claimed_at: "{now}"
    end
  end
end
