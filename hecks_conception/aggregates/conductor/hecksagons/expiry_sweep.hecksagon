Hecks.hecksagon "ExpirySweep" do
  # worktree-pool-lease-reclaim / expiry (sprint 20) — HONESTLY BLOCKED.
  #
  # Intent: periodically expire Leases whose TTL has elapsed (active leases
  # past expires_at) and return their worktree paths to the pool. NO adapter
  # is wired — the previous canned Tools::Cascade.RecordResult tick was a
  # no-op (the command does not exist) that only LOOKED like a sweep.
  #
  # Real implementation needs a TIME-AWARE query the runtime lacks : find
  # Leases where state == active AND expires_at < now. Lease.Expired today is
  # state-based (state == expired), not a TTL comparison, so it cannot drive
  # the sweep. When a clock/time-where lands, this becomes a cron (or beat)
  # adapter : `dispatch Conductor::Lease.Expire, for_each: { from:
  # Lease.PastTtl }`. Until then this file is documentation, not behaviour.
end
