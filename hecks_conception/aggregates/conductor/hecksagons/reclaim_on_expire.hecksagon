Hecks.hecksagon "Conductor" do
  # worktree-pool-lease-reclaim : an expired lease must not sit in limbo.
  # On LeaseExpired, dispatch Reclaim. No args — the lease identity flows
  # through the cascade hint (event aggregate_id). No FK, no event.<ref>.
  adapter "ReclaimOnExpire" do
    driven on "Conductor::Lease.LeaseExpired" do |event|
      dispatch "Conductor::Lease.Reclaim"
    end
  end
end
