Hecks.hecksagon "StoryWorktreeSync" do
  # Lock the story's git worktree while a Lease holds it. The story identity
  # rides the LeaseGranted event as {story} — Grant stores the Story FK
  # (references-not-ids) via then_set :story, and belongs_to-on-event puts that
  # stored FK on the event. worktree_path is the Lease's own id.
  adapter "LockAdapter" do
    driven on "Conductor::Lease.LeaseGranted" do |event|
      dispatch "Plan::Story.LockWorktree", story: "{story}", worktree_path: "{worktree_path}"
    end
  end

  # Unlock the story's worktree when its Lease is reclaimed. NOW REAL : Lease
  # belongs_to Story, and belongs_to-on-event rides the stored {story} FK on
  # LeaseReclaimed (Lease.Reclaim is reference_to(Lease) so the command inputs
  # alone carried only the lease id ; the FK-on-event is what makes {story}
  # resolve at reclaim time — the exact seam this adapter waited on). Clears the
  # story's worktree_locked flag so it no longer lags the physical removal
  # (conductor/hecksagons/worktree_remove.hecksagon). WorktreeUnlocked then
  # triggers the worktree-removed live check.
  adapter "UnlockAdapter" do
    driven on "Conductor::Lease.LeaseReclaimed" do |event|
      dispatch "Plan::Story.UnlockWorktree", story: "{story}"
    end
  end
end
