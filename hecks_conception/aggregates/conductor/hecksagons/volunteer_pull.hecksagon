Hecks.hecksagon "VolunteerPull" do
  # volunteer-pull-protocol (sprint 20). The fleet mutex is the Claim aggregate
  # (identified_by :story — first Acquire wins). SEAM 1 (worker self-select) is
  # now WIRED FOR REAL in the sibling claim_next_on_worker_registered.hecksagon :
  # the runtime cross-aggregate predicate it needed (WhereOp::NoneInState) shipped,
  # so Plan::Story.NextClaimable can pick the next unheld claimable story and a
  # WorkerRegistered drives a real Claim.Acquire on it. No sentinel, no garbage.

  # ------------------------------------------------------------------
  # SEAM 2 (REAL), split for safety : Acquire -> Start (gates) -> Grant (lease).
  # ------------------------------------------------------------------
  # SEAM 2a : a Claim is acquired -> START its story (gates run FIRST). The
  # ClaimAcquired event carries Acquire's input attrs, so {story} and {worker}
  # both interpolate off event.data. We dispatch Start (NOT Grant) here so the
  # worktree lease is created ONLY AFTER Story.Start's four givens pass (sprint
  # set, state tasked, contracts ratified, deps resolved). worker rides through
  # Start as a pass-through input into the StoryStarted event.
  adapter "StartOnClaimAcquired" do
    driven on "Conductor::Claim.ClaimAcquired" do |event|
      dispatch "Plan::Story.Start", story: "{story}", worker: "{worker}"
    end
  end

  # SEAM 2b : the story actually STARTED (gates passed) -> NOW grant its worktree
  # lease. StoryStarted carries Start's inputs (build_event clones them), so
  # {story} and {worker} both interpolate off event.data. Splitting Grant onto
  # StoryStarted (not ClaimAcquired) is the safety fix : a refused Start emits
  # nothing, so no orphan `git worktree add` runs for a story that never
  # legitimately started. expires_at is a placeholder (no clock on the dispatch
  # path yet — honest, not faked). worker is the stored FK SEAM 3 matches on :
  # the lease records WHICH worker holds it, so a later WorkerDied matches it via
  # Lease.HeldByWorker (where worker == the dead worker_id).
  adapter "GrantOnStoryStarted" do
    driven on "Plan::Story.StoryStarted" do |event|
      dispatch "Conductor::Lease.Grant", worktree_path: "worktrees/{story}", story: "{story}", worker: "{worker}", expires_at: "PENDING_NO_CLOCK"
    end
  end

  # ------------------------------------------------------------------
  # SEAM 1 (worker self-select) is NOW WIRED FOR REAL — see the sibling
  #   conductor/hecksagons/claim_next_on_worker_registered.hecksagon. It fires on
  #   a genuine WorkerRegistered, sweeps Plan::Story.NextClaimable (state tasked,
  #   deps resolved, AND no held Claim — the none_in_state anti-join that was the
  #   missing runtime predicate), and Claim.Acquires the picked story for the new
  #   worker. That ClaimAcquired then cascades into SEAM 2a/2b above. The Acquire
  #   mutex (given state != held) serialises concurrent registrations.
  #
  # SEAM 3 (worker-died reclaim) is WIRED FOR REAL — see the sibling
  #   conductor/hecksagons/worker_died_reclaim.hecksagon. belongs_to Worker
  #   synthesises a STORED worker FK on both Lease and Claim (references-not-ids),
  #   so the ReclaimOnWorkerDied adapter sweeps Lease.HeldByWorker /
  #   Claim.HeldByWorker (where worker == the dead worker_id) and fires Reclaim /
  #   Expire once per matched record. SEAM 2b carries the worker FK onto the Grant
  #   so this match has data to find.
end
