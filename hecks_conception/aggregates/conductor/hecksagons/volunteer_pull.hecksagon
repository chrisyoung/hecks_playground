Hecks.hecksagon "VolunteerPull" do
  # volunteer-pull-protocol (sprint 20). The fleet mutex is the Claim aggregate
  # (identified_by :story — first Acquire wins). This hecksagon wires the ONE
  # seam that runs for real today ; the worker-self-select seams are honestly
  # blocked on a runtime feature and are NOT wired (a wired sentinel dispatch
  # would now — with resolver-on-cascade live — fire garbage : e.g.
  # WorkerRegistered -> Claim.Acquire(story:"NEXT_CLAIMABLE") -> a real Lease +
  # a real `git worktree add worktrees/NEXT_CLAIMABLE` on disk).

  # ------------------------------------------------------------------
  # SEAM 2 (REAL) : a Claim is acquired -> grant its worktree lease + start it.
  # ------------------------------------------------------------------
  # Fires on a GENUINE ClaimAcquired (an operator/worker claimed a real story).
  # {story} carries the id from the event. Lease.Grant -> LeaseGranted ->
  # worktree_create runs `git worktree add worktrees/<story>` on disk AND
  # story_worktree_sync locks the story's worktree — the full chain runs
  # because resolver-on-cascade re-activates the resolver on cascaded events.
  # expires_at is a placeholder (no clock on the dispatch path yet — honest,
  # not faked) ; worker_ref is omitted (dead FK kwarg, references-not-ids).
  adapter "GrantAndStartOnClaimAcquired" do
    driven on "Conductor::Claim.ClaimAcquired" do |event|
      dispatch "Conductor::Lease.Grant",
               worktree_path: "worktrees/{story}",
               story_ref:     "{story}",
               expires_at:    "PENDING_NO_CLOCK"
      dispatch "Plan::Story.Start",
               story: "{story}"
    end
  end

  # ------------------------------------------------------------------
  # SEAM 1 (worker self-select) and SEAM 3 (worker-died reclaim) are HONESTLY
  # BLOCKED — not wired, not faked.
  #
  # SEAM 1 : on WorkerRegistered / ClaimReleased, pull the NEXT claimable story
  #   and Claim.Acquire it. Picking "next claimable" requires a cross-aggregate
  #   query (Plan::Story.Claimable, dependency-aware) evaluated from inside the
  #   adapter — runtime-cross-aggregate-where. There is no honest story id to
  #   put on the Acquire until that lands ; a sentinel here now cascades into a
  #   real garbage worktree (see header).
  #
  # SEAM 3 : on WorkerDied, expire the worker's Claim + reclaim its Lease.
  #   Worker carries no back-refs by design ("claim and lease are DERIVED via
  #   queries") ; mapping WorkerDied -> the right Claim/Lease needs
  #   Claim.ByWorker / Lease.ByWorker — also runtime-cross-aggregate-where.
  #
  # When runtime-cross-aggregate-where lands, the clean shape is a projection
  # that pre-computes the claimable/owned ids and emits an event carrying a
  # real story id, which THIS hecksagon then acts on. Until then : documentation.
end
