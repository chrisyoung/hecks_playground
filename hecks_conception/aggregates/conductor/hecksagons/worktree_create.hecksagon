Hecks.hecksagon "WorktreeCreate" do
  # ============================================================
  # WORKTREE-CREATE ADAPTER (worktree-pool-lease-reclaim, sprint 20)
  # ============================================================
  #
  # Driven on LeaseGranted : provisions the git worktree at the
  # allocated path so the Worker can check out and begin.
  #
  # Canned by default — dispatches RecordResult ok:true.
  # World-wired: world.bluebook binds :exec to run
  # `git worktree add <worktree_path>` once adapter-invocation-with-result
  # (hex-invocation-principle) closes.
  #
  # Gap: adapter-invocation-with-result — exec family cannot yet return
  # real exit codes through the bus; canned floor is the correct shape.

  adapter "WorktreeCreate" do
    driven on "Conductor::Lease.LeaseGranted" do |event|
      dispatch "Tools::Cascade.RecordResult",
               id:        event.worktree_path,
               tool:      "git_worktree_add",
               output:    "worktree provisioned (canned)",
               exit_code: 0,
               ok:        true
    end
  end
end
