Hecks.hecksagon "Conductor" do
  # worktree-pool-lease-reclaim : create a REAL git worktree when a Lease is
  # granted. The path is the Lease's own identity ({worktree_path}) — no FK.
  # The runtime spawns git in-process via the `run` leaf (no bin script,
  # no canned RecordResult).
  adapter "WorktreeCreate" do
    driven on "Conductor::Lease.LeaseGranted" do |event|
      run "git worktree add --detach {worktree_path}"
    end
  end
end
