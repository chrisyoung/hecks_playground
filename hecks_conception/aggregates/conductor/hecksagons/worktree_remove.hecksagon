Hecks.hecksagon "Conductor" do
  # worktree-pool-lease-reclaim : remove the REAL git worktree when a Lease is
  # reclaimed. Path is the Lease identity ({worktree_path}) — no FK. Spawned
  # in-process via the `run` leaf ; no bin script, no canned.
  adapter "WorktreeRemove" do
    driven on "Conductor::Lease.LeaseReclaimed" do |event|
      run "git worktree remove --force {id}"
    end
  end
end
