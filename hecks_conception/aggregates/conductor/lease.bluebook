Hecks.bluebook "Conductor", version: "2026.06.02.2" do
  vision "The Conductor domain : workforce orchestration. The Lease aggregate is the worktree allocation — one Lease per worktree path. A Worker holds a Lease on a path for the duration of a Story. Belongs to a Story and a Worker."
  category "framework"

  aggregate "Lease", "A worktree allocation. Identified by worktree_path — at most one active Lease per path (invariant). Belongs to the Story being worked and the Worker holding it. Carries an expiry timestamp and a lifecycle state." do
    identified_by :worktree_path

    attribute :worktree_path,  WorktreePath
    attribute :expires_at,     ExpiresAt
    attribute :state,          State,        default: "active"

    belongs_to Story
    belongs_to Worker

    value_object "WorktreePath" do
      attribute :value, String
    end

    value_object "ExpiresAt" do
      attribute :value, String
    end

    value_object "State" do
      # active | expired | reclaimed
      attribute :value, String
    end

    command "Grant" do
      role "System"
      description "Grant a lease on a worktree path to a worker for a story. Creates the record in state=active and stores the Story + Worker foreign keys (references-not-ids : the synthesised belongs_to FKs are now live)."
      attribute :worktree_path,  WorktreePath
      attribute :story,          Story
      attribute :worker,         Worker
      attribute :expires_at,     ExpiresAt
      then_set :worktree_path,  to: :worktree_path
      then_set :story,          to: :story
      then_set :worker,         to: :worker
      then_set :expires_at,     to: :expires_at
      then_set :state,          to: "active"
      emits "LeaseGranted"
    end

    command "Renew" do
      role "System"
      description "Extend the lease expiry. The lease stays active."
      reference_to(Lease)
      attribute :expires_at, ExpiresAt
      then_set :expires_at, to: :expires_at
      emits "LeaseRenewed"
    end

    command "Expire" do
      role "System"
      description "Mark the lease as expired — TTL reached without renewal."
      reference_to(Lease)
      then_set :state, to: "expired"
      emits "LeaseExpired"
    end

    command "Reclaim" do
      role "System"
      description "Reclaim the worktree path — story done or worker dead. Returns the path to the pool."
      reference_to(Lease)
      then_set :state, to: "reclaimed"
      emits "LeaseReclaimed"
    end

    # ============================================================
    # QUERIES — fleet observability (conductor-observability card)
    # ============================================================

    query "Active" do
      description "All leases currently active — one per checked-out worktree path. SEMANTIC : state == active. Used by the Fleet View (view-1) to show which worktree each worker holds ; the projection layer joins Lease.Active against Worker.Alive on the stored worker FK to annotate each alive worker with their path and lease age (time since the lease was granted, computed from expires_at and the renewal window — gap : runtime-cross-aggregate-where for the join ; time-threshold arithmetic is projection-side). Also feeds the Stuck View (view-5) to distinguish an active-but-long-running lease from a fully expired one."
      where state: "active"
    end

    query "Expired" do
      description "All leases that have expired without being reclaimed. SEMANTIC : state == expired. Used by the Stuck View (view-5) as the primary signal for a stuck worker : an expired lease means the worktree path has not been returned to the pool and the owning worker has likely timed out. The expiry cause (TTL-elapsed vs. worker-dead) is recorded on the LeaseExpired event payload ; distinguishing them in the view is projection-side. Poisoned mailbox detection for the same worker reads via the existing \"storehouse mailboxes\" surface (\"storehouse mailboxes poisoned\") — not a new query here (gap : system-prompt-render-adapter, CLI follow-up)."
      where state: "expired"
    end

    query "HeldByWorker" do
      description "All ACTIVE leases held by a given worker. SEMANTIC : worker == :worker AND state == active. The driving read for SEAM 3 (worker-died reclaim) : when a Worker dies, the ReclaimOnWorkerDied driven adapter sweeps this query (where worker == the dead worker_id) and fires Lease.Reclaim once per matching active lease. Now that belongs_to Worker synthesises a STORED worker FK (references-not-ids), the worker filter is a plain same-aggregate where — no cross-aggregate join needed."
      where worker: :worker
      where state: "active"
    end

    query "PastTtl" do
      description "All ACTIVE leases whose TTL has elapsed — orphaned worktrees to reclaim. SEMANTIC : state == active AND expires_at < :now. The driving read for the expiry sweep : a cadence Tick fans Conductor::Lease.Expire out over this query (fed :now via the {now} clock primitive), which cascades through ReclaimOnExpire to reclaim each worktree path and return it to the pool — independent of worker liveness (a lease can outlive its TTL even while its worker still heartbeats ; the worker-death side is Worker.Stale). expires_at is an ISO-8601 instant, so the lt comparison is a plain chronological string compare. Twin of Worker.Stale on the lease-TTL side of the same clock-driven reclaim."
      where state: "active"
      where expires_at: { lt: :now }
    end
  end
end
