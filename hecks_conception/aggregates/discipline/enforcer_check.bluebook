Hecks.bluebook "EnforcerCheck", version: "2026.04.28.1" do
  vision "Named enforcement rules driving the live bluebook-first watcher — each rule is a registered pattern with severity and complaint text, decoupled from the watcher itself so new rules land as data, not code."
  category "discipline"

  # ============================================================
  # ENFORCER CHECK — named rule rows driving the enforcer
  # ============================================================
  #
  # Each EnforcerCheck is a registered rule : a named pattern kind,
  # a severity (block | warn), and the complaint text to emit.
  # The fixtures-as-runtime rule is the first registered check ;
  # future checks (e.g. runtime_load_of_behaviors_extension) follow
  # the same shape without touching the Enforcer aggregate.
  #
  # Lifecycle :
  #   RegisterCheck   → check is known to the enforcer kernel
  #   TriggerCheck    → kernel saw a match ; side-effect: Enforcer.ComplainFixturesAsRuntime
  #   RecordViolation → the offending file is attached to this check's history
  #
  # Lifted out of enforcer.bluebook in i112 Round 2c so each bluebook
  # owns one concern : Enforcer (sibling discipline/enforcer.bluebook)
  # counts and logs ; EnforcerCheck declares.

  aggregate "EnforcerCheck", "A named enforcement rule — pattern kind, severity, and complaint text" do
    identified_by :id
    attribute :id,          String, default: ""
    attribute :pattern_kind, String, default: ""
    attribute :severity,    String, default: ""
    attribute :complaint,   String, default: ""

    command "RegisterCheck" do
      role "System"
      description "Declare a new enforcement rule. id is a stable slug (e.g. 'fixtures_at_runtime') ; pattern_kind names the detection strategy the kernel uses ; severity is 'block' or 'warn' ; complaint is the stderr text the hook emits."
      attribute :id,           String
      attribute :pattern_kind, String
      attribute :severity,     String
      attribute :complaint,    String
      then_set :id,           to: :id
      then_set :pattern_kind, to: :pattern_kind
      then_set :severity,     to: :severity
      then_set :complaint,    to: :complaint
      emits "CheckRegistered"
    end

    command "TriggerCheck" do
      role "System"
      description "The enforcer kernel matched this check's pattern_kind against a live file operation. Triggering records the activation ; the kernel is responsible for also dispatching Enforcer.ComplainFixturesAsRuntime (or the appropriate Complain variant) on the Enforcer aggregate."
      attribute :id, String
      emits "CheckTriggered"
    end

    command "RecordViolation" do
      role "System"
      description "Attach a specific offending file to this check's activation log. Called after TriggerCheck when the kernel has resolved the exact file path. Kept separate from TriggerCheck so the check record carries a concrete evidence trail."
      attribute :id,        String
      attribute :file_path, String
      emits "ViolationRecorded"
    end
  end
end
