Hecks.bluebook "Rule", version: "2026.04.28.1" do
  vision "One validation rule — innate or adaptive. The catalog half of the immune system as a bluebook."
  category "discipline"

  # ============================================================
  # RULE — split from validator.bluebook (i112)
  # ============================================================
  #
  # Was one half of the original Validator bluebook, paired with
  # Violation (now in discipline/violation.bluebook). Rule is the
  # catalog ; Violation is the detected breach. No policies between
  # them in the original, so the split is structural-only.
  #
  # Each rule is a fixture. The runtime reads these fixtures and
  # applies them when validating a domain. No Rust hardcoding.
  #
  # Innate rules: structural (always apply)
  # Adaptive rules: learned from corrections (antibodies)

  aggregate "Rule", "One validation rule — innate or adaptive" do
    identified_by :name
    attribute :name,        Name
    attribute :category,    Category
    attribute :description, Description
    attribute :severity,    Severity

    value_object "Name" do
      # Stable slug identifying the rule (e.g. 'no_primitive_envy').
      attribute :value, String
    end

    value_object "Category" do
      # The validator family the rule belongs to (innate / adaptive / warning / verb).
      attribute :value, String
    end

    value_object "Description" do
      # Human-readable explanation of what the rule enforces.
      attribute :value, String
    end

    value_object "Severity" do
      # Either 'error' (hard stop) or 'warning' (surface only).
      attribute :value, String
    end

    command "RegisterRule" do
      description "Register a validation rule"
      attribute :name,        Name
      attribute :category,    Category
      attribute :description, Description
      attribute :severity,    Severity
      emits "RuleRegistered"
      then_set :name,        to: :name
      then_set :category,    to: :category
      then_set :description, to: :description
      then_set :severity,    to: :severity
    end

    query ListRules do
      description "What rules do I enforce?"
    end
  end

  # Innate rules — structural validation

  # Warnings — soft rules

  # Verb detection — noun/adjective suffixes (from the Verbs domain)
end
