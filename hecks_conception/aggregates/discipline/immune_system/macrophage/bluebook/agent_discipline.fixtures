Hecks.fixtures "AgentDiscipline", version: "2026.05.31.1" do
  vision "The two violation kinds the AgentDiscipline macrophage enforces — the bluebook-of-record for the agent-discipline-check hook. Each row is a Register dispatch ; the fixtures fire at session boot so the registry is always populated from the bluebook itself, not from a hardcoded list in a hook script. The dispatch VERB is the runtime's own FQN — `Domain::Aggregate.Command`, where Domain is the name in `Hecks.bluebook`, never the filesystem realm path (i787)."

  fixture "skip_env_var violation kind" do
    dispatch "AgentDiscipline::AgentDiscipline.Register", kind: "skip_env_var"
  end

  fixture "ignored_isolation violation kind" do
    dispatch "AgentDiscipline::AgentDiscipline.Register", kind: "ignored_isolation"
  end
end
