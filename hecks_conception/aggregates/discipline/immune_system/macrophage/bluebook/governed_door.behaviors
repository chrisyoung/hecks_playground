Hecks.behaviors "Macrophage" do
  vision "Behavioral tests for the GovernedDoor macrophage sibling — the governed-door barrier rule. The native->door MAP is PROJECTED from the command IR (LookupDoor scans redirects_native), so it is verified by a live CLI smoke, not here (the behaviors harness runs its own in-memory query engine and cannot iterate the IR's command structure). These tests cover the per-record AUDIT — Record logs one immutable denial, ByTool reads the per-tool trail — the Pizzas Order shape (many records + queries, never stored derived state)."

  test "Record logs a denied native tool attempt" do
    tests "Record", on: "GovernedDoor"
    input  id: "Bash-2026-06-26T05:00:00Z", tool_name: "Bash", door: "Tools::ShellTool.Bash", reason: "native Bash makes no bus event", occurred_at: "2026-06-26T05:00:00Z"
    expect tool_name: "Bash", door: "Tools::ShellTool.Bash", reason: "native Bash makes no bus event"
  end

  test "Record emits Recorded" do
    tests "Record", on: "GovernedDoor"
    input  id: "Edit-2026-06-26T05:01:00Z", tool_name: "Edit", door: "Tools::FileTool.Edit", reason: "native Edit makes no bus event", occurred_at: "2026-06-26T05:01:00Z"
    expect_event "Recorded"
  end

  test "ByTool lists the denials recorded for one tool" do
    tests "ByTool", on: "GovernedDoor", kind: :query
    setup  "Record", id: "Bash-2026-06-26T05:02:00Z", tool_name: "Bash", door: "Tools::ShellTool.Bash", reason: "native Bash makes no bus event", occurred_at: "2026-06-26T05:02:00Z"
    input  tool_name: "Bash"
    expect count: 1
  end

  test "ListAll returns the denial audit trail" do
    tests "ListAll", on: "GovernedDoor", kind: :query
    setup  "Record", id: "Grep-2026-06-26T05:03:00Z", tool_name: "Grep", door: "Tools::SearchTool.Grep", reason: "native Grep makes no bus event", occurred_at: "2026-06-26T05:03:00Z"
    expect count: 1
  end
end
