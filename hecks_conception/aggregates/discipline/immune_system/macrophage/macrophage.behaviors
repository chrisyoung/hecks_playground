Hecks.behaviors "Macrophage" do
  vision "Behavioral tests for the per-rule macrophage family. Placeholder coverage for the BidirectionalAssociation (i612), IdentityDiscipline (i611), and CorrespondenceDiscipline (i624) aggregates ; expand to the other rule aggregates as their companion-block tests land. Each test exercises one command's state contract : input attributes recorded onto the aggregate, lifecycle counters incremented, ComplaintIssued / ViolationRecorded emitted."

  # ── BidirectionalAssociation aggregate (i612) ──────────────────

  test "StartSession sets session_started_at on BidirectionalAssociation" do
    tests "StartSession", on: "BidirectionalAssociation"
    input  session_started_at: "2026-05-14T00:00:00Z"
    expect ok: "true"
  end

  test "BidirectionalAssociation Check records a clean run" do
    tests "Check", on: "BidirectionalAssociation"
    input  bluebook_path: "sandbox/pigeoncoop/pigeoncoop.bluebook"
    expect ok: "true"
  end

  test "BidirectionalAssociation RecordViolation increments violations_detected" do
    tests "RecordViolation", on: "BidirectionalAssociation"
    input  aggregate_a: "Parent", aggregate_b: "Student",
           bluebook_a: "sandbox/pigeoncoop/pigeoncoop.bluebook",
           bluebook_b: "sandbox/pigeoncoop/pigeoncoop.bluebook",
           recorded_at: "2026-05-14T00:00:00Z"
    expect ok: "true"
  end

  test "BidirectionalAssociation Complain sets last_complaint" do
    tests "Complain", on: "BidirectionalAssociation"
    input  aggregate_a: "Parent", aggregate_b: "Student",
           complaint: "The BidirectionalAssociation macrophage expected a unidirectional reference between Parent and Student.",
           last_complaint_at: "2026-05-14T00:00:00Z"
    expect ok: "true"
  end

  test "BidirectionalAssociation Exempt records a named exemption" do
    tests "Exempt", on: "BidirectionalAssociation"
    input  aggregate_a: "Parent", aggregate_b: "Student",
           reason: "Parent and Student share identity in this domain; navigation is bidirectional by design.",
           exempted_at: "2026-05-14T00:00:00Z"
    expect ok: "true"
  end

  # ── IdentityDiscipline aggregate (i611) ────────────────────────────
  #
  # Minimal companion-block coverage for the four primary commands.
  # The Check command observes one bluebook (no violations expected
  # in this clean fixture path) ; RecordViolation walks the entity
  # accretion ; Complain surfaces the rule's voice ; ExemptAggregate
  # registers a named, non-empty exemption.

  test "IdentityDiscipline StartSession records session_started_at" do
    tests "StartSession", on: "IdentityDiscipline"
    input  session_started_at: { value: "2026-05-14T10:00:00Z" }
    expect session_started_at: { value: "2026-05-14T10:00:00Z" }
  end

  test "IdentityDiscipline StartSession emits SessionStarted" do
    tests "StartSession", on: "IdentityDiscipline"
    input  session_started_at: { value: "2026-05-14T10:00:00Z" }
    expect emits: ["SessionStarted"]
  end

  test "IdentityDiscipline Check records bluebooks_checked" do
    tests "Check", on: "IdentityDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-14T10:00:00Z" }
    input  file_path: { value: "/tmp/fake-aggregates/clean.bluebook" }
    expect emits: ["BluebookChecked"]
  end

  test "IdentityDiscipline RecordViolation appends an IdentityViolation entity" do
    tests "RecordViolation", on: "IdentityDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-14T10:00:00Z" }
    input  file_path:      { value: "/tmp/fake-aggregates/bad.bluebook" },
           aggregate_name: { value: "ShellTool" },
           field_name:     { value: ":id" },
           kind:           { value: "identified_by_id" },
           line_number:    { value: 72 },
           recorded_at:    { value: "2026-05-14T10:00:01Z" }
    expect emits: ["ViolationRecorded"]
  end

  test "IdentityDiscipline ExemptAggregate appends an ExemptedAggregate entity" do
    tests "ExemptAggregate", on: "IdentityDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-14T10:00:00Z" }
    input  aggregate_name: { value: "Tools::EmailTool" },
           kind:           { value: "id_attribute" },
           reason:         { value: "phase 3 conversion queued — see i611" },
           exempted_at:    { value: "2026-05-14T10:00:02Z" }
    expect emits: ["AggregateExempted"]
  end

  test "IdentityDiscipline Complain sets last_complaint" do
    tests "Complain", on: "IdentityDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-14T10:00:00Z" }
    input  file_path:         { value: "/tmp/fake-aggregates/bad.bluebook" },
           aggregate_name:    { value: "ShellTool" },
           kind:              { value: "identified_by_id" },
           complaint:         { value: "The IdentityDiscipline macrophage expected a natural-key identified_by — :id is forbidden (i611)." },
           last_complaint_at: { value: "2026-05-14T10:00:03Z" }
    expect last_complaint: { value: "The IdentityDiscipline macrophage expected a natural-key identified_by — :id is forbidden (i611)." }
  end

  test "IdentityDiscipline Complain emits ComplaintIssued" do
    tests "Complain", on: "IdentityDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-14T10:00:00Z" }
    input  file_path:         { value: "/tmp/fake-aggregates/bad.bluebook" },
           aggregate_name:    { value: "ShellTool" },
           kind:              { value: "identified_by_id" },
           complaint:         { value: "The IdentityDiscipline macrophage expected ..." },
           last_complaint_at: { value: "2026-05-14T10:00:03Z" }
    expect emits: ["ComplaintIssued"]
  end

  test "IdentityDiscipline RevokeExemption emits ExemptionRevoked" do
    tests "RevokeExemption", on: "IdentityDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-14T10:00:00Z" }
    input  aggregate_name: { value: "Tools::EmailTool" },
           kind:           { value: "id_attribute" },
           revoked_at:     { value: "2026-05-14T10:01:00Z" }
    expect emits: ["ExemptionRevoked"]
  end

  # ── WritingDiscipline aggregate (i623) ─────────────────────────
  #
  # Minimal companion-block coverage for the i623 writing-style rules.
  # StartSession resets per-session counters ; Check exercises the
  # primary scan path ; RecordViolation walks the entity accretion ;
  # Complain surfaces the rule voice ; ExemptDraft registers a named,
  # non-empty exemption ; SetThreshold tunes the we_dont_we_do bound.

  test "WritingDiscipline StartSession records session_started_at" do
    tests "StartSession", on: "WritingDiscipline"
    input  session_started_at: { value: "2026-05-14T11:00:00Z" }
    expect session_started_at: { value: "2026-05-14T11:00:00Z" }
  end

  test "WritingDiscipline StartSession emits SessionStarted" do
    tests "StartSession", on: "WritingDiscipline"
    input  session_started_at: { value: "2026-05-14T11:00:00Z" }
    expect emits: ["SessionStarted"]
  end

  test "WritingDiscipline Check records drafts_checked" do
    tests "Check", on: "WritingDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-14T11:00:00Z" }
    input  draft_id:   { value: "01JCKZWRITE0010" },
           draft_text: { value: "Clean draft with no rule violations." }
    expect emits: ["DraftChecked"]
  end

  test "WritingDiscipline RecordViolation appends a WritingViolation entity" do
    tests "RecordViolation", on: "WritingDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-14T11:00:00Z" }
    input  draft_id:       { value: "01JCKZWRITE0011" },
           kind:           { value: "em_dash" },
           excerpt:        { value: "prose with one offending character" },
           offset:         { value: 18 },
           complaint_text: { value: "The WritingDiscipline macrophage expected zero em-dashes." },
           recorded_at:    { value: "2026-05-14T11:00:01Z" }
    expect emits: ["ViolationRecorded"]
  end

  test "WritingDiscipline ExemptDraft appends an ExemptedDraft entity" do
    tests "ExemptDraft", on: "WritingDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-14T11:00:00Z" }
    input  draft_id:    { value: "01JCKZWRITE0011" },
           kind:        { value: "em_dash" },
           reason:      { value: "literal quote of the rule itself, dash is intentional" },
           exempted_at: { value: "2026-05-14T11:00:02Z" }
    expect emits: ["DraftExempted"]
  end

  test "WritingDiscipline Complain sets last_complaint" do
    tests "Complain", on: "WritingDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-14T11:00:00Z" }
    input  draft_id:          { value: "01JCKZWRITE0011" },
           kind:              { value: "em_dash" },
           excerpt:           { value: "one offending span" },
           complaint:         { value: "The WritingDiscipline macrophage expected zero em-dashes (U+2014)." },
           last_complaint_at: { value: "2026-05-14T11:00:03Z" }
    expect last_complaint: { value: "The WritingDiscipline macrophage expected zero em-dashes (U+2014)." }
  end

  test "WritingDiscipline Complain emits ComplaintIssued" do
    tests "Complain", on: "WritingDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-14T11:00:00Z" }
    input  draft_id:          { value: "01JCKZWRITE0011" },
           kind:              { value: "we_dont_we_do" },
           excerpt:           { value: "we do not sell products, we build futures" },
           complaint:         { value: "The WritingDiscipline macrophage expected sparse use of the negative-positive construction." },
           last_complaint_at: { value: "2026-05-14T11:00:04Z" }
    expect emits: ["ComplaintIssued"]
  end

  test "WritingDiscipline SetThreshold updates we_dont_we_do_threshold" do
    tests "SetThreshold", on: "WritingDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-14T11:00:00Z" }
    input  we_dont_we_do_threshold: { value: 2 }
    expect we_dont_we_do_threshold: { value: 2 }
  end

  test "WritingDiscipline RevokeExemption emits ExemptionRevoked" do
    tests "RevokeExemption", on: "WritingDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-14T11:00:00Z" }
    input  draft_id:   { value: "01JCKZWRITE0011" },
           kind:       { value: "em_dash" },
           revoked_at: { value: "2026-05-14T11:01:00Z" }
    expect emits: ["ExemptionRevoked"]
  end

  # ── CorrespondenceDiscipline aggregate (i624) ──────────────────
  #
  # Placeholder coverage for the per-rule flow macrophage. Each test
  # exercises one command's state contract : session lifecycle,
  # primary check, violation accretion, exemption registration, and
  # complaint surfacing. The five behaviors here mirror the
  # acceptance list in inbox/i624.md.

  test "CorrespondenceDiscipline StartSession records session_started_at" do
    tests "StartSession", on: "CorrespondenceDiscipline"
    input  session_started_at: { value: "2026-05-15T09:00:00Z" }
    expect session_started_at: { value: "2026-05-15T09:00:00Z" }
  end

  test "CorrespondenceDiscipline Check records a watched-surface dispatch" do
    tests "Check", on: "CorrespondenceDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-15T09:00:00Z" }
    input  surface:       { value: "Tools::EmailTool.CreateDraft" },
           command_fqn:   { value: "Tools::EmailTool.CreateDraft" },
           invocation_id: { value: "cmd_a91f" },
           body:          { value: "Hi Angie, the Bicho Bolita receipts for May are attached." },
           observed_at:   { value: "2026-05-15T09:01:00Z" }
    expect emits: ["DispatchChecked"]
  end

  test "CorrespondenceDiscipline RecordViolation appends a FlowViolation entity" do
    tests "RecordViolation", on: "CorrespondenceDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-15T09:00:00Z" }
    input  recorded_at:    { value: "2026-05-15T09:01:00Z" },
           command_fqn:    { value: "Tools::EmailTool.CreateDraft" },
           surface:        { value: "Tools::EmailTool.CreateDraft" },
           invocation_id:  { value: "cmd_a91f" },
           body:           { value: "Hi Angie, the Bicho Bolita receipts for May are attached." },
           kind:           { value: "correspondence_without_compose" },
           window_minutes: { value: 5 }
    expect emits: ["ViolationRecorded"]
  end

  test "CorrespondenceDiscipline ExemptSurface appends an ExemptedSurface entity" do
    tests "ExemptSurface", on: "CorrespondenceDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-15T09:00:00Z" }
    input  surface:     { value: "Tools::EmailTool.LabelMessage" },
           reason:      { value: "header-only surface ; no discretionary prose to compose" },
           exempted_at: { value: "2026-05-15T09:02:00Z" }
    expect emits: ["SurfaceExempted"]
  end

  test "CorrespondenceDiscipline Complain sets last_complaint" do
    tests "Complain", on: "CorrespondenceDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-15T09:00:00Z" }
    input  command_fqn:       { value: "Tools::EmailTool.CreateDraft" },
           surface:           { value: "Tools::EmailTool.CreateDraft" },
           invocation_id:     { value: "cmd_a91f" },
           complaint:         { value: "The CorrespondenceDiscipline macrophage expected Writing.Compose to dispatch before Tools::EmailTool.CreateDraft#cmd_a91f. None was found in the prior 5 minutes." },
           last_complaint_at: { value: "2026-05-15T09:01:00Z" }
    expect last_complaint: { value: "The CorrespondenceDiscipline macrophage expected Writing.Compose to dispatch before Tools::EmailTool.CreateDraft#cmd_a91f. None was found in the prior 5 minutes." }
  end

  test "CorrespondenceDiscipline Complain emits ComplaintIssued" do
    tests "Complain", on: "CorrespondenceDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-15T09:00:00Z" }
    input  command_fqn:       { value: "Tools::EmailTool.CreateDraft" },
           surface:           { value: "Tools::EmailTool.CreateDraft" },
           invocation_id:     { value: "cmd_a91f" },
           complaint:         { value: "The CorrespondenceDiscipline macrophage expected Writing.Compose to dispatch before Tools::EmailTool.CreateDraft#cmd_a91f. None was found in the prior 5 minutes." },
           last_complaint_at: { value: "2026-05-15T09:01:00Z" }
    expect emits: ["ComplaintIssued"]
  end

  test "CorrespondenceDiscipline WatchSurface registers a new surface" do
    tests "WatchSurface", on: "CorrespondenceDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-15T09:00:00Z" }
    input  surface:       { value: "Tools::SlackTool.Post" },
           match_kind:    { value: "substring" },
           registered_at: { value: "2026-05-15T09:03:00Z" }
    expect emits: ["SurfaceWatched"]
  end

  test "CorrespondenceDiscipline SetWindow updates compose_window_minutes" do
    tests "SetWindow", on: "CorrespondenceDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-15T09:00:00Z" }
    input  compose_window_minutes: { value: 15 }
    expect compose_window_minutes: { value: 15 }
  end

  test "CorrespondenceDiscipline UnwatchSurface retires a watched surface" do
    tests "UnwatchSurface", on: "CorrespondenceDiscipline"
    setup  "StartSession", session_started_at: { value: "2026-05-15T09:00:00Z" }
    input  surface:    { value: "Tools::SlackTool.Post" },
           retired_at: { value: "2026-05-15T09:04:00Z" }
    expect emits: ["SurfaceUnwatched"]
  end

