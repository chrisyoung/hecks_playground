           last_complaint_at: { value: "2026-05-30T10:00:02Z" }
    expect last_complaint: { value: "The AdapterLocation macrophage expected the adapter declared in aggregates/framework/misplaced.hecksagon to live at aggregates/framework/hecksagons/misplaced.hecksagon." }
  end

