Hecks.hecksagon "Fibroblast" do
  Fibroblast::Fibroblast.persisted_by("Heki")

  # Impure edge, hecksagon-first : on Sweep, run the repair sweeper and cascade
  # its outcome into RecordResult. Re-homed from the RunSweepOnSweepRan
  # Process.Spawn policy — the impure edge lives here, not in the bluebook.
  adapter :exec,
          name:        "fibroblast_sweep",
          command:     "Fibroblast.Sweep",
          exec:        "bash bin/fibroblast_sweep.sh",
          result_into: "Cascade::Cascade.RecordResult"
end
