Hecks.fixtures "LocRatchet" do
  # The seeded concerns. core_runtime + shell carry the SHRINK pressure ;
  # every other concern is a deliberate GROW carve-out, each justified at
  # its own fixture below. A carve-out wins by longest-prefix-match, so
  # declaring a subtree of rust/src here removes it from core_runtime's
  # shrink gate — which is the point : where a bluebook shape is the
  # contract, the Rust that projects it should grow with the shape rather
  # than fight the gate. codegen was the first such carve-out (the
  # specializer emitters, projections of codegen/*_shape/*.bluebook).
  #
  # Leave room for a future `deploy` grow concern alongside these.
  aggregate "Concern" do
    # core_runtime is the kernel's SHRINK concern — the pressure that keeps
    # imperative Rust from accreting where a bluebook should carry the
    # knowledge. Growth rides an explicit [loc-ratchet-override: core_runtime]
    # per commit, never a silent allowance.
    #
    # 2026-07-19 — this fixture was repaired after declaring the OPPOSITE of
    # what it documented. It read `direction: "grow", baseline: "31460"` under
    # a comment describing a shrink gate that "ratchets down from 31460, so
    # future growth past it still fails". But `grow` NEVER fails (bin/loc-
    # ratchet's `violates?`), so the concern was declaring no gate at all. The
    # contradiction went unseen because bin/loc-ratchet was reading this file
    # from a stale path (missing the `bluebook/` segment) and silently falling
    # back to its hard-coded concerns — which enforce shrink-vs-base-ref. The
    # fallback was STRICTER than the declaration it stood in for, so the bug
    # masked itself: fixing only the path would have turned the gate off and
    # printed a green check while doing it (base=31460 head=38170 delta=+6710).
    #
    # The pinned 31460 floor is retired rather than re-pinned : it had drifted
    # 6710 lines stale, and re-basing it would bless growth that accrued while
    # the gate was masked. baseline "" restores compare-against-base-ref —
    # exactly the enforcement the fallback has been applying all along, so this
    # repair changes no behaviour, only stops the declaration from lying.
    fixture "core_runtime",
            name:       "core_runtime",
            path:       "rust/src",
            extensions: "rs",
            direction:  "shrink",
            baseline:   ""

    fixture "codegen",
            name:       "codegen",
            path:       "rust/src/specializer",
            extensions: "rs",
            direction:  "grow",
            baseline:   ""

    fixture "shell",
            name:       "shell",
            path:       "hecks_conception",
            extensions: "sh",
            direction:  "shrink",
            baseline:   ""

    # world — the `.world` grammar (IR + parser + boot attach). Carved
    # out of core_runtime (longest-prefix-match) and allowed to grow,
    # because the grammar is the contract and the parser/IR Rust is a
    # mechanical projection of the `.world` shape (i610 mcp block).
    fixture "world",
            name:       "world",
            path:       "rust/src/world",
            extensions: "rs",
            direction:  "grow",
            baseline:   ""

    # adapter_resolution — the post-dispatch named-adapter arms
    # (:web_tool i569, :mcp world-server i610). Each is a mechanical
    # projection of its framework/adapter_families/<name>.hecksagon
    # shape, so the resolver Rust grows with the families rather than
    # fighting core_runtime's shrink pressure.
    fixture "adapter_resolution",
            name:       "adapter_resolution",
            path:       "rust/src/adapter_resolution",
            extensions: "rs",
            direction:  "grow",
            baseline:   ""

    # invariants — the f4 aggregate-level invariant evaluator. Carved out
    # of core_runtime (longest-prefix-match) and allowed to grow, because
    # the invariant DSL is the contract and the evaluator Rust is a thin
    # mechanical reuse of the existing `given` predicate machinery. Grows
    # with the f4 rule surface rather than fighting core_runtime's shrink.
    fixture "invariants",
            name:       "invariants",
            path:       "rust/src/invariants",
            extensions: "rs",
            direction:  "grow",
            baseline:   ""

    # corpus_loader — the bluebook-discovery walk (collect_bluebooks) and
    # organ-wins merge (i108/i126/i143). Carved out of core_runtime so the
    # walk can evolve alongside the bluebook tree layout (sibling roots,
    # bucket walk, miette inclusion) without fighting the shrink gate.
    # The contract IS the bluebook tree shape ; the loader is its reader.
    fixture "corpus_loader",
            name:       "corpus_loader",
            path:       "rust/src/corpus_loader",
            extensions: "rs",
            direction:  "grow",
            baseline:   ""
  end
end
