Hecks.fixtures "LocRatchet" do
  # The three seeded concerns. core_runtime + shell preserve today's
  # shrink pressure exactly ; codegen carves the specializer emitters
  # out of core_runtime (longest-prefix-match) and lets them grow,
  # because the shape (codegen/*_shape/*.bluebook) is the contract and
  # the emitter Rust is a mechanical projection of it.
  #
  # Leave room for a future `deploy` grow concern alongside these.
  aggregate "Concern" do
    # core_runtime baseline re-based from "" (compare-against-base-ref) to a
    # pinned floor of 31460 — the f4 invariant wiring (ec1b2edf + the
    # `pub mod invariants;` crate decl) grows core_runtime by an irreducible
    # +31 of call-site / IR / parser-branch wiring (the evaluator itself lives
    # in the `invariants` GROW concern below). Owner-blessed as the new floor
    # rather than a [loc-ratchet-override:] : the shrink gate now ratchets
    # down from 31460, so future growth past it still fails.
    fixture "core_runtime",
            name:       "core_runtime",
            path:       "rust/src",
            extensions: "rs",
            direction:  "shrink",
            baseline:   "31460"

    fixture "codegen",
            name:       "codegen",
            path:       "rust/src/specializer",
            extensions: "rs",
            direction:  "grow",
            baseline:   ""

    fixture "shell",
            name:       "shell",
            path:       "hecks_conception",
            extensions: "sh",
            direction:  "shrink",
            baseline:   ""

    # world — the `.world` grammar (IR + parser + boot attach). Carved
    # out of core_runtime (longest-prefix-match) and allowed to grow,
    # because the grammar is the contract and the parser/IR Rust is a
    # mechanical projection of the `.world` shape (i610 mcp block).
    fixture "world",
            name:       "world",
            path:       "rust/src/world",
            extensions: "rs",
            direction:  "grow",
            baseline:   ""

    # adapter_resolution — the post-dispatch named-adapter arms
    # (:web_tool i569, :mcp world-server i610). Each is a mechanical
    # projection of its framework/adapter_families/<name>.hecksagon
    # shape, so the resolver Rust grows with the families rather than
    # fighting core_runtime's shrink pressure.
    fixture "adapter_resolution",
            name:       "adapter_resolution",
            path:       "rust/src/adapter_resolution",
            extensions: "rs",
            direction:  "grow",
            baseline:   ""

    # invariants — the f4 aggregate-level invariant evaluator. Carved out
    # of core_runtime (longest-prefix-match) and allowed to grow, because
    # the invariant DSL is the contract and the evaluator Rust is a thin
    # mechanical reuse of the existing `given` predicate machinery. Grows
    # with the f4 rule surface rather than fighting core_runtime's shrink.
    fixture "invariants",
            name:       "invariants",
            path:       "rust/src/invariants",
            extensions: "rs",
            direction:  "grow",
            baseline:   ""
  end
end
