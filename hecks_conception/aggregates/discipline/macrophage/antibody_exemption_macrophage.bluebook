Hecks.bluebook "AntibodyExemptionMacrophage", version: "2026.05.13.1" do
  vision "The antibody-exemption-marker rule made structural — one macrophage, one enforcement. Tracks whether [antibody-exempt: <reason>] markers in commit messages name specific, concrete, per-file concerns or fall into the pre-emptive / blanket pattern the discipline forbids. Every vague or pre-emptive marker short-circuits the per-file conversation the gate was built to surface. This macrophage keeps the audit trail, issues complaints, and gives the scoreboard rule-level precision for the exemption discipline."
  category "discipline"

  # ============================================================
  # ANTIBODY EXEMPTION MACROPHAGE — one macrophage, one rule
  # ============================================================
  #
  # The [antibody-exempt: <reason>] marker exists so a human can
  # explicitly bless a specific imperative write after the hook
  # blocks it. The discipline is : (a) the marker must name a
  # concrete, per-file concern, and (b) it must NOT be written
  # pre-emptively — the hook must block first, then the human
  # decides per file. Pre-empting drains the surface : if the
  # model pre-writes the marker it never has to surface the edit
  # for human review, which defeats the entire gate mechanism.
  #
  # This macrophage tracks every [antibody-exempt: ...] marker it
  # sees, classifies each as well-formed or malformed, records the
  # reason-for-malformation on a MalformedExemption entity, and
  # issues a complaint when a marker is pre-emptive or vague. The
  # complaint text begins "The AntibodyExemptionMacrophage expected
  # ..." so rule attribution is visible at a glance.
  #
  # Malformation criteria :
  #   Pre-emptive  — marker appears before the hook ever fired
  #   Too vague    — reason text is a generic phrase with no
  #                  file-specific content (e.g. "exempt", "ok",
  #                  "known", "safe", "auto-generated")
  #   Blanket      — marker covers multiple files with a single
  #                  reason rather than naming per-file rationale
  #
  # The existing Macrophage aggregate is NOT retired here — this
  # aggregate is a sibling. i595 decomposition #3 of 7.

  aggregate "AntibodyExemptionMacrophage", "Per-rule macrophage for the antibody-exemption-marker well-formedness enforcement — tracks all exemption markers seen, classifies them as well-formed or malformed, and maintains the complaint history for this rule alone" do
    identified_by :name

    attribute :name, Name

    # Session metadata
    attribute :session_started_at, Timestamp

    # Exemption tallies — scoped to this rule.
    attribute :total_exemptions_seen,  ExemptionCount
    attribute :well_formed_exemptions, ExemptionCount
    attribute :malformed_exemptions,   ExemptionCount
    attribute :preemptive_exemptions,  ExemptionCount

    # Latest-complaint surface — quick read for the statusline.
    attribute :last_complaint,              ComplaintText
    attribute :last_complaint_at,           Timestamp
    attribute :last_offending_marker_text,  MarkerText

    # ── Value-objects : this rule's language ──

    value_object "Name" do
      # Singleton key for this macrophage.
      attribute :value, String
    end

    value_object "Timestamp" do
      # ISO-8601 timestamp string. Used for session_started_at,
      # last_complaint_at, and any per-event when fields.
      attribute :value, String
    end

    value_object "FilePath" do
      # An absolute or relative filesystem path recorded as the
      # site of an exemption marker or complaint.
      attribute :value, String
    end

    value_object "MarkerText" do
      # The raw text of the [antibody-exempt: <reason>] marker as
      # it appeared in the commit message or file. Preserved verbatim
      # so the audit trail can show exactly what was written.
      attribute :value, String
    end

    value_object "ExemptionCount" do
      # Count of exemption markers of a particular classification
      # (total / well-formed / malformed / pre-emptive) recorded
      # by this macrophage in the current session.
      attribute :value, Integer
    end

    value_object "ComplaintText" do
      # The body of a complaint — the stderr text the hook emits.
      # Includes the rule name so complaint attribution is clear :
      # "The AntibodyExemptionMacrophage expected ..."
      attribute :value, String
    end

    value_object "ReasonText" do
      # The human-readable explanation of why a given exemption
      # marker was judged malformed — e.g. "marker is too vague",
      # "pre-emptive: hook had not yet fired for this file",
      # "blanket marker covers multiple files".
      attribute :value, String
    end

    # ── Entity — malformed-exemption audit trail ──

    entity "MalformedExemption" do
      description "One historical record of a malformed or pre-emptive [antibody-exempt: ...] marker. Records the file where the marker appeared, the verbatim marker text, and the reason the macrophage judged it malformed. The last_complaint / last_complaint_at scalars on the root mirror the most recent complaint; this collection holds the full audit trail."
      attribute :recorded_at,           Timestamp
      attribute :file_path,             FilePath
      attribute :marker_text,           MarkerText
      attribute :reason_for_malformation, ReasonText
    end

    # ── Session lifecycle ──

    command "StartSession" do
      role "System"
      description "Reset per-session counters at boot. The macrophage keeps a per-session tally so the discipline scoreboard reflects what landed today, not lifetime totals. The MalformedExemption entity collection is NOT reset — it is audit trail."
      attribute :session_started_at, Timestamp
      then_set :session_started_at, to: :session_started_at
      emits "SessionStarted"
    end

    # ── Exemption recording — one command per classification ──

    command "RecordExemption" do
      role "Hook"
      description "An [antibody-exempt: <reason>] marker was seen in a commit message or file header. Neutral intake — increments total_exemptions_seen before classification is complete. The hook follows up immediately with RecordWellFormedExemption or RecordMalformedExemption once it evaluates the marker's specificity and timing."
      attribute :file_path,   FilePath
      attribute :marker_text, MarkerText
      emits "ExemptionSeen"
    end

    command "RecordWellFormedExemption" do
      role "Hook"
      description "The [antibody-exempt: <reason>] marker names a specific, concrete, per-file concern and was written after the hook blocked — not pre-emptively. The exemption discipline is satisfied. Increments well_formed_exemptions so the scoreboard can confirm the exemption gate is functioning as designed."
      attribute :file_path,   FilePath
      attribute :marker_text, MarkerText
      emits "WellFormedExemptionRecorded"
    end

    command "RecordMalformedExemption" do
      role "Hook"
      description "The [antibody-exempt: <reason>] marker is too vague, pre-emptive, or blanket. Increments malformed_exemptions and, if the marker is specifically pre-emptive, also increments preemptive_exemptions. The hook chains into Complain to surface the complaint on the next turn — this command records the fact; Complain records the reaction."
      attribute :file_path,             FilePath
      attribute :marker_text,           MarkerText
      attribute :reason_for_malformation, ReasonText
      emits "MalformedExemptionRecorded"
    end

    # ── Complaint surface ──

    command "Complain" do
      role "Hook"
      description "The AntibodyExemptionMacrophage detected a malformed or pre-emptive exemption marker. Records the complaint text and timestamp on the root for fast statusline reads, and appends a MalformedExemption entity for the audit trail. The hook ALSO prints to stderr so Claude Code surfaces the complaint as a system reminder on the next turn — the feedback loop that closes the discipline mechanism. Complaint text should begin 'The AntibodyExemptionMacrophage expected ...' so the rule's name is visible at a glance."
      attribute :file_path,             FilePath
      attribute :marker_text,           MarkerText
      attribute :complaint,             ComplaintText
      attribute :last_complaint_at,     Timestamp
      attribute :reason_for_malformation, ReasonText
      then_set :last_complaint,             to: :complaint
      then_set :last_complaint_at,          to: :last_complaint_at
      then_set :last_offending_marker_text, to: :marker_text
      emits "ComplaintIssued"
    end
  end
end
