Hecks.bluebook "BluebookFirstMacrophage", version: "2026.05.13.1" do
  vision "The bluebook-first rule made structural — one macrophage, one enforcement. Tracks whether imperative edits were preceded by a corresponding bluebook declaration. Every time an imperative file (.rs | .sh | .rb | .js | .py | .go | .ts) lands without an antibody-exempt marker, this macrophage records the offense, surfaces a complaint, and keeps the audit trail. Scoped strictly to the bluebook-first discipline; no other rule lives here."
  category "discipline"

  # ============================================================
  # BLUEBOOK FIRST MACROPHAGE — one macrophage, one rule
  # ============================================================
  #
  # The original Macrophage aggregate enforces the bluebook-first
  # discipline alongside fixtures-at-runtime and other checks —
  # all sharing a single aggregate. i595 decomposes that singleton
  # into a family of per-rule macrophages. This is the first member.
  #
  # Responsibility : track every file write by kind, record the
  # complaint when an imperative file arrives without an exempt
  # marker, and maintain the full complaint history as an entity
  # collection. The statusline can surface "3 bluebook violations
  # this session" with rule-level precision because counts are
  # scoped to this enforcement alone.
  #
  # File kinds (same classification as the parent Macrophage) :
  #   .bluebook .hecksagon .fixtures .behaviors .world  → declarative (no complaint)
  #   .rs .sh .rb .js .py .go .ts                       → imperative (complain)
  #   .md .heki .json .toml .yaml .txt                  → support (no complaint)
  #   anything else                                     → other (no complaint)
  #
  # The existing Macrophage aggregate is NOT retired here — this
  # aggregate is a sibling. Migration step 2 of the i595 plan.

  aggregate "BluebookFirstMacrophage", "Per-rule macrophage for the bluebook-first enforcement — tracks imperative edits, exempted edits, and the complaint history for this rule alone" do
    identified_by :name

    attribute :name, Name

    # Session metadata
    attribute :session_started_at, Timestamp

    # Edit tallies — scoped to this rule's relevant file kinds.
    # Bluebook and support edits are recorded to keep the session
    # picture whole ; imperative_edits is the signal for this rule.
    attribute :bluebook_edits,   EditCount
    attribute :imperative_edits, EditCount
    attribute :exempted_edits,   EditCount

    # Latest-complaint surface — quick read for the statusline.
    attribute :last_complaint,    ComplaintText
    attribute :last_complaint_at, Timestamp

    # ── Value-objects : this rule's language ──

    value_object "Name" do
      # Singleton key for this macrophage.
      attribute :value, String
    end

    value_object "Timestamp" do
      # ISO-8601 timestamp string. Used for session_started_at,
      # complained_at, and any per-event when fields.
      attribute :value, String
    end

    value_object "FilePath" do
      # An absolute or relative filesystem path recorded as the
      # site of an edit or complaint.
      attribute :value, String
    end

    value_object "ComplaintText" do
      # The body of a complaint — the stderr text the hook emits.
      # Includes the rule name so complaint attribution is clear :
      # "The BluebookFirstMacrophage expected ..."
      attribute :value, String
    end

    value_object "EditCount" do
      # Count of edits of a particular kind (bluebook / imperative
      # / exempted) recorded by this macrophage in the current session.
      attribute :value, Integer
    end

    # ── Entity — complaint audit trail ──

    entity "Complaint" do
      description "One historical complaint event for the bluebook-first rule. Records which file triggered the complaint, what the complaint text said, and when. The last_complaint / last_complaint_at scalars on the root mirror the most recent entry; this collection holds the full audit trail."
      attribute :complained_at,  Timestamp
      attribute :file_path,      FilePath
      attribute :complaint_text, ComplaintText
    end

    # ── Session lifecycle ──

    command "StartSession" do
      role "System"
      description "Reset per-session counters at boot. The macrophage keeps a per-session tally so the discipline scoreboard reflects what landed today, not lifetime totals. The Complaint entity collection is NOT reset — it is audit trail."
      attribute :session_started_at, Timestamp
      then_set :session_started_at, to: :session_started_at
      emits "SessionStarted"
    end

    # ── Edit recording — one command per file kind ──

    command "RecordBluebookEdit" do
      role "Hook"
      description "A bluebook-family file (.bluebook | .hecksagon | .fixtures | .behaviors | .world) was written. The bluebook-first rule is satisfied — no complaint. Increments bluebook_edits so the session scoreboard can show the ratio of declarative to imperative writes."
      attribute :file_path, FilePath
      emits "BluebookEdited"
    end

    command "RecordImperativeEdit" do
      role "Hook"
      description "An imperative-language file (.rs | .sh | .rb | .js | .py | .go | .ts) was written without an antibody-exempt marker. Increments imperative_edits. The hook chains into Complain to surface the complaint on the next turn — this command records the fact; Complain records the reaction."
      attribute :file_path, FilePath
      emits "ImperativeEdited"
    end

    command "RecordExemptedEdit" do
      role "Hook"
      description "An imperative-language file was written, but carries an [antibody-exempt: ...] marker — the bluebook-first discipline is satisfied by the marker. Tracked separately so the scoreboard can distinguish 'exempted imperative edits' from 'unexempted imperative edits' and confirm the exemption discipline is being followed."
      attribute :file_path, FilePath
      emits "ExemptedEdited"
    end

    # ── Complaint surface ──

    command "Complain" do
      role "Hook"
      description "The BluebookFirstMacrophage detected an imperative edit without an antibody-exempt marker. Records the complaint text and timestamp on the root for fast statusline reads, and appends a Complaint entity for the audit trail. The hook ALSO prints to stderr so Claude Code surfaces the complaint as a system reminder on the next turn — the feedback loop that closes the discipline mechanism. Complaint text should begin 'The BluebookFirstMacrophage expected ...' so the rule's name is visible at a glance."
      attribute :file_path,         FilePath
      attribute :complaint,         ComplaintText
      attribute :last_complaint_at, Timestamp
      then_set :last_complaint,    to: :complaint
      then_set :last_complaint_at, to: :last_complaint_at
      emits "ComplaintIssued"
    end
  end
end
