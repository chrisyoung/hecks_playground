Hecks.bluebook "ClientSignOffMacrophage", version: "2026.05.13.1" do
  vision "The client-sign-off protection rule made structural — one macrophage, one enforcement. Tracks whether edits to client-owned paths silently remove content that the client already approved. Every time a pending edit deletes lines or elements present at the most recent sign-off snapshot, this macrophage records the removal, surfaces a complaint, and keeps the audit trail. Scoped strictly to the client-content-protection discipline; no other rule lives here."
  category "discipline"

  # ============================================================
  # CLIENT SIGN-OFF MACROPHAGE — one macrophage, one rule
  # ============================================================
  #
  # The regression class this exists to prevent : on 2026-05-13 a
  # sidequest pass on Joey's OPT site quietly stripped five elements
  # Joey had already signed off on — recovery nav link, hero photo
  # class, group fitness card copy, 1-on-1 consultation button, and
  # a pattern divider. Joey caught the recovery link removal himself ;
  # the audit surfaced the rest. The class is "edits to a client repo
  # that DELETE content present at the most recent client sign-off."
  #
  # Sign-off representation : git tags. When a client approves a
  # preview, a tag is placed on that commit following the naming
  # convention  signoff/<client-name>/<YYYY-MM-DD>  (e.g.
  # "signoff/joey/2026-05-12"). The macrophage's enforcement is :
  # for any edit to a client-owned path, compare HEAD against the
  # most recent sign-off tag for that client — flag if the edit
  # REMOVES content that was present at the sign-off snapshot.
  # Additions are fine ; modifications are fine ; removals are
  # the trigger.
  #
  # i595 decomposition #8. The parent Macrophage aggregate is NOT
  # retired here — this aggregate is a sibling, same as the other
  # seven per-rule macrophages in this family.

  aggregate "ClientSignOffMacrophage", "Per-rule macrophage for client content protection — tracks registered clients, recorded sign-offs, and the removal audit trail for this rule alone" do
    identified_by :name

    attribute :name, Name

    # Session metadata
    attribute :session_started_at, Timestamp

    # Lifetime tallies — scoped to this rule.
    attribute :clients_tracked,      Count
    attribute :signoffs_recorded,    Count
    attribute :removals_detected,    Count
    attribute :removals_complained,  Count

    # Latest-complaint surface — quick read for the statusline.
    attribute :last_complaint,          ComplaintText
    attribute :last_complaint_at,       Timestamp
    attribute :last_offending_file,     FilePath
    attribute :last_offending_client,   ClientName

    # ── Value-objects : this rule's language ──

    value_object "Name" do
      # Singleton key for this macrophage instance.
      attribute :value, String
    end

    value_object "Timestamp" do
      # ISO-8601 timestamp string. Used for session_started_at,
      # signed_at, detected_at, complained_at, and any per-event
      # when fields.
      attribute :value, String
    end

    value_object "ClientName" do
      # Identifier for a tracked client — short, lowercase, hyphen-
      # separated (e.g. "joey", "lou-ann", "emaho"). Must be non-empty
      # and at most 80 characters. Matches the client segment of the
      # signoff tag name (signoff/<client>/<date>).
      attribute :value, String
    end

    value_object "RepoPath" do
      # Absolute filesystem path of the client's repository root
      # (e.g. "/Users/christopheryoung/Projects/opt-website").
      # Used when the macrophage diffs files against the signoff ref.
      attribute :value, String
    end

    value_object "OwnedPathPattern" do
      # A glob-or-prefix pattern that defines which paths fall within
      # a client's scope (e.g. "site/**/*.html" or "site/"). Edits
      # matching any of the client's owned patterns trigger CheckEdit.
      attribute :value, String
    end

    value_object "FilePath" do
      # A specific file affected by a pending edit — absolute or
      # relative to the repository root. Stored in Removal entities
      # and surfaced in complaint text.
      attribute :value, String
    end

    value_object "SignoffTagName" do
      # Git tag name following the pattern signoff/<client>/<date>
      # (e.g. "signoff/joey/2026-05-12"). Used as the human-readable
      # identifier when citing which approval is being violated.
      attribute :value, String
    end

    value_object "SnapshotRef" do
      # Git ref (commit SHA or tag ref) pointing at the sign-off
      # commit. The macrophage diffs the affected file at HEAD against
      # this ref to detect removals.
      attribute :value, String
    end

    value_object "RemovalExcerpt" do
      # Short excerpt of the removed content — enough to identify what
      # was signed off and is now missing. Included verbatim in the
      # complaint text so the developer can see what was stripped
      # without having to diff manually.
      attribute :value, String
    end

    value_object "ComplaintText" do
      # The body of a complaint — the stderr text the hook emits.
      # Includes the rule name so complaint attribution is clear :
      # "The ClientSignOffMacrophage expected ..."
      attribute :value, String
    end

    value_object "ContactEmail" do
      # Email address for the client contact — used for escalation
      # when a removal complaint must be surfaced to the client directly
      # (e.g. "joey@optperformancetraining.com").
      attribute :value, String
    end

    value_object "SignoffSummary" do
      # Human-readable description of what the client approved at this
      # sign-off snapshot (e.g. "Joey approved the full homepage
      # redesign — hero, nav, group fitness section, and footer").
      # Informational only ; not used in enforcement logic.
      attribute :value, String
    end

    value_object "Count" do
      # Count of clients, sign-offs, removals, or complaints tracked
      # by this macrophage over its lifetime.
      attribute :value, Integer
    end

    # ── Entities ──

    entity "Client" do
      description "A tracked client whose content is under sign-off protection. Holds the client identity, contact email for escalation, and the set of path patterns that define the client's owned scope within their repository."
      attribute :client_name,          ClientName
      attribute :contact_email,        ContactEmail
      attribute :owned_path_patterns,  list_of(OwnedPathPattern)
      attribute :registered_at,        Timestamp
    end

    entity "SignOff" do
      description "A recorded client approval of a specific snapshot. Created by dispatching RecordSignOff after the client confirms a preview. The sign-off tag is placed on the approved commit externally (git tag); this entity records that fact so CheckEdit can locate the most recent signoff_ref to diff against."
      attribute :client_name,   ClientName
      attribute :signed_at,     Timestamp
      attribute :signoff_tag,   SignoffTagName
      attribute :snapshot_ref,  SnapshotRef
      attribute :summary,       SignoffSummary
    end

    entity "Removal" do
      description "Audit trail entry for one detected removal of signed-off content. Created by RecordRemoval after CheckEdit determines that a pending edit deletes content present at the client's most recent sign-off. The complaint_text here mirrors what Complain surfaces to stderr."
      attribute :detected_at,              Timestamp
      attribute :client_name,              ClientName
      attribute :file_path,                FilePath
      attribute :removed_excerpt,          RemovalExcerpt
      attribute :last_seen_in_signoff_ref, SnapshotRef
      attribute :complaint_text,           ComplaintText
    end

    # ── Session lifecycle ──

    command "StartSession" do
      role "System"
      description "Reset per-session counters at boot. The macrophage carries lifetime tallies on clients_tracked, signoffs_recorded, removals_detected, and removals_complained — StartSession sets the session clock so per-session reporting is possible without wiping the entity collections, which are permanent audit trail."
      attribute :session_started_at, Timestamp
      then_set :session_started_at, to: :session_started_at
      emits "SessionStarted"
    end

    # ── Registration ──

    command "RegisterClient" do
      role "Developer"
      description "Register a client whose content is now under sign-off protection. Appends a Client entity recording the client's name, contact email, and the set of path patterns that define their owned scope. Cannot register the same client_name twice — the macrophage treats a duplicate RegisterClient as a configuration error, not a silent overwrite."
      attribute :client_name,         ClientName
      attribute :contact_email,       ContactEmail
      attribute :owned_path_patterns, list_of(OwnedPathPattern)
      emits "ClientRegistered"
    end

    # ── Sign-off recording ──

    command "RecordSignOff" do
      role "Developer"
      description "Record that a client has signed off on the content at a specific snapshot. Dispatched manually by Miette after the client (e.g. Joey) confirms a preview — the git tag has already been placed on the approved commit externally. Appends a SignOff entity and increments signoffs_recorded. Subsequent CheckEdit calls will diff against this snapshot_ref until a newer RecordSignOff supersedes it."
      attribute :client_name,  ClientName
      attribute :signoff_tag,  SignoffTagName
      attribute :snapshot_ref, SnapshotRef
      attribute :summary,      SignoffSummary
      emits "SignOffRecorded"
    end

    # ── Edit checking ──

    command "CheckEdit" do
      role "Hook"
      description "Evaluate a pending edit to a client-owned file against the client's most recent sign-off. The hook locates the most recent SignOff entity for the client, diffs the file at HEAD against signoff_ref, and determines whether any content present at sign-off is absent from the pending edit. If no removal is detected, the command is a no-op. If a removal is detected, the hook chains into RecordRemoval and then Complain. CheckEdit is the primary entry point for the pre-edit gate."
      attribute :client_name, ClientName
      attribute :file_path,   FilePath
      emits "EditChecked"
    end

    # ── Removal recording ──

    command "RecordRemoval" do
      role "Hook"
      description "Record a confirmed removal of signed-off content. Appends a Removal entity with the removed excerpt and the sign-off ref where the content was last seen. Updates last_offending_file and last_offending_client on the root for fast statusline reads. Increments removals_detected. The hook chains into Complain immediately after to close the feedback loop."
      attribute :client_name,              ClientName
      attribute :file_path,                FilePath
      attribute :removed_excerpt,          RemovalExcerpt
      attribute :last_seen_in_signoff_ref, SnapshotRef
      then_set :last_offending_file,   to: :file_path
      then_set :last_offending_client, to: :client_name
      emits "RemovalRecorded"
    end

    # ── Complaint surface ──

    command "Complain" do
      role "Hook"
      description "The ClientSignOffMacrophage detected a removal of signed-off content. Records the complaint text and timestamp on the root for fast statusline reads, and appends the complaint text to the most recent Removal entity's complaint_text field. The hook ALSO prints to stderr so Claude Code surfaces the complaint as a hookSpecificOutput.additionalContext on the next turn — the feedback loop that closes the protection mechanism. Complaint text begins 'The ClientSignOffMacrophage expected ...' so the rule's name is visible at a glance."
      attribute :client_name,       ClientName
      attribute :file_path,         FilePath
      attribute :signoff_tag,       SignoffTagName
      attribute :removed_excerpt,   RemovalExcerpt
      attribute :complaint,         ComplaintText
      attribute :last_complaint_at, Timestamp
      then_set :last_complaint,    to: :complaint
      then_set :last_complaint_at, to: :last_complaint_at
      emits "ComplaintIssued"
    end
  end
end
