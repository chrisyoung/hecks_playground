Hecks.bluebook "LinearReferenceMacrophage", version: "2026.05.13.1" do
  vision "The retired-tool-reference rule made structural — one macrophage, one enforcement. Tracks whether any file introduces a reference to a tool that has been retired from the workflow. Linear is the canonical first tracked tool (retired 2026-04-27); the tracked set is data, not hard-coded, so adding a newly-retired tool is a domain event. Every time a reference to a tracked retired tool is detected this macrophage records the offense, surfaces a complaint, and keeps the audit trail. Scoped strictly to the retired-tool-reference discipline; no other rule lives here."
  category "discipline"

  # ============================================================
  # LINEAR REFERENCE MACROPHAGE — one macrophage, one rule
  # ============================================================
  #
  # The name is "LinearReference" not "Linear" — it generalises
  # to any retired tool. Linear is the canonical first member of
  # the tracked-retired-tools list (retired 2026-04-27, replaced
  # by the hecks MCP + Glass command palette).
  #
  # Stale references compound over time: they appear in docs,
  # commit messages, usage examples, and onboarding guides. Each
  # one is a false affordance — a reader reaches for a tool that
  # no longer exists and wastes time debugging their environment.
  # Catching references at write-time, before they accumulate, is
  # far cheaper than periodic grep-and-purge sweeps.
  #
  # The list of tracked retired tools is a TrackedRetiredTool
  # entity collection, not a hard-coded constant. Adding a newly-
  # retired tool is a single TrackRetiredTool command — no code
  # change needed. Removing a fully-purged tool is a single
  # UntrackRetiredTool command.
  #
  # The existing Macrophage aggregate is NOT retired here — this
  # aggregate is a sibling. Migration step 5 of the i595 plan.

  aggregate "LinearReferenceMacrophage", "Per-rule macrophage for the retired-tool-reference enforcement — tracks which tools are being watched, records detected references, and maintains the complaint history for this rule alone" do
    identified_by :name

    attribute :name, Name

    # Session metadata
    attribute :session_started_at, Timestamp

    # Running totals — scoped to this rule.
    attribute :total_references_seen, ReferenceCount
    attribute :files_checked,         ReferenceCount

    # Latest-complaint surface — quick read for the statusline.
    attribute :last_complaint,         ComplaintText
    attribute :last_complaint_at,      Timestamp
    attribute :last_offending_file,    FilePath
    attribute :last_offending_tool,    ToolName

    # ── Value-objects : this rule's language ──

    value_object "Name" do
      # Singleton key for this macrophage.
      attribute :value, String
    end

    value_object "Timestamp" do
      # ISO-8601 timestamp string. Used for session_started_at,
      # last_complaint_at, and any per-event when fields.
      attribute :value, String
    end

    value_object "FilePath" do
      # An absolute or relative filesystem path recorded as the
      # site of a reference or complaint.
      attribute :value, String
    end

    value_object "ToolName" do
      # The canonical name of a retired tool, e.g. "Linear".
      # Stored on both TrackedRetiredTool and RetiredReference so
      # queries can filter by tool without joining on entity ids.
      attribute :value, String
    end

    value_object "ReferenceCount" do
      # Count of detected references (or files checked) recorded
      # by this macrophage in the current session.
      attribute :value, Integer
    end

    value_object "ReferenceText" do
      # The verbatim snippet of the file that contained the
      # reference — the line or phrase that triggered detection.
      attribute :value, String
    end

    value_object "ComplaintText" do
      # The body of a complaint — the stderr text the hook emits.
      # Includes the rule name so complaint attribution is clear :
      # "The LinearReferenceMacrophage expected ..."
      attribute :value, String
    end

    value_object "LineNumber" do
      # 1-based line number within the file where the reference
      # was detected. Zero means the line could not be isolated.
      attribute :value, Integer
    end

    # ── Entity — retired-tool registry ──

    entity "TrackedRetiredTool" do
      description "One tool that has been retired and whose references should be flagged. Adding a new entry via TrackRetiredTool is the only change required when a new tool is retired — the detection loop iterates this collection at runtime, so the set is data, not code."
      attribute :tool_name,    ToolName
      attribute :retired_at,   Timestamp
      attribute :replaced_by,  ToolName
      attribute :notes,        ReferenceText
    end

    # ── Entity — reference audit trail ──

    entity "RetiredReference" do
      description "One detected reference to a tracked retired tool. Records when it was seen, which file contained it, which tool was referenced, the line number, and the verbatim snippet. The last_offending_file / last_offending_tool scalars on the root mirror the most recent entry; this collection holds the full audit trail."
      attribute :recorded_at,      Timestamp
      attribute :file_path,        FilePath
      attribute :tool_name,        ToolName
      attribute :line_number,      LineNumber
      attribute :reference_text,   ReferenceText
    end

    # ── Session lifecycle ──

    command "StartSession" do
      role "System"
      description "Reset per-session counters at boot. The macrophage keeps a per-session tally so the discipline scoreboard reflects what was detected today, not lifetime totals. The TrackedRetiredTool and RetiredReference entity collections are NOT reset — they are persistent state and audit trail respectively."
      attribute :session_started_at, Timestamp
      then_set :session_started_at, to: :session_started_at
      emits "SessionStarted"
    end

    # ── Tool registry commands ──

    command "TrackRetiredTool" do
      role "System"
      description "Register a newly-retired tool so the macrophage will flag references to it going forward. This is the only change needed when a tool is retired — no code edit, no redeploy. Appends a TrackedRetiredTool entity. If the tool_name already exists, the entry is refreshed with the new metadata."
      attribute :tool_name,   ToolName
      attribute :retired_at,  Timestamp
      attribute :replaced_by, ToolName
      attribute :notes,       ReferenceText
      emits "RetiredToolTracked"
    end

    command "UntrackRetiredTool" do
      role "System"
      description "Remove a tool from the watch list once all references to it have been purged from the codebase. This acknowledges that the cleanup is complete and prevents false positives on historical commits or example output that legitimately names the old tool in a 'was replaced by' context."
      attribute :tool_name, ToolName
      emits "RetiredToolUntracked"
    end

    # ── Reference recording ──

    command "RecordReference" do
      role "Hook"
      description "A tracked retired tool was referenced in a file. Increments total_references_seen, updates last_offending_file and last_offending_tool, and appends a RetiredReference entity for the audit trail. The hook chains into Complain to surface the violation on the next turn — this command records the fact; Complain records the reaction."
      attribute :file_path,      FilePath
      attribute :tool_name,      ToolName
      attribute :line_number,    LineNumber
      attribute :reference_text, ReferenceText
      attribute :recorded_at,    Timestamp
      then_set :last_offending_file, to: :file_path
      then_set :last_offending_tool, to: :tool_name
      emits "ReferenceRecorded"
    end

    # ── Complaint surface ──

    command "Complain" do
      role "Hook"
      description "The LinearReferenceMacrophage detected a reference to a tracked retired tool. Records the complaint text and timestamp on the root for fast statusline reads, and appends a Complaint for the audit trail. The hook ALSO prints to stderr so Claude Code surfaces the complaint as a system reminder on the next turn — the feedback loop that closes the discipline mechanism. Complaint text should begin 'The LinearReferenceMacrophage expected ...' so the rule's name is visible at a glance."
      attribute :file_path,         FilePath
      attribute :complaint,         ComplaintText
      attribute :last_complaint_at, Timestamp
      then_set :last_complaint,    to: :complaint
      then_set :last_complaint_at, to: :last_complaint_at
      emits "ComplaintIssued"
    end
  end
end
