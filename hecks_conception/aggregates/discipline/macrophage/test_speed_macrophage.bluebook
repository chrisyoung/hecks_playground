Hecks.bluebook "TestSpeedMacrophage", version: "2026.05.13.1" do
  vision "The tests-under-1-second rule made structural — one macrophage, one enforcement. Tracks test-suite durations across sessions, complains when any suite (or the aggregated whole) crosses the threshold, and maintains an audit trail of slow runs and registered exemptions. Slow tests rot the dev loop; this macrophage keeps the rot visible and named. Scoped strictly to the test-speed discipline; no other rule lives here."
  category "discipline"

  # ============================================================
  # TEST SPEED MACROPHAGE — one macrophage, one rule
  # ============================================================
  #
  # CLAUDE.md states: "Tests must run under 1 second — enforced by
  # pre-commit hook." That constraint exists because a slow test
  # suite fragments attention and erodes the tight feedback loop
  # that makes test-driven work pleasant. When a suite drifts past
  # the threshold, the rule has been broken whether or not the
  # pre-commit hook fires — this macrophage makes the drift
  # observable as domain state.
  #
  # i595 decomposes the monolithic Macrophage aggregate into a
  # family of per-rule macrophages. TestSpeedMacrophage is the
  # seventh (and final) member of that family. Each per-rule
  # macrophage is a sibling, not a child, of the original
  # Macrophage aggregate — migration step 7 of the i595 plan.
  #
  # Thresholds (configurable via AdjustThreshold) :
  #   warning    800 ms — approaching the limit; monitor
  #   error     1000 ms — rule broken; complaint issued
  #
  # Slow-test exemptions follow the same discipline as antibody
  # markers : case-by-case, named, never pre-emptive. An exemption
  # without a reason is rejected — the pre-emptive trap is the
  # failure mode the discipline guards against.
  #
  # Suite kinds distinguish the four test surfaces in the project :
  #   Behaviors   — .behaviors files run via storehouse
  #   Unit        — fast isolated unit specs
  #   Integration — adapter-level specs that may touch I/O
  #   Smoke       — end-to-end smoke tests
  #
  # The existing Macrophage aggregate is NOT retired here — this
  # aggregate is a sibling. Migration step 7 of the i595 plan.

  aggregate "TestSpeedMacrophage", "Per-rule macrophage for the tests-under-1-second enforcement — tracks suite durations, threshold breaches, and named exemptions for this rule alone" do
    identified_by :name

    attribute :name, Name

    # Session metadata
    attribute :session_started_at, Timestamp

    # Threshold configuration — adjustable if the team decides on
    # a new default, but the starting contract is 1000 ms hard /
    # 800 ms warning.
    attribute :threshold_ms,         DurationMs
    attribute :warning_threshold_ms, DurationMs

    # Run tallies — scoped to this session.
    attribute :total_runs,             RunCount
    attribute :runs_within_threshold,  RunCount
    attribute :runs_at_warning,        RunCount
    attribute :runs_over_threshold,    RunCount

    # Aggregate duration — sum of every recorded run's duration_ms
    # in the current session. Lets the statusline show "total test
    # time this session: X ms".
    attribute :total_duration_ms, DurationMs

    # Latest-complaint surface — quick read for the statusline.
    attribute :last_complaint,         ComplaintText
    attribute :last_complaint_at,      Timestamp
    attribute :last_offending_suite,   SuiteName

    # ── Value-objects : this rule's language ──

    value_object "Name" do
      # Singleton key for this macrophage.
      attribute :value, String
    end

    value_object "Timestamp" do
      # ISO-8601 timestamp string. Used for session_started_at,
      # last_complaint_at, and per-event recorded_at fields.
      attribute :value, String
    end

    value_object "SuiteName" do
      # The name of a test suite — typically a file path, rspec
      # group label, or storehouse behaviors target. Used both as
      # a key in ExemptedSlowTest and as an audit dimension in
      # SlowTestRun.
      attribute :value, String
    end

    value_object "DurationMs" do
      # A duration in milliseconds. Used for threshold_ms,
      # warning_threshold_ms, total_duration_ms, duration_ms on
      # individual runs, and exceeded_by_ms on slow runs.
      attribute :value, Integer
    end

    value_object "RunCount" do
      # Count of test runs in a particular bucket (within / warning
      # / over / total) accumulated this session.
      attribute :value, Integer
    end

    value_object "ComplaintText" do
      # The body of a complaint — the stderr text the hook emits.
      # Includes the rule name so complaint attribution is clear :
      # "The TestSpeedMacrophage expected ..."
      attribute :value, String
    end

    value_object "TestKind" do
      # Classifies which test surface a run came from. Four values :
      #   Behaviors   — .behaviors files run via storehouse behaviors
      #   Unit        — fast isolated unit specs
      #   Integration — adapter-level specs that may touch I/O
      #   Smoke       — end-to-end smoke tests (e.g. pizzas.rb)
      attribute :value, String
    end

    value_object "ExemptionReason" do
      # Named reason text for a slow-test exemption. Must be
      # non-empty — an exemption without a reason is the pre-emptive
      # trap the discipline guards against. Example : "cargo test
      # --release compiles the binary; unavoidably slow by design."
      attribute :value, String
    end

    # ── Entity — slow run audit trail ──

    entity "SlowTestRun" do
      description "One recorded test run that exceeded the warning or error threshold. Appended by the Complain command. Provides the full audit trail of slow runs this session — the last_offending_suite / last_complaint_at scalars on the root mirror the most recent entry for fast reads, but this collection holds everything."
      attribute :recorded_at,   Timestamp
      attribute :suite_name,    SuiteName
      attribute :kind,          TestKind
      attribute :duration_ms,   DurationMs
      attribute :exceeded_by_ms, DurationMs
    end

    # ── Entity — named exemptions ──

    entity "ExemptedSlowTest" do
      description "A suite whose slowness is officially exempted with a named, case-by-case reason. Registered via ExemptSlowTest. The macrophage will not issue a complaint for a suite that appears in this collection — but the exemption must carry a non-empty reason, enforcing the same discipline as antibody markers. Exemptions are never pre-emptive; they are registered after the hook has complained and the team has decided."
      attribute :suite_name, SuiteName
      attribute :reason,     ExemptionReason
      attribute :exempted_at, Timestamp
    end

    # ── Session lifecycle ──

    command "StartSession" do
      role "System"
      description "Reset per-session counters at boot. The macrophage keeps a per-session tally so the discipline scoreboard reflects what ran today, not lifetime totals. The SlowTestRun and ExemptedSlowTest entity collections are NOT reset — they are audit trail and configuration respectively."
      attribute :session_started_at, Timestamp
      then_set :session_started_at, to: :session_started_at
      then_set :total_runs,            to: :total_runs
      then_set :runs_within_threshold, to: :runs_within_threshold
      then_set :runs_at_warning,       to: :runs_at_warning
      then_set :runs_over_threshold,   to: :runs_over_threshold
      then_set :total_duration_ms,     to: :total_duration_ms
      emits "SessionStarted"
    end

    # ── Test run recording ──

    command "RecordTestRun" do
      role "Hook"
      description "A test suite finished. Routes the run into the correct bucket based on duration_ms vs threshold_ms and warning_threshold_ms : within-threshold increments runs_within_threshold; at-warning increments runs_at_warning; over-threshold increments runs_over_threshold and chains into Complain (unless the suite is in ExemptedSlowTest). Always increments total_runs and adds duration_ms to total_duration_ms."
      attribute :suite_name,  SuiteName
      attribute :kind,        TestKind
      attribute :duration_ms, DurationMs
      then_set :total_runs,        to: :total_runs
      then_set :total_duration_ms, to: :total_duration_ms
      emits "TestRunRecorded"
    end

    # ── Exemption management ──

    command "ExemptSlowTest" do
      role "Developer"
      description "Register a named exemption for a specific suite so the macrophage will not complain about its duration. The reason attribute is required and must be non-empty — an exemption without a named reason falls into the pre-emptive trap the discipline forbids. Exemptions are registered after the hook has fired, never before; the SlowTestRun audit trail should already contain an entry for this suite. Appends an ExemptedSlowTest entity."
      attribute :suite_name,  SuiteName
      attribute :reason,      ExemptionReason
      attribute :exempted_at, Timestamp
      emits "SlowTestExempted"
    end

    # ── Threshold adjustment ──

    command "AdjustThreshold" do
      role "Developer"
      description "Update the error and/or warning thresholds if the team decides on a new default. The canonical CLAUDE.md contract is 1000 ms / 800 ms; this command exists for deliberate, team-agreed changes — not for relaxing the rule to hide rot. Both threshold_ms and warning_threshold_ms must be provided so the two values stay consistent."
      attribute :threshold_ms,         DurationMs
      attribute :warning_threshold_ms, DurationMs
      then_set :threshold_ms,         to: :threshold_ms
      then_set :warning_threshold_ms, to: :warning_threshold_ms
      emits "ThresholdAdjusted"
    end

    # ── Complaint surface ──

    command "Complain" do
      role "Hook"
      description "The TestSpeedMacrophage detected a test suite that exceeded the threshold_ms. Records the complaint text and timestamp on the root for fast statusline reads, appends a SlowTestRun entity to the audit trail, and updates last_offending_suite. The hook ALSO prints to stderr so Claude Code surfaces the complaint as a system reminder on the next turn — the feedback loop that closes the discipline mechanism. Complaint text should begin 'The TestSpeedMacrophage expected ...' so the rule's name is visible at a glance and attribution is unambiguous."
      attribute :suite_name,         SuiteName
      attribute :kind,               TestKind
      attribute :duration_ms,        DurationMs
      attribute :exceeded_by_ms,     DurationMs
      attribute :complaint,          ComplaintText
      attribute :last_complaint_at,  Timestamp
      then_set :last_complaint,        to: :complaint
      then_set :last_complaint_at,     to: :last_complaint_at
      then_set :last_offending_suite,  to: :suite_name
      then_set :runs_over_threshold,   to: :runs_over_threshold
      emits "ComplaintIssued"
    end
  end
end
