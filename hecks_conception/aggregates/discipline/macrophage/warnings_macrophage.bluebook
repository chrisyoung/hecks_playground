Hecks.bluebook "WarningsMacrophage", version: "2026.05.13.1" do
  vision "The zero-warning build rule made structural — one macrophage, one enforcement. Tracks compiler warnings (cargo / rustc), test-runner warnings (rspec deprecations), and lint warnings (ESLint / rubocop / similar). Every warning is an alarm waiting to be ignored; keeping the count at zero preserves the alarm's honesty. Suppression markers (#[allow(...)], eslint-disable, etc.) are treated with the same case-by-case discipline as antibody-exempt — recorded explicitly, never pre-emptive. Scoped strictly to the warnings discipline; no other rule lives here."
  category "discipline"

  # ============================================================
  # WARNINGS MACROPHAGE — one macrophage, one rule
  # ============================================================
  #
  # Rule (from CLAUDE.md / Standards) :
  #   "Warnings are errors waiting to happen — `cargo build` produces
  #   no warnings. `rspec` produces no deprecation traces. ESLint
  #   produces no swallowed rules."
  #
  # Why it matters : a zero-warning build is an alarm system. Every
  # warning that slips through dulls the signal; the team stops
  # noticing. Structural enforcement keeps the threshold honest by
  # making each deviation visible in the audit trail rather than
  # silent in a scrolling terminal.
  #
  # i595 context : the original Macrophage aggregate enforces
  # several rules in a single aggregate. i595 decomposes that
  # singleton into a family of per-rule macrophages. This is the
  # fourth member of that family. The parent Macrophage aggregate
  # is NOT retired here — this aggregate is a sibling.
  #
  # Warning sources tracked :
  #   Compiler — `cargo build`, `rustc`, or similar producing a
  #              warning line (e.g. "warning: unused variable")
  #   Test     — test runner (rspec, jest, etc.) producing a
  #              deprecation warning or a `warning:` trace
  #   Lint     — ESLint / rubocop / clippy / similar producing
  #              a rule violation outside compiler output
  #
  # Suppression markers (e.g. #[allow(dead_code)], eslint-disable)
  # are tracked as their own category — the discipline equivalent
  # of antibody-exempt markers for the warnings rule. They must be
  # named and intentional; pre-emptive suppression is itself a
  # violation surfaced by Complain.

  aggregate "WarningsMacrophage", "Per-rule macrophage for the zero-warning-build enforcement — tracks compiler, test, and lint warnings plus explicit suppression markers and the complaint history for this rule alone" do
    identified_by :name

    attribute :name, Name

    # Session metadata
    attribute :session_started_at, Timestamp

    # Warning tallies — broken out by source so the scoreboard
    # can show "2 compiler, 0 test, 1 lint" rather than a single number.
    attribute :total_warnings,      WarningCount
    attribute :compiler_warnings,   WarningCount
    attribute :test_warnings,       WarningCount
    attribute :lint_warnings,       WarningCount

    # Suppression markers — analogous to exempted_edits in
    # BluebookFirstMacrophage. Each #[allow(...)] or eslint-disable
    # that lands is recorded here; a non-zero count triggers the
    # same scrutiny as an antibody-exempt marker.
    attribute :suppressed_warnings, WarningCount

    # Latest-complaint surface — quick read for the statusline.
    attribute :last_complaint,       ComplaintText
    attribute :last_complaint_at,    Timestamp
    attribute :last_offending_file,  FilePath

    # ── Value-objects : this rule's language ──

    value_object "Name" do
      # Singleton key for this macrophage.
      attribute :value, String
    end

    value_object "Timestamp" do
      # ISO-8601 timestamp string. Used for session_started_at,
      # last_complaint_at, and per-event recorded_at fields.
      attribute :value, String
    end

    value_object "FilePath" do
      # An absolute or relative filesystem path recorded as the
      # site of a warning or complaint.
      attribute :value, String
    end

    value_object "WarningCount" do
      # Count of warnings of a particular kind (compiler / test /
      # lint / suppressed) recorded by this macrophage in the
      # current session.
      attribute :value, Integer
    end

    value_object "WarningText" do
      # The raw warning line as emitted by the tool —
      # e.g. "warning: unused variable `x` [unused_variables]".
      # Stored verbatim so the audit trail is replayable.
      attribute :value, String
    end

    value_object "WarningSource" do
      # Which tool surface produced the warning.
      # One of: "Compiler" | "Test" | "Lint"
      attribute :value, String
    end

    value_object "ComplaintText" do
      # The body of a complaint — the stderr text the hook emits.
      # Includes the rule name so complaint attribution is clear :
      # "The WarningsMacrophage expected ..."
      attribute :value, String
    end

    # ── Entity — warning audit trail ──

    entity "Warning" do
      description "One historical warning event. Records which file triggered the warning, the source tool, the raw warning text, and when it was recorded. The total_warnings / compiler_warnings / test_warnings / lint_warnings scalars on the root mirror live counts; this collection holds the full audit trail so individual warnings remain queryable after the session."
      attribute :recorded_at,   Timestamp
      attribute :file_path,     FilePath
      attribute :source,        WarningSource
      attribute :warning_text,  WarningText
    end

    # ── Session lifecycle ──

    command "StartSession" do
      role "System"
      description "Reset per-session counters at boot. The macrophage keeps a per-session tally so the discipline scoreboard reflects what surfaced today, not lifetime totals. The Warning entity collection is NOT reset — it is audit trail."
      attribute :session_started_at, Timestamp
      then_set :session_started_at, to: :session_started_at
      emits "SessionStarted"
    end

    # ── Warning recording — one command per source kind ──

    command "RecordCompilerWarning" do
      role "Hook"
      description "The compiler (cargo / rustc / similar) produced a warning line during a build. Increments compiler_warnings and total_warnings. The hook chains into Complain to surface the complaint on the next turn — this command records the fact; Complain records the reaction."
      attribute :file_path,    FilePath
      attribute :warning_text, WarningText
      attribute :recorded_at,  Timestamp
      emits "CompilerWarningRecorded"
    end

    command "RecordTestWarning" do
      role "Hook"
      description "The test runner (rspec / jest / similar) produced a deprecation warning or warning trace. Increments test_warnings and total_warnings. Deprecation traces are pre-failures — treating them as warnings under this rule surfaces the debt before it becomes a breakage."
      attribute :file_path,    FilePath
      attribute :warning_text, WarningText
      attribute :recorded_at,  Timestamp
      emits "TestWarningRecorded"
    end

    command "RecordLintWarning" do
      role "Hook"
      description "A linter (ESLint / rubocop / clippy / similar) produced a rule violation. Increments lint_warnings and total_warnings. Lint warnings that are swallowed or ignored become permanent technical debt; this command makes each one visible in the audit trail."
      attribute :file_path,    FilePath
      attribute :warning_text, WarningText
      attribute :recorded_at,  Timestamp
      emits "LintWarningRecorded"
    end

    command "RecordSuppressedWarning" do
      role "Hook"
      description "A suppression marker (#[allow(...)], eslint-disable-next-line, rubocop:disable, etc.) was added to a file — the warnings discipline is satisfied by the explicit marker. Tracked separately so the scoreboard can distinguish 'suppressed warnings' from 'unacknowledged warnings' and confirm the suppression discipline is case-by-case rather than blanket. Suppression without a corresponding named reason is itself a violation that Complain should surface."
      attribute :file_path,    FilePath
      attribute :warning_text, WarningText
      attribute :recorded_at,  Timestamp
      emits "SuppressedWarningRecorded"
    end

    # ── Complaint surface ──

    command "Complain" do
      role "Hook"
      description "The WarningsMacrophage detected a warning (or an unsanctioned suppression marker) that violates the zero-warning build rule. Records the complaint text and timestamp on the root for fast statusline reads, records the offending file, and appends a Warning entity for the audit trail. The hook ALSO prints to stderr so Claude Code surfaces the complaint as a system reminder on the next turn — the feedback loop that closes the discipline mechanism. Complaint text should begin 'The WarningsMacrophage expected ...' so the rule's name is visible at a glance."
      attribute :file_path,        FilePath
      attribute :complaint,        ComplaintText
      attribute :last_complaint_at, Timestamp
      then_set :last_complaint,      to: :complaint
      then_set :last_complaint_at,   to: :last_complaint_at
      then_set :last_offending_file, to: :file_path
      emits "ComplaintIssued"
    end
  end
end
