Hecks.bluebook "Violation", version: "2026.04.28.1" do
  vision "A detected rule violation — the breach half of the immune system as a bluebook."
  category "discipline"

  # ============================================================
  # VIOLATION — split from validator.bluebook (i112)
  # ============================================================
  #
  # Was one half of the original Validator bluebook, paired with Rule
  # (now in discipline/rule.bluebook). Violation is the detected
  # breach ; Rule is the catalog. No policies between them in the
  # original, so the split is structural-only.

  aggregate "Violation", "A detected rule violation" do
    identified_by :ref
    attribute :ref, String
    attribute :rule_name, String
    attribute :message, String
    attribute :aggregate_name, String
    attribute :command_name, String

    command "DetectViolation" do
      description "A rule was broken"
      attribute :rule_name, String
      attribute :message, String
      emits "ViolationDetected"
      then_set :rule_name, to: :rule_name
      then_set :message, to: :message
    end

    query ListViolations do
      description "What's wrong with this domain?"
    end
  end
end
