Hecks.adapter_family "persistence" do
  # The persistence adapter family : where an aggregate's state lives.
  # Each consumer hecksagon declares ONE persistence adapter (e.g.
  # `adapter :sqlite, db: "data/app.db"`) ; the runtime resolves the
  # provider and routes every repository through it. Unlike the driving
  # adapter families (:tts, :web_tool, :mcp) which fire on a command,
  # persistence is SUBSTRATE — it doesn't trigger on an event, it backs
  # the find/save/all the bus already performs.
  #
  # Adding a connection field — say :pool_size or :timeout — is editing
  # this declaration. Adding a PROVIDER (e.g. :duckdb) is appending to
  # providers below + a framework/providers/<provider>.hecksagon.

  vision "Where aggregate state lives. Each instance carries a provider
          (:memory / :heki / :sqlite / :postgres / :mysql) and the
          connection options that provider needs (db: for sqlite,
          host:/user:/name: for postgres+mysql). The runtime mints a
          repository backend per provider — memory + heki are the
          built-in defaults ; sqlite/postgres/mysql build a typed table
          per aggregate, one column per attribute from the bluebook IR.
          Behavior_kind = back_aggregate_storage."

  fields  :name,      # symbolic adapter name (optional ; persistence is a singleton per hecksagon)
          :provider,  # one of the named providers below
          :db,        # sqlite : filesystem path to the .db file
          :url,       # connection URL (postgres/mysql alternative to host/user/name)
          :host,      # postgres/mysql : database host
          :user,      # postgres/mysql : database user
          :password,  # postgres/mysql : database password
          :name_opt   # postgres/mysql : database name (`name:` in the DSL)

  # Persistence is substrate, not a command-triggered side effect : it
  # has no trigger command and chains into nothing. Both fields are
  # :none so the framework registry classes it as a driven backend,
  # not a driving adapter.
  trigger_field :none
  response_field :none

  behavior :back_aggregate_storage

  providers :memory,    # in-process HashMap (the runtime default)
            :heki,      # markdown-line .heki files (Miette's organ store)
            :sqlite,    # framework/providers/sqlite.hecksagon — typed columns, one .db file
            :postgres,  # future — Sequel/native driver
            :mysql      # future — Sequel/native driver
end
