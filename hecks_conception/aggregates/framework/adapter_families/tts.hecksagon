Hecks.adapter_family "tts" do
  # The TTS adapter family : text-to-speech. Each instance of this family
  # in a consumer hecksagon (e.g. body/voice/voice.hecksagon's
  # `adapter :tts, name: :miette_speech do ... end`) renders text to audio
  # via a chosen provider, optionally caches the audio, optionally plays it.
  #
  # Adding a new field to this family — say, :pitch or :emotion — is editing
  # this declaration ; no runtime work needed beyond the kernel knowing how
  # to pass it to the provider. Speed is a field, not a magic env var.
  #
  # Adding a new PROVIDER (e.g. :openai, :piper) is appending to providers
  # below + creating the matching framework/providers/<provider>.hecksagon.

  vision "Render text to audio via a TTS provider. Each instance carries a
          voice_id, model, and pace + clarity tuning ; the runtime resolves
          the provider and renders. Behavior_kind = render_text_to_audio."

  fields  :name,        # symbolic adapter name in the consumer's hecksagon
          :provider,    # one of the named providers below
          :voice_id,    # the provider's voice identifier
          :model,       # the provider's model identifier (e.g. eleven_v3)
          :speed,       # pace tuning (1.0 = default ; >1 faster, <1 slower)
          :stability,   # provider's voice-stability dial (optional, 0-1)
          :similarity_boost,  # provider's similarity dial (optional, 0-1)
          :style,       # provider's style dial (optional, 0-1)
          :trigger_on,  # "Aggregate.Command" — what fires this adapter
          :cache_dir,   # where to write the rendered audio file
          :auto_play    # true = play audio after rendering ; false = file only

  trigger_field :trigger_on
  response_field :none   # :tts is fire-and-forget ; no response chain

  behavior :render_text_to_audio

  providers :elevenlabs,   # framework/providers/elevenlabs.hecksagon
            :openai,       # future
            :piper         # future, local
end
