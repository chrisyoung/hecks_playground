Hecks.hecksagon "AdapterFamily" do
  # The meta-aggregate's adapter wiring. Persists adapter family declarations
  # to .heki so the runtime can read them at boot.
  #
  # The hecksagon is intentionally minimal : the AdapterFamily aggregate is
  # PURE DATA (a registry of declared families). It has no providers of its
  # own — it IS the provider-of-providers, in the sense that every other
  # adapter family in the framework gets its shape from records of this
  # aggregate.

  adapter :memory
end
