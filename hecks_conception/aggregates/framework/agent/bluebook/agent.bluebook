Hecks.bluebook "Agent", version: "2026.07.02.1" do
  vision "A being that dispatches. Humans, systems, daemons, bots, AIs — the named, typed actors whose intent flows through every command. Today every command carries a role string ('Chris', 'System', 'Caller') ; this bluebook lifts the string into a first-class typed reference so provenance and audit are computable instead of suggested."
  category "framework"

  # ============================================================
  # AGENT — the being that dispatches
  # ============================================================
  #
  # Conceived 2026-05-07 from i483. Surfaced while four StoreHouse
  # handler agents were running in parallel and Chris noticed that
  # roles already gesture at being objects ; the framework hadn't
  # yet reached for the type. This bluebook is where the type comes
  # into being.
  #
  # Agent is PURE IDENTITY + PROVENANCE : the named "who" of every
  # dispatch. It carries NO authorization surface — no auth identity
  # link, no role binding, no permissions. Auth/authz is a
  # cross-cutting concern owned entirely by the Authorization context
  # (Phase 4 decouple, 2026-07-02) : identity↔role lives in
  # Authorization::RoleAssignment, the rules live in
  # Authorization::Policy, and the gate reads that ONE context.
  # Supporting authz never adds a field, command, or surface to a
  # domain bluebook — this one included. That is also what lets a
  # client-app user hold a role without ever being an Agent : the
  # principal universe is AuthIdentity, and Agent is only the
  # provenance registry for beings that dispatch HERE.
  #
  # ── Design decisions (i483, amended by the 2026-07-02 decouple) ──
  #
  # 1. Agent kinds : enum-checked at the bluebook layer with the
  #    closed set ["human", "system", "daemon", "bot", "ai"]. Closed
  #    because the kind drives downstream typing — ai Agents may carry
  #    a model reference, human Agents drive the audit trail visible
  #    to compliance. New kinds enter through this bluebook, not
  #    through accidental string literals.
  #
  # 2. Role is its own aggregate (see role.bluebook in this same
  #    directory), not a value object on Agent : Role carries a
  #    permissions list whose grants and revocations are domain
  #    events in their own right, audited separately from Agent's
  #    own lifecycle. Since the decouple, BINDING an identity to a
  #    role is not an Agent concern either — it lives in
  #    Authorization::RoleAssignment, keyed by auth_identity_id.
  #
  # 3. Permissions as Phrase patterns live on Role historically ;
  #    enforcement is consolidated into the Authorization PDP. The
  #    gate matches a principal's assigned role against active
  #    Policy permits/forbids (deny-by-default, forbid-override) ;
  #    Role's own list is not enforced.
  #
  # 4. AuthIdentity is a framework aggregate in its own right
  #    (auth_identity.bluebook — i264, landed). Agent does NOT link
  #    to it : the caller's identity is stamped at the door as the
  #    reserved actor_kind / actor_auth_id meta-attrs and resolved
  #    through Authorization::RoleAssignment, never through Agent
  #    state. (Until 2026-07-02 Agent carried auth_identity_id +
  #    role_name and the Bind / LinkAuthIdentity commands ; the
  #    Phase 4 decouple removed them so authz needs no domain
  #    surface, per the authorization vision.)
  #
  # 5. Cascade attribution : the Agent reference flows automatically
  #    through cascading dispatches. When EnterSleep fans out through
  #    ten policies, every downstream command inherits the originator's
  #    Agent unless a policy explicitly re-attributes (the System Agent
  #    overrides for system-initiated cascades like garbage collection).
  #    First chapter : the convention is documented here ; the runtime
  #    wiring is filed under i481 (Dispatch's `Dispatched` event picks
  #    up `dispatched_by: Agent`). Provenance keys on the agent NAME —
  #    untouched by the decouple.
  #
  # ── Companion bluebooks ───────────────────────────────────────
  #
  # role.bluebook        — Role is a typed aggregate carrying a name
  #                        and a permissions list. The thing a
  #                        RoleAssignment names.
  # auth_identity.bluebook — the framework's authentication primitive
  #                        (i264, landed). The `authenticate` gate
  #                        reads its active set.
  # ../../authorization/authorization.bluebook — the PDP : Policy
  #                        rules + RoleAssignment (identity↔role).
  #                        The `authorize` gate reads THIS context
  #                        only ; the roster policies at its top level
  #                        seed the standing assignments at boot.
  # storehouse/dispatch.bluebook — the bus. i481 wires the `Dispatched`
  #                        event payload to carry `dispatched_by: Agent`.

  aggregate "Agent", "A being that dispatches — human, system, daemon, bot, or ai. The typed actor whose intent flows through every command. Pure identity + provenance : authorization lives in the Authorization context, never here." do
    identified_by { name.value }

    # ── Value-objects : the domain's language ──
    #
    # 2026-05-12 : every primitive wrapped in a typed value-object per
    # the no-primitive-envy discipline. Mirrors macrophage / immunity.
    # Per the 2026-05-12 discipline — duplication of VO names across
    # aggregates is fine ; no bluebook-level shared VOs.

    # Name — the Agent's natural-key identifier. Same shape as Role.Name,
    # different concept ; the duplication is intentional.
    value_object "Name" do
      attribute :value, String
    end

    # Description — one-line prose : who this Agent is.
    value_object "Description" do
      attribute :value, String
    end

    # Kind — closed set of agent shapes. The enum is enforced at the
    # bluebook layer ; the validator rejects unrecognised values at
    # parse time. Typing is downstream-load-bearing : ai Agents may
    # carry a model reference, human Agents drive the audit trail
    # visible to compliance.
    value_object "Kind" do
      attribute :value, one_of("human", "system", "daemon", "bot", "ai")
    end

    # Status — the Agent's lifecycle state. "active" on Birth ;
    # "retired" after Retire. Pure provenance lifecycle : the RBAC
    # read-model reads Authorization::RoleAssignment, not Agent, so
    # retiring an Agent is an audit fact, not a permission change —
    # revoke access by retiring the RoleAssignment in the authz
    # context. Mirrors the Pizzas Order.status form.
    value_object "Status" do
      attribute :value, one_of("active", "retired")
    end

    attribute :name,        Name
    attribute :description, Description
    attribute :kind,        Kind

    # status : lifecycle state. Defaults to "active" on Birth ; Retire
    # transitions it to "retired".
    attribute :status, Status, default: { value: "active" }

    lifecycle :status, default: "active" do
      transition "Retire" => "retired"
    end

    # ── Commands ───────────────────────────────────────────────
    #
    # The verb here is `Birth` (not `Conceive`) — the conception
    # language is reserved for DomainCell.Conceive, where a new
    # *domain* enters the nursery. An Agent is a being, not a domain ;
    # Birth captures the moment of arrival into the framework's
    # roster of beings. The event is `AgentBorn`.
    #
    # Filed during the i483 merge : the runtime today resolves
    # cascade triggers by bare command name across all loaded
    # aggregates, so two `Conceive` commands in different aggregates
    # collide when a policy says `trigger "Conceive"`. Filed as a
    # cross-aggregate name-uniqueness validator gap (see follow-up).

    command "Birth" do
      role "Framework"
      description "Bring a new Agent into being. Inputs : the agent's name, a one-line description of who they are, and the kind. Authorization is separate BY DESIGN : grant access by assigning the agent's auth identity a role in the Authorization context (RoleAssignment.Assign), never by touching the Agent."
      attribute :name,        Name
      attribute :description, Description
      attribute :kind,        Kind
      emits "AgentBorn"
    end

    command "Retire" do
      role "Framework"
      description "Mark an Agent as retired. The Agent record stays for audit ; future dispatches under this name are rejected by the bus. Cascades already in flight complete with the retired Agent attribution intact."
      reference_to(Agent)
      emits "Retired"
    end
  end
end
