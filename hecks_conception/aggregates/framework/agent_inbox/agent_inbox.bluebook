Hecks.bluebook "AgentInbox" do
  vision "The durable blackboard that makes Tools::AgentTool.SendMessage REAL — inter-agent messaging through storehouse (i708 stigmergy), not the harness's missing SendMessage. The runtime never had an agent-resume API, so agent_tool.hecksagon's adapter was a canned 'agent resumed' stub. AgentMessage is the substrate that replaces the stub : a sender records a durable message addressed to an agent id ; the target agent reads it on its poll loop and Replies ; the sender's out-of-process adapter binary block-polls the reply query until it lands and returns it. The bus is the medium, the .heki record is the trace ; no orchestrator threads prompts between agents."
  category "framework"

  aggregate "AgentMessage" do
    description "One message addressed to a running agent by id, durable on the blackboard. Lifecycle : sent (recorded, unread) -> read (the target agent picked it up off its Unread poll) -> replied (the target agent posted its answer). The sender's send-message adapter binary block-polls the `answered` query for this id ; the reply is durable aggregate state, the binary only gives it a synchronous face."
    identified_by :id

    attribute :agent_id, AgentId
    attribute :body,     Body
    attribute :mid,      Mid,    default: ""
    attribute :reply,    Reply, default: ""
    attribute :status,   Status, default: "sent" do
      transition "MarkRead" => "read"
      transition "Reply"    => "replied"
    end

    value_object "AgentId" do
      # The target agent's id or name — the same handle the Agent tool
      # mints when it spawns an agent. Addressing is by id, not by a
      # direct channel : the sender never holds a reference to the agent.
      attribute :value, String
    end

    value_object "Body" do
      # The message text the sender wants the target agent to receive.
      # Large bodies ride the event payload ; only this lands in state.
      attribute :value, String
    end

    value_object "Mid" do
      # A READABLE echo of the message's identity id, minted == the id by the
      # sender. A query returns an aggregate's FIELDS but not its identity, so
      # without this echo the target agent could read the message off Unread but
      # not know which id to Reply to. The agent reads mid, then Reply(id=mid).
      attribute :value, String
    end

    value_object "Reply" do
      # The target agent's answer, written by Reply. Empty until replied ;
      # the sender's block-poll returns this once status == replied.
      attribute :value, String
    end

    value_object "Status" do
      # sent | read | replied — String not Boolean per heki's String-only
      # serializer. Drives the Unread / answered queries the poll loops read.
      attribute :value, String
    end

    command "Send" do
      role "Agent"
      goal "Post a message to a running agent by id, durable on the blackboard"
      attribute :agent_id, AgentId
      attribute :body,     Body
      attribute :mid,      Mid
      then_set :agent_id, to: :agent_id
      then_set :body,     to: :body
      then_set :mid,      to: :mid
      emits "AgentMessageSent"
    end

    command "MarkRead" do
      role "Agent"
      goal "The target agent marks the message read when it picks it up off its Unread poll"
      reference_to AgentMessage
      emits "AgentMessageRead"
    end

    command "Reply" do
      role "Agent"
      goal "The target agent records its answer ; the sender's block-poll returns it"
      reference_to AgentMessage
      attribute :reply, Reply
      then_set :reply, to: :reply
      emits "AgentMessageReplied"
    end

    # The target agent polls this on its loop : every message addressed to
    # it that it hasn't read yet. It MarkReads each, acts, and Replies.
    query "Unread" do |agent_id|
      where(agent_id: agent_id, status: "sent")
    end

    # The sender's adapter binary block-polls this for the message id it
    # Sent : empty until the target agent Replies, then carries the reply.
    # Filter by `mid` (the identity echo), NOT by `id` (the identity field) —
    # queries project attributes, not the identity row-key. `mid` is set ==
    # the id at Send so the sender can address this by correlation id.
    query "Answered" do |id|
      where(mid: id, status: "replied")
    end

    # The SWEEP read : every unread message across EVERY agent, no agent_id
    # filter. Unread is the per-agent poll (one agent reads its own mail) ;
    # AllUnread is the singleton-sweep read (one InboxPoller tick reads the
    # whole blackboard at once). Mirrors ProcessMacrophage.Sweep walking the
    # entire watchlist in one tick rather than one driver per supervised
    # process : agents are spawned dynamically, so the poller is ONE
    # sweep-all-inboxes Driver, never one driver per agent.
    query "AllUnread" do
      where(status: "sent")
    end
  end

  aggregate "InboxPoller" do
    description "The singleton sweeper that drives the inbox forward — the receiver half of i708 stigmergy modeled as a Driver. Direct analog of ProcessHealth::ProcessMacrophage : Drivers are STATIC (declared, projected into the Procfile) but agents are DYNAMIC (spawned at will), so there is exactly ONE poller that sweeps EVERY inbox per tick, not one driver per agent. Poll is the recurring tick : it records last_polled_at + emits Polled, mirroring ProcessMacrophage.Sweep recording the tick + emitting Swept. The per-message fan-out (read AllUnread, MarkRead + Reply each) is the runtime's job — the RunPollOnPolled policy spawns bin/agent_poll.sh, exactly as RunSweepOnSwept spawns bin/process_health_sweep. The bluebook only records the tick happened ; the impure sweep leaf lives out-of-process."
    identified_by :name

    attribute :name,           Name
    attribute :last_polled_at, Timestamp, default: "—"
    attribute :polls_run,      PollCount, default: 0

    value_object "Name" do
      # Singleton key — there is one InboxPoller per being. Default
      # "inbox_poller". Mirrors ProcessMacrophage.Name : under i611 phase 1
      # (`singleton: true`) this VO disappears.
      attribute :value, String
    end

    value_object "Timestamp" do
      # ISO-8601 wall-clock instant of the last poll tick — the freshness
      # signal an organ-health check reads to tell a live poller from a
      # flatlined one. Duplicated per the per-aggregate VO rule.
      attribute :value, String
    end

    value_object "PollCount" do
      # Tally of Poll ticks fired since session start. The caller passes the
      # next count, mirroring ProcessMacrophage's externally-incremented
      # tallies — the bluebook stays arithmetic-free.
      attribute :value, Integer
    end

    command "Poll" do
      role "System"
      goal "One inbox-sweep tick — record it happened ; the runtime fans out across AllUnread"
      description "One poll tick. The Driver (agent_inbox.hecksagon's `driving on interval` + the Procfile inbox_poller loop) fires this on its cadence ; Poll records last_polled_at + emits Polled. The per-message fan-out — read AllUnread, MarkRead + Reply each by its mid — is the runtime's job, done by bin/agent_poll.sh which the RunPollOnPolled policy spawns. Poll itself expresses no fan-out, mirroring ProcessMacrophage.Sweep (records the tick, the spawned script walks the records)."
      attribute :last_polled_at, Timestamp
      then_set :last_polled_at, to: :last_polled_at
      emits "Polled"
    end
  end

  # ── The Driver realization lives in the hecksagon, not a policy ──
  #
  # There is deliberately NO RunPollOnPolled Process.Spawn policy here. The
  # receiver is realized as a long-running :daemon (agent_inbox.hecksagon's
  # `adapter :daemon, name: :inbox_poller, command: "bin/agent_poll.sh"`,
  # projected to the Procfile inbox_poller member) : bin/agent_poll.sh IS the
  # Driver loop. Each tick it dispatches InboxPoller.Poll (which records
  # last_polled_at + emits Polled as the freshness signal) and then sweeps
  # AllUnread inline — MarkRead + Reply each. A Process.Spawn-on-Polled policy
  # would make the daemon spawn copies of itself every tick ; one mechanism
  # (the daemon sweeps inline) is correct. Polled stays a pure domain event a
  # future reactor (metrics, health) can subscribe to.
end
