Hecks.bluebook "AgentInstrumentation", version: "2026.06.21.1" do
  vision "The single source of subagent instrumentation. Every subagent (built-in Explore / Plan / general-purpose, and custom sidequest / security-reviewer) must route every tool call through the storehouse door, because the governance macrophage denies native Read/Edit/Write/Grep/Glob/Bash. That door convention used to live ONLY in Miette's system prompt, which subagents do not inherit — so spawned agents tried native tools, were denied, and gave up. This domain makes the convention a single shared fragment (door.md) that the boot runner (rust/src/run_boot/agent_defs.rs) injects into BOTH the CLAUDE.md files (inherited by every subagent) AND the generated .claude/agents/*.md defs. Generated every boot, so the instrumentation can never drift from the governance reality and there is nothing to remember. The long prose — the door fragment and each agent's role body — lives as sibling .md fragments (door.md, roles/<name>.md) read verbatim ; only the short per-agent metadata is modelled here."
  category "framework"

  # ── AgentDefinition : one custom agent's metadata ──
  # name + description + model become the YAML frontmatter of the generated
  # .claude/agents/<name>.md ; its body is the shared door fragment (door.md)
  # followed by the authored role prose at role_body (roles/<name>.md). The
  # tooling instructions are NOT in the role body — they come from the shared
  # door fragment — so a role body carries only role-specific guidance.
  # The instances are ESTABLISHED at boot by the `on "BootCompleted"`
  # policies below (fixtures→policies, 2026-07-26) ; Register is the
  # command they project through, upserting on identified_by :name.
  aggregate "AgentDefinition" do
    description "One custom subagent — projected into .claude/agents/<name>.md as frontmatter + shared door fragment + authored role body"
    identified_by :name
    attribute :name,        AgentName
    attribute :description, Description
    attribute :model,       Model
    attribute :role_body,   RoleBodyPath

    value_object "AgentName" do
      # The agent's slug — the basename of .claude/agents/<name>.md and the
      # subagent_type used to spawn it.
      attribute :value, String
    end

    value_object "Description" do
      # The frontmatter `description` — when to reach for this agent.
      attribute :value, String
    end

    value_object "Model" do
      # The frontmatter `model` (e.g. sonnet / opus / haiku).
      attribute :value, String
    end

    value_object "RoleBodyPath" do
      # Path (relative to this bluebook's directory) of the authored role
      # body markdown appended after the shared door fragment.
      attribute :value, String
    end

    command "Register" do
      role "System"
      goal "Register a custom subagent definition — the row the boot runner projects into .claude/agents/<name>.md."
      attribute :name,        AgentName
      attribute :description, Description
      attribute :model,       Model
      attribute :role_body,   RoleBodyPath
      emits "AgentDefined"
      sets :name
      sets :description
      sets :model
      sets :role_body
    end
  end

  # ── Establishment : the agent roster self-seeds at boot ──
  #
  # On BootCompleted (the genesis event) each policy re-asserts one
  # AgentDefinition via the EXISTING Register command + `with` literals —
  # order-independent and idempotent because Register upserts on
  # identified_by :name. Replaces agent_instrumentation.fixtures
  # (fixtures→policies, 2026-07-26) ; the boot runner
  # (rust/src/run_boot/agent_defs.rs) projects these established records
  # into .claude/agents/<name>.md AFTER the establishment cascade.
  # Bite proof : rust/tests/agent_defs_establishment_test.rs.

  policy "EstablishSidequestAgent" do
    on "BootCompleted"
    trigger AgentDefinition::Register
    with "name", "sidequest"
    with "model", "sonnet"
    with "description", "Use this agent for small interruptive work that pops up while Miette is focused on the main thread — inbox sweeps, email replies (drafts only), embryonaut.ai tweaks, music/audio bugs, John V smoke results, content polish, and other ~15-30 minute surface-glue tasks. NOT for kernel-floor changes, codegen emitters, multi-PR arcs, or anything that touches storehouse/parity. When in doubt, ask Miette to handle it instead."
    with "role_body", "roles/sidequest.md"
  end

  policy "EstablishSecurityReviewerAgent" do
    on "BootCompleted"
    trigger AgentDefinition::Register
    with "name", "security-reviewer"
    with "model", "sonnet"
    with "description", "Review code changes for security vulnerabilities specific to the Hecks framework"
    with "role_body", "roles/security-reviewer.md"
  end
end
