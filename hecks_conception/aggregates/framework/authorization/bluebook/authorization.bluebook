Hecks.bluebook "Authorization", version: "2026.06.27.1" do
  vision "The Policy Decision Point — authorization DECOUPLED from every domain into one bounded context, so policy changes in ONE place with no domain redeploy and the system is multi-team / multi-tenant out of the gate. Cedar-shaped : a Policy is a RULE — effect (permit|forbid), principal, action, resource, an optional `when` condition, and an optional expiry. Domains carry NO authz (no `role` on commands) ; the gate (the dispatch PEP) consults THIS context's rule set — hydrated into a boot read-model and evaluated IN-PROCESS (the OPA-bundle / Zanzibar-cache model : decoupled authoring, local evaluation, no per-dispatch network hop) — the NIST Policy-Engine(decision)/PEP(enforcement) split. Multi-team/tenant = namespaced resources + `when`-scoped conditions (e.g. permit(role=editor, action=Edit, resource=Doc) when resource.team == principal.team). Evaluation is deny-by-default with forbid-override : ALLOW iff an active, unexpired PERMIT matches and NO matching FORBID does. Identity stays OIDC/JWT (sub->principal) ; expiry IS the JWT exp / grant TTL. FRONTIER : the `when` predicate exceeds today's where-filter grammar, so the first cut matches effect+principal+action+resource (condition '-' = unconditional) and `when` lands with the kernel-interpreter the extraction/conception chapters wait on — the rule SHAPE is conceived now so policy is authored against it from day one."
  category "framework"

  aggregate "Policy", "One Cedar-shaped authorization rule owned by the PDP : effect (permit|forbid), principal, action, resource, an optional `when` condition, an optional expiry. The gate hydrates the active set and evaluates allow/deny in-process (deny-by-default, forbid-override). Domains reference none of this ; policy lives and changes here alone." do
    identified_by { id.value }

    attribute :id,         Id
    attribute :effect,     Effect
    attribute :principal,  Principal
    attribute :action,     Action
    attribute :resource,   Resource
    attribute :condition,  Condition,  default: { value: "-" }
    attribute :expires_at, ExpiresAt,  default: { value: "-" }
    attribute :status,     Status,     default: { value: "active" }

    value_object "Id" do
      # Stable natural key for the rule (e.g. "editor-edit-doc"). The PDP keys by this ; Permit/Forbid upsert on it.
      attribute :value, String
    end
    value_object "Effect" do
      attribute :value, String

      one_of do
        member value: "permit"
        member value: "forbid"
      end
    end
    value_object "Principal" do
      # WHO : a role name ("editor"), a specific principal id (an OIDC sub), or "*" (any). Roles keep RBAC ; sub keeps direct grants.
      attribute :value, String
    end
    value_object "Action" do
      # WHAT : a command/query phrase ("Pizzas::Order.PlaceOrder"), a prefix ("Pizzas::Order.*"), or "*".
      attribute :value, String
    end
    value_object "Resource" do
      # ON WHAT : an aggregate/resource pattern ("Pizzas::Order"), a namespace ("Pizzas::*"), or "*". Namespacing carries multi-tenant scope.
      attribute :value, String
    end
    value_object "Condition" do
      # The `when` predicate (ABAC), e.g. "resource.team == principal.team". "-" = unconditional. FRONTIER : evaluated once the kernel-interpreter lands ; the first runtime cut treats non-"-" conditions conservatively (see the gate).
      attribute :value, String
    end
    value_object "ExpiresAt" do
      # ISO-8601 instant the rule expires (the JWT exp / grant TTL). "-" = no expiry. The gate excludes expired rules (clock::now).
      attribute :value, String
    end
    value_object "Status" do
      attribute :value, String

      one_of do
        member value: "active"
        member value: "retired"
      end
    end

    command "Permit" do
      role "Framework"
      description "Author (upsert by id) a PERMIT rule. Deny-by-default means nothing is allowed until a permit matches. Multi-team : each team authors its own permits in this one context, no domain touched."
      attribute :id,         Id
      attribute :principal,  Principal
      attribute :action,     Action
      attribute :resource,   Resource
      attribute :condition,  Condition
      attribute :expires_at, ExpiresAt
      then_set :id,         to: :id
      then_set :effect,     to: "permit"
      then_set :principal,  to: :principal
      then_set :action,     to: :action
      then_set :resource,   to: :resource
      then_set :condition,  to: :condition
      then_set :expires_at, to: :expires_at
      then_set :status,     to: "active"
      emits "Permitted"
    end

    command "Forbid" do
      role "Framework"
      description "Author (upsert by id) a FORBID rule. Forbid OVERRIDES permit : a matching forbid denies even if a permit also matches — the standard Cedar/least-privilege precedence."
      attribute :id,         Id
      attribute :principal,  Principal
      attribute :action,     Action
      attribute :resource,   Resource
      attribute :condition,  Condition
      attribute :expires_at, ExpiresAt
      then_set :id,         to: :id
      then_set :effect,     to: "forbid"
      then_set :principal,  to: :principal
      then_set :action,     to: :action
      then_set :resource,   to: :resource
      then_set :condition,  to: :condition
      then_set :expires_at, to: :expires_at
      then_set :status,     to: "active"
      emits "Forbidden"
    end

    command "Retire" do
      role "Framework"
      description "Retire a rule — soft-delete. The active set (and so the gate) drops it on the next boot / re-hydrate. Time-bounded revocation : a rule also drops automatically once expires_at passes."
      reference_to(Policy)
      given("rule must currently be active") { status == "active" }
      then_set :status, to: "retired"
      emits "Retired"
    end

    query "Active" do
      description "Every active rule — the set the gate hydrates into its in-process PDP read-model at boot (refreshed on a Policy lifecycle event). The runtime does the matching (effect/principal/action/resource, forbid-override, expiry) ; the where-grammar can't express that, so this query is the BUNDLE, not the decision."
      where status: "active"
    end

    query "Explain" do
      description "DRY-RUN the decision : given a SUBJECT `principal` + an `action`, return the verdict (permit / forbid / deny-by-default) + the matched rules WITHOUT dispatching — so policy is authored confidently. The INVERSE of Active : Active is the BUNDLE (the rules), Explain is the DECISION (runtime-COMPUTED, not a where-filter, like the gate). The caller's access is gated like any read (operator/System sees it ; agents are denied, so explain is not a policy-enumeration oracle) ; the SUBJECT is evaluated with NO origin short-circuit, so it shows the true verdict even for a System subject (the gate's origin-admit is noted, not applied). A conditional permit shows as inert until the `when` frontier lands."
    end

    lifecycle :status, default: "active" do
      transition "Permit" => "active",  from: ["active"]
      transition "Forbid" => "active",  from: ["active"]
      transition "Retire" => "retired", from: "active"
    end
  end

  aggregate "RoleAssignment", "RBAC's identity→role, owned by the authorization context — never by a domain aggregate. One record per auth identity (identified_by :auth_identity_id ; Assign upserts on it). The gate's AclReadModel hydrates auth_identity_id → role_name from the active set, then exact-matches the role against Policy principals. This is where the Agent domain's auth surface moved in the Phase 4 decouple (2026-07-02) : a principal — client-app user, API key, agent — holds a role without any domain carrying auth." do
    identified_by { auth_identity_id.value }

    attribute :auth_identity_id, AuthIdentityId
    attribute :role_name,        RoleName
    attribute :status,           Status, default: { value: "active" }

    value_object "AuthIdentityId" do
      # The principal's stable identity — an OIDC sub, an agent's stamped
      # HECKS_SESSION_AUTH_ID, an API-key id. The natural key : one
      # assignment per identity, so a duplicate is structurally
      # unrepresentable (replacing the read-model's old last-wins-by-
      # iteration over Agent rows).
      attribute :value, String
    end
    value_object "RoleName" do
      # The role this identity fills — matched EXACTLY against Policy
      # principals by the gate (no inheritance, per the RBAC→PDP
      # consolidation). Roles keep RBAC ; sub keeps direct grants.
      attribute :value, String
    end
    value_object "Status" do
      attribute :value, String

      one_of do
        member value: "active"
        member value: "retired"
      end
    end

    command "Assign" do
      role "Framework"
      description "Assign (upsert by auth identity) a role to a principal. Re-assigning replaces the role — the audit trail keeps both events. Idempotent : the roster re-asserts each boot."
      attribute :auth_identity_id, AuthIdentityId
      attribute :role_name,        RoleName
      then_set :auth_identity_id, to: :auth_identity_id
      then_set :role_name,        to: :role_name
      then_set :status,           to: "active"
      emits "Assigned"
    end

    command "Retire" do
      role "Framework"
      description "Retire an assignment — revoke the principal's role. Fail closed : a retired assignment resolves to NO role, so the principal is deny-by-default at the gate on the next re-hydrate."
      reference_to(RoleAssignment)
      given("assignment must currently be active") { status == "active" }
      then_set :status, to: "retired"
      emits "AssignmentRetired"
    end

    query "Active" do
      description "Every active assignment — the set the gate's AclReadModel hydrates into auth_identity_id → role_name (at boot, on a RoleAssignment lifecycle dispatch, and after the boot-completion cascade settles)."
      where status: "active"
    end

    lifecycle :status, default: "active" do
      transition "Assign" => "active",  from: ["active"]
      transition "Retire" => "retired", from: "active"
    end
  end

  # ============================================================
  # THE ROSTER — who this deployment's principals are
  # ============================================================
  #
  # Establishment policies that self-seed the standing authz state at
  # boot. On BootCompleted (the genesis event) each policy re-asserts a
  # RoleAssignment or a Policy rule via the EXISTING commands above +
  # `with` literals : order-independent and idempotent, because every
  # target upserts on its natural key (RoleAssignment on
  # auth_identity_id, Policy on id). No domain bluebook is touched, no
  # new field, no new runtime capability — the keystone (BootCompleted
  # through the policy engine) fires these exactly as it fires
  # boot.bluebook's StartStudioOnComplete. They live at this bluebook's
  # top level, beside the aggregates they trigger, so the single-file
  # validator resolves every trigger.
  #
  # Type-shaped : agents of the same TYPE share a ROLE, and permits are
  # authored per role, never per identity. pr-agent stands alone ;
  # workflow-subagent + sidequest are two identities sharing the
  # workflow-subagent role — the role layer exercised, not decorative
  # (retire ONE assignment to revoke ONE being ; retire the role's
  # permits to revoke the type). The operator and the drivers/clocks
  # stay System : admitted by origin, never rostered.
  #
  # Grants are least-privilege by construction : deny-by-default means
  # the permits below are the ENTIRE surface an agent principal can
  # touch. Tools::* is the working surface ; Authorization::* and
  # Governance::* are explicitly forbidden (forbid-overrides-permit)
  # so no future broad permit can accidentally open the control plane.
  #
  # LATENT (Q3 two-step) : the roster authors records, but no launcher
  # stamps HECKS_SESSION_AUTH_ID yet — no real agent dispatches as
  # governed until the separate, reversible env cutover.

  # ── Role assignments (upsert on auth_identity_id) ──────────────

  policy "RosterAssignPrAgent" do
    on "BootCompleted"
    trigger "RoleAssignment.Assign"
    with "auth_identity_id", "pr-agent"
    with "role_name", "pr-agent"
  end

  policy "RosterAssignWorkflowSubagent" do
    on "BootCompleted"
    trigger "RoleAssignment.Assign"
    with "auth_identity_id", "workflow-subagent"
    with "role_name", "workflow-subagent"
  end

  # sidequest shares the workflow-subagent ROLE — two identities, one
  # role : the grouping RBAC exists for.
  policy "RosterAssignSidequest" do
    on "BootCompleted"
    trigger "RoleAssignment.Assign"
    with "auth_identity_id", "sidequest"
    with "role_name", "workflow-subagent"
  end

  # ── pr-agent grants (upsert on Policy id) ─────────────────────

  policy "RosterPermitPrAgentTools" do
    on "BootCompleted"
    trigger "Policy.Permit"
    with "id", "roster-pr-agent-tools"
    with "principal", "pr-agent"
    with "action", "Tools::*"
    with "resource", "*"
    with "condition", "-"
    with "expires_at", "-"
  end

  policy "RosterForbidPrAgentAuthz" do
    on "BootCompleted"
    trigger "Policy.Forbid"
    with "id", "roster-pr-agent-no-authz"
    with "principal", "pr-agent"
    with "action", "Authorization::*"
    with "resource", "*"
    with "condition", "-"
    with "expires_at", "-"
  end

  policy "RosterForbidPrAgentGovernance" do
    on "BootCompleted"
    trigger "Policy.Forbid"
    with "id", "roster-pr-agent-no-governance"
    with "principal", "pr-agent"
    with "action", "Governance::*"
    with "resource", "*"
    with "condition", "-"
    with "expires_at", "-"
  end

  # ── workflow-subagent grants (cover sidequest too, by role) ──────

  policy "RosterPermitWorkflowSubagentTools" do
    on "BootCompleted"
    trigger "Policy.Permit"
    with "id", "roster-workflow-subagent-tools"
    with "principal", "workflow-subagent"
    with "action", "Tools::*"
    with "resource", "*"
    with "condition", "-"
    with "expires_at", "-"
  end

  policy "RosterForbidWorkflowSubagentAuthz" do
    on "BootCompleted"
    trigger "Policy.Forbid"
    with "id", "roster-workflow-subagent-no-authz"
    with "principal", "workflow-subagent"
    with "action", "Authorization::*"
    with "resource", "*"
    with "condition", "-"
    with "expires_at", "-"
  end

  policy "RosterForbidWorkflowSubagentGovernance" do
    on "BootCompleted"
    trigger "Policy.Forbid"
    with "id", "roster-workflow-subagent-no-governance"
    with "principal", "workflow-subagent"
    with "action", "Governance::*"
    with "resource", "*"
    with "condition", "-"
    with "expires_at", "-"
  end
end
