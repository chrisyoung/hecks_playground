Hecks.behavior_kind "perform_exec" do
  # The perform_exec behavior — what the kernel does when an :exec
  # adapter fires. Sibling to perform_web_fetch (:web_tool) and
  # invoke_claude_tool (:claude_tool). The kernel hook is one of the
  # small fixed set of runtime primitives the framework ships.
  #
  # The dispatch flow :
  #
  #   1. The bus dispatches the bound command (e.g. Inbox.Check).
  #   2. The kernel resolves the matching :exec adapter
  #      (one with command: "Inbox.Check").
  #   3. The kernel reads the adapter's :exec field
  #      ("node bin/inbox_poll.mjs") and runs it to completion with
  #      cwd = the parent of the dispatched aggregates root, the same
  #      working dir the overmind loop uses, so relative paths in the
  #      exec resolve identically whether the loop or a manual
  #      storehouse__dispatch fired it.
  #   4. The kernel captures stdout + stderr + exit code. stdout is
  #      capped at 100 KB so one dispatch cannot blow up downstream
  #      state (same cap as perform_web_fetch).
  #   5. The kernel routes the result into :result_into as a follow-on
  #      dispatch carrying output (stdout, tail of stderr on failure),
  #      exit_code, and ok (true iff exit_code == 0).
  #
  # No URL safety / no network rules (that is perform_web_fetch's
  # concern). :exec trusts its :exec because the :exec string is
  # author-controlled in a committed hecksagon, never attacker-supplied
  # — exactly the trust model :claude_tool's bash primitive has.

  vision "Run the bound :exec adapter's :exec program to completion
          and return (stdout, exit_code, ok). cwd is the aggregates
          root's parent. stdout capped at 100 KB ; on non-zero exit
          the captured stderr tail rides in output so the failure is
          legible in the Cascade record. Synchronous in v1 ; a repeat
          dispatch for the same id runs sequentially."

  # Every adapter family that picks this behavior must name the
  # follow-on dispatch target. The :exec travels on the adapter
  # instance, not the command attrs (unlike perform_web_fetch's :url,
  # per-dispatch input — an exec binding is fixed at declaration).
  requires_field :result_into

  # :description is the always-present captionable attribute on the
  # dispatched command — same convention as invoke_claude_tool /
  # perform_web_fetch. The exec takes no per-dispatch attrs in v1 ;
  # the bound program reads its own state (Inbox.Check's poller reads
  # the historyId watermark + correspondent registry itself).
  trigger_attribute :description

  # What the kernel does, declaratively :
  #   1. Resolve the :exec adapter for the dispatched command.
  #   2. Split :exec into program + args ; run with cwd =
  #      aggregates-root-parent ; inherit the process env.
  #   3. Capture stdout + stderr ; cap stdout at 100 KB, append
  #      "... [truncated]" if over.
  #   4. Dispatch :result_into with output, exit_code, ok
  #      (true iff exit_code == 0). A non-zero exit is recorded,
  #      not raised — the Cascade record is the audit trail.
  #
  # Cancellation : v1 is synchronous, no in-flight supersession. The
  # overmind loop's --every cadence guarantees runs do not overlap so
  # long as the exec finishes within the interval ; an exec that runs
  # long is the bound program's bug to fix, not the kernel's to police.
end
