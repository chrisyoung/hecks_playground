Hecks.behavior_kind "render_text_to_audio" do
  # The render_text_to_audio behavior — what the kernel does when a
  # :tts (or any future) adapter fires. The kernel hook for this behavior
  # is one of the small, fixed set of runtime primitives the framework
  # ships : take a text string + a provider config, render audio bytes,
  # optionally cache, optionally play.
  #
  # Adapter families that pick this behavior_kind plug into the same
  # kernel hook. :tts uses it ; a future :voice_clone_render or
  # :speech_synthesis would too.

  vision "Convert a text string into audio bytes via a provider. The kernel
          hook accepts (text, provider_config, instance_fields) and returns
          (audio_bytes, file_path_if_cached). Cancellation : a new render
          for the same instance supersedes any in-flight render."

  # The contract : every adapter family that picks this behavior_kind must
  # provide a `:provider` field and a `:trigger_on` field. The trigger
  # command must carry a :text attribute (the text to render).

  requires_field :provider
  requires_field :trigger_on

  trigger_attribute :text   # the dispatched command's :text attr is the input

  # What the kernel does, declaratively :
  #   1. Resolve the named provider for this family
  #   2. Hand the provider (text, instance_fields) and let it render
  #   3. If provider declares cache_into, write the audio to the path
  #   4. If provider declares play_after_cache + the instance's auto_play
  #      field is true, fork an audio playback subprocess
  #   5. Cancellation : if a prior render for the same instance is still
  #      in flight, kill it before starting the new one
  cancellation :supersede_prior_per_instance
end
