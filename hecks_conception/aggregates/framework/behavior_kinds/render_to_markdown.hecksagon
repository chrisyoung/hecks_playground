Hecks.behavior_kind "render_to_markdown" do
  # The render_to_markdown behavior — what the kernel does when a :report
  # (or any future) adapter fires. One of the small fixed set of runtime
  # primitives : run a query, take its result records, emit a markdown
  # string (a table / list of the records), generic over the aggregate.
  # The data's meaning is the records ; markdown is one projection of them
  # — a terminal renders it raw, an app as HTML, the turn as additionalContext.
  #
  # Adapter families that pick this behavior_kind plug into the same kernel
  # hook. The rendered markdown chains to :result_into as a follow-on
  # dispatch (typically AiSession.Inject), the same result_into chaining
  # the tool adapters use.

  vision "Render a query result as markdown. The kernel hook accepts
          (query_verb, result_records, instance_fields) and returns a
          markdown string — generic over the aggregate, no per-aggregate
          layout (presentation is not domain). The string chains to
          :result_into. This is the f4 cut : declared here, the kernel
          arm is projected from this contract, not hand-written."

  # The contract : every adapter family that picks this behavior_kind must
  # provide a :query (what to render) and a :result_into (where the
  # markdown goes as a follow-on dispatch).
  requires_field :query
  requires_field :result_into

  trigger_attribute :id   # the triggering event's id is the input handle
end
