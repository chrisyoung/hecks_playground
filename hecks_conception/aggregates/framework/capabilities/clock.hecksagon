Hecks.capability "clock" do
  # The Clock capability — the runtime's portable "what time is it now".
  #
  # Conceived 2026-05-18 (i639) after Chris reframed the i630 VinDiction
  # worker fix : routing dispatch-path SystemTime::now() through a
  # hand-written kernel helper is a bluebook-first confession. The clock
  # is a DOMAIN PRIMITIVE, not ambient kernel plumbing. This declaration
  # is the contract ; the runtime_shape projection + the ban validator
  # are the remaining i639 arc.
  #
  # Unlike :exec / :mcp / :tts (TRIGGERED adapter families that fire
  # AFTER a matching dispatch), the clock is an INLINE primitive : the
  # runtime calls it to build the invocation-id of the dispatch in
  # progress. So it is a capability/port with two target-bound adapters,
  # NOT a trigger adapter family and NOT an external provider.

  vision "Portable monotonic-epoch clock. One contract, two target
          adapters resolved at compile time by #[cfg(target_arch)] —
          the host binary and the wasm32 Cloudflare Worker share one
          emitted runtime/mod.rs, so the split MUST be #[cfg] in
          emitted code, never a specializer-time fork. Every dispatch
          touches this : invocation-id fallback, storehouse_log
          timestamps, interpreter RNG seed. Bypassing it with raw
          std::time::SystemTime::now() panics 'time not implemented'
          on wasm32 — that is the i630 bug class this capability exists
          to make structurally impossible."

  kind :substrate           # runtime substrate primitive (closed-set kind)

  # The port : one operation, returns a Duration since the unix epoch.
  operation :now_since_epoch, returns: "std::time::Duration"

  # The two target-bound adapters. Resolved by rustc via #[cfg], not by
  # the specializer (which emits ONE file for both targets).
  adapter :host,   cfg: 'not(target_arch = "wasm32")',
                   impl: "std::time::SystemTime::now()
                          .duration_since(std::time::SystemTime::UNIX_EPOCH)
                          .unwrap_or_default()"
  adapter :wasm32, cfg: 'target_arch = "wasm32"',
                   impl: "std::time::Duration::from_millis(
                          worker::Date::now().as_millis())"

  # Canonical implementation today : the hand-written #[cfg] helper.
  # i639 (b) makes runtime_shape snippets + interpreter::emit reference
  # THIS capability instead of the raw call or the ad-hoc helper ;
  # i639 (c) adds the validator that bans the raw bypass. Until then,
  # canonical_impl names where the contract is honoured.
  canonical_impl "crate::heki::now_duration"

  # The contract the projection + validator enforce :
  contract "No snippet under codegen/**/snippets/*.rs.frag and no
            hand-maintained kernel-floor file may call
            std::time::SystemTime::now() or Instant::now() directly.
            All wall-clock reads route through this capability's
            canonical_impl. heki::now_duration itself is the sole
            exception (it IS the host/wasm adapter bodies)."

  source "hecks_conception/aggregates/framework/capabilities/clock.hecksagon"
end
