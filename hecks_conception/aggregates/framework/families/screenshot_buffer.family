# screenshot_buffer — an impure-boundary PORT for the circular on-disk frame
# buffer that backs visual debugging. Declared once ; bound per domain in a
# .hecksagon (WebDebug binds it on Screenshot). Two-color rule : the DOMAIN is
# sync, the ADAPTER is async, and there is NEVER a lock — the frame write is an
# edge that LEAVES the domain.
#
# Signal is EFFECT (not reply) : the Screenshot aggregate EMITS FrameCaptured
# carrying the base64 JPEG bytes ; the adapter does the async disk IO — write
# frame_<id>.jpg, refresh latest.jpg, prune the oldest past `capacity` — and the
# written path RE-ENTERS the domain as a command (Screenshot.RecordStored). The
# whole round-trip rides ONE how-verb, `buffered_by`, hung off the aggregate FQN
# with its triggering event (`on:`). The frame bytes never touch the heki : they
# ride the event to the adapter and stop there, so persistence stays tiny.
#
# A family names its how-verb, its signal, and the config FIELDS its adapters
# need — NAMES only ; the per-deployment VALUES (where frames land, how many to
# keep) live in .world. The family NEVER names its adapters (the inverted arrow
# lives in .adapter).
Hecks.family "screenshot_buffer" do
  verb     "buffered_by"   # the how-verb the bind hangs off the aggregate FQN
  signal   :effect         # emit FrameCaptured ; the written-path verdict re-enters as a command
  field    :dir            # WHERE frames land ; value supplied in .world
  field    :capacity       # circular-buffer size ; the adapter prunes oldest past it
  produces :path           # the basename a conforming handler must emit on success
end
