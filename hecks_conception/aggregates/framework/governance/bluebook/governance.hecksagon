Hecks.hecksagon "Governance" do
  # Governance production wiring. The model (governance.bluebook)
  # stays pure ; this file is the override that gives the bus state
  # across dispatches — Propose, then Permit, then Activate must see
  # the same Policy. Absolute db path so the store resolves the same
  # regardless of the storehouse process cwd. Mirrors vindiction /
  # bin-buddy (i76). Tests ignore this file and run memory-only.
  #
  # heki, not sqlite : the prior `adapter :sqlite` was inert for its
  # whole life (governance.db never existed — governance ran on heki).
  # When :sqlite became real, this declaration started sqlite-ifying the
  # WHOLE combined conception (apply_sqlite_persistence is domain-wide)
  # and panicked on the first SQL-incompatible column. heki preserves
  # the actual behaviour (state across dispatches, file-backed). Re-enable
  # :sqlite once apply_sqlite_persistence is scoped to the declaring
  # hecksagon's own aggregates + create_table degrades gracefully.
  adapter :heki
end
