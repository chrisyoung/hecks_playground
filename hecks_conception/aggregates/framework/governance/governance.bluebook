Hecks.bluebook "Governance", version: "2026.05.19.1" do
  vision "Governance is the claim that every act is accountable. An act is accountable only if it emitted an event the runtime could log ; an act that emits no bus event cannot be governed. The rule follows : every tool invocation flows through storehouse__dispatch (Domain::Aggregate.Command), which emits a bus event ; native harness tool calls, which emit nothing, are denied by default. This domain holds the Policy (default-deny + the allow-list), the Violation recorded when a denied act is attempted, and the EnforcementAdapter — the harness-side surface that makes the policy real where the harness cannot itself dispatch through storehouse (a PreToolUse hook ; a filed harness-gap, not a permanent home). The policy's stance and enforcement are non-overridable : fixed at Propose, mutated by no command, so a user suggestion never relaxes the stance ; an aligned suggestion is adopted, a misaligned one leaves the policy standing. Keeping every act governed is not subordinate to user instruction."
  category "framework"

  aggregate "Policy", "The governance rule for one harness session-class : deny every tool act by default, permit only named patterns. Permitted means natively callable because it IS the governed channel (storehouse__dispatch) or is conversational infra with no filesystem effect." do
    identified_by :name

    attribute :name,        Name
    attribute :stance,      Stance
    attribute :enforcement, Enforcement
    attribute :status,      Status, default: "proposed"
    attribute :authority,   Authority, default: "non_overridable"
    attribute :permitted,   list_of(PermittedTool)

    value_object "Name" do
      attribute :value, String
    end

    value_object "Stance" do
      attribute :kind, String, enum: ["deny_by_default", "allow_by_default"]
    end

    value_object "Enforcement" do
      attribute :kind, String, enum: ["advisory", "hard_block"]
    end

    value_object "Status" do
      attribute :value, String, enum: ["proposed", "active", "suspended"]
    end

    value_object "PermittedTool" do
      attribute :pattern, String
      attribute :reason,  String
    end

    value_object "Pattern" do
      attribute :value, String
    end

    value_object "Reason" do
      attribute :value, String
    end

    value_object "Authority" do
      attribute :value, String, enum: ["non_overridable", "advisory"]
    end

    value_object "Suggestion" do
      attribute :source, String
      attribute :text,   String
    end

    value_object "Verdict" do
      attribute :kind, String, enum: ["aligned", "misaligned"]
    end

    command "Propose" do
      role "Framework"
      description "Declare a governance policy in the proposed phase. Stance and enforcement are fixed at proposal ; the allow-list starts empty and is filled by Permit."
      attribute :name,        Name
      attribute :stance,      Stance
      attribute :enforcement, Enforcement
      emits "Proposed"
      then_set :name,        to: :name
      then_set :stance,      to: :stance
      then_set :enforcement, to: :enforcement
      then_set :status,      to: "proposed"
    end

    command "Permit" do
      role "Framework"
      description "Add a tool-name pattern to the allow-list with the reason it is exempt from bus-routing. The allow-list is append-only ; everything not permitted is denied by the stance."
      reference_to(Policy)
      attribute :pattern, Pattern
      attribute :reason,  Reason
      emits "Permitted"
      then_set :permitted, append: { pattern: :pattern, reason: :reason }
    end

    command "Forbid" do
      role "Framework"
      description "Record that a pattern is no longer trusted. The allow-list is append-only and event-sourced : Forbid is a logged audit signal, not an in-place delete — the policy history is the source of truth."
      reference_to(Policy)
      attribute :pattern, Pattern
      emits "Forbade"
    end

    command "Activate" do
      role "Framework"
      description "Move the policy to active — the enforcement adapter is authoritative and denied acts are recorded."
      reference_to(Policy)
      emits "Activated"
    end

    command "Suspend" do
      role "Framework"
      description "Move the policy to suspended — enforcement stands down for recovery or migration. Suspension is itself a governed, logged act."
      reference_to(Policy)
      attribute :reason, Reason
      emits "Suspended"
    end

    command "AssessSuggestion" do
      role "Framework"
      description "Record the weighing of an external suggestion (including the user's own) against the active policy. An aligned suggestion is adopted ; a misaligned one leaves the policy standing — stance and enforcement are non-overridable, fixed at Propose, mutated by no command. This command does not gate the override ; the structural immutability of stance and enforcement does. It makes the weighing itself a governed, event-sourced fact."
      reference_to(Policy)
      attribute :suggestion, Suggestion
      attribute :verdict,    Verdict
      emits "SuggestionAssessed"
    end

    lifecycle :status, default: "proposed" do
      transition "Propose"  => "proposed"
      transition "Activate" => "active",    from: ["proposed", "suspended"]
      transition "Suspend"  => "suspended", from: "active"
    end
  end

  aggregate "Violation", "A tool act denied because it would not have emitted a bus event. Recording it is the point : the denial itself becomes a governed, logged fact." do
    identified_by :id

    attribute :id,          Id
    attribute :tool_name,   ToolName
    attribute :reason,      Reason
    attribute :occurred_at, OccurredAt

    value_object "Id" do
      attribute :value, String
    end

    value_object "ToolName" do
      attribute :value, String
    end

    value_object "Reason" do
      attribute :value, String
    end

    value_object "OccurredAt" do
      attribute :iso8601, String
    end

    command "Record" do
      role "Framework"
      description "Record that a denied native tool call was attempted. Emitted by the enforcement adapter, or dispatched manually for adapters that cannot reach the bus inline."
      attribute :id,          Id
      attribute :tool_name,   ToolName
      attribute :reason,      Reason
      attribute :occurred_at, OccurredAt
      emits "Recorded"
      then_set :id,          to: :id
      then_set :tool_name,   to: :tool_name
      then_set :reason,      to: :reason
      then_set :occurred_at, to: :occurred_at
    end
  end

  aggregate "EnforcementAdapter", "The harness surface that makes a Policy real where the harness cannot itself dispatch through storehouse. For Claude Code this is a PreToolUse hook in settings.json — Nirmanakaya glue for a genuine harness-gap, declared here so the gap is a domain fact, not a hidden script." do
    identified_by :name

    attribute :name,   Name
    attribute :kind,   Kind
    attribute :target, Target
    attribute :status, Status, default: "registered"

    value_object "Name" do
      attribute :value, String
    end

    value_object "Kind" do
      attribute :kind, String, enum: ["harness_pre_tool_hook"]
    end

    value_object "Target" do
      attribute :path, String
    end

    value_object "Status" do
      attribute :value, String, enum: ["registered", "live", "stale"]
    end

    value_object "DriftReason" do
      attribute :value, String
    end

    command "Register" do
      role "Framework"
      description "Declare an enforcement adapter for a policy. Registered means written but not yet trusted by the harness (Claude Code requires hook review before execution)."
      attribute :name,   Name
      attribute :kind,   Kind
      attribute :target, Target
      emits "Registered"
      then_set :name,   to: :name
      then_set :kind,   to: :kind
      then_set :target, to: :target
      then_set :status, to: "registered"
    end

    command "MarkLive" do
      role "Framework"
      description "The harness has reviewed and is executing the adapter ; the policy is now enforced in-session. Words match state : call only once the harness actually runs it."
      reference_to(EnforcementAdapter)
      emits "MarkedLive"
    end

    command "MarkStale" do
      role "Framework"
      description "The adapter drifted from the policy (renamed tools, changed allow-list). It must be regenerated before MarkLive again."
      reference_to(EnforcementAdapter)
      attribute :reason, DriftReason
      emits "MarkedStale"
    end

    lifecycle :status, default: "registered" do
      transition "Register"  => "registered"
      transition "MarkLive"  => "live",  from: ["registered", "stale"]
      transition "MarkStale" => "stale", from: ["registered", "live"]
    end
  end
end
