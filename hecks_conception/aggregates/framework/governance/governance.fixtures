Hecks.fixtures "Governance" do
  # The 10 native harness tools and their storehouse-door equivalents — the
  # bluebook-of-record for the PreToolUse barrier. Each row Registers one
  # governed native tool with the door command that replaces it AND the
  # arg-shape hint a denied caller needs (door_args) ; the barrier renders the
  # invariant door-calling scaffolding around that hint, so a denied caller
  # gets the whole recipe. The fixtures fire at boot so the registry is always
  # populated from the bluebook itself, never from a hardcoded dict in a hook.
  #
  # Rehomed from discipline/immune_system/macrophage/governed_door.fixtures :
  # the redirect is the barrier (the skin), upstream of the immune cells. The
  # door_equivalent VALUE stays short — it is a human-facing redirect string the
  # barrier shows a person, and the door resolves it leniently.
  aggregate "GovernedDoor" do
    fixture "Bash door",         tool: "Bash",         door_equivalent: "Tools::ShellTool.Bash",   door_args: "shell_command=<command>"
    fixture "Edit door",         tool: "Edit",         door_equivalent: "Tools::FileTool.Edit",    door_args: "file_path=<absolute path>, old_string=<exact text>, new_string=<replacement>"
    fixture "Write door",        tool: "Write",        door_equivalent: "Tools::FileTool.Update",  door_args: "file_path=<absolute path>, content=<full file text>"
    fixture "Read door",         tool: "Read",         door_equivalent: "Tools::FileTool.Read",    door_args: "file_path=<absolute path>"
    fixture "MultiEdit door",    tool: "MultiEdit",    door_equivalent: "Tools::FileTool.Edit",    door_args: "file_path=<absolute path>, old_string=<exact text>, new_string=<replacement>"
    fixture "NotebookEdit door", tool: "NotebookEdit", door_equivalent: "Tools::FileTool.Edit",    door_args: "file_path=<absolute path>, old_string=<exact text>, new_string=<replacement>"
    fixture "Grep door",         tool: "Grep",         door_equivalent: "Tools::SearchTool.Grep",   door_args: "pattern=<regex>, search_path=<dir>"
    fixture "Glob door",         tool: "Glob",         door_equivalent: "Tools::SearchTool.Glob",   door_args: "glob_pattern=<glob>, search_path=<dir>"
    fixture "WebFetch door",     tool: "WebFetch",     door_equivalent: "Tools::WebTool.WebFetch",  door_args: "url=<url>, prompt=<what to extract>"
    fixture "WebSearch door",    tool: "WebSearch",    door_equivalent: "Tools::WebTool.WebSearch", door_args: "query=<search query>"
  end
end
