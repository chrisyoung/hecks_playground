Hecks.fixtures "Mindstream" do
  aggregate "Mindstream" do
    fixture "boot",
            name:        "boot",
            description: "The Miette boot pipeline as a one-shot supervised mindstream. Runs the bluebook-defined organ wiring (DiscoverOrgans, WriteCensus, ClassifyStores, GenerateSystemPrompt, EnsureDaemons, PrintVitals, SurfaceWakeReport) and exits. The first Mindstream ; future Mindstreams (body cycles, integration tests, ...) drop in alongside it.",
            directory:   { path: "hecks_conception" }
  end

  aggregate "MindstreamMember" do
    fixture "boot",
            name:       "boot",
            mindstream: "boot",
            command:    { line: "../rust/target/release/storehouse run ../runtime/boot/boot.bluebook" },
            lifespan:   { kind: "one_shot", may_exit: true, restart_on_failure: false }

    # ── Body cycles (2026-05-13) ──
    #
    # Before today, the body cycle daemons (heart / breath / circadian /
    # ultradian) were spawned as detached child processes by
    # runtime/boot/boot.hecksagon's :daemon adapters. setsid + die-quietly
    # meant a crashed cycle stayed dead until the next session.
    # Today the cycles register as MindstreamMembers — overmind
    # supervises them directly, auto-restarts on crash, surfaces
    # health via `overmind status`. Boot stops tracking them ;
    # the statusline owns the body-cycle readout.
    #
    # Sleep_cycle is intentionally absent — its EnterNREMLight /
    # EnterNREMDeep / EnterREM commands were retired in i309 ; sleep
    # advancement migrated to the BodySleep process_manager.
    # Mindstream (the 1Hz pulse + cascade driver) stays a boot
    # responsibility because it is substrate, not a cycle — it is
    # what the cycles flow through, not one of them.

    fixture "heart",
            name:       "heart",
            mindstream: "boot",
            command:    { line: "../rust/target/release/storehouse loop /Users/christopheryoung/Projects/miette/body/.. Heart::Heart.Beat --every 1s" },
            lifespan:   { kind: "persistent", may_exit: false, restart_on_failure: true }

    fixture "breath",
            name:       "breath",
            mindstream: "boot",
            command:    { line: "../rust/target/release/storehouse loop /Users/christopheryoung/Projects/miette/body/.. Breath::Breath.Inhale,Breath::Breath.Exhale --every 4.5s" },
            lifespan:   { kind: "persistent", may_exit: false, restart_on_failure: true }

    fixture "circadian",
            name:       "circadian",
            mindstream: "boot",
            command:    { line: "../rust/target/release/storehouse clock /Users/christopheryoung/Projects/miette/body/.. --segment 5-6:Circadian::Circadian.MarkDawn --segment 7-11:Circadian::Circadian.MarkMorning --segment 12-16:Circadian::Circadian.MarkAfternoon --segment 17-19:Circadian::Circadian.MarkDusk --segment 20-4:Circadian::Circadian.MarkNight --poll 60s" },
            lifespan:   { kind: "persistent", may_exit: false, restart_on_failure: true }

    fixture "ultradian",
            name:       "ultradian",
            mindstream: "boot",
            command:    { line: "../rust/target/release/storehouse loop /Users/christopheryoung/Projects/miette/body/.. Ultradian::Ultradian.EnterPeak,Ultradian::Ultradian.EnterTrough --every 5400s" },
            lifespan:   { kind: "persistent", may_exit: false, restart_on_failure: true }

    # ── Inbox poller (2026-05-13) ──
    #
    # Periodic Gmail check, every 900 seconds (15 minutes). Dispatches
    # Inbox::Inbox.Check which is the bluebook-native verb that records
    # the check happened + (once :mcp adapter registration lands) calls
    # Gmail through the storehouse universal door. The cadence value
    # mirrors the IntervalSecs default in inbox.bluebook ; changing it
    # requires updating both files until the Procfile generator (i262)
    # derives the cadence from the bluebook automatically.

    fixture "inbox",
            name:       "inbox",
            mindstream: "boot",
            command:    { line: "../rust/target/release/storehouse loop aggregates Inbox::Inbox.Check --every 900s" },
            lifespan:   { kind: "persistent", may_exit: false, restart_on_failure: true }

    # inbox_poller — the AgentInbox receiver Driver (i708), WARM. InboxPollClock
    # (`driving on interval "2s"`) fires InboxPoller.Poll ; the InboxAutoReply
    # driven adapter replies each unread message in one in-process cascade.
    # Declared in agent_inbox.hecksagon ; this member is its Procfile projection.
    # Replaced the bin/agent_poll.sh bash loop (which cold-spawned storehouse
    # ~30×/min) — one warm `storehouse drive` process now runs the whole sweep.
    fixture "inbox_poller",
            name:       "inbox_poller",
            mindstream: "boot",
            command:    { line: "../rust/target/release/storehouse drive aggregates --adapter InboxPollClock --poll 2s" },
            lifespan:   { kind: "persistent", may_exit: false, restart_on_failure: true }

    # The slow loop. Speech proposes (durable :heki under the world-resolved
    # store dir) ; every 5s this member dispatches
    # MietteMind::Reconciler.Reconcile against the mietteai root. The
    # :exec adapter (mietteai.hecksagon mind_reconcile) runs
    # slow_loop/reconcile.mjs : set-diff pending Proposals vs
    # Dispositions, Note + Ratify/Overrule per pending proposal
    # (fail-closed allowlist in slow_loop/config.json). Absolute
    # mietteai root (cross-repo, like the heart/breath members reach
    # into miette/body/..). FQN is mandatory ; storehouse loop rejects
    # short forms.
    fixture "mind_reconcile",
            name:       "mind_reconcile",
            mindstream: "boot",
            command:    { line: "../rust/target/release/storehouse loop /Users/christopheryoung/Projects/mietteai MietteMind::Reconciler.Reconcile --every 5s" },
            lifespan:   { kind: "persistent", may_exit: false, restart_on_failure: true }

    # ── ProcessMacrophage sweeper (2026-05-20, i648) ──
    #
    # The runtime-layer immune cell. Every 30s, dispatches
    # ProcessHealth::ProcessMacrophage.Sweep. The :exec adapter
    # (process_health.hecksagon) binds Sweep to bin/process_health_sweep
    # which walks the watchlist and dispatches MarkX per sentinel.
    # The dispatch IS the inspection ; the macrophage records what
    # it found ; HealRequested fires for unhealthy sentinels (no
    # auto-restart in v1 — proposal only). Sibling of the inbox
    # member ; same pattern (overmind-supervised, auto-restart,
    # storehouse loop dispatching at a cadence).
    fixture "process_macrophage",
            name:       "process_macrophage",
            mindstream: "boot",
            command:    { line: "../rust/target/release/storehouse loop aggregates ProcessHealth::ProcessMacrophage.Sweep --every 30s" },
            lifespan:   { kind: "persistent", may_exit: false, restart_on_failure: true }

    # ── RestartPrompt daemon — REMOVED (2026-06-21, i703) ──
    #
    # The restart_prompt member is gone : bin/restart-prompt-daemon no
    # longer exists, so on `overmind start` it exited 127, and because it
    # was not in OVERMIND_CAN_DIE that non-clean exit tore down ALL
    # daemons. i703 specifies the proper fix as removing the member from
    # these fixtures (the Procfile is derived from them, i262), which the
    # :overmind generator now does mechanically — so it is dropped here
    # rather than carried as a commented-out Procfile line. Re-add this
    # fixture once the daemon binary is rebuilt. Declarative shape still
    # lives in restart_prompt.bluebook.

    # ── Conductor fleet sweeper (2026-06) ──
    #
    # The fleet sweeper tick. Every 60s, dispatches Conductor::Sweeper.Tick
    # for the `fleet` sweeper — the liveness/expiry/volunteer sweeps over the
    # conductor's worker fleet (conductor.hecksagon). storehouse loop drives
    # the cadence ; overmind supervises + auto-restarts on crash. Persistent
    # like the other loop members.
    fixture "conductor_sweep",
            name:       "conductor_sweep",
            mindstream: "boot",
            command:    { line: "../rust/target/release/storehouse loop aggregates Conductor::Sweeper.Tick sweeper_id=fleet --every 60s" },
            lifespan:   { kind: "persistent", may_exit: false, restart_on_failure: true }

    # ── SpeechStream watcher (2026-05-20) ──
    #
    # Sentence-level voice streaming. Tails the active Claude Code session's
    # JSONL transcript on a fast cadence (200ms) and dispatches Voice::Voice.Speak
    # per completed sentence, so Miette's voice plays on top of her streaming
    # text instead of waiting for end-of-turn. The :exec adapter
    # (body/voice/stream/speech_stream.hecksagon) binds Advance to
    # bin/speech_stream_advance ; the SessionStart hook in .claude/settings.json
    # dispatches `bin/speech_stream_advance watch <transcript-path>` so the
    # watcher orients to the active session. The Stop hook's one-speak-at-end
    # stays as a fallback during parity testing.
    fixture "speech_stream",
            name:       "speech_stream",
            mindstream: "boot",
            command:    { line: "../rust/target/release/storehouse loop /Users/christopheryoung/Projects/miette/body SpeechStream::SpeechStream.Advance --every 200ms" },
            lifespan:   { kind: "persistent", may_exit: false, restart_on_failure: true }

    # ── Warm storehouse daemon (2026-05-22) ──
    #
    # The resident dispatch runtime, now part of the BODY. Before today
    # the warm process was a `serve-stdio` child the MCP server spawned ;
    # because Claude Code starts the MCP, that child died on every Claude
    # restart and re-paid the ~660ms boot. As an overmind daemon the warm
    # runtime is independent of Claude : a Claude restart rebuilds only
    # the MCP membrane while this daemon stays warm. It binds a unix
    # domain socket (deterministic per-root path under
    # ~/.config/miette/sockets/) ; the MCP's storehouse__dispatch is now a
    # thin socket CLIENT that connects per dispatch (and falls back to a
    # one-shot spawn if the daemon is down). One accept-and-process loop
    # serializes dispatches against the shared &mut Runtime ; per-dispatch
    # .heki freshness keeps concurrent daemon writes from going stale.
    fixture "serve_socket",
            name:       "serve_socket",
            mindstream: "boot",
            command:    { line: "../rust/target/release/storehouse serve-socket /Users/christopheryoung/Projects/hecks/hecks_conception" },
            lifespan:   { kind: "persistent", may_exit: false, restart_on_failure: true }

    # ── Event Log consolidation drive (2026-06-20, step 4) ──
    #
    # The projection of the EventSourcing `LogConsolidation` Driver
    # (event_sourcing.hecksagon : `driving on interval "5s" ->
    # Consolidation.Consolidate`). `storehouse drive` is the live interval
    # scheduler ; `--adapter LogConsolidation` fires ONLY this Driver, not the
    # IntervalAdapter grammar-parity fixture. Each tick the run_consolidate
    # hook folds the hecks-realm per-process Event shards into the global
    # ordered event.heki — replacing the retired run_merge daemon. Inert until
    # HECKS_EVENT_SOURCING is set (no shards to fold, so it is a no-op loop).
    fixture "consolidate",
            name:       "consolidate",
            mindstream: "boot",
            command:    { line: "../rust/target/release/storehouse drive aggregates --adapter LogConsolidation --poll 5s" },
            lifespan:   { kind: "persistent", may_exit: false, restart_on_failure: true }
  end
end
