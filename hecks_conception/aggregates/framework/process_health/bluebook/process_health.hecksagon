Hecks.hecksagon "ProcessHealth" do
  uses_framework "Governance"
  ProcessHealth::ProcessSentinel.persisted_by("Heki")
  ProcessHealth::ProcessMacrophage.persisted_by("Heki")

  # ── Impure edges, hecksagon-first (2026-06-28) ───────────────────
  # Re-expressed (i780, 2026-08-17) from the retired `adapter :exec` kwargs
  # form onto the spawn effect port. TWO adapters subscribe to the SAME
  # Swept event — the runtime records one OutboundEvent per subscriber
  # (OutboundEvent.Record's own documented "one Record per subscribing
  # adapter" fan-out), so both fire independently off one dispatch.
  #
  # The runaway reaper : when ProcessMacrophage.Sweep completes, run
  # bin/process_health_reap (kills orphaned Tools::ShellTool.Bash dispatch
  # children that spin past runaway_after_seconds — the gap the liveness sweep
  # is blind to).
  ProcessHealth::ProcessMacrophage.spawned_by("ProcessHealthReap", on: "Swept") do
    success "Cascade::Cascade.RecordResult"
    failure "Cascade::Cascade.RecordResult"
  end

  # The liveness probe : on Sweep, walk the watchlist via overmind status and
  # MarkAlive | MarkHanged | MarkDead each ProcessSentinel.
  ProcessHealth::ProcessMacrophage.spawned_by("ProcessHealthSweep", on: "Swept") do
    success "Cascade::Cascade.RecordResult"
    failure "Cascade::Cascade.RecordResult"
  end

  # The healer : on Heal, restart dead sentinels via overmind (or restart the
  # supervisor itself).
  ProcessHealth::ProcessMacrophage.spawned_by("ProcessHealthHeal", on: "HealRequested") do
    success "Cascade::Cascade.RecordResult"
    failure "Cascade::Cascade.RecordResult"
  end
end
