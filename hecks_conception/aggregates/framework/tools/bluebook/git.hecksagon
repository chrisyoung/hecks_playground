Hecks.hecksagon "Git" do
  uses_framework "Governance"
  # Impure edges, hecksagon-first : each Git.X command runs its git script and
  # cascades the output into RecordResult. Re-expressed (i780, 2026-08-17)
  # from the retired `adapter :exec` kwargs form onto the spawn effect port —
  # see fibroblast.hecksagon for the pattern this mirrors. Sprint 7
  # done-is-done gates consume Git.CurrentBranch + Git.WorktreeList to
  # self-verify.

  adapter :memory

  Git::Git.spawned_by("GitStatus", on: "StatusChecked") do
    success "Cascade::Cascade.RecordResult"
    failure "Cascade::Cascade.RecordResult"
  end
  Git::Git.spawned_by("GitLog", on: "LogRead") do
    success "Cascade::Cascade.RecordResult"
    failure "Cascade::Cascade.RecordResult"
  end
  Git::Git.spawned_by("GitDiff", on: "DiffRead") do
    success "Cascade::Cascade.RecordResult"
    failure "Cascade::Cascade.RecordResult"
  end
  Git::Git.spawned_by("GitCurrentBranch", on: "CurrentBranchRead") do
    success "Cascade::Cascade.RecordResult"
    failure "Cascade::Cascade.RecordResult"
  end
  Git::Git.spawned_by("GitWorktreeList", on: "WorktreeListRead") do
    success "Cascade::Cascade.RecordResult"
    failure "Cascade::Cascade.RecordResult"
  end
end
