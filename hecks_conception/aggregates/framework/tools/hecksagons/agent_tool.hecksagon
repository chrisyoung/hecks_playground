Hecks.hecksagon "AgentToolAdapter" do
  # ============================================================
  # AGENT TOOL ADAPTER (sendmessage-on-bus, i708)
  # ============================================================
  #
  # Tools::AgentTool.SendMessage is wired to the REAL messaging substrate
  # (agent_inbox.bluebook + adapters/agent/send-message bin). The flow :
  #
  #   1. Caller dispatches Tools::AgentTool.SendMessage (records the tool
  #      invocation on the AgentTool aggregate, emits AgentMessageSent).
  #   2. The actual message is delivered via the standalone send-message
  #      binary (adapters/agent/send-message) which callers invoke directly
  #      with --root <dir> <agent_id> <body>. The bin dispatches
  #      AgentInbox::AgentMessage.Send, block-polls Answered(id=<cid>) for
  #      the reply, and prints it on stdout.
  #   3. The target agent runs bin/agent_poll.sh which polls Unread(
  #      agent_id), MarkReads each, and Replies.
  #
  # ── `driven on` grammar not yet live in the runtime ──
  #
  # The `driven on "Event"` subscription form (shell_adapter.hecksagon
  # precedent) is DECLARED here but not auto-fired by the runtime as of
  # i708 completion. The bus does not yet register `driven on` subscriptions
  # and call the body on event emit. That wiring lives in rust/src (kernel-
  # floor — the runtime must recognise the DrivenAdapter IR and register a
  # subscription). When that lands, the canned dispatch below becomes the
  # real AgentInbox::AgentMessage.Send relay and the standalone bin path
  # can be retired.
  #
  # For now : call the bin directly. The bluebook contract does not change
  # when the grammar lands ; only the substrate behind this stub changes.

  adapter "AgentToolAdapter" do
    driven on "Tools::AgentTool.AgentMessageSent" do |event|
      # TODO: when `driven on` grammar fires — replace this canned stub with:
      #   dispatch "AgentInbox::AgentMessage.Send",
      #            id: event.id, agent_id: event.to, body: event.message, mid: event.id
      # The send-message binary provides the synchronous face in the meantime.
      dispatch "Tools::Cascade.RecordResult",
               id: event.id,
               tool: "agent_resume",
               output: "agent resumed",
               exit_code: 0,
               ok: true
    end
  end
end
