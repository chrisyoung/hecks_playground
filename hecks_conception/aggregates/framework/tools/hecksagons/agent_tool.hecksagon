Hecks.hecksagon "AgentToolAdapter" do
  # ============================================================
  # AGENT TOOL ADAPTER (sendmessage-on-bus, i708)
  # ============================================================
  #
  # Tools::AgentTool.SendMessage is wired to the REAL messaging substrate
  # (agent_inbox.bluebook + adapters/agent/send-message bin). The flow :
  #
  #   1. Caller dispatches Tools::AgentTool.SendMessage (records the tool
  #      invocation on the AgentTool aggregate, emits AgentMessageSent).
  #   2. The actual message is delivered via the standalone send-message
  #      binary (adapters/agent/send-message) which callers invoke directly
  #      with --root <dir> <agent_id> <body>. The bin dispatches
  #      AgentInbox::AgentMessage.Send, block-polls Answered(id=<cid>) for
  #      the reply, and prints it on stdout.
  #   3. The receiver is the warm InboxPollClock Driver (storehouse drive,
  #      agent_inbox.hecksagon) : it fires InboxPoller.Poll every 2s and the
  #      InboxAutoReply driven adapter replies each unread message in-process.
  #
  # ── `driven on` grammar IS live ; this stub's relay is a follow-on ──
  #
  # The `driven on "Event"` subscription form fires live now — the runtime
  # recognises the DrivenAdapter IR and calls the body on event emit
  # (InboxAutoReply + the conductor LivenessSweep are live proofs). So the
  # canned dispatch below CAN become the real AgentInbox::AgentMessage.Send
  # relay, retiring the standalone send-message bin path. That swap is a
  # tracked follow-on (a behaviour change needing its own verification), not
  # done here ; the send-message binary remains the synchronous face meanwhile.
  # The bluebook contract does not change when the relay lands ; only the
  # substrate behind this stub does.

  adapter "AgentToolAdapter" do
    driven on "Tools::AgentTool.AgentMessageSent" do |event|
      # TODO: when `driven on` grammar fires — replace this canned stub with:
      #   dispatch "AgentInbox::AgentMessage.Send",
      #            with: { id: "{id}", agent_id: "{to}", body: "{message}", mid: "{id}" }
      # The send-message binary provides the synchronous face in the meantime.
      #
      # i787: migrated off the block-arg `event.id` form — the runtime's
      # DrivenCapture takes declarative `with:` kwargs and `{field}`
      # interpolation, so `event.id` raised NoMethodError at LOAD time and
      # made this whole file unloadable.
      dispatch "Cascade::Cascade.RecordResult",
               with: {
                 id: "{id}",
                 tool: "agent_resume",
                 output: "agent resumed",
                 exit_code: 0,
                 ok: true
               }
    end
  end
end
