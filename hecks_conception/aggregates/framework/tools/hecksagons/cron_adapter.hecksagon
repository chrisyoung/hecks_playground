Hecks.hecksagon "CronAdapter" do
  # ============================================================
  # CRON ADAPTER (sprint 14 — driving-on-grammar story)
  # ============================================================
  #
  # Sibling of shell_adapter.hecksagon. Where ShellAdapter
  # subscribes to a BUS EVENT (driven on), CronAdapter subscribes to
  # an EXTERNAL TRIGGER (driving on cron). The live `storehouse drive`
  # daemon EVALUATES this 5-field expression and fires the declared
  # dispatch only WHEN DUE (minute 0,5,10,... of every hour for
  # "*/5 * * * *"), deduped to at most once per minute. The
  # behaviors-test path still fires it on `kind: :driving_tick` so the
  # cascade stays deterministic without a wall clock.

  adapter "CronAdapter" do
    driving on cron "*/5 * * * *" do |signal|
      dispatch "Hecks::Framework::Tools::TaskTool.Get",
               id: "cron-adapter-smoke",
               task_id: "cron-adapter-smoke",
               description: "cron adapter smoke"
    end
  end
end
