Hecks.behaviors "Tools" do
  vision "Behavioral tests for the 18 Tools category aggregates — ShellTool, FileTool, SearchTool, WebTool, EmailTool, TaskTool, Sidequest, WakeupTool, CronTool, MonitorTool, NotifyTool, PlanTool, WorktreeTool, AskTool, SkillTool, LspTool, MetaTool, RemoteTriggerTool. Cascade extracted to framework/cascade/cascade.behaviors (i609 phase 1, 2026-05-14). Each command records its identifying attrs into state via then_set and emits a matching event the runtime can react to."

  # ── ShellTool : Bash ──────────────────────────────────────────────
  #
  # Bash carries shell_command + description in both event payload and
  # aggregate state (small values, no bloat risk).

  test "Bash records shell_command + description" do
    tests "Bash", on: "ShellTool"
    input  id:             { value: "bash-1" },
           shell_command:  { value: "echo hello" },
           description:    { value: "say hi from the shell" }
    expect shell_command:  { value: "echo hello" },
           description:    { value: "say hi from the shell" }
  end

  test "Bash emits BashRan" do
    tests "Bash", on: "ShellTool"
    input  id:             { value: "bash-2" },
           shell_command:  { value: "ls -la" },
           description:    { value: "list working directory" }
    expect emits: ["BashRan"]
  end

  test "Bash carries a very long shell_command in state" do
    tests "Bash", on: "ShellTool"
    input  id:             { value: "bash-3" },
           shell_command:  { value: "echo " + ("x" * 2000) },
           description:    { value: "stress-test long command line" }
    expect description:    { value: "stress-test long command line" }
  end

  # ── FileTool : Read ───────────────────────────────────────────────
  #
  # Read is pure observation — file contents flow only through the
  # FileRead event payload ; state records what was looked at + why.

  test "Read records file_path + description" do
    tests "Read", on: "FileTool"
    input  id:           { value: "read-1" },
           file_path:    { value: "/tmp/example.txt" },
           description:  { value: "inspect example file" }
    expect file_path:    { value: "/tmp/example.txt" },
           description:  { value: "inspect example file" }
  end

  test "Read emits FileRead" do
    tests "Read", on: "FileTool"
    input  id:           { value: "read-2" },
           file_path:    { value: "/etc/hosts" },
           description:  { value: "peek at hosts" }
    expect emits: ["FileRead"]
  end

  # ── FileTool : Edit ───────────────────────────────────────────────
  #
  # Edit's old_string / new_string live in event payload only ; state
  # only records file_path + description so persistence stays small.

  test "Edit records file_path + description" do
    tests "Edit", on: "FileTool"
    input  id:           { value: "edit-1" },
           file_path:    { value: "/tmp/foo.rb" },
           old_string:   { value: "foo" },
           new_string:   { value: "bar" },
           replace_all:  { value: false },
           description:  { value: "rename foo to bar" }
    expect file_path:    { value: "/tmp/foo.rb" },
           description:  { value: "rename foo to bar" }
  end

  test "Edit emits EditApplied" do
    tests "Edit", on: "FileTool"
    input  id:           { value: "edit-2" },
           file_path:    { value: "/tmp/bar.rb" },
           old_string:   { value: "x" },
           new_string:   { value: "y" },
           replace_all:  { value: true },
           description:  { value: "replace x with y everywhere" }
    expect emits: ["EditApplied"]
  end

  # ── FileTool : Update ─────────────────────────────────────────────
  #
  # Update's content lives in event payload only ; state records the
  # file_path + description.

  test "Update records file_path + description" do
    tests "Update", on: "FileTool"
    input  id:           { value: "update-1" },
           file_path:    { value: "/tmp/new_file.txt" },
           content:      { value: "hello world" },
           description:  { value: "create greeting file" }
    expect file_path:    { value: "/tmp/new_file.txt" },
           description:  { value: "create greeting file" }
  end

  test "Update emits FileUpdated" do
    tests "Update", on: "FileTool"
    input  id:           { value: "update-2" },
           file_path:    { value: "/tmp/other.txt" },
           content:      { value: "x" * 5000 },
           description:  { value: "write a large file" }
    expect emits: ["FileUpdated"]
  end

  # ── SearchTool : Grep ─────────────────────────────────────────────
  #
  # Grep records pattern + search_path + description into state.
  # Match tuples flow through the GrepRan event payload.

  test "Grep records pattern + search_path + description" do
    tests "Grep", on: "SearchTool"
    input  id:           { value: "grep-1" },
           pattern:      { value: "TODO" },
           search_path:  { value: "lib/" },
           description:  { value: "find outstanding TODOs" }
    expect pattern:      { value: "TODO" },
           search_path:  { value: "lib/" },
           description:  { value: "find outstanding TODOs" }
  end

  test "Grep emits GrepRan" do
    tests "Grep", on: "SearchTool"
    input  id:           { value: "grep-2" },
           pattern:      { value: "fn main" },
           search_path:  { value: "rust/src/" },
           description:  { value: "locate the main entry" }
    expect emits: ["GrepRan"]
  end

  # ── SearchTool : Glob ─────────────────────────────────────────────
  #
  # Glob records glob_pattern + search_path + description. Match paths
  # flow through the GlobMatched event payload.

  test "Glob records glob_pattern + search_path + description" do
    tests "Glob", on: "SearchTool"
    input  id:           { value: "glob-1" },
           glob_pattern: { value: "**/*.rs" },
           search_path:  { value: "rust/src/" },
           description:  { value: "list all rust sources" }
    expect glob_pattern: { value: "**/*.rs" },
           search_path:  { value: "rust/src/" },
           description:  { value: "list all rust sources" }
  end

  test "Glob emits GlobMatched" do
    tests "Glob", on: "SearchTool"
    input  id:           { value: "glob-2" },
           glob_pattern: { value: "aggregates/**/*.bluebook" },
           search_path:  { value: "hecks_conception/" },
           description:  { value: "find every bluebook" }
    expect emits: ["GlobMatched"]
  end

  # ── WebTool : WebFetch ────────────────────────────────────────────
  #
  # WebFetch records url + description ; fetched content rides in the
  # WebFetched event payload only.

  test "WebFetch records url + description" do
    tests "WebFetch", on: "WebTool"
    input  id:           { value: "webfetch-1" },
           url:          { value: "https://example.com" },
           prompt:       { value: "summarize the page" },
           description:  { value: "fetch example.com" }
    expect url:          { value: "https://example.com" },
           description:  { value: "fetch example.com" }
  end

  test "WebFetch emits WebFetched" do
    tests "WebFetch", on: "WebTool"
    input  id:           { value: "webfetch-2" },
           url:          { value: "https://example.org" },
           prompt:       { value: "extract the title" },
           description:  { value: "another fetch" }
    expect emits: ["WebFetched"]
  end

  # ── WebTool : WebSearch ───────────────────────────────────────────
  #
  # WebSearch records the query + description ; result listings ride in
  # the WebSearched event payload.

  test "WebSearch records query + description" do
    tests "WebSearch", on: "WebTool"
    input  id:           { value: "websearch-1" },
           query:        { value: "domain-driven design" },
           description:  { value: "research DDD references" }
    expect query:        { value: "domain-driven design" },
           description:  { value: "research DDD references" }
  end

  test "WebSearch emits WebSearched" do
    tests "WebSearch", on: "WebTool"
    input  id:           { value: "websearch-2" },
           query:        { value: "rust bevy ecs" },
           description:  { value: "research bevy" }
    expect emits: ["WebSearched"]
  end

  # ── EmailTool : SearchThreads ──────────────────────────────
  #
  # SearchThreads records description only ; query + matched thread
  # ids ride in the ThreadsSearched event payload.

  test "SearchThreads records description" do
    tests "SearchThreads", on: "EmailTool"
    input  id:          { value: "email-search-1" },
           query:       { value: "from:joey is:unread" },
           description: { value: "find joey's pending replies" }
    expect description: { value: "find joey's pending replies" }
  end

  test "SearchThreads emits ThreadsSearched" do
    tests "SearchThreads", on: "EmailTool"
    input  id:          { value: "email-search-2" },
           query:       { value: "label:embryonaut newer_than:7d" },
           description: { value: "scan embryonaut label" }
    expect emits: ["ThreadsSearched"]
  end

  # ── EmailTool : GetThread ───────────────────────────────────
  #
  # GetThread records thread_id + description ; full thread body
  # rides in the ThreadFetched event payload.

  test "GetThread records thread_id + description" do
    tests "GetThread", on: "EmailTool"
    input  id:          { value: "email-get-1" },
           thread_id:   { value: "thread-abc123" },
           description: { value: "fetch joey's reply thread" }
    expect thread_id:   { value: "thread-abc123" },
           description: { value: "fetch joey's reply thread" }
  end

  test "GetThread emits ThreadFetched" do
    tests "GetThread", on: "EmailTool"
    input  id:          { value: "email-get-2" },
           thread_id:   { value: "thread-def456" },
           description: { value: "fetch another thread" }
    expect emits: ["ThreadFetched"]
  end

  # ── EmailTool : CreateDraft ───────────────────────────────────
  #
  # CreateDraft records to + subject + description ; body rides in
  # the DraftCreated event payload only.

  test "CreateDraft records to + subject + description" do
    tests "CreateDraft", on: "EmailTool"
    input  id:          { value: "email-draft-1" },
           to:          { value: "joey@example.com" },
           subject:     { value: "Re : OPT site fixes" },
           body:        { value: "Hi Joey,\n\nThe nine fixes are in.\n" },
           description: { value: "draft reply to joey's audit" }
    expect to:          { value: "joey@example.com" },
           subject:     { value: "Re : OPT site fixes" },
           description: { value: "draft reply to joey's audit" }
  end

  test "CreateDraft emits DraftCreated" do
    tests "CreateDraft", on: "EmailTool"
    input  id:          { value: "email-draft-2" },
           to:          { value: "louann@example.com" },
           subject:     { value: "Volunteer page update" },
           body:        { value: "Hi Lou Ann, the page is ready.\n" },
           description: { value: "draft reply to lou ann" }
    expect emits: ["DraftCreated"]
  end

  # ── EmailTool : ListDrafts ───────────────────────────────────
  #
  # ListDrafts records description only ; the draft list rides in
  # the DraftsListed event payload.

  test "ListDrafts records description" do
    tests "ListDrafts", on: "EmailTool"
    input  id:          { value: "email-list-1" },
           description: { value: "review pending drafts" }
    expect description: { value: "review pending drafts" }
  end

  test "ListDrafts emits DraftsListed" do
    tests "ListDrafts", on: "EmailTool"
    input  id:          { value: "email-list-2" },
           description: { value: "another listing pass" }
    expect emits: ["DraftsListed"]
  end

  # Cascade behaviors moved to framework/cascade/cascade.behaviors (i609 phase 1, 2026-05-14)

  # ── FileTool : Write ──────────────────────────────────────────────
  #
  # Write is the harness-name surface for full-file overwrite (Update is
  # the bluebook-canonical name). Content rides in the FileWritten
  # event payload only ; state records the file_path + description.

  test "Write records file_path + description" do
    tests "Write", on: "FileTool"
    input  id:           { value: "write-1" },
           file_path:    { value: "/tmp/written.txt" },
           content:      { value: "first contents" },
           description:  { value: "write a fresh file" }
    expect file_path:    { value: "/tmp/written.txt" },
           description:  { value: "write a fresh file" }
  end

  test "Write emits FileWritten" do
    tests "Write", on: "FileTool"
    input  id:           { value: "write-2" },
           file_path:    { value: "/tmp/another.txt" },
           content:      { value: "y" * 4000 },
           description:  { value: "write a big file" }
    expect emits: ["FileWritten"]
  end

  # ── FileTool : NotebookEdit ───────────────────────────────────────
  #
  # NotebookEdit operates at cell granularity. new_source rides in the
  # NotebookEdited event payload ; state records description.

  test "NotebookEdit records description" do
    tests "NotebookEdit", on: "FileTool"
    input  id:             { value: "nbedit-1" },
           notebook_path:  { value: "/tmp/notebook.ipynb" },
           cell_id:        { value: "abc123" },
           new_source:     { value: "print('hello')" },
           edit_mode:      { value: "replace" },
           description:    { value: "swap a cell's source" }
    expect description:    { value: "swap a cell's source" }
  end

  test "NotebookEdit emits NotebookEdited" do
    tests "NotebookEdit", on: "FileTool"
    input  id:             { value: "nbedit-2" },
           notebook_path:  { value: "/tmp/analysis.ipynb" },
           cell_id:        { value: "def456" },
           new_source:     { value: "df.head()" },
           edit_mode:      { value: "insert" },
           description:    { value: "add a head() probe" }
    expect emits: ["NotebookEdited"]
  end

  # ── TaskTool ──────────────────────────────────────────────────────
  #
  # TaskTool exposes Create / Get / List / Output / Stop / Update.

  test "Create records subject + description on TaskTool" do
    tests "Create", on: "TaskTool"
    input  id:           { value: "task-create-1" },
           subject:      { value: "Refactor parser" },
           description:  { value: "create the refactor task" },
           active_form:  { value: "Refactoring the parser" },
           metadata:     { value: "{}" }
    expect subject:      { value: "Refactor parser" },
           description:  { value: "create the refactor task" }
  end

  test "Create emits TaskCreated" do
    tests "Create", on: "TaskTool"
    input  id:           { value: "task-create-2" },
           subject:      { value: "Audit the macrophage" },
           description:  { value: "kick off an audit" },
           active_form:  { value: "Auditing the macrophage" },
           metadata:     { value: "{\"priority\":\"high\"}" }
    expect emits: ["TaskCreated"]
  end

  test "Get records task_id + description on TaskTool" do
    tests "Get", on: "TaskTool"
    input  id:           { value: "task-get-1" },
           task_id:      { value: "task-001" },
           description:  { value: "fetch the parser task" }
    expect task_id:      { value: "task-001" },
           description:  { value: "fetch the parser task" }
  end

  test "Get emits TaskFetched" do
    tests "Get", on: "TaskTool"
    input  id:           { value: "task-get-2" },
           task_id:      { value: "task-002" },
           description:  { value: "another lookup" }
    expect emits: ["TaskFetched"]
  end

  test "List records description on TaskTool" do
    tests "List", on: "TaskTool"
    input  id:           { value: "task-list-1" },
           description:  { value: "enumerate active tasks" }
    expect description:  { value: "enumerate active tasks" }
  end

  test "List emits TasksListed" do
    tests "List", on: "TaskTool"
    input  id:           { value: "task-list-2" },
           description:  { value: "another listing" }
    expect emits: ["TasksListed"]
  end

  test "Output records task_id + description on TaskTool" do
    tests "Output", on: "TaskTool"
    input  id:           { value: "task-output-1" },
           task_id:      { value: "task-003" },
           description:  { value: "fetch transcript" }
    expect task_id:      { value: "task-003" },
           description:  { value: "fetch transcript" }
  end

  test "Output emits TaskOutputFetched" do
    tests "Output", on: "TaskTool"
    input  id:           { value: "task-output-2" },
           task_id:      { value: "task-004" },
           description:  { value: "grab the output stream" }
    expect emits: ["TaskOutputFetched"]
  end

  test "Stop records task_id + description on TaskTool" do
    tests "Stop", on: "TaskTool"
    input  id:           { value: "task-stop-1" },
           task_id:      { value: "task-005" },
           description:  { value: "halt the runaway task" }
    expect task_id:      { value: "task-005" },
           description:  { value: "halt the runaway task" }
  end

  test "Stop emits TaskStopped" do
    tests "Stop", on: "TaskTool"
    input  id:           { value: "task-stop-2" },
           task_id:      { value: "task-006" },
           description:  { value: "another halt" }
    expect emits: ["TaskStopped"]
  end

  test "Update records task_id + subject + status + description on TaskTool" do
    tests "Update", on: "TaskTool"
    input  id:             { value: "task-update-1" },
           task_id:        { value: "task-007" },
           status:         { value: "in_progress" },
           subject:        { value: "Refactor parser (revised)" },
           description:    { value: "advance the task" },
           active_form:    { value: "Refactoring the parser (revised)" },
           owner:          { value: "Miette" },
           metadata:       { value: "{}" },
           add_blocks:     [],
           add_blocked_by: []
    expect task_id:        { value: "task-007" },
           subject:        { value: "Refactor parser (revised)" },
           status:         { value: "in_progress" },
           description:    { value: "advance the task" }
  end

  test "Update emits TaskUpdated" do
    tests "Update", on: "TaskTool"
    input  id:             { value: "task-update-2" },
           task_id:        { value: "task-008" },
           status:         { value: "completed" },
           subject:        { value: "Audit complete" },
           description:    { value: "mark the audit done" },
           active_form:    { value: "Completing the audit" },
           owner:          { value: "Miette" },
           metadata:       { value: "{}" },
           add_blocks:     [],
           add_blocked_by: []
    expect emits: ["TaskUpdated"]
  end

  # ── Sidequest : Dispatch ──────────────────────────────────────────

  test "Dispatch records subagent_type + description on Sidequest" do
    tests "Dispatch", on: "Sidequest"
    input  id:                 { value: "sidequest-1" },
           description:        { value: "spawn a researcher" },
           prompt:              { value: "What does the bluebook DSL look like?" },
           subagent_type:      { value: "researcher" },
           model:              { value: "claude-opus-4-7" },
           run_in_background:  { value: false },
           isolation:          { value: "worktree" }
    expect subagent_type:      { value: "researcher" },
           description:        { value: "spawn a researcher" }
  end

  test "Dispatch emits SidequestDispatched" do
    tests "Dispatch", on: "Sidequest"
    input  id:                 { value: "sidequest-2" },
           description:        { value: "another sub-agent" },
           prompt:              { value: "Investigate the parser cache." },
           subagent_type:      { value: "general-purpose" },
           model:              { value: "claude-sonnet-4-5" },
           run_in_background:  { value: true },
           isolation:          { value: "none" }
    expect emits: ["SidequestDispatched"]
  end

  # ── Sidequest : SendMessage (i639) ────────────────────

  test "SendMessage records description on Sidequest" do
    tests "SendMessage", on: "Sidequest"
    input  id:          { value: "sidequest-1" },
           message:     { value: "drop the AgentTool idea — extend Sidequest instead" },
           description: { value: "steer the running agent" }
    expect description: { value: "steer the running agent" }
  end

  test "SendMessage emits SidequestMessageSent" do
    tests "SendMessage", on: "Sidequest"
    input  id:          { value: "sidequest-2" },
           message:     { value: "tighten the spec" },
           description: { value: "course-correct" }
    expect emits: ["SidequestMessageSent"]
  end

  # ── WakeupTool : Schedule ─────────────────────────────────────────

  test "Schedule records delay_seconds + reason + description on WakeupTool" do
    tests "Schedule", on: "WakeupTool"
    input  id:             { value: "wake-1" },
           delay_seconds:  { value: 300 },
           reason:         { value: "follow up on deploy" },
           prompt:         { value: "Check the deploy status." },
           description:    { value: "wake up in 5m" }
    expect delay_seconds:  { value: 300 },
           reason:         { value: "follow up on deploy" },
           description:    { value: "wake up in 5m" }
  end

  test "Schedule emits WakeupScheduled" do
    tests "Schedule", on: "WakeupTool"
    input  id:             { value: "wake-2" },
           delay_seconds:  { value: 900 },
           reason:         { value: "poll the smoke test" },
           prompt:         { value: "Re-run the smoke." },
           description:    { value: "wake in 15m" }
    expect emits: ["WakeupScheduled"]
  end

  # ── CronTool : Create / List / Delete ─────────────────────────────

  test "Create records schedule + description on CronTool" do
    tests "Create", on: "CronTool"
    input  id:           { value: "cron-create-1" },
           schedule:     { value: "0 9 * * 1-5" },
           job_name:     { value: "weekday-greet" },
           prompt:       { value: "Send the morning brief." },
           description:  { value: "morning brief cron" }
    expect schedule:     { value: "0 9 * * 1-5" },
           description:  { value: "morning brief cron" }
  end

  test "Create emits CronCreated" do
    tests "Create", on: "CronTool"
    input  id:           { value: "cron-create-2" },
           schedule:     { value: "*/15 * * * *" },
           job_name:     { value: "heartbeat" },
           prompt:       { value: "Ping the heartbeat endpoint." },
           description:  { value: "heartbeat poller" }
    expect emits: ["CronCreated"]
  end

  test "List records description on CronTool" do
    tests "List", on: "CronTool"
    input  id:           { value: "cron-list-1" },
           description:  { value: "enumerate cron jobs" }
    expect description:  { value: "enumerate cron jobs" }
  end

  test "List emits CronListed" do
    tests "List", on: "CronTool"
    input  id:           { value: "cron-list-2" },
           description:  { value: "another listing" }
    expect emits: ["CronListed"]
  end

  test "Delete records cron_id + description on CronTool" do
    tests "Delete", on: "CronTool"
    input  id:           { value: "cron-delete-1" },
           cron_id:      { value: "cron-001" },
           description:  { value: "retire the heartbeat" }
    expect cron_id:      { value: "cron-001" },
           description:  { value: "retire the heartbeat" }
  end

  test "Delete emits CronDeleted" do
    tests "Delete", on: "CronTool"
    input  id:           { value: "cron-delete-2" },
           cron_id:      { value: "cron-002" },
           description:  { value: "remove the morning cron" }
    expect emits: ["CronDeleted"]
  end

  # ── MonitorTool : Stream ──────────────────────────────────────────

  test "Stream records target + description on MonitorTool" do
    tests "Stream", on: "MonitorTool"
    input  id:             { value: "monitor-1" },
           target:         { value: "log://overmind/web" },
           filter:         { value: "ERROR" },
           until_pattern:  { value: "boot complete" },
           description:    { value: "watch web logs for errors" }
    expect target:         { value: "log://overmind/web" },
           description:    { value: "watch web logs for errors" }
  end

  test "Stream emits StreamSubscribed" do
    tests "Stream", on: "MonitorTool"
    input  id:             { value: "monitor-2" },
           target:         { value: "process://pid-9001" },
           filter:         { value: "" },
           until_pattern:  { value: "" },
           description:    { value: "follow a background process" }
    expect emits: ["StreamSubscribed"]
  end

  # ── NotifyTool : Push ─────────────────────────────────────────────

  test "Push records title + channel + description on NotifyTool" do
    tests "Push", on: "NotifyTool"
    input  id:           { value: "notify-1" },
           title:        { value: "Deploy green" },
           body:         { value: "All checks passed at 09:42." },
           channel:      { value: "urgent" },
           description:  { value: "ping operator on green deploy" }
    expect title:        { value: "Deploy green" },
           channel:      { value: "urgent" },
           description:  { value: "ping operator on green deploy" }
  end

  test "Push emits NotificationPushed" do
    tests "Push", on: "NotifyTool"
    input  id:           { value: "notify-2" },
           title:        { value: "Smoke red" },
           body:         { value: "Smoke test failed on main." },
           channel:      { value: "default" },
           description:  { value: "ping on smoke failure" }
    expect emits: ["NotificationPushed"]
  end

  # ── PlanTool : Enter / Exit ───────────────────────────────────────

  test "Enter records plan + description on PlanTool" do
    tests "Enter", on: "PlanTool"
    input  id:           { value: "plan-enter-1" },
           plan:         { value: "1. Audit the parser\n2. Refactor\n3. Ship" },
           description:  { value: "open plan mode" }
    expect plan:         { value: "1. Audit the parser\n2. Refactor\n3. Ship" },
           description:  { value: "open plan mode" }
  end

  test "Enter emits PlanEntered" do
    tests "Enter", on: "PlanTool"
    input  id:           { value: "plan-enter-2" },
           plan:         { value: "1. Investigate\n2. Fix" },
           description:  { value: "another plan" }
    expect emits: ["PlanEntered"]
  end

  test "Exit records description on PlanTool" do
    tests "Exit", on: "PlanTool"
    input  id:           { value: "plan-exit-1" },
           description:  { value: "close plan mode" }
