  end

  # ── AskTool : AskUser ─────────────────────────────────────────────

  test "AskUser records question + header + description on AskTool" do
    tests "AskUser", on: "AskTool"
    input  id:            { value: "ask-1" },
           question:      { value: "Should we proceed with the destructive op?" },
