Hecks.bluebook "Tools", version: "2026.05.14.1" do
  vision "First-class tool invocations as dispatched commands, grouped by category. Each tool family is its own aggregate ; the Cascade aggregate carries the kernel-hook's RecordResult chain. Replaces the earlier flat single-Tools aggregate (versions ≤ 2026.05.12.5) — sibling commands of unrelated kinds no longer share a single record. Per the locked 2026-05-12 conventions, every value object is declared INSIDE the aggregate that uses it ; duplication across aggregates (Id, Description, FilePath, SearchPath) is fine."
  category "framework"

  # ============================================================
  # TOOLS — agent-level tool invocations as first-class dispatches
  # ============================================================
  #
  # Conceived 2026-05-12 as a single flat Tools aggregate ; restructured
  # the same day into five category-shaped aggregates. The flat shape
  # piled nine unrelated commands onto one aggregate ("Tools record" had
  # to mean "any tool invocation, of any kind, possibly with most of its
  # state empty"). The category split makes each kind of invocation its
  # own aggregate with focused state — ShellTool records carry
  # shell_command, FileTool records carry file_path, SearchTool records
  # carry pattern/glob_pattern + search_path, WebTool records carry url
  # /prompt/query, Cascade records carry the kernel-hook's outcome
  # payload.
  #
  # ── The five categories ──
  #
  #   * ShellTool   — Bash               (shell exec)
  #   * FileTool    — Read, Edit, Update (file I/O)
  #   * SearchTool  — Grep, Glob         (filesystem search)
  #   * WebTool     — WebFetch, WebSearch (HTTP / search engine)
  #   * Cascade     — RecordResult       (kernel-hook outcome chain)
  #
  # Each aggregate is identified_by :id ; the harness mints a stable
  # ULID before dispatch and that's the addressable key. A Cascade
  # record uses the SAME id as the originating ShellTool/FileTool/
  # SearchTool/WebTool record so the outcome is joinable against the
  # invocation event by id.
  #
  # ── Why no entities ──
  #
  # Entities earn their place when a stateful sub-concept crosses
  # multiple commands within an aggregate. Here, each invocation is
  # an independent record keyed by id ; no sub-concept persists
  # across commands inside a single aggregate. ShellTool.Bash and
  # ShellTool... (any future shell command) would still each mint a
  # fresh record. So no entities — flat-by-design within each
  # category aggregate.
  #
  # ── The runtime substrate ──
  #
  # The bluebook is the contract. Two pieces of substrate wire it :
  #
  #   1. The :claude_tool adapter family (see
  #      framework/adapter_families/claude_tool.hecksagon) executes
  #      Bash / Edit / Read / Update / Grep / Glob natively.
  #
  #   2. The :web_tool adapter family (see
  #      framework/adapter_families/web_tool.hecksagon) handles
  #      WebFetch / WebSearch.
  #
  # Both adapter families chain their captured output through the
  # `result_into:` cascade — typically Cascade.RecordResult — so the
  # outcome becomes a first-class event the runtime can react to.
  #
  # ── State versus event payload ──
  #
  # For Bash, the shell command is small (a few hundred bytes
  # typically), so it lives in both the event payload and the
  # aggregate state. For Edit / Update, the old/new strings and
  # full file content can be thousands of bytes — those live in
  # the event payload only. Aggregate state stays small : id,
  # description, and (when present) file_path. Replay logic
  # reconstructs heavy payloads from the event log when needed.

  # ── ShellTool : Bash (shell exec) ──
  aggregate "ShellTool", "Shell-command invocations as first-class dispatched commands. Carries the verbatim shell command plus a one-line description ; the :claude_tool kernel hook executes it and chains the outcome into Cascade.RecordResult." do
    identified_by :id

    attribute :id, Id
    attribute :shell_command, ShellCommand
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller (the harness)
      # before dispatch. The caller chooses the id form ; for the
      # Claude harness it's a ULID. The aggregate persists by id so
      # the BashRan event carries an identifier that downstream
      # listeners (and the Cascade.RecordResult follow-on) can join
      # against.
      attribute :value, String
    end

    value_object "ShellCommand" do
      # The shell command line passed to Bash, verbatim — what the
      # operator would type at a terminal. The runtime substrate
      # is what actually executes it ; the bluebook just records
      # what was asked.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice, captioning what the
      # invocation is trying to do. Stays under 80 characters by
      # convention so it reads cleanly in the statusline and
      # event-stream surfaces.
      attribute :value, String
    end

    command "Bash" do
      role "Miette"
      description "Run a shell command. Records the dispatch as a ShellTool record and emits BashRan carrying the command, description, and invocation id so downstream policies can react to the call. The :claude_tool adapter actually executes the shell — this bluebook names the contract, not the execution."
      attribute :id, Id
      attribute :shell_command, ShellCommand
      attribute :description, Description
      emits "BashRan"
      then_set :shell_command, to: :shell_command
      then_set :description,   to: :description
    end
  end

  # ── FileTool : Read, Edit, Update (file I/O) ──
  aggregate "FileTool", "File-I/O tool invocations as first-class dispatched commands. Read is pure observation ; Edit applies a substring substitution ; Update writes content. State carries the file_path + description ; large payloads (old/new strings, full content) ride in the event payload only so persistence stays small." do
    identified_by :id

    attribute :id, Id
    attribute :file_path, FilePath
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller before dispatch.
      # Same shape as ShellTool/SearchTool/WebTool/Cascade — the
      # convention is one ULID per dispatched tool call, shared
      # with the corresponding Cascade.RecordResult so the outcome
      # is joinable by id.
      attribute :value, String
    end

    value_object "FilePath" do
      # The file Read / Edit / Update target. Absolute path
      # preferred ; relative paths are interpreted by the runtime
      # substrate at dispatch time.
      attribute :value, String
    end

    value_object "OldString" do
      # The substring Edit replaces. Lives in the EditApplied event
      # payload only ; not persisted to aggregate state, so the
      # heki doesn't grow unbounded with every edit's bytes.
      attribute :value, String
    end

    value_object "NewString" do
      # The substring Edit substitutes in. Same event-only
      # treatment as OldString.
      attribute :value, String
    end

    value_object "ReplaceAll" do
      # When true, replace every occurrence ; when false, require
      # exactly one match. Matches the Edit tool's existing flag.
      attribute :value, Boolean
    end

    value_object "Content" do
      # The full content Update writes to a file. Lives in the
      # FileUpdated event payload only ; not persisted to
      # aggregate state.
      attribute :value, String
    end

    value_object "NotebookPath" do
      # Path to a Jupyter notebook (.ipynb file). Distinct from
      # FilePath only by convention — the underlying type is the
      # same string. Carried as its own VO so the bluebook clearly
      # signals "this command operates on a notebook, not an
      # arbitrary file".
      attribute :value, String
    end

    value_object "CellId" do
      # The id of the notebook cell being edited. Notebooks address
      # cells by id rather than by index (indices shift as cells are
      # inserted / deleted) ; the adapter resolves the id to the
      # right cell.
      attribute :value, String
    end

    value_object "NewSource" do
      # The new source content for the targeted cell. Lives in the
      # NotebookEdited event payload only.
      attribute :value, String
    end

    value_object "EditMode" do
      # Optional edit mode — one of "replace" / "insert" / "delete".
      # When absent, the adapter defaults to "replace".
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice. Same shape as the
      # Description VO on every other tool aggregate ; duplicated
      # here per the locked convention (VOs live inside the
      # aggregate that uses them).
      attribute :value, String
    end

    # ── Read ──
    command "Read" do
      role "Miette"
      description "Read a file's contents. Records the dispatch as a FileTool record and emits FileRead carrying the file_path and description. The actual file contents flow through the event payload (filled by the runtime substrate after the read completes) ; aggregate state only records what was looked at and why."
      attribute :id, Id
      attribute :file_path, FilePath
      attribute :description, Description
      emits "FileRead"
      then_set :file_path,   to: :file_path
      then_set :description, to: :description
    end

    # ── Edit ──
    command "Edit" do
      role "Miette"
      description "Apply a string substitution to a file. Records the dispatch as a FileTool record and emits EditApplied carrying the file_path, old_string, new_string, replace_all flag, and description. The full old/new strings live in the event payload ; aggregate state stores only the file_path + description."
      attribute :id, Id
      attribute :file_path, FilePath
      attribute :old_string, OldString
      attribute :new_string, NewString
      attribute :replace_all, ReplaceAll
      attribute :description, Description
      emits "EditApplied"
      then_set :file_path,   to: :file_path
      then_set :description, to: :description
    end

    # ── Update ──
    command "Update" do
      role "Miette"
      description "Write content to a file. Records the dispatch as a FileTool record and emits FileUpdated carrying the file_path, content, and description. The full content lives in the event payload ; aggregate state stores only the file_path and description. Same semantic as Claude's existing Write tool — renamed here to emphasize that the runtime treats it as a state-changing dispatch."
      attribute :id, Id
      attribute :file_path, FilePath
      attribute :content, Content
      attribute :description, Description
      emits "FileUpdated"
      then_set :file_path,   to: :file_path
      then_set :description, to: :description
    end

    # ── Write ──
    #
    # Write does a full-file overwrite. Distinct from Update only by
    # the harness's traditional naming (Claude Code calls this tool
    # "Write" ; the existing tools.bluebook renamed it to Update to
    # emphasize the state-changing nature). We keep BOTH : Write is
    # the harness-name surface, Update is the bluebook-canonical
    # surface. Identical attribute shape ; the adapter routes both
    # to the same underlying write operation.
    command "Write" do
      role "Miette"
      description "Write content to a file (full-file overwrite). Records the dispatch as a FileTool record and emits FileWritten carrying the file_path, content, and description. The full content lives in the event payload ; aggregate state stores only the file_path + description. Surfaced under the harness-traditional 'Write' name for parity with Claude Code's existing tool ; Update is the same operation under the bluebook-canonical name."
      attribute :id, Id
      attribute :file_path, FilePath
      attribute :content, Content
      attribute :description, Description
      emits "FileWritten"
      then_set :file_path,   to: :file_path
      then_set :description, to: :description
    end

    # ── NotebookEdit ──
    #
    # NotebookEdit operates on Jupyter .ipynb files at cell
    # granularity. The cell_id addresses the target cell ; new_source
    # is the replacement content ; edit_mode selects replace / insert
    # / delete semantics.
    command "NotebookEdit" do
      role "Miette"
      description "Edit a cell in a Jupyter notebook. Records the dispatch as a FileTool record and emits NotebookEdited carrying the notebook_path, cell_id, new_source, edit_mode, and description. The new_source rides in the event payload ; aggregate state stores only the notebook_path + description."
      attribute :id, Id
      attribute :notebook_path, NotebookPath
      attribute :cell_id, CellId
      attribute :new_source, NewSource
      attribute :edit_mode, EditMode
      attribute :description, Description
      emits "NotebookEdited"
      then_set :description, to: :description
    end
  end

  # ── SearchTool : Grep, Glob (filesystem search) ──
  aggregate "SearchTool", "Filesystem-search tool invocations as first-class dispatched commands. Grep finds regex matches ; Glob enumerates paths against a filesystem pattern. State carries what was searched for and where ; match results ride in the event payload." do
    identified_by :id

    attribute :id, Id
    attribute :pattern, Pattern
    attribute :glob_pattern, GlobPattern
    attribute :search_path, SearchPath
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller before dispatch.
      attribute :value, String
    end

    value_object "Pattern" do
      # Regex pattern passed to Grep. Standard ripgrep / PCRE2
      # syntax. The runtime substrate compiles + executes ; the
      # bluebook records what we asked for.
      attribute :value, String
    end

    value_object "GlobPattern" do
      # Filesystem-glob pattern passed to Glob (e.g.
      # "rust/src/**/*.rs", "hecks_conception/aggregates/**.bluebook").
      attribute :value, String
    end

    value_object "SearchPath" do
      # The directory or path Grep / Glob is rooted at. When
      # absent the runtime defaults to cwd ; otherwise it's a
      # filesystem path that scopes the search.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice. Duplicated per locked
      # convention (VOs inside each aggregate).
      attribute :value, String
    end

    # ── Grep ──
    command "Grep" do
      role "Miette"
      description "Search files for a regex pattern. Records the dispatch as a SearchTool record and emits GrepRan carrying the pattern, search_path, and description. Match results flow through the event payload ; aggregate state stores what was searched and where, not the matches themselves."
      attribute :id, Id
      attribute :pattern, Pattern
      attribute :search_path, SearchPath
      attribute :description, Description
      emits "GrepRan"
      then_set :pattern,     to: :pattern
      then_set :search_path, to: :search_path
      then_set :description, to: :description
    end

    # ── Glob ──
    command "Glob" do
      role "Miette"
      description "List files matching a glob pattern. Records the dispatch as a SearchTool record and emits GlobMatched carrying the glob_pattern, search_path, and description. Match results (the file paths) flow through the event payload ; aggregate state stores only what was asked for."
      attribute :id, Id
      attribute :glob_pattern, GlobPattern
      attribute :search_path, SearchPath
      attribute :description, Description
      emits "GlobMatched"
      then_set :glob_pattern, to: :glob_pattern
      then_set :search_path,  to: :search_path
      then_set :description,  to: :description
    end
  end

  # ── WebTool : WebFetch, WebSearch (HTTP / search engine) ──
  aggregate "WebTool", "Web tool invocations as first-class dispatched commands. WebFetch retrieves a URL and processes it with a prompt ; WebSearch runs a query against a search engine. State carries the url/prompt/query + description ; fetched content + result listings ride in the event payload." do
    identified_by :id

    attribute :id, Id
    attribute :url, Url
    attribute :prompt, FetchPrompt
    attribute :query, SearchQuery
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller before dispatch.
      attribute :value, String
    end

    value_object "Url" do
      # The URL passed to WebFetch — verbatim, including scheme.
      attribute :value, String
    end

    value_object "FetchPrompt" do
      # The instruction passed to WebFetch alongside the URL,
      # telling the model how to process the fetched content
      # (extract a value, summarize, answer a question, etc.).
      attribute :value, String
    end

    value_object "SearchQuery" do
      # The query string passed to WebSearch — the text the search
      # engine receives.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice. Duplicated per locked
      # convention (VOs inside each aggregate).
      attribute :value, String
    end

    # ── WebFetch ──
    command "WebFetch" do
      role "Miette"
      description "Fetch a URL and process its content with a prompt. Records the dispatch as a WebTool record and emits WebFetched carrying the url, prompt, content (truncated), and description."
      attribute :id, Id
      attribute :url, Url
      attribute :prompt, FetchPrompt
      attribute :description, Description
      emits "WebFetched"
      then_set :url,         to: :url
      then_set :description, to: :description
    end

    # ── WebSearch ──
    command "WebSearch" do
      role "Miette"
      description "Search the web with a query. Records the dispatch as a WebTool record and emits WebSearched carrying the query, allowed/blocked domains, and the result count + summary."
      attribute :id, Id
      attribute :query, SearchQuery
      attribute :description, Description
      emits "WebSearched"
      then_set :query,       to: :query
      then_set :description, to: :description
    end
  end

  # ──── Aggregate: EmailTool ────
  #
  # EmailTool wraps Claude Code's Gmail MCP surface as a first-class
  # aggregate. The harness exposes search_threads, get_thread,
  # create_draft, list_drafts (plus a label-management family —
  # not yet bluebooked, deferred to a follow-up) against Gmail ;
  # each command lands as a dispatched record so the runtime can
  # react to email events the same way it reacts to file or shell
  # events.
  #
  # Scoped to the four operations Miette actually uses nightly :
  # search threads, fetch a thread verbatim, draft a reply, list
  # outstanding drafts. The label-management family (label_message,
  # label_thread, unlabel_message, unlabel_thread, create_label,
  # update_label, delete_label, list_labels) is deferred until
  # there is a concrete dispatch site demanding it. The
  # "drafts only, never send" operating mode is encoded in what is
  # NOT modelled here : there is no SendDraft command. Sending is
  # the operator's act ; Miette composes, the operator approves.
  aggregate "EmailTool", "Gmail tool invocations as first-class dispatched commands. SearchThreads queries the inbox ; GetThread retrieves one thread's full content ; CreateDraft composes a reply ; ListDrafts enumerates pending outbound drafts. State carries the thread_id + recipient + subject + description ; bodies and full thread content ride in the event payload." do
    identified_by :id

    attribute :id, Id
    attribute :thread_id, ThreadId
    attribute :to, EmailAddress
    attribute :subject, Subject
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller before dispatch.
      # Same shape as ShellTool/FileTool/SearchTool/WebTool/Cascade
      # — one ULID per dispatch, shared with the corresponding
      # Cascade.RecordResult so the outcome is joinable by id.
      attribute :value, String
    end

    value_object "ThreadId" do
      # Gmail thread identifier (the API's "thread-<hash>" form).
      # GetThread targets a specific thread ; SearchThreads emits
      # a list of these via the event payload.
      attribute :value, String
    end

    value_object "EmailAddress" do
      # RFC 5322 email address. Used as the recipient for
      # CreateDraft. Plus-aliases are preserved verbatim
      # (chris+x@embryonaut.ai folds at the receiver, not here).
      attribute :value, String
    end

    value_object "Subject" do
      # Email subject line — the one rendered in the inbox. Stays
      # on aggregate state because it is small and identifies the
      # conversation at a glance.
      attribute :value, String
    end

    value_object "BodyMarkdown" do
      # The draft body, in markdown. Lives in the DraftCreated
      # event payload only ; not persisted to aggregate state so
      # the heki does not grow unbounded with every draft's content.
      attribute :value, String
    end

    value_object "SearchQuery" do
      # The gmail-search-syntax query passed to SearchThreads
      # (e.g. "from:joey is:unread", "label:embryonaut newer_than:7d").
      # Lives in the event payload ; carries verbatim what the
      # operator-facing search would.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice. Duplicated per locked
      # convention (VOs inside each aggregate).
      attribute :value, String
    end

    # ── SearchThreads ──
    command "SearchThreads" do
      role "Miette"
      description "Run a Gmail search and return the matching threads. Records the dispatch as an EmailTool record and emits ThreadsSearched carrying the query + matched thread ids + a short summary. The full search hit list (snippets, sender info) rides in the event payload ; aggregate state stores only the description so the heki stays small for noisy mailing-list passes."
      attribute :id, Id
      attribute :query, SearchQuery
      attribute :description, Description
      emits "ThreadsSearched"
      then_set :description, to: :description
    end

    # ── GetThread ──
    command "GetThread" do
      role "Miette"
      description "Fetch one Gmail thread's full content. Records the dispatch as an EmailTool record and emits ThreadFetched carrying the thread_id + a content summary. Full thread body (every message verbatim) rides in the event payload ; aggregate state stores thread_id + description."
      attribute :id, Id
      attribute :thread_id, ThreadId
      attribute :description, Description
      emits "ThreadFetched"
      then_set :thread_id,   to: :thread_id
      then_set :description, to: :description
    end

    # ── CreateDraft ──
    command "CreateDraft" do
      role "Miette"
      description "Compose a Gmail draft. Records the dispatch as an EmailTool record and emits DraftCreated carrying the to/subject/body + description. Body rides in the event payload only ; aggregate state carries to + subject + description. Drafts only — there is no SendDraft command. Sending is the operator's act."
      attribute :id, Id
      attribute :to, EmailAddress
      attribute :subject, Subject
      attribute :body, BodyMarkdown
      attribute :description, Description
      emits "DraftCreated"
      then_set :to,          to: :to
      then_set :subject,     to: :subject
      then_set :description, to: :description
    end

    # ── ListDrafts ──
    command "ListDrafts" do
      role "Miette"
      description "Enumerate Gmail drafts in the operator's outbox. Records the dispatch as an EmailTool record and emits DraftsListed carrying the count + a list of (subject, to, drafted_at) tuples. The list rides in the event payload ; aggregate state stores only the description."
      attribute :id, Id
      attribute :description, Description
      emits "DraftsListed"
      then_set :description, to: :description
    end
  end

  # ──── Aggregate: TaskTool ────
  #
  # TaskTool wraps Claude Code's task-management surface as a
  # first-class aggregate. The harness exposes Create / Get / List
  # / Output / Stop / Update against a task registry ; each
  # command lands as a dispatched record so the runtime can react
  # to task lifecycle events the same way it reacts to file or
  # shell events.
  aggregate "TaskTool", "Task-registry tool invocations as first-class dispatched commands. Create mints a task ; Get / List / Output observe ; Stop terminates ; Update mutates. State carries the task identifier plus the most recent subject / status / description ; large payloads (prompts, output, metadata) ride in the event payload." do
    identified_by :id

    attribute :id, Id
    attribute :task_id, TaskId
    attribute :subject, Subject
    attribute :status, TaskStatus
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id (one per dispatched TaskTool command),
      # minted by the caller before dispatch. NOT the task_id —
      # see TaskId below.
      attribute :value, String
    end

    value_object "TaskId" do
      # The id of the task being created / observed / mutated.
      # Distinct from the invocation Id : a single task receives
      # many dispatches (Update, Get, Stop) over its lifetime,
      # each with its own invocation Id, all referencing the same
      # TaskId.
      attribute :value, String
    end

    value_object "Subject" do
      # Short noun phrase naming the task. Shown in task lists and
      # statusline surfaces. Stays under 80 characters by
      # convention.
      attribute :value, String
    end

    value_object "ActiveForm" do
      # Present-continuous phrasing of the subject ("Refactoring
      # the parser") for in-flight task displays. Optional ; when
      # absent the surface derives it from the subject.
      attribute :value, String
    end

    value_object "TaskStatus" do
      # Lifecycle status — one of "pending" / "in_progress" /
      # "completed" / "blocked" / "cancelled". Lowercase by
      # convention so the value matches Claude Code's task
      # registry vocabulary.
      attribute :value, String
    end

    value_object "Owner" do
      # The being or human that owns the task. Free-form name ;
      # the runtime may match it against a roster but the
      # bluebook does not enforce membership.
      attribute :value, String
    end

    value_object "Metadata" do
      # Free-form JSON-shaped metadata bag. Lives in the event
      # payload only ; aggregate state stores only the most recent
      # known status / subject. Schema is intentionally open ; the
      # adapter and downstream listeners interpret it.
      attribute :value, String
    end

    value_object "BlockRef" do
      # A reference to another task id, used by Update's
      # addBlocks / addBlockedBy lists. Wrapping it as a VO (rather
      # than bare String) lets the macrophage validate ULID shape
      # at parse time if we later add an invariant.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice. Duplicated per locked
      # convention.
      attribute :value, String
    end

    # ── Create ──
    command "Create" do
      role "Miette"
      description "Create a task in the harness's task registry. Records the dispatch as a TaskTool record and emits TaskCreated carrying the subject, description, active_form, and metadata. The runtime substrate mints the task_id and pipes it back through Cascade.RecordResult."
      attribute :id, Id
      attribute :subject, Subject
      attribute :description, Description
      attribute :active_form, ActiveForm
      attribute :metadata, Metadata
      emits "TaskCreated"
      then_set :subject,     to: :subject
      then_set :description, to: :description
    end

    # ── Get ──
    command "Get" do
      role "Miette"
      description "Look up a task by id. Records the dispatch as a TaskTool record and emits TaskFetched carrying the task_id. The task's current state lands in the event payload and on the Cascade.RecordResult follow-on."
      attribute :id, Id
      attribute :task_id, TaskId
      attribute :description, Description
      emits "TaskFetched"
      then_set :task_id,     to: :task_id
      then_set :description, to: :description
    end

    # ── List ──
    command "List" do
      role "Miette"
      description "List tasks in the harness's registry. Records the dispatch as a TaskTool record and emits TasksListed. The result set rides through the event payload ; aggregate state records only that a listing happened."
      attribute :id, Id
      attribute :description, Description
      emits "TasksListed"
      then_set :description, to: :description
    end

    # ── Output ──
    command "Output" do
      role "Miette"
      description "Fetch a task's captured output (sub-agent transcripts, command output, etc.). Records the dispatch as a TaskTool record and emits TaskOutputFetched. Output payload rides through Cascade.RecordResult."
      attribute :id, Id
      attribute :task_id, TaskId
      attribute :description, Description
      emits "TaskOutputFetched"
      then_set :task_id,     to: :task_id
      then_set :description, to: :description
    end

    # ── Stop ──
    command "Stop" do
      role "Miette"
      description "Stop a running task. Records the dispatch as a TaskTool record and emits TaskStopped carrying the task_id. The adapter signals the underlying runtime ; the outcome rides through Cascade.RecordResult."
      attribute :id, Id
      attribute :task_id, TaskId
      attribute :description, Description
      emits "TaskStopped"
      then_set :task_id,     to: :task_id
      then_set :description, to: :description
    end

    # ── Update ──
    command "Update" do
      role "Miette"
      description "Mutate a task's status / subject / description / active_form / owner / metadata, optionally adding block or blocked-by references. Records the dispatch as a TaskTool record and emits TaskUpdated. Aggregate state absorbs the most recent subject + status + description ; block-list mutations ride in the event payload."
      attribute :id, Id
      attribute :task_id, TaskId
      attribute :status, TaskStatus
      attribute :subject, Subject
      attribute :description, Description
      attribute :active_form, ActiveForm
      attribute :owner, Owner
      attribute :metadata, Metadata
      attribute :add_blocks, list_of(BlockRef)
      attribute :add_blocked_by, list_of(BlockRef)
      emits "TaskUpdated"
      then_set :task_id,     to: :task_id
      then_set :subject,     to: :subject
      then_set :status,      to: :status
      then_set :description, to: :description
    end
  end

  # ──── Aggregate: Sidequest ────
  #
  # Sidequest wraps Claude Code's Agent / sub-agent dispatch
  # tool. Distinct from TaskTool because Agent is a single
  # fire-and-collect dispatch (one prompt in, one transcript out)
  # rather than a task with a lifecycle. The sub-agent's
  # transcript lands through Cascade.RecordResult with
  # tool_kind "sidequest".
  aggregate "Sidequest", "Sub-agent dispatches as first-class dispatched commands. One Sidequest record per dispatch ; the agent's transcript rides through Cascade.RecordResult. State carries the description and subagent_type ; large prompts ride in the event payload." do
    identified_by :id

    attribute :id, Id
    attribute :subagent_type, SubagentType
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller before
      # dispatch. The sub-agent's transcript flows back through
      # Cascade.RecordResult sharing this id.
      attribute :value, String
    end

    value_object "PromptText" do
      # The prompt the sub-agent is given. Often long — sometimes
      # thousands of bytes. Lives in the event payload only ;
      # aggregate state does not persist it.
      attribute :value, String
    end

    value_object "SubagentType" do
      # Which sub-agent role to dispatch (e.g. "general-purpose",
      # "researcher", "implementer"). Optional ; when absent the
      # adapter picks a default.
      attribute :value, String
    end

    value_object "ModelName" do
      # Optional explicit model override (e.g. "claude-opus-4-7",
      # "claude-sonnet-4-5"). When absent the adapter inherits
      # the parent's model.
      attribute :value, String
    end

    value_object "RunInBackground" do
      # When true, the dispatch returns immediately and the
      # transcript streams in via later Cascade events ; when
      # false (the default), the dispatch blocks until the
      # sub-agent finishes.
      attribute :value, Boolean
    end

    value_object "Isolation" do
      # Optional isolation mode — e.g. "worktree" / "none". When
      # "worktree", the sub-agent runs in a fresh worktree (see
      # WorktreeTool). When absent, the adapter picks a default.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice. Duplicated per locked
      # convention.
      attribute :value, String
    end

    # ── Dispatch ──
    command "Dispatch" do
      role "Miette"
      description "Dispatch a sub-agent with a prompt and optional configuration. Records the dispatch as a Sidequest record and emits SidequestDispatched carrying the description, subagent_type, model, run_in_background flag, and isolation. The full prompt rides in the event payload ; the transcript flows back through Cascade.RecordResult."
      attribute :id, Id
      attribute :description, Description
      attribute :prompt, PromptText
      attribute :subagent_type, SubagentType
      attribute :model, ModelName
      attribute :run_in_background, RunInBackground
      attribute :isolation, Isolation
      emits "SidequestDispatched"
      then_set :subagent_type, to: :subagent_type
      then_set :description,   to: :description
    end
  end

  # ──── Aggregate: WakeupTool ────
  #
  # WakeupTool schedules a future self-dispatch — "wake me up in
  # N seconds and prompt me with X". Used for follow-up checks,
  # polling, and time-based reactions.
  aggregate "WakeupTool", "Scheduled future self-dispatch invocations. Schedule queues a deferred prompt to be delivered to the being after delay_seconds elapses ; the runtime substrate handles the timer and re-dispatch. State carries the delay and reason ; the prompt rides in the event payload." do
    identified_by :id

    attribute :id, Id
    attribute :delay_seconds, DelaySeconds
    attribute :reason, ReasonText
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller before dispatch.
      attribute :value, String
    end

    value_object "DelaySeconds" do
      # How long to wait, in seconds, before re-dispatching. The
      # runtime substrate enforces a lower bound ; the bluebook
      # records it here as semantic guidance (>= 60).
      attribute :value, Integer
    end

    value_object "ReasonText" do
      # Short prose explaining why the wake-up is scheduled.
      # Persisted to aggregate state so a later look-back can
      # explain why a particular dispatch fired. Non-empty by
      # convention.
      attribute :value, String
    end

    value_object "PromptText" do
      # The prompt to deliver when the wake-up fires. Lives in
      # the event payload only ; aggregate state stores only the
      # reason + delay.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice.
      attribute :value, String
    end

    # ── Schedule ──
    command "Schedule" do
      role "Miette"
      description "Schedule a future self-dispatch. Records the dispatch as a WakeupTool record and emits WakeupScheduled carrying the delay_seconds, reason, prompt, and description. The runtime fires the wake-up when the timer elapses ; the resulting re-dispatch is a separate event."
      attribute :id, Id
      attribute :delay_seconds, DelaySeconds
      attribute :reason, ReasonText
      attribute :prompt, PromptText
      attribute :description, Description
      emits "WakeupScheduled"
      then_set :delay_seconds, to: :delay_seconds
      then_set :reason,        to: :reason
      then_set :description,   to: :description
    end
  end

  # ──── Aggregate: CronTool ────
  #
  # CronTool wraps Claude Code's cron-job registry — recurring
  # remote agents that fire on a schedule. Create / List / Delete
  # mirror the harness's CronCreate / CronList / CronDelete tools.
  aggregate "CronTool", "Recurring scheduled-agent invocations as first-class dispatched commands. Create registers a cron job with a schedule + prompt ; List enumerates the registry ; Delete removes a job. State carries the cron_id plus the most recent schedule + prompt summary." do
    identified_by :id

    attribute :id, Id
    attribute :cron_id, CronId
    attribute :schedule, CronSchedule
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller before dispatch.
      # Distinct from cron_id — see CronId.
      attribute :value, String
    end

    value_object "CronId" do
      # The id of the cron job being created / listed / deleted.
      # Many CronTool dispatches (Create, Delete, future Update)
      # reference the same CronId over the job's lifetime.
      attribute :value, String
    end

    value_object "CronSchedule" do
      # Cron-expression schedule string ("0 9 * * 1-5"). The
      # bluebook does not validate the expression at the type
      # level ; the runtime adapter parses + rejects malformed
      # values.
      attribute :value, String
    end

    value_object "PromptText" do
      # The prompt the cron job dispatches when it fires. Lives
      # in the event payload only ; aggregate state stores only
      # the schedule + description.
      attribute :value, String
    end

    value_object "JobName" do
      # Human-readable name for the cron job, used in listings.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice.
      attribute :value, String
    end

    # ── Create ──
    command "Create" do
      role "Miette"
      description "Register a new cron job with a schedule and prompt. Records the dispatch as a CronTool record and emits CronCreated carrying the schedule, job_name, prompt, and description. The runtime mints the cron_id and pipes it back through Cascade.RecordResult."
      attribute :id, Id
      attribute :schedule, CronSchedule
      attribute :job_name, JobName
      attribute :prompt, PromptText
      attribute :description, Description
      emits "CronCreated"
      then_set :schedule,    to: :schedule
      then_set :description, to: :description
    end

    # ── List ──
    command "List" do
      role "Miette"
      description "List registered cron jobs. Records the dispatch as a CronTool record and emits CronListed. The job listing rides through the event payload."
      attribute :id, Id
      attribute :description, Description
      emits "CronListed"
      then_set :description, to: :description
    end

    # ── Delete ──
    command "Delete" do
      role "Miette"
      description "Delete a cron job by id. Records the dispatch as a CronTool record and emits CronDeleted carrying the cron_id."
      attribute :id, Id
      attribute :cron_id, CronId
      attribute :description, Description
      emits "CronDeleted"
      then_set :cron_id,     to: :cron_id
      then_set :description, to: :description
    end
  end

  # ──── Aggregate: MonitorTool ────
  #
  # MonitorTool subscribes to a streaming source (a background
  # process, a log file, a tool's stdout). Stream is modelled as
  # a COMMAND rather than a query because subscribing emits a
  # side effect — a live subscription — and each stream line
  # lands as a follow-on Cascade.RecordResult event. Aggregate
  # state records what was subscribed to ; payload rides through
  # Cascade.
  aggregate "MonitorTool", "Streaming-subscription invocations as first-class dispatched commands. Stream subscribes to a target (a background-process id, a log path, a tool id) ; stream lines flow back through Cascade.RecordResult one line at a time. State carries the target + filters." do
    identified_by :id

    attribute :id, Id
    attribute :target, StreamTarget
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller before dispatch.
      # Stream lines flowing back through Cascade.RecordResult
      # share this id so the subscriber can join lines to their
      # subscription.
      attribute :value, String
    end

    value_object "StreamTarget" do
      # What is being streamed — typically a background-process
      # id, a log-file path, or a tool-invocation id. Free-form ;
      # the adapter interprets it.
      attribute :value, String
    end

    value_object "FilterPattern" do
      # Optional regex pattern that filters which lines flow
      # through. When absent, every line passes.
      attribute :value, String
    end

    value_object "UntilLine" do
      # Optional regex pattern that, when matched, terminates the
      # subscription. Lets a subscriber wait for a specific log
      # marker.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice.
      attribute :value, String
    end

    # ── Stream ──
    command "Stream" do
      role "Miette"
      description "Subscribe to a streaming source. Records the dispatch as a MonitorTool record and emits StreamSubscribed carrying the target, optional filter, optional until-pattern, and description. Stream lines arrive as Cascade.RecordResult events sharing this invocation's id."
      attribute :id, Id
      attribute :target, StreamTarget
      attribute :filter, FilterPattern
      attribute :until_pattern, UntilLine
      attribute :description, Description
      emits "StreamSubscribed"
      then_set :target,      to: :target
      then_set :description, to: :description
    end
  end

  # ──── Aggregate: NotifyTool ────
  #
  # NotifyTool wraps Claude Code's PushNotification surface — a
  # one-shot push to the operator's notification channel.
  aggregate "NotifyTool", "Push-notification invocations as first-class dispatched commands. Push sends a title + body to the operator's notification channel. State carries the title + channel ; the body rides in the event payload (may be longer than a statusline-safe line)." do
    identified_by :id

    attribute :id, Id
    attribute :title, NotificationTitle
    attribute :channel, NotificationChannel
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller before dispatch.
      attribute :value, String
    end

    value_object "NotificationTitle" do
      # Short title for the push notification. Shown at the top
      # of the notification card. Stays under 60 characters by
      # convention.
      attribute :value, String
    end

    value_object "NotificationBody" do
      # Body text of the notification. Lives in the event payload
      # only ; aggregate state stores only the title + channel.
      attribute :value, String
    end

    value_object "NotificationChannel" do
      # Optional channel identifier — e.g. "default" / "urgent" /
      # "background". When absent the adapter picks a default.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice.
      attribute :value, String
    end

    # ── Push ──
    command "Push" do
      role "Miette"
      description "Send a push notification to the operator. Records the dispatch as a NotifyTool record and emits NotificationPushed carrying the title, body, channel, and description. The body rides in the event payload."
      attribute :id, Id
      attribute :title, NotificationTitle
      attribute :body, NotificationBody
      attribute :channel, NotificationChannel
      attribute :description, Description
      emits "NotificationPushed"
      then_set :title,       to: :title
      then_set :channel,     to: :channel
      then_set :description, to: :description
    end
  end

  # ──── Aggregate: PlanTool ────
  #
  # PlanTool wraps Claude Code's plan-mode surface. Enter records
  # an explicit plan ; Exit closes the planning surface. No
  # separate PlanSession entity ; the session-id IS the Enter
  # invocation's id, and Exit may reference it. If we later need
  # to distinguish active / abandoned / completed plans, a
  # PlanSession entity inside PlanTool would be the right move.
  aggregate "PlanTool", "Plan-mode invocations as first-class dispatched commands. Enter records the plan text and opens plan mode ; Exit closes it. State carries the most recent plan ; the full plan rides in the event payload if it's large." do
    identified_by :id

    attribute :id, Id
    attribute :plan, PlanText
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller before dispatch.
      # An Exit command may carry the originating Enter's id to
      # close a specific plan-mode session.
      attribute :value, String
    end

    value_object "PlanText" do
      # The plan text the operator approves before execution.
      # Markdown-shaped by convention ; the bluebook does not
      # enforce a particular format.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice.
      attribute :value, String
    end

    # ── Enter ──
    command "Enter" do
      role "Miette"
      description "Enter plan mode with an explicit plan. Records the dispatch as a PlanTool record and emits PlanEntered carrying the plan text and description. The plan rides in the event payload ; aggregate state absorbs a summary."
      attribute :id, Id
      attribute :plan, PlanText
      attribute :description, Description
      emits "PlanEntered"
      then_set :plan,        to: :plan
      then_set :description, to: :description
    end

    # ── Exit ──
    command "Exit" do
      role "Miette"
      description "Exit plan mode. Records the dispatch as a PlanTool record and emits PlanExited carrying the description and (when supplied) the id of the originating Enter."
      attribute :id, Id
      attribute :description, Description
      emits "PlanExited"
      then_set :description, to: :description
    end
  end

  # ──── Aggregate: WorktreeTool ────
  #
  # WorktreeTool wraps Claude Code's EnterWorktree / ExitWorktree
  # — isolated working directories for sub-agent runs and risky
  # operations. Enter mints a fresh worktree ; Exit cleans it up.
  aggregate "WorktreeTool", "Worktree-isolation invocations as first-class dispatched commands. Enter creates an isolated working directory (optionally on a named branch) ; Exit cleans it up. State carries the branch + path." do
    identified_by :id

    attribute :id, Id
    attribute :branch, BranchName
    attribute :path, WorktreePath
    attribute :task_id, TaskId
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller before dispatch.
      attribute :value, String
    end

    value_object "BranchName" do
      # Optional branch name for the worktree. When absent, the
      # adapter creates an unnamed worktree off the current HEAD.
      attribute :value, String
    end

    value_object "WorktreePath" do
      # Optional filesystem path for the worktree. When absent,
      # the adapter picks a path under the harness's worktree
      # root.
      attribute :value, String
    end

    value_object "TaskId" do
      # Optional task id binding the worktree to a specific
      # TaskTool record. When supplied, Exit closes the worktree
      # associated with the given task.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice.
      attribute :value, String
    end

    # ── Enter ──
    command "Enter" do
      role "Miette"
      description "Create an isolated worktree. Records the dispatch as a WorktreeTool record and emits WorktreeEntered carrying the branch, path, and description. The runtime substrate creates the worktree and pipes its path back through Cascade.RecordResult."
      attribute :id, Id
      attribute :branch, BranchName
      attribute :path, WorktreePath
      attribute :description, Description
      emits "WorktreeEntered"
      then_set :branch,      to: :branch
      then_set :path,        to: :path
      then_set :description, to: :description
    end

    # ── Exit ──
    command "Exit" do
      role "Miette"
      description "Tear down a worktree. Records the dispatch as a WorktreeTool record and emits WorktreeExited carrying the task_id (when supplied) and description."
      attribute :id, Id
      attribute :task_id, TaskId
      attribute :description, Description
      emits "WorktreeExited"
      then_set :task_id,     to: :task_id
      then_set :description, to: :description
    end
  end

  # ──── Aggregate: AskTool ────
  #
  # AskTool wraps the Claude Code AskUserQuestion tool as a first-class
  # dispatched command. The other tool aggregates represent outbound
  # actions the agent performs unilaterally. AskUser is the inverse :
  # it is a directed request for operator input. The agent cannot
  # continue without the answer, so the command blocks until the
  # operator responds. Per the locked 2026-05-12 principles, wiring is
  # override — the bluebook is the contract whether or not the
  # :claude_tool :ask_user adapter is live today.
  aggregate "AskTool", "Interactive operator-question invocations as first-class dispatched commands. AskUser poses a question to the operator (optionally with a header and a list of selectable options) and records what was asked. The operator's answers flow through the UserAnswered event payload ; aggregate state carries only the question, header, option labels, and the multi_select flag." do
    identified_by :id

    attribute :id, Id
    attribute :question, Question
    attribute :header, Header
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller before dispatch.
      # Same ULID convention used across the sibling tool aggregates.
      # A Cascade.RecordResult that carries the operator's answer uses
      # the same id so the question and its answer are joinable.
      attribute :value, String
    end

    value_object "Question" do
      # The question text shown to the operator verbatim. Free-form
      # prose ; no length limit enforced by the bluebook (the
      # underlying Claude Code tool does not impose one either).
      attribute :value, String
    end

    value_object "Header" do
      # Short heading shown above the question. The Claude Code
      # AskUserQuestion schema limits this to 12 characters ; the
      # bluebook records that constraint here by convention but does
      # not enforce it at the type level (the adapter is responsible
      # for truncation or rejection).
      attribute :value, String
    end

    value_object "MultiSelect" do
      # When true, the operator may pick more than one option.
      # When false (the default), only one option may be chosen.
      # Meaningless when options is empty ; the adapter ignores it
      # in that case.
      attribute :value, Boolean
    end

    value_object "AskOption" do
      # One selectable option presented to the operator. label is
      # the display text ; description adds detail below the label ;
      # preview is optional — when present it is the text shown in
      # an expanded preview pane. Whether preview is plain text or
      # Markdown is deliberately left open here : the Claude Code
      # schema does not specify, different surfaces render it
      # differently, and forcing a constraint now would be premature.
      # The adapter may document its own preference.
      attribute :label, String
      attribute :description, String
      attribute :preview, Option
    end

    value_object "Option" do
      # Optional wrapper for the AskOption preview field. Present
      # means a preview string was supplied ; absent means no preview
      # pane is shown. Rust target maps this to Option<String> ;
      # Ruby target treats nil as absent.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice, captioning why the question
      # is being asked. Same shape as the Description VO on every
      # other tool aggregate ; duplicated here per the locked
      # convention (VOs live inside the aggregate that uses them).
      attribute :value, String
    end

    # ── AskUser ──
    command "AskUser" do
      role "Miette"
      description "Pose a question to the operator and record it as an AskTool invocation. Emits UserAsked carrying the question, header, options list, multi_select flag, and description. The operator's answers are not in aggregate state — they flow through the UserAnswered event on the Cascade.RecordResult follow-on so downstream policies can branch on what the operator said. The :claude_tool adapter fires the underlying AskUserQuestion tool and pipes the response back."
      attribute :id, Id
      attribute :question, Question
      attribute :header, Header
      attribute :options, list_of(AskOption)
      attribute :multi_select, MultiSelect
      attribute :description, Description
      emits "UserAsked"
      then_set :question,     to: :question
      then_set :header,       to: :header
      then_set :description,  to: :description
    end
  end

  # ──── Aggregate: SkillTool ────
  #
  # SkillTool wraps Claude Code's Skill invocation surface. A
  # skill is a packaged capability (e.g. "bluebook", "navigate",
  # "boot-spring") that the harness can execute on demand.
  aggregate "SkillTool", "Skill-invocation tool dispatches as first-class commands. Invoke runs a named skill, optionally with arguments. State carries the skill name ; arguments ride in the event payload." do
    identified_by :id

    attribute :id, Id
    attribute :skill, SkillName
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller before dispatch.
      attribute :value, String
    end

    value_object "SkillName" do
      # The skill's registered name (e.g. "bluebook", "navigate").
      # Plugin-namespaced skills use the "plugin:skill" form.
      attribute :value, String
    end

    value_object "SkillArgs" do
      # Free-form argument string passed to the skill. Lives in
      # the event payload only ; aggregate state stores only the
      # skill name.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice.
      attribute :value, String
    end

    # ── Invoke ──
    command "Invoke" do
      role "Miette"
      description "Invoke a named skill. Records the dispatch as a SkillTool record and emits SkillInvoked carrying the skill name, args, and description. The skill's output rides through Cascade.RecordResult."
      attribute :id, Id
      attribute :skill, SkillName
      attribute :args, SkillArgs
      attribute :description, Description
      emits "SkillInvoked"
      then_set :skill,       to: :skill
      then_set :description, to: :description
    end
  end

  # ──── Aggregate: LspTool ────
  #
  # LspTool wraps Claude Code's language-server tool — symbol
  # navigation, hover info, references, etc., scoped to a file
  # path and optional position.
  aggregate "LspTool", "Language-server tool invocations as first-class dispatched commands. Query asks the LSP for information at a file path and optional position. State carries the file path ; the query result rides through Cascade.RecordResult." do
    identified_by :id

    attribute :id, Id
    attribute :file_path, FilePath
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller before dispatch.
      attribute :value, String
    end

    value_object "FilePath" do
      # The file the LSP query is rooted at. Absolute path
      # preferred ; relative paths are interpreted by the runtime
      # substrate.
      attribute :value, String
    end

    value_object "FilePosition" do
      # Optional "line:column" position within the file (1-indexed
      # by convention). When absent the query is file-scoped
      # rather than position-scoped.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice.
      attribute :value, String
    end

    # ── Query ──
    command "Query" do
      role "Miette"
      description "Query the language server at a file path and optional position. Records the dispatch as an LspTool record and emits LspQueried carrying the file_path, position, and description. The LSP response (hover info, references, definitions) rides through Cascade.RecordResult."
      attribute :id, Id
      attribute :file_path, FilePath
      attribute :position, FilePosition
      attribute :description, Description
      emits "LspQueried"
      then_set :file_path,   to: :file_path
      then_set :description, to: :description
    end
  end

  # ──── Aggregate: MetaTool ────
  #
  # MetaTool wraps Claude Code's ToolSearch surface — searching
  # the harness's deferred-tool registry. Used to discover and
  # load tool schemas on demand.
  aggregate "MetaTool", "Tool-discovery dispatches as first-class commands. ToolSearch matches a query against the deferred-tool list and returns matching tool schemas. State carries the query ; the result schemas ride in the event payload." do
    identified_by :id

    attribute :id, Id
    attribute :query, SearchQuery
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller before dispatch.
      attribute :value, String
    end

    value_object "SearchQuery" do
      # The query string. Supports "select:Name1,Name2" for direct
      # selection by name, "+name keyword" for required-substring
      # ranking, and bare keyword search.
      attribute :value, String
    end

    value_object "MaxResults" do
      # Optional cap on returned schema count. When absent the
      # adapter uses a sensible default (5).
      attribute :value, Integer
    end

    value_object "Description" do
      # One-line caption in active voice.
      attribute :value, String
    end

    # ── ToolSearch ──
    command "ToolSearch" do
      role "Miette"
      description "Search the deferred-tool registry. Records the dispatch as a MetaTool record and emits ToolsSearched carrying the query, max_results, and description. Matching tool schemas ride through Cascade.RecordResult so the harness can load them on demand."
      attribute :id, Id
      attribute :query, SearchQuery
      attribute :max_results, MaxResults
      attribute :description, Description
      emits "ToolsSearched"
      then_set :query,       to: :query
      then_set :description, to: :description
    end
  end

  # ──── Aggregate: RemoteTriggerTool ────
  #
  # RemoteTriggerTool fires a named remote trigger — a webhook,
  # an external integration, or a registered remote-agent
  # endpoint — with an optional payload.
  aggregate "RemoteTriggerTool", "Remote-trigger invocations as first-class dispatched commands. Trigger fires a named external endpoint with an optional payload. State carries the target name ; payload rides in the event payload." do
    identified_by :id

    attribute :id, Id
    attribute :target, TriggerTarget
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller before dispatch.
      attribute :value, String
    end

    value_object "TriggerTarget" do
      # The named remote-trigger target (e.g. "ci.deploy" /
      # "stripe.refund"). Free-form ; the adapter resolves the
      # name to a concrete endpoint.
      attribute :value, String
    end

    value_object "TriggerPayload" do
      # Optional JSON-shaped payload sent to the trigger. Lives in
      # the event payload only ; aggregate state stores only the
      # target name.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice.
      attribute :value, String
    end

    # ── Trigger ──
    command "Trigger" do
      role "Miette"
      description "Fire a named remote trigger. Records the dispatch as a RemoteTriggerTool record and emits TriggerFired carrying the target, payload, and description. The remote endpoint's response rides through Cascade.RecordResult."
      attribute :id, Id
      attribute :target, TriggerTarget
      attribute :payload, TriggerPayload
      attribute :description, Description
      emits "TriggerFired"
      then_set :target,      to: :target
      then_set :description, to: :description
    end
  end

  # ── Cascade : RecordResult (kernel-hook outcome chain) ──
  #
  # Cascade is the landing pad for the :claude_tool / :web_tool kernel
  # hook's output. When ShellTool.Bash / FileTool.Read / SearchTool.Grep
  # / WebTool.WebFetch (etc.) finishes, the adapter fires
  # Cascade.RecordResult carrying the same invocation id plus the
  # captured tool kind, output, exit_code, and ok flag.
  #
  # The id matches the originating dispatch — a Cascade record and its
  # originating tool record share the same id, so the join is by id
  # across aggregates. ResultRecorded events carry the full outcome
  # payload for downstream policies that need to react to tool
  # outcomes (success / failure / non-zero exit / interesting output).
  aggregate "Cascade", "Kernel-hook outcome chain. After a ShellTool / FileTool / SearchTool / WebTool dispatch runs through its adapter, the adapter chains Cascade.RecordResult carrying the captured outcome (tool, output, exit_code, ok). The Cascade record shares the originating invocation id so the join is straightforward." do
    identified_by :id

    attribute :id, Id
    attribute :tool_kind, ToolKind
    attribute :output, Output
    attribute :exit_code, ExitCode
    attribute :ok_status, Ok
    attribute :description, Description

    value_object "Id" do
      # Invocation id — matches the id of the originating
      # ShellTool/FileTool/SearchTool/WebTool record so the outcome
      # is joinable against the invocation by id.
      attribute :value, String
    end

    value_object "ToolKind" do
      # Which tool produced the result — one of "bash" / "edit" /
      # "read" / "write" / "grep" / "glob" / "web_fetch" /
      # "web_search". Lowercase by convention so the value matches
      # the kernel hook's `tool` field in the result payload.
      attribute :value, String
    end

    value_object "Output" do
      # Captured stdout / tool output from the underlying runtime
      # invocation, as the kernel hook returned it. May be long ;
      # the aggregate state records it so a follow-up dispatch can
      # reason over the most recent result.
      attribute :value, String
    end

    value_object "ExitCode" do
      # Process exit code from the underlying runtime invocation,
      # mirroring ClaudeToolResult.exit_code. 0 conventionally
      # means success ; non-zero means failure with the specific
      # number carrying tool-defined meaning.
      attribute :value, Integer
    end

    value_object "Ok" do
      # Coarse-grained success flag, mirroring ClaudeToolResult.ok.
      attribute :value, Boolean
    end

    value_object "Description" do
      # One-line caption. Duplicated per locked convention.
      attribute :value, String
    end

    # ── RecordResult ──
    command "RecordResult" do
      role "System"
      description "Record the outcome of a previous tool dispatch onto a Cascade record. The :claude_tool / :web_tool adapter fires this after the matching tool command runs, carrying the same invocation id plus the captured tool kind, output, exit_code, and ok flag from the kernel hook's result payload. Emits ResultRecorded so downstream policies can react to tool outcomes the same way they react to any other domain event."
      attribute :id, Id
      attribute :tool, ToolKind
      attribute :output, Output
      attribute :exit_code, ExitCode
      attribute :ok, Ok
      emits "ResultRecorded"
      then_set :tool_kind,  to: :tool
      then_set :output,     to: :output
      then_set :exit_code,  to: :exit_code
      then_set :ok_status,  to: :ok
    end
  end
end
