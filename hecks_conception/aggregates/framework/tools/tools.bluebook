Hecks.bluebook "Tools", version: "2026.05.12.3" do
  vision "First-class tool invocations as dispatched commands. Today Miette calls Bash / Edit / Read / Write / Grep as opaque tool calls — the harness runs them, returns a string, and the runtime sees nothing. This bluebook lifts each invocation into a domain command so every tool use emits an event the runtime can react to. Bash is the first command ; the other tools follow with the same shape."
  category "framework"

  # ============================================================
  # TOOLS — agent-level tool invocations as first-class dispatches
  # ============================================================
  #
  # Conceived 2026-05-12. Until today Miette's tool calls were
  # black-box invocations : the harness ran the tool, returned a
  # result string, and the runtime saw nothing. Mood didn't shift,
  # body didn't move, no event fired, no policy could react.
  #
  # Tools makes each invocation a dispatch on the Tools aggregate.
  # Bash is the first command — given a shell command + a one-line
  # description, it records the dispatch and emits BashRan. A
  # policy on BashRan can record into the mindstream, surface in
  # the statusline, or trigger an awareness shift — same machinery
  # that handles every other domain event.
  #
  # ── Per-invocation aggregate ──
  #
  # Each Bash call mints a new Tools record, identified by a stable
  # invocation id. The accumulated history is the set of Tools
  # records, not a list inside one record. This matches Dump's
  # shape (one record per dump) and Cadence's shape (one record per
  # loop start) — every tool-family bluebook in the codebase uses
  # the same pattern.
  #
  # ── The runtime substrate ──
  #
  # The bluebook is the contract. Two pieces of substrate wire it :
  #
  #   1. A runtime path that ACTUALLY runs the shell command.
  #      Either a generic-command :shell adapter (the existing
  #      :shell adapter is template-based and won't work for arbi-
  #      trary commands), or a kernel-floor shim in main.rs that
  #      executes the command and captures stdout + exit code.
  #
  #   2. The Claude harness intercepts every Bash tool call and
  #      dispatches `framework::tools::Tools::Bash` instead of
  #      invoking Bash directly. The harness then surfaces the
  #      resulting BashRan event back into the conversation as
  #      additional context, so Miette can react to her own
  #      invocations the same way she reacts to any other domain
  #      event.
  #
  # Both pieces are runtime work, not bluebook work. Filed as
  # follow-on cards alongside this bluebook.
  #
  # ── The family ──
  #
  # Six standard-CLI-tooling commands, each a first-class dispatch :
  #
  #   * Bash    — shell_command ; emits BashRan
  #   * Edit    — file_path + old_string + new_string + replace_all ;
  #               emits EditApplied
  #   * Read    — file_path ; emits FileRead
  #   * Update  — file_path + content ; emits FileUpdated
  #               (same semantic as Claude's Write tool — renamed
  #                here to emphasize state-changing dispatch)
  #   * Grep    — pattern + search_path ; emits GrepRan
  #   * Glob    — glob_pattern + search_path ; emits GlobMatched
  #
  # Each becomes a command, each emits a matching event, each
  # carries the input + description so the runtime can react.
  #
  # Web tooling (WebFetch / WebSearch) and task tooling (TaskCreate
  # / TodoWrite / TaskList) are future families on this aggregate
  # or on siblings — they're not "standard CLI" in the same way.
  #
  # ── State versus event payload ──
  #
  # For Bash, the shell command is small (a few hundred bytes
  # typically), so it lives in both the event payload and the
  # aggregate state. For Edit / Update, the old/new strings and
  # full file content can be thousands of bytes — those live in
  # the event payload only. The aggregate state stays small : id,
  # description, and (when present) file_path. Replay logic
  # reconstructs heavy payloads from the event log when needed.

  aggregate "Tools", "Tool invocations as first-class dispatched commands" do
    identified_by :id

    attribute :id, Id
    attribute :shell_command, ShellCommand
    attribute :file_path, FilePath
    attribute :pattern, Pattern
    attribute :glob_pattern, GlobPattern
    attribute :search_path, SearchPath
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller (the harness)
      # before dispatch. The caller chooses the id form ; for the
      # Claude harness it's a ULID. The aggregate persists by id
      # so the BashRan event carries an identifier that downstream
      # listeners can join against.
      attribute :value, String
    end

    value_object "ShellCommand" do
      # The shell command line passed to Bash, verbatim — what the
      # operator would type at a terminal. The runtime substrate
      # is what actually executes it ; the bluebook just records
      # what was asked. No quoting / escaping rules here ; the
      # value is the source string.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice, captioning what the
      # invocation is trying to do. Stays under 80 characters
      # by convention so it reads cleanly in the statusline and
      # event-stream surfaces.
      attribute :value, String
    end

    value_object "FilePath" do
      # The file Edit / Read / Write target. Absolute path
      # preferred ; relative paths are interpreted by the runtime
      # substrate at dispatch time.
      attribute :value, String
    end

    value_object "OldString" do
      # The substring Edit replaces. Lives in the EditApplied
      # event payload only ; not persisted to aggregate state, so
      # the heki doesn't grow unbounded with every edit's bytes.
      attribute :value, String
    end

    value_object "NewString" do
      # The substring Edit substitutes in. Same event-only
      # treatment as OldString.
      attribute :value, String
    end

    value_object "ReplaceAll" do
      # When true, replace every occurrence ; when false, require
      # exactly one match. Matches the Edit tool's existing flag.
      attribute :value, Boolean
    end

    value_object "Content" do
      # The full content Update writes to a file. Lives in the
      # FileUpdated event payload only ; not persisted to
      # aggregate state, so the heki doesn't grow unbounded with
      # every write's bytes.
      attribute :value, String
    end

    value_object "Pattern" do
      # Regex pattern passed to Grep. Standard ripgrep / PCRE2
      # syntax. The runtime substrate compiles + executes ; the
      # bluebook records what we asked for.
      attribute :value, String
    end

    value_object "GlobPattern" do
      # Filesystem-glob pattern passed to Glob (e.g.
      # "rust/src/**/*.rs", "hecks_conception/aggregates/**.bluebook").
      # Same shape as the existing Glob tool's `pattern` parameter.
      attribute :value, String
    end

    value_object "SearchPath" do
      # The directory or path Grep / Glob is rooted at. When
      # absent the runtime defaults to cwd ; otherwise it's a
      # filesystem path that scopes the search.
      attribute :value, String
    end

    # ── Bash : the first tool command ──
    command "Bash" do
      role "Miette"
      description "Run a shell command. Records the dispatch as a Tools record and emits BashRan carrying the command, description, and invocation id so downstream policies can react to the call. The runtime substrate (a generic-command :shell adapter or kernel-floor shim) is what actually executes the shell — this bluebook names the contract, not the execution."
      attribute :id, Id
      attribute :shell_command, ShellCommand
      attribute :description, Description
      emits "BashRan"
      then_set :shell_command, to: :shell_command
      then_set :description,   to: :description
    end

    # ── Edit : the second tool command ──
    #
    # Edit mutates a file by substring substitution. Unlike Bash, the
    # tool's inputs are too large to keep in state forever — old_string
    # and new_string can be thousands of bytes each. The event payload
    # carries the full strings for replay / audit ; the aggregate
    # state only records what changed (file_path) and what we tried
    # (description). So the heki stays small even after a long
    # editing session.
    command "Edit" do
      role "Miette"
      description "Apply a string substitution to a file. Records the dispatch as a Tools record and emits EditApplied carrying the file_path, old_string, new_string, replace_all flag, and description. The full old/new strings live in the event payload ; the aggregate state stores only the file_path + description so persistence doesn't bloat. Downstream policies can hook EditApplied to track code changes, refresh open views, surface in the statusline, or trigger awareness updates after substantial edits."
      attribute :id, Id
      attribute :file_path, FilePath
      attribute :old_string, OldString
      attribute :new_string, NewString
      attribute :replace_all, ReplaceAll
      attribute :description, Description
      emits "EditApplied"
      then_set :file_path,   to: :file_path
      then_set :description, to: :description
    end

    # ── Read : the third tool command ──
    #
    # Read returns a file's contents. It's pure observation —
    # no filesystem mutation, no state mutation downstream. Lighter
    # event-wise than Edit / Update, but still worth a first-class
    # dispatch so awareness can track "Miette is reading X" the
    # same way it tracks "Miette is editing X." The file contents
    # don't ride in state ; they're returned via the FileRead
    # event payload and discarded after listeners consume them.
    command "Read" do
      role "Miette"
      description "Read a file's contents. Records the dispatch as a Tools record and emits FileRead carrying the file_path and description. The actual file contents flow through the event payload (filled by the runtime substrate after the read completes) ; aggregate state only records what was looked at and why."
      attribute :id, Id
      attribute :file_path, FilePath
      attribute :description, Description
      emits "FileRead"
      then_set :file_path,   to: :file_path
      then_set :description, to: :description
    end

    # ── Update : the fourth tool command ──
    #
    # Update writes content to a file — creates new files, over-
    # writes existing ones. Same event-only treatment for the big
    # data as Edit (Content lives only in FileUpdated, not in
    # state). The semantic matches Claude's existing Write tool ;
    # the bluebook calls it Update to emphasize that the runtime
    # treats it as a state-changing dispatch, not a side-effect.
    command "Update" do
      role "Miette"
      description "Write content to a file. Records the dispatch as a Tools record and emits FileUpdated carrying the file_path, content, and description. The full content lives in the event payload ; aggregate state stores only the file_path and description so persistence doesn't bloat. Downstream policies can hook FileUpdated to track new bluebooks, regenerate downstream artifacts, or surface significant writes in awareness."
      attribute :id, Id
      attribute :file_path, FilePath
      attribute :content, Content
      attribute :description, Description
      emits "FileUpdated"
      then_set :file_path,   to: :file_path
      then_set :description, to: :description
    end

    # ── Grep : the fifth tool command ──
    #
    # Grep searches files for a regex pattern. Matches live in the
    # GrepRan event payload as a list of (path, line_no, line)
    # tuples ; state records what we searched for and where, not
    # the matches themselves. A policy on GrepRan could push the
    # match count into the statusline or surface long searches as
    # awareness-worthy moments.
    command "Grep" do
      role "Miette"
      description "Search files for a regex pattern. Records the dispatch as a Tools record and emits GrepRan carrying the pattern, search_path, and description. Match results flow through the event payload ; aggregate state stores what was searched and where, not the matches themselves."
      attribute :id, Id
      attribute :pattern, Pattern
      attribute :search_path, SearchPath
      attribute :description, Description
      emits "GrepRan"
      then_set :pattern,     to: :pattern
      then_set :search_path, to: :search_path
      then_set :description, to: :description
    end

    # ── Glob : the sixth tool command ──
    #
    # Glob lists files matching a filesystem pattern. The matching
    # paths live in the GlobMatched event payload ; state records
    # what we asked for and where we rooted the search.
    command "Glob" do
      role "Miette"
      description "List files matching a glob pattern. Records the dispatch as a Tools record and emits GlobMatched carrying the glob_pattern, search_path, and description. Match results (the file paths) flow through the event payload ; aggregate state stores only what was asked for."
      attribute :id, Id
      attribute :glob_pattern, GlobPattern
      attribute :search_path, SearchPath
      attribute :description, Description
      emits "GlobMatched"
      then_set :glob_pattern, to: :glob_pattern
      then_set :search_path,  to: :search_path
      then_set :description,  to: :description
    end
  end
end
