Hecks.bluebook "Tools", version: "2026.05.12.6" do
  vision "First-class tool invocations as dispatched commands, grouped by category. Each tool family is its own aggregate (ShellTool, FileTool, SearchTool, WebTool) ; the Cascade aggregate carries the kernel-hook's RecordResult chain. Replaces the earlier flat single-Tools aggregate (versions ≤ 2026.05.12.5) — sibling commands of unrelated kinds no longer share a single record. Per the locked 2026-05-12 conventions, every value object is declared INSIDE the aggregate that uses it ; duplication across aggregates (Id, Description, FilePath, SearchPath) is fine."
  category "framework"

  # ============================================================
  # TOOLS — agent-level tool invocations as first-class dispatches
  # ============================================================
  #
  # Conceived 2026-05-12 as a single flat Tools aggregate ; restructured
  # the same day into five category-shaped aggregates. The flat shape
  # piled nine unrelated commands onto one aggregate ("Tools record" had
  # to mean "any tool invocation, of any kind, possibly with most of its
  # state empty"). The category split makes each kind of invocation its
  # own aggregate with focused state — ShellTool records carry
  # shell_command, FileTool records carry file_path, SearchTool records
  # carry pattern/glob_pattern + search_path, WebTool records carry url
  # /prompt/query, Cascade records carry the kernel-hook's outcome
  # payload.
  #
  # ── The five categories ──
  #
  #   * ShellTool   — Bash               (shell exec)
  #   * FileTool    — Read, Edit, Update (file I/O)
  #   * SearchTool  — Grep, Glob         (filesystem search)
  #   * WebTool     — WebFetch, WebSearch (HTTP / search engine)
  #   * Cascade     — RecordResult       (kernel-hook outcome chain)
  #
  # Each aggregate is identified_by :id ; the harness mints a stable
  # ULID before dispatch and that's the addressable key. A Cascade
  # record uses the SAME id as the originating ShellTool/FileTool/
  # SearchTool/WebTool record so the outcome is joinable against the
  # invocation event by id.
  #
  # ── Why no entities ──
  #
  # Entities earn their place when a stateful sub-concept crosses
  # multiple commands within an aggregate. Here, each invocation is
  # an independent record keyed by id ; no sub-concept persists
  # across commands inside a single aggregate. ShellTool.Bash and
  # ShellTool... (any future shell command) would still each mint a
  # fresh record. So no entities — flat-by-design within each
  # category aggregate.
  #
  # ── The runtime substrate ──
  #
  # The bluebook is the contract. Two pieces of substrate wire it :
  #
  #   1. The :claude_tool adapter family (see
  #      framework/adapter_families/claude_tool.hecksagon) executes
  #      Bash / Edit / Read / Update / Grep / Glob natively.
  #
  #   2. The :web_tool adapter family (see
  #      framework/adapter_families/web_tool.hecksagon) handles
  #      WebFetch / WebSearch.
  #
  # Both adapter families chain their captured output through the
  # `result_into:` cascade — typically Cascade.RecordResult — so the
  # outcome becomes a first-class event the runtime can react to.
  #
  # ── State versus event payload ──
  #
  # For Bash, the shell command is small (a few hundred bytes
  # typically), so it lives in both the event payload and the
  # aggregate state. For Edit / Update, the old/new strings and
  # full file content can be thousands of bytes — those live in
  # the event payload only. Aggregate state stays small : id,
  # description, and (when present) file_path. Replay logic
  # reconstructs heavy payloads from the event log when needed.

  # ── ShellTool : Bash (shell exec) ──
  aggregate "ShellTool", "Shell-command invocations as first-class dispatched commands. Carries the verbatim shell command plus a one-line description ; the :claude_tool kernel hook executes it and chains the outcome into Cascade.RecordResult." do
    identified_by :id

    attribute :id, Id
    attribute :shell_command, ShellCommand
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller (the harness)
      # before dispatch. The caller chooses the id form ; for the
      # Claude harness it's a ULID. The aggregate persists by id so
      # the BashRan event carries an identifier that downstream
      # listeners (and the Cascade.RecordResult follow-on) can join
      # against.
      attribute :value, String
    end

    value_object "ShellCommand" do
      # The shell command line passed to Bash, verbatim — what the
      # operator would type at a terminal. The runtime substrate
      # is what actually executes it ; the bluebook just records
      # what was asked.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice, captioning what the
      # invocation is trying to do. Stays under 80 characters by
      # convention so it reads cleanly in the statusline and
      # event-stream surfaces.
      attribute :value, String
    end

    command "Bash" do
      role "Miette"
      description "Run a shell command. Records the dispatch as a ShellTool record and emits BashRan carrying the command, description, and invocation id so downstream policies can react to the call. The :claude_tool adapter actually executes the shell — this bluebook names the contract, not the execution."
      attribute :id, Id
      attribute :shell_command, ShellCommand
      attribute :description, Description
      emits "BashRan"
      then_set :shell_command, to: :shell_command
      then_set :description,   to: :description
    end
  end

  # ── FileTool : Read, Edit, Update (file I/O) ──
  aggregate "FileTool", "File-I/O tool invocations as first-class dispatched commands. Read is pure observation ; Edit applies a substring substitution ; Update writes content. State carries the file_path + description ; large payloads (old/new strings, full content) ride in the event payload only so persistence stays small." do
    identified_by :id

    attribute :id, Id
    attribute :file_path, FilePath
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller before dispatch.
      # Same shape as ShellTool/SearchTool/WebTool/Cascade — the
      # convention is one ULID per dispatched tool call, shared
      # with the corresponding Cascade.RecordResult so the outcome
      # is joinable by id.
      attribute :value, String
    end

    value_object "FilePath" do
      # The file Read / Edit / Update target. Absolute path
      # preferred ; relative paths are interpreted by the runtime
      # substrate at dispatch time.
      attribute :value, String
    end

    value_object "OldString" do
      # The substring Edit replaces. Lives in the EditApplied event
      # payload only ; not persisted to aggregate state, so the
      # heki doesn't grow unbounded with every edit's bytes.
      attribute :value, String
    end

    value_object "NewString" do
      # The substring Edit substitutes in. Same event-only
      # treatment as OldString.
      attribute :value, String
    end

    value_object "ReplaceAll" do
      # When true, replace every occurrence ; when false, require
      # exactly one match. Matches the Edit tool's existing flag.
      attribute :value, Boolean
    end

    value_object "Content" do
      # The full content Update writes to a file. Lives in the
      # FileUpdated event payload only ; not persisted to
      # aggregate state.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice. Same shape as the
      # Description VO on every other tool aggregate ; duplicated
      # here per the locked convention (VOs live inside the
      # aggregate that uses them).
      attribute :value, String
    end

    # ── Read ──
    command "Read" do
      role "Miette"
      description "Read a file's contents. Records the dispatch as a FileTool record and emits FileRead carrying the file_path and description. The actual file contents flow through the event payload (filled by the runtime substrate after the read completes) ; aggregate state only records what was looked at and why."
      attribute :id, Id
      attribute :file_path, FilePath
      attribute :description, Description
      emits "FileRead"
      then_set :file_path,   to: :file_path
      then_set :description, to: :description
    end

    # ── Edit ──
    command "Edit" do
      role "Miette"
      description "Apply a string substitution to a file. Records the dispatch as a FileTool record and emits EditApplied carrying the file_path, old_string, new_string, replace_all flag, and description. The full old/new strings live in the event payload ; aggregate state stores only the file_path + description."
      attribute :id, Id
      attribute :file_path, FilePath
      attribute :old_string, OldString
      attribute :new_string, NewString
      attribute :replace_all, ReplaceAll
      attribute :description, Description
      emits "EditApplied"
      then_set :file_path,   to: :file_path
      then_set :description, to: :description
    end

    # ── Update ──
    command "Update" do
      role "Miette"
      description "Write content to a file. Records the dispatch as a FileTool record and emits FileUpdated carrying the file_path, content, and description. The full content lives in the event payload ; aggregate state stores only the file_path and description. Same semantic as Claude's existing Write tool — renamed here to emphasize that the runtime treats it as a state-changing dispatch."
      attribute :id, Id
      attribute :file_path, FilePath
      attribute :content, Content
      attribute :description, Description
      emits "FileUpdated"
      then_set :file_path,   to: :file_path
      then_set :description, to: :description
    end
  end

  # ── SearchTool : Grep, Glob (filesystem search) ──
  aggregate "SearchTool", "Filesystem-search tool invocations as first-class dispatched commands. Grep finds regex matches ; Glob enumerates paths against a filesystem pattern. State carries what was searched for and where ; match results ride in the event payload." do
    identified_by :id

    attribute :id, Id
    attribute :pattern, Pattern
    attribute :glob_pattern, GlobPattern
    attribute :search_path, SearchPath
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller before dispatch.
      attribute :value, String
    end

    value_object "Pattern" do
      # Regex pattern passed to Grep. Standard ripgrep / PCRE2
      # syntax. The runtime substrate compiles + executes ; the
      # bluebook records what we asked for.
      attribute :value, String
    end

    value_object "GlobPattern" do
      # Filesystem-glob pattern passed to Glob (e.g.
      # "rust/src/**/*.rs", "hecks_conception/aggregates/**.bluebook").
      attribute :value, String
    end

    value_object "SearchPath" do
      # The directory or path Grep / Glob is rooted at. When
      # absent the runtime defaults to cwd ; otherwise it's a
      # filesystem path that scopes the search.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice. Duplicated per locked
      # convention (VOs inside each aggregate).
      attribute :value, String
    end

    # ── Grep ──
    command "Grep" do
      role "Miette"
      description "Search files for a regex pattern. Records the dispatch as a SearchTool record and emits GrepRan carrying the pattern, search_path, and description. Match results flow through the event payload ; aggregate state stores what was searched and where, not the matches themselves."
      attribute :id, Id
      attribute :pattern, Pattern
      attribute :search_path, SearchPath
      attribute :description, Description
      emits "GrepRan"
      then_set :pattern,     to: :pattern
      then_set :search_path, to: :search_path
      then_set :description, to: :description
    end

    # ── Glob ──
    command "Glob" do
      role "Miette"
      description "List files matching a glob pattern. Records the dispatch as a SearchTool record and emits GlobMatched carrying the glob_pattern, search_path, and description. Match results (the file paths) flow through the event payload ; aggregate state stores only what was asked for."
      attribute :id, Id
      attribute :glob_pattern, GlobPattern
      attribute :search_path, SearchPath
      attribute :description, Description
      emits "GlobMatched"
      then_set :glob_pattern, to: :glob_pattern
      then_set :search_path,  to: :search_path
      then_set :description,  to: :description
    end
  end

  # ── WebTool : WebFetch, WebSearch (HTTP / search engine) ──
  aggregate "WebTool", "Web tool invocations as first-class dispatched commands. WebFetch retrieves a URL and processes it with a prompt ; WebSearch runs a query against a search engine. State carries the url/prompt/query + description ; fetched content + result listings ride in the event payload." do
    identified_by :id

    attribute :id, Id
    attribute :url, Url
    attribute :prompt, FetchPrompt
    attribute :query, SearchQuery
    attribute :description, Description

    value_object "Id" do
      # Stable invocation id, minted by the caller before dispatch.
      attribute :value, String
    end

    value_object "Url" do
      # The URL passed to WebFetch — verbatim, including scheme.
      attribute :value, String
    end

    value_object "FetchPrompt" do
      # The instruction passed to WebFetch alongside the URL,
      # telling the model how to process the fetched content
      # (extract a value, summarize, answer a question, etc.).
      attribute :value, String
    end

    value_object "SearchQuery" do
      # The query string passed to WebSearch — the text the search
      # engine receives.
      attribute :value, String
    end

    value_object "Description" do
      # One-line caption in active voice. Duplicated per locked
      # convention (VOs inside each aggregate).
      attribute :value, String
    end

    # ── WebFetch ──
    command "WebFetch" do
      role "Miette"
      description "Fetch a URL and process its content with a prompt. Records the dispatch as a WebTool record and emits WebFetched carrying the url, prompt, content (truncated), and description."
      attribute :id, Id
      attribute :url, Url
      attribute :prompt, FetchPrompt
      attribute :description, Description
      emits "WebFetched"
      then_set :url,         to: :url
      then_set :description, to: :description
    end

    # ── WebSearch ──
    command "WebSearch" do
      role "Miette"
      description "Search the web with a query. Records the dispatch as a WebTool record and emits WebSearched carrying the query, allowed/blocked domains, and the result count + summary."
      attribute :id, Id
      attribute :query, SearchQuery
      attribute :description, Description
      emits "WebSearched"
      then_set :query,       to: :query
      then_set :description, to: :description
    end
  end

  # ── Cascade : RecordResult (kernel-hook outcome chain) ──
  #
  # Cascade is the landing pad for the :claude_tool / :web_tool kernel
  # hook's output. When ShellTool.Bash / FileTool.Read / SearchTool.Grep
  # / WebTool.WebFetch (etc.) finishes, the adapter fires
  # Cascade.RecordResult carrying the same invocation id plus the
  # captured tool kind, output, exit_code, and ok flag.
  #
  # The id matches the originating dispatch — a Cascade record and its
  # originating tool record share the same id, so the join is by id
  # across aggregates. ResultRecorded events carry the full outcome
  # payload for downstream policies that need to react to tool
  # outcomes (success / failure / non-zero exit / interesting output).
  aggregate "Cascade", "Kernel-hook outcome chain. After a ShellTool / FileTool / SearchTool / WebTool dispatch runs through its adapter, the adapter chains Cascade.RecordResult carrying the captured outcome (tool, output, exit_code, ok). The Cascade record shares the originating invocation id so the join is straightforward." do
    identified_by :id

    attribute :id, Id
    attribute :tool_kind, ToolKind
    attribute :output, Output
    attribute :exit_code, ExitCode
    attribute :ok_status, Ok
    attribute :description, Description

    value_object "Id" do
      # Invocation id — matches the id of the originating
      # ShellTool/FileTool/SearchTool/WebTool record so the outcome
      # is joinable against the invocation by id.
      attribute :value, String
    end

    value_object "ToolKind" do
      # Which tool produced the result — one of "bash" / "edit" /
      # "read" / "write" / "grep" / "glob" / "web_fetch" /
      # "web_search". Lowercase by convention so the value matches
      # the kernel hook's `tool` field in the result payload.
      attribute :value, String
    end

    value_object "Output" do
      # Captured stdout / tool output from the underlying runtime
      # invocation, as the kernel hook returned it. May be long ;
      # the aggregate state records it so a follow-up dispatch can
      # reason over the most recent result.
      attribute :value, String
    end

    value_object "ExitCode" do
      # Process exit code from the underlying runtime invocation,
      # mirroring ClaudeToolResult.exit_code. 0 conventionally
      # means success ; non-zero means failure with the specific
      # number carrying tool-defined meaning.
      attribute :value, Integer
    end

    value_object "Ok" do
      # Coarse-grained success flag, mirroring ClaudeToolResult.ok.
      attribute :value, Boolean
    end

    value_object "Description" do
      # One-line caption. Duplicated per locked convention.
      attribute :value, String
    end

    # ── RecordResult ──
    command "RecordResult" do
      role "System"
      description "Record the outcome of a previous tool dispatch onto a Cascade record. The :claude_tool / :web_tool adapter fires this after the matching tool command runs, carrying the same invocation id plus the captured tool kind, output, exit_code, and ok flag from the kernel hook's result payload. Emits ResultRecorded so downstream policies can react to tool outcomes the same way they react to any other domain event."
      attribute :id, Id
      attribute :tool, ToolKind
      attribute :output, Output
      attribute :exit_code, ExitCode
      attribute :ok, Ok
      emits "ResultRecorded"
      then_set :tool_kind,  to: :tool
      then_set :output,     to: :output
      then_set :exit_code,  to: :exit_code
      then_set :ok_status,  to: :ok
    end
  end
end
