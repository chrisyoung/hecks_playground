Hecks.hecksagon "Tools" do
  # ============================================================
  # TOOLS — adapter bindings : Tools.X dispatch → real tool run
  # ============================================================
  #
  # The Tools bluebook (sibling file tools.bluebook) declares the
  # six tool commands as first-class dispatches. The default-to-
  # memory runtime is enough for the dispatch + event-emit loop ;
  # this hecksagon adds the SIDE-EFFECT layer.
  #
  # Each `adapter :claude_tool` entry below binds a Tools.X command
  # to the corresponding Claude tool. When the runtime sees a
  # matching dispatch, the adapter fires, the underlying tool
  # actually runs (real shell, real file edit, real read), and the
  # result routes back into the aggregate state as a follow-on
  # dispatch.
  #
  # ── The principle the binding sits on ──
  #
  #   "the domain will compose the tool call and the adapter runs
  #    them" — Chris, 2026-05-12
  #
  # The bluebook (composition) is pure ; the adapter (execution) is
  # the only impure layer. Same shape as the IO monad — intent and
  # side-effect kept separate.
  #
  # ── Runtime status (2026-05-12) ──
  #
  # The :claude_tool adapter flavor isn't yet a typed IR struct ;
  # the hecksagon_parser falls back to IoAdapter for unrecognized
  # kinds, so these entries LAND in the hecksagon IR as IoAdapter
  # rows with options={command: "Tools.X", tool: :foo}. The runtime
  # doesn't yet dispatch off them — that's i551's runtime work
  # (parser + dispatcher mirroring :llm).
  #
  # Today this file is the DESIGN SURFACE : the binding is named,
  # the structure is captured, and any future parser / dispatcher
  # work has a concrete shape to read against. Default-to-memory
  # means the bluebook side is already working ; the adapter is the
  # next layer.

  adapter :memory

  adapter :claude_tool, command: "Tools.Bash",   tool: :bash,  result_into: "Tools.RecordResult"
  adapter :claude_tool, command: "Tools.Edit",   tool: :edit,  result_into: "Tools.RecordResult"
  adapter :claude_tool, command: "Tools.Read",   tool: :read,  result_into: "Tools.RecordResult"
  adapter :claude_tool, command: "Tools.Update", tool: :write, result_into: "Tools.RecordResult"
  adapter :claude_tool, command: "Tools.Grep",   tool: :grep,  result_into: "Tools.RecordResult"
  adapter :claude_tool, command: "Tools.Glob",   tool: :glob,  result_into: "Tools.RecordResult"

  # ── :web_tool adapter bindings (i569) ──
  #
  # Bind Tools.WebFetch / Tools.WebSearch to the :web_tool adapter
  # family declared at framework/adapter_families/web_tool.hecksagon.
  # Same shape as the :claude_tool bindings above : `command` names
  # the dispatch target, `tool` selects the family's behavior
  # (web_fetch → perform_web_fetch hook ; web_search →
  # perform_web_search hook), and `result_into` chains the kernel-
  # hook output back as a follow-on dispatch.
  #
  # Runtime status (2026-05-12) : these bindings are declared NOW
  # but won't auto-dispatch until i557's framework_registry lands.
  # Their bluebook validity is checkable today via `storehouse
  # validate` ; live dispatch waits for the registry to walk
  # framework/adapter_families/ at boot and wire kernel hooks by
  # behavior name. See hecks_conception/inbox/i569.md for the
  # dependency notes.
  adapter :web_tool, command: "Tools.WebFetch",  tool: :web_fetch,  result_into: "Tools.RecordResult"
  adapter :web_tool, command: "Tools.WebSearch", tool: :web_search, result_into: "Tools.RecordResult"
end
