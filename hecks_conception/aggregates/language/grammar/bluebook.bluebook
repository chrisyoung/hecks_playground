Hecks.bluebook "Bluebook", version: "2026.05.12.1" do
  vision "Bluebook describing itself — the IR shape every parser must produce"
  category "meta"

  # ============================================================
  # The IR contract.
  # ============================================================
  #
  # This bluebook is the canonical description of what a parsed .bluebook
  # IR contains. Both the Ruby DSL parser (lib/hecks/dsl/) and the Rust
  # parser (rust/src/parser.rs) must produce structures matching
  # the shape declared here.
  #
  # The Domain aggregate is the sole root of the IR tree. Every other
  # IR concept is an entity owned by Domain — they have identity within
  # a Domain boundary but are not independently dispatchable aggregates.
  # This matches Evans's DDD : a single aggregate root with reachable
  # entities, not a flat list of peer aggregates.
  #
  # When parity drift surfaces (see parity/parity_test.rb), the
  # divergence is either a parser bug or — more rarely — a change to
  # this file. Update this file FIRST when adding a real new IR concept,
  # then teach both parsers to produce it.
  #
  # This domain is not booted as a runtime organ — it carries no live
  # state. It documents shape.
  #
  # 2026-05-12 : Domain's own surface attributes (name, category,
  # vision) wrapped in typed value-objects per the no-primitive-envy
  # rule, mirroring the macrophage / antibody / mindstream sweeps.
  # Per-aggregate VO sets — no bluebook-level VOs. Entity inner
  # attributes (Aggregate.name, Attribute.type, etc.) are
  # intentionally left as primitives : the no_primitive_envy
  # validator only scans aggregate-root and command surfaces, and
  # those inner attrs describe the SHAPE of the IR — they ARE the
  # primitive contract every parser must produce.

  aggregate "Domain", "The top of the IR tree — name + all aggregates + cross-cutting policies/fixtures" do
    identified_by :name

    attribute :name,     Name
    attribute :category, Category
    attribute :vision,   Vision

    # ── Value-objects : the meta-bluebook's own language ──

    value_object "Name" do
      # The Domain's identifier — the string passed to
      # `Hecks.bluebook "<Name>"`. Used as the identified_by key
      # in the IR and as the canonical name every parser must
      # round-trip unchanged.
      attribute :value, String
    end

    value_object "Category" do
      # The Domain's category label (e.g. 'framework', 'language',
      # 'meta', 'capability'). A coarse classifier the workshop UI
      # uses to group aggregates ; not enforced as an enum here
      # because new categories are added freely.
      attribute :value, String
    end

    value_object "Vision" do
      # Free-form prose stating what the domain is for. Surfaces
      # in dashboards and the conceive flow so a reader knows the
      # purpose of the bluebook before reading its structure.
      attribute :value, String
    end

    entity "Aggregate" do
      description "A DDD aggregate root — attributes, value objects, commands, queries, lifecycle"
      attribute :name, String
      attribute :description, String
    end

    entity "Attribute" do
      description "A typed field on an aggregate, value object, or command"
      attribute :name, String
      attribute :type, String
      attribute :list, String
      attribute :default, String
    end

    entity "ValueObject" do
      description "An immutable embedded structure within an aggregate"
      attribute :name, String
      attribute :description, String
    end

    entity "Reference" do
      description "A typed pointer from one aggregate or command to another aggregate"
      attribute :name, String
      attribute :target, String
      attribute :domain, String
    end

    entity "Command" do
      description "An intent to change aggregate state — role, attributes, mutations, emits"
      attribute :name, String
      attribute :description, String
      attribute :role, String
      attribute :emits, String
    end

    entity "Query" do
      description "A read-side projection on an aggregate — pure, no side effects"
      attribute :name, String
      attribute :description, String
    end

    entity "Given" do
      description "A precondition checked before a command executes — pure UL expression"
      attribute :ref, String
      attribute :expression, String
      attribute :message, String
    end

    entity "Mutation" do
      description "A declared state change — set, append, increment, decrement, toggle"
      attribute :ref, String
      attribute :field, String
      attribute :op, String
      attribute :value, String
    end

    entity "Lifecycle" do
      description "The state machine of an aggregate — field, default state, transitions"
      attribute :field, String
      attribute :default, String
    end

    entity "Transition" do
      description "One arrow in a lifecycle — command, source state(s), target state"
      attribute :command, String
      attribute :to_state, String
      attribute :from_state, String
    end

    entity "Policy" do
      description "A reactive wire — when EVENT fires on aggregate A, trigger COMMAND on aggregate B"
      attribute :name, String
      attribute :on_event, String
      attribute :trigger_command, String
      attribute :target_domain, String
    end

    entity "Fixture" do
      description "A canonical instance of an aggregate seeded with the bluebook"
      attribute :aggregate_name, String
      attribute :attributes, String
    end
  end

  # ============================================================
  # Mutation operation kinds — the only legal `op` values.
  # ============================================================

end
