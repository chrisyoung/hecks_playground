Hecks.bluebook "Composition", version: "2026.05.12.1" do
  vision "Two sentences joined across domains — the output of one feeds the input of the next"
  category "language"

  # ============================================================
  # COMPOSITION — two sentences joined across domains
  # ============================================================
  #
  # Lifted out of vocabulary.bluebook in i112. Sibling aggregates
  # moved to language/ : sentence, acl, lexicon. The CompileOnCompose
  # policy follows its trigger target (Compile) into lexicon.bluebook.
  #
  # 2026-05-12 : primitives wrapped in typed value-objects per the
  # no-primitive-envy discipline locked alongside macrophage /
  # immunity / dispatch_audit. Per-aggregate VO sets ; this aggregate
  # owns its own Phrase, DomainName, CommandName, BridgeType,
  # Connector, and Translation vocabulary. The domain now reads as
  # itself : a Phrase is not a String, a DomainName is not a String.

  aggregate "Composition" do
    description "Two commands chained — the output of one feeds the input of the next"
    identified_by :phrase
    attribute :phrase,        Phrase
    attribute :from_domain,   DomainName
    attribute :from_command,  CommandName
    attribute :to_domain,     DomainName
    attribute :to_command,    CommandName
    attribute :bridge_type,   BridgeType
    attribute :connector,     Connector, default: { value: "then" }
    attribute :translations,  list_of(Translation)
    attribute :valid,         Validity, default: { value: "true" }

    # ── Value-objects : the composition's vocabulary ──

    value_object "Phrase" do
      # The natural-language phrase that names this composition —
      # the identity by which the lexicon resolves it.
      attribute :value, String
    end

    value_object "DomainName" do
      # The name of a domain participating in the composition —
      # either the source (from_domain) or the sink (to_domain).
      attribute :value, String
    end

    value_object "CommandName" do
      # The name of a command inside one of the participating
      # domains — either the producer (from_command) or the
      # consumer (to_command).
      attribute :value, String
    end

    value_object "BridgeType" do
      # The type that flows from the source command's output into
      # the sink command's input. Two commands compose when their
      # bridge types align.
      attribute :value, String
    end

    value_object "Connector" do
      # The natural-language conjunction joining the two sentences
      # ("then", "and", "so") — surfaces in translations.
      attribute :value, String
    end

    value_object "Translation" do
      # One natural-language rendering of this composition. A
      # composition may collect many translations as linguists
      # phrase it in different idioms.
      attribute :value, String
    end

    value_object "Validity" do
      # Whether the composition's types bridge cleanly. Surfaces as
      # "true" or "false" ; MarkInvalid flips it when a downstream
      # check finds the bridge type misaligned.
      attribute :value, String
    end

    command "Compose" do
      role "System"
      goal "Register a valid cross-domain composition — types must align"
      attribute :phrase,       Phrase
      attribute :from_domain,  DomainName
      attribute :from_command, CommandName
      attribute :to_domain,    DomainName
      attribute :to_command,   CommandName
      attribute :bridge_type,  BridgeType
      attribute :connector,    Connector
      emits "CompositionCreated"
      sets :phrase
      sets :from_domain
      sets :from_command
      sets :to_domain
      sets :to_command
      sets :bridge_type
      sets :connector
    end

    command "TranslateComposition" do
      role "Linguist"
      goal "Add a natural language translation for this composition"
      reference_to(Composition)
      attribute :natural_phrase, Translation
      emits "CompositionTranslated"
      sets :translations, append: :natural_phrase
    end

    command "MarkInvalid" do
      role "System"
      goal "Mark a composition as invalid — types don't bridge"
      reference_to(Composition)
      emits "CompositionInvalidated"
      sets :valid, to: "false"
    end
  end
end
