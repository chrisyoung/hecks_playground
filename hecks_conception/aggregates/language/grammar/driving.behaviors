Hecks.behaviors "Driving" do
  vision "Behavioral tests for the Driving domain — exercises every command and query in memory"

  # ── Driver aggregate ──────────────────────────────────────────

  test "Declare runs" do
    tests "Declare", on: "Driver"
    input  name: "sample_drivername", root: "sample_aggregatesroot", schedule: "sample_schedule", lifespan: "sample_lifespan"
    expect name: "sample_drivername", root: "sample_aggregatesroot", schedule: "sample_schedule", lifespan: "sample_lifespan"
  end

  test "AddDispatch runs" do
    tests "AddDispatch", on: "Driver"
    input  dispatch_id: "sample_dispatchid", command: "sample_commandfqn", order: "sample_order", when: "sample_hourrange"
    expect dispatches_size: 1
  end

  test "Fire runs" do
    tests "Fire", on: "Driver"
    input  fired_at: "sample_timestamp"
    expect last_fired_at: "sample_timestamp"
  end

end
