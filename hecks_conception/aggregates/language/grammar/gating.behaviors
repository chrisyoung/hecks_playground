Hecks.behaviors "Gating" do
  vision "Behavioral proof of the Gating grammar in pure memory — the Gate aggregate, the inbound-wrapper sibling of Driver. Declare brings a Gate into being (the IR a `gating on dispatch` block builds) ; Retire soft-detaches it ; Active is the boot-time read the runtime hydrates its synchronous stack from. The verdict a before-Gate's check returns (Allow|Deny) is in-process runtime motion proven in the Rust dispatch tests ; these behaviors pin the GRAMMAR — that a gate is declared, queryable, idempotent on re-declare, and excluded once retired. Grounded in the first Gate : the rbac-authorize before-gate (check 'rbac-authorize', pattern '*')."

  # ── Declare : the IR a `gating on dispatch` block builds ───────────────
  test "Declare brings a before-gate into being in the active state" do
    tests "Declare", on: "Gate"
    input  name: "Authorize", phase: "before", check: "rbac-authorize", pattern: "*", order: 20
    expect name: "Authorize", phase: "before", check: "rbac-authorize", status: "active"
  end

  test "Declare emits Declared" do
    tests "Declare", on: "Gate"
    input  name: "Authorize", phase: "before", check: "rbac-authorize", pattern: "*", order: 20
    expect_event "Declared"
  end

  # ── Active : the boot-time hydration read (projection target) ────────
  test "Active lists a declared gate" do
    tests "Active", on: "Gate", kind: :query
    setup  "Declare", name: "Authorize", phase: "before", check: "rbac-authorize", pattern: "*", order: 20
    expect count: 1
  end

  # Declare upserts on identity : re-declaring (as the parser re-emits the
  # same `gating on dispatch` block every boot) re-affirms the same gate
  # rather than duplicating it. Two Declares of the same name leave exactly
  # one active record. Mirrors Driver's re-declare-on-name idempotency.
  test "Declare is idempotent — re-declaring the same name keeps one record" do
    tests "Active", on: "Gate", kind: :query
    setup  "Declare", name: "Authorize", phase: "before", check: "rbac-authorize", pattern: "*", order: 20
    setup  "Declare", name: "Authorize", phase: "before", check: "rbac-authorize", pattern: "*", order: 20
    expect count: 1
  end

  # ── Retire : soft-detach ──────────────────────────────────────
  test "Retire detaches the gate" do
    tests "Retire", on: "Gate"
    setup  "Declare", name: "Authorize", phase: "before", check: "rbac-authorize", pattern: "*", order: 20
    input  name: "Authorize"
    expect status: "retired"
  end

  test "Retire emits Retired" do
    tests "Retire", on: "Gate"
    setup  "Declare", name: "Authorize", phase: "before", check: "rbac-authorize", pattern: "*", order: 20
    input  name: "Authorize"
    expect_event "Retired"
  end

  # A retired gate is dropped from the hydration read, so the next boot (or
  # in-session re-hydrate) drops it from the runtime stack.
  test "Active excludes a retired gate" do
    tests "Active", on: "Gate", kind: :query
    setup  "Declare", name: "Authorize", phase: "before", check: "rbac-authorize", pattern: "*", order: 20
    setup  "Retire",  name: "Authorize"
    expect count: 0
  end
end
