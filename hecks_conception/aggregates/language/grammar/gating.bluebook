Hecks.bluebook "Gating", version: "2026.06.26.1" do
  vision "A Gate is the inbound WRAPPER on the dispatch path : it sits ACROSS every inbound dispatch, runs BEFORE the aggregate handler (and optionally AFTER), and may VETO — a Deny aborts the dispatch and records a Governance::Violation. Conceptually it completes the boundary triad (a Family is the outbound edge — persisted_by, charged_by ; a Driver is the inbound source — an external clock dispatching on a schedule ; a Gate is the inbound wrapper), but it is NOT a new DSL. A Gate is a STOREHOUSE SERVICE : you declare one by dispatching Gate.Declare through the universal door — the same way every other act flows — with no hexagon form, no family, no new grammar (convention over configuration). The runtime hydrates its synchronous before/after MiddlewareStack from the declared, active Gates (the way the Procfile is the projection of Drivers), self-seeding the standing rbac-authorize gate so the door is gated by default. A Gate is IN-PROCESS and SYNCHRONOUS by construction — it must BLOCK the dispatch to veto it, so it can never be a slow out-of-process edge (the two-color rule forbids that for a per-dispatch wrapper). Its `check` resolves three ways, all storehouse-native : the conventional shortcuts 'rbac-authorize' (role over the boot-hydrated AclReadModel) and 'authenticate' (the caller is an active AuthIdentity), both in-process verdicts over read-models the query grammar can't yet express ; OR any bluebook QUERY named Aggregate.Query — the runtime runs it READ-ONLY with the caller's principal as the reserved `actor` kwarg and ALLOWS iff it returns a row, so any query is a gate with zero Rust and zero DSL. A System origin (daemon, cascade, boot) is admitted by origin. This is the whole door : authz, authn, and any custom gate, declared and resolved entirely through storehouse. (REALIZED 2026-06-26 : the vetoing stack, the Gate.Active hydration + self-seed, the authenticate gate, and the storehouse-service query gate are live on main ; no `gating on dispatch` DSL was added — a gate is a storehouse service, not a grammar.)"
  category "language"

  # ============================================================
  # GATE — the inbound wrapper that gates a dispatch
  # ============================================================
  #
  # Conceived 2026-06-26. Chris : "there should be a way to attach
  # bluebooks to the storehouse like middleware" → "should middleware use
  # adapters?" → "both via adapters." The answer : a Gate is the inbound
  # WRAPPER, declared as a hexagon adapter (`gating on dispatch`), the
  # third sibling of Family (outbound) and Driver (inbound source). It
  # completes the boundary triad.
  #
  # ── check : a runtime verdict key, not inline code, not an adapter ──
  #
  # `check` mirrors Storehouse::Primitive.implementation : a STRING the
  # runtime registry resolves to an IN-PROCESS verdict function the
  # runtime owns. "rbac-authorize" resolves to the role/permission gate
  # that consults the boot-hydrated AclReadModel (auth_identity_id ->
  # role -> ancestors). The bluebook declares the ATTACHMENT (which gate,
  # what phase, what order, over which dispatches) ; the runtime owns the
  # verdict the key names. The macrophage enforces that every declared
  # `check` key has a matching runtime leaf — the same contract that binds
  # Storehouse::Primitive.implementation to its dispatcher.
  #
  # Why a key and not a dispatchable bluebook query : a before-Gate runs
  # SYNCHRONOUSLY inside the dispatch it gates, and the role-hierarchy
  # traversal (flatten ancestors, test membership) is algorithmic, not a
  # where-filter. The verdict is genuine in-process runtime motion
  # (Sambhogakaya), like a read-model. A LATER chapter may let `check`
  # name a dispatchable query for purely-declarative gates ; the first
  # chapter resolves runtime keys.
  #
  # ── Companion chapters ────────────────────────────────────────────
  #
  # driving.bluebook  — Driver, the inbound SOURCE this mirrors. Same
  #   `<verb> on <kind>` adapter-block surface ; opposite process model
  #   (Driver out-of-process, Gate in-process).
  # hexagon.bluebook  — Family / Binding, the OUTBOUND edges. Gate is the
  #   inbound complement.
  # framework/governance/governance.bluebook — Policy / Violation : the
  #   audit a vetoing before-Gate writes to on Deny.
  # framework/agent/{agent,role}.bluebook — the RBAC identity + permission
  #   domains the rbac-authorize check's read-model is built from.

  aggregate "Gate", "One inbound wrapper across a domain's dispatches : the phase it runs in (before|after the aggregate handler), the check the runtime resolves to an in-process verdict function, the match pattern selecting which dispatches it wraps, and the order it runs in. Keyed by name (e.g. 'rbac-authorize', 'authenticate'). Declared through the storehouse door via Gate.Declare — no DSL, no hexagon form. A before-Gate is VETOING (Deny aborts + records a Violation) ; an after-Gate observes. The inverse of a Driver : a Driver names its own inbound schedule and runs out-of-process ; a Gate names its own inbound check and runs in-process, synchronous, blocking the dispatch it gates." do
    identified_by :name

    # ---- Identity ----
    attribute :name,    GateName

    # ---- Declaration ----
    attribute :phase,   Phase
    attribute :check,   Check
    attribute :pattern, Pattern, default: "*"
    attribute :order,   Order,   default: 100

    # ---- Lifecycle ----
    attribute :status,  Status,  default: "active"

    # ── Value objects ─────────────────────────────────────────

    value_object "GateName" do
      # The gate's natural-key identifier (e.g. "rbac-authorize",
      # "authenticate", or a custom name). The registry keys by this string ;
      # Declare upserts on it.
      attribute :value, String
    end

    value_object "Phase" do
      # When the gate runs relative to the aggregate handler. "before"
      # gates are VETOING (may Deny and abort) ; "after" gates observe the
      # result only.
      attribute :value, String, enum: ["before", "after"]
    end

    value_object "Check" do
      # What the gate runs to decide allow/deny. Two storehouse-native forms :
      # (1) a built-in verdict key — "rbac-authorize" (role over the
      #     AclReadModel) or "authenticate" (active AuthIdentity) — in-process
      #     verdicts over boot-hydrated read-models the query grammar can't
      #     yet express ; or
      # (2) a bluebook QUERY named Aggregate.Query — the runtime runs it
      #     read-only with the caller's principal as the reserved `actor`
      #     kwarg and ALLOWS iff it returns a row.
      # An unresolvable check fails closed (deny). No DSL : a gate is a
      # storehouse service either way.
      attribute :value, String
    end

    value_object "Pattern" do
      # Selects which dispatches this gate wraps. "*" matches every command
      # (the cross-cutting case — authn/authz). A trailing-* dotted prefix
      # ("Hecks::Framework::Agent::*") scopes it to one domain or aggregate.
      # Same dotted phrase form Lexicon canonicalises.
      attribute :value, String
    end

    value_object "Order" do
      # Run order within a phase — lower runs first. Authentication (resolve
      # + verify the principal) orders before authorization (check the
      # verified principal's role), so an authn gate takes a lower number
      # than an authz gate. Ties break by name for determinism. Mirrors
      # Driver's Dispatch.order (the per-tick sequence).
      attribute :value, Integer
    end

    value_object "Status" do
      # Lifecycle token : active | retired. Active gates hydrate into the
      # runtime stack ; retired ones stay on the audit row but are NOT in
      # the stack (the Active query excludes them).
      attribute :value, String, enum: ["active", "retired"]
    end

    # ── Commands ───────────────────────────────────────────────────

    command "Declare" do
      role "Framework"
      description "Bring a Gate into being — declared through the storehouse door (a normal dispatch, no DSL). Declares the phase, the check (a built-in verdict key like 'rbac-authorize' / 'authenticate', OR a bluebook query named Aggregate.Query), the match pattern, and the order. Idempotent on name : re-declaring replaces the phase/check/pattern/order. The runtime picks up the change on next boot, or on the in-session re-hydrate that follows a Gate lifecycle event."
      attribute :name,    GateName
      attribute :phase,   Phase
      attribute :check,   Check
      attribute :pattern, Pattern
      attribute :order,   Order
      then_set :name,    to: :name
      then_set :phase,   to: :phase
      then_set :check,   to: :check
      then_set :pattern, to: :pattern
      then_set :order,   to: :order
      then_set :status,  to: "active"
      emits "Declared"
    end

    command "Retire" do
      role "Framework"
      description "Detach a Gate — soft-delete. Moves status to retired ; the audit row survives so the history of which gates were attached when is preserved. The Active query excludes it, so the next boot (or in-session re-hydrate) drops it from the runtime stack. Retired is terminal — re-attach by Declare-ing a fresh record."
      reference_to(Gate)
      given("gate must currently be active") { status == "active" }
      then_set :status, to: "retired"
      emits "Retired"
    end

    query "Active" do
      description "Every attached (non-retired) Gate — the set the runtime hydrates its synchronous before/after stack from at boot (the MiddlewareStack, the projection of declared Gates as the Procfile is the projection of declared Drivers). The runtime orders the result by `order` (lower first), ties broken by name, then splits by phase : before-gates run pre-dispatch (vetoing), after-gates run post-dispatch (observe-only)."
      where status: "active"
    end

    # ── Lifecycle ─────────────────────────────────────────────────
    #
    # absent -> active (Declare) -> retired (Retire). Declare is an upsert,
    # valid from absent OR active (re-affirm the attachment) ; Retire is
    # terminal. Mirrors Driver's re-declare-on-name idempotency.
    lifecycle :status, default: "active" do
      transition "Declare" => "active",  from: ["active"]
      transition "Retire"  => "retired", from: "active"
    end
  end
end
