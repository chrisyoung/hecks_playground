Hecks.hecksagon "Lexicon" do
  # Persistence (i728 Phase B) : durable-by-default. The compiled phrase
  # index (lexicon.heki) persists under information/ ; :heki declared so the
  # backing is explicit BEFORE apply_memory_persistence makes :memory real.
  # The index is regenerable (Compile rebuilds it from the corpus walk), so
  # this MAY be reclassified :memory once Compile-on-boot is wired ; until
  # then :heki keeps the index alive across boots without a recompile.
  #
  # NOTE (i728 comb) : a second, NON-LOADED Lexicon lives at
  # storehouse/lexicon.bluebook + storehouse/lexicon.hecksagon (:memory) —
  # outside the aggregates/ load-walk, a suspected dead duplicate. Flagged
  # for retirement review ; this hecksagon governs the LOADED grammar Lexicon.
  adapter :heki
end
