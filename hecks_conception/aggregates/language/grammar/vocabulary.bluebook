Hecks.bluebook "Vocabulary", version: "2026.06.14.1" do
  vision "The compiled vocabulary — all sentences, compositions, and ACLs indexed for matching"
  category "language"

  # ============================================================
  # VOCABULARY — the grammar's compiled phrase book
  # ============================================================
  #
  # Renamed from "Lexicon" (i728) : the storehouse callable-phrase index
  # (storehouse/lexicon.bluebook — glass's compile/lookup/list) keeps the
  # name "Lexicon". This is the GRAMMAR's compiled vocabulary (sentences /
  # compositions / ACLs indexed for matching) — a distinct domain that had
  # collided with glass's Lexicon on name, store, AND event. It carried the
  # name "Vocabulary" originally (lifted from vocabulary.bluebook in i112) ;
  # restored here so the two no longer clash. The three Compile-on-* policies
  # trigger Compile, so they live alongside the trigger target.

  aggregate "Vocabulary", "The compiled vocabulary — all sentences, compositions, and ACLs indexed for matching" do
    identified_by :name
    attribute :name,              Name
    attribute :sentence_count,    EntryCount
    attribute :composition_count, EntryCount
    attribute :acl_count,         EntryCount
    attribute :last_compiled,     Timestamp

    value_object "Name" do
      # Stable slug naming this vocabulary snapshot.
      attribute :value, String
    end

    value_object "EntryCount" do
      # Count of entries (sentences, compositions, ACLs) in the compiled vocabulary.
      attribute :value, Integer
    end

    value_object "Timestamp" do
      # ISO-8601 timestamp of the last compile.
      attribute :value, String
    end

    value_object "Input" do
      # A natural-language input the vocabulary attempts to match.
      attribute :value, String
    end

    command "Compile" do
      role "System"
      description "Walk all bluebooks, enumerate valid sentences and compositions, build the phrase book"
      emits "VocabularyCompiled"
      then_set :last_compiled, to: "now"
    end

    command "Match" do
      role "System"
      description "Match natural input against the vocabulary — return the command path or nothing"
      reference_to(Vocabulary)
      attribute :input, Input
      emits "InputMatched"
    end
  end

  policy "CompileOnDefine" do
    on "SentenceDefined"
    trigger "Compile"
  end

  policy "CompileOnCompose" do
    on "CompositionCreated"
    trigger "Compile"
  end

  policy "CompileOnGrant" do
    on "AccessGranted"
    trigger "Compile"
  end
end
