Hecks.bluebook "ContextWindow", version: "2026.04.28.1" do
  vision "Everything stuffed into the prompt — grammar, organs, examples. Context window IS the training, no fine-tuning required."
  category "language"

  # ============================================================
  # CONTEXT WINDOW — prompt assembly
  # ============================================================
  #
  # Lifted out of inference.bluebook in i112. Sibling aggregates
  # moved to language/ : few_shot, local_model, prompt. The
  # ValidateOnInference policy follows its trigger target
  # (ValidateOutput) into prompt.bluebook.

  aggregate "ContextWindow", "Everything stuffed into the prompt — grammar, organs, examples" do
    identified_by :name
    attribute :name, String
    attribute :system_prompt, String
    attribute :grammar_tokens, Integer
    attribute :example_tokens, Integer
    attribute :organ_tokens, Integer
    attribute :total_tokens, Integer

    command "BuildContext" do
      role "System"
      description "Assemble the context — system prompt + Bluebook grammar + few-shot examples + organ behaviors"
      attribute :grammar_tokens, Integer
      attribute :example_tokens, Integer
      attribute :organ_tokens, Integer
      emits "ContextBuilt"
      then_set :grammar_tokens, to: :grammar_tokens
      then_set :example_tokens, to: :example_tokens
      then_set :organ_tokens, to: :organ_tokens
    end
  end
end
