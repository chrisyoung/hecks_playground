Hecks.bluebook "Prompt", version: "2026.04.28.1" do
  vision "A single inference request — user input + context → bluebook output"
  category "language"

  # ============================================================
  # PROMPT — one inference round-trip
  # ============================================================
  #
  # Lifted out of inference.bluebook in i112. Sibling aggregates
  # moved to language/ : context_window, few_shot, local_model.
  # The ValidateOnInference policy lives here because ValidateOutput
  # is its trigger target.

  aggregate "Prompt", "A single inference request — user input + context → bluebook output" do
    identified_by :ref
    attribute :ref,        Ref
    attribute :input,      Input
    attribute :output,     Output
    attribute :valid,      Validity
    attribute :latency_ms, LatencyMs

    value_object "Ref" do
      # Stable identifier for this inference round-trip.
      attribute :value, String
    end

    value_object "Input" do
      # The user input fed into the model along with the context.
      attribute :value, String
    end

    value_object "Output" do
      # The model's raw output text — should be a parseable bluebook.
      attribute :value, String
    end

    value_object "Validity" do
      # Either 'valid' or 'invalid' — set by the Rust validator on OutputValidated.
      attribute :value, String
    end

    value_object "LatencyMs" do
      # Wall-clock latency of the inference call in milliseconds.
      attribute :value, Integer
    end

    command "RunInference" do
      role "System"
      description "Send input to the local model with full context, get bluebook output"
      attribute :input, Input
      emits "InferenceRan"
      then_set :input, to: :input
    end

    command "ValidateOutput" do
      role "System"
      description "Check if the model's output is a valid bluebook — Rust validation"
      reference_to(Prompt)
      attribute :valid, Validity
      emits "OutputValidated"
      then_set :valid, to: :valid
    end
  end

  policy "ValidateOnInference" do
    on "InferenceRan"
    trigger "ValidateOutput"
  end
end
