Hecks.bluebook "NurseryCensus", version: "2026.05.12.1" do
  vision "The master snapshot of all nursery domains — total counts of domains, aggregates, commands, policies, sectors"
  category "library"

  # ============================================================
  # NURSERY CENSUS — master snapshot
  # ============================================================
  #
  # Lifted out of census.bluebook in i112. Sibling aggregates
  # moved to library/ : domain_entry, sector, compilation. The
  # IndexOnCensus policy follows its trigger target (ClassifySector)
  # into sector.bluebook.
  #
  # 2026-05-12 : primitives wrapped in typed value-objects per the
  # no-primitive-envy discipline.

  aggregate "NurseryCensus", "The master snapshot of all nursery domains" do
    identified_by :name
    attribute :name, CensusName
    attribute :total_domains, Count
    attribute :total_aggregates, Count
    attribute :total_commands, Count
    attribute :total_policies, Count
    attribute :sector_count, Count
    attribute :errors, Count

    # ── Value-objects : the census's vocabulary ──

    value_object "CensusName" do
      # The census snapshot's identifier — singleton-style "current"
      # or named historical snapshot.
      attribute :value, String
    end

    value_object "Count" do
      # Non-negative tally — every census field is a population
      # bucket (domains, aggregates, commands, policies, sectors,
      # parse errors).
      attribute :value, Integer
    end

    command "TakeCensus" do
      role "System"
      description "Scan the nursery and count everything"
      attribute :total_domains, Count
      attribute :total_aggregates, Count
      attribute :total_commands, Count
      attribute :total_policies, Count
      attribute :sector_count, Count
      attribute :errors, Count
      emits "CensusTaken"
      then_set :total_domains, to: :total_domains
      then_set :total_aggregates, to: :total_aggregates
      then_set :total_commands, to: :total_commands
      then_set :total_policies, to: :total_policies
      then_set :sector_count, to: :sector_count
      then_set :errors, to: :errors
    end

    command "RecountDomains" do
      role "System"
      description "Quick update — just the domain count, on every beat"
      reference_to(NurseryCensus)
      attribute :total_domains, Count
      emits "DomainCountUpdated"
      then_set :total_domains, to: :total_domains
    end
  end
end
