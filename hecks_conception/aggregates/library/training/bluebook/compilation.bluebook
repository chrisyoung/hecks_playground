Hecks.bluebook "Compilation", version: "2026.04.28.1" do
  vision "Compile the nursery into a compressed corpus — single-file output of all domains"
  category "library"

  # ============================================================
  # COMPILATION — nursery → corpus file
  # ============================================================
  #
  # Lifted out of census.bluebook in i112. Sibling aggregates
  # moved to library/ : nursery_census, domain_entry, sector.

  aggregate "Compilation", "Compile the nursery into a compressed corpus" do
    identified_by :name
    attribute :name,             Name
    attribute :domains_compiled, DomainCount
    attribute :output_path,      OutputPath

    value_object "Name" do
      # Stable slug naming this compilation run.
      attribute :value, String
    end

    value_object "DomainCount" do
      # Number of nursery domains included in the compiled corpus.
      attribute :value, Integer
    end

    value_object "OutputPath" do
      # Filesystem path the compiled corpus was written to.
      attribute :value, String
    end

    command "CompileNursery" do
      role "System"
      description "Compress all nursery domains into a single corpus file"
      attribute :domains_compiled, DomainCount
      attribute :output_path,      OutputPath
      emits "NurseryCompiled"
      then_set :domains_compiled, to: :domains_compiled
      then_set :output_path,      to: :output_path
    end
  end
end
