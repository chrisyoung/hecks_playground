Hecks.bluebook "ModelSpec", version: "2026.04.28.1" do
  vision "What the trained model should be able to do"
  category "meta"

  # Lifted out of training_corpus.bluebook in i112 split.

  aggregate "ModelSpec", "What the trained model should be able to do" do
    identified_by :name
    attribute :name,          Name
    attribute :capabilities,  list_of(Capability)
    attribute :input_format,  Format
    attribute :output_format, Format

    value_object "Name" do
      # Identifier of the model spec.
      attribute :value, String
    end

    value_object "Capability" do
      # One capability the trained model should support.
      attribute :value, String
    end

    value_object "Format" do
      # Input or output format the model produces / consumes (e.g. 'bluebook', 'json').
      attribute :value, String
    end

    command "DefineModel" do
      role "Creator"
      description "Specify what the Miette LLM should produce"
      attribute :name,          Name
      attribute :capabilities,  list_of(Capability)
      attribute :input_format,  Format
      attribute :output_format, Format
      emits "ModelDefined"
      then_set :name,          to: :name
      then_set :capabilities,  to: :capabilities
      then_set :input_format,  to: :input_format
      then_set :output_format, to: :output_format
    end
  end
end
