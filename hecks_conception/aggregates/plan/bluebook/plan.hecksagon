Hecks.hecksagon "Plan" do
  Plan::Sprint.persisted_by("Heki")
  Plan::Story.persisted_by("Heki")
  Plan::Task.persisted_by("Heki")
  Plan::Board.persisted_by("Heki")
  Plan::Backlog.persisted_by("Heki")
  Plan::UseCase.persisted_by("Heki")
  Plan::Epic.persisted_by("Heki")
  Plan::Project.persisted_by("Heki")

  # Impure edges, hecksagon-first : on Story.RunCheck, run the four done-is-done
  # checks (all fire on the one command, mirroring the four policies that fired
  # on StoryChecksRequested). Re-homed from the RunXCheckOnChecksRequested
  # Process.Spawn policies — the impure edge lives here, not in the bluebook.
  adapter :exec, name: "check_worktree",      command: "Story.RunCheck", exec: "bin/check-worktree",      result_into: "Cascade::Cascade.RecordResult"
  adapter :exec, name: "check_merged",        command: "Story.RunCheck", exec: "bin/check-merged",        result_into: "Cascade::Cascade.RecordResult"
  adapter :exec, name: "check_tests",         command: "Story.RunCheck", exec: "bin/check-tests",         result_into: "Cascade::Cascade.RecordResult"
  adapter :exec, name: "check_verb_resolves", command: "Story.RunCheck", exec: "bin/check-verb-resolves", result_into: "Cascade::Cascade.RecordResult"
end
