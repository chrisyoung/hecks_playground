Hecks.behaviors "Board" do
  vision "Behavioral tests for the one working Board — sprint roster (queued + single active slot), activation gating (one-active + on-board), and the active sprint's card order. Proves the scalar + list-membership guards evaluate at runtime."

  # ── Creation ──────────────────────────────────────────

  test "Open mints the singleton board" do
    tests "Open", on: "Board"
    input  name: "board", project: "framework"
    expect name: "board", project: "framework"
  end

  # ── Sprint roster ─────────────────────────────────────

  test "PlaceSprint adds a sprint to the queued roster" do
    tests "PlaceSprint", on: "Board"
    setup  "Open", name: "board", project: "framework"
    input  name: "board", sprint_ref: "2"
    expect ok: "true"
  end

  test "ActivateSprint succeeds for a placed sprint" do
    tests "ActivateSprint", on: "Board"
    setup  "Open", name: "board", project: "framework"
    setup  "PlaceSprint", name: "board", sprint_ref: "2"
    input  name: "board", sprint_ref: "2"
    expect active_sprint_ref: "2"
  end

  test "ActivateSprint emits only SprintActivatedOnBoard (rule #3: no card start)" do
    tests "ActivateSprint", on: "Board"
    setup  "Open", name: "board", project: "framework"
    setup  "PlaceSprint", name: "board", sprint_ref: "2"
    input  name: "board", sprint_ref: "2"
    expect emits: ["SprintActivatedOnBoard"]
  end

  # RULE #4 PENDING : on-board activation is not yet guarded — the runtime
  # fails open on list-membership predicates (gap: runtime-list-membership-
  # guards). This test pins CURRENT behavior (unplaced activation succeeds)
  # so it flips loudly the day the runtime grows collection guards.
  test "ActivateSprint of an unplaced sprint currently succeeds (rule #4 pending runtime gap)" do
    tests "ActivateSprint", on: "Board"
    setup  "Open", name: "board", project: "framework"
    input  name: "board", sprint_ref: "2"
    expect active_sprint_ref: "2"
  end

  test "ActivateSprint is refused when a sprint is already active (one-active)" do
    tests "ActivateSprint", on: "Board"
    setup  "Open", name: "board", project: "framework"
    setup  "PlaceSprint", name: "board", sprint_ref: "2"
    setup  "PlaceSprint", name: "board", sprint_ref: "3"
    setup  "ActivateSprint", name: "board", sprint_ref: "2"
    input  name: "board", sprint_ref: "3"
    expect refused: "no sprint may already be active"
  end

  test "DeactivateSprint clears the active slot" do
    tests "DeactivateSprint", on: "Board"
    setup  "Open", name: "board", project: "framework"
    setup  "PlaceSprint", name: "board", sprint_ref: "2"
    setup  "ActivateSprint", name: "board", sprint_ref: "2"
    input  name: "board"
    expect active_sprint_ref: ""
  end

  test "DeactivateSprint is refused when no sprint is active" do
    tests "DeactivateSprint", on: "Board"
    setup  "Open", name: "board", project: "framework"
    input  name: "board"
    expect refused: "a sprint must be active"
  end

  # ── Card order ──────────────────────────────────────

  test "PlaceCard appends to the active sprint's card order" do
    tests "PlaceCard", on: "Board"
    setup  "Open", name: "board", project: "framework"
    input  name: "board", card_ref: "i608"
    expect ok: "true"
  end

  test "ReorderSprints replaces queued_sprint_refs list" do
    tests "ReorderSprints", on: "Board"
    setup  "Open", name: "the-board", project: "framework"
    setup  "PlaceSprint", sprint_ref: "a"
    setup  "PlaceSprint", sprint_ref: "b"
    setup  "PlaceSprint", sprint_ref: "c"
    input  name: "the-board", queued_sprint_refs: ["c", "a", "b"]
    expect queued_sprint_refs: ["c", "a", "b"]
  end
end
