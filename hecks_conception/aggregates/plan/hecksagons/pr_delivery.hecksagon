Hecks.hecksagon "PrDelivery" do
  # pr-delivery-merge-on-accept (sprint 20). Approve is the human gate ; the
  # merge is the automated consequence. StoryApproved -> enqueue -> start ->
  # REAL gh merge -> complete. Story identity rides events as {story_ref} ;
  # same-type MergeQueue cascades preserve the queue id (the target branch).
  adapter "EnqueueOnApproved" do
    driven on "Plan::Story.StoryApproved" do |event|
      dispatch "Conductor::MergeQueue.Enqueue", id: "main", story_ref: "{id}"
    end
  end
  adapter "StartMergeOnEnqueued" do
    driven on "Conductor::MergeQueue.MergeEnqueued" do |event|
      dispatch "Conductor::MergeQueue.StartMerge", story_ref: "{story_ref}"
    end
  end
  adapter "MergeAndCompleteOnStarted" do
    driven on "Conductor::MergeQueue.MergeStarted" do |event|
      # REAL merge : squash-merge the story's PR (branch sq/<story>) into main
      # and delete the branch. No canned RecordResult. By the time a story is
      # approved it already passed the pr_mergeable gate, so the merge is
      # expected clean. NOTE: failure handling (FailMerge if gh errors) needs
      # conditional-dispatch (no DSL branch yet) ; CompleteMerge fires after.
      run "gh pr merge sq/{story_ref} --squash --delete-branch"
      dispatch "Conductor::MergeQueue.CompleteMerge", story_ref: "{story_ref}"
    end
  end
end
