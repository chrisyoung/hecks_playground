Hecks.behaviors "Plan" do
  vision "Behavioral tests for the Plan domain — the Story lifecycle introduced by lifecycle-tasked-state (sprint 14) plus the Task aggregate (task-completion-state, sprint 14). Stories spawn untasked ; Tasked moves them to tasked ; Start (gated on state == tasked) moves them to started. Task is now its own aggregate with Add / Complete / Cancel / Reopen ; cascade policies maintain Story.pending_task_count ; the ready_means_all_tasks_resolved invariant gates MarkReady on pending_task_count == 0."

  test "Capture mints a story in the untasked state" do
    tests "Capture", on: "Story"
    input  ref: "l1", title: "Lifecycle one", tier: 1, summary: "sample", target: "plan/story", project: "plan"
    expect ref: "l1", state: "untasked"
  end

  test "Capture emits StoryCaptured" do
    tests "Capture", on: "Story"
    input  ref: "l2", title: "Lifecycle two", tier: 1, summary: "sample", target: "plan/story", project: "plan"
    expect emits: ["StoryCaptured"]
  end

  test "Tasked flips an untasked story to tasked" do
    tests "Tasked", on: "Story"
    setup  "Capture", ref: "l5", title: "L5", tier: 1, summary: "s", target: "t", project: "plan"
    input  ref: "l5"
    expect ref: "l5", state: "tasked"
  end

  test "Tasked emits StoryTasked" do
    tests "Tasked", on: "Story"
    setup  "Capture", ref: "l6", title: "L6", tier: 1, summary: "s", target: "t", project: "plan"
    input  ref: "l6"
    expect emits: ["StoryTasked"]
  end

  test "Start moves a tasked story to started" do
    tests "Start", on: "Story"
    setup  "Capture",        ref: "l7", title: "L7", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AssignToSprint", ref: "l7", sprint_ref: "1"
    setup  "Tasked",         ref: "l7"
    input  ref: "l7"
    expect ref: "l7", state: "started"
  end

  test "Start emits StoryStarted" do
    tests "Start", on: "Story"
    setup  "Capture",        ref: "l8", title: "L8", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AssignToSprint", ref: "l8", sprint_ref: "1"
    setup  "Tasked",         ref: "l8"
    input  ref: "l8"
    expect emits: ["StoryStarted"]
  end

  test "Cancel soft-deletes a tasked story to cancelled" do
    tests "Cancel", on: "Story"
    setup  "Capture", ref: "cx1", title: "CX1", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "Tasked",  ref: "cx1"
    input  ref: "cx1"
    expect ref: "cx1", state: "cancelled"
  end

  test "Cancel emits StoryCancelled" do
    tests "Cancel", on: "Story"
    setup  "Capture", ref: "cx2", title: "CX2", tier: 1, summary: "s", target: "t", project: "plan"
    input  ref: "cx2"
    expect emits: ["StoryCancelled"]
  end

  test "Resume returns a deferred story to untasked" do
    tests "Resume", on: "Story"
    setup  "Capture", ref: "rs1", title: "RS1", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "Defer",   ref: "rs1"
    input  ref: "rs1"
    expect ref: "rs1", state: "untasked"
  end

  test "Resume emits StoryResumed" do
    tests "Resume", on: "Story"
    setup  "Capture", ref: "rs2", title: "RS2", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "Defer",   ref: "rs2"
    input  ref: "rs2"
    expect emits: ["StoryResumed"]
  end

  test "AssignToSprint keeps state untasked (metadata-only since sprint 14)" do
    tests "AssignToSprint", on: "Story"
    setup  "Capture", ref: "l9", title: "L9", tier: 1, summary: "s", target: "t", project: "plan"
    input  ref: "l9", sprint_ref: "1"
    expect ref: "l9", state: "untasked", sprint: "1"
  end


  test "Retarget re-points the target without changing state" do
    tests "Retarget", on: "Story"
    setup  "Capture", ref: "r1", title: "R1", tier: 1, summary: "s", target: "old/target", project: "plan"
    input  ref: "r1", target: "new/target"
    expect ref: "r1", state: "untasked", target: "new/target"
  end

  test "Retarget emits StoryRetargeted" do
    tests "Retarget", on: "Story"
    setup  "Capture", ref: "r2", title: "R2", tier: 1, summary: "s", target: "old/target", project: "plan"
    input  ref: "r2", target: "new/target"
    expect emits: ["StoryRetargeted"]
  end

  test "Retier re-sizes the tier without changing state" do
    tests "Retier", on: "Story"
    setup  "Capture", ref: "r3", title: "R3", tier: 1, summary: "s", target: "t", project: "plan"
    input  ref: "r3", tier: 2
    expect ref: "r3", state: "untasked", tier: 2
  end

  test "Retier emits StoryRetiered" do
    tests "Retier", on: "Story"
    setup  "Capture", ref: "r4", title: "R4", tier: 1, summary: "s", target: "t", project: "plan"
    input  ref: "r4", tier: 2
    expect emits: ["StoryRetiered"]
  end
  # ── task-completion-state (sprint 14) ───────────────────────────────

  test "Task.Add mints a Task in pending status" do
    tests "Add", on: "Task"
    input  id: "l10-t0", story: "l10", order: 0, description: "first thing"
    expect id: "l10-t0", status: "pending", story: "l10"
  end

  test "Task.Add emits TaskAdded" do
    tests "Add", on: "Task"
    input  id: "l11-t0", story: "l11", order: 0, description: "a thing"
    expect emits: ["TaskAdded"]
  end

  test "Task.Complete moves a pending task to done" do
    tests "Complete", on: "Task"
    setup  "Add", id: "l12-t0", story: "l12", order: 0, description: "do it"
    input  id: "l12-t0"
    expect id: "l12-t0", status: "done"
  end

  test "Task.Complete emits TaskCompleted" do
    tests "Complete", on: "Task"
    setup  "Add", id: "l13-t0", story: "l13", order: 0, description: "do it"
    input  id: "l13-t0"
    expect emits: ["TaskCompleted"]
  end

  test "Task.Cancel moves a pending task to cancelled" do
    tests "Cancel", on: "Task"
    setup  "Add", id: "l14-t0", story: "l14", order: 0, description: "drop it"
    input  id: "l14-t0"
    expect id: "l14-t0", status: "cancelled"
  end

  test "Task.Cancel emits TaskCancelled" do
    tests "Cancel", on: "Task"
    setup  "Add", id: "l15-t0", story: "l15", order: 0, description: "drop it"
    input  id: "l15-t0"
    expect emits: ["TaskCancelled"]
  end

  test "Task.Complete on an already-done task is refused" do
    tests "Complete", on: "Task"
    setup  "Add",      id: "l16-t0", story: "l16", order: 0, description: "x"
    setup  "Complete", id: "l16-t0"
    input  id: "l16-t0"
    expect refused: "task must not already be resolved"
  end

  test "Task.Reopen returns a done task to pending" do
    tests "Reopen", on: "Task"
    setup  "Add",      id: "l17-t0", story: "l17", order: 0, description: "x"
    setup  "Complete", id: "l17-t0"
    input  id: "l17-t0"
    expect id: "l17-t0", status: "pending"
  end

  test "BumpPendingTaskCount emits PendingTaskCountBumped" do
    tests "BumpPendingTaskCount", on: "Story"
    setup  "Capture", ref: "l20", title: "L20", tier: 1, summary: "s", target: "t", project: "plan"
    input  ref: "l20"
    expect emits: ["PendingTaskCountBumped"]
  end

  test "Task.Add cascades through BumpOnTaskAdded and emits PendingTaskCountBumped" do
    # The load-bearing end-to-end : Task.Add fires TaskAdded, the
    # BumpOnTaskAdded policy dispatches Story.BumpPendingTaskCount on
    # the owning Story (routed by the event payload's story field),
    # which emits PendingTaskCountBumped. Verified empirically against
    # a live store : pending_task_count moves from 0 → 1.
    tests "Add", on: "Task", kind: :cascade
    setup  "Capture", ref: "l22", title: "L22", tier: 1, summary: "s", target: "t", project: "plan"
    input  id: "l22-t0", story: "l22", order: 0, description: "cascade probe"
    expect emits: ["TaskAdded", "PendingTaskCountBumped"]
  end

  test "DropPendingTaskCount emits PendingTaskCountDropped" do
    tests "DropPendingTaskCount", on: "Story"
    setup  "Capture",              ref: "l21", title: "L21", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "BumpPendingTaskCount", ref: "l21"
    input  ref: "l21"
    expect emits: ["PendingTaskCountDropped"]
  end

  # MarkReady has four pre-existing live-check invariants in addition to
  # ready_means_all_tasks_resolved — verified / merged_to_main / worktree_clean /
  # tests_passing. The two tests below arm the four flag-recorders first so the
  # only invariant we are exercising is the task-count one ; the rejection test
  # then leaves pending_task_count > 0, the success test cancels it back to 0.
  test "Story.MarkReady on a started story with an outstanding task is refused" do
    tests "MarkReady", on: "Story"
    setup  "Capture",                         ref: "l18", title: "L18", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AssignToSprint",                  ref: "l18", sprint_ref: "1"
    setup  "Tasked",                          ref: "l18"
    setup  "Start",                           ref: "l18"

    setup  "RequestReady",                           ref: "l18"
    setup  "RecordVerbResolvesCheckResult",   ref: "l18", ok: true
    setup  "RecordMergedCheckResult",         ref: "l18", ok: true
    setup  "RecordWorktreeCheckResult",       ref: "l18", ok: true
    setup  "RecordTestsCheckResult",          ref: "l18", ok: true
    setup  "RecordPrMergeableCheckResult",    ref: "l18", ok: true
    setup  "BumpPendingTaskCount",            ref: "l18"
    input  ref: "l18"
    expect refused: "ready_means_all_tasks_resolved"
  end

  test "Story.MarkReady succeeds once pending_task_count is 0" do
    tests "MarkReady", on: "Story"
    setup  "Capture",                         ref: "l19", title: "L19", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AssignToSprint",                  ref: "l19", sprint_ref: "1"
    setup  "Tasked",                          ref: "l19"
    setup  "Start",                           ref: "l19"

    setup  "RequestReady",                           ref: "l19"
    setup  "RecordVerbResolvesCheckResult",   ref: "l19", ok: true
    setup  "RecordMergedCheckResult",         ref: "l19", ok: true
    setup  "RecordWorktreeCheckResult",       ref: "l19", ok: true
    setup  "RecordTestsCheckResult",          ref: "l19", ok: true
    setup  "RecordPrMergeableCheckResult",    ref: "l19", ok: true
    setup  "BumpPendingTaskCount",            ref: "l19"
    setup  "DropPendingTaskCount",            ref: "l19"
    input  ref: "l19"
    expect ref: "l19", state: "ready_for_review"
  end
  test "Task.Complete cascades through DropOnTaskCompleted to the owning story" do
    # Regression (cascade-cross-aggregate-persist) : TaskCompleted carries only
    # the task id, not the story FK. The cascade must resolve the owning Story
    # from Task.story (the attribute whose declared type IS Story) ; resolving
    # by the leaked task id names no Story and made the cascade silently error,
    # so pending_task_count never dropped. Add bumps to 1 ; Complete must emit
    # PendingTaskCountDropped (proof it found the owning Story).
    tests "Complete", on: "Task", kind: :cascade
    setup "Capture", ref: "l24", title: "L24", tier: 1, summary: "s", target: "t", project: "plan"
    setup "Add",     id: "l24-t0", story: "l24", order: 0, description: "drop probe"
    input id: "l24-t0"
    expect emits: ["TaskCompleted", "PendingTaskCountDropped"]
  end


  # ── sprint-reorder-stories (sprint 14) ───────────────────────
  # Sprint.ReorderStories fixtures DEFERRED — the behaviors runner's
  # parse_value (behaviors_runner.rs : parse_value) lacks list-literal
  # support : `input story_refs: ["a", "b", "c"]` is stored as a single
  # Value::Str("[\"a\", \"b\", \"c\"]"), so story_refs.size returns the
  # string-byte length, not the list arity. The size-equality given() on
  # ReorderStories is correct DSL ; it will exercise correctly once the
  # runner gains list parsing (gap : runtime-list-input-in-behaviors).
  # Board.ReorderSprints shipped with zero fixtures by the same precedent.
  # The companion-ratchet test below exercises the command-existence +
  # size-equality given() on the refusal branch.
  test "Sprint.ReorderStories refuses a size-mismatch input" do
    tests "ReorderStories", on: "Sprint"
    setup  "Plan",     number: "42", goal: "reorder reject", project: "plan"
    setup  "AddStory", number: "42", story: "a"
    setup  "AddStory", number: "42", story: "b"
    setup  "AddStory", number: "42", story: "c"
    input  number: "42", story_refs: "only-one"
    expect refused: "story_refs must be a permutation of stories"
  end

  # pending-task-count-default-zero (sprint 14) — proves the load-bearing
  # default. A freshly-Captured story has pending_task_count = 0 by
  # attribute default ; the ready_means_all_tasks_resolved invariant must
  # clear on MarkReady WITHOUT any Bump/Drop interaction. Regression guard
  # for the bug where the default was missing and the invariant rejected
  # MarkReady because None != 0.
  test "Story.MarkReady succeeds on a freshly-Captured story without any task interactions" do
    tests "MarkReady", on: "Story"
    setup  "Capture",                         ref: "l23", title: "L23", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AssignToSprint",                  ref: "l23", sprint_ref: "1"
    setup  "Tasked",                          ref: "l23"
    setup  "Start",                           ref: "l23"

    setup  "RequestReady",                           ref: "l23"
    setup  "RecordVerbResolvesCheckResult",   ref: "l23", ok: true
    setup  "RecordMergedCheckResult",         ref: "l23", ok: true
    setup  "RecordWorktreeCheckResult",       ref: "l23", ok: true
    setup  "RecordTestsCheckResult",          ref: "l23", ok: true
    setup  "RecordPrMergeableCheckResult",    ref: "l23", ok: true
    input  ref: "l23"
    expect ref: "l23", state: "ready_for_review", pending_task_count: 0
  end

  # ── Worktree lifecycle (worktree-removal-is-story-done-gate) ──
  test "LockWorktree claims the worktree and locks it" do
    tests "LockWorktree", on: "Story"
    setup  "Capture", ref: "wt1", title: "WT", tier: 1, summary: "s", target: "t", project: "plan"
    input  ref: "wt1", worktree_path: "/tmp/wt/wt1"
    expect ref: "wt1", worktree_locked: true, worktree_path: "/tmp/wt/wt1"
  end

  test "LockWorktree is refused when the worktree is already locked" do
    tests "LockWorktree", on: "Story"
    setup  "Capture", ref: "wt2", title: "WT", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "LockWorktree", ref: "wt2", worktree_path: "/tmp/wt/wt2"
    input  ref: "wt2", worktree_path: "/tmp/other"
    expect refused: "worktree not already locked"
  end

  test "UnlockWorktree releases the worktree lock" do
    tests "UnlockWorktree", on: "Story"
    setup  "Capture", ref: "wt3", title: "WT", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "LockWorktree", ref: "wt3", worktree_path: "/tmp/wt/wt3"
    input  ref: "wt3"
    expect ref: "wt3", worktree_locked: false
  end

  test "RecordWorktreeRemovedCheckResult sets worktree_removed" do
    tests "RecordWorktreeRemovedCheckResult", on: "Story"
    setup  "Capture", ref: "wr1", title: "WR", tier: 1, summary: "s", target: "t", project: "plan"
    input  ref: "wr1", ok: true
    expect ref: "wr1", worktree_removed: true
  end

  test "Approve is refused when the worktree has not been removed" do
    tests "Approve", on: "Story"
    setup  "Capture",                       ref: "wr2", title: "WR", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AssignToSprint",                ref: "wr2", sprint_ref: "1"
    setup  "Tasked",                        ref: "wr2"
    setup  "Start",                         ref: "wr2"

    setup  "RequestReady",                         ref: "wr2"
    setup  "RecordVerbResolvesCheckResult", ref: "wr2", ok: true
    setup  "RecordMergedCheckResult",       ref: "wr2", ok: true
    setup  "RecordWorktreeCheckResult",     ref: "wr2", ok: true
    setup  "RecordTestsCheckResult",        ref: "wr2", ok: true
    setup  "RecordPrMergeableCheckResult",  ref: "wr2", ok: true
    setup  "MarkReady",                     ref: "wr2"
    input  story: "wr2"
    expect refused: "removed_means_done"
  end

  test "Approve succeeds once the worktree is removed" do
    tests "Approve", on: "Story"
    setup  "Capture",                          ref: "wr3", title: "WR", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AssignToSprint",                   ref: "wr3", sprint_ref: "1"
    setup  "Tasked",                           ref: "wr3"
    setup  "Start",                            ref: "wr3"

    setup  "RequestReady",                            ref: "wr3"
    setup  "RecordVerbResolvesCheckResult",    ref: "wr3", ok: true
    setup  "RecordMergedCheckResult",          ref: "wr3", ok: true
    setup  "RecordWorktreeCheckResult",        ref: "wr3", ok: true
    setup  "RecordTestsCheckResult",           ref: "wr3", ok: true
    setup  "RecordPrMergeableCheckResult",    ref: "wr3", ok: true
    setup  "RecordWorktreeRemovedCheckResult", ref: "wr3", ok: true
    setup  "MarkReady",                        ref: "wr3"
    input  story: "wr3"
    expect ref: "wr3", state: "done"
  end

  # ── pr-delivery-merge-on-accept (sprint 20) ──────────────────────────

  test "Story.MarkReady is refused when pr_mergeable is false" do
    # pr_mergeable gate (given guard) fires BEFORE invariants, so we arm all
    # other flags (verified/merged/worktree_clean/tests/task_count) but leave
    # pr_mergeable false. The refused message is the given guard string.
    tests "MarkReady", on: "Story"
    setup  "Capture",                         ref: "pm1", title: "PM1", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AssignToSprint",                  ref: "pm1", sprint_ref: "1"
    setup  "Tasked",                          ref: "pm1"
    setup  "Start",                           ref: "pm1"

    setup  "RequestReady",                           ref: "pm1"
    setup  "RecordVerbResolvesCheckResult",   ref: "pm1", ok: true
    setup  "RecordMergedCheckResult",         ref: "pm1", ok: true
    setup  "RecordWorktreeCheckResult",       ref: "pm1", ok: true
    setup  "RecordTestsCheckResult",          ref: "pm1", ok: true
    # pr_mergeable intentionally NOT armed — remains false (default)
    input  ref: "pm1"
    expect refused: "the PR must be mergeable"
  end

  test "Story.MarkReady succeeds once pr_mergeable is armed true" do
    tests "MarkReady", on: "Story"
    setup  "Capture",                         ref: "pm2", title: "PM2", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AssignToSprint",                  ref: "pm2", sprint_ref: "1"
    setup  "Tasked",                          ref: "pm2"
    setup  "Start",                           ref: "pm2"

    setup  "RequestReady",                           ref: "pm2"
    setup  "RecordVerbResolvesCheckResult",   ref: "pm2", ok: true
    setup  "RecordMergedCheckResult",         ref: "pm2", ok: true
    setup  "RecordWorktreeCheckResult",       ref: "pm2", ok: true
    setup  "RecordTestsCheckResult",          ref: "pm2", ok: true
    setup  "RecordPrMergeableCheckResult",    ref: "pm2", ok: true
    input  ref: "pm2"
    expect ref: "pm2", state: "ready_for_review"
  end

  test "RecordPrMergeableCheckResult arms pr_mergeable" do
    tests "RecordPrMergeableCheckResult", on: "Story"
    setup  "Capture", ref: "pm3", title: "PM3", tier: 1, summary: "s", target: "t", project: "plan"
    input  ref: "pm3", ok: true
    expect ref: "pm3", pr_mergeable: true
  end

  # ── appended: story-dependency-dag + contract-first-sprint-gate ──

  # ── Story dependency DAG (story-dependency-dag, sprint 20) ───────────

  test "AddDependency appends a dependency ref to the story" do
    tests "AddDependency", on: "Story"
    setup  "Capture", ref: "dep1", title: "Dep story", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "Capture", ref: "dep2", title: "Main story", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AddDependency", ref: "dep2", dependency: "dep1"
    input  ref: "dep2", dependency: "dep1"
    expect ref: "dep2"
  end

  test "AddDependency emits DependencyAdded" do
    tests "AddDependency", on: "Story"
    setup  "Capture", ref: "dep3", title: "Dep story", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "Capture", ref: "dep4", title: "Main story", tier: 1, summary: "s", target: "t", project: "plan"
    input  ref: "dep4", dependency: "dep3"
    expect emits: ["DependencyAdded"]
  end

  test "RemoveDependency replaces the dependencies list (whole-list replace, gap: runtime-list-remove-primitive)" do
    tests "RemoveDependency", on: "Story"
    setup  "Capture", ref: "dep5", title: "Dep story", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "Capture", ref: "dep6", title: "Main story", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AddDependency", ref: "dep6", dependency: "dep5"
    input  ref: "dep6", dependency: "dep5", dependencies: []
    expect ref: "dep6"
  end

  test "RemoveDependency emits DependencyRemoved" do
    tests "RemoveDependency", on: "Story"
    setup  "Capture", ref: "dep7", title: "Dep story", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "Capture", ref: "dep8", title: "Main story", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AddDependency", ref: "dep8", dependency: "dep7"
    input  ref: "dep8", dependency: "dep7", dependencies: []
    expect emits: ["DependencyRemoved"]
  end

  # Claimable query : runtime enforces state == "tasked" ; dep-state exclusion
  # is projection-side (gap : runtime-cross-aggregate-where). Tests verify
  # the state filter ; blocked/unblocked semantics are documented contract.

  test "Claimable includes a tasked story with no dependencies (unblocked)" do
    tests "Claimable", on: "Story", kind: :query
    setup  "Capture", ref: "clm1", title: "Claimable", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AssignToSprint", ref: "clm1", sprint_ref: "20"
    setup  "Tasked", ref: "clm1"
    expect includes: { ref: "clm1", state: "tasked" }
  end

  test "Claimable excludes a story still in untasked state (blocked by lifecycle, not dep)" do
    tests "Claimable", on: "Story", kind: :query
    setup  "Capture", ref: "clm2", title: "Untasked", tier: 1, summary: "s", target: "t", project: "plan"
    expect count: 0
  end

  test "RatifyContracts records contracts and flips contracts_ratified true" do
    tests "RatifyContracts", on: "Sprint"
    setup  "Plan", number: "90", goal: "g", project: "plan"
    input  number: "90", contracts: "Worker/Claim/Lease/MergeQueue interfaces"
    expect number: "90", contracts_ratified: true
  end

  test "RatifyContracts emits SprintContractsRatified" do
    tests "RatifyContracts", on: "Sprint"
    setup  "Plan", number: "91", goal: "g", project: "plan"
    input  number: "91", contracts: "the contract"
    expect emits: ["SprintContractsRatified"]
  end
  # ── appended: ci-fence-main-up-to-date ──
  test "RecordMainUpToDateCheckResult arms main_up_to_date when ok is true" do
    tests "RecordMainUpToDateCheckResult", on: "Story"
    setup  "Capture", ref: "mu1", title: "MU", tier: 1, summary: "s", target: "t", project: "plan"
    input  ref: "mu1", ok: true
    expect ref: "mu1", main_up_to_date: true
  end

  test "RecordMainUpToDateCheckResult clears main_up_to_date when ok is false" do
    tests "RecordMainUpToDateCheckResult", on: "Story"
    setup  "Capture",                         ref: "mu2", title: "MU", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "RecordMainUpToDateCheckResult",    ref: "mu2", ok: true
    input  ref: "mu2", ok: false
    expect ref: "mu2", main_up_to_date: false
  end

  # ── Done-is-done gate enforcement (done-is-done-gate-enforcement) ────
  test "RequestReady moves a started story to checking" do
    tests "RequestReady", on: "Story"
    setup  "Capture",        ref: "ck1", title: "C1", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AssignToSprint", ref: "ck1", sprint_ref: "1"
    setup  "Tasked",         ref: "ck1"
    setup  "Start",          ref: "ck1"
    input  ref: "ck1"
    expect ref: "ck1", state: "checking"
  end

  test "A recorded check auto-advances checking to ready_for_review when all gates pass" do
    tests "RecordPrMergeableCheckResult", on: "Story", kind: :cascade
    setup  "Capture",                       ref: "ck2", title: "C2", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AssignToSprint",                ref: "ck2", sprint_ref: "1"
    setup  "Tasked",                        ref: "ck2"
    setup  "Start",                         ref: "ck2"
    setup  "RequestReady",                  ref: "ck2"
    setup  "RecordVerbResolvesCheckResult", ref: "ck2", ok: true
    setup  "RecordMergedCheckResult",       ref: "ck2", ok: true
    setup  "RecordWorktreeCheckResult",     ref: "ck2", ok: true
    setup  "RecordTestsCheckResult",        ref: "ck2", ok: true
    input  ref: "ck2", ok: true
    expect ref: "ck2", state: "ready_for_review"
  end

  test "A failing check leaves the story in checking (the gate holds)" do
    tests "RecordPrMergeableCheckResult", on: "Story", kind: :cascade
    setup  "Capture",                       ref: "ck3", title: "C3", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AssignToSprint",                ref: "ck3", sprint_ref: "1"
    setup  "Tasked",                        ref: "ck3"
    setup  "Start",                         ref: "ck3"
    setup  "RequestReady",                  ref: "ck3"
    setup  "RecordVerbResolvesCheckResult", ref: "ck3", ok: true
    setup  "RecordMergedCheckResult",       ref: "ck3", ok: true
    setup  "RecordWorktreeCheckResult",     ref: "ck3", ok: true
    setup  "RecordTestsCheckResult",        ref: "ck3", ok: true
    input  ref: "ck3", ok: false
    expect ref: "ck3", state: "checking"
  end

  test "ChecksFailed moves a checking story back to started" do
    tests "ChecksFailed", on: "Story"
    setup  "Capture",        ref: "cf1", title: "CF1", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AssignToSprint", ref: "cf1", sprint_ref: "1"
    setup  "Tasked",         ref: "cf1"
    setup  "Start",          ref: "cf1"
    setup  "RequestReady",   ref: "cf1"
    input  ref: "cf1"
    expect ref: "cf1", state: "started"
  end

  # ---- Epic : optional cross-cutting grouping of Sprints + Stories under a Project ----

  test "Frame mints an epic in active status" do
    tests "Frame", on: "Epic"
    input  name: "ep1", title: "Epic one", description: "first epic"
    expect name: "ep1", status: "active"
  end

  test "Frame emits EpicFramed" do
    tests "Frame", on: "Epic"
    input  name: "ep2", title: "Epic two", description: "second epic"
    expect emits: ["EpicFramed"]
  end

  test "Reword amends an epic title and description" do
    tests "Reword", on: "Epic"
    setup  "Frame", name: "ep3", title: "Old", description: "old"
    input  id: "ep3", title: "New", description: "new"
    expect emits: ["EpicReworded"]
  end

  test "AddSprint groups a sprint under an epic" do
    tests "AddSprint", on: "Epic"
    setup  "Frame", name: "ep4", title: "E4", description: "d"
    input  name: "ep4", sprint: "19"
    expect emits: ["SprintAddedToEpic"]
  end

  test "AddStory groups a story under an epic" do
    tests "AddStory", on: "Epic"
    setup  "Frame", name: "ep5", title: "E5", description: "d"
    input  id: "ep5", story: "some-story"
    expect emits: ["StoryAddedToEpic"]
  end

  test "Complete marks an epic done" do
    tests "Complete", on: "Epic"
    setup  "Frame", name: "ep6", title: "E6", description: "d"
    input  id: "ep6"
    expect name: "ep6", status: "done"
  end

  test "Cancel soft-deletes an epic" do
    tests "Cancel", on: "Epic"
    setup  "Frame", name: "ep7", title: "E7", description: "d"
    input  id: "ep7"
    expect name: "ep7", status: "cancelled"
  end

  test "AddEpic adds an epic to a project" do
    tests "AddEpic", on: "Project"
    setup  "Register", name: "proj1", description: "a project"
    input  name: "proj1", epic: "ep1"
    expect emits: ["EpicAddedToProject"]
  end


  test "Plan refuses a sprint with an empty number" do
    tests "Plan", on: "Sprint"
    input  number: "", goal: "no number", project: "plan"
    expect refused: "number must be set"
  end


  test "Renumber changes a sprint number" do
    tests "Renumber", on: "Sprint"
    setup  "Plan", number: "78", goal: "to renumber", project: "plan"
    input  id: "78", new_number: "79"
    expect number: "79"
  end

  test "Plan refuses a sprint with no project" do
    tests "Plan", on: "Sprint"
    input  number: "5", goal: "orphan sprint"
    expect refused: "project is required"
  end

  test "Capture refuses a story with no project" do
    tests "Capture", on: "Story"
    input  ref: "np1", title: "No project", tier: 1, summary: "s", target: "t"
    expect refused: "project is required"
  end

  test "Sprint.AssignToProject sets a sprint's project" do
    tests "AssignToProject", on: "Sprint"
    setup  "Plan", number: "200", goal: "g", project: "plan"
    input  id: "200", project: "framework"
    expect number: "200", project: "framework"
  end

  test "Sprint.AssignToProject refuses without a project" do
    tests "AssignToProject", on: "Sprint"
    setup  "Plan", number: "201", goal: "g", project: "plan"
    input  id: "201"
    expect refused: "project is required"
  end

  test "Start refused when the story sprint has unratified contracts" do
    tests "Start", on: "Story"
    setup  "Sprint.Plan",     number: "3", goal: "g", project: "plan"
    setup  "Capture",        ref: "cg1", title: "CG1", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AssignToSprint", ref: "cg1", sprint_ref: "3"
    setup  "Tasked",         ref: "cg1"
    input  ref: "cg1"
    expect refused: "sprint contracts must be ratified"
  end

  test "Start succeeds when the story sprint has ratified contracts" do
    tests "Start", on: "Story"
    setup  "Capture",        ref: "cg2", title: "CG2", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AssignToSprint", ref: "cg2", sprint_ref: "1"
    setup  "Tasked",         ref: "cg2"
    input  ref: "cg2"
    expect state: "started"
  end

  # Board query : runtime enforces the STATE-SET filter via WhereOp::In
  # (where state: { in: [untasked, tasked, started, ready_for_review] }).
  # The active-sprint membership half stays projector-side until its
  # cross-aggregate WhereOp lands.

  test "Board includes an untasked story" do
    tests "Board", on: "Story", kind: :query
    setup  "Capture", ref: "bd1", title: "B1", tier: 1, summary: "s", target: "t", project: "plan"
    expect includes: { ref: "bd1", state: "untasked" }
  end

  test "Board includes a tasked story" do
    tests "Board", on: "Story", kind: :query
    setup  "Capture", ref: "bd2", title: "B2", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "Tasked",  ref: "bd2"
    expect includes: { ref: "bd2", state: "tasked" }
  end

  # ---- Refusal coverage for lifecycle / required-field invariants ----
  # (bulletproofing : every declared given gets a refusal test)

  test "Sprint.Plan refused without a number" do
    tests "Plan", on: "Sprint"
    input  number: "", goal: "g", project: "plan"
    expect refused: "number must be set"
  end

  test "Sprint.UpdateGoal refused with an empty goal" do
    tests "UpdateGoal", on: "Sprint"
    setup  "Plan", number: "80", goal: "g", project: "plan"
    input  number: "80", goal: ""
    expect refused: "goal must be non-empty"
  end

  test "Sprint.Renumber refused without a new number" do
    tests "Renumber", on: "Sprint"
    setup  "Plan", number: "81", goal: "g", project: "plan"
    input  number: "81", new_number: ""
    expect refused: "new number must be set"
  end

  test "Sprint.Activate refused when not planned" do
    tests "Activate", on: "Sprint"
    setup  "Plan",     number: "82", goal: "g", project: "ap"
    setup  "Activate", number: "82"
    input  number: "82"
    expect refused: "must be planned"
  end

  test "Story.Tasked refused when already tasked" do
    tests "Tasked", on: "Story"
    setup  "Capture", ref: "rt1", title: "t", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "Tasked",  ref: "rt1"
    input  ref: "rt1"
    expect refused: "can only flip to tasked from untasked"
  end

  test "Story.Start refused when untasked" do
    tests "Start", on: "Story"
    setup  "Capture",        ref: "rt2", title: "t", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AssignToSprint", ref: "rt2", sprint_ref: "1"
    input  ref: "rt2"
    expect refused: "story must be tasked before starting"
  end


  test "Task.Reopen refused when the task is not resolved" do
    tests "Reopen", on: "Task"
    setup  "Add", id: "tk1", story: "rt1", order: 1, description: "d"
    input  id: "tk1"
    expect refused: "task must currently be resolved"
  end

  test "Project.Activate refused when not paused" do
    tests "Activate", on: "Project"
    setup  "Register", name: "pa1"
    input  name: "pa1"
    expect refused: "must be paused"
  end

  test "Project.Pause refused when not active" do
    tests "Pause", on: "Project"
    setup  "Register", name: "pa2"
    setup  "Pause",    name: "pa2"
    input  name: "pa2"
    expect refused: "must be active"
  end

  # NOTE Project.Complete's "must be active or paused" gate is enforced but not
  # behavior-tested : reaching a terminal Project state requires Complete/Cancel,
  # whose names collide across aggregates (Task/Story/Sprint), so a setup step
  # resolves ambiguously. Same gate family as Project.Activate/Pause (covered).

  test "Sprint.AddUnplanned refused when the sprint is not active" do
    tests "AddUnplanned", on: "Sprint"
    setup  "Plan", number: "83", goal: "g", project: "plan"
    input  number: "83", story_ref: "x"
    expect refused: "unplanned work preempts only an active sprint"
  end

  test "Sprint.AddStory refused once the sprint is active (planned scope freezes)" do
    tests "AddStory", on: "Sprint"
    setup  "Plan",     number: "85", goal: "g", project: "asf"
    setup  "Activate", number: "85"
    input  number: "85", story: "x"
    expect refused: "planned scope freezes once active"
  end

  test "Story.AssignToSprint refused with an empty sprint_ref" do
    tests "AssignToSprint", on: "Story"
    setup  "Capture", ref: "as1", title: "t", tier: 1, summary: "s", target: "t", project: "plan"
    input  ref: "as1", sprint_ref: ""
    expect refused: "sprint_ref must be named"
  end

  test "Story.Start refused while a dependency is unresolved" do
    tests "Start", on: "Story"
    setup  "Capture",        ref: "dpar", title: "t", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "Capture",        ref: "dchild", title: "t", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "AssignToSprint", ref: "dchild", sprint_ref: "1"
    setup  "Tasked",         ref: "dchild"
    setup  "AddDependency",  ref: "dchild", dependency: "dpar"
    input  ref: "dchild"
    expect refused: "all dependencies must be resolved before starting"
  end
  # ── project-owns-active-sprint-uniqueness (DDD re-enforcement) ──
  # one-active-per-project is enforced INSIDE Project, intra-aggregate, against
  # its own active_sprint field. No cross-aggregate read.
  test "Project.ActivateSprint records the active sprint locally" do
    tests "ActivateSprint", on: "Project"
    setup  "Register", name: "alpha"
    input  project: "alpha", sprint_ref: "1"
    expect active_sprint: "1"
  end

  test "Project.ActivateSprint refuses a different sprint while one is active" do
    tests "ActivateSprint", on: "Project"
    setup  "Register",       name: "beta"
    setup  "Project.ActivateSprint", project: "beta", sprint_ref: "1"
    input  project: "beta", sprint_ref: "2"
    expect refused: "one active sprint per project"
  end

  test "Project.ActivateSprint is idempotent on the same sprint" do
    tests "ActivateSprint", on: "Project"
    setup  "Register",       name: "gamma"
    setup  "Project.ActivateSprint", project: "gamma", sprint_ref: "1"
    input  project: "gamma", sprint_ref: "1"
    expect active_sprint: "1"
  end

  test "Project.DeactivateSprint clears the active sprint" do
    tests "DeactivateSprint", on: "Project"
    setup  "Register",               name: "delta"
    setup  "Project.ActivateSprint", project: "delta", sprint_ref: "1"
    input  project: "delta"
    expect active_sprint: ""
  end

  test "Project.DeactivateSprint is refused when no sprint is active" do
    tests "DeactivateSprint", on: "Project"
    setup  "Register", name: "epsilon"
    input  project: "epsilon"
    expect refused: "a sprint must be active to deactivate"
  end

  # ── replicated sprint_active flag (DDD : Story reads its own copy) ──
  test "Story.MarkSprintActive sets the local sprint_active flag" do
    tests "MarkSprintActive", on: "Story"
    setup  "Capture", ref: "sa1", title: "SA1", tier: 1, summary: "s", target: "t", project: "plan"
    input  ref: "sa1"
    expect ref: "sa1", sprint_active: true
  end

  test "Story.ClearSprintActive clears the local sprint_active flag" do
    tests "ClearSprintActive", on: "Story"
    setup  "Capture",          ref: "sa2", title: "SA2", tier: 1, summary: "s", target: "t", project: "plan"
    setup  "MarkSprintActive", ref: "sa2"
    input  ref: "sa2"
    expect ref: "sa2", sprint_active: false
  end

end
