Hecks.bluebook "Sprint", version: "2026.05.25.2" do
  vision "A time-box that committed stories are promoted into. Sprints walk planned → active → ready_for_closure → completed; stories accumulate via AddStory. Completed is only reachable through Approve (Operator role) from ready_for_closure. RequestClosure is the Miette signal that all closure criteria are satisfied; Approve is the gated human confirmation. Seed three; more are addable."
  category "plan"

  # ── Sprint aggregate ──────────────────────────────────────────────
  #
  # One row per sprint. Identified by a string number ("1","2","3").
  # String-valued for safe id resolution across tools.
  # Lifecycle: planned → active → ready_for_closure → completed.
  # Story membership: list_of(StoryRef) grows via AddStory.
  #
  # Done-is-done gate (mirror of Story.ready_means_verified):
  # A Sprint may not enter ready_for_closure or completed unless ALL six
  # closure_criteria flags are true. Each flag is set by its own Mark*
  # command (per-flag audit trail). The `closure_criteria_met` invariant
  # enforces this — RequestClosure is refused with InvariantViolation when
  # any flag is still false.

  aggregate "Sprint", "One time-boxed sprint — a number, a goal, a list of committed stories, a closure checklist, and a lifecycle state." do
    identified_by :number

    # ---- Identity ----
    attribute :number,              Number

    # ---- Content ----
    attribute :goal,                Goal

    # ---- Project assignment ----
    attribute :project,             Project

    # ---- Membership ----
    # story_refs    : committed (planned) stories promoted into this sprint
    #                 while it is planned. Frozen once active (rule #5).
    # unplanned_refs: explicit preempts added WHILE active (AddUnplanned).
    # Completion reads both lists — the record distinguishes planned from
    # unplanned work done in the sprint.
    attribute :story_refs,          list_of(StoryRef)
    attribute :unplanned_refs,      list_of(StoryRef)

    # ---- Lifecycle ----
    # state: planned | active | ready_for_closure | completed
    attribute :state,               State, default: "planned"

    # ---- Closure criteria (Sprint DoD) ----
    # Six operator/runtime-confirmed flags. All must be true before
    # RequestClosure may fire. Each is armed by its own Mark* command.
    attribute :all_stories_done,    AllStoriesDone,    default: false
    attribute :merged_to_main,      MergedToMain,      default: false
    attribute :ci_passing,          CiPassing,         default: false
    attribute :summary_drafted,     SummaryDrafted,    default: false
    attribute :worktrees_pruned,    WorktreesPruned,   default: false
    attribute :prs_for_open_branches, PrsForOpenBranches, default: false
    attribute :wip_limit,           WipLimit,          default: 0

    # ── Value-objects : the sprint's vocabulary ──

    value_object "Number" do
      # String-valued sprint identifier ("1", "2", "3"). String form
      # keeps id resolution safe regardless of caller type coercion.
      attribute :value, String
    end

    value_object "Goal" do
      # One-line description of the sprint's intention — what the
      # team commits to delivering by the end of the time-box.
      attribute :value, String
    end

    value_object "StoryRef" do
      # Opaque reference to a story committed into this sprint.
      # String-valued; the planning domain does not validate story
      # existence — that is the concern of the Story aggregate.
      attribute :value, String
    end

    value_object "State" do
      # Lifecycle token: planned / active / ready_for_closure / completed.
      attribute :value, String
    end

    value_object "Project" do
      # The project this sprint belongs to. E.g. "framework", "mel",
      # "opt". Optional — existing sprints 1–3 are the framework
      # project's sprints and do not require this field to be set.
      attribute :value, String
    end

    value_object "AllStoriesDone" do
      # True once the caller has confirmed every committed story reached
      # the done state. Armed by MarkAllStoriesDone.
      attribute :value, Boolean
    end

    value_object "MergedToMain" do
      # True once the sprint branch (if any) has been merged to main.
      # Armed by MarkMergedToMain.
      attribute :value, Boolean
    end

    value_object "CiPassing" do
      # True once CI is green on main after the sprint's work landed.
      # Armed by MarkCiPassing.
      attribute :value, Boolean
    end

    value_object "SummaryDrafted" do
      # True once a written retrospective / summary has been drafted.
      # Armed by MarkSummaryDrafted.
      attribute :value, Boolean
    end

    value_object "WorktreesPruned" do
      # True once all sprint worktrees have been pruned / removed.
      # Armed by MarkWorktreesPruned.
      attribute :value, Boolean
    end

    value_object "PrsForOpenBranches" do
      # True once open branches have PRs filed so nothing is lost.
      # Armed by MarkPrsForOpenBranches.
      attribute :value, Boolean
    end

    value_object "WipLimit" do
      # Max stories allowed in started state at once. 0 = unlimited.
      attribute :value, Integer
    end

    value_object "StoryCount" do
      # How many stories the sprint fanned out over. Carried on
      # SprintExecuted so downstream reactors know the fan-out width
      # without re-querying the Story store.
      attribute :value, Integer
    end

    # ============================================================
    # COMMANDS
    # ============================================================

    command "Plan" do
      role "Miette"
      description "Create a new sprint with a number and a goal. Sets state to planned. This is the creation command — the record does not exist yet."
      attribute :number, Number
      attribute :goal,   Goal
      then_set :number, to: :number
      then_set :goal,   to: :goal
      then_set :state,  to: "planned"
      emits "SprintPlanned"
    end

    command "UpdateGoal" do
      role "Miette"
      description "Amend the sprint's goal text — pure metadata, no lifecycle change. Used to rename a sprint whose theme has clarified since it was planned (e.g. sprint 2 'Product Executor' → 'Decomposition' once the cards revealed the real shape). Valid from any state."
      reference_to(Sprint)
      attribute :goal, Goal
      then_set :goal, to: :goal
      given("goal must be non-empty") { goal != "" }
      emits "SprintGoalUpdated"
    end

    command "AddStory" do
      role "Miette"
      description "Append a story ref to the sprint's committed membership list. The sprint must exist; the story is promoted into this sprint."
      reference_to(Sprint)
      attribute :story_ref, StoryRef
      given("planned scope freezes once active — only AddUnplanned may add to an active sprint (rule #5)") { state == "planned" }
      then_set :story_refs, append: :story_ref
      emits "StoryAddedToSprint"
    end

    command "AddUnplanned" do
      role "Miette"
      description "Attach an UNPLANNED story to the active sprint — an explicit preempt. Recorded on unplanned_refs (separate from the planned story_refs) so the completion record distinguishes planned from unplanned work. Allowed ONLY while the sprint is active : the sanctioned way work enters an active sprint, counterpart to AddStory's planned-scope freeze (rule #5)."
      reference_to(Sprint)
      attribute :story_ref, StoryRef
      given("unplanned work preempts only an active sprint") { state == "active" }
      then_set :unplanned_refs, append: :story_ref
      emits "UnplannedStoryAdded"
    end

    command "Reorder" do
      role "Miette"
      description "Replace the entire story_refs list with a new sequence. The caller supplies the full desired membership order — use this to remove, reorder, or swap stories out of a sprint."
      reference_to(Sprint)
      attribute :story_refs, list_of(StoryRef)
      then_set :story_refs, to: :story_refs
      emits "SprintReordered"
    end

    command "Groom" do
      role "Miette"
      description "Mark the sprint's committed stories as expressed in the bluebook — a pure signal, no state mutation. Emits SprintGroomed so downstream policies can react."
      reference_to(Sprint)
      emits "SprintGroomed"
    end

    command "Activate" do
      role "Miette"
      description "Transition the sprint from planned to active. Work begins."
      reference_to(Sprint)
      given("must be planned") { state == "planned" }
      then_set :state, to: "active"
      emits "SprintActivated"
    end

    # ── Closure criteria setters ─────────────────────────────────
    # Each command arms one flag in the Sprint DoD checklist.
    # No lifecycle change — flags can be set in any order while active.
    # All six must be true before RequestClosure may fire.

    command "MarkAllStoriesDone" do
      role "Miette"
      description "Confirm every committed story in this sprint has reached done state. Sets all_stories_done to true. Does not change lifecycle — this arms one flag in the closure checklist."
      reference_to(Sprint)
      then_set :all_stories_done, to: true
      emits "AllStoriesMarkedDone"
    end

    command "MarkMergedToMain" do
      role "Miette"
      description "Confirm the sprint's branch (if any) has been merged to main. Sets merged_to_main to true."
      reference_to(Sprint)
      then_set :merged_to_main, to: true
      emits "MergedToMainMarked"
    end

    command "MarkCiPassing" do
      role "Miette"
      description "Confirm CI is green on main after the sprint's work landed. Sets ci_passing to true."
      reference_to(Sprint)
      then_set :ci_passing, to: true
      emits "CiPassingMarked"
    end

    command "MarkSummaryDrafted" do
      role "Miette"
      description "Confirm a retrospective / summary has been drafted for this sprint. Sets summary_drafted to true."
      reference_to(Sprint)
      then_set :summary_drafted, to: true
      emits "SummaryDraftedMarked"
    end

    command "MarkWorktreesPruned" do
      role "Miette"
      description "Confirm all sprint worktrees have been pruned and removed. Sets worktrees_pruned to true."
      reference_to(Sprint)
      then_set :worktrees_pruned, to: true
      emits "WorktreesPrunedMarked"
    end

    command "MarkPrsForOpenBranches" do
      role "Miette"
      description "Confirm open branches have PRs filed so no work is lost at sprint close. Sets prs_for_open_branches to true."
      reference_to(Sprint)
      then_set :prs_for_open_branches, to: true
      emits "PrsForOpenBranchesMarked"
    end

    # ── Closure gate ─────────────────────────────────────────────

    command "RequestClosure" do
      role "Miette"
      description "Signal that all closure criteria are satisfied and the sprint is ready for human sign-off. Moves active to ready_for_closure. The closure_criteria_met invariant enforces the DoD gate: RequestClosure is refused (InvariantViolation, 0 events) unless all six criteria flags are true. Arm each flag with its Mark* command first."
      reference_to(Sprint)
      emits "SprintClosureRequested"
    end

    command "Approve" do
      role "Operator"
      description "Human gate: move a ready_for_closure sprint to completed. Only Operator may Approve. Emits SprintApproved. Completed is only reachable via this command — there is no direct path from active to completed."
      reference_to(Sprint)
      emits "SprintApproved"
    end

    command "Reopen" do
      role "Operator"
      description "Un-close a sprint: move completed back to active and RESET all six closure criteria to false, so the Done-is-Done gate must be genuinely re-satisfied before it can close again. The missing lifecycle exit from completed — closes the gap where a sprint approved on incomplete criteria could not be corrected. Only Operator may Reopen."
      reference_to(Sprint)
      then_set :state, to: "active"
      then_set :all_stories_done, to: false
      then_set :merged_to_main, to: false
      then_set :ci_passing, to: false
      then_set :summary_drafted, to: false
      then_set :worktrees_pruned, to: false
      then_set :prs_for_open_branches, to: false
      emits "SprintReopened"
    end

    command "Cancel" do
      role "Miette"
      description "Soft-delete a sprint: move it to the terminal `cancelled` state. For removing phantom or erroneous sprints — e.g. the demo sprints flows leave behind when run against the live store. Cancelled sprints drop out of Board (which is active-only). Hard record removal is a separate runtime concern (no Delete primitive yet) ; Cancel is the bluebook-first way to take an unwanted sprint out of circulation."
      reference_to(Sprint)
      then_set :state, to: "cancelled"
      emits "SprintCancelled"
    end

    command "Deactivate" do
      role "Miette"
      description "Return an active sprint to planned — the legitimate way to step a sprint back out of active (e.g. it was activated before the current sprint was closed). The missing reverse of Activate ; enables the one-active-sprint rule (close-before-activate) to be honoured without cancelling real work."
      reference_to(Sprint)
      then_set :state, to: "planned"
      emits "SprintDeactivated"
    end

    command "Execute" do
      role "System"
      description "The operator entry for fanning out a sprint's stories. Dispatching Plan::Sprint.Execute through the bus emits SprintExecuted with story_count; the runtime projection of SprintExecuted queries Plan::Story.BySprint to find every story committed to this sprint, then runs each story's use cases directly (the same step-execution path StoryExecuted uses). It does NOT re-dispatch Plan::Story.Execute per story — that would re-trigger the StoryExecuted projection and double-run. Pure signal: no state transition, valid from any state."
      reference_to(Sprint)
      attribute :story_count, StoryCount
      emits "SprintExecuted"
    end

    # ── Lifecycle state machine ──────────────────────────────────
    #
    # Plan has no `from:` — it is the creation command; the record
    # does not exist until Plan fires.

    command "SetWipLimit" do
      role "Operator"
      description "Set the sprint WIP limit — the max number of stories allowed in started state at once. 0 means unlimited. Bounds in-progress work."
      reference_to(Sprint)
      attribute :wip_limit, WipLimit
      then_set :wip_limit, to: :wip_limit
      emits "WipLimitSet"
    end

    lifecycle :state, default: "planned" do
      transition "Plan"           => "planned"
      transition "Activate"       => "active",           from: "planned"
      transition "RequestClosure" => "ready_for_closure", from: "active"
      transition "Approve"        => "completed",        from: "ready_for_closure"
      transition "Reopen"         => "active",           from: "completed"
      transition "Cancel"         => "cancelled",        from: "active"
      transition "Cancel"         => "cancelled",        from: "planned"
      transition "Cancel"         => "cancelled",        from: "completed"
      transition "Deactivate"     => "planned",          from: "active"
    end

    # ── Invariant: done is done (Sprint closure) ─────────────────
    #
    # A Sprint may only be in ready_for_closure or completed if ALL six
    # closure criteria flags are true. Checked on the RESULTING state
    # after EVERY command, before save — so RequestClosure
    # (active → ready_for_closure) is rejected with InvariantViolation
    # (0 events) when any flag is false. Arm each with its Mark* command.
    #
    # Predicate, equivalently:
    #   state in {ready_for_closure, completed} ⇒ all criteria true.
    invariant "closure_criteria_met" do
      holds_when { state != "ready_for_closure" && state != "completed" || all_stories_done == true && merged_to_main == true && ci_passing == true && summary_drafted == true && worktrees_pruned == true && prs_for_open_branches == true }
    end

    # ============================================================
    # QUERIES
    # ============================================================

    query "Board" do
      description "The working context — the active sprint with its committed stories. Filters to state: active so 'the board' means what is being worked on right now, not the whole rail (ListAll is the rail)."
      where state: "active"
    end

    query "ListAll" do
      description "Every sprint and its lifecycle state — the sprint rail. Returns all sprints regardless of state."
    end

    query "ForProject" do
      description "Sprints belonging to a given project. Pass project: <slug> to filter."
      where project: :project
    end
  end
end
