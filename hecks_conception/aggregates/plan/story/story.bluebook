Hecks.bluebook "Story", version: "2026.05.25.3" do
  vision "A Story is the work unit of the Planning domain — a user story whose ordered steps are forwarded commands dispatched through the storehouse. Each Story references an inbox card (via target) and carries a sequence of Steps (entity: order + command phrase + args). Dispatching the Story Forward command is the act of running its mapped steps through the bus in order. The lifecycle walks backlog → in_sprint → started → ready_for_review → done, with deferred as a side exit from backlog. Done is only reachable through Approve (Operator role) from ready_for_review. MarkReady is the author signal that the done_criterion is satisfied and all use cases ran; Approve is the gated human confirmation. Stories are first-class — captured, composed, forwarded, marked ready, approved, and done as domain records, not hand-written briefs."
  category "plan"

  aggregate "Story", "A user story with an ordered list of forwarded commands — the work unit of the Planning domain" do
    identified_by :ref

    # ---- Identity ----
    attribute :ref,            Ref

    # ---- Content ----
    attribute :title,          Title
    attribute :tier,           Tier
    attribute :summary,        Summary
    attribute :target,         Target

    # ---- Project assignment ----
    attribute :project,        Project

    # ---- Sprint assignment ----
    attribute :sprint,         SprintRef

    # ---- Lifecycle ----
    attribute :state,          State, default: "backlog"

    # ---- Verification (f4 done-is-done) ----
    # True once Verify has confirmed the done_criterion actually holds (for
    # "callable", that the target resolves as a dispatchable verb). The
    # `ready_means_verified` invariant gives this teeth: a Story may not
    # enter ready_for_review or done unless verified is true.
    attribute :verified,       Verified, default: false

    # ---- Definition of done ----
    # The done_criterion declares WHAT must be true before MarkReady is valid:
    #   "callable"  — the story target verb resolves + dispatches through storehouse
    #   "deployed"  — the target app/service is deployed and reachable
    # Enforcement (storehouse-resolution check + UseCase.ForStory completeness)
    # lands with the f4 rule construct. Until then this is the documented UL
    # contract: MarkReady MUST NOT be called unless the criterion is satisfied
    # and all story use cases have been generated and run.
    attribute :done_criterion, DoneCriterion, default: "callable"

    # ---- Composition ----
    attribute :subsumes,       list_of(CardRef)
    attribute :steps,          list_of(Step)

    # ---- Artifacts ----
    # Files the story produced or consumed: a downloaded graphic, a
    # generated bluebook, a screenshot. The Story records the reference
    # (path + filename + kind + note); the bytes live on disk or in a store.
    attribute :attachments,    list_of(Attachment)

    # ── Value objects ──────────────────────────────────────────────

    value_object "Ref" do
      # Short story identifier — "f1", "f15". Stable for the lifetime
      # of the record.
      attribute :value, String
    end

    value_object "Title" do
      # One-line human-readable name for the story.
      attribute :value, String
    end

    value_object "Tier" do
      # Priority tier (Integer). Lower number = higher priority.
      attribute :value, Integer
    end

    value_object "Summary" do
      # Short prose description of what the story accomplishes.
      attribute :value, String
    end

    value_object "Target" do
      # The aggregate or bluebook this story builds — bluebook-awareness
      # field. E.g. "storehouse/deploy" or "planning/story".
      attribute :value, String
    end

    value_object "Project" do
      # The project this story belongs to. E.g. "framework", "mel", "opt",
      # "pigeoncoop", "bin-buddy", "embryonaut".
      # Optional — stories with no project set default to the framework project.
      attribute :value, String
    end

    value_object "SprintRef" do
      # The sprint this story is assigned to. E.g. "s1", "s2".
      attribute :value, String
    end

    value_object "State" do
      # Lifecycle token: backlog / in_sprint / started / ready_for_review / done / deferred.
      attribute :value, String
    end

    value_object "Verified" do
      # Done-is-done flag (f4). False until Verify confirms the
      # done_criterion holds ; the ready_means_verified invariant requires
      # it true before the Story may enter ready_for_review or done.
      attribute :value, Boolean
    end

    value_object "DoneCriterion" do
      # The definition-of-done primitive. Allowed values:
      #   "callable" — the story target verb resolves through storehouse
      #   "deployed" — the app/service is deployed and reachable
      # MarkReady REQUIRES this criterion to be satisfied before the call.
      # Cross-aggregate enforcement via f4 rule construct — declared intent.
      attribute :value, String
    end

    value_object "CardRef" do
      # Reference to an inbox card this story subsumes. E.g. "i42".
      attribute :value, String
    end

    value_object "StepOrder" do
      # 0-based position of a Step in the sequence. Identity by position —
      # the runner sorts by this before dispatching.
      attribute :value, Integer
    end

    value_object "CommandPhrase" do
      # A fully-qualified bluebook command phrase this Step dispatches —
      # e.g. "Plan::Story.Forward". Fed into storehouse_resolve at
      # execution time.
      attribute :value, String
    end

    value_object "Args" do
      # The Step k=v argument bag as a JSON-object string ("{}") for no
      # args). Unpacked into route argv tokens at execution time.
      attribute :value, String
    end

    value_object "StepCount" do
      # How many steps this Story forwarded. Carried on StoryForwarded so
      # downstream reactors know the sequence length without re-reading steps.
      attribute :value, Integer
    end

    value_object "UseCaseCount" do
      # How many use cases were executed. Carried on StoryExecuted so
      # downstream reactors know the acceptance scenario count without
      # re-reading the UseCase store.
      attribute :value, Integer
    end

    value_object "AttachmentPath" do
      # Filesystem path (or store URI) where the attached file lives.
      # E.g. "/Users/.../emaho/public/uploads/about-volunteer/image0.jpeg".
      attribute :value, String
    end

    value_object "AttachmentName" do
      # Human-facing filename. E.g. "image0.jpeg".
      attribute :value, String
    end

    value_object "AttachmentKind" do
      # MIME type or kind token. E.g. "image/jpeg", "text/markdown", "bluebook".
      attribute :value, String
    end

    value_object "AttachmentNote" do
      # Short prose: what this file is and where it came from.
      attribute :value, String
    end

    # ── Step entity ────────────────────────────────────────────────
    # Identity + order + a command phrase + args => entity.
    # The list is ordered; order is identity within the Story boundary.
    entity "Step" do
      attribute :order,   StepOrder
      attribute :command, CommandPhrase
      attribute :args,    Args
    end

    # ── Attachment entity ──────────────────────────────────────────
    # A file the story carries: path + filename + kind + note. Listed;
    # appended by AttachFile. The bytes live on disk; the Story holds
    # the reference so the work unit owns the artifacts it touched.
    entity "Attachment" do
      attribute :path,     AttachmentPath
      attribute :filename, AttachmentName
      attribute :kind,     AttachmentKind
      attribute :note,     AttachmentNote
    end

    # ── Commands ──────────────────────────────────────────────────

    command "Capture" do
      role "Miette"
      description "Mint a new Story from a ref + title + tier + summary + target. Starts in backlog status with an empty steps list. The ref IS the story identity — one Story per ref."
      attribute :ref,     Ref
      attribute :title,   Title
      attribute :tier,    Tier
      attribute :summary, Summary
      attribute :target,  Target
      attribute :project, Project
      then_set :ref,      to: :ref
      then_set :title,    to: :title
      then_set :tier,     to: :tier
      then_set :summary,  to: :summary
      then_set :target,   to: :target
      then_set :project,  to: :project
      then_set :state,    to: "backlog"
      emits "StoryCaptured"
    end

    command "Reword" do
      role "Miette"
      description "Amend a story's content — re-describe its title and summary — without touching its lifecycle. Capture is gated to backlog (it mints + resets state), so once a story is in_sprint/started its description was un-editable ; Reword closes that gap. Pure content mutation : no state transition, valid from any state. Used to update a card's title/summary as the design firms up."
      reference_to(Story)
      attribute :title,   Title
      attribute :summary, Summary
      then_set :title,   to: :title
      then_set :summary, to: :summary
      emits "StoryReworded"
    end

    command "AssignToSprint" do
      role "Miette"
      description "Move a backlog story into a sprint. Records the sprint_ref so the story is owned by a sprint slot."
      reference_to(Story)
      attribute :sprint_ref, SprintRef
      then_set :sprint,      to: :sprint_ref
      then_set :state,       to: "in_sprint"
      given("sprint_ref must be named") { sprint_ref != "" }
      emits "StoryAssignedToSprint"
    end

    command "MoveToSprint" do
      role "Miette"
      description "Re-assign a story to a different sprint without changing lifecycle state — a story can move sprints whether it is in_sprint or started. Closes the re-sprinting gap: AssignToSprint is allowed only from backlog, so a committed story could not otherwise change sprints."
      reference_to(Story)
      attribute :sprint_ref, SprintRef
      then_set :sprint, to: :sprint_ref
      emits "StoryMovedToSprint"
    end

    command "RemoveFromSprint" do
      role "Miette"
      description "Pull a story back out of its sprint — clears the sprint ref and returns lifecycle state to backlog. Valid from in_sprint or started. Closes the gap where a committed story could be assigned but never un-assigned."
      reference_to(Story)
      then_set :sprint, to: ""
      then_set :state,  to: "backlog"
      emits "StoryRemovedFromSprint"
    end

    command "ComposeStep" do
      role "Miette"
      description "Append one ordered Step to the Story — a (order, command, args) triple. Called once per command in the sequence. The runner sorts by order before dispatching, so out-of-call-order ComposeStep still executes in order sequence."
      reference_to(Story)
      attribute :order,   StepOrder
      attribute :command, CommandPhrase
      attribute :args,    Args
      then_set :steps, append: { order: :order, command: :command, args: :args }
      emits "StepComposed"
    end

    command "AttachFile" do
      role "Miette"
      description "Attach a file to the story — append an Attachment (path, filename, kind, note) to the attachments list. The file lives on disk or in a store; the Story records the reference so the work unit carries the artifacts it produced or consumed (a downloaded graphic, a generated bluebook, a screenshot). No lifecycle change — a story can gain attachments in any state."
      reference_to(Story)
      attribute :path,     AttachmentPath
      attribute :filename, AttachmentName
      attribute :kind,     AttachmentKind
      attribute :note,     AttachmentNote
      then_set :attachments, append: { path: :path, filename: :filename, kind: :kind, note: :note }
      emits "FileAttached"
    end

    command "Start" do
      role "Miette"
      description "Begin work on a story that has been assigned to a sprint AND whose sprint is the board's active sprint. The active-sprint guard would live in `given` if the runtime evaluated cross-aggregate predicates ; it does not today (same family as board.bluebook rule #4 fail-open) — the rule is enforced reactively by Plan::Story.Unstart until cross-aggregate guards land. Moves from in_sprint to started."
      reference_to(Story)
      given("story must be on a sprint board") { sprint != "" }
      emits "StoryStarted"
    end

    command "Forward" do
      role "Miette"
      description "Execute the Story — dispatch every mapped Step in order sequence through the bus. This command is pure: it records the act of forwarding and emits StoryForwarded with the step count. The actual per-step dispatch is the runtime projection of StoryForwarded."
      reference_to(Story)
      attribute :step_count, StepCount
      given("story must be on a sprint board") { sprint != "" }
      emits "StoryForwarded"
    end

    command "Execute" do
      role "System"
      description "The operator entry for running a story's use-case acceptance scenarios. Dispatching Plan::Story.Execute through the bus emits StoryExecuted with use_case_count; the runtime projection of StoryExecuted reads Plan::UseCase.ForStory, sorts each use case's steps, dispatches each step, and calls UseCase.Run per use case. Dispatch IS the act — no CLI side-channel. Orthogonal to Forward: Forward runs the story's own work-steps; Execute runs the use-case acceptance layer."
      reference_to(Story)
      attribute :use_case_count, UseCaseCount
      emits "StoryExecuted"
    end

    command "Verify" do
      role "Miette"
      description "Confirm the done_criterion actually holds before the story can be marked ready. For criterion=callable this asserts the story's target resolves as a dispatchable verb through the storehouse (here: the target is set and addressable); the caller proves true dispatchability by actually dispatching the target. Sets verified to true so the ready_means_verified invariant lets MarkReady through. No lifecycle change — Verify is the gate that arms MarkReady, not a transition."
      reference_to(Story)
      given("target must resolve as a dispatchable verb") { target != "" }
      then_set :verified, to: true
      emits "StoryVerified"
    end

    command "MarkReady" do
      role "Miette"
      description "Signal that a started story is ready for human review: moves started to ready_for_review and emits StoryReadyForReview. The ready_means_verified invariant (f4) now ENFORCES the done-is-done gate: MarkReady is rejected (InvariantViolation, 0 events) unless verified is true — run Verify first. done_criterion satisfied (callable = target verb resolves through storehouse; deployed = app/service reachable), all use cases ran, and all tests pass."
      reference_to(Story)
      emits "StoryReadyForReview"
    end

    command "Approve" do
      role "Operator"
      description "Human gate: move a ready_for_review story to done. Only Operator may Approve. Emits StoryApproved. Done is only reachable via this command — there is no direct path from started to done."
      reference_to(Story)
      emits "StoryApproved"
    end

    command "Reopen" do
      role "Operator"
      description "Reject a ready_for_review story back to started — the reviewer found it not actually done, work resumes. The reverse of MarkReady; valid only from ready_for_review."
      reference_to(Story)
      then_set :state, to: "started"
      emits "StoryReopened"
    end

    command "Unstart" do
      role "Miette"
      description "Reverse Start — move a started story back to in_sprint. Honors the active-sprint discipline : only stories whose sprint is the board's active sprint may stay started. The cross-aggregate guard that would forbid an off-active-sprint Start at all is not runtime-evaluable today (gap : cross-aggregate-guards) ; Unstart is the corrective verb that closes the drift. Pure state reversal : the story remains committed to its sprint ; only its lifecycle state moves back."
      reference_to(Story)
      emits "StoryUnstarted"
    end

    command "Defer" do
      role "Miette"
      description "Park a backlog story that is not yet scheduled — move it to deferred so the active backlog stays clean."
      reference_to(Story)
      emits "StoryDeferred"
    end

    command "Cancel" do
      role "Miette"
      description "Soft-delete a story: move it to the terminal `cancelled` state. For removing phantom or erroneous stories — e.g. demo stories flows leave behind when run against the live store. Mirrors Sprint.Cancel ; valid from any state. Hard record removal is a separate runtime concern (no Delete primitive yet)."
      reference_to(Story)
      then_set :state, to: "cancelled"
      emits "StoryCancelled"
    end

    # ── Lifecycle ─────────────────────────────────────────────────
    #
    # backlog → in_sprint → started → ready_for_review → done
    #                                              deferred (from backlog)
    #
    # Done is ONLY reachable via Approve (Operator) from ready_for_review.
    # MarkReady is the author signal; Approve is the human gate.

    lifecycle :state, default: "backlog" do
      transition "Capture"        => "backlog",          from: "backlog"
      transition "AssignToSprint" => "in_sprint",        from: "backlog"
      transition "Start"          => "started",          from: "in_sprint"
      transition "Unstart"        => "in_sprint",        from: "started"
      transition "MarkReady"      => "ready_for_review", from: "started"
      transition "Approve"        => "done",             from: "ready_for_review"
      transition "Reopen"         => "started",          from: "ready_for_review"
      transition "Reopen"         => "ready_for_review", from: "done"
      transition "Defer"          => "deferred",         from: "backlog"
      transition "RemoveFromSprint" => "backlog",         from: "in_sprint"
      transition "RemoveFromSprint" => "backlog",         from: "started"
    end

    # ── Invariant: done is done (f4) ────────────────────────
    #
    # A Story may only be in ready_for_review or done if it has been
    # verified. Checked on the RESULTING state after EVERY command, before
    # save — so MarkReady (started → ready_for_review) is rejected with an
    # InvariantViolation (0 events) when verified is false. Run Verify first
    # to arm it. This is the teeth behind the done_criterion contract:
    # "done is done" is now enforced by the runtime, not just documented.
    #
    # Predicate, equivalently: state in {ready_for_review, done} ⇒ verified.
    invariant "ready_means_verified" do
      holds_when { state != "ready_for_review" && state != "done" || verified == true }
    end

    # ── Queries ─────────────────────────────────────────────────

    query "Runnable" do
      description "Stories with composed steps, ready to forward through the bus."
      where state: "started"
    end

    query "ReadyForReview" do
      description "Stories awaiting Operator approval before they can be marked done."
      where state: "ready_for_review"
    end

    query "ByProject" do
      description "All stories belonging to a given project. Pass project: <slug> to filter."
      where project: :project
    end

    query "BySprint" do
      description "All stories committed to a given sprint, by the Story.sprint field — the reliable source of truth (Sprint.story_refs can drift). The Plan::Sprint.Execute projection reads this to fan out over a sprint's stories. Pass sprint: <ref> to filter."
      where sprint: :sprint
    end

    query "Board" do
      description "Every story with its lifecycle state — the full planning board. The turn-inject adapter reads this query and injects it after the turn ; distinct from a future Summary (whole-client-project stats)."
    end
  end

  # ── Policies ──────────────────────────────────────────────────
  # The "Start generates use cases + bluebooks" decision, wired as a
  # policy -> generator command. On StoryStarted the cascade fires
  # UseCase.Generate; the Start transition marks the story started.
  # (Second hop — Bluebook.Scaffold on UseCaseGenerated — lands once a
  # codegen adapter backs it.)
  policy "GenerateOnStart" do
    on "StoryStarted"
    trigger "Plan::UseCase.Generate"
  end
end
