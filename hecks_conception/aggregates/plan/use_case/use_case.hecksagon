# UseCase — Hecksagon
#
# Infrastructure declaration for the UseCase aggregate.
# Records generated use cases so the Story Start-policy cascade
# is real and observable from session to session.
#
# :heki persists records across sessions; the ForStory query
# then surfaces the full set a story has accumulated.
#
Hecks.hecksagon "UseCase" do
  adapter :heki
end
