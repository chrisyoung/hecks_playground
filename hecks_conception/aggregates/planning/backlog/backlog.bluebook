Hecks.bluebook "Backlog", version: "2026.05.24.2" do
  vision "The ordered intake pool. A singleton holding the priority order of un-sprinted story refs — it owns the one thing a query can't cheaply own: manual priority order."
  category "planning"

  # ── Backlog aggregate ─────────────────────────────────────────────
  #
  # Singleton-shaped (identified_by :name, name defaults to "main").
  # No lifecycle — it's a pool, not a state machine. Commands append
  # to, replace, or emit pulls from the ordered_refs list. The removal
  # projection on PullToSprint is the runtime's job ; the command is pure.

  aggregate "Backlog", "The ordered intake pool of un-sprinted story refs. Singleton — one backlog per planning context, keyed by name='main'." do
    identified_by :name

    attribute :name,         Name,            default: "main"
    attribute :project,      Project
    attribute :ordered_refs, list_of(StoryRef)

    value_object "Name" do
      # The singleton key. Always "main" in practice ; kept as a VO
      # so the identifier is typed and traceable.
      attribute :value, String
    end

    value_object "Project" do
      # The project this backlog belongs to. E.g. "framework", "mel",
      # "opt". Optional — the existing "main" backlog is the framework
      # project's backlog and does not require this field to be set.
      attribute :value, String
    end

    value_object "StoryRef" do
      # An opaque reference to a story, e.g. "i42" or a UUID string.
      # The backlog owns priority order, not story content.
      attribute :value, String
    end

    # ── Commands ──────────────────────────────────────────────────

    command "Capture" do
      role "Miette"
      description "Append a story ref to the ordered pool. Sets name to 'main' so the singleton is addressable on first creation."
      attribute :story_ref, StoryRef
      then_set :name,         to: "main"
      then_set :ordered_refs, append: :story_ref
      emits "StoryBacklogged"
    end

    command "Reorder" do
      role "Miette"
      description "Replace the entire ordered_refs list with a new priority sequence. The caller supplies the full desired order."
      reference_to(Backlog)
      attribute :ordered_refs, list_of(StoryRef)
      then_set :ordered_refs, to: :ordered_refs
      emits "BacklogReordered"
    end

    command "PullToSprint" do
      role "Miette"
      description "Signal that a story ref has been pulled into an active sprint. Removal from the pool is a runtime projection; the command is a pure domain intent signal."
      reference_to(Backlog)
      attribute :story_ref, StoryRef
      emits "StoryPulledToSprint"
    end

    # ── Queries ───────────────────────────────────────────────────

    query "ListOrdered" do
      description "The prioritized pool of un-sprinted stories, in order."
    end

    query "ForProject" do
      description "The backlogs belonging to a given project. Pass project: <slug> to filter."
      where project: :project
    end
  end
end
