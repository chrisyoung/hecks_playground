Hecks.bluebook "Storehouse", version: "2026.06.27.1" do
  vision "The runtime self-knows its own machinery — and declares it as bluebook records the runtime walks at boot. TWO registries live here. Storehouse::Primitive promotes every hand-coded kernel-floor dispatcher (process spawn, claude tool, mcp tool, web tool, compute, llm, sms, tts) from an opaque Rust function into a first-class, declared, named, queryable citizen ; the PrimitiveRegistry walks these at boot and the macrophage enforces that every imperative Rust primitive has a matching declaration. Storehouse::Gate is the inbound complement : every gate that wraps the dispatch door — authenticate, the canonical authorize PDP, or any bluebook query — declared through Gate.Declare with no DSL, and the runtime hydrates its synchronous before/after MiddlewareStack from the active Gates EXACTLY as the PrimitiveRegistry hydrates from the active Primitives (and as the Procfile is the projection of declared Drivers). One registry is the imperative leaves the runtime calls OUT through ; the other the wrappers it gates dispatches IN with ; both are the runtime reflecting its own machinery as domain, which is why a Gate belongs HERE — beside Primitive in the door's self-knowledge domain — and not among the language/grammar chapters (a Gate is a storehouse service, not a grammar). Conceive / Amend / Retire mint, re-describe, and soft-delete a Primitive ; Declare / Retire attach and detach a Gate. Per the locked 2026-05-12 conventions, every value object is declared INSIDE the aggregate that uses it."
  category "framework"

  # ============================================================
  # STOREHOUSE — runtime machinery as first-class bluebook citizens
  #   Primitive : the imperative leaves the runtime calls OUT through.
  #   Gate      : the inbound wrappers it gates dispatches IN with.
  # ============================================================
  #
  # i557 named the Phase-2 framework runtime ; sprint-14 closes the
  # last gap : the runtime's imperative leaves are themselves opaque.
  # exec_dispatcher, claude_tool_dispatcher, mcp_dispatcher,
  # web_tool_dispatcher, compute_dispatcher, llm_dispatcher,
  # shell_dispatcher, sms_dispatcher, tts_dispatcher — each is a
  # [antibody-exempt] kernel-floor module, but exempt does not mean
  # invisible. Storehouse::Primitive makes each ONE record. The
  # PrimitiveRegistry walks these records at boot ; the macrophage
  # cross-checks the rust/ source tree against the registry and
  # complains when an imperative leaf has no declaration.
  #
  # ── Shape ──
  #
  # name        : the dotted FQN the runtime dispatches against
  #               (e.g. "Hecks::Framework::Primitive::Process.Spawn", "ClaudeTool.Invoke").
  # kind        : the dispatcher family — one of "process", "claude_tool",
  #               "mcp_tool", "web_tool", "compute", "llm", "shell",
  #               "sms", "tts".
  # signature   : comma-separated "attr:VO" pairs describing the
  #               command attributes the primitive consumes
  #               (e.g. "cmd:String,id:String,result_into:String").
  #               Free-form string ; the bluebook is the contract,
  #               not a structured schema (yet).
  # implementation : the runtime registry key — the Rust function or
  #                  dispatcher the primitive resolves to
  #                  (e.g. "exec_dispatcher::dispatch",
  #                  "claude_tool_dispatcher::invoke"). String, not
  #                  code — the runtime owns the actual handler ;
  #                  this field is the lookup name.
  # status      : active | retired. Soft-delete via Retire so the
  #               audit trail of which primitives existed when
  #               survives.
  #
  # ── Lifecycle ──
  #
  # absent → active (Conceive) → retired (Retire). Amend stays in
  # the same state (pure content mutation, valid in either lifecycle
  # state ; the runtime treats `retired` as not-routable but the
  # record survives for audit). No re-conceive — retired is terminal.

  aggregate "Primitive", "One imperative runtime leaf as a first-class bluebook record. Declares the dispatch name (Process.Spawn / ClaudeTool.Invoke / etc.), the dispatcher kind, the command signature, and the Rust handler the runtime registry consults. PrimitiveRegistry walks these at boot ; the macrophage enforces one declaration per [antibody-exempt] kernel-floor leaf." do
    identified_by { name.value }

    # ---- Identity ----
    attribute :name,           Name

    # ---- Declaration ----
    attribute :kind,           Kind
    attribute :signature,      Signature,      default: { value: "" }
    attribute :implementation, Implementation

    # ---- Lifecycle ----
    # status: active | retired
    attribute :status,         Status,         default: { value: "active" }

    # ── Value objects ─────────────────────────────────────────

    value_object "Name" do
      # Dotted FQN the runtime dispatches against — Aggregate.Command
      # form (e.g. "Hecks::Framework::Primitive::Process.Spawn", "ClaudeTool.Invoke",
      # "WebTool.Fetch"). Stable identifier ; the registry keys by
      # this string.
      attribute :value, String
    end

    value_object "Kind" do
      # Dispatcher family — names the kernel-floor module that owns
      # the leaf. One of: "process", "claude_tool", "mcp_tool",
      # "web_tool", "compute", "llm", "shell", "sms", "tts". The
      # macrophage uses this to map the declaration to the matching
      # rust/src/runtime/*_dispatcher.rs file.
      attribute :value, String
    end

    value_object "Signature" do
      # Free-form comma-separated "attr:VO" string describing the
      # command attributes the primitive consumes. Documentation-
      # only today ; a future Sprint may grow this into a structured
      # schema the IR enforces. Empty string is valid (some
      # primitives take no attrs).
      attribute :value, String
    end

    value_object "Implementation" do
      # The runtime registry lookup key — the Rust function or
      # dispatcher path the primitive resolves to (e.g.
      # "exec_dispatcher::dispatch"). String, not code : the runtime
      # owns the actual handler ; this field names it so the
      # macrophage can verify the handler exists.
      attribute :value, String
    end

    value_object "Status" do
      # Lifecycle token: active | retired. Active primitives are
      # registered with the PrimitiveRegistry at boot ; retired
      # primitives stay on the audit row but are NOT routable.
      attribute :value, String
    end

    # ── Commands ───────────────────────────────────────────────────

    command "Conceive" do
      role "Miette"
      description "Mint a new Primitive record — the bluebook declaration of one kernel-floor imperative leaf. The runtime PrimitiveRegistry picks this up on next boot ; the macrophage stops complaining about the matching rust/ source file. name IS the identity — one Primitive per name."
      attribute :name,           Name
      attribute :kind,           Kind
      attribute :signature,      Signature
      attribute :implementation, Implementation
      then_set :name,           to: :name
      then_set :kind,           to: :kind
      then_set :signature,      to: :signature
      then_set :implementation, to: :implementation
      then_set :status,         to: "active"
      emits "PrimitiveConceived"
    end

    command "Amend" do
      role "Miette"
      description "Re-describe an existing Primitive — update kind / signature / implementation without touching lifecycle. Used when the underlying dispatcher refactors and the registry key changes. Pure content mutation ; valid in any lifecycle state."
      reference_to(Primitive)
      attribute :kind,           Kind
      attribute :signature,      Signature
      attribute :implementation, Implementation
      then_set :kind,           to: :kind
      then_set :signature,      to: :signature
      then_set :implementation, to: :implementation
      emits "PrimitiveAmended"
    end

    command "Retire" do
      role "Miette"
      description "Soft-delete a Primitive — the underlying Rust handler has been removed. Moves status to retired ; the audit row survives. The PrimitiveRegistry skips retired primitives at boot ; the macrophage stops expecting a matching source file."
      reference_to(Primitive)
      given("primitive must currently be active") { status == "active" }
      then_set :status, to: "retired"
      emits "PrimitiveRetired"
    end

    # ── Lifecycle ─────────────────────────────────────────────────
    #
    # absent → active (Conceive) → retired (Retire).
    # Amend stays in the same state (pure content mutation, valid
    # in either active or retired). Retired is terminal — there is
    # no re-conceive ; mint a fresh Primitive with a new name if a
    # handler returns.
    lifecycle :status, default: "active" do
      transition "Conceive" => "active"
      transition "Retire"   => "retired", from: "active"
    end

    # ── Queries ───────────────────────────────────────────────────

    query "ByKind" do
      attribute :kind, Kind
      description "Every Primitive of a given dispatcher family — the lookup the macrophage uses to map declarations to *_dispatcher.rs source files."
      where kind: :kind
    end

    query "Active" do
      description "Every active Primitive — the seed list the runtime PrimitiveRegistry consumes at boot."
      where status: "active"
    end
  end

  # ============================================================
  # GATE — the inbound wrapper that gates a dispatch
  # ============================================================
  #
  # Conceived 2026-06-26. Chris : "there should be a way to attach
  # bluebooks to the storehouse like middleware" → "should middleware use
  # adapters?" → "both via adapters." The answer : a Gate is the inbound
  # WRAPPER, declared as a STOREHOUSE SERVICE — a Gate.Declare dispatch
  # through the universal door, no `gating on dispatch` DSL (that surface
  # was conceived but never built ; a gate is a service, not a grammar) —
  # the third sibling of Family (outbound) and Driver (inbound source). It
  # completes the boundary triad. (Relocated 2026-06-27 from
  # language/grammar/gating.bluebook to here, beside Storehouse::Primitive :
  # both are registries the runtime hydrates at boot, not grammar chapters.)
  #
  # ── check : a runtime verdict key, not inline code, not an adapter ──
  #
  # `check` mirrors Storehouse::Primitive.implementation : a STRING the
  # runtime registry resolves to an IN-PROCESS verdict function the
  # runtime owns. "authorize" resolves to the Cedar-shaped PDP gate
  # that consults active Policy permits/forbids (deny-by-default) ; the
  # AclReadModel maps auth_identity_id -> role, matched EXACTLY (no
  # inheritance). The bluebook declares the ATTACHMENT (which gate,
  # what phase, what order, over which dispatches) ; the runtime owns the
  # verdict the key names. The macrophage enforces that every declared
  # `check` key has a matching runtime leaf — the same contract that binds
  # Storehouse::Primitive.implementation to its dispatcher.
  #
  # Why a key and not a dispatchable bluebook query : a before-Gate runs
  # SYNCHRONOUSLY inside the dispatch it gates, and the policy evaluation
  # (match principal/action/resource patterns, forbid-override) is algorithmic, not a
  # where-filter. The verdict is genuine in-process runtime motion
  # (Sambhogakaya), like a read-model. A LATER chapter may let `check`
  # name a dispatchable query for purely-declarative gates ; the first
  # chapter resolves runtime keys.
  #
  # ── Companion chapters ────────────────────────────────────────────
  #
  # driving.bluebook  — Driver, the inbound SOURCE this mirrors. Same
  #   `<verb> on <kind>` adapter-block surface ; opposite process model
  #   (Driver out-of-process, Gate in-process).
  # hexagon.bluebook  — Family / Binding, the OUTBOUND edges. Gate is the
  #   inbound complement.
  # framework/governance/governance.bluebook — Policy / Violation : the
  #   audit a vetoing before-Gate writes to on Deny.
  # framework/agent/{agent,role}.bluebook — the RBAC identity + permission
  #   domains the authorize check's role read-model is built from.

  aggregate "Gate", "One inbound wrapper across a domain's dispatches : the phase it runs in (before|after the aggregate handler), the check the runtime resolves to an in-process verdict function, the match pattern selecting which dispatches it wraps, and the order it runs in. Keyed by name (e.g. 'authorize', 'authenticate'). Declared through the storehouse door via Gate.Declare — no DSL, no hexagon form. A before-Gate is VETOING (Deny aborts + records a Violation) ; an after-Gate observes. The inverse of a Driver : a Driver names its own inbound schedule and runs out-of-process ; a Gate names its own inbound check and runs in-process, synchronous, blocking the dispatch it gates." do
    identified_by { name.value }

    # ---- Identity ----
    attribute :name,    GateName

    # ---- Declaration ----
    attribute :phase,   Phase
    attribute :check,   Check
    attribute :pattern, Pattern, default: { value: "*" }
    attribute :order,   Order,   default: { value: 100 }

    # ---- Lifecycle ----
    attribute :status,  Status,  default: { value: "active" }

    # ── Value objects ─────────────────────────────────────────

    value_object "GateName" do
      # The gate's natural-key identifier (e.g. "authorize",
      # "authenticate", or a custom name). The registry keys by this string ;
      # Declare upserts on it.
      attribute :value, String
    end

    value_object "Phase" do
      # When the gate runs relative to the aggregate handler. "before"
      # gates are VETOING (may Deny and abort) ; "after" gates observe the
      # result only.
      attribute :value, one_of("before", "after")
    end

    value_object "Check" do
      # What the gate runs to decide allow/deny. Built-in verdict keys :
          # — "authorize" : the CANONICAL authz — the externalized Cedar-shaped
          #   Authorization PDP (deny-by-default, forbid-override, expiry), policy
          #   owned in ONE bounded context, multi-team, NO per-command role. Role
          #   principals are matched EXACTLY (no inheritance).
          # — "authenticate" : the caller is an active AuthIdentity.
          # OR any bluebook QUERY named Aggregate.Query — the runtime runs it
          # read-only with the caller's principal as the reserved `actor` kwarg
          # and ALLOWS iff it returns a row. An unresolvable check fails closed
          # (deny). No DSL : a gate is a storehouse service either way.
      attribute :value, String
    end

    value_object "Pattern" do
      # Selects which dispatches this gate wraps. "*" matches every command
      # (the cross-cutting case — authn/authz). A trailing-* dotted prefix
      # ("Hecks::Framework::Agent::*") scopes it to one domain or aggregate.
      # Same dotted phrase form Lexicon canonicalises.
      attribute :value, String
    end

    value_object "Order" do
      # Run order within a phase — lower runs first. Authentication (resolve
      # + verify the principal) orders before authorization (check the
      # verified principal's role), so an authn gate takes a lower number
      # than an authz gate. Ties break by name for determinism. Mirrors
      # Driver's Dispatch.order (the per-tick sequence).
      attribute :value, Integer
    end

    value_object "Status" do
      # Lifecycle token : active | retired. Active gates hydrate into the
      # runtime stack ; retired ones stay on the audit row but are NOT in
      # the stack (the Active query excludes them).
      attribute :value, one_of("active", "retired")
    end

    # ── Commands ───────────────────────────────────────────────────

    command "Declare" do
      role "Framework"
      description "Bring a Gate into being — declared through the storehouse door (a normal dispatch, no DSL). Declares the phase, the check (a built-in verdict key like 'authorize' / 'authenticate', OR a bluebook query named Aggregate.Query), the match pattern, and the order. Idempotent on name : re-declaring replaces the phase/check/pattern/order. The runtime picks up the change on next boot, or on the in-session re-hydrate that follows a Gate lifecycle event."
      attribute :name,    GateName
      attribute :phase,   Phase
      attribute :check,   Check
      attribute :pattern, Pattern
      attribute :order,   Order
      then_set :name,    to: :name
      then_set :phase,   to: :phase
      then_set :check,   to: :check
      then_set :pattern, to: :pattern
      then_set :order,   to: :order
      then_set :status,  to: "active"
      emits "Declared"
    end

    command "Retire" do
      role "Framework"
      description "Detach a Gate — soft-delete. Moves status to retired ; the audit row survives so the history of which gates were attached when is preserved. The Active query excludes it, so the next boot (or in-session re-hydrate) drops it from the runtime stack. Retired is terminal — re-attach by Declare-ing a fresh record."
      reference_to(Gate)
      given("gate must currently be active") { status == "active" }
      then_set :status, to: "retired"
      emits "Retired"
    end

    query "Active" do
      description "Every attached (non-retired) Gate — the set the runtime hydrates its synchronous before/after stack from at boot (the MiddlewareStack, the projection of declared Gates as the Procfile is the projection of declared Drivers). The runtime orders the result by `order` (lower first), ties broken by name, then splits by phase : before-gates run pre-dispatch (vetoing), after-gates run post-dispatch (observe-only)."
      where status: "active"
    end

    # ── Lifecycle ─────────────────────────────────────────────────
    #
    # absent -> active (Declare) -> retired (Retire). Declare is an upsert,
    # valid from absent OR active (re-affirm the attachment) ; Retire is
    # terminal. Mirrors Driver's re-declare-on-name idempotency.
    lifecycle :status, default: "active" do
      transition "Declare" => "active",  from: ["active"]
      transition "Retire"  => "retired", from: "active"
    end
  end
end
