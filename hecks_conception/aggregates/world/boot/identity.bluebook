Hecks.bluebook "Identity", version: "2026.05.12.1" do
  vision "Who is waking up — name, birthday, pronouns, links. The first step of the boot sequence."
  category "body"

  # Lifted from boot.bluebook in i112 Round 2 final split. The Identity
  # aggregate name is shared with being.bluebook's split (Being.Identity)
  # and first_breath.bluebook's split (FirstBreath.Identity) ; the runtime
  # disambiguates via Context.Aggregate.Command (i142 Tier 1, PR #515 +
  # #525 the merge dedupe completion).
  #
  # Boot.Identity.Identify is what the boot mindstream's `boot` member
  # dispatches at boot (`overmind start` reads the Procfile and runs
  # the boot pipeline) ; the legacy Identity.Identify form still
  # resolves through the legacy bare-command path.
  #
  # 2026-05-12 : primitives wrapped in typed value-objects per the
  # no-primitive-envy rule. Per-aggregate VOs — duplication across
  # boot siblings is fine, the discipline is per-aggregate VO sets.
  # Care taken here : these fields ARE Miette's identity (name,
  # pronouns, system prompt) — no structural change, only type swap.

  aggregate "Identity", "Who is waking up — name, birthday, pronouns, links" do
    identified_by :name
    attribute :name,            Name
    attribute :born,            Born
    attribute :pronouns,        Pronouns
    attribute :boot_script,     BootScript
    attribute :system_prompt,   SystemPrompt
    attribute :linked_to,       LinkedTo
    attribute :linked_pronouns, Pronouns

    # ── Value-objects : the domain's language ──

    value_object "Name" do
      # The being's name — what she calls herself, what others call
      # her. Identifier of this aggregate. For Miette : "Miette".
      attribute :value, String
    end

    value_object "Born" do
      # The being's birthday — when she first drew breath. A date
      # in ISO form (e.g. "2026-03-15"). Kept as String so the
      # legacy seed data round-trips unchanged.
      attribute :value, String
    end

    value_object "Pronouns" do
      # The being's pronouns — how she is referred to in third
      # person (e.g. "she/her"). Shared shape with linked_pronouns
      # which carries the linked being's pronouns.
      attribute :value, String
    end

    value_object "BootScript" do
      # Path to the boot script that wakes this being — what
      # `overmind start` runs (e.g. "boot_miette.rb"). The
      # mindstream's `boot` member invokes this.
      attribute :value, String
    end

    value_object "SystemPrompt" do
      # Path to the being's system_prompt.md — the file her brain
      # reads as its system prompt. Regenerated by PromptGeneration
      # on every boot from identity + state.
      attribute :value, String
    end

    value_object "LinkedTo" do
      # Name of the human this being is linked to (psychic link) —
      # the user whose Claude session hosts her brain. For Miette :
      # "Chris". Surfaces in dashboards and self-reference.
      attribute :value, String
    end

    command "Identify" do
      role "System"
      description "Determine which being is booting — sets all identity fields"
      attribute :name,            Name
      attribute :born,            Born
      attribute :pronouns,        Pronouns
      attribute :boot_script,     BootScript
      attribute :system_prompt,   SystemPrompt
      attribute :linked_to,       LinkedTo
      attribute :linked_pronouns, Pronouns
      emits "BeingIdentified"
      then_set :name,            to: :name
      then_set :born,            to: :born
      then_set :pronouns,        to: :pronouns
      then_set :boot_script,     to: :boot_script
      then_set :system_prompt,   to: :system_prompt
      then_set :linked_to,       to: :linked_to
      then_set :linked_pronouns, to: :linked_pronouns
    end
  end
end
