Hecks.bluebook "Delivery", version: "2026.04.16.1" do
  vision "The domain leaves the womb and enters the nursery — born, valid, healthy"
  category "world"

  # Lifted out of conception.bluebook in i112 split. Carries two
  # policies : DeliverOnPass (Labor.PassLabor → Delivery.DeliverDomain)
  # and RegisterOnDelivery (Delivery.DeliverDomain →
  # Delivery.RegisterBirth).

  aggregate "Delivery" do
    description "The domain leaves the womb and enters the nursery — born, valid, healthy"
    identified_by :domain_name
    attribute :domain_name,     DomainName
    attribute :path,            Path
    attribute :aggregate_count, ElementCount
    attribute :command_count,   ElementCount
    attribute :fixture_count,   ElementCount
    attribute :indexed,         IndexedFlag

    value_object "DomainName" do
      # Hecks.bluebook "<Name>" — the delivered domain's identifier.
      attribute :value, String
    end

    value_object "Path" do
      # Filesystem path where the bluebook landed in the nursery.
      attribute :value, String
    end

    value_object "ElementCount" do
      # Count of an IR element category (aggregates / commands / fixtures).
      attribute :value, Integer
    end

    value_object "IndexedFlag" do
      # Whether the delivered domain is registered in the nursery index ('yes' / 'no').
      attribute :value, String
    end

    command "DeliverDomain" do
      role "Midwife"
      goal "Write the bluebook to the nursery — the domain is born"
      attribute :domain_name,     DomainName
      attribute :path,            Path
      attribute :aggregate_count, ElementCount
      attribute :command_count,   ElementCount
      attribute :fixture_count,   ElementCount
      emits "DomainDelivered"
      sets :domain_name
      sets :path
      sets :aggregate_count
      sets :command_count
      sets :fixture_count
    end

    command "RegisterBirth" do
      role "Midwife"
      goal "Update the census, validate with Rust, announce to the nursery"
      reference_to(Delivery)
      emits "BirthRegistered"
    end

    command "IndexInNursery" do
      role "Midwife"
      goal "Add to the census, domain_entry records, and nursery_awareness — the corpus grows"
      reference_to(Delivery)
      emits "IndexedInNursery"
      sets :indexed, to: "yes"
    end
  end

  policy "DeliverOnPass" do
    on "LaborPassed"
    trigger DeliverDomain
  end

  policy "RegisterOnDelivery" do
    on "DomainDelivered"
    trigger RegisterBirth
  end
end
