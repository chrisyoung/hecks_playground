Hecks.behaviors "DomainCell" do
  vision "Behavioral tests for the DomainCell aggregate — conceive, mature, checkpoint, apoptosis."

  # ── DomainCell aggregate ──────────────────────────────────────────
  # (merged from body.behaviors during i112 cleanup)

  test "Conceive sets domain_name" do
    tests "Conceive", on: "DomainCell"
    input  domain_name: "sample"
    expect domain_name: "sample", maturity: 0, phase: "conceived"
  end

  # NOTE : the "Conceive cascades through policy chain" :cross_cascade
  # test was removed 2026-05-17. It primed + expected events from
  # Mood / Heartbeat / Capabilities / Organs — Miette's body, moved to
  # the chrisyoung/miette repo by i117 Round 4 (6b081837). The cascade
  # web no longer exists in this repo ; DomainCell.Conceive now emits
  # only "DomainConceived", already covered by "Conceive sets
  # domain_name" above. i117 Round 4 residue (cf i158/i159). i642.

  test "Mature runs" do
    tests "Mature", on: "DomainCell"
    setup  "DomainCell.Conceive", domain_name: "sample"
    expect phase: "growing"
  end

  test "Mature cascades through policy chain" do
    tests "Mature", on: "DomainCell", kind: :cascade
    setup  "DomainCell.Conceive", domain_name: "sample"
    expect emits: ["DomainMatured", "CheckpointPassed"]
  end

  test "PassCheckpoint sets checkpoint_name" do
    tests "PassCheckpoint", on: "DomainCell"
    setup  "DomainCell.Conceive", domain_name: "sample"
    setup  "Mature"
    input  checkpoint_name: "sample"
    expect checkpoints_passed_size: 1, phase: "validated"
  end

  test "TriggerApoptosis runs" do
    tests "TriggerApoptosis", on: "DomainCell"
    setup  "DomainCell.Conceive", domain_name: "sample"
    expect alive: false, phase: "dead"
  end
end
