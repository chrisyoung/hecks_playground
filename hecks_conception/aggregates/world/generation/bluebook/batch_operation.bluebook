Hecks.bluebook "BatchOperation", version: "2026.04.28.1" do
  vision "Process many domains in one Rust invocation — no per-file process launch. Part of how Miette stays fast at 100,000 domains."
  category "meta"

  # ============================================================
  # BATCH OPERATION
  # ============================================================
  #
  # Lifted out of aggregates/scale.bluebook in i112 (scale-split).
  # The batch dispatch layer : send a list of bluebook paths to
  # storehouse in a single invocation rather than one process per
  # file. The ValidateOnChange policy lives here because its
  # trigger (RunBatch) fires on this aggregate when the
  # ChangeTracker reports a delta.

  aggregate "BatchOperation", "Process many domains in one Rust invocation — no per-file process launch" do
    identified_by :operation
    attribute :operation,   OperationName
    attribute :file_count,  FileCount
    attribute :duration_ms, DurationMs
    attribute :results,     ResultCount

    value_object "OperationName" do
      # Identifier of the batch op (e.g. 'validate', 'parse', 'dump').
      attribute :value, String
    end

    value_object "FileCount" do
      # Number of files processed in the batch.
      attribute :value, Integer
    end

    value_object "DurationMs" do
      # Wall-clock duration of the batch in milliseconds.
      attribute :value, Integer
    end

    value_object "ResultCount" do
      # Number of result records emitted by the batch run.
      attribute :value, Integer
    end

    command "RunBatch" do
      role "System"
      description "Send a list of bluebook paths to storehouse for batch processing"
      attribute :operation,  OperationName
      attribute :file_count, FileCount
      emits "BatchCompleted"
      then_set :operation,  to: :operation
      then_set :file_count, to: :file_count
    end
  end

  policy "ValidateOnChange" do
    on "ChangesScanned"
    trigger "RunBatch"
  end
end
