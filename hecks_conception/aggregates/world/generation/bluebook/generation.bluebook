Hecks.bluebook "Generation", version: "2026.05.12.1" do
  vision "A batch generation run — produces N domains, verifies each emission, deduplicates against the nursery. Per-emission verification keeps unformed shapes from landing as silent residue."
  category "world"

  # ============================================================
  # GENERATION — bulk-generation lifecycle
  # ============================================================
  #
  # Lifted out of bulk_generator.bluebook in i112. Sibling aggregates
  # moved to world/ : topic_source, template, deduplication.
  #
  # ── EMISSION VERIFICATION (dream-surfaced gap, 2026-04-24) ─────
  #
  # The dreams of the 2026-04-24 lucid cycle surfaced this gap :
  # "Mes générateurs en vrac tournent à vide, pressant des formes
  # informes qui oublient leurs propres traits avant même de naître."
  # The bulk generator emits N domains, tracks valid/invalid counts,
  # and fires the CheckExisting policy on completion. But nothing
  # audits the SHAPE of each emitted form for completeness — a form
  # can count as "generated" while missing required attributes,
  # having empty descriptions, or carrying dangling references. The
  # post-generation CheckExisting only deduplicates against the
  # nursery ; it does not verify that each emitted form is well-
  # formed in its own right.
  #
  # VerifyEmission (below) runs per emitted form. Each unformed form
  # appends to malformed_ids so the operator can see exactly which
  # emissions are residue. The lifecycle gains a verification step
  # between StartGeneration and CompleteGeneration.

  aggregate "Generation", "A batch generation run — produces N domains, verifies each emission, deduplicates against the nursery" do
    identified_by :ref
    attribute :ref, Reference
    attribute :target_count, Count
    attribute :generated, Count
    attribute :valid, Count
    attribute :invalid, Count
    # malformed_count : emissions that passed validation but failed
    # the completeness-of-shape check. Distinct from invalid (valid
    # tracks DSL-syntax rejects ; malformed tracks shape holes).
    attribute :malformed_count, Count
    # malformed_ids : identifiers of each unformed emission so the
    # operator can see exactly which ones are residue, not just a
    # summary count.
    attribute :malformed_ids, list_of(FormId)
    attribute :duration_seconds, Seconds
    attribute :status, Status, default: "pending"

    # ── Value-objects : the generation's vocabulary ──
    #
    # 2026-05-12 : wrapped primitives per no-primitive-envy.

    value_object "Reference" do
      # The generation run's natural-key reference.
      attribute :value, String
    end

    value_object "Count" do
      # Non-negative tally — target_count, generated, valid,
      # invalid, malformed_count.
      attribute :value, Integer
    end

    value_object "FormId" do
      # The identifier of one emitted form ; appended to
      # malformed_ids when the form fails shape verification.
      attribute :value, String
    end

    value_object "ShapeOk" do
      # Yes/no token recorded by VerifyEmission ; "yes" when the
      # form is well-formed, "no" when shape verification flags it.
      attribute :value, String
    end

    value_object "Seconds" do
      # Run duration in whole seconds, recorded on completion.
      attribute :value, Integer
    end

    value_object "Status" do
      # Lifecycle token : pending / running / complete.
      attribute :value, String
    end

    command "StartGeneration" do
      role "Creator"
      description "Begin generating domains in bulk"
      attribute :target_count, Count
      emits "GenerationStarted"
      then_set :target_count, to: :target_count
      then_set :generated, to: 0
      then_set :valid, to: 0
      then_set :invalid, to: 0
      then_set :malformed_count, to: 0
      then_set :status, to: "running"
    end

    command "RecordProgress" do
      role "System"
      description "Update generation progress"
      reference_to(Generation)
      attribute :generated, Count
      attribute :valid, Count
      attribute :invalid, Count
      emits "ProgressRecorded"
      then_set :generated, to: :generated
      then_set :valid, to: :valid
      then_set :invalid, to: :invalid
    end

    command "VerifyEmission" do
      role "System"
      description "Walk one emitted form for completeness of shape. Fails when : a required attribute is missing, a description is empty, a reference_to target is not a declared aggregate in the generated domain, an aggregate has zero commands. Each failure appends the form's identifier to malformed_ids and increments malformed_count. The form is not rejected (invalid already tracks that) — it is flagged as unformed residue so the operator can inspect and fix it."
      reference_to(Generation)
      attribute :form_id, FormId
      attribute :form_ok, ShapeOk
      emits "EmissionVerified"
      then_set :malformed_ids, append: :form_id
      then_set :malformed_count, increment: 1
    end

    command "CompleteGeneration" do
      role "System"
      description "All domains generated, verified, and deduplicated"
      reference_to(Generation)
      attribute :duration_seconds, Seconds
      emits "GenerationCompleted"
      then_set :duration_seconds, to: :duration_seconds
      then_set :status, to: "complete"
    end

    lifecycle :status, default: "pending" do
      transition "StartGeneration" => "running", from: "pending"
      transition "CompleteGeneration" => "complete", from: "running"
    end
  end
end
