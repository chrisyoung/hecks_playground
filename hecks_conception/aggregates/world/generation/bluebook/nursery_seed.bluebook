Hecks.bluebook "NurserySeed", version: "2026.04.28.1" do
  vision "Seed the nursery with domains — parallel workers conceive in bulk"
  category "world"

  # ============================================================
  # NURSERY SEED — orchestrates parallel seeding into the nursery
  # ============================================================
  #
  # Lifted out of seeding.bluebook in i112. Sibling aggregates
  # moved to world/ : worker, merge, initial_state. Each carries
  # its own bluebook ; policies follow the trigger target.

  aggregate "NurserySeed", "Seed the nursery with domains — parallel workers conceive in bulk" do
    identified_by :ref
    attribute :ref,             Ref
    attribute :worker_count,    WorkerCount
    attribute :domains_seeded,  DomainCount
    attribute :status,          Status, default: "pending"

    value_object "Ref" do
      # Stable identifier for this seeding run.
      attribute :value, String
    end

    value_object "WorkerCount" do
      # Number of parallel workers launched by the seeding orchestrator.
      attribute :value, Integer
    end

    value_object "DomainCount" do
      # Number of domains landed in the nursery during this run.
      attribute :value, Integer
    end

    value_object "Status" do
      # Lifecycle marker ('pending' / 'running' / 'complete').
      attribute :value, String
    end

    command "StartSeeding" do
      role "Creator"
      description "Launch parallel workers to conceive domains into the nursery"
      attribute :worker_count, WorkerCount
      emits "SeedingStarted"
      then_set :worker_count, to: :worker_count
      then_set :status, to: "running"
    end

    command "CompleteSeeding" do
      role "System"
      description "All workers finished — domains are in the nursery"
      reference_to(NurserySeed)
      attribute :domains_seeded, DomainCount
      emits "SeedingCompleted"
      then_set :domains_seeded, to: :domains_seeded
      then_set :status, to: "complete"
    end

    lifecycle :status, default: "pending" do
      transition "StartSeeding" => "running", from: "pending"
      transition "CompleteSeeding" => "complete", from: "running"
    end
  end
end
