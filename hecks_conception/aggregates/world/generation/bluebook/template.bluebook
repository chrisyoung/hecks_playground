Hecks.bluebook "Template", version: "2026.04.28.1" do
  vision "A bluebook template that generates valid domains from topics — pattern-driven domain conception"
  category "world"

  # ============================================================
  # TEMPLATE — pattern source for bulk domain generation
  # ============================================================
  #
  # Lifted out of bulk_generator.bluebook in i112. Sibling aggregates
  # moved to world/ : topic_source, generation, deduplication.

  aggregate "Template", "A bluebook template that generates valid domains from topics" do
    identified_by :name
    attribute :name,               Name
    attribute :aggregate_patterns, list_of(Pattern)
    attribute :command_patterns,   list_of(Pattern)
    attribute :policy_patterns,    list_of(Pattern)

    value_object "Name" do
      # Template identifier used by the bulk generator.
      attribute :value, String
    end

    value_object "Pattern" do
      # One pattern (aggregate / command / policy) included in the template.
      attribute :value, String
    end

    command "DefineTemplate" do
      role "System"
      description "Set the patterns used to generate aggregates, commands, and policies"
      attribute :aggregate_patterns, list_of(Pattern)
      attribute :command_patterns,   list_of(Pattern)
      attribute :policy_patterns,    list_of(Pattern)
      emits "TemplateDefined"
      then_set :aggregate_patterns, to: :aggregate_patterns
      then_set :command_patterns,   to: :command_patterns
      then_set :policy_patterns,    to: :policy_patterns
    end
  end
end
