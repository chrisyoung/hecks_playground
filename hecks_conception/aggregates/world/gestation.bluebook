Hecks.bluebook "Gestation", version: "2026.04.16.1" do
  vision "Multi-domain project growing — each bounded context gets its own bluebook"
  category "world"

  # Lifted out of conception.bluebook in i112 split. Carries one
  # policy : GestateOnConception (Conception.ConceiveDomain →
  # Gestation.StartGestation).

  aggregate "Gestation", "Multi-domain project growing — each bounded context gets its own bluebook" do
    identified_by :project_name
    attribute :project_name, String
    attribute :nursery_path, String
    attribute :bounded_contexts, list_of(String)
    attribute :aggregates, list_of(String)
    attribute :commands, list_of(String)
    attribute :policies, list_of(String)
    attribute :fixtures, list_of(String)
    attribute :contractions, Integer

    command "StartGestation" do
      role "Miette"
      description "Scaffold the hecks/ folder with one bluebook per bounded context"
      attribute :project_name, String
      attribute :nursery_path, String
      attribute :bounded_contexts, list_of(String)
      emits "GestationStarted"
      then_set :project_name, to: :project_name
      then_set :nursery_path, to: :nursery_path
      then_set :bounded_contexts, to: :bounded_contexts
      then_set :contractions, to: 0
    end

    command "FormAggregate" do
      role "Miette"
      description "An aggregate crystallizes within the forming domain"
      reference_to(Gestation)
      attribute :aggregate_name, String
      emits "AggregateFormed"
      then_set :aggregates, append: :aggregate_name
    end

    command "FormCommand" do
      role "Miette"
      description "A command emerges within an aggregate"
      reference_to(Gestation)
      attribute :command_name, String
      emits "CommandFormed"
      then_set :commands, append: :command_name
    end

    command "FormPolicy" do
      role "Miette"
      description "A policy wires itself between aggregates"
      reference_to(Gestation)
      attribute :policy_name, String
      emits "PolicyFormed"
      then_set :policies, append: :policy_name
    end

    command "Contract" do
      role "Miette"
      description "A contraction — the domain tightens, refines, gets closer to birth"
      reference_to(Gestation)
      emits "Contracted"
      then_set :contractions, increment: 1
    end
  end

  policy "GestateOnConception" do
    on "DomainConceived"
    trigger "StartGestation"
  end
end
