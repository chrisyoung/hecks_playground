Hecks.bluebook "LazyIndex", version: "2026.05.16.1" do
  vision "Load domain entries on demand — not all at boot. Part of how Miette stays fast at 100,000 domains."
  category "meta"

  # ============================================================
  # LAZY INDEX
  # ============================================================
  #
  # Lifted out of aggregates/scale.bluebook in i112 (scale-split).
  # The on-demand loader for the nursery : look up domains by
  # name, sector, or pattern and load from .heki only when asked.
  # Cache eviction releases unused domains. No cross-aggregate
  # policies bind to this index.

  aggregate "LazyIndex", "Load domain entries on demand — not all at boot" do
    identified_by :name
    attribute :name,             IndexName
    attribute :total_indexed,    TotalIndexed
    attribute :loaded_in_memory, LoadedInMemory
    attribute :cache_hit_rate,   CacheHitRate

    value_object "IndexName" do
      # Identifies this index instance — typically the nursery root path.
      attribute :value, String
    end

    value_object "TotalIndexed" do
      # Total number of domain entries known to the index (including unloaded).
      attribute :value, Integer
    end

    value_object "LoadedInMemory" do
      # Number of domain entries currently resident in memory.
      attribute :value, Integer
    end

    value_object "CacheHitRate" do
      # Fraction of queries served from memory without a .heki load (0.0–1.0).
      attribute :value, Float
    end

    command "QueryIndex" do
      role "System"
      description "Look up domains by name, sector, or pattern — load from .heki on demand"
      attribute :loaded_in_memory, LoadedInMemory
      emits "IndexQueried"
      then_set :loaded_in_memory, to: :loaded_in_memory
    end

    command "EvictCache" do
      role "System"
      description "Release domains from memory that haven't been accessed recently"
      reference_to(LazyIndex)
      emits "CacheEvicted"
    end
  end
end
