# Budget — Hecksagon
#
# Infrastructure declaration for the Budget aggregate (spend cap
# for a period — hour/day/month — with manual override window).
# Pairs with aggregates/world/spend/budget.bluebook.
#
# Memory-adapter backed; the .heki binary store writes happen via
# the standard Hecks persistence layer.
#
# Access control: `gate "Budget", :chris do allow ... end` was never a
# real HecksagonBuilder verb (no gate/allow method exists) -- the
# bluebook's own `role "Creator"` on SetBudget/OverrideBudget/
# ClearOverride already says the same thing, and is real access control
# now that Governance is attached below.
Hecks.hecksagon "Budget" do
  uses_framework "Governance"

  Budget::Budget.persisted_by("Memory")
end
