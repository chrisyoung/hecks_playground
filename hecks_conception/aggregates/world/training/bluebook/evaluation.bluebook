Hecks.bluebook "Evaluation", version: "2026.04.28.1" do
  vision "Test the trained model against known-good outputs"
  category "world"

  # Lifted out of training_pipeline.bluebook in i112 split. Carries
  # the EvaluateOnComplete policy — FineTune.FineTuneCompleted →
  # EvaluateModel here. Policy lives with the trigger target.

  aggregate "Evaluation" do
    description "Test the trained model against known-good outputs"
    identified_by :name
    attribute :name,                 Name
    attribute :bluebook_accuracy,    Score
    attribute :conversation_quality, Score
    attribute :behavior_adherence,   Score
    attribute :passed,               PassResult

    value_object "Name" do
      # Identifier of this evaluation run.
      attribute :value, String
    end

    value_object "Score" do
      # A scalar metric score in [0.0, 1.0].
      attribute :value, Float
    end

    value_object "PassResult" do
      # Whether the evaluation passed ('yes' / 'no').
      attribute :value, String
    end

    command "EvaluateModel" do
      role "System"
      goal "Run the trained model against test set — does it produce valid Bluebooks? Does it converse like Miette?"
      attribute :bluebook_accuracy,    Score
      attribute :conversation_quality, Score
      attribute :behavior_adherence,   Score
      emits "ModelEvaluated"
      sets :bluebook_accuracy
      sets :conversation_quality
      sets :behavior_adherence
    end
  end

  policy "EvaluateOnComplete" do
    on "FineTuneCompleted"
    trigger Hecks::World::Training::Evaluation::Evaluation::EvaluateModel
  end
end
