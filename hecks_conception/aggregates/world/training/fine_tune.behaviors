Hecks.behaviors "FineTune" do
  vision "Behavioral tests for the FineTune aggregate — start, record, complete."

  # ── FineTune aggregate ──────────────────────────────────────────
  # (merged from training_pipeline.behaviors during i112 cleanup)

  test "StartFineTune sets base_model + dataset_size + epochs + learning_rate" do
    tests "StartFineTune", on: "FineTune"
    input  base_model: "sample", dataset_size: 1, epochs: 1, learning_rate: 1.0
    expect base_model: "sample", dataset_size: 1, epochs: 1, learning_rate: 1.0, status: "training"
  end

  test "RecordEpoch sets loss" do
    tests "RecordEpoch", on: "FineTune"
    setup  "StartFineTune", base_model: "sample", dataset_size: 1, epochs: 1, learning_rate: 1.0
    input  loss: 1.0
    expect loss: 1.0
  end

  test "CompleteFineTune runs" do
    tests "CompleteFineTune", on: "FineTune"
    setup  "StartFineTune", base_model: "sample", dataset_size: 1, epochs: 1, learning_rate: 1.0
    expect status: "complete"
  end

  # i165 closed — the cascade test was pending on a misdiagnosed
  # policy-attr-mapping gap. Real cause : EvaluateOnComplete's
  # `trigger "EvaluateModel"` was a bare-name dispatch, and the
  # combined-domain bare-name resolver picks the FIRST aggregate
  # carrying that command (depth-then-path-sorted). discipline/
  # domain_hygiene/summer.bluebook also declares EvaluateModel and
  # sorts ahead of hecks_conception/aggregates/world/training/, so
  # the cascade routed to Summer.Model.EvaluateModel — whose
  # reference_to(Model) self-ref is unresolved → silent dispatch
  # error → ModelEvaluated never fires. Fix : qualify the trigger
  # to "Evaluation.EvaluateModel" so the 2-part resolver in
  # command_dispatch::resolve filters by aggregate name and lands
  # on Evaluation.EvaluateModel directly. Missing-attr was a red
  # herring — Rust's apply_mutations resolves null safely and
  # storage of null-valued metrics is fine for a freshly-cascaded
  # Evaluation row (real metrics would land via a follow-on
  # EvaluateModel dispatch with payload).
  test "CompleteFineTune cascades through policy chain" do
    tests "CompleteFineTune", on: "FineTune", kind: :cross_cascade
    setup  "StartFineTune", base_model: "sample", dataset_size: 1, epochs: 1, learning_rate: 1.0
    expect emits: ["FineTuneCompleted", "ModelEvaluated"]
  end
end
