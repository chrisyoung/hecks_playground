Hecks.behaviors "RVDC" do
  vision "Behavioral tests for the RVDC domain — exercises every command and query in memory"

  # ── App aggregate ──────────────────────────────────────────

  test "Boot sets port" do
    tests "Boot", on: "App"
    input  port: 1
    expect ok: "true"
  end

  test "RegisterDomains sets domains" do
    tests "RegisterDomains", on: "App", kind: :pending
    input  domains: "sample"
    # UNCOVERED : RegisterDomains lacks `then_set :domains, to: :domains` and dispatches against the fixture-seeded App (id=1), so update path leaves the 4-element fixture domains list untouched.
    expect domains: "sample"
  end

end
