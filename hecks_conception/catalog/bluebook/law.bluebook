Hecks.bluebook "Law", version: "2026.05.12.1" do
  vision "Enforceable rules — not advice, not memory. Laws are checked by contract and violations are reported."
  category "meta"

  aggregate "Law" do
    description "A single enforceable rule — has a check, a severity, and a contract that can be run"
    identified_by :name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Name" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Description" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "DomainScope" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "CheckExpression" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Severity" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Status" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "ViolationCount" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    attribute :name, Name
    attribute :description, Description
    attribute :domain_scope, DomainScope
    attribute :check_expression, CheckExpression
    attribute :severity, Severity
    attribute :status, Status, default: { value: "draft" }

    attribute :violation_count, ViolationCount

    command "Enact" do
      role "Architect"
      goal "Create a new law — an enforceable rule with a check expression and severity"
      attribute :name, Name
      attribute :description, Description
      attribute :domain_scope, DomainScope
      attribute :check_expression, CheckExpression
      attribute :severity, Severity
      emits "LawEnacted"
      sets :name
      sets :description
      sets :domain_scope
      sets :check_expression
      sets :severity
      sets :status, to: "active"
      sets :violation_count, to: 0
    end

    command "Amend" do
      role "Architect"
      goal "Change the check or description of an existing law"
      reference_to(Law)
      attribute :description, Description
      attribute :check_expression, CheckExpression
      emits "LawAmended"
      sets :description
      sets :check_expression
    end

    command "Suspend" do
      role "Architect"
      goal "Temporarily disable a law — it still exists but is not enforced"
      reference_to(Law)
      emits "LawSuspended"
      sets :status, to: "suspended"
    end

    command "Reinstate" do
      role "Architect"
      goal "Re-enable a suspended law"
      reference_to(Law)
      emits "LawReinstated"
      sets :status, to: "active"
    end

    command "RecordViolation" do
      role "Enforcer"
      goal "A contract check found this law was violated"
      reference_to(Law)
      emits "ViolationRecorded"
      sets :violation_count, increment: 1
    end

    lifecycle :status, default: "draft" do
      transition "Enact" => "active"
      transition "Suspend" => "suspended", from: "active"
      transition "Reinstate" => "active", from: "suspended"
    end
  end

  aggregate "Violation" do
    description "A specific instance of a law being broken — who, where, when, what"
    # Composite : Report sets law_name/violator/detected_at together at
    # creation time, and the triple is unique enough — no minted field needed.
    identified_by :law_name, :violator, :detected_at

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "LawName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Violator" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Location" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Detail" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "DetectedAt" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Resolution" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :law_name, LawName
    attribute :violator, Violator
    attribute :location, Location
    attribute :detail, Detail
    attribute :detected_at, DetectedAt
    attribute :resolution, Resolution, default: { value: "open" }


    command "Report" do
      role "Enforcer"
      goal "Report a specific violation — which law, where, what happened"
      attribute :law_name, LawName
      attribute :violator, Violator
      attribute :location, Location
      attribute :detail, Detail
      attribute :detected_at, DetectedAt
      emits "ViolationReported"
      sets :law_name
      sets :violator
      sets :location
      sets :detail
      sets :detected_at
      sets :resolution, to: "open"
    end

    command "Resolve" do
      role "Architect"
      goal "Mark a violation as resolved — the offending code or domain was fixed"
      reference_to(Violation)
      emits "ViolationResolved"
    end

    lifecycle :resolution, default: "open" do
      transition "Report" => "open"
      transition "Resolve" => "resolved", from: "open"
    end
  end

  aggregate "Enforcement" do
    description "A run of all active laws against a scope — the contract check"
    # enforced_at isn't known until Conclude, well after RecordCheck
    # must already be able to find this record by reference_to — same
    # late-field trap as Session's started_at. scope alone repeats
    # across runs, so this needs a field the caller mints at Enforce
    # time.
    identified_by :enforcement_id

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "EnforcementId" do
      attribute :value, String
      invariant "must not be empty" do
        !value.empty?
      end
    end

    value_object "Scope" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "LawsChecked" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "LawsPassed" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "LawsViolated" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "EnforcedAt" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Verdict" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :enforcement_id, EnforcementId
    attribute :scope, Scope
    attribute :laws_checked, LawsChecked
    attribute :laws_passed, LawsPassed
    attribute :laws_violated, LawsViolated
    attribute :enforced_at, EnforcedAt
    attribute :verdict, Verdict, default: { value: "unchecked" }


    command "Enforce" do
      role "Enforcer"
      goal "Run all active laws against a scope — check every contract, report every violation"
      attribute :enforcement_id, EnforcementId
      attribute :scope, Scope
      emits "EnforcementStarted"
      sets :enforcement_id
      sets :scope
      sets :laws_checked, to: 0
      sets :laws_passed, to: 0
      sets :laws_violated, to: 0
      sets :verdict, to: "running"
    end

    command "RecordCheck" do
      role "Enforcer"
      goal "Record the result of checking one law"
      reference_to(Enforcement)
      attribute :passed, TrueClass
      emits "LawChecked"
    end

    command "Conclude" do
      role "Enforcer"
      goal "All laws checked — render final verdict"
      reference_to(Enforcement)
      attribute :enforced_at, EnforcedAt
      emits "EnforcementConcluded"
      sets :enforced_at
    end

    command "PassAll" do
      role "Enforcer"
      goal "Every law passed — scope is lawful"
      reference_to(Enforcement)
      emits "ScopeLawful"
      given("no violations") { laws_violated == 0 }
      sets :verdict, to: "lawful"
    end

    command "FailSome" do
      role "Enforcer"
      goal "One or more laws were violated — scope is unlawful"
      reference_to(Enforcement)
      emits "ScopeUnlawful"
      sets :verdict, to: "unlawful"
    end

    lifecycle :verdict, default: "unchecked" do
      transition "Enforce" => "running"
      transition "PassAll" => "lawful", from: "running"
      transition "FailSome" => "unlawful", from: "running"
    end
  end

  # Enforcement flow
  policy "ReportOnViolation" do
    on "ViolationRecorded"
    trigger Report
  end

  policy "ConcludeOnAllChecked" do
    on "LawChecked"
    trigger Conclude
  end

  # === The Laws ===

  # Conception laws

  # Training laws

  # Code laws

  # Architecture laws

  # Violation examples

  # Enforcement examples
end
