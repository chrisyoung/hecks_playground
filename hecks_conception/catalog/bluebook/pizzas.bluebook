Hecks.bluebook "Pizzas" do
  vision "Manage pizza creation, customization, and ordering for a pizzeria"
  core

  aggregate "Pizza" do
    identified_by :name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Name" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Description" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Amount" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    description "A pizza with toppings, pricing, and menu visibility"
    attribute :name, Name
    attribute :description, Description
    attribute :toppings, list_of(Topping)

    value_object "Topping" do
      attribute :name, String
      attribute :amount, Integer
      invariant "amount must be positive" do
        amount > 0
      end
    end

    value_object "Price" do
      attribute :cents, Integer
      attribute :currency, String, default: "USD"
      invariant "must be non-negative" do
        cents >= 0
      end
    end

    command "CreatePizza" do
      role "Chef"
      goal "Add a new pizza to the menu"
      attribute :name, Name
      attribute :description, Description
      emits "PizzaCreated"
    end

    command "AddTopping" do
      role "Chef"
      goal "Customize a pizza with ingredients"
      reference_to(Pizza)
      attribute :name, Name
      attribute :amount, Amount

      given("max 10 toppings") { toppings.size < 10 }
      sets :toppings, append: { name: :name, amount: :amount }
      emits "ToppingAdded"
    end

    query "ByDescription" do |desc|
      # `desc` names no owner attribute (the owner's own field is
      # `description`), so derive_from_owner! can't infer its type --
      # declared explicitly instead, matching Description's own type.
      attribute :desc, Description
      where(description: :desc)
    end
  end

  aggregate "Order" do
    # Many orders per customer — nothing else is unique at PlaceOrder
    # time, so the caller mints order_id.
    identified_by :order_id

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "OrderId" do
      attribute :value, String
      invariant "must not be empty" do
        !value.empty?
      end
    end

    value_object "CustomerName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Status" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Quantity" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    description "A customer order referencing a pizza with status tracking"
    attribute :order_id, OrderId
    attribute :customer_name, CustomerName
    attribute :items, list_of(OrderItem)
    reference_to(Pizza)

    value_object "OrderItem" do
      attribute :quantity, Integer
      invariant "quantity must be positive" do
        quantity > 0
      end
    end

    value_object "OrderStatus" do
      attribute :status_label, String, default: "pending"
    end

    attribute :status, Status, default: { value: "pending" }
    lifecycle :status, default: "pending" do
      transition "CancelOrder" => "cancelled"
    end

    command "PlaceOrder" do
      role "Customer"
      goal "Order a pizza for delivery or pickup"
      reference_to(Pizza)
      attribute :order_id, OrderId
      attribute :customer_name, CustomerName
      attribute :quantity, Quantity
      emits "OrderPlaced"
      sets :order_id
      sets :customer_name
    end

    command "CancelOrder" do
      role "Customer"
      goal "Cancel a pending order before preparation starts"
      reference_to(Order)
      emits "OrderCancelled"
    end

    query "Pending" do
      where(status: "pending")
    end
  end
end
