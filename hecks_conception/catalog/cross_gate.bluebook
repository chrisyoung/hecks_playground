Hecks.bluebook "CrossGate" do
  vision "Slice-1 cross-aggregate point-gate fixture : a Doc publishes only when its Folder is approved. Proves a given reads one named sibling's field — Folder(folder).status == approved — resolved at the dispatch port before the pipeline's mut borrow. Pure strings, no bool coercion, so Ruby and Rust verdicts are byte-identical."

  aggregate "Folder" do
    identified_by :name

    value_object "Name" do
      attribute :value, String
    end
    value_object "Status" do
      attribute :value, String
    end

    description "A container that can be approved"
    attribute :name, Name
    attribute :status, Status, default: "pending"

    command "CreateFolder" do
      role "System"
      attribute :name, Name
      emits "FolderCreated"
    end

    command "ApproveFolder" do
      role "System"
      reference_to(Folder)
      then_set :status, to: "approved"
      emits "FolderApproved"
    end

    query "all" do
    end
  end

  aggregate "Doc" do
    identified_by :id

    value_object "Id" do
      attribute :value, String
    end
    value_object "DocState" do
      attribute :value, String
    end

    description "A document gated on its folder's approval"
    attribute :id, Id
    attribute :folder, Folder
    attribute :state, DocState, default: "draft"

    # Self-referential DAG edge : a Doc depends_on sibling Docs. Set-gate
    # fixture for Release below (the SET generalisation of the point gate).
    has_many Docs, as: :dependencies

    command "CreateDoc" do
      role "System"
      attribute :id, Id
      attribute :folder, Folder
      emits "DocCreated"
    end

    command "PublishDoc" do
      role "System"
      reference_to(Doc)
      given("folder must be approved") { Folder(folder).status == "approved" }
      then_set :state, to: "published"
      emits "DocPublished"
    end

    command "AddDep" do
      role "System"
      reference_to(Doc)
      attribute :dependency, Doc
      then_set :dependencies, append: :dependency
      emits "DepAdded"
    end

    command "FinishDoc" do
      role "System"
      reference_to(Doc)
      then_set :state, to: "done"
      emits "DocFinished"
    end

    # Set-gate : releasable only when EVERY dependency Doc is resolved
    # (state "done" or "cancelled"). A draft / missing dependency blocks it
    # (fail closed). Proves the SET cross-aggregate gate end-to-end.
    command "Release" do
      role "System"
      reference_to(Doc)
      given("all dependencies must be resolved") { Doc(dependencies).unresolved.empty? }
      then_set :state, to: "released"
      emits "DocReleased"
    end

    query "Drafts" do
      where state: { in: ["draft"] }
    end

    query "Releasable" do
      description "Docs whose every dependency is resolved (terminal : done / cancelled ; a missing dep counts as unresolved). The READ-port twin of the Release set-gate -- same specification, evaluated over the stored ref-list at query time."
      where dependencies: { resolved: true }
    end

    query "all" do
    end
  end
end
