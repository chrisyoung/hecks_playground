  aggregate "DomainDeclaration", "A bounded context declared in the hecksagon — the unit of composition" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Name" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "ListensTo" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Expressed" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "TargetDomain" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :name, Name
    attribute :listens_to, list_of(ListensTo)
    attribute :expressed, Expressed

    command "DeclareDomain" do
      role "Architect"
      description "Register a bounded context in the hecksagon"
      attribute :name, Name
      emits "DomainDeclared"
      then_set :name, to: :name
      then_set :expressed, to: "true"
    end

    command "WireDependency" do
      role "Architect"
      description "This domain listens to events from another domain"
      reference_to(DomainDeclaration)
      attribute :target_domain, TargetDomain
      emits "DependencyWired"
      then_set :listens_to, append: :target_domain
    end

    command "SilenceDomain" do
      role "Architect"
      description "Temporarily disable a domain without removing it"
      reference_to(DomainDeclaration)
      emits "DomainSilenced"
      then_set :expressed, to: "false"
    end
  end

  aggregate "CapabilityDeclaration", "A capability declared in the hecksagon — pluggable behavior" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Name" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Category" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "BluebookPath" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :name, Name
    attribute :category, Category
    attribute :bluebook_path, BluebookPath

    command "DeclareCapability" do
      role "Architect"
      description "Register a capability — security, voice, heki, projection, etc."
      attribute :name, Name
      attribute :category, Category
      emits "CapabilityDeclared"
      then_set :name, to: :name
      then_set :category, to: :category
    end
  end

  aggregate "WorldConfig", "Runtime configuration — database, API keys, adapter selection" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "ConfigKey" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "ConfigValue" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Environment" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :config_key, ConfigKey
    attribute :config_value, ConfigValue
    attribute :environment, Environment

    command "SetConfig" do
      role "Architect"
      description "Set a world configuration value for a specific environment"
      attribute :config_key, ConfigKey
      attribute :config_value, ConfigValue
      attribute :environment, Environment
      emits "ConfigSet"
      then_set :config_key, to: :config_key
      then_set :config_value, to: :config_value
      then_set :environment, to: :environment
    end
  end

  aggregate "AppOverride", "Per-app hecksagon and world that merge with the parent" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "AppName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "AppType" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "OverridesHecksagon" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "OverridesWorld" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :app_name, AppName
    attribute :app_type, AppType
    attribute :overrides_hecksagon, OverridesHecksagon
    attribute :overrides_world, OverridesWorld

    command "RegisterApp" do
      role "Architect"
      description "Register an app variant — web, cli, mobile — that merges its config with the parent"
      attribute :app_name, AppName
      attribute :app_type, AppType
      emits "AppRegistered"
      then_set :app_name, to: :app_name
      then_set :app_type, to: :app_type
    end
  end

  policy "WireOnDeclare" do
    on "DomainDeclared"
    trigger "WireDependency"
  end
end
