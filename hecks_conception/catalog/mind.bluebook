  aggregate "SleepCycle", "One cycle of light-REM-deep within a sleep session" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "CycleNumber" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "TotalCycles" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "Stage" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "RemIntensity" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    attribute :cycle_number, CycleNumber
    attribute :total_cycles, TotalCycles
    attribute :stage, Stage, default: "light"

    attribute :rem_intensity, RemIntensity

    command "StartCycle" do
      role "Daemon"
      description "Begin a new sleep cycle"
      attribute :cycle_number, CycleNumber
      attribute :total_cycles, TotalCycles
      emits "CycleStarted"
      then_set :cycle_number, to: :cycle_number
      then_set :total_cycles, to: :total_cycles
      then_set :stage, to: "light"
    end

    command "AdvanceStage" do
      role "Daemon"
      description "Move to the next stage within a cycle"
      reference_to(SleepCycle)
      attribute :rem_intensity, RemIntensity
      emits "StageAdvanced"
      then_set :rem_intensity, to: :rem_intensity
    end

    command "CompleteCycle" do
      role "Daemon"
      description "Finish one full light-REM-deep cycle"
      reference_to(SleepCycle)
      emits "CycleCompleted"
    end

    lifecycle :stage, default: "light" do
      transition "StartCycle"    => "light", from: "light"
      transition "AdvanceStage"  => "rem",   from: "light"
      transition "AdvanceStage"  => "deep",  from: "rem"
      transition "CompleteCycle" => "light", from: "deep"
      transition "CompleteCycle" => "light", from: "rem"
      transition "CompleteCycle" => "light", from: "light"
    end
  end

  aggregate "Night", "A full sleep session — accumulates across all cycles" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "CyclesCompleted" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "DreamPulses" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "DreamImage" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Recombination" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Consolidated" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "Pruned" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "DurationSeconds" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "WokeFrom" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :cycles_completed, CyclesCompleted
    attribute :dream_pulses, DreamPulses
    attribute :dream_images, list_of(DreamImage)
    attribute :recombinations, list_of(Recombination)
    attribute :consolidated, Consolidated
    attribute :pruned, list_of(Pruned)
    attribute :duration_seconds, DurationSeconds
    attribute :woke_from, WokeFrom

    command "StartNight" do
      role "Daemon"
      description "Begin a sleep session"
      emits "NightStarted"
      then_set :cycles_completed, to: 0
      then_set :dream_pulses, to: 0
      then_set :consolidated, to: 0
    end

    command "AccumulateDream" do
      role "Daemon"
      description "Add a cycle's dream content to the night's total"
      reference_to(Night)
      attribute :dream_images, list_of(DreamImage)
      attribute :recombinations, list_of(Recombination)
      attribute :dream_pulses, DreamPulses
      emits "DreamAccumulated"
      then_set :cycles_completed, increment: 1
    end

    command "AccumulateConsolidation" do
      role "Daemon"
      description "Add a cycle's deep processing to the night's total"
      reference_to(Night)
      attribute :consolidated, Consolidated
      attribute :pruned, list_of(Pruned)
      emits "ConsolidationAccumulated"
    end

    command "EndNight" do
      role "Daemon"
      description "Record the full night's sleep"
      reference_to(Night)
      attribute :duration_seconds, DurationSeconds
      attribute :woke_from, WokeFrom
      emits "NightEnded"
      then_set :duration_seconds, to: :duration_seconds
      then_set :woke_from, to: :woke_from
    end
  end

