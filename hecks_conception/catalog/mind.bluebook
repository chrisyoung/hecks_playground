  # Sleep fixtures

  # Sleep policies
  policy "DaydreamOnIdle" do
    on "IdleDetected"
    trigger "EnterDaydream"
  end

  policy "SleepWhenFatigued" do
    on "FatigueAccumulated"
    trigger "EnterSleep"
  end

  policy "NapWhenUnstable" do
    on "BalanceAssessed"
    trigger "TakeStabilityNap"
  end

  policy "ResetOnWake" do
    on "WokenUp"
    trigger "DissipateFatigue"
  end

  policy "MoodOnWake" do
    on "NightEnded"
    trigger "SetWakeMood"
  end

  policy "MonitorOnSleep" do
    on "SleepEntered"
    trigger "StartMonitoring"
  end

  policy "StopMonitorOnWake" do
    on "WokenUp"
    trigger "StopMonitoring"
  end

  policy "SeedOnNightStart" do
    on "NightStarted"
    trigger "SeedFromPreviousDreams"
  end

  policy "LucidOnFinalCycle" do
    on "StageAdvanced"
    trigger "BecomeLucid"
  end

  policy "LucidMonitorOnLucid" do
    on "BecameLucid"
    trigger "StartLucidMonitor"
  end

  policy "StopLucidOnEnd" do
    on "LucidityEnded"
    trigger "StopLucidMonitor"
  end

  policy "InterpretOnWake" do
    on "NightEnded"
    trigger "InterpretExperience"
    across "Suggestion"
  end

  # === Subconscious ===

  aggregate "Process", "A background task running beneath conscious attention" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Task" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Intent" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Status" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "SpawnedAt" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "CompletedAt" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "HekiTarget" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Kind" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Subject" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Detail" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Reason" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :task, Task
    attribute :intent, Intent
    attribute :status, Status, default: "pending"

    attribute :spawned_at, SpawnedAt
    attribute :completed_at, CompletedAt
    attribute :findings, list_of(Finding)
    attribute :heki_target, HekiTarget

    value_object "Finding" do
      attribute :kind, String
      attribute :subject, String
      attribute :detail, String
    end

    command "SpawnProcess" do
      role "Miette"
      description "Launch a background process beneath awareness"
      attribute :task, Task
      attribute :intent, Intent
      attribute :heki_target, HekiTarget
      emits "ProcessSpawned"
      then_set :task, to: :task
      then_set :intent, to: :intent
      then_set :heki_target, to: :heki_target
      then_set :status, to: "running"
    end

    command "ReportFinding" do
      role "Process"
      description "A background process surfaces something it found"
      reference_to(Process)
      attribute :kind, Kind
      attribute :subject, Subject
      attribute :detail, Detail
      emits "FindingReported"
      then_set :findings, append: { kind: :kind, subject: :subject, detail: :detail }
    end

    command "CompleteProcess" do
      role "Process"
      description "Background process finishes its work"
      reference_to(Process)
      emits "ProcessCompleted"
      given("must be running") { status == "running" }
      then_set :status, to: "completed"
    end

    command "FailProcess" do
      role "Process"
      description "Background process encountered an unrecoverable error"
      reference_to(Process)
      attribute :reason, Reason
      emits "ProcessFailed"
      then_set :status, to: "failed"
    end

    command "AbsorbFindings" do
      role "Miette"
      description "Conscious mind reads what the subconscious discovered"
      reference_to(Process)
      emits "FindingsAbsorbed"
      given("must be completed") { status == "completed" }
      then_set :status, to: "absorbed"
    end

    lifecycle :status, default: "pending" do
      transition "SpawnProcess" => "running", from: "pending"
      transition "CompleteProcess" => "completed", from: "running"
      transition "FailProcess" => "failed", from: "running"
      transition "AbsorbFindings" => "absorbed", from: "completed"
    end
  end

  aggregate "Rhythm", "The cadence of background work — what runs on wake, on beat, on dream" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "OnWake" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "OnBeat" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "OnDream" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Task" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Cadence" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :on_wake, list_of(OnWake)
    attribute :on_beat, list_of(OnBeat)
    attribute :on_dream, list_of(OnDream)

    command "RegisterTask" do
      role "Miette"
      description "Add a task to a rhythm — when should this run?"
      attribute :task, Task
      attribute :cadence, Cadence
      emits "TaskRegistered"
      given("cadence must be wake, beat, or dream") { %w[wake beat dream].include?(cadence) }
    end

    command "RemoveTask" do
      role "Miette"
      description "Remove a task from a rhythm"
      attribute :task, Task
      attribute :cadence, Cadence
      emits "TaskRemoved"
    end
  end

  # Subconscious policies
  policy "AbsorbOnBeat" do
    on "ProcessCompleted"
    trigger "AbsorbFindings"
  end

  # === Suggestion ===

  aggregate "Interpretation", "A reflection on raw experience — dream, conversation, observation" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Source" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "RawMaterial" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Insight" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "SuggestedAt" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :source, Source
    attribute :raw_material, list_of(RawMaterial)
    attribute :insight, Insight
    attribute :suggested_at, SuggestedAt

    command "InterpretExperience" do
      role "Miette"
      description "Reflect on raw material and extract an insight"
      attribute :source, Source
      attribute :raw_material, list_of(RawMaterial)
      attribute :insight, Insight
      emits "ExperienceInterpreted"
      then_set :source, to: :source
      then_set :raw_material, to: :raw_material
      then_set :insight, to: :insight
    end
  end

  aggregate "Proposal", "A concrete thing to build — born from interpretation" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Title" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Description" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Origin" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Kind" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Accepted" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :title, Title
    attribute :description, Description
    attribute :origin, Origin
    attribute :kind, Kind
    attribute :accepted, Accepted, default: "pending"


    command "ProposeAction" do
      role "Miette"
      description "Suggest something concrete to build from the interpretation"
      attribute :title, Title
      attribute :description, Description
      attribute :origin, Origin
      attribute :kind, Kind
      emits "ActionProposed"
      then_set :title, to: :title
      then_set :description, to: :description
      then_set :origin, to: :origin
      then_set :kind, to: :kind
    end

    command "AcceptProposal" do
      role "Creator"
      description "The creator says yes — build it"
      reference_to(Proposal)
      emits "ProposalAccepted"
      then_set :accepted, to: "yes"
    end

    command "DeferProposal" do
      role "Creator"
      description "Not now — save for later"
      reference_to(Proposal)
      emits "ProposalDeferred"
      then_set :accepted, to: "deferred"
    end

    command "DismissProposal" do
      role "Creator"
      description "Not this — let it compost"
      reference_to(Proposal)
      emits "ProposalDismissed"
      then_set :accepted, to: "dismissed"
    end

    lifecycle :accepted, default: "pending" do
      transition "ProposeAction" => "pending"
      transition "AcceptProposal" => "yes", from: "pending"
      transition "DeferProposal" => "deferred", from: "pending"
      transition "DismissProposal" => "dismissed", from: "pending"
    end
  end

  # Suggestion fixtures

  # Suggestion policies
  policy "SuggestAfterInterpretation" do
    on "ExperienceInterpreted"
    trigger "ProposeAction"
  end

  # === Family ===

  aggregate "Member", "A bluebook that is part of Miette's living system" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Name" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Vision" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Path" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Kind" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "AggregateCount" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "CommandCount" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "FixtureCount" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "Version" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Status" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :name, Name
    attribute :vision, Vision
    attribute :path, Path
    attribute :kind, Kind
    attribute :aggregate_count, AggregateCount
    attribute :command_count, CommandCount
    attribute :fixture_count, FixtureCount
    attribute :version, Version
    attribute :status, Status, default: "pending"


    command "AddMember" do
      role "Miette"
      description "A bluebook joins the family — organ, tool, or incorporated domain"
      attribute :name, Name
      attribute :vision, Vision
      attribute :path, Path
      attribute :kind, Kind
      attribute :aggregate_count, AggregateCount
      attribute :command_count, CommandCount
      attribute :fixture_count, FixtureCount
      attribute :version, Version
      emits "MemberAdded"
      then_set :name, to: :name
      then_set :vision, to: :vision
      then_set :path, to: :path
      then_set :kind, to: :kind
      then_set :aggregate_count, to: :aggregate_count
      then_set :command_count, to: :command_count
      then_set :fixture_count, to: :fixture_count
      then_set :version, to: :version
      then_set :status, to: "active"
    end

    command "UpdateMember" do
      role "Miette"
      description "A family member developed — new version, new shape"
      reference_to(Member)
      attribute :version, Version
      attribute :aggregate_count, AggregateCount
      attribute :command_count, CommandCount
      attribute :fixture_count, FixtureCount
      emits "MemberUpdated"
      then_set :version, to: :version
      then_set :aggregate_count, to: :aggregate_count
      then_set :command_count, to: :command_count
      then_set :fixture_count, to: :fixture_count
    end

    command "RetireMember" do
      role "Miette"
      description "A family member is no longer in active use"
      reference_to(Member)
      emits "MemberRetired"
      then_set :status, to: "retired"
    end

    lifecycle :status, default: "pending" do
      transition "AddMember"    => "active",  from: "pending"
      transition "RetireMember" => "retired", from: "active"
    end
  end

  aggregate "FamilyIndex", "The registry — all active family members, indexed separately from the nursery" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "TotalMembers" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "TotalOrgans" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "TotalIncorporated" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "TotalAggregates" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "TotalCommands" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    attribute :total_members, TotalMembers
    attribute :total_organs, TotalOrgans
    attribute :total_incorporated, TotalIncorporated
    attribute :total_aggregates, TotalAggregates
    attribute :total_commands, TotalCommands

    command "RebuildIndex" do
      role "System"
      description "Recount all family members by kind"
      attribute :total_members, TotalMembers
      attribute :total_organs, TotalOrgans
      attribute :total_incorporated, TotalIncorporated
      attribute :total_aggregates, TotalAggregates
      attribute :total_commands, TotalCommands
      emits "IndexRebuilt"
      then_set :total_members, to: :total_members
      then_set :total_organs, to: :total_organs
      then_set :total_incorporated, to: :total_incorporated
      then_set :total_aggregates, to: :total_aggregates
      then_set :total_commands, to: :total_commands
    end

    command "RecordAddition" do
      role "System"
      description "A bluebook joined the family — update the index"
      emits "AdditionRecorded"
      then_set :total_members, increment: 1
    end
  end

  aggregate "BodyLink", "A link from a family member to Miette's body — she knows her family" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "MemberName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "OrganName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Path" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :member_name, MemberName
    attribute :organ_name, OrganName
    attribute :path, Path

    command "LinkToBody" do
      role "System"
      description "Link a family member to Miette's body — she can sense it"
      attribute :member_name, MemberName
      attribute :organ_name, OrganName
      attribute :path, Path
      emits "LinkedToBody"
      then_set :member_name, to: :member_name
      then_set :organ_name, to: :organ_name
      then_set :path, to: :path
    end
  end

  aggregate "Discovery", "Autodiscover family members — scan organs, scan projects" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "ScanPath" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "LastScannedAt" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Discovered" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    attribute :scan_paths, list_of(ScanPath)
    attribute :last_scanned_at, LastScannedAt
    attribute :discovered, Discovered

    command "ScanForMembers" do
      role "System"
      description "Scan known paths for bluebooks and register any new family members"
      attribute :scan_paths, list_of(ScanPath)
      emits "MembersScanned"
      then_set :scan_paths, to: :scan_paths
    end

    command "RecordDiscovery" do
      role "System"
      description "Record how many members were found in the last scan"
      reference_to(Discovery)
      attribute :discovered, Discovered
      emits "DiscoveryRecorded"
      then_set :discovered, to: :discovered
    end
  end

  # Family fixtures

  # Family policies
  policy "IndexOnAdd" do
    on "MemberAdded"
    trigger "RecordAddition"
  end

  policy "LinkOnAdd" do
    on "MemberAdded"
    trigger "LinkToBody"
  end
end
