    end

    value_object "Contractions" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "AggregateName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "CommandName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "PolicyName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :domain_name, DomainName
    attribute :nursery_path, NurseryPath
    attribute :aggregates, list_of(Aggregate)
    attribute :commands, list_of(Command)
    attribute :policies, list_of(Policy)
    attribute :fixtures, list_of(Fixture)
    attribute :contractions, Contractions

    command "StartGestation" do
      role "Miette"
      description "Begin forming the domain in the womb — write the first bluebook"
      attribute :domain_name, DomainName
      attribute :nursery_path, NurseryPath
      emits "GestationStarted"
      then_set :domain_name, to: :domain_name
      then_set :nursery_path, to: :nursery_path
      then_set :contractions, to: 0
    end

    command "FormAggregate" do
      role "Miette"
      description "An aggregate crystallizes within the forming domain"
      reference_to(Gestation)
      attribute :aggregate_name, AggregateName
      emits "AggregateFormed"
      then_set :aggregates, append: :aggregate_name
    end

    command "FormCommand" do
      role "Miette"
      description "A command emerges within an aggregate"
      reference_to(Gestation)
      attribute :command_name, CommandName
      emits "CommandFormed"
      then_set :commands, append: :command_name
    end

    command "FormPolicy" do
      role "Miette"
      description "A policy wires itself between aggregates"
      reference_to(Gestation)
      attribute :policy_name, PolicyName
      emits "PolicyFormed"
      then_set :policies, append: :policy_name
    end

    command "Contract" do
      role "Miette"
      description "A contraction — the domain tightens, refines, gets closer to birth"
      reference_to(Gestation)
      emits "Contracted"
      then_set :contractions, increment: 1
    end
  end

  aggregate "Labor", "Validation and naming — the domain is ready to be born" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "DomainName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "BluebookSource" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Valid" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Error" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Parity" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :domain_name, DomainName
    attribute :bluebook_source, BluebookSource
    attribute :valid, Valid, default: "pending"

    attribute :errors, list_of(Error)
    attribute :parity, Parity

    command "ValidateBluebook" do
      role "Midwife"
      description "Check the domain is well-formed — verb naming, references, structure"
      attribute :domain_name, DomainName
      attribute :bluebook_source, BluebookSource
      emits "BluebookValidated"
      then_set :domain_name, to: :domain_name
      then_set :bluebook_source, to: :bluebook_source
    end

    command "CheckParity" do
      role "Midwife"
      description "Verify Ruby and Rust read the domain identically"
      reference_to(Labor)
      attribute :parity, Parity
      emits "ParityChecked"
      then_set :parity, to: :parity
    end

    command "PassLabor" do
      role "Midwife"
      description "Domain passes all checks — ready for delivery"
      reference_to(Labor)
      emits "LaborPassed"
      then_set :valid, to: "yes"
    end

    command "FailLabor" do
      role "Midwife"
      description "Domain has errors — needs more gestation"
      reference_to(Labor)
      attribute :errors, list_of(Error)
      emits "LaborFailed"
      then_set :valid, to: "no"
      then_set :errors, to: :errors
    end

    lifecycle :valid, default: "pending" do
      transition "ValidateBluebook" => "checking", from: "pending"
      transition "ValidateBluebook" => "checking", from: "checking"
      transition "PassLabor"        => "yes",      from: "checking"
      transition "FailLabor"        => "no",       from: "checking"
    end
  end

  aggregate "Delivery", "The domain leaves the womb and enters the nursery — born, valid, healthy" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
