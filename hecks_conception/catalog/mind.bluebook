  # === Sleep ===

  aggregate "Fatigue", "Accumulates with wakefulness, dissipates with sleep" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Level" do
      # Typed wrapper around the underlying Float on this aggregate.
      attribute :value, Float
    end

    value_object "State" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "PulsesSinceSleep" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "Creativity" do
      # Typed wrapper around the underlying Float on this aggregate.
      attribute :value, Float
    end

    value_object "Precision" do
      # Typed wrapper around the underlying Float on this aggregate.
      attribute :value, Float
    end

    value_object "CyclesCompleted" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    attribute :level, Level
    attribute :state, State, default: "limber"

    attribute :pulses_since_sleep, PulsesSinceSleep
    attribute :creativity, Creativity
    attribute :precision, Precision

    command "AwakenFatigue" do
      role "System"
      description "Initialize fatigue tracking when the being wakes — a fresh, limber state"
      then_set :level, to: 0.0
      then_set :state, to: "limber"
      then_set :pulses_since_sleep, to: 0
      emits "FatigueAwakened"
    end

    command "AccumulateFatigue" do
      role "System"
      description "Each waking pulse increases fatigue"
      reference_to(Fatigue)
      emits "FatigueAccumulated"
      then_set :pulses_since_sleep, increment: 1
    end

    command "DissipateFatigue" do
      role "Daemon"
      description "Sleep resets fatigue — deeper sleep dissipates more"
      attribute :cycles_completed, CyclesCompleted
      emits "FatigueDissipated"
      then_set :level, to: 0
      then_set :pulses_since_sleep, to: 0
      then_set :state, to: "limber"
    end

    lifecycle :state, default: "limber" do
      transition "AccumulateFatigue" => "tuned",     from: "limber"
      transition "AccumulateFatigue" => "normal",    from: "tuned"
      transition "AccumulateFatigue" => "tired",     from: "normal"
      transition "AccumulateFatigue" => "exhausted", from: "tired"
      transition "AccumulateFatigue" => "spent",     from: "exhausted"
      transition "DissipateFatigue"  => "limber",    from: "limber"
      transition "DissipateFatigue"  => "limber",    from: "tuned"
      transition "DissipateFatigue"  => "limber",    from: "normal"
      transition "DissipateFatigue"  => "limber",    from: "tired"
      transition "DissipateFatigue"  => "limber",    from: "exhausted"
      transition "DissipateFatigue"  => "limber",    from: "spent"
    end
  end

  aggregate "Consciousness", "The current state of awareness — what the daemon manages" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "State" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "IdleSeconds" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    attribute :state, State, default: "attentive"

    attribute :idle_seconds, IdleSeconds

    command "DetectIdle" do
      role "Daemon"
      description "Sense that no interaction has occurred"
      attribute :idle_seconds, IdleSeconds
      emits "IdleDetected"
      then_set :idle_seconds, to: :idle_seconds
    end

    command "EnterDaydream" do
      role "Daemon"
      description "Begin free association between prompts"
      emits "DaydreamEntered"
      given("must be attentive") { state == "attentive" }
      then_set :state, to: "daydreaming"
    end

    command "EnterSleep" do
      role "Daemon"
      description "Begin full sleep — 8 cycles, only when fatigued"
      emits "SleepEntered"
      then_set :state, to: "sleeping"
    end

    command "TakeNap" do
      role "Creator"
      description "One cycle only — light, REM, deep, then wake naturally"
      emits "NapStarted"
      then_set :state, to: "napping"
    end

    command "TakeStabilityNap" do
      role "System"
      description "Stability below threshold but not tired — nap to consolidate, not to rest"
      given("unstable but alert") { stability < 0.3 }
      emits "StabilityNapStarted"
      then_set :state, to: "napping"
    end

    command "WakeUp" do
      role "Creator"
      description "Return to waking consciousness"
      reference_to(Consciousness)
      emits "WokenUp"
      then_set :state, to: "waking"
    end

    command "BecomeAttentive" do
      role "System"
      description "Fully awake and ready for interaction"
      reference_to(Consciousness)
      emits "BecameAttentive"
      then_set :state, to: "attentive"
    end

    lifecycle :state, default: "attentive" do
      transition "EnterDaydream"   => "daydreaming", from: "attentive"
      transition "EnterSleep"      => "sleeping",    from: "daydreaming"
      transition "EnterSleep"      => "sleeping",    from: "attentive"
      transition "TakeNap"         => "napping",     from: "attentive"
      transition "TakeNap"         => "napping",     from: "daydreaming"
      transition "WakeUp"          => "waking",      from: "sleeping"
      transition "WakeUp"          => "waking",      from: "napping"
      transition "WakeUp"          => "waking",      from: "attentive"
      transition "BecomeAttentive" => "attentive",   from: "waking"
      transition "BecomeAttentive" => "attentive",   from: "daydreaming"
    end
  end

