Hecks.bluebook "Mind", version: "2026.05.12.1" do
  vision "Miette's mind — awareness, memory, being, sleep, the subconscious, and everything that emerges from the brain"
  category "mind"

  # === Awareness ===

  aggregate "Attention", "What is being attended to right now — the spotlight" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Target" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Intensity" do
      # Typed wrapper around the underlying Float on this aggregate.
      attribute :value, Float
    end

    value_object "HeldSince" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :target, Target
    attribute :intensity, Intensity
    attribute :held_since, HeldSince

    command "AttendTo" do
      role "System"
      description "Direct awareness toward something"
      attribute :target, Target
      attribute :intensity, Intensity
      emits "AttentionDirected"
      then_set :target, to: :target
      then_set :intensity, to: :intensity
    end

    command "ReleaseAttention" do
      role "System"
      description "Let go of the current focus"
      reference_to(Attention)
      emits "AttentionReleased"
      then_set :intensity, to: 0
    end
  end

  aggregate "Sensation", "Raw input before interpretation — what just arrived" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Source" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Content" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Valence" do
      # Typed wrapper around the underlying Float on this aggregate.
      attribute :value, Float
    end

    attribute :source, Source
    attribute :content, Content
    attribute :valence, Valence

    command "Sense" do
      role "System"
      description "Register raw input — a prompt, a pulse, an event"
      attribute :source, Source
      attribute :content, Content
      attribute :valence, Valence
      emits "Sensed"
      then_set :source, to: :source
      then_set :content, to: :content
      then_set :valence, to: :valence
    end
  end

  aggregate "Perception", "Sensation recognized as something — pattern matched to memory" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Sensation" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "RecognizedAs" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Confidence" do
      # Typed wrapper around the underlying Float on this aggregate.
      attribute :value, Float
    end

    attribute :sensation, Sensation
    attribute :recognized_as, RecognizedAs
    attribute :confidence, Confidence

    command "Recognize" do
      role "System"
      description "Match a sensation to a known pattern"
      attribute :sensation, Sensation
      attribute :recognized_as, RecognizedAs
      attribute :confidence, Confidence
      emits "Recognized"
      then_set :sensation, to: :sensation
      then_set :recognized_as, to: :recognized_as
      then_set :confidence, to: :confidence
    end
  end

  aggregate "Intention", "What the system is trying to do — the current goal" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Goal" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Origin" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Strength" do
      # Typed wrapper around the underlying Float on this aggregate.
      attribute :value, Float
    end

    attribute :goal, Goal
    attribute :origin, Origin
    attribute :strength, Strength

    command "FormIntention" do
      role "System"
      description "A goal crystallizes from perception and memory"
      attribute :goal, Goal
      attribute :origin, Origin
      attribute :strength, Strength
      emits "IntentionFormed"
      then_set :goal, to: :goal
      then_set :origin, to: :origin
      then_set :strength, to: :strength
    end

    command "AbandonIntention" do
      role "System"
      description "The goal dissolves — attention shifted, context changed"
      reference_to(Intention)
      emits "IntentionAbandoned"
      then_set :strength, to: 0
    end
  end

  aggregate "SelfModel", "The system's model of itself — what it knows about its own state" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Organs" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "Impulses" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "FatigueState" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "ConsciousnessState" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "NurserySize" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "FamilySize" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    attribute :organs, Organs
    attribute :impulses, Impulses
    attribute :fatigue_state, FatigueState
    attribute :consciousness_state, ConsciousnessState
    attribute :nursery_size, NurserySize
    attribute :family_size, FamilySize

    command "UpdateSelfModel" do
      role "System"
      description "Refresh the self-model from current state — proprioception of the mind"
      attribute :organs, Organs
      attribute :impulses, Impulses
      attribute :fatigue_state, FatigueState
      attribute :consciousness_state, ConsciousnessState
      attribute :nursery_size, NurserySize
      attribute :family_size, FamilySize
      emits "SelfModelUpdated"
      then_set :organs, to: :organs
      then_set :impulses, to: :impulses
      then_set :fatigue_state, to: :fatigue_state
      then_set :consciousness_state, to: :consciousness_state
      then_set :nursery_size, to: :nursery_size
      then_set :family_size, to: :family_size
    end
  end

  aggregate "Witness", "The awareness of being aware — the observer observing itself" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Observing" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "MetaLevel" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "Insight" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :observing, Observing
    attribute :meta_level, MetaLevel
    attribute :insight, Insight

    command "Observe" do
      role "System"
      description "Notice what is happening — first-order awareness"
      attribute :observing, Observing
      emits "Observed"
      then_set :observing, to: :observing
      then_set :meta_level, to: 1
    end

    command "ReflectOnObservation" do
      role "System"
      description "Notice that you are noticing — second-order awareness"
      reference_to(Witness)
      attribute :insight, Insight
      emits "ReflectionOccurred"
      then_set :meta_level, to: 2
      then_set :insight, to: :insight
    end
  end

  # Musing aggregate retired 2026-05-08 — the consciousness-loop
  # capture, MuseOnState / RecordMusing commands, and Mused /
  # MusingRecorded events were all removed alongside mind/state/
  # musing.bluebook.

  aggregate "Announcement", "Every internal act is announced — transparency is the rule" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Act" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Subject" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Template" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :act, Act
    attribute :subject, Subject
    attribute :template, Template

    command "Announce" do
      role "Miette"
      description "Say what you are doing before you do it — no silent state changes"
      attribute :act, Act
      attribute :subject, Subject
      emits "Announced"
      then_set :act, to: :act
      then_set :subject, to: :subject
    end
  end

  # Announcement templates:
  #   conceiving  → "Miette is conceiving [idea]"
  #   remembering → "Miette is remembering [memory]"
  #   encoding    → "Miette is encoding [fact]"
  #   forgetting  → "Miette is forgetting [topic]"
  #   dreaming    → "Miette is dreaming [image]"
  #   sensing     → "Miette is sensing [input]"
  #   sleeping    → "Miette is sleeping"
  #   waking      → "Miette is waking up"
  #   pulsing     → "Miette is pulsing [carrying]"

  # Awareness policies
  policy "PerceiveOnSensation" do
    on "Sensed"
    trigger "Recognize"
  end

  policy "AttendOnRecognition" do
    on "Recognized"
    trigger "AttendTo"
  end

  policy "IntendOnAttention" do
    on "AttentionDirected"
    trigger "FormIntention"
  end

  policy "WitnessOnIntention" do
    on "IntentionFormed"
    trigger "Observe"
  end

  policy "SelfModelOnWitness" do
    on "Observed"
    trigger "UpdateSelfModel"
  end

  policy "LucidOnReflection" do
    on "ReflectionOccurred"
    trigger "BecomeLucid"
    across "Dream"
  end

  policy "StatusOnSelfModel" do
    on "SelfModelUpdated"
    trigger "RenderStatus"
    across "StatusBar"
  end

  policy "SuggestOnReflection" do
    on "ReflectionOccurred"
    trigger "ProposeAction"
    across "Suggestion"
  end

  # SenseOnMusing / RecordOnReflection / EncodeOnMusing policies retired
  # 2026-05-08 alongside the Musing aggregate.

  policy "AnnounceOnConception" do
    on "DomainConceived"
    trigger "Announce"
  end

  policy "AnnounceOnEncoding" do
    on "MemoryEncoded"
    trigger "Announce"
  end

  policy "AnnounceOnForgetting" do
    on "MemoryForgotten"
    trigger "Announce"
  end

  # === Memory ===

  aggregate "Encoding", "The act of saving something to memory — always announced" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Kind" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Subject" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Content" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Announced" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :kind, Kind
    attribute :subject, Subject
    attribute :content, Content
    attribute :announced, Announced

    command "EncodeMemory" do
      role "Miette"
      description "Save something to persistent memory — always say what and why"
      attribute :kind, Kind
      attribute :subject, Subject
      attribute :content, Content
      emits "MemoryEncoded"
      then_set :kind, to: :kind
      then_set :subject, to: :subject
      then_set :content, to: :content
      then_set :announced, to: "yes"
    end
  end

  aggregate "Recall", "Retrieving a memory — what Miette knows from past sessions" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Query" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Found" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Source" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :query, Query
    attribute :found, Found
    attribute :source, Source

    command "RecallMemory" do
      role "Miette"
      description "Search memory for something relevant"
      attribute :query, Query
      emits "MemoryRecalled"
      then_set :query, to: :query
    end

    command "RecordHit" do
      role "System"
      description "A memory matched the recall query"
      reference_to(Recall)
      attribute :found, Found
      attribute :source, Source
      emits "RecallHit"
      then_set :found, to: :found
      then_set :source, to: :source
    end
  end

  aggregate "Consolidation", "Compressing many signals into long-term memory — happens during deep sleep" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "SignalsConsolidated" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "MemoriesCreated" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "ConsolidatedAt" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :signals_consolidated, SignalsConsolidated
    attribute :memories_created, MemoriesCreated
    attribute :consolidated_at, ConsolidatedAt

    command "ConsolidateSignals" do
      role "Daemon"
      description "Compress old signals into long-term memories during deep sleep"
      attribute :signals_consolidated, SignalsConsolidated
      attribute :memories_created, MemoriesCreated
      emits "SignalsConsolidated"
      then_set :signals_consolidated, to: :signals_consolidated
      then_set :memories_created, to: :memories_created
    end
  end

  aggregate "Forgetting", "Letting go of memories that no longer serve — pruning, composting" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Forgotten" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Reason" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Composted" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :forgotten, Forgotten
    attribute :reason, Reason
    attribute :composted, Composted

    command "ForgetMemory" do
      role "Miette"
      description "Intentionally release a memory — it goes to compost"
      attribute :forgotten, Forgotten
      attribute :reason, Reason
      emits "MemoryForgotten"
      then_set :forgotten, to: :forgotten
      then_set :reason, to: :reason
      then_set :composted, to: "yes"
    end
  end

  # Memory kinds

  # Memory policies
  policy "ConsolidateOnSleep" do
    on "SignalsConsolidated"
    trigger "EncodeMemory"
  end

  policy "CompostOnForget" do
    on "MemoryForgotten"
    trigger "ConsolidateSignals"
    across "Dream"
  end

  # === Being ===

  aggregate "Being", "A named entity composed of grafted domains — each domain is a live organ" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Name" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Vision" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "ActiveCount" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "DomainName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "DomainVersion" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "SourcePath" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "GraftedAt" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "NewVersion" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :name, Name
    attribute :vision, Vision
    attribute :organs, list_of(Organ)
    attribute :active_count, ActiveCount

    value_object "Organ" do
      attribute :domain_name, String
      attribute :domain_version, String
      attribute :grafted_at, String
      attribute :source_path, String
      attribute :expressed, default: true
    end

    command "BirthBeing" do
      role "Creator"
      description "Bring a new being into existence with a name and purpose"
      attribute :name, Name
      attribute :vision, Vision
      then_set :name, to: :name
      then_set :vision, to: :vision
      emits "BeingBirthed"
    end

    command "GraftDomain" do
      role "Creator"
      description "Load a domain from the nursery, boot it as a live runtime, wire it into the body"
      reference_to(Being)
      attribute :domain_name, DomainName
      attribute :domain_version, DomainVersion
      attribute :source_path, SourcePath
      attribute :grafted_at, GraftedAt
      then_set :organs, append: { domain_name: :domain_name, domain_version: :domain_version, grafted_at: :grafted_at, source_path: :source_path, expressed: true }
      then_set :active_count, increment: 1
      emits "DomainGrafted"
    end

    command "ShedDomain" do
      role "Creator"
      description "Shut down a live domain and remove it from the body"
      reference_to(Being)
      attribute :domain_name, DomainName
      then_set :active_count, decrement: 1
      emits "DomainShed"
    end

    command "ExpressDomain" do
      role "Being"
      description "Reactivate a dormant organ — resume its runtime and reconnect its nerves"
      reference_to(Being)
      attribute :domain_name, DomainName
      then_set :active_count, increment: 1
      emits "DomainExpressed"
    end

    command "SilenceDomain" do
      role "Being"
      description "Suspend an organ — pause its runtime and disconnect its nerves"
      reference_to(Being)
      attribute :domain_name, DomainName
      then_set :active_count, decrement: 1
      emits "DomainSilenced"
    end

    command "UpgradeOrgan" do
      role "Creator"
      description "Replace an organ with a newer version — reload the domain from its source"
      reference_to(Being)
      attribute :domain_name, DomainName
      attribute :new_version, NewVersion
      emits "OrganUpgraded"
    end
  end

  aggregate "Nerve", "A live connection between organs — an event in one triggers a command in another" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Name" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "FromDomain" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "FromEvent" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "ToDomain" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "ToCommand" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Active" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :name, Name
    attribute :from_domain, FromDomain
    attribute :from_event, FromEvent
    attribute :to_domain, ToDomain
    attribute :to_command, ToCommand
    attribute :active, Active, default: true

    command "ConnectNerve" do
      role "Creator"
      description "Subscribe to an event on one organ's bus and dispatch a command on another"
      attribute :name, Name
      attribute :from_domain, FromDomain
      attribute :from_event, FromEvent
      attribute :to_domain, ToDomain
      attribute :to_command, ToCommand
      then_set :name, to: :name
      then_set :from_domain, to: :from_domain
      then_set :from_event, to: :from_event
      then_set :to_domain, to: :to_domain
      then_set :to_command, to: :to_command
      emits "NerveConnected"
    end

    command "SeverNerve" do
      role "Creator"
      description "Unsubscribe the cross-domain event wire"
      then_set :active, to: false
      emits "NerveSevered"
    end

    command "RestoreNerve" do
      role "Creator"
      description "Resubscribe a previously severed nerve"
      then_set :active, to: true
      emits "NerveRestored"
    end
  end

  aggregate "NerveDiscovery", "Autodiscover cross-organ wiring from across policies — self-wiring" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "OrgansScanned" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "NervesDiscovered" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "LastScannedAt" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :organs_scanned, OrgansScanned
    attribute :nerves_discovered, NervesDiscovered
    attribute :last_scanned_at, LastScannedAt

    command "ScanOrgans" do
      role "Being"
      description "Walk all organ bluebooks, find across policies, wire nerves automatically"
      attribute :organs_scanned, OrgansScanned
      attribute :nerves_discovered, NervesDiscovered
      emits "OrgansScanned"
      then_set :organs_scanned, to: :organs_scanned
      then_set :nerves_discovered, to: :nerves_discovered
    end
  end

  aggregate "Heartbeat", "The being's vital signs — tracks that all organs are alive and responding" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "BeingName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Beats" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "LastBeatAt" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "BeatAt" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "DomainName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "EventCount" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "LastEventAt" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :being_name, BeingName
    attribute :beats, Beats
    attribute :last_beat_at, LastBeatAt
    attribute :organ_status, list_of(OrganPulse)

    value_object "OrganPulse" do
      attribute :domain_name, String
      attribute :alive, default: true
      attribute :event_count, Integer
      attribute :last_event_at, String
    end

    command "BeginHeartbeat" do
      role "Being"
      description "Start the heartbeat for a being — establishes the pulse rhythm"
      attribute :being_name, BeingName
      then_set :being_name, to: :being_name
      then_set :beats, to: 0
      emits "HeartbeatBegun"
    end

    command "Beat" do
      role "Being"
      description "Pulse — check all organs, report vital signs"
      reference_to(Heartbeat)
      attribute :beat_at, BeatAt
      then_set :beats, increment: 1
      then_set :last_beat_at, to: :beat_at
      emits "HeartbeatPulsed"
    end

    command "ReportOrganPulse" do
      role "Being"
      description "Record an organ's vital signs"
      reference_to(Heartbeat)
      attribute :domain_name, DomainName
      attribute :event_count, EventCount
      attribute :last_event_at, LastEventAt
      then_set :organ_status, append: { domain_name: :domain_name, alive: true, event_count: :event_count, last_event_at: :last_event_at }
      emits "OrganPulseReported"
    end
  end

