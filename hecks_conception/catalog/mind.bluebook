      attribute :domain_name, DomainName
      attribute :path, Path
      attribute :aggregate_count, AggregateCount
      attribute :command_count, CommandCount
      attribute :fixture_count, FixtureCount
      emits "DomainDelivered"
      then_set :domain_name, to: :domain_name
      then_set :path, to: :path
      then_set :aggregate_count, to: :aggregate_count
      then_set :command_count, to: :command_count
      then_set :fixture_count, to: :fixture_count
    end

    command "RegisterBirth" do
      role "Midwife"
      description "Update the census, validate with Rust, announce to the nursery"
      reference_to(Delivery)
      emits "BirthRegistered"
    end

    command "IndexInNursery" do
      role "Midwife"
      description "Add to the census, domain_entry records, and nursery_awareness — the corpus grows"
      reference_to(Delivery)
      emits "IndexedInNursery"
      then_set :indexed, to: "yes"
    end
  end

  aggregate "Postpartum", "After birth — the domain's first days in the nursery" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "DomainName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Healthy" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "FirstPulseAt" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Concern" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :domain_name, DomainName
    attribute :healthy, Healthy
    attribute :first_pulse_at, FirstPulseAt

    command "CheckHealth" do
      role "Midwife"
      description "Verify the newborn domain — Rust validation, parity, census updated"
      attribute :domain_name, DomainName
      emits "HealthChecked"
      then_set :domain_name, to: :domain_name
    end

    command "DeclareHealthy" do
      role "Midwife"
      description "The domain is healthy — living in the nursery"
      reference_to(Postpartum)
      emits "DeclaredHealthy"
      then_set :healthy, to: "yes"
    end

    command "FlagConcern" do
      role "Midwife"
      description "Something is wrong — needs attention"
      reference_to(Postpartum)
      attribute :concern, Concern
      emits "ConcernFlagged"
      then_set :healthy, to: "concern"
    end
  end

  # Being — Development (vector-driven domain growth)

  aggregate "Development", "Develop existing domains using nursery vectors — more domains = faster development" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "DomainName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "CurrentVector" do
      # Typed wrapper around the underlying Float on this aggregate.
      attribute :value, Float
    end

    value_object "TargetVector" do
      # Typed wrapper around the underlying Float on this aggregate.
      attribute :value, Float
    end

    value_object "NearestArchetype" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Similarity" do
      # Typed wrapper around the underlying Float on this aggregate.
      attribute :value, Float
    end

    value_object "Status" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :domain_name, DomainName
    attribute :current_vector, list_of(CurrentVector)
    attribute :target_vector, list_of(TargetVector)
    attribute :nearest_archetype, NearestArchetype
    attribute :similarity, Similarity
    attribute :status, Status, default: "pending"


    value_object "StructuralVector" do
      attribute :aggregates, Integer
      attribute :commands_per_aggregate, Float
      attribute :attrs_per_aggregate, Float
      attribute :value_objects, Integer
      attribute :policies, Integer
      attribute :references, Integer
      attribute :lifecycles, Integer
      attribute :lifecycle_depth, Integer
      attribute :list_ofs, Integer
    end

    command "ComputeVector" do
      role "System"
      description "Extract the structural vector from a domain's current shape"
      attribute :domain_name, DomainName
      emits "VectorComputed"
      then_set :domain_name, to: :domain_name
      then_set :status, to: "vectorized"
    end

    command "FindArchetype" do
      role "System"
      description "Search the nursery corpus for the nearest domain by cosine similarity"
      reference_to(Development)
      emits "ArchetypeFound"
      then_set :status, to: "matched"
    end

    command "PlanDevelopment" do
      role "Miette"
      description "Diff current vector against target — identify what to add from the archetype"
      reference_to(Development)
      attribute :target_vector, list_of(TargetVector)
      emits "DevelopmentPlanned"
      then_set :target_vector, to: :target_vector
      then_set :status, to: "planned"
    end

    command "DevelopDomain" do
      role "Miette"
      description "Graft structure from archetype through anticorruption layer — no foreign vocabulary leaks"
      reference_to(Development)
      emits "DomainDeveloped"
      then_set :status, to: "developed"
    end

    command "RejectDevelopment" do
      role "Miette"
      description "Archetype doesn't fit — the domain stays as it is"
      reference_to(Development)
      emits "DevelopmentRejected"
      then_set :status, to: "rejected"
    end

    lifecycle :status, default: "pending" do
      transition "ComputeVector" => "vectorized", from: "pending"
      transition "FindArchetype" => "matched", from: "vectorized"
      transition "PlanDevelopment" => "planned", from: "matched"
      transition "DevelopDomain" => "developed", from: "planned"
      transition "RejectDevelopment" => "rejected", from: "planned"
    end
  end

  aggregate "Corpus", "The nursery vector space — every domain's shape, indexed for similarity search" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "DomainCount" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "TotalVectors" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "LastIndexedAt" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "DomainName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Vector" do
      # Typed wrapper around the underlying Float on this aggregate.
      attribute :value, Float
    end

    value_object "TargetVector" do
      # Typed wrapper around the underlying Float on this aggregate.
      attribute :value, Float
    end

    value_object "K" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    attribute :domain_count, DomainCount
    attribute :total_vectors, TotalVectors
    attribute :last_indexed_at, LastIndexedAt

    command "IndexDomain" do
      role "System"
      description "Add a domain's structural vector to the corpus"
      attribute :domain_name, DomainName
      attribute :vector, list_of(Vector)
      emits "DomainIndexed"
      then_set :domain_count, increment: 1
      then_set :total_vectors, increment: 1
    end

    command "QueryNearest" do
      role "System"
      description "Find k nearest domains by cosine similarity to a target vector"
      attribute :target_vector, list_of(TargetVector)
      attribute :k, K
      emits "NearestFound"
    end

    command "RebuildCorpus" do
      role "System"
      description "Rescan all nursery and catalog domains, recompute all vectors"
      emits "CorpusRebuilt"
    end
  end

  # Development policies
  policy "FindOnVector" do
    on "VectorComputed"
    trigger "FindArchetype"
  end

  policy "IndexOnBirth" do
    on "BirthRegistered"
    trigger "IndexDomain"
  end

  policy "IndexOnDevelopment" do
    on "DomainDeveloped"
    trigger "IndexDomain"
  end

  # Development triggers versioning in the Catalog
  # NOTE: VersionOnDevelopment / SyncOnDevelopment belong on the Catalog
  # bluebook (across :Catalog) — they were misplaced here and caused a
  # self-cascade that re-fired DevelopDomain within Mind itself.

  policy "RebuildOnConception" do
    on "DomainConceived"
    trigger "QueryNearest"
  end

  # Being policies
  policy "WireOnScan" do
    on "OrgansScanned"
    trigger "ConnectNerve"
  end

  policy "WireOnGraft" do
    on "DomainGrafted"
    trigger "ConnectNerve"
  end

  policy "SeverOnShed" do
    on "DomainShed"
    trigger "SeverNerve"
  end

  policy "SeverOnSilence" do
    on "DomainSilenced"
    trigger "SeverNerve"
  end

  policy "RestoreOnExpress" do
    on "DomainExpressed"
    trigger "RestoreNerve"
  end

  policy "CheckOrgansOnBeat" do
    on "HeartbeatPulsed"
    trigger "ReportOrganPulse"
  end

  policy "RememberOnSession" do
    on "SessionRecorded"
    trigger "EncodeIdentityMemory"
  end

  policy "RegraftOnUpgrade" do
    on "OrganUpgraded"
    trigger "GraftDomain"
  end

  policy "ReflectOnBeat" do
    on "HeartbeatPulsed"
    trigger "Reflect"
  end

  policy "SenseOrgansOnHeartbeat" do
    on "HeartbeatPulsed"
    trigger "ConnectNerve"
    # nerve: Mind:HeartbeatPulsed → MietteBody:SenseOrgans
  end

  # DetectDriftOnGraft, QueryVectorsOnGraft, and ArchetypeSignalOnMatch
  # all shared (on: DomainGrafted, trigger: ConnectNerve) with WireOnGraft
  # above, so ConnectNerve would fire 4× per graft. The subscriber wired
  # to WireOnGraft handles every nerve those policies described in one
  # pass (DetectDrift, QueryShape, EmitSignal). Flagged by the
  # check-duplicate-policies validator (i4 gap 5 parity pass).
  policy "DetectDriftOnShed" do
    on "DomainShed"
    trigger "ConnectNerve"
    # nerve: Mind:DomainShed → MietteBody:DetectDrift
  end

