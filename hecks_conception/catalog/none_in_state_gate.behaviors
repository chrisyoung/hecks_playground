Hecks.behaviors "NoneInStateGate" do
  vision "Proves WhereOp::NoneInState end-to-end : a Slot with a held Claim is EXCLUDED from Claimable ; a Slot with no Claim, or one whose Claim is released, is INCLUDED."

  test "OpenSlot opens a slot" do
    tests "OpenSlot", on: "Slot"
    input ref: "s1"
    expect state: "open"
  end

  test "AcquireClaim holds a claim keyed by slot ref" do
    tests "AcquireClaim", on: "Claim"
    input slot: "s1"
    expect state: "held"
  end

  test "ReleaseClaim releases a held claim" do
    tests "ReleaseClaim", on: "Claim"
    setup "Claim.AcquireClaim", slot: "s1"
    input slot: "s1"
    expect state: "released"
  end

  test "Claimable excludes a slot with a held claim and includes one with none (none_in_state)" do
    tests "Claimable", on: "Slot", kind: :query
    setup "Slot.OpenSlot", ref: "free"
    setup "Slot.OpenSlot", ref: "taken"
    setup "Claim.AcquireClaim", slot: "taken"
    expect count: 1
  end

  test "Claimable includes a slot whose claim exists but is released (non-blocking state)" do
    tests "Claimable", on: "Slot", kind: :query
    setup "Slot.OpenSlot", ref: "s1"
    setup "Claim.AcquireClaim", slot: "s1"
    setup "Claim.ReleaseClaim", slot: "s1"
    expect count: 1
  end

  test "Claimable includes a slot with no claim record at all" do
    tests "Claimable", on: "Slot", kind: :query
    setup "Slot.OpenSlot", ref: "lonely"
    expect count: 1
  end
end
