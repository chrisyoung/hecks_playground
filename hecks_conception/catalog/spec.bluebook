Hecks.bluebook "Spec", version: "2026.05.12.1" do
  vision "Testing infrastructure — spec generation, memory adapters, canonical Pizza/Order domain"
  category "framework"

  aggregate "TestHelper" do
    description "Resets runtime state between tests: clears repos and event bus"
    command "Reset" do
    end
  end

  aggregate "InMemoryLoader" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Domain" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Mod" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    description "Loads a domain into Ruby without disk I/O via RubyVM::InstructionSequence"
    command "Load" do
      attribute :domain, Domain
      attribute :mod, Mod
    end
  end

  aggregate "MemoryAdapter" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Aggregate" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "DomainModule" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    description "Generated in-memory repository with find, save, delete, all, count, query, clear"
    command "Generate" do
      attribute :aggregate, Aggregate
      attribute :domain_module, DomainModule
    end
  end

  aggregate "MemoryOutbox" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Event" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "EntryId" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    description "In-memory outbox for testing: store, poll, mark_published, clear"
    command "Store" do
      attribute :event, Event
    end
    command "Poll" do
    end
    command "MarkPublished" do
      attribute :entry_id, EntryId
    end
  end

  aggregate "EventBus" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "EventName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Event" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    description "In-memory pub/sub with ordered event log for test verification"
    command "Subscribe" do
      attribute :event_name, EventName
    end
    command "Publish" do
      attribute :event, Event
    end
    command "Clear" do
    end
  end

  aggregate "InMemoryExecutor" do
    description "Fallback query executor filtering in-memory collections"
    command "Execute" do
    end
  end

  aggregate "SpecGenerator" do
    description "Composes 14 type-specific mixins to generate RSpec files from domain IR"
    command "GenerateSpecHelper" do
    end
  end

  aggregate "SpecHelpers" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Thing" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Attr" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    description "Example value generation, argument building, and spec snippet builders"
    command "ExampleArgs" do
      attribute :thing, Thing
    end
    command "ExampleValue" do
      attribute :attr, Attr
    end
  end

  aggregate "SpecWriter" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Root" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "GemName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    description "Orchestrates writing all RSpec files to disk for a domain gem"
    command "GenerateSpecs" do
      attribute :root, Root
      attribute :gem_name, GemName
    end
  end

  aggregate "ServerHelpers" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Url" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "BaseUrl" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "FormPath" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    description "HTTP server test helpers: port allocation, readiness polling, form submission"
    command "FreePort" do
    end
    command "WaitForServer" do
      attribute :url, Url
    end
    command "SubmitForm" do
      attribute :base_url, BaseUrl
      attribute :form_path, FormPath
    end
  end

  aggregate "Pizza" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Name" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Description" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Amount" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    description "A pizza with a name, description, and toppings. Demonstrates value objects, lists, validations, and queries."
    attribute :name, Name
    attribute :description, Description
    attribute :toppings, list_of(Topping)

    value_object "Topping" do
      description "A measured ingredient on a pizza. Immutable once created."
      attribute :name, String
      attribute :amount, Integer

      invariant "amount must be positive" do
        amount > 0
      end
    end

    validation :name, presence: true
    validation :description, presence: true

    command "CreatePizza" do
      description "Add a new pizza to the menu with a name and description"
      attribute :name, Name
      attribute :description, Description
    end

    query "ByDescription" do |desc|
      where(description: desc)
    end

    command "AddTopping" do
      description "Add a measured topping to an existing pizza"
      reference_to(Pizza)
      attribute :name, Name
      attribute :amount, Amount
    end
  end

  aggregate "Order" do

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "CustomerName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Status" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Quantity" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    description "A customer order referencing a pizza. Demonstrates references, transitions, and collection proxies."
    attribute :customer_name, CustomerName
    attribute :items, list_of(OrderItem)
    reference_to(Pizza)

    attribute :status, Status, default: "pending"

    lifecycle :status, default: "pending" do
      transition "CancelOrder" => "cancelled"
    end

    value_object "OrderItem" do
      description "A line item in an order with a quantity"
      attribute :quantity, Integer

      invariant "quantity must be positive" do
        quantity > 0
      end
    end

    validation :customer_name, presence: true

    command "PlaceOrder" do
      description "Place a new order for a pizza"
      attribute :customer_name, CustomerName
      reference_to(Pizza)
      attribute :quantity, Quantity
    end

    command "CancelOrder" do
      description "Cancel a pending order, transitioning status to cancelled"
      reference_to(Order)
    end

    query "Pending" do
      where(status: "pending")
    end
  end

end
