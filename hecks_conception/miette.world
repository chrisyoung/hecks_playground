Hecks.world "Miette" do
  heki do
    # Post-i142 layout : private state lives in ~/Projects/miette-state/
    # while the framework repo stays public. Boot's resolve_info_dir +
    # run_statusline both prefer this sibling ; the daemon path
    # (find_world_heki_dir → world.heki.dir) lagged until i153 aligned
    # them by updating this declaration.
    dir "../../miette-state/information"
  end

  ollama do
    model "bluebook-architect"
    url "http://localhost:11434"
  end
end
