Hecks.bluebook "Dispatch", version: "2026.05.10.1" do
  vision "The bus. Routes a phrase + params to the target bluebook, validates the params against the target command's attributes, dispatches through the configured storage adapter, and re-emits the resulting event. Every surface (Spring REPL, Glass palette, the conversation surface, the bin-buddy command bus, future hosts) calls into Route ; no surface does its own resolution."
  category "storehouse"

  # ============================================================
  # DISPATCH — the bus itself
  # ============================================================
  #
  # Before this bluebook every surface routed its own way — each
  # one parsed phrases and reached for the runtime directly.
  # Several implementations of the same idea, each subtly different.
  # Dispatch makes the bus one.
  #
  # Route resolves the phrase via Lexicon.Lookup, validates params
  # against the target command's attributes, dispatches through
  # the configured storage adapter (named in the hecksagon, not
  # here), captures the emitted event, and re-emits it as
  # Dispatched with the original phrase + params + the target
  # event's payload.
  #
  # Persistence delegates to the per-aggregate storage adapter —
  # Dispatch does NOT own a separate dispatch log. The bus
  # resolves and routes ; storage writes are the adapter's job.
  #
  # Validation failures (phrase doesn't resolve, params don't fit
  # target command's attributes) surface as runtime errors before
  # the command runs ; no DispatchFailed event is emitted at the
  # bluebook layer because the command never reached the dispatch
  # phase.
  #
  # Companion to lexicon.bluebook (resolves the phrase),
  # query.bluebook (the read side), and command_bus.bluebook
  # (a scoped, app-filtered view of this bus). See i528 for the
  # full storehouse arc and the four-segment phrase convention.

  aggregate "Dispatch", "Singleton command bus over the conception" do
    identified_by ServiceName

    value_object "ServiceName" do
      attribute :value, String
      rule "must be the singleton 'dispatch'" do
        requires { value == "dispatch" }
      end
    end

    value_object "Phrase" do
      # The four-segment form a caller types :
      # "app::domain::Aggregate::Command". Each segment carries one
      # level of namespace context — `app` is the project name
      # (inferred from the bluebook's containing folder at compile
      # time, not declared in the source) ; `domain` is the
      # sub-folder grouping ; `Aggregate` and `Command` come from
      # the bluebook itself. Same shape as Lexicon.Phrase.
      attribute :value, String
      rule "must be app::domain::Aggregate::Command (4 non-empty segments)" do
        requires { value.split("::").length == 4 && value.split("::").all? { |s| s.length > 0 } }
      end
    end

    value_object "Params" do
      # Key-value bag carried as a JSON object string. The runtime
      # parses this into the target command's typed attributes at
      # validation time ; the bluebook layer keeps it opaque so any
      # command's attribute set fits the same Route signature.
      attribute :value, String
      rule "must be a JSON object" do
        requires { value.start_with?("{") && value.end_with?("}") }
      end
    end

    attribute ServiceName

    # ── Commands ───────────────────────────────────────────────

    command "Route" do
      role "Caller"
      description "Resolve the phrase via Lexicon.Lookup, validate params against the target command's attributes, dispatch through the per-bluebook runtime path, capture the emitted event, and re-emit it as Dispatched. On validation failure the command never runs ; runtime errors surface to the caller."
      attribute Phrase, as: :phrase
      attribute Params, as: :params
      expects "phrase resolves in the lexicon" do
        Lexicon.Lookup(phrase: phrase).present?
      end
      emits "Dispatched"
    end
  end
end
