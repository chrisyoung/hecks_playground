Hecks.bluebook "Query", version: "2026.05.10.1" do
  vision "The read side of the bus. Reads attribute values from the configured storage adapter by canonical four-segment path. Closes the gap where the runtime can dispatch but cannot query — Read makes attribute access a bluebook command like everything else. Companion to Run (future), which invokes named queries declared inside aggregates."
  category "storehouse"

  # ============================================================
  # QUERY — the read side of the bus
  # ============================================================
  #
  # Before this bluebook the runtime could dispatch (commands
  # write events, events mutate state, the bluebook IR knew the
  # shape) but could not query — invoking the runtime with a
  # state attribute returned UnknownCommand. Reading state from
  # the CLI required hand-decompressing the storage file. That
  # was a Sambhogakaya gap : the bluebook implied the access, the
  # runtime didn't render it.
  #
  # Read closes the gap for raw attribute access. Parse the
  # four-segment path "app::domain::Aggregate::attribute" into
  # its components, locate the aggregate's record in the
  # configured storage adapter, project the latest record's
  # named attribute, emit ValueRead with the flattened value as
  # payload. Path-not-found surfaces as a runtime error before
  # the command runs.
  #
  # Named queries (computed views declared inside an aggregate's
  # bluebook alongside its commands) share the same four-segment
  # phrase shape and dispatch through Lexicon like everything
  # else. The convention : fourth segment is PascalCase for
  # commands, lowercase for queries — so
  # "bin-buddy::notifications::Notifications::SendEmail" is a
  # command and "bin-buddy::notifications::Notifications::recent_sends"
  # is a query. A Run command (filed for the next iteration of
  # this bluebook) invokes named queries by phrase the way
  # Dispatch.Route invokes commands.
  #
  # Companion to dispatch.bluebook (the write side) and
  # lexicon.bluebook (resolves what's available — and indexes
  # both commands and queries). See i528 for the full storehouse
  # arc and the four-segment convention.

  aggregate "Query", "Singleton read bus over the conception" do
    identified_by ServiceName

    value_object "ServiceName" do
      attribute :value, String
      rule "must be the singleton 'query'" do
        requires { value == "query" }
      end
    end

    value_object "Path" do
      # The four-segment form a caller types :
      # "app::domain::Aggregate::attribute". Same shape as
      # Dispatch.Phrase, but the fourth segment names an attribute
      # rather than a command. The same shape also serves named
      # queries (Run, future) where the fourth segment is a query
      # name. Deeper nesting for sub-attribute access (e.g.
      # positional indexing like LucidDream::observations[-1]) is
      # not in this first chapter ; filed for a later iteration.
      attribute :value, String
      rule "must be app::domain::Aggregate::attribute (4 non-empty segments)" do
        requires { value.split("::").length == 4 && value.split("::").all? { |s| s.length > 0 } }
      end
    end

    value_object "Value" do
      # The projected attribute value, flattened to its string form
      # for the event payload. Callers reparse if they need a
      # specific shape (number, boolean, JSON). A future iteration
      # carries the type tag alongside the value so the caller
      # doesn't guess.
      attribute :value, String
    end

    attribute ServiceName

    # ── Commands ───────────────────────────────────────────────

    command "Read" do
      role "Caller"
      description "Parse the four-segment path (app::domain::Aggregate::attribute), locate the aggregate's record in the configured storage adapter, read the latest record's named attribute, emit ValueRead with the flattened value as payload. Path-not-found surfaces as a runtime error before the command runs. For named queries (computed views), see Run (next iteration of this bluebook)."
      attribute Path, as: :path
      emits "ValueRead"
    end
  end
end
