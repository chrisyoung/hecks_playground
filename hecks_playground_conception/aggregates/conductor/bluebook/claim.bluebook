Hecks.bluebook "Conductor", version: "2026.06.02.2" do
  vision "The Conductor domain : workforce orchestration. The Claim aggregate is the atomic hold — the mutex that serialises story assignment. One Claim per story, identified by the story identity. Belongs to a Worker."
  category "framework"

  aggregate "Claim" do
    description "The atomic hold on a story — the structural mutex. Identified by the story it guards. At most one Claim may be in state=held per story (invariant). Belongs to the Worker that holds it."
    identified_by :story

    attribute :story,       Story
    attribute :state,       State,      default: { value: "open" }
    attribute :claimed_at,  ClaimedAt

    reference_to Worker

    value_object "Story" do
      attribute :value, String
    end

    value_object "State" do
      # open | held | released | expired (default open ; Acquire sets held)
      attribute :value, String
    end

    value_object "ClaimedAt" do
      attribute :value, String
    end

    command "Acquire" do
      role "System"
      goal "Acquire a claim on a story for a worker. Acquires only when the story has no active (held) claim - the structural mutex refusing a second concurrent acquire. Creates the record in state=held and stores the Worker foreign key (references-not-ids : the synthesised belongs_to Worker FK is now live)."
      attribute :story,       Story
      attribute :worker,      Worker
      attribute :claimed_at,  ClaimedAt
      given("the story has no active (held) claim - the structural mutex") { state != "held" }
      sets :story
      sets :worker
      sets :state,      to: "held"
      sets :claimed_at
      emits "ClaimAcquired"
    end

    command "Release" do
      role "System"
      goal "Release the hold on this claim. Transitions state to released."
      reference_to(Claim)
      sets :state, to: "released"
      emits "ClaimReleased"
    end

    command "Expire" do
      role "System"
      goal "Expire a claim that was never released (liveness timeout). Transitions state to expired."
      reference_to(Claim)
      sets :state, to: "expired"
      emits "ClaimExpired"
    end

    # ============================================================
    # QUERIES — fleet observability (conductor-observability card)
    # ============================================================

    query "Active" do
      description "All claims currently held — one per story being worked. SEMANTIC : state == held. Used by (a) the Fleet View (view-1) to derive which story each alive Worker is working on (projection layer joins Worker.Alive against Claim.Active on the stored worker FK — gap : runtime-cross-aggregate-where) ; and (b) the Blocked/DAG View (view-4) to show which claimable stories are already claimed vs. still waiting. The worker annotation on each held claim is a plain stored attribute; cross-aggregate lookup of the Worker’s details is projection-side."
      where state: "held"
    end

    query "HeldByWorker" do
      description "All HELD claims held by a given worker. SEMANTIC : worker == :worker AND state == held. The driving read for SEAM 3 (worker-died reclaim) : when a Worker dies, the ReclaimOnWorkerDied driven adapter sweeps this query (where worker == the dead worker_id) and fires Claim.Expire once per matching held claim. Now that belongs_to Worker synthesises a STORED worker FK (references-not-ids), the worker filter is a plain same-aggregate where — no cross-aggregate join needed."
      # Plain-scalar query param, not `reference_to Worker` -- the latter
      # hit a cross-file resolution-order issue (claim.bluebook loads
      # alphabetically before worker.bluebook within the same multi-file
      # Conductor domain; MetaValidator ran before Worker existed yet).
      # Flagged for review, not silently worked around: the underlying
      # multi-file same-domain load-order dependency is a real finding for
      # the migration plan, not specific to this one query.
      attribute :worker, String
      where worker: :worker
      where state: "held"
    end
  end
end
