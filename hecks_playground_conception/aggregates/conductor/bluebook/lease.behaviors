Hecks.behaviors "Conductor" do
  vision "Lease behaviors — Grant / Renew / Expire / Reclaim / query:Active / query:Expired / query:HeldByWorker. Grant now stores the Story + Worker FKs (references-not-ids)."

  test "Grant creates an active lease" do
    tests "Grant", on: "Lease"
    setup  "Conductor::Worker.Register", worker_id: "w1", stale_after: 4102444800
    input  worktree_path: "p1", story: "s1", worker: "w1", expires_at: 0
    expect worktree_path: "p1", state: "active"
  end

  test "Grant stores the story and worker foreign keys" do
    tests "Grant", on: "Lease"
    setup  "Conductor::Worker.Register", worker_id: "w1", stale_after: 4102444800
    input  worktree_path: "p1b", story: "s1", worker: "w1", expires_at: 0
    expect worktree_path: "p1b", story: "s1", worker: "w1"
  end

  test "Renew extends expires_at" do
    tests "Renew", on: "Lease"
    setup  "Conductor::Worker.Register", worker_id: "w1", stale_after: 4102444800
    setup  "Grant", worktree_path: "p2", story: "s1", worker: "w1", expires_at: 0
    input  worktree_path: "p2", expires_at: 9
    expect expires_at: 9
  end

  test "Lease Expire moves an active lease to expired" do
    tests "Expire", on: "Lease"
    setup  "Conductor::Worker.Register", worker_id: "w1", stale_after: 4102444800
    setup  "Grant", worktree_path: "p3", story: "s1", worker: "w1", expires_at: 0
    input  worktree_path: "p3"
    expect state: "expired"
  end

  test "Reclaim returns the path to the pool" do
    tests "Reclaim", on: "Lease"
    setup  "Conductor::Worker.Register", worker_id: "w1", stale_after: 4102444800
    setup  "Grant", worktree_path: "p4", story: "s1", worker: "w1", expires_at: 0
    input  worktree_path: "p4"
    expect state: "reclaimed"
  end

  # Active query : runtime enforces state == "active" ; cross-aggregate join
  # (worker + story details) and lease-age computation are projection-side
  # (gap : runtime-cross-aggregate-where). Tests verify the state filter.

  test "Active includes a granted (active) lease" do
    tests "Active", on: "Lease", kind: :query
    setup  "Conductor::Worker.Register", worker_id: "w1", stale_after: 4102444800
    setup  "Grant", worktree_path: "p5", story: "s1", worker: "w1", expires_at: 0
    expect includes: { worktree_path: "p5", state: "active" }
  end

  test "Active excludes a reclaimed lease" do
    tests "Active", on: "Lease", kind: :query
    setup  "Conductor::Worker.Register", worker_id: "w1", stale_after: 4102444800
    setup  "Grant",   worktree_path: "p6", story: "s1", worker: "w1", expires_at: 0
    setup  "Reclaim", worktree_path: "p6"
    expect count: 0
  end

  test "Active excludes an expired lease" do
    tests "Active", on: "Lease", kind: :query
    setup  "Conductor::Worker.Register", worker_id: "w1", stale_after: 4102444800
    setup  "Grant",  worktree_path: "p7", story: "s1", worker: "w1", expires_at: 0
    setup  "Expire", worktree_path: "p7"
    expect count: 0
  end

  # Expired query : runtime enforces state == "expired" ; stuck-view uses this
  # to identify abandoned worktrees. Poison-mailbox detection is via
  # "storehouse mailboxes poisoned" (not a query here).

  test "Expired includes a lease that has timed out" do
    tests "Expired", on: "Lease", kind: :query
    setup  "Conductor::Worker.Register", worker_id: "w1", stale_after: 4102444800
    setup  "Grant",  worktree_path: "p8", story: "s1", worker: "w1", expires_at: 0
    setup  "Expire", worktree_path: "p8"
    expect includes: { worktree_path: "p8", state: "expired" }
  end

  test "Expired excludes an active lease" do
    tests "Expired", on: "Lease", kind: :query
    setup  "Conductor::Worker.Register", worker_id: "w1", stale_after: 4102444800
    setup  "Grant", worktree_path: "p9", story: "s1", worker: "w1", expires_at: 0
    expect count: 0
  end

  test "Expired excludes a reclaimed lease" do
    tests "Expired", on: "Lease", kind: :query
    setup  "Conductor::Worker.Register", worker_id: "w1", stale_after: 4102444800
    setup  "Grant",   worktree_path: "p10", story: "s1", worker: "w1", expires_at: 0
    setup  "Reclaim", worktree_path: "p10"
    expect count: 0
  end

  # HeldByWorker query : runtime enforces worker == :worker AND state == active.
  # The driving read for SEAM 3 worker-died reclaim. Now a plain same-aggregate
  # where on the stored worker FK (references-not-ids).

  test "HeldByWorker includes an active lease held by that worker" do
    tests "HeldByWorker", on: "Lease", kind: :query
    setup  "Conductor::Worker.Register", worker_id: "w1", stale_after: 4102444800
    setup  "Grant", worktree_path: "p11", story: "s1", worker: "w1", expires_at: 0
    input  worker: "w1"
    expect includes: { worktree_path: "p11", worker: "w1", state: "active" }
  end

  test "HeldByWorker excludes a lease held by a different worker" do
    tests "HeldByWorker", on: "Lease", kind: :query
    setup  "Conductor::Worker.Register", worker_id: "w2", stale_after: 4102444800
    setup  "Conductor::Worker.Register", worker_id: "w1", stale_after: 4102444800
    setup  "Grant", worktree_path: "p12", story: "s1", worker: "w2", expires_at: 0
    input  worker: "w1"
    expect count: 0
  end

  test "HeldByWorker excludes a reclaimed lease for that worker" do
    tests "HeldByWorker", on: "Lease", kind: :query
    setup  "Conductor::Worker.Register", worker_id: "w1", stale_after: 4102444800
    setup  "Grant",   worktree_path: "p13", story: "s1", worker: "w1", expires_at: 0
    setup  "Reclaim", worktree_path: "p13"
    input  worker: "w1"
    expect count: 0
  end

  # PastTtl query (the lease-TTL clock consumer) : runtime enforces
  # state == active AND expires_at < :now. expires_at and :now are Unix epoch seconds, so :now is a
  # plain literal here ; in production the {now} clock primitive fills it. The expiry sweep fans Lease.Expire over this.

  test "PastTtl includes an active lease whose TTL has elapsed" do
    tests "PastTtl", on: "Lease", kind: :query
    setup  "Conductor::Worker.Register", worker_id: "w1", stale_after: 4102444800
    setup  "Grant", worktree_path: "pttl1", story: "s1", worker: "w1", expires_at: 1767225600
    input  now: 1780272000
    expect includes: { worktree_path: "pttl1", state: "active" }
  end

  test "PastTtl excludes an active lease whose TTL is still in the future" do
    tests "PastTtl", on: "Lease", kind: :query
    setup  "Conductor::Worker.Register", worker_id: "w1", stale_after: 4102444800
    setup  "Grant", worktree_path: "pttl2", story: "s1", worker: "w1", expires_at: 1798761600
    input  now: 1780272000
    expect count: 0
  end

  test "PastTtl excludes an already-expired lease even past its TTL" do
    tests "PastTtl", on: "Lease", kind: :query
    setup  "Conductor::Worker.Register", worker_id: "w1", stale_after: 4102444800
    setup  "Grant",  worktree_path: "pttl3", story: "s1", worker: "w1", expires_at: 1767225600
    setup  "Expire", worktree_path: "pttl3"
    input  now: 1780272000
    expect count: 0
  end
end
