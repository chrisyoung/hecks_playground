Hecks.bluebook "Conductor", version: "2026.06.02.2" do
  vision "The Conductor domain : workforce orchestration. The Lease aggregate is the worktree allocation — one Lease per worktree path. A Worker holds a Lease on a path for the duration of a Story. Belongs to a Story and a Worker."

  aggregate "Lease" do
    description "A worktree allocation. Identified by worktree_path — at most one active Lease per path (invariant). Belongs to the Story being worked and the Worker holding it. Carries an expiry timestamp and a lifecycle state."
    identified_by :worktree_path

    attribute :worktree_path,  WorktreePath
    attribute :expires_at,     ExpiresAt
    attribute :state,          State,        default: { value: "active" }

    # Migration plan task 4: was `belongs_to Story` -- a STRUCTURAL cross-
    # aggregate reference, but "Story" is not an aggregate in the
    # Conductor domain (has_many/has_one/belongs_to/reference_to only
    # ever resolve WITHIN the declaring aggregate's own domain -- see
    # merge_queue.bluebook's own comment on the same finding). Sibling
    # aggregate `Claim` (claim.bluebook, same Conductor domain) already
    # carries Story cross-domain correctly -- a plain VO-wrapped identity
    # string, never a structural reference -- and this file's own `Grant`
    # command already writes `story` that same way
    # (`attribute :story, Story` / `then_set :story, to: :story`). Only
    # the aggregate-level declaration was still the old structural form.
    attribute :story, Story
    reference_to Worker

    value_object "Story" do
      attribute :value, String
    end

    value_object "WorktreePath" do
      attribute :value, String
    end

    value_object "ExpiresAt" do
      # Migration plan task 4: was an ISO-8601 UTC string -- see
      # worker.bluebook's StaleAfter, the same fix for the same reason
      # (hecksagain refuses an ordered where-clause comparator on
      # anything but a numeric field). Unix epoch seconds instead.
      attribute :value, Integer
    end

    value_object "State" do
      # active | expired | reclaimed
      attribute :value, String
    end

    command "Grant" do
      role "System"
      goal "Grant a lease on a worktree path to a worker for a story. Creates the record in state=active and stores the Story + Worker foreign keys (references-not-ids : the synthesised belongs_to FKs are now live)."
      attribute :worktree_path,  WorktreePath
      attribute :story,          Story
      attribute :worker,         Worker
      attribute :expires_at,     ExpiresAt
      sets :worktree_path
      sets :story
      sets :worker
      sets :expires_at
      sets :state,          to: "active"
      emits "LeaseGranted"
    end

    command "Renew" do
      role "System"
      goal "Extend the lease expiry. The lease stays active."
      reference_to(Lease)
      attribute :expires_at, ExpiresAt
      sets :expires_at
      emits "LeaseRenewed"
    end

    command "Expire" do
      role "System"
      goal "Mark the lease as expired — TTL reached without renewal."
      reference_to(Lease)
      sets :state, to: "expired"
      emits "LeaseExpired"
    end

    command "Reclaim" do
      role "System"
      goal "Reclaim the worktree path — story done or worker dead. Returns the path to the pool."
      reference_to(Lease)
      sets :state, to: "reclaimed"
      emits "LeaseReclaimed"
    end

    # ============================================================
    # QUERIES — fleet observability (conductor-observability card)
    # ============================================================

    query "Active" do
      description "All leases currently active — one per checked-out worktree path. SEMANTIC : state == active. Used by the Fleet View (view-1) to show which worktree each worker holds ; the projection layer joins Lease.Active against Worker.Alive on the stored worker FK to annotate each alive worker with their path and lease age (time since the lease was granted, computed from expires_at and the renewal window — gap : runtime-cross-aggregate-where for the join ; time-threshold arithmetic is projection-side). Also feeds the Stuck View (view-5) to distinguish an active-but-long-running lease from a fully expired one."
      where state: "active"
    end

    query "Expired" do
      description "All leases that have expired without being reclaimed. SEMANTIC : state == expired. Used by the Stuck View (view-5) as the primary signal for a stuck worker : an expired lease means the worktree path has not been returned to the pool and the owning worker has likely timed out. The expiry cause (TTL-elapsed vs. worker-dead) is recorded on the LeaseExpired event payload ; distinguishing them in the view is projection-side. Poisoned mailbox detection for the same worker reads via the existing \"storehouse mailboxes\" surface (\"storehouse mailboxes poisoned\") — not a new query here (gap : system-prompt-render-adapter, CLI follow-up)."
      where state: "expired"
    end

    query "HeldByWorker" do
      description "All ACTIVE leases held by a given worker. SEMANTIC : worker == :worker AND state == active. The driving read for SEAM 3 (worker-died reclaim) : when a Worker dies, the ReclaimOnWorkerDied driven adapter sweeps this query (where worker == the dead worker_id) and fires Lease.Reclaim once per matching active lease. Now that belongs_to Worker synthesises a STORED worker FK (references-not-ids), the worker filter is a plain same-aggregate where — no cross-aggregate join needed."
      attribute :worker, Worker
      where worker: :worker
      where state: "active"
    end

    query "PastTtl" do
      description "All ACTIVE leases whose TTL has elapsed — orphaned worktrees to reclaim. SEMANTIC : state == active AND expires_at < :now. The driving read for the expiry sweep : a cadence Tick fans Conductor::Lease.Expire out over this query, passing now: as an ordinary ask-time parameter (see Worker.Stale's own comment — the '{now} clock primitive' predates hecksagain and never had a real magic-injection mechanism; an explicit parameter is the honest equivalent), which cascades through ReclaimOnExpire to reclaim each worktree path and return it to the pool — independent of worker liveness (a lease can outlive its TTL even while its worker still heartbeats ; the worker-death side is Worker.Stale). expires_at is now Unix epoch seconds (see ExpiresAt's own comment), so the lt comparison is a plain numeric compare. Twin of Worker.Stale on the lease-TTL side of the same clock-driven reclaim."
      attribute :now, ExpiresAt
      where state: "active"
      where expires_at: { lt: :now }
    end
  end
end
