Hecks.bluebook "Conductor", version: "2026.06.02.2" do
  vision "The Conductor domain : workforce orchestration. Workers are fleet members that claim stories, hold worktrees, and push work through the merge queue. This file defines the Worker aggregate — the named, living unit of execution that registers, sends heartbeats, and eventually dies."
  category "framework"

  aggregate "Worker" do
    description "A named, living execution unit. Registers to the fleet, sends periodic heartbeats, is declared dead on liveness timeout. Its current claim and active worktree are DERIVED via queries on Claim and Lease — not stored back-refs."
    identified_by :worker_id

    attribute :worker_id,     WorkerId
    attribute :status,        Status,      default: { value: "alive" }
    attribute :heartbeat_at,  HeartbeatAt
    # Liveness deadline (the clock). An ISO-8601 UTC instant : while the
    # worker keeps beating, Register/Heartbeat push stale_after forward
    # (`{now+threshold}`). A crashed worker stops beating, so stale_after
    # stops advancing and eventually falls behind `now` — that is what the
    # Stale query detects and the sweep reclaims.
    attribute :stale_after,   StaleAfter

    value_object "WorkerId" do
      attribute :value, String
    end

    value_object "Status" do
      # alive | dead
      attribute :value, String
    end

    value_object "HeartbeatAt" do
      attribute :value, String
    end

    value_object "StaleAfter" do
      # Migration plan task 4: was an ISO-8601 UTC string ("sorts
      # chronologically, so stale_after < now is a plain lexical
      # comparison") -- correct under the old runtime, but hecksagain's
      # meta-validator refuses an ordered (lt/gt) where-clause comparator
      # on anything but a numeric field categorically ("over anything
      # else the adapters answer differently or not at all" -- a real,
      # deliberate cross-adapter-consistency principle, not a bug to
      # route around). Unix epoch seconds instead : still sorts
      # chronologically, now genuinely numeric under every adapter.
      attribute :value, Integer
    end

    command "Register" do
      role "System"
      goal "Register a new worker in the fleet. Creates the record with status=alive and stamps the initial liveness deadline (stale_after = {now+threshold} supplied by the caller / cadence)."
      attribute :worker_id,   WorkerId
      attribute :stale_after, StaleAfter
      sets :worker_id
      sets :status,       to: "alive"
      sets :stale_after
      emits "WorkerRegistered"
    end

    command "Heartbeat" do
      role "System"
      goal "Record a heartbeat from the worker, stamping heartbeat_at AND pushing the liveness deadline forward (stale_after = {now+threshold}). Heartbeat-as-liveness : a live worker keeps advancing stale_after ; a crashed one stops, so the Stale query eventually catches it."
      reference_to(Worker)
      attribute :heartbeat_at, HeartbeatAt
      attribute :stale_after,  StaleAfter
      sets :heartbeat_at
      sets :stale_after
      emits "WorkerHeartbeat"
    end

    command "MarkDead" do
      role "System"
      goal "Mark the worker as dead — liveness timeout or explicit deregistration."
      reference_to(Worker)
      sets :status, to: "dead"
      emits "WorkerDied"
    end

    # ============================================================
    # QUERIES — fleet observability (conductor-observability card)
    # ============================================================

    query "Alive" do
      description "All workers currently alive in the fleet. SEMANTIC : status == alive. Used by the Fleet View (view-1) to enumerate active workers. The current-claim (story) and active-worktree (lease) for each alive worker are DERIVED by joining against Claim.Active and Lease.Active in the projection layer — cross-aggregate field access is not yet supported in queries (gap : runtime-cross-aggregate-where). Heartbeat staleness (time since heartbeat_at) is a projection-side computation; the runtime expresses no time-threshold filter today."
      where status: "alive"
    end

    query "Dead" do
      description "All workers that have been declared dead. SEMANTIC : status == dead. Used by the Fleet View (view-1) dead-workers panel and as a complement to Alive for fleet-size accounting. Current-claim and lease derivation apply the same projection-side join as Alive."
      where status: "dead"
    end

    query "Stale" do
      description "All ALIVE workers whose liveness deadline has elapsed. SEMANTIC : status == alive AND stale_after < :now. The driving read for the liveness sweep : a cadence Tick fans Worker.MarkDead out over this query, passing now: as an ordinary ask-time parameter (the caller's own current epoch — the '{now} clock primitive' language predates hecksagain and never had a real magic-injection mechanism even under the old runtime; an explicitly-declared parameter is the honest equivalent, matching how every other query in this corpus already takes its ask-time inputs), which cascades through worker_died_reclaim to reclaim the dead worker's lease and expire its claim — returning the story to the pool. stale_after is now Unix epoch seconds (see StaleAfter's own comment), so the lt comparison is a plain numeric compare."
      attribute :now, StaleAfter
      where status: "alive"
      where stale_after: { lt: :now }
    end
  end
end
