# Driving/driven adapter declarations moved out of worktree_create.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word and no success/failure
# routing on spawned_by binds. Kept verbatim as the spec for an upstream hecks
# feature. Nothing loads this file.

# spawned_by success/failure routing (the bare bind stays in the .hecksagon):
  Conductor::Lease.spawned_by("WorktreeCreate", on: "LeaseGranted") do
    success "Cascade::Cascade.RecordResult"
    failure "Cascade::Cascade.RecordResult"
  end
