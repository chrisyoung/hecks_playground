# Driving/driven adapter declarations moved out of claim_next_on_claim_released.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word (no interval/cron
# drivers, no `driven on` reactions). Kept verbatim as the spec for an
# upstream hecks feature. Nothing loads this file.

  adapter "ClaimNextOnClaimReleased" do
    driven on "Conductor::Claim.ClaimReleased" do |event|
      dispatch "Conductor::Claim.Acquire", for_each: { from: "Plan::Story.NextClaimable", where: {} }, with: { story: "{ref}", worker: "{worker}", claimed_at: "{now}" }
    end
  end
