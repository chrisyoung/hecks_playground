# Driving/driven adapter declarations moved out of claim_next_on_worker_registered.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word (no interval/cron
# drivers, no `driven on` reactions). Kept verbatim as the spec for an
# upstream hecks feature. Nothing loads this file.

  adapter "ClaimNextOnWorkerRegistered" do
    driven on "Conductor::Worker.WorkerRegistered" do |event|
      dispatch "Conductor::Claim.Acquire", for_each: { from: "Plan::Story.NextClaimable", where: {} }, with: { story: "{ref}", worker: "{worker_id}", claimed_at: "{now}" }
    end
  end
