# Driving/driven adapter declarations moved out of liveness_sweep.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word (no interval/cron
# drivers, no `driven on` reactions). Kept verbatim as the spec for an
# upstream hecks feature. Nothing loads this file.

  adapter "LivenessSweep" do
    driven on "Conductor::Sweeper.Ticked" do |event|
      dispatch "Conductor::Worker.MarkDead", for_each: { from: "Conductor::Worker.Stale", where: { now: "{now}" } }, with: { id: "{worker_id}" }
    end
  end
