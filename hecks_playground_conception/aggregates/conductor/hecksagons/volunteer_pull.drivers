# Driving/driven adapter declarations moved out of volunteer_pull.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word (no interval/cron
# drivers, no `driven on` reactions). Kept verbatim as the spec for an
# upstream hecks feature. Nothing loads this file.

  adapter "StartOnClaimAcquired" do
    driven on "Conductor::Claim.ClaimAcquired" do |event|
      dispatch "Plan::Story.Start", with: { story: "{story}", worker: "{worker}" }
    end
  end

  adapter "GrantOnStoryStarted" do
    driven on "Plan::Story.StoryStarted" do |event|
      # expires_at "{now+3600}" -- clock-arithmetic interpolation, already
      # flagged by this file's own comment as "not faked" (i.e. not real
      # yet) -- interpolate_args only resolves bare {word} tokens, so this
      # value passes through as literal text until that lands. Not this
      # fix's scope ; the with: wrap alone gets the file parsing again.
      dispatch "Conductor::Lease.Grant", with: { worktree_path: "worktrees/{story}", story: "{story}", worker: "{worker}", expires_at: "{now+3600}" }
    end
  end
