# Driving/driven adapter declarations moved out of worker_died_reclaim.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word (no interval/cron
# drivers, no `driven on` reactions). Kept verbatim as the spec for an
# upstream hecks feature. Nothing loads this file.

  adapter "ReclaimOnWorkerDied" do
    driven on "Conductor::Worker.WorkerDied" do |event|
      dispatch "Conductor::Lease.Reclaim", for_each: { from: "Conductor::Lease.HeldByWorker", where: { worker: "{id}" } }, with: { id: "{worktree_path}" }
      dispatch "Conductor::Claim.Expire", for_each: { from: "Conductor::Claim.HeldByWorker", where: { worker: "{id}" } }, with: { id: "{story}" }
    end
  end
