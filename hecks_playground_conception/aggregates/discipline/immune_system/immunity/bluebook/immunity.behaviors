Hecks.behaviors "Immunity" do
  vision "Behavioral tests for the Immunity aggregate — threat detection, antibodies, neutralization."

  # ── Immunity aggregate ──────────────────────────────────────────
  # (merged from body.behaviors during i112 cleanup)

  test "DetectThreat sets threat_pattern" do
    tests "DetectThreat", on: "Immunity"
    input  name: { value: "immunity" }, threat_pattern: "sample"
    expect ok: "true"
  end

  # NOTE : the "DetectThreat cascades through policy chain"
  # :cross_cascade test was removed 2026-05-17. Its only cross-leg
  # was into Mood (expected "Focused") — Miette's body, moved to the
  # chrisyoung/miette repo by i117 Round 4 (6b081837). DetectThreat
  # now emits only "ThreatDetected", already covered by "DetectThreat
  # sets threat_pattern" above. i117 Round 4 residue (cf i158/i159). i642.

  test "GraftVerbImmunity sets noun_suffixes + adjective_suffixes + dual_words" do
    tests "GraftVerbImmunity", on: "Immunity"
    setup  "DetectThreat", name: { value: "immunity" }, threat_pattern: "sample"
    input  immunity: "immunity", noun_suffixes: [{ value: "sample" }], adjective_suffixes: [{ value: "sample" }], dual_words: [{ value: "sample" }]
    expect noun_suffixes: ["sample"], adjective_suffixes: ["sample"], dual_words: ["sample"]
  end

  test "GenerateAntibody sets pattern + learned_from" do
    tests "GenerateAntibody", on: "Immunity"
    setup  "DetectThreat", name: { value: "immunity" }, threat_pattern: "sample"
    input  immunity: "immunity", pattern: "sample", learned_from: "sample"
    expect antibodies: [{ pattern: "sample", learned_from: "sample", strength: 1 }]
  end

  test "StrengthenAntibody sets pattern" do
    tests "StrengthenAntibody", on: "Immunity"
    setup  "DetectThreat", name: { value: "immunity" }, threat_pattern: "sample"
    input  immunity: "immunity", pattern: "sample"
    expect ok: "true"
  end

  test "Neutralize runs" do
    tests "Neutralize", on: "Immunity"
    setup  "DetectThreat", name: { value: "immunity" }, threat_pattern: "sample"
    input  immunity: "immunity", pattern: "sample", learned_from: "sample"
    expect ok: "true"
  end

  test "Neutralize cascades through policy chain" do
    tests "Neutralize", on: "Immunity", kind: :cascade
    setup  "DetectThreat", name: { value: "immunity" }, threat_pattern: "sample"
    input  immunity: "immunity", pattern: "sample", learned_from: "sample"
    expect emits: ["ThreatNeutralized", "AntibodyGenerated"]
  end
end
