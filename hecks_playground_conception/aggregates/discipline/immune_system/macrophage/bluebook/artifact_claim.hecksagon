Hecks.hecksagon "ArtifactClaim" do
  uses_framework "Governance"
  ArtifactClaim::ArtifactClaim.persisted_by("Heki")
  ArtifactClaim::NoPromisesSweep.persisted_by("Heki")

  # Impure edges, hecksagon-first : the no-promises sweep's scan + verify leaves.
  # Re-expressed (i780, 2026-08-17) from the retired `adapter :exec` kwargs
  # form onto the spawn effect port.
  ArtifactClaim::NoPromisesSweep.spawned_by("ArtifactClaimScan", on: "ScanRequested")
  ArtifactClaim::NoPromisesSweep.spawned_by("ArtifactClaimVerify", on: "VerifyRequested")
end
