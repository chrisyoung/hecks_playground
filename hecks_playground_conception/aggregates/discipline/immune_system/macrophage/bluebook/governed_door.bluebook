Hecks.bluebook "Macrophage", version: "2026.06.26.2" do
  # ============================================================
  # GOVERNED DOOR — one macrophage, one rule
  # ============================================================
  #
  # The per-rule macrophage sibling for the governed-door barrier — the
  # structural channel rule. Added to the Macrophage domain in its OWN file
  # (the domain spans many files, like Conductor / Inbox / Corpus), so it is
  # addressed Macrophage::GovernedDoor — one more sibling beside FixturesRuntime,
  # BluebookFirst, Warnings. It inherits the Macrophage hexagon's `adapter :heki`,
  # so no separate hecksagon is needed.
  #
  # WHY THIS RULE EXISTS : a native harness tool (Bash, Edit, Write, Read, Grep,
  # Glob, MultiEdit, NotebookEdit, WebFetch, WebSearch) emits NO bus event, so an
  # act made through it is ungoverned — invisible to the dispatch log, outside
  # the Transparency vow. Each such tool has a storehouse-door equivalent
  # (Tools::ShellTool.Bash, Tools::FileTool.Edit / Write / Read,
  # Tools::SearchTool.Grep / Glob, Tools::WebTool.WebFetch / WebSearch). The
  # PreToolUse hook hard-blocks the native tool and redirects the caller to the
  # door. Control-plane tools (Agent, Task*, AskUserQuestion, ToolSearch) and
  # mcp__storehouse__* are NOT governed here — they orchestrate, they do not act
  # on the world.
  #
  # THE ESCAPE (operational, out-of-band) : `miette --ungoverned` exports
  # HECKS_PLAYGROUND_GOVERNANCE_OFF=1 for door-down recovery and upgrades. Every governance
  # HOOK honors it and exits 0 (governed-door-hook, governed-door-complain,
  # macrophage-hook). The one piece that cannot read an env var is the STATIC
  # permissions.deny list in the being's settings file — so the launcher strips
  # exactly that key (`jq 'del(.permissions.deny)'`) and loads the rest.
  # UNGOVERNED DROPS GOVERNANCE, NEVER THE BODY. Measured 2026-08-12, per key :
  # the DOOR survives either shape (enableAllProjectMcpServers is declared in
  # BOTH the being's settings and ~/.claude/settings.json, so the project MCP
  # server comes up regardless) — the prior ungoverned session did reach the
  # door, which is how the adapter drop was found at all. What dropping the
  # whole file actually amputated is everything declared ONLY in the being's
  # file : the UserPromptSubmit wake surface, the statusline, the Stop hook,
  # SubagentStart, advisorModel and the plugins. The SessionStart boot pipeline
  # half-survives (the project's settings.local.json carries its own). Real
  # losses, but not the door — say the true one. The door remains the PREFERRED
  # route when ungoverned ; native tools are a fallback for when it is broken,
  # and the Transparency vow still binds every native act. There is no in-band
  # allowlist : the governed agent cannot disable its own governance mid-session.
  #
  # ONE AGGREGATE, TWO FACETS, REFERENCING PIZZAS :
  #   THE MAP — projected, not stored. LookupDoor scans the command IR for the
  #     door whose `redirects_native` contains the queried tool and derives
  #     door_args from that command's attributes. No Register, no seeded rows,
  #     no .fixtures — structure from the model, config never seeded at boot.
  #   THE AUDIT — per-record. Each blocked attempt is ONE immutable record
  #     (identified_by :id), modeled the Pizzas Order way : a Record command and
  #     queries (ListAll / ByTool), NOT an ever-growing collection on a singleton
  #     (Pizzas only appends to BOUNDED lists like toppings). "How many denials",
  #     "by tool", "the latest" are QUERIES over the records, never stored derived
  #     state — mirroring Order.Pending. This rehomes the old Governance::Violation
  #     into the macrophage that owns the governed-door rule.

  aggregate "GovernedDoor" do
    description "The governed-door rule : the native->door map (PROJECTED from the command IR via LookupDoor, no stored rows) AND the per-record audit of blocked native-tool attempts (one immutable record per denial). The bluebook of record for what the governed-door hooks redirect to and log."
    identified_by :id

    # One record per blocked attempt — the denial audit (Pizzas Order shape).
    attribute :id,          Id
    attribute :tool_name,   ToolName
    attribute :door,        DoorPhrase
    attribute :reason,      Reason
    attribute :occurred_at, OccurredAt

    value_object "Id" do
      # "<tool>-<iso8601>" — unique per blocked attempt.
      attribute :value, String
    end

    value_object "ToolName" do
      # The native harness tool name that was blocked (e.g. "Bash", "Edit").
      attribute :value, String
    end

    value_object "DoorPhrase" do
      # The storehouse-door command the caller was redirected to — the door
      # LookupDoor projected for this tool (e.g. "Tools::ShellTool.Bash").
      attribute :value, String
    end

    value_object "Reason" do
      # Why it was denied — "native <tool> makes no bus event".
      attribute :value, String
    end

    value_object "OccurredAt" do
      attribute :iso8601, String
    end

    # ── THE AUDIT : one record per denial ──

    command "Record" do
      role "Hook"
      goal "Record that a denied native tool call was attempted. Dispatched by the governed-door hooks (PreToolUse + PostToolUse) when LookupDoor returns a door for the tool. One immutable record per attempt — the audit trail."
      attribute :id,          Id
      attribute :tool_name,   ToolName
      attribute :door,        DoorPhrase
      attribute :reason,      Reason
      attribute :occurred_at, OccurredAt
      sets :id
      sets :tool_name
      sets :door
      sets :reason
      sets :occurred_at
      emits "Recorded"
    end

    query "ListAll" do
      description "Every recorded denial — the full audit trail. The statusline derives the session denial count by counting these rows (mirroring Order.Pending : a read over records, never stored derived state)."
    end

    query "ByTool" do
      attribute :tool_name, ToolName
      description "Every denial recorded for one native tool by name — the per-tool audit."
      where tool_name: :tool_name
    end

    # ── THE MAP : projected from the command IR ──

    query "LookupDoor" do
      description "Look up the storehouse-door equivalent for one native tool by name. PROJECTS the map from the command IR : scans every command for the door whose `redirects_native` list contains the queried tool and returns its fully-qualified door command plus door_args derived from that command's own attributes — there is no stored map, no Register, no fixtures. Returns the door + args when the tool is governed, or empty when it is not (control-plane tools, mcp__storehouse__*). The governed-door hooks call this per dispatch to render the redirect message. A computed meta-query the runtime special-cases — like MatchInput / CausationTrace — because a record-filter `where` cannot iterate the IR's own command structure. It ignores the stored denial records entirely. NOT actually dispatched through hecksagain's ordinary query path (see hecksagain_runtime/lib/hecksagain_runtime/governed_door.rb's hand-written Ruby escape hatch) -- this declaration exists so LookupDoor still appears in catalog/describe output for humans and tooling, and so it satisfies hecksagain's structural query validation."
      attribute :tool, ToolName
      where tool_name: :tool
    end
  end
end
