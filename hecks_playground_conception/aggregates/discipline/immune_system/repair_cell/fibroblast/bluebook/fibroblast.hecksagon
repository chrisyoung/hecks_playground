Hecks.hecksagon "Fibroblast" do
  uses_framework "Governance"
  Fibroblast::Fibroblast.persisted_by("Heki")

  # Impure edge, hecksagon-first : on Sweep (which emits SweepRan), run the
  # repair sweeper and cascade its outcome into RecordResult. Re-expressed
  # (i780, 2026-08-17) from the retired `adapter :exec` kwargs form onto the
  # spawn effect port : the runtime records ONE OutboundEvent per dispatch,
  # bin/adapter-host claims it, runs FibroblastSweep's handler, and
  # dispatches the SAME command back on success or failure — :exec never
  # branched, so success == failure == RecordResult expresses that
  # unconditional shape without a new IR field.
  Fibroblast::Fibroblast.spawned_by("FibroblastSweep", on: "SweepRan")
end
