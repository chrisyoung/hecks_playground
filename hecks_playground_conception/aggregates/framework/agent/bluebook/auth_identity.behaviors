Hecks.behaviors "AuthIdentity" do
  vision "Behavioral proof of the authentication primitive (i264). Establish mints a PENDING identity and emits the trigger the verifier Family subscribes to ; MarkVerified / Reject are the adapter's success/failure verdicts (the charged_by shape) ; Retire fails an active identity closed. Active is the in-process read-model the per-dispatch authenticate Gate consults — it lists ONLY verified, non-retired identities, so a pending / rejected / retired principal is never admitted. The impure verification itself (the external check) is the Family's job ; these behaviors pin the DOMAIN lifecycle the Gate depends on."

  # ── Establish : mint a pending identity, trigger verification ──
  test "Establish mints a pending identity" do
    tests "Establish", on: "AuthIdentity"
    input  id: "sess-1", label: "Chris laptop", credential: "HECKS_PLAYGROUND_SESSION_TOKEN"
    expect id: "sess-1", status: "pending"
  end

  test "Establish emits Established (the verifier Family's trigger)" do
    tests "Establish", on: "AuthIdentity"
    input  id: "sess-2", label: "daemon", credential: ""
    expect_event "Established"
  end

  # ── MarkVerified : the verifier adapter's APPROVED verdict ──
  test "MarkVerified moves a pending identity to active" do
    tests "MarkVerified", on: "AuthIdentity"
    setup  "Establish", id: "sess-3", label: "Chris laptop", credential: "HECKS_PLAYGROUND_SESSION_TOKEN"
    input  id: "sess-3", verification_ref: "vrf-abc"
    expect status: "active", verification_ref: "vrf-abc"
  end

  # ── Reject : the verifier adapter's DENIED verdict ──
  test "Reject moves a pending identity to rejected" do
    tests "Reject", on: "AuthIdentity"
    setup  "Establish", id: "sess-4", label: "imposter", credential: "HECKS_PLAYGROUND_SESSION_TOKEN"
    input  id: "sess-4", reason: "token signature mismatch"
    expect status: "rejected"
  end

  # ── Active : the in-process read-model the authenticate Gate consults ──
  # Only a VERIFIED (active) identity appears — pending does not, so a
  # principal whose session is mid-verification is not yet admitted.
  test "Active lists a verified identity" do
    tests "Active", on: "AuthIdentity", kind: :query
    setup  "Establish",    id: "sess-5", label: "Chris laptop", credential: "HECKS_PLAYGROUND_SESSION_TOKEN"
    setup  "MarkVerified", id: "sess-5", verification_ref: "vrf-5"
    expect count: 1
  end

  test "Active excludes a still-pending identity" do
    tests "Active", on: "AuthIdentity", kind: :query
    setup  "Establish", id: "sess-6", label: "mid-verify", credential: "HECKS_PLAYGROUND_SESSION_TOKEN"
    expect count: 0
  end

  # ── Retire : fail an active identity closed ──
  test "Retire moves an active identity to retired" do
    tests "Retire", on: "AuthIdentity"
    setup  "Establish",    id: "sess-7", label: "Chris laptop", credential: "HECKS_PLAYGROUND_SESSION_TOKEN"
    setup  "MarkVerified", id: "sess-7", verification_ref: "vrf-7"
    input  id: "sess-7"
    expect status: "retired"
  end

  test "Active excludes a retired identity (fail closed)" do
    tests "Active", on: "AuthIdentity", kind: :query
    setup  "Establish",    id: "sess-8", label: "Chris laptop", credential: "HECKS_PLAYGROUND_SESSION_TOKEN"
    setup  "MarkVerified", id: "sess-8", verification_ref: "vrf-8"
    setup  "Retire",       id: "sess-8"
    expect count: 0
  end
end
