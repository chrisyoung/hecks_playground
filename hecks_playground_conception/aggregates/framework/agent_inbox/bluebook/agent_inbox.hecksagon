Hecks.hecksagon "AgentInbox" do
  uses_framework "Governance"
  # ============================================================
  # AGENT INBOX wiring — the receiver-as-Driver (i708 stigmergy)
  # ============================================================
  #
  # The receiver half of inter-agent messaging, modeled as a DRIVER (the driving
  # side of the hexagon, aggregates/language/grammar/driving.bluebook) : an
  # external clock that reaches IN on a cadence. A Driver is the inverse of a
  # Family — a Family LEAVES the domain (persisted_by, charged_by) ; a Driver
  # reaches IN. The Procfile is the PROJECTION of the declared Driver.
  #
  # Two adapters realize the WARM receiver, replacing the old bin/agent_poll.sh
  # bash loop (which cold-spawned `storehouse` ~30×/min = ~30 Event shards/min) :
  #
  #   InboxPollClock — the CLOCK. `storehouse drive --adapter InboxPollClock`
  #   fires InboxPoller.Poll on its interval ; Poll records last_polled_at +
  #   emits Polled (the freshness signal). ONE sweep-all-inboxes clock, never one
  #   per agent : Drivers are STATIC (declared, projected to the Procfile) while
  #   agents are DYNAMIC — the same reason ProcessMacrophage.Sweep walks the whole
  #   watchlist in one tick.
  #
  #   InboxAutoReply — the FAN-OUT. `driven on Polled`, it sweeps every unread
  #   message (for_each AllUnread) and Replies each in one cascade : the runtime's
  #   per-record fan-out, the same shape as the conductor's LivenessSweep firing
  #   Worker.MarkDead for_each Worker.Stale. The reply is the interim ECHO
  #   ("[agent <id>] received: <body>", record fields interpolated) ; real
  #   intelligent replies are the job of the :llm reply-port adapter — the old
  #   HECKS_PLAYGROUND_AGENT_REPLY_HOOK shell extension point (never set in prod) is dropped.
  #   ONE for_each, collapsing sent -> replied directly : enumeration is a snapshot
  #   (every query is swept before any dispatch executes), so a separate MarkRead
  #   pass would sweep pre-mutation state ; the `read` state was observational only
  #   and no consumer queries it (the sender block-polls Answered = status replied).
  #
  # The whole sweep runs in ONE warm `storehouse drive` process — Poll, Polled,
  # and the per-message Reply cascade all in-process, no per-tick cold spawn.



  # Persistence : :heki, not :memory. The drive process is SEPARATE from the
  # sender's send-message adapter binary. Memory-backing the messages would put
  # each in a throwaway process — the sender's block-poll on Answered would never
  # see the reply. Durable heki is the shared medium that makes the
  # Send -> Poll -> Reply flow function across processes (same reasoning as
  # process_health.hecksagon).

  # Explicit persisted_by, restored (i788/i789/i790) -- bare `adapter
  # :heki` above no longer synthesizes a domain-wide default (see
  # storehouse/bluebook/command_bus.hecksagon's own comment : `adapter`
  # is a real defined method now, not method_missing). Both of this
  # domain's aggregates, explicit, per this comment's own domain-wide
  # intent.
  AgentInbox::AgentMessage.persisted_by("Heki")
  AgentInbox::InboxPoller.persisted_by("Heki")
end
