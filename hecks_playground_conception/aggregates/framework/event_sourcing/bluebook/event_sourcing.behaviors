Hecks.behaviors "EventSourcing" do
  vision "Behavioral proof of the substrate in pure memory — no disk, no runtime. Three things are proven : (1) Append is the one writer and the Log surface (Replay / Since / ForAggregate / ByCorrelation) filters the Event set ; (2) every Event carries causation_id + correlation_id, so the Log is lineage-ready ; (3) Projection.Apply is an HONEST fold — chaining Apply calls DERIVES the view from the deltas (events_applied counts the deltas, view collects the derived rows), and Rebuild empties it for replay. Snapshot.Capture caches a fold at a watermark."

  # ── Event : Append is the one writer ──────────────────────────────────

  test "Append records an immutable event with its sequence" do
    tests "Append", on: "Event"
    input  event_id:       { value: "e1" },
           aggregate_name: { value: "Order" },
           aggregate_id:   { value: "o1" },
           command:        { verb: "HecksPlayground::Catalog::Pizzas::Order.PlaceOrder", inputs: "customer=ada qty=2" },
           delta:          { field: "status", value: "pending" },
           causation_id:   { value: "c0" },
           correlation_id: { value: "flow-1" },
           actor:          { value: "Customer" },
           sequence:       { value: 1 },
           recorded_at:    { value: "2026-06-19T00:00:00Z" },
           event_name: { value: "EventAppended" }, verdict: { allowed: "true", role: "System", policy_id: "" },
           bluebook_version: { value: "1" }, runtime_version: { value: "1" }, prev_hash: { value: "" }, entry_hash: { value: "" }
    expect sequence: { value: 1 }, emits: ["EventAppended"]
  end

  # LINEAGE-READY : every Event carries causation_id + correlation_id.
  test "every Event carries causation_id and correlation_id (lineage-ready)" do
    tests "Append", on: "Event"
    input  event_id:       { value: "e2" },
           aggregate_name: { value: "Order" },
           aggregate_id:   { value: "o1" },
           command:        { verb: "Order.Authorize", inputs: "ref=ch_1" },
           delta:          { field: "status", value: "authorized" },
           causation_id:   { value: "e1" },
           correlation_id: { value: "flow-1" },
           actor:          { value: "System" },
           sequence:       { value: 2 },
           recorded_at:    { value: "2026-06-19T00:00:01Z" },
           event_name: { value: "EventAppended" }, verdict: { allowed: "true", role: "System", policy_id: "" },
           bluebook_version: { value: "1" }, runtime_version: { value: "1" }, prev_hash: { value: "" }, entry_hash: { value: "" }
    expect causation_id: { value: "e1" }, correlation_id: { value: "flow-1" }
  end

  # ── Event : the Log surface filters the Event set ───────────────────────

  test "Replay returns the appended events in the Log" do
    tests "Replay", on: "Event", kind: :query
    setup  "Append", event_id: { value: "e1" }, aggregate_name: { value: "Order" }, aggregate_id: { value: "o1" },
           command: { verb: "HecksPlayground::Catalog::Pizzas::Order.PlaceOrder", inputs: "" }, delta: { field: "status", value: "pending" },
           causation_id: { value: "c0" }, correlation_id: { value: "flow-1" }, actor: { value: "Customer" },
           sequence: { value: 1 }, recorded_at: { value: "t1" },
           event_name: { value: "EventAppended" }, verdict: { allowed: "true", role: "System", policy_id: "" },
           bluebook_version: { value: "1" }, runtime_version: { value: "1" }, prev_hash: { value: "" }, entry_hash: { value: "" }
    setup  "Append", event_id: { value: "e2" }, aggregate_name: { value: "Order" }, aggregate_id: { value: "o1" },
           command: { verb: "Order.Authorize", inputs: "" }, delta: { field: "status", value: "authorized" },
           causation_id: { value: "e1" }, correlation_id: { value: "flow-1" }, actor: { value: "System" },
           sequence: { value: 2 }, recorded_at: { value: "t2" },
           event_name: { value: "EventAppended" }, verdict: { allowed: "true", role: "System", policy_id: "" },
           bluebook_version: { value: "1" }, runtime_version: { value: "1" }, prev_hash: { value: "" }, entry_hash: { value: "" }
    input  aggregate_name: { value: "Order" }
    expect count: 2
  end

  test "ForAggregate returns only one aggregate's events" do
    tests "ForAggregate", on: "Event", kind: :query
    setup  "Append", event_id: { value: "e1" }, aggregate_name: { value: "Order" }, aggregate_id: { value: "o1" },
           command: { verb: "HecksPlayground::Catalog::Pizzas::Order.PlaceOrder", inputs: "" }, delta: { field: "status", value: "pending" },
           causation_id: { value: "c0" }, correlation_id: { value: "flow-1" }, actor: { value: "Customer" },
           sequence: { value: 1 }, recorded_at: { value: "t1" },
           event_name: { value: "EventAppended" }, verdict: { allowed: "true", role: "System", policy_id: "" },
           bluebook_version: { value: "1" }, runtime_version: { value: "1" }, prev_hash: { value: "" }, entry_hash: { value: "" }
    setup  "Append", event_id: { value: "e2" }, aggregate_name: { value: "Order" }, aggregate_id: { value: "o2" },
           command: { verb: "HecksPlayground::Catalog::Pizzas::Order.PlaceOrder", inputs: "" }, delta: { field: "status", value: "pending" },
           causation_id: { value: "c0" }, correlation_id: { value: "flow-2" }, actor: { value: "Customer" },
           sequence: { value: 2 }, recorded_at: { value: "t2" },
           event_name: { value: "EventAppended" }, verdict: { allowed: "true", role: "System", policy_id: "" },
           bluebook_version: { value: "1" }, runtime_version: { value: "1" }, prev_hash: { value: "" }, entry_hash: { value: "" }
    input  aggregate_id: { value: "o1" }
    expect count: 1
  end

  test "ByCorrelation returns one originating flow" do
    tests "ByCorrelation", on: "Event", kind: :query
    setup  "Append", event_id: { value: "e1" }, aggregate_name: { value: "Order" }, aggregate_id: { value: "o1" },
           command: { verb: "HecksPlayground::Catalog::Pizzas::Order.PlaceOrder", inputs: "" }, delta: { field: "status", value: "pending" },
           causation_id: { value: "c0" }, correlation_id: { value: "flow-1" }, actor: { value: "Customer" },
           sequence: { value: 1 }, recorded_at: { value: "t1" },
           event_name: { value: "EventAppended" }, verdict: { allowed: "true", role: "System", policy_id: "" },
           bluebook_version: { value: "1" }, runtime_version: { value: "1" }, prev_hash: { value: "" }, entry_hash: { value: "" }
    setup  "Append", event_id: { value: "e2" }, aggregate_name: { value: "Order" }, aggregate_id: { value: "o2" },
           command: { verb: "HecksPlayground::Catalog::Pizzas::Order.PlaceOrder", inputs: "" }, delta: { field: "status", value: "pending" },
           causation_id: { value: "c0" }, correlation_id: { value: "flow-2" }, actor: { value: "Customer" },
           sequence: { value: 2 }, recorded_at: { value: "t2" },
           event_name: { value: "EventAppended" }, verdict: { allowed: "true", role: "System", policy_id: "" },
           bluebook_version: { value: "1" }, runtime_version: { value: "1" }, prev_hash: { value: "" }, entry_hash: { value: "" }
    input  correlation_id: { value: "flow-1" }
    expect count: 1
  end

  # ORDER / SEQUENCE proof : the Log is keyed by a monotonic sequence, and
  # AtSequence retrieves the event AT a position — so position N selects
  # exactly one of the three ordered appends. (The strictly-after-watermark
  # TAIL scan that Snapshot fall-forward uses is a RANGE query DEFERRED to
  # the runtime phase — where() is equality-only in the corpus today.)
  test "AtSequence selects the event at a sequence position (order proof)" do
    tests "AtSequence", on: "Event", kind: :query
    setup  "Append", event_id: { value: "e1" }, aggregate_name: { value: "Order" }, aggregate_id: { value: "o1" },
           command: { verb: "HecksPlayground::Catalog::Pizzas::Order.PlaceOrder", inputs: "" }, delta: { field: "status", value: "pending" },
           causation_id: { value: "c0" }, correlation_id: { value: "flow-1" }, actor: { value: "Customer" },
           sequence: { value: 1 }, recorded_at: { value: "t1" },
           event_name: { value: "EventAppended" }, verdict: { allowed: "true", role: "System", policy_id: "" },
           bluebook_version: { value: "1" }, runtime_version: { value: "1" }, prev_hash: { value: "" }, entry_hash: { value: "" }
    setup  "Append", event_id: { value: "e2" }, aggregate_name: { value: "Order" }, aggregate_id: { value: "o1" },
           command: { verb: "Order.Authorize", inputs: "" }, delta: { field: "status", value: "authorized" },
           causation_id: { value: "e1" }, correlation_id: { value: "flow-1" }, actor: { value: "System" },
           sequence: { value: 2 }, recorded_at: { value: "t2" },
           event_name: { value: "EventAppended" }, verdict: { allowed: "true", role: "System", policy_id: "" },
           bluebook_version: { value: "1" }, runtime_version: { value: "1" }, prev_hash: { value: "" }, entry_hash: { value: "" }
    setup  "Append", event_id: { value: "e3" }, aggregate_name: { value: "Order" }, aggregate_id: { value: "o1" },
           command: { verb: "Order.Ship", inputs: "" }, delta: { field: "status", value: "shipped" },
           causation_id: { value: "e2" }, correlation_id: { value: "flow-1" }, actor: { value: "System" },
           sequence: { value: 3 }, recorded_at: { value: "t3" },
           event_name: { value: "EventAppended" }, verdict: { allowed: "true", role: "System", policy_id: "" },
           bluebook_version: { value: "1" }, runtime_version: { value: "1" }, prev_hash: { value: "" }, entry_hash: { value: "" }
    input  seq: { value: 2 }
    expect count: 1
  end

  # ── Projection : the HONEST fold derives the view from deltas ──────────────

  test "Apply folds one delta into the view" do
    tests "Apply", on: "Projection"
    setup  "Rebuild", name: { value: "current_state:Order" }
    input  name: { value: "current_state:Order" }, row_key: { value: "status" }, row_value: { value: "pending" }, sequence: { value: 1 }
    expect events_applied: 1, view: [{ key: "status", value: "pending" }], last_sequence: { value: 1 }, emits: ["DeltaApplied"]
  end

  test "Apply chained three times DERIVES the accumulated view (honest fold)" do
    tests "Apply", on: "Projection"
    setup  "Rebuild", name: { value: "orders_by_customer" }
    setup  "Apply", name: { value: "orders_by_customer" }, row_key: { value: "o1" }, row_value: { value: "ada" }, sequence: { value: 1 }
    setup  "Apply", name: { value: "orders_by_customer" }, row_key: { value: "o2" }, row_value: { value: "bo" },  sequence: { value: 2 }
    input  name: { value: "orders_by_customer" }, row_key: { value: "o3" }, row_value: { value: "cy" }, sequence: { value: 3 }
    expect events_applied: 3, view: [{ key: "o1", value: "ada" }, { key: "o2", value: "bo" }, { key: "o3", value: "cy" }], last_sequence: { value: 3 }
  end

  test "Rebuild empties the projection for a fresh replay" do
    tests "Rebuild", on: "Projection"
    setup  "Rebuild", name: { value: "current_state:Order" }
    setup  "Apply", name: { value: "current_state:Order" }, row_key: { value: "status" }, row_value: { value: "pending" }, sequence: { value: 1 }
    input  name: { value: "current_state:Order" }
    expect events_applied: 0, view: [], emits: ["ProjectionRebuilt"]
  end

  # ── Snapshot : a cached fold at a watermark ────────────────────────────

  test "Capture caches the folded state at a watermark" do
    tests "Capture", on: "Snapshot"
    input  projection_name: { value: "current_state:Order" }, watermark: { value: 2 }, state: []
      expect watermark: { value: 2 }, emits: ["SnapshotCaptured"]
    end

    # ── Consolidation : the merge trigger (operational singleton) ────────
    # The fold itself is kernel-floor IO (run_consolidate) that does NOT run in
    # the pure-memory behaviors runtime ; this proves the DOMAIN trigger — the
    # Consolidate command keys the singleton "log" record.
    test "Consolidate touches the singleton consolidation marker" do
      tests "Consolidate", on: "Consolidation"
      input  consolidation_id: "log"
      expect consolidation_id: "log"
    end

    # ── Verification : derivability as a STANDING invariant ──────────────
    # Like Consolidate, the measurement itself is kernel-floor (run_verification
    # folds the Log and compares it to the live store) and does NOT run in the
    # pure-memory behaviors runtime. These prove the DOMAIN shape : the trigger
    # keys the singleton, and Record is where a verdict lands.

    test "Verify touches the singleton verification marker" do
      tests "Verify", on: "Verification"
      input  verification_id: "projection"
      expect verification_id: "projection", emits: ["VerificationRequested"]
    end

    test "Record lands a derivable verdict on the singleton" do
      tests "Record", on: "Verification"
      input  verification_id: "projection", status: "derivable",
             checked_at: "2026-07-22T03:00:00Z", drift_fields: "0",
             transient: "0", fields_checked: "12", missing_rows: "0", detail: "-"
      expect status: "derivable", drift_fields: "0", fields_checked: "12", missing_rows: "0",
             emits: ["VerificationRecorded"]
    end

    test "Record lands a DRIFTED verdict naming what disagreed" do
      tests "Record", on: "Verification"
      setup  "Record", verification_id: "projection", status: "derivable",
             checked_at: "2026-07-22T03:00:00Z", drift_fields: "0",
             transient: "0", fields_checked: "12", missing_rows: "0", detail: "-"
      input  verification_id: "projection", status: "drifted",
             checked_at: "2026-07-22T03:01:00Z", drift_fields: "1",
             transient: "0", fields_checked: "12", missing_rows: "0", detail: "Counter::c1::hits"
      expect status: "drifted", drift_fields: "1", detail: "Counter::c1::hits"
    end

  # ── Event : the lineage + trust walks, answered by the LogWalker port ──
  #
  # The walks consume the Log rows they are handed (`log`), so these run with no
  # Append setup. `link` builds a minimal row ; `signed` builds a hash-chained one
  # (entry_hash is the sha256 recipe on the IntegrityReport value object).

  link = ->(id, cause, seq) { { event_id: { value: id }, causation_id: { value: cause }, sequence: { value: seq } } }
  signed = lambda do |id, cause, seq, prev, hash, value = "pending"|
    { event_id: { value: id }, causation_id: { value: cause }, sequence: { value: seq },
      aggregate_name: { value: "Order" }, aggregate_id: { value: "o1" },
      command: { verb: "Order.Place", inputs: "" }, delta: { field: "status", value: value },
      prev_hash: { value: prev }, entry_hash: { value: hash } }
  end
  h1 = "2238e135b1d4aa5217696371e89c7b190fab4a8760c51ed61db4fc4885e89c3a"
  h2 = "44a8799aa27c6685efcbe95caeb68db43535b0313bda9ee45344edea7c1af877"
  h3 = "23bc87cfd661bcc003f8f078c5544c57522f15d41d4139302337cb76f5857c28"
  chain = [signed.("a:1", "", 1, "", h1), signed.("a:2", "a:1", 2, h1, h2, "paid"), signed.("a:3", "a:2", 3, h2, h3, "shipped")]

  test "CausationTrace walks from an event up to its root cause" do
    tests "CausationTrace", on: "Event", kind: :query
    input  event_id: { value: "e3" }, log: [link.("e1", "", 1), link.("e2", "e1", 2), link.("e3", "e2", 3)]
    expect count: 1, row: { "root_event_id": "e1", "reached_root": true, "stopped": "root", "steps.event_id": %w[e3 e2 e1], "steps.depth": [0, 1, 2] }
  end

  test "CausationTrace reports a cause missing from the log" do
    tests "CausationTrace", on: "Event", kind: :query
    input  event_id: { value: "e2" }, log: [link.("e2", "gone", 2)]
    expect row: { "root_event_id": "e2", "reached_root": false, "stopped": "missing", "steps.event_id": %w[e2] }
  end

  test "CausationTrace stops a causation cycle instead of looping" do
    tests "CausationTrace", on: "Event", kind: :query
    input  event_id: { value: "e1" }, log: [link.("e1", "e2", 1), link.("e2", "e1", 2)]
    expect row: { "stopped": "cycle", "reached_root": false, "steps.event_id": %w[e1 e2] }
  end

  test "CausationTrace on an unknown event walks nothing" do
    tests "CausationTrace", on: "Event", kind: :query
    input  event_id: { value: "nope" }, log: [link.("e1", "", 1)]
    expect row: { "stopped": "unknown", "reached_root": false, "steps.event_id": [] }
  end

  test "ConsequenceTree fans out breadth-first with siblings in sequence order" do
    tests "ConsequenceTree", on: "Event", kind: :query
    input  event_id: { value: "e1" },
           log: [link.("e1", "", 1), link.("e3", "e1", 3), link.("e2", "e1", 2), link.("e4", "e2", 4), link.("x", "", 5)]
    expect count: 1, row: { "size": 4, "height": 2, "steps.event_id": %w[e1 e2 e3 e4], "steps.depth": [0, 1, 1, 2] }
  end

  test "ConsequenceTree of a leaf is just itself" do
    tests "ConsequenceTree", on: "Event", kind: :query
    input  event_id: { value: "e2" }, log: [link.("e1", "", 1), link.("e2", "e1", 2)]
    expect row: { "size": 1, "height": 0, "steps.event_id": %w[e2] }
  end

  test "ConsequenceTree stops a causation cycle instead of looping" do
    tests "ConsequenceTree", on: "Event", kind: :query
    input  event_id: { value: "e1" }, log: [link.("e1", "e2", 1), link.("e2", "e1", 2)]
    expect row: { "size": 2, "steps.event_id": %w[e1 e2] }
  end

  test "ChainIntact reports a shard whose hashes all re-derive as intact" do
    tests "ChainIntact", on: "Event", kind: :query
    input  log: chain
    expect count: 1, row: { "checked": 3, "intact": true, "broken.event_id": [] }
  end

  test "ChainIntact flags an edited entry" do
    tests "ChainIntact", on: "Event", kind: :query
    input  log: [chain[0], signed.("a:2", "a:1", 2, h1, h2, "refunded"), chain[2]]
    expect row: { "intact": false, "broken.event_id": %w[a:2], "broken.reason": %w[edited], "broken.shard": %w[a] }
  end

  test "ChainIntact flags the entry after a dropped one" do
    tests "ChainIntact", on: "Event", kind: :query
    input  log: [chain[0], chain[2]]
    expect row: { "intact": false, "checked": 2, "broken.event_id": %w[a:3], "broken.reason": %w[broken_link] }
  end
end
