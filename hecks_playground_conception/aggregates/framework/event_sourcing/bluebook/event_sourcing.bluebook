Hecks.bluebook "EventSourcing", version: "2026.06.19.1" do
  vision "The one substrate. A durable, append-only, ordered Log of immutable Events ; current-state and every read model are PROJECTIONS (folds) of that Log. Current-state is just the trivial per-aggregate projection. An Event is BOTH the command (intent + inputs) AND the resulting delta (the fact of what changed) ; the fold applies the DELTA only (deterministic — now/rand/compute are resolved once at write and recorded as fact), while lineage reads the command + the causation_id / correlation_id. This bluebook conceives Event (the immutable atom + the Log's append-and-replay surface), Projection (the honest incremental fold that DERIVES a view from the deltas it is fed), and Snapshot (a cached fold at a sequence point — today's heki current-state store, reinterpreted — with on-read fall-forward to replay). Lineage is ENABLED here (every Event carries causation_id + correlation_id) but its facet-queries are DEFERRED to a later phase. Subsumption is COEXIST-THEN-MIGRATE : OutboundEvent becomes a read model of undelivered events, CascadeRun an event-reactive consumer, dispatch_audit a pure audit projection, and IdentityService's IdentityString rename-chain a fold of rename Events whose head is the current name — none are rewritten in this phase, only flagged."

  # ============================================================
  # EVENT  —  the immutable atom AND the Log surface
  # ============================================================
  #
  # BOUNDARY DECISION (flagged) : Event IS the aggregate ; "Log" is the
  # SUBSTRATE CONCEPT — the totally-ordered set of all Event records — not
  # a container that holds a nested list. This is deliberate :
  #
  #   * The Log operations (replay / at_sequence / for_aggregate /
  #     by_correlation) are RECORD-FILTERING queries over the Event set,
  #     so they are count-assertable and compose like any other query.
  #   * The lineage-ready guarantee (every Event carries causation_id +
  #     correlation_id) is a per-RECORD invariant, directly assertable
  #     after Append, not buried inside one Log record's list elements.
  #
  # Append is THE ONE WRITER. There is no Event.Update / Event.Delete :
  # the Log is append-only by construction (no mutating command exists).

  aggregate "Event" do
    description "The immutable atom of the substrate. Carries BOTH the command (intent + inputs) and the resulting delta (the fact of what changed), plus the lineage ids (causation_id / correlation_id), the acting party, the monotonic sequence, and the recorded_at stamp. Identified by event_id. Append is the only writer ; the Log is append-only because no mutating command exists."
    identified_by :event_id

    attribute :event_id,       EventId
    attribute :aggregate_name, AggregateName
    attribute :aggregate_id,   AggregateId
    attribute :command,        Command
    # The domain EVENT as the first-class fact : the emitted event's name. An
    # EVENT-row carries event_name with an EMPTY delta (the payload rides
    # command.inputs) ; the trivial fold skips empty-delta rows, so an event-row
    # is a lineage/governance fact that never disturbs state reconstruction.
    attribute :event_name,     EventName
    attribute :delta,          Delta
    attribute :causation_id,   CausationId
    attribute :correlation_id, CorrelationId
    attribute :actor,          Actor
    # The authorization verdict under which this event was admitted — who was
    # allowed to do this, in what role, by which policy. Governability : the log
    # answers "who successfully did what, under what verdict."
    attribute :verdict,        Verdict
    attribute :sequence,       Sequence
    attribute :recorded_at,    RecordedAt
    # Provenance : the domain-definition version that produced this event and the
    # runtime build that recorded it. Self-describing for replay + upcasting.
    attribute :bluebook_version, BluebookVersion
    attribute :runtime_version,  RuntimeVersion
    # TRUST — the hash chain. Each entry hashes its own content TOGETHER WITH the
    # previous entry's hash, so the entries of one shard form a chain : edit,
    # drop, or reorder any entry and every entry after it fails to re-derive.
    # The chain is PER SHARD, which is the only place a total order exists at
    # append time — a shard has exactly one writer (its process), while the
    # global Log is a merge of many. The merge orders shards ; it does not
    # re-chain them.
    attribute :prev_hash,  PrevHash
    attribute :entry_hash, EntryHash

    # ── Value objects ──────────────────────────────────────────────

    value_object "EventId" do
      # Stable, globally-unique id for this event record. The atom's key.
      attribute :value, String
    end

    value_object "PrevHash" do
      # The entry_hash of the previous entry in THIS SHARD's chain. Empty on the
      # first entry a process writes — where a chain walk starts.
      attribute :value, String
    end

    value_object "EntryHash" do
      # This entry's hash, over its own content AND prev_hash. Recomputable from
      # the row alone, so a verifier needs nothing but the Log to check it.
      #
      # HONEST LIMIT : this detects CORRUPTION, TRUNCATION and REORDERING — an
      # accidental or careless change to a log that is supposed to be immutable.
      # It is NOT proof against a deliberate rewrite : anyone who can edit an
      # entry can recompute the rest of the chain. Real tamper-EVIDENCE needs a
      # cryptographic digest plus an anchor the rewriter cannot reach (a signed
      # or externally-witnessed head). The chain is the mechanism ; the digest
      # and the anchor are the policy, and can be strengthened without changing
      # this shape.
      attribute :value, String
    end

    value_object "AggregateName" do
      # WHICH aggregate kind this event belongs to, e.g. "Order".
      # for_aggregate filters on (name, id) ; current-state is the trivial
      # per-aggregate projection keyed by this pair.
      attribute :value, String
    end

    value_object "AggregateId" do
      # WHICH instance of that aggregate, e.g. an order id.
      attribute :value, String
    end

    value_object "Command" do
      # The INTENT side : the command FQN + its inputs, as the caller
      # composed it, e.g. "Order.PlaceOrder customer=ada qty=2". Read by
      # lineage (DEFERRED) ; NEVER re-executed by the fold.
      attribute :verb,    String
      attribute :inputs,  String
    end

    value_object "Delta" do
      # The FACT side : the resolved change this event records. now / rand /
      # compute are resolved ONCE at write and frozen here, so replaying the
      # delta is deterministic. The fold applies THIS, never the command.
      #   field — the state field that changed (or a list verb token).
      #   value — the resolved new value / appended element.
      attribute :field,   String
      attribute :value,   String
    end

    value_object "CausationId" do
      # The id of the event/command that DIRECTLY caused this one. Lineage-
      # ready ; the facet-queries over it are DEFERRED.
      attribute :value, String
    end

    value_object "CorrelationId" do
      # The id shared by every event in the same originating flow. by_
      # correlation filters on it ; lineage facet-queries DEFERRED.
      attribute :value, String
    end

    value_object "Actor" do
      # WHO acted — the role/agent/human that issued the command.
      attribute :value, String
    end

    value_object "Sequence" do
      # The Log's total order. Monotonic per Append. since(seq) and replay
      # order on this. Provided by the writer (the runtime's sequencer).
      attribute :value, Integer
    end

    value_object "RecordedAt" do
      # Wall-clock stamp at write, recorded as fact (part of the delta
      # determinism rule — time is resolved once, here).
      attribute :value, String
    end

    value_object "EventName" do
      # The emitted domain event's name, e.g. "Deposited". First-class on the
      # EVENT-row (the row whose delta is empty) ; empty on a delta-row.
      attribute :value, String
    end

    value_object "Verdict" do
      # The authorization decision this event was admitted under. `allowed` is
      # "true" for a recorded success (a denied command writes no Event) ; role
      # + policy_id name WHO was permitted and by which rule. Governability.
      attribute :allowed,   String
      attribute :role,      String
      attribute :policy_id, String
    end

    value_object "BluebookVersion" do
      # The version of the SUBJECT aggregate's bluebook in effect when this
      # event was produced — so a replay knows which schema to read it as.
      attribute :value, String
    end

    value_object "RuntimeVersion" do
      # The storehouse build that recorded this event — provenance for audit.
      attribute :value, String
    end

    # ── The CONSISTENCY RULE between command and delta (flagged) ──
    #
    # An Event with a command but NO delta means "nothing happened" —
    # forbidden. The delta is AUTHORITATIVE : the fold applies the delta
    # and never re-runs the command. We enforce the floor of that rule
    # here : a delta must name a field.
    invariant "an event is a fact — it names either a changed field (delta-row) or the domain event (event-row)" do
      delta.field != "" || event_name.value != ""
    end

    invariant "sequence is monotonic and positive" do
      sequence.value > 0
    end

    # ── Append : THE ONE WRITER ────────────────────────────────────

    command "Append" do
      role "System"
      goal "Append one immutable event to the Log — the single write path of the whole substrate"
      goal "Record an event as fact. Carries BOTH the command (intent + inputs) and the resolved delta, the lineage ids, the actor, the monotonic sequence, and recorded_at. The runtime's sequencer supplies a strictly-increasing sequence ; the delta is already resolved (now/rand/compute frozen) so the fold is deterministic. This is the only writer — there is no update or delete, which is what makes the Log append-only."
      attribute :event_id,       EventId
      attribute :aggregate_name, AggregateName
      attribute :aggregate_id,   AggregateId
      attribute :command,        Command
      attribute :event_name,     EventName
      attribute :delta,          Delta
      attribute :causation_id,   CausationId
      attribute :correlation_id, CorrelationId
      attribute :actor,          Actor
      attribute :verdict,        Verdict
      attribute :sequence,       Sequence
      attribute :recorded_at,    RecordedAt
      attribute :bluebook_version, BluebookVersion
      attribute :runtime_version,  RuntimeVersion
      # TRUST : the chain the writer stamps — this entry's hash over its own
      # content AND its predecessor's hash. Carried on Append because Append is
      # the only writer ; an attribute the command does not declare is dropped at
      # the door, so the chain would silently never reach the Log.
      attribute :prev_hash,  PrevHash
      attribute :entry_hash, EntryHash
      emits "EventAppended"
    end

    # ── The Log surface : RECORD-FILTERING queries over the Event set ─

    query "Replay" do |aggregate_name|
      # The Log for one aggregate kind, in sequence order — the universal
      # fold input. The trivial per-aggregate projection replays this.
      where(aggregate_name: :aggregate_name)
    end

    query "AtSequence" do |seq|
      # `seq` names no owner attribute (the owner's own field is
      # `sequence`), so derive_from_owner! can't infer its type -- declared
      # explicitly instead, matching Sequence's own type.
      attribute :seq, Sequence
      # Point lookup : the event AT a sequence. where() carries ordered
          # predicates (Gt/Gte/Lt/Lte) in the matcher, so the "tail strictly
          # AFTER a watermark" that Snapshot's fall-forward needs IS expressible.
          # Range pushdown PARTLY landed : a NON-NUMERIC target pushes to the SQL
          # backend as CAST(col AS TEXT) OP ? (lexical, index-backed), exact
          # against the oracle. But SEQUENCE is numeric, and a numeric target
          # can't push lexically ("10" vs "5"). The Event-Log sequence-range
          # SEEK now backs the numeric tail : the offset index carries the
          # sequence column, binary-searched to the contiguous byte slice
          # (Event.SinceSequence ; Snapshot.ReadForward folds it forward). The
          # SQL backend pushes numeric ranges on INTEGER columns too (CAST AS
          # INTEGER, NULL-exact). AtSequence is the equality slice and the
          # building block of that scan.
          #
          # NOTE : keys on the bare `sequence` VO. The oracle UNWRAPS a
          # single-value VO ({"value": N}) to its inner value before comparing,
          # so this resolves to the integer in BOTH runtimes — the in-memory
          # behaviors (VO-as-string) and the live storehouse (VO-as-map) now
          # agree. The sequence-range SEEK that Snapshot fall-forward needs runs
          # through SinceSequence, which drives the nested value directly.
      where(sequence: :seq)
    end

    query "SinceSequence" do |sequence|
      # The watermark TAIL : every event STRICTLY AFTER a sequence, in order
      # — the input Snapshot's fall-forward folds (read watermark+1..head).
      # Backed by the Event-Log sequence-range SEEK : the offset index carries
      # the sequence column, so this binary-searches to the contiguous byte
      # slice instead of streaming the whole Log — O(tail), not O(whole-log).
      # Keys on sequence.value (the nested int), like AtSequence : the runtime
      # INJECTS the `sequence.value > sequence` range clause (the where() DSL
      # can't address a dotted key portably) and drives the seek through it.
      where(sequence: { gt: :sequence })
      order_by :sequence
      description "Every event strictly after a sequence — the Snapshot fall-forward tail, backed by the sequence-range seek"
    end

    query "ForAggregate" do |aggregate_id|
      # Every event for one aggregate instance — the input to the trivial
      # per-aggregate (current-state) projection.
      where(aggregate_id: :aggregate_id)
    end

    query "ByCorrelation" do |correlation_id|
          # Every event in one originating flow — the lineage-ready slice.
          where(correlation_id: :correlation_id)
        end

        # ── Lineage facet-queries ──────────────────────────────────────

        query "ByActor" do |actor|
          # Every event a given party issued — a plain equality slice over the
          # actor field. Expressible as an ordinary where() (the lineage facet
          # that needs no traversal).
          where(actor: :actor)
        end

        # ── Lineage + trust walks : answered by the LogWalker port ──────
        #
        # Three questions a single where() cannot say, because each is an
        # unbounded walk or a recomputation over the Log : what caused this
        # (CausationTrace, backward), what did this cause (ConsequenceTree,
        # forward), and does the hash chain still re-derive (ChainIntact).
        # Under hecks 3.x a query is answered from this aggregate's records OR
        # from outside by exactly one port, never both. These three have no
        # where, so the EventSourcing hecksagon binds each to the LogWalker
        # port (event_sourcing.ports.hecksagon) and an adapter walks the rows.
        #
        # The adapter is built bare and sees no records, so the Log slice to
        # walk is the `log` argument : the caller composes it (Replay,
        # ByCorrelation, ... return Event rows, which are exactly LogEntry
        # rows) and the port executes the walk. The answer is a value object,
        # built and checked before it enters the domain.

        query "CausationTrace" do
          description "Walk the causation chain from this event up to its root cause"
          attribute :event_id, EventId
          attribute :log,      list_of(LogEntry)
          returns CausationChain
        end

        query "ConsequenceTree" do
          description "Walk forward from this event through everything it caused, breadth-first"
          attribute :event_id, EventId
          attribute :log,      list_of(LogEntry)
          returns ConsequenceTree
        end

        query "ChainIntact" do
          description "Re-derive every entry's hash chain per shard ; the report lists the entries that do not"
          attribute :log, list_of(LogEntry)
          returns IntegrityReport
        end

        # The rows the walks consume : an Event, as the Log returns it.
        value_object "LogEntry" do
          attribute :event_id,       EventId
          attribute :causation_id,   CausationId
          attribute :sequence,       Sequence
          attribute :aggregate_name, AggregateName, optional: true
          attribute :aggregate_id,   AggregateId,   optional: true
          attribute :command,        Command,       optional: true
          attribute :event_name,     EventName,     optional: true
          attribute :delta,          Delta,         optional: true
          attribute :correlation_id, CorrelationId, optional: true
          attribute :actor,          Actor,         optional: true
          attribute :recorded_at,    RecordedAt,    optional: true
          attribute :prev_hash,      PrevHash,      optional: true
          attribute :entry_hash,     EntryHash,     optional: true
        end

        # One event on a lineage walk. depth 0 is the event asked about ;
        # backward it grows toward the root cause, forward toward the leaves.
        value_object "LineageStep" do
          attribute :event_id,       String
          attribute :causation_id,   String
          attribute :aggregate_name, String
          attribute :aggregate_id,   String
          attribute :verb,           String
          attribute :event_name,     String
          attribute :sequence,       Integer
          attribute :depth,          Integer
        end

        value_object "CausationChain" do
          # steps run from the event asked about up to the root cause. `stopped`
          # says why the walk ended : "root" (an empty causation_id), "missing"
          # (the cause is not in the log slice), "cycle" (the chain loops back)
          # or "unknown" (the event is not in the slice at all).
          attribute :start_event_id, String
          attribute :root_event_id,  String
          attribute :stopped,        String
          attribute :reached_root,   Boolean
          attribute :steps,          list_of(LineageStep)
        end

        value_object "ConsequenceTree" do
          # steps are level-ordered (depth 0 is the root event) and siblings are
          # in sequence order, so the tree shape is rebuilt from the flat list.
          attribute :root_event_id, String
          attribute :size,          Integer
          attribute :height,        Integer
          attribute :steps,         list_of(LineageStep)
        end

        value_object "BrokenEntry" do
          # reason : "edited" (its content no longer hashes to its entry_hash) or
          # "broken_link" (its prev_hash does not name the entry before it in
          # its shard : one was dropped or reordered).
          attribute :event_id, String
          attribute :shard,    String
          attribute :sequence, Integer
          attribute :reason,   String
        end

        value_object "IntegrityReport" do
          # Hash recipe : sha256 hex over event_id, aggregate_name, aggregate_id,
          # command verb + inputs, event_name, delta field + value, causation_id,
          # correlation_id, actor, sequence, recorded_at and prev_hash, joined
          # with the unit separator (0x1f). A shard is the text before the first
          # ":" in an event_id ; an id with no ":" belongs to the one unnamed shard.
          attribute :checked, Integer
          attribute :intact,  Boolean
          attribute :broken,  list_of(BrokenEntry)
        end
      end

  # ============================================================
  # PROJECTION  —  the HONEST incremental fold
  # ============================================================
  #
  # A Projection DERIVES a view by folding the deltas it is fed, one at a
  # time, via Apply. Rebuild resets it to empty so the runtime can replay
  # the Log into it from scratch. This is NOT the board_markdown/terraform
  # "record-the-precomputed-result" pattern — here the fold actually
  # accumulates : events_applied counts the deltas folded, and view
  # collects the derived rows. The behaviors prove derivation by chaining
  # Apply calls and asserting the accumulated result.
  #
  # Current-state is the TRIVIAL projection : name = the aggregate kind,
  # the fold keeps only the latest delta per field. Read models are NAMED
  # projections with their own fold. Both are the same machine.

  aggregate "Projection" do
    description "A view derived by folding event deltas. Identified by name. Apply folds one delta (incrementing events_applied, appending the derived row) ; Rebuild empties it for a fresh replay. Current-state is the trivial per-aggregate projection ; read models are named projections — the same fold machine."
    identified_by :name

    attribute :name,           ProjectionName
    attribute :events_applied, AppliedCount, default: { value: 0 }
    attribute :last_sequence,  Sequence,     default: { value: 0 }
    attribute :view,           list_of(Row)

    value_object "ProjectionName" do
      # Natural key. "current_state:Order" for the trivial projection,
      # or a read-model name like "orders_by_customer".
      attribute :value, String
    end

    value_object "AppliedCount" do
      # Monotonic count of deltas folded since the last Rebuild. PROVES
      # the fold ran : 3 Applies -> events_applied == 3.
      attribute :value, Integer
    end

    value_object "Sequence" do
      # The sequence of the last event folded — the projection's watermark.
      attribute :value, Integer
    end

    value_object "Row" do
      # One derived row of the view. key/value is the folded delta : the
      # field that changed and its resolved value. A read model shapes its
      # own rows ; the trivial projection's rows ARE the current state.
      attribute :key,   String
      attribute :value, String
    end

    value_object "RowKey" do
      # The field a folded delta changed — the derived row's key.
      attribute :value, String
    end

    value_object "RowValue" do
      # The resolved value a folded delta carried — the derived row's value.
      attribute :value, String
    end

    command "Rebuild" do
      role "System"
      goal "Empty the projection so the Log can be replayed into it from scratch"
      goal "Reset the fold. The runtime calls Rebuild then replays the Log (Event.Replay) folding each delta via Apply — a projection is always reproducible from the Log alone. Clears the derived view and the counters."
      reference_to(Projection)
      sets :name
      sets :events_applied, to: 0
      sets :last_sequence,  to: 0
      sets :view,           to: []
      emits "ProjectionRebuilt"
    end

    command "Apply" do
      role "System"
      goal "Fold one event delta into the view — the actual derivation step"
      goal "Apply a single event's delta to the projection : append the derived row (key=field, value=resolved value), advance the watermark to the event's sequence, and increment events_applied. The runtime drives this once per event during replay or live tailing. This is the honest fold : the view is DERIVED from the deltas, never recorded precomputed."
      reference_to(Projection)
      attribute :row_key,   RowKey
      attribute :row_value, RowValue
      attribute :sequence,  Sequence
      sets :view,           append: { key: :row_key, value: :row_value }
      sets :last_sequence,  to: :sequence
      sets :events_applied, increment: 1
      emits "DeltaApplied"
    end
  end

  # ============================================================
  # SNAPSHOT  —  a cached fold at a sequence point
  # ============================================================
  #
  # A Snapshot is a cached projection result AT a sequence (the watermark).
  # It is today's heki current-state store, reinterpreted : not the source
  # of truth (the Log is), just a cache. On read the runtime folds the tail
  # FORWARD : it RANGE-SCANS the Log from watermark+1 to head (the Log is
  # ordered by sequence) and Applies each delta, so the snapshot is caught
  # up. So a snapshot is never WRONG, only STALE — invalidation is implicit
  # (the gap between watermark and Log head). CADENCE (flagged) : capture by
  # THRESHOLD (every N events) or ON-DEMAND, not by time.
  #
  # NOTE : the strictly-after-watermark TAIL is a RANGE scan. where() DOES
  # carry ordered predicates (Gt/Gte/Lt/Lte) in the matcher, so the tail is
  # now EXPRESSIBLE. Range pushdown PARTLY landed : a NON-NUMERIC target pushes
  # to SQL as CAST(col AS TEXT) OP ? (lexical, index-backed). But the watermark
  # tail keys on SEQUENCE (numeric), which can't push lexically. The Event-Log
  # sequence-range SEEK now backs it : the offset index carries the sequence
  # column, binary-searched to the contiguous slice, and Snapshot.ReadForward
  # folds that tail forward onto the cache (O(tail), not O(whole-log)). The
  # SQL backend pushes numeric ranges on INTEGER columns too (CAST AS INTEGER,
  # NULL-exact) ; Eq + indexes + non-numeric + numeric SQL ranges all landed in
  # the where() overhaul. Event.
  # AtSequence is the equality slice ; the fall-forward scan is its ordered
  # generalisation.

  aggregate "Snapshot" do
    description "A cached fold of a projection at a sequence watermark. Identified by projection_name. Capture records the folded state + watermark ; on read (ReadForward) the runtime SEEKS the Log tail from watermark+1 to head via the Event-Log sequence-range index and folds those deltas forward, so a snapshot is never wrong, only stale, and the read is O(tail) not O(whole-log). The SQL backend also pushes numeric ranges on INTEGER columns (CAST AS INTEGER). Threshold/on-demand cadence, not time-based."
    identified_by :projection_name

    attribute :projection_name, ProjectionName
    attribute :watermark,       Watermark
    attribute :state,           list_of(Row)

    value_object "ProjectionName" do
      # Which projection this snapshot caches. One snapshot per projection.
      attribute :value, String
    end

    value_object "Watermark" do
      # The sequence the snapshot is valid AS OF. The runtime range-scans
      # the Log from watermark+1 to head and folds forward on read to catch up.
      attribute :value, Integer
    end

    value_object "Row" do
      # One row of the cached folded state. Same shape as a Projection Row.
      attribute :key,   String
      attribute :value, String
    end

    command "Capture" do
      role "System"
      goal "Cache a projection's folded state at a sequence watermark"
      goal "Record the projection's current folded state and the sequence it is valid as of. The runtime captures on a threshold (every N events) or on demand — never on a timer. On read it range-scans the Log from watermark+1 to head and folds those deltas forward, so this cache is always safe : stale at worst, never wrong."
      attribute :projection_name, ProjectionName
      attribute :watermark,       Watermark
      attribute :state,           list_of(Row)
      sets :watermark
      sets :state
      emits "SnapshotCaptured"
    end

    query "ReadForward" do |projection_name|
      # The projection read AS OF NOW : the cached snapshot rows PLUS the fold
      # of the watermark TAIL — every Event with sequence.value > watermark,
      # fetched via the Event-Log sequence-range SEEK (binary-search the offset
      # index, read the contiguous slice), folded forward onto the cache
      # (last-write-wins). A named query the runtime special-cases (like
      # CausationTrace) : it never returns stale state because the tail is
      # always re-folded on read, and it is O(tail), not O(whole-log). No
      # snapshot captured yet -> watermark 0 -> a full replay. Serves the
      # trivial current-state projection (Row key "agg::id::field") ;
      # custom-projection reducers are a later lift.
      where(projection_name: :projection_name)
    end
  end

  # ============================================================
  # VERIFICATION  —  derivability as a STANDING invariant
  # ============================================================
  #
  # `verify-projection` proves the claim the whole substrate rests on : current
  # state is DERIVABLE from the Log, so the Log is the source of truth and not a
  # parallel record. Proven ONCE by an operator running a command, that is an
  # anecdote. The property has to hold continuously, so it has to be MEASURED
  # continuously — the same shape as Consolidation : a tiny singleton whose
  # command is the TRIGGER, fired by a driving-on-interval Driver, with the
  # kernel-floor fold+compare behind it.
  #
  # Verify is the trigger ; Record is where the verdict lands, so the answer is
  # itself domain state a reader can query rather than a line in a log nobody
  # tails. TRANSIENT drift is reported separately from PERSISTENT drift because a
  # continuously-dispatching aggregate races the gauge by nature — and an alarm
  # that fires on every race is one everybody learns to ignore.

  aggregate "Verification" do
    description "A singleton standing verdict on derivability : does fold(Log) still reconstruct the live store? One record, keyed \"projection\". Verify is the trigger a Driver fires on an interval ; the runtime performs the fold+compare (kernel-floor, sibling of the consolidation merge) and dispatches Record with the outcome. Persistent drift means the Log and the store genuinely disagree — an unlogged write or a fold bug. Transient drift is the liveness race of reading two stores that cannot be snapshotted atomically, and is counted, not alarmed on."
    identified_by :verification_id

    attribute :verification_id, VerificationId
    attribute :status,          Status,     default: { value: "unknown" }
    attribute :checked_at,      CheckedAt,  default: { value: "-" }
    attribute :drift_fields,    DriftFields, default: { value: "0" }
    attribute :transient,       Transient,  default: { value: "0" }
    attribute :fields_checked,  FieldsChecked, default: { value: "0" }
    attribute :missing_rows,    MissingRows, default: { value: "0" }
    attribute :detail,          Detail,     default: { value: "-" }

    value_object "VerificationId" do
      # The singleton key — "projection".
      attribute :value, String
    end
    value_object "Status" do
      # derivable = every folded field matches the store. drifted = at least one
      # PERSISTENT mismatch survived re-measurement. empty = the Log has nothing
      # to verify yet (the gate is off, or nothing has been dispatched).
      attribute :value, String, one_of: %w[unknown derivable drifted empty]
    end
    value_object "CheckedAt" do
      attribute :value, String
    end
    value_object "DriftFields" do
      # How many (aggregate, id, field) triples PERSISTENTLY disagree.
      attribute :value, String
    end
    value_object "Transient" do
      # Mismatches that cleared on re-measurement — the liveness race, not drift.
      attribute :value, String
    end
    value_object "FieldsChecked" do
      attribute :value, String
    end
    value_object "MissingRows" do
      # COMPLETENESS — emitted domain events the Log does not contain. Always 0 on
      # a healthy runtime ; any other number names events that HAPPENED and were
      # not recorded, which is the one failure a source of truth cannot have.
      #
      # A separate property from drift, and one the derivability gauge is blind to:
      # a dropped EVENT-row carries an empty delta, so it contributes nothing to
      # the fold and fold(Log) still matches the store perfectly. Counted at the
      # dispatch caller (owed) against the writer (written) — because missing
      # events have no oracle to compare against, unlike drift.
      attribute :value, String
    end
    value_object "Detail" do
      # The first drifting triples, so the verdict is actionable without re-running
      # the command by hand.
      attribute :value, String
    end

    command "Verify" do
      role "System"
      goal "Ask whether current state is still derivable from the Log"
      goal "The TRIGGER. Carries no result : the runtime hook folds the complete Log (consolidated event.heki + the unconsolidated shard tail), compares each reconstructed field to the live store, re-measures to strip transient races, and dispatches Record with the verdict. Fired by the ProjectionVerification Driver on an interval, or by hand."
      attribute :verification_id, VerificationId
      sets :verification_id
      emits "VerificationRequested"
    end

    command "Record" do
      role "System"
      goal "Record the standing verdict on derivability"
      goal "Where the measurement lands, so the answer is queryable domain state rather than console output. Upserts on the singleton key — the LATEST verdict is the one that matters ; the history of verdicts rides the Log like any other fact."
      reference_to(Verification)
      sets :verification_id
      attribute :status,          Status
      attribute :checked_at,      CheckedAt
      attribute :drift_fields,    DriftFields
      attribute :transient,       Transient
      attribute :fields_checked,  FieldsChecked
      attribute :missing_rows,    MissingRows
      attribute :detail,          Detail
      sets :status
      sets :checked_at
      sets :drift_fields
      sets :transient
      sets :fields_checked
      sets :missing_rows
      sets :detail
      emits "VerificationRecorded"
    end

    query "Drifted" do
      description "The verdict IF it is currently drifting — empty means the Log and the store agree. The one query a monitor needs."
      where status: "drifted"
    end
  end

  # ============================================================
  # CONSOLIDATION  —  the merge trigger (operational, NOT an Event)
  # ============================================================
  #
  # The fold that turns the per-process Event shards into the global ordered
  # Log is an ADAPTER operational concern, kept OUT of the Event domain so
  # Append stays the one and only Event writer. It cannot be an Event command :
  # Event's invariants (delta.field present, sequence > 0) describe an APPENDED
  # fact, which a merge pass is not. So consolidation is its own tiny singleton
  # aggregate — one record, keyed "log" — whose Consolidate command is the
  # trigger. A driving-on-interval Driver (event_sourcing.hecksagon, fired by
  # `storehouse drive`) dispatches it ; the runtime hook run_consolidate then
  # performs one merge pass (kernel-floor persistence IO, event_merge.rs). This
  # is what retires the hand-written run_merge daemon.

  aggregate "Consolidation" do
    description "A singleton marker that the per-process Event shards were folded into the global ordered Log AND the fully-folded shards of dead processes reclaimed. The fold and the reclaim are both kernel-floor persistence IO (event_merge.rs, sibling of heki.rs) ; this aggregate is the DOMAIN trigger for them — one record, keyed \"log\", touched by each Consolidate. Reclamation matters because every dispatch process single-writes its own shard then exits, so without GC the shard directory grows without bound ; a shard is reclaimed only once the merge has folded it whole AND its owning process is dead (a live owner holds the file open, so unlinking it would lose its future appends). Fired by a driving-on-interval Driver, replacing the run_merge daemon."
    identified_by :consolidation_id

    # Singleton key : defaults to "log" so a no-arg Consolidate keys the one
    # record. The driver dispatches Consolidate with no domain attrs, so the
    # default is what identifies the singleton.
    attribute :consolidation_id, ConsolidationId, default: { value: "log" }

    value_object "ConsolidationId" do
      attribute :value, String
    end

    command "Consolidate" do
      role "System"
      goal "Fold this realm's per-process Event shards into the global ordered Log"
      goal "Maintenance command — the AppendLog adapter's consolidation half. Carries no shard data : the runtime hook run_consolidate performs ONE merge pass (read each shard from its checkpoint offset, order by (ts, shard, seq), write new records to the global event.heki idempotently by event_id, advance the checkpoint), then RECLAIMS every shard the merge has now folded whole whose owning process is dead (deleting the file and pruning its checkpoint entry, guarded by a trustworthy live-process probe so a live owner's open shard is never unlinked). Dispatched by the driving-on-interval Driver, never by hand. Touches the singleton so the record's existence is the freshness signal."
      attribute :consolidation_id, ConsolidationId
    end
  end
end
