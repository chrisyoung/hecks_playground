# Driving/driven adapter declarations moved out of event_sourcing.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word (no interval/cron
# drivers, no `driven on` reactions). Kept verbatim as the spec for an
# upstream hecks feature. Nothing loads this file.

  adapter "LogConsolidation" do
    driving on interval "5s" do |clock|
      dispatch "EventSourcing::Consolidation.Consolidate",
               consolidation_id: "log"
    end
  end

  adapter "ProjectionVerification" do
    driving on interval "60s" do |clock|
      dispatch "EventSourcing::Verification.Verify",
               verification_id: "projection"
    end
  end
