Hecks.behaviors "Governance" do
  vision "Behavioral tests for the governance veto-audit — Violation, the single immutable record of a denied or vetoed dispatch. Recording it is the point : the denial becomes a governed, logged fact. (The deny-by-default Policy + EnforcementAdapter that once lived here are retired ; the channel barrier is now Macrophage::GovernedDoor and authorization is the inbound Gate concept.)"

  test "Record logs a denied native tool attempt" do
    tests "Record", on: "Violation"
    input  id: "v-1", tool_name: "Bash", reason: "native Bash makes no bus event", occurred_at: "2026-06-25T05:00:00Z"
    expect tool_name: "Bash", reason: "native Bash makes no bus event"
  end

  test "Record captures the structured gate + cause (legible deny)" do
    tests "Record", on: "Violation"
    input  id: "v-3", tool_name: "Pizzas::Order.Open", reason: "middleware 'authorize': requires an authorization permit (deny-by-default), caller ghost", gate: "authorize", cause: "deny-by-default", occurred_at: "2026-06-29T05:00:00Z"
    expect gate: "authorize", cause: "deny-by-default"
  end

  test "Record emits Recorded" do
    tests "Record", on: "Violation"
    input  id: "v-2", tool_name: "Read", reason: "native Read makes no bus event", occurred_at: "2026-06-25T05:01:00Z"
    expect_event "Recorded"
  end

  test "ByTool lists the denials recorded for one tool" do
    tests "ByTool", on: "Violation", kind: :query
    setup  "Record", id: "v-9", tool_name: "Bash", reason: "native Bash makes no bus event", occurred_at: "2026-06-25T05:02:00Z"
    input  tool_name: "Bash"
    expect count: 1
  end
end
