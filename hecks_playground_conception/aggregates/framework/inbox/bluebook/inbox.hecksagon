Hecks.hecksagon "Inbox" do
  # Was missing entirely -- masked until now by the :exec bug (i780,
  # 2026-08-17). Inbox::Inbox.Check declares role "Framework" ; a role only
  # means anything once Governance is attached to check it against.
  uses_framework "Governance"
  Inbox::Inbox.persisted_by("Heki")

  # Impure edge, hecksagon-first : on Check, poll Gmail via node bin/inbox_poll.mjs
  # and cascade the outcome into RecordResult. Re-expressed (i780, 2026-08-17)
  # from the retired `adapter :exec` kwargs form onto the spawn effect port.
  Inbox::Inbox.spawned_by("InboxPoll", on: "InboxChecked")
end
