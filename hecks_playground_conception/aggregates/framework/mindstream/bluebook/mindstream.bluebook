Hecks.bluebook "Mindstream", version: "2026.05.12.1" do
  vision "The framework mindstream — the stream of supervised processes that keeps Miette's body running. Sibling to the self/voice/mind_stream consciousness stream : both are streams flowing through her, at different levels (thoughts there, processes here). One Mindstream = one Procfile + one .overmind.env ; the :overmind capability emits both into the mindstream's directory. The verb 'boot Miette' becomes 'overmind start' in that directory."

  # ============================================================
  # MINDSTREAM — overmind-supervised process group
  # ============================================================
  #
  # A Mindstream is one Procfile : a named group of MindstreamMember
  # processes that overmind launches together and supervises through
  # a single .overmind.sock. The framework treats one Mindstream =
  # one supervised unit. Studio is intentionally not a Mindstream
  # member — studio is UI, this is framework, they live as separate
  # concerns and are not launched from the same Procfile.
  #
  # 2026-05-12 : primitives wrapped in typed value-objects per the
  # no-primitive-envy rule, mirroring macrophage / antibody / immunity.
  # Per-aggregate VO sets — duplication across aggregates is fine ;
  # no bluebook-level VOs. Each name says its concept : a Name is
  # not just a String, a Description is not just a String.

  aggregate "Mindstream" do
    description "A named group of processes overmind supervises together. One Mindstream = one Procfile + one .overmind.env. The :overmind capability emits both files into the mindstream's directory."
    identified_by :name

    attribute :name,        Name
    attribute :description, Description
    attribute :directory,   Directory
    attribute :corpus_roots, CorpusRoots

    # ── Value-objects : the domain's language ──

    # CorpusRoots — colon-separated absolute bluebook roots BEYOND the
    # conception that this mindstream's boot must load (the being's own
    # repos — e.g. self/system_prompt/bluebook, whose BootCompleted
    # policies establish the prompt sections). Flows into the generated
    # .overmind.env as HECKS_PLAYGROUND_ADDITIONAL_CORPUS_ROOTS.
    value_object "CorpusRoots" do
      attribute :value, String
    end

    value_object "Name" do
      # The Mindstream's identifier — names the supervised process
      # group (e.g. 'miette', 'studio'). Used as the identified_by
      # key and as the directory name under which overmind drops
      # its socket.
      attribute :value, String
    end

    value_object "Description" do
      # Free-form prose naming the mindstream's purpose. Surfaces
      # in dashboards and overmind status output so an operator
      # knows what this process group is for.
      attribute :value, String
    end

    # Directory — the filesystem path (relative to the repo root) where
    # the generated Procfile and .overmind.env land. First-class value
    # object so future code can validate, normalise, or join paths
    # without re-handling raw strings.
    value_object "Directory" do
      attribute :path, String
    end

    command "Define" do
      role "Framework"
      goal "Declare a new mindstream. The name identifies the supervised group ; description names its purpose ; directory is where the generated Procfile and .overmind.env will land."
      attribute :name,        Name
      attribute :description, Description
      attribute :directory,   Directory
      attribute :corpus_roots, CorpusRoots
      sets :name
      sets :description
      sets :directory
      sets :corpus_roots
      emits "Defined"
    end

    command "Retire" do
      role "Framework"
      goal "Remove a mindstream from the catalog. The :overmind capability stops emitting artifacts for it on the next regeneration."
      reference_to(Mindstream)
      emits "Retired"
    end
  end

  # ============================================================
  # MINDSTREAMMEMBER — one Procfile entry
  # ============================================================
  #
  # Each member is one process flowing in the mindstream. It becomes
  # one Procfile line and contributes (or not) to the mindstream's
  # OVERMIND_CAN_DIE list based on its lifespan.

  aggregate "MindstreamMember" do
    description "One Procfile entry — a single process flowing in the mindstream. Belongs to one Mindstream (references-not-ids : a stored Mindstream FK synthesised by belongs_to)."
    identified_by :name

    attribute :name,     Name
    attribute :command,  ShellCommand
    attribute :lifespan, Lifespan
    attribute :order,    MemberOrder

    reference_to Mindstream

    # ── Value-objects : the domain's language ──

    value_object "Name" do
      # The member's identifier inside its mindstream — becomes the
      # Procfile process name (the token before the colon on each
      # line). Duplicated from Mindstream.Name by design : the
      # discipline is per-aggregate VO sets, no shared envelope.
      attribute :value, String
    end

    # ShellCommand — the line overmind invokes from the Mindstream's
    # directory. Value object so the generator can interpolate, validate,
    # or rewrite the command line uniformly.
    value_object "ShellCommand" do
      attribute :line, String
    end

    # Lifespan — domain language for whether a process is one-shot
    # (allowed to exit cleanly ; flows into OVERMIND_CAN_DIE) or
    # persistent (must keep running ; overmind treats exit as crash).
    # The enum constraint forbids any other value at parse time ;
    # may_exit + restart_on_failure capture the semantic dimensions
    # the generator reads to produce overmind directives.
    value_object "Lifespan" do
      # `one_of:` (the inline single-attribute closed-set keyword) only
      # works when the value object has exactly one attribute -- Lifespan
      # has three, so it needs the bare `member` form instead (ADR 0025),
      # one line per valid combination. Every real usage in this corpus
      # (the `with lifespan: "{...}"` data below) only ever pairs kind
      # with the matching may_exit/restart_on_failure, so the closed set
      # is these two combinations, not the cross product of three
      # independent fields.
      attribute :kind,               String
      attribute :may_exit,           TrueClass
      attribute :restart_on_failure, TrueClass

      member kind: "one_shot",   may_exit: true,  restart_on_failure: false
      member kind: "persistent", may_exit: false, restart_on_failure: true
    end

    # MemberOrder — the member's position in the generated Procfile.
    # Establishment carries it so the projection is DETERMINISTIC :
    # the emitter sorts numerically, never by store iteration order.
    value_object "MemberOrder" do
      attribute :value, Integer
    end

    command "Register" do
      role "Framework"
      goal "Add (or re-assert — upserts on :name) a member of a mindstream. Inputs : the member name, the mindstream it joins, the shell command overmind invokes, its lifespan, and its Procfile order."
      attribute :name,       Name
      attribute :mindstream, Mindstream
      attribute :command,    ShellCommand
      attribute :lifespan,   Lifespan
      attribute :order,      MemberOrder
      sets :name
      sets :mindstream
      sets :command
      sets :lifespan
      sets :order
      emits "Registered"
    end

    command "Retire" do
      role "Framework"
      goal "Remove a member from supervision. The :overmind capability drops it from the next Procfile regeneration."
      reference_to(MindstreamMember)
      emits "Retired"
    end
  end

  # ============================================================
  # The boot mindstream as ESTABLISHMENT (fixtures→policies, 2026-07-26)
  # ============================================================
  #
  # Replaces miette/deploy/mindstream.fixtures. Define/Register upsert on
  # :name, so `storehouse establish <conception>` re-asserts the stream
  # idempotently ; the Procfile + .overmind.env artifacts project from the
  # ESTABLISHED records through the seam (`storehouse project procfile
  # <conception> --output-dir <deploy>` → projection::procfile) — never
  # from a fixtures file, never by hand. corpus_roots flows into
  # HECKS_PLAYGROUND_ADDITIONAL_CORPUS_ROOTS so the being-repo BootCompleted policies
  # (the system prompt sections) register in the completion corpus.
  # Bite : rust/tests/mindstream_establishment_test.rs.
  policy "EstablishBootMindstream" do
    on "BootCompleted"
    trigger Mindstream::Define, with: {
      name: "boot",
      description: "The Miette boot pipeline as a one-shot supervised mindstream. Runs the bluebook-defined organ wiring (DiscoverOrgans, WriteCensus, ClassifyStores, GenerateSystemPrompt, EnsureDaemons, PrintVitals, SurfaceWakeReport) and exits. The first Mindstream ; future Mindstreams (body cycles, integration tests, ...) drop in alongside it.",
      directory: "{ path: \"/Users/christopheryoung/Projects/hecks_playground/hecks_playground_conception\" }",
      corpus_roots: "{ value: \"/Users/christopheryoung/Projects/miette/self/system_prompt/bluebook\" }"
    }
  end

  policy "EstablishBootMember" do
    on "BootCompleted"
    trigger MindstreamMember::Register, with: {
      name: "boot",
      mindstream: "boot",
      command: "{ line: \"/Users/christopheryoung/.local/bin/storehouse run /Users/christopheryoung/Projects/hecks_playground/runtime/boot/bluebook/boot.bluebook\" }",
      lifespan: "{ kind: \"one_shot\", may_exit: true, restart_on_failure: false }",
      order: "1"
    }
  end

  policy "EstablishEstablishMember" do
    on "BootCompleted"
    trigger MindstreamMember::Register, with: {
      name: "establish",
      mindstream: "boot",
      command: "{ line: \"/Users/christopheryoung/.local/bin/storehouse establish /Users/christopheryoung/Projects/hecks_playground/hecks_playground_conception\" }",
      lifespan: "{ kind: \"one_shot\", may_exit: true, restart_on_failure: false }",
      order: "2"
    }
  end

  policy "EstablishHeartMember" do
    on "BootCompleted"
    trigger MindstreamMember::Register, with: {
      name: "heart",
      mindstream: "boot",
      command: "{ line: \"/Users/christopheryoung/.local/bin/storehouse loop /Users/christopheryoung/Projects/miette/body/.. Heart::Heart.Beat --every 1s\" }",
      lifespan: "{ kind: \"persistent\", may_exit: false, restart_on_failure: true }",
      order: "3"
    }
  end

  policy "EstablishBreathMember" do
    on "BootCompleted"
    trigger MindstreamMember::Register, with: {
      name: "breath",
      mindstream: "boot",
      command: "{ line: \"/Users/christopheryoung/.local/bin/storehouse loop /Users/christopheryoung/Projects/miette/body/.. Breath::Breath.Inhale,Breath::Breath.Exhale --every 4.5s\" }",
      lifespan: "{ kind: \"persistent\", may_exit: false, restart_on_failure: true }",
      order: "4"
    }
  end

  policy "EstablishCircadianMember" do
    on "BootCompleted"
    trigger MindstreamMember::Register, with: {
      name: "circadian",
      mindstream: "boot",
      command: "{ line: \"/Users/christopheryoung/.local/bin/storehouse clock /Users/christopheryoung/Projects/miette/body/.. --segment 5-6:Circadian::Circadian.MarkDawn --segment 7-11:Circadian::Circadian.MarkMorning --segment 12-16:Circadian::Circadian.MarkAfternoon --segment 17-19:Circadian::Circadian.MarkDusk --segment 20-4:Circadian::Circadian.MarkNight --poll 60s\" }",
      lifespan: "{ kind: \"persistent\", may_exit: false, restart_on_failure: true }",
      order: "5"
    }
  end

  policy "EstablishUltradianMember" do
    on "BootCompleted"
    trigger MindstreamMember::Register, with: {
      name: "ultradian",
      mindstream: "boot",
      command: "{ line: \"/Users/christopheryoung/.local/bin/storehouse loop /Users/christopheryoung/Projects/miette/body/.. Ultradian::Ultradian.EnterPeak,Ultradian::Ultradian.EnterTrough --every 5400s\" }",
      lifespan: "{ kind: \"persistent\", may_exit: false, restart_on_failure: true }",
      order: "6"
    }
  end

  policy "EstablishInboxMember" do
    on "BootCompleted"
    trigger MindstreamMember::Register, with: {
      name: "inbox",
      mindstream: "boot",
      command: "{ line: \"/Users/christopheryoung/.local/bin/storehouse loop /Users/christopheryoung/Projects/hecks_playground/hecks_playground_conception/aggregates Inbox::Inbox.Check --every 900s\" }",
      lifespan: "{ kind: \"persistent\", may_exit: false, restart_on_failure: true }",
      order: "7"
    }
  end

  policy "EstablishInboxPollerMember" do
    on "BootCompleted"
    trigger MindstreamMember::Register, with: {
      name: "inbox_poller",
      mindstream: "boot",
      command: "{ line: \"/Users/christopheryoung/.local/bin/storehouse drive /Users/christopheryoung/Projects/hecks_playground/hecks_playground_conception/aggregates --adapter InboxPollClock --poll 2s\" }",
      lifespan: "{ kind: \"persistent\", may_exit: false, restart_on_failure: true }",
      order: "8"
    }
  end

  policy "EstablishMindReconcileMember" do
    on "BootCompleted"
    trigger MindstreamMember::Register, with: {
      name: "mind_reconcile",
      mindstream: "boot",
      command: "{ line: \"/Users/christopheryoung/.local/bin/storehouse loop /Users/christopheryoung/Projects/mietteai MietteMind::Reconciler.Reconcile --every 5s\" }",
      lifespan: "{ kind: \"persistent\", may_exit: false, restart_on_failure: true }",
      order: "9"
    }
  end

  policy "EstablishProcessMacrophageMember" do
    on "BootCompleted"
    trigger MindstreamMember::Register, with: {
      name: "process_macrophage",
      mindstream: "boot",
      command: "{ line: \"/Users/christopheryoung/.local/bin/storehouse loop /Users/christopheryoung/Projects/hecks_playground/hecks_playground_conception/aggregates ProcessHealth::ProcessMacrophage.Sweep --every 30s\" }",
      lifespan: "{ kind: \"persistent\", may_exit: false, restart_on_failure: true }",
      order: "10"
    }
  end

  policy "EstablishConductorSweepMember" do
    on "BootCompleted"
    trigger MindstreamMember::Register, with: {
      name: "conductor_sweep",
      mindstream: "boot",
      command: "{ line: \"/Users/christopheryoung/.local/bin/storehouse loop /Users/christopheryoung/Projects/hecks_playground/hecks_playground_conception/aggregates Conductor::Sweeper.Tick sweeper_id=fleet --every 60s\" }",
      lifespan: "{ kind: \"persistent\", may_exit: false, restart_on_failure: true }",
      order: "11"
    }
  end

  policy "EstablishSpeechStreamMember" do
    on "BootCompleted"
    trigger MindstreamMember::Register, with: {
      name: "speech_stream",
      mindstream: "boot",
      command: "{ line: \"/Users/christopheryoung/.local/bin/storehouse loop /Users/christopheryoung/Projects/miette/body SpeechStream::SpeechStream.Advance --every 200ms\" }",
      lifespan: "{ kind: \"persistent\", may_exit: false, restart_on_failure: true }",
      order: "12"
    }
  end

  policy "EstablishServeSocketMember" do
    on "BootCompleted"
    trigger MindstreamMember::Register, with: {
      name: "serve_socket",
      mindstream: "boot",
      command: "{ line: \"/Users/christopheryoung/.local/bin/storehouse serve-socket /Users/christopheryoung/Projects/hecks_playground/hecks_playground_conception\" }",
      lifespan: "{ kind: \"persistent\", may_exit: false, restart_on_failure: true }",
      order: "13"
    }
  end

  policy "EstablishConsolidateMember" do
    on "BootCompleted"
    trigger MindstreamMember::Register, with: {
      name: "consolidate",
      mindstream: "boot",
      command: "{ line: \"/Users/christopheryoung/.local/bin/storehouse drive /Users/christopheryoung/Projects/hecks_playground/hecks_playground_conception/aggregates --adapter LogConsolidation --poll 5s\" }",
      lifespan: "{ kind: \"persistent\", may_exit: false, restart_on_failure: true }",
      order: "14"
    }
  end
end
