Hecks.bluebook "Primitive", version: "2026.05.22.1" do
  vision "The irreducible primitive standard library — the small closed set of bluebook commands bound to real side-effects, the ONLY hand-written imperative leaves in the runtime (later specializer-generated). This bluebook starts the floor with Process.Spawn : run a literal program to completion, capture (ok, output, exit_code), and chain the outcome into a result_into target (typically Cascade.RecordResult). It proves the bluebook path matches :exec semantics : instead of a hand-written resolve_exec_adapters arm, an ordinary bluebook policy fires Process.Spawn on a command's emitted event and the runtime's one generic primitive hook performs the spawn. The fibroblast repair sweep is migrated to this path (parity verified). resolve_exec_adapters STAYS for the un-migrated :exec bindings (Inbox.Check, ProcessMacrophage.Sweep, ProcessMacrophage.Heal) until trigger-on-command (gap #1b) lands — those commands emit events whose names collide across aggregates (Swept), so a name-matched policy can't disambiguate them yet. Per the locked 2026-05-12 conventions, every value object is declared INSIDE the aggregate that uses it."
  category "framework"

  # ============================================================
  # PRIMITIVE — the irreducible side-effect floor
  # ============================================================
  #
  # The adapters-as-bluebook arc (plan: structured-pondering-pie)
  # aims to reduce six hand-written imperative Rust resolvers
  # (resolve_*_adapters) to ONE policy/cascade pattern bottoming out
  # in a small primitive stdlib. This bluebook is the first floor
  # tile : Process.Spawn, the generic process-spawn primitive that
  # does what the :exec adapter family's resolver does — proven on
  # the fibroblast repair sweep (the :exec family's simplest member).
  #
  # ── How it fits ──
  #
  # Before : `adapter :exec, command: "Agg.Cmd", exec: "...", result_into:
  #   "HecksPlayground::Framework::Cascade::Cascade.RecordResult"` in a hecksagon, resolved by a bespoke
  #   resolve_exec_adapters arm in runtime/mod.rs.
  #
  # After (for migrated bindings — fibroblast today) : an ordinary
  #   bluebook `policy` fires on the command's emitted event and
  #   triggers `Primitive::Process.Spawn` with a literal `cmd` +
  #   `result_into`. The runtime's single generic primitive hook
  #   (resolve_primitive_spawn) detects the dispatched `Process.Spawn`,
  #   runs the literal program via the kernel-floor exec leaf
  #   (runtime/exec_dispatcher.rs — reused unchanged), and cascades
  #   (id, output, exit_code, ok) into `result_into`. The adapter
  #   PROTOCOL is now declarative bluebook ; only the spawn syscall
  #   stays imperative.
  #
  # ── Why the resolver stays (the wall) ──
  #
  # resolve_exec_adapters is NOT retired yet. Three :exec bindings
  # remain (Inbox.Check, ProcessMacrophage.Sweep, ProcessMacrophage.
  # Heal). Migrating them needs gap #1b — trigger-on-COMMAND, or
  # aggregate-scoped policy events. Policies today match by event NAME
  # globally, and `Swept` (ProcessMacrophage.Sweep's event) is ALSO
  # emitted by rust_to_bluebook_macrophage AND already consumed by the
  # MarkHangedOnMissingHeartbeat policy — a name-matched policy can't
  # fire ONLY for ProcessMacrophage.Sweep. The :exec resolver matches
  # the precise Aggregate.Command, so it stays for those bindings until
  # gap #1b lands. The fibroblast event was deliberately named SweepRan
  # (not Swept) precisely to dodge that collision, which is why it
  # could migrate first.
  #
  # ── Why no entities, why minimal state ──
  #
  # Each Spawn is an independent side-effect keyed by id ; no
  # sub-concept persists across commands. State stays tiny : id, the
  # command string, and the captured outcome. The outcome ALSO
  # cascades into `result_into` (the real landing pad) so the
  # Process record itself is just an audit row of the spawn.
  #
  # ── The cascade join key ──
  #
  # Process.Spawn carries an `id` — the originating invocation id (the
  # aggregate id of the command whose event the firing policy reacted
  # to). The primitive hook threads that same id into the
  # `result_into` cascade so the outcome record joins the originating
  # invocation by id, exactly as the retired :exec resolver did.

  aggregate "Process" do
    description "One process-spawn side-effect. Runs a literal program to completion, captures (ok, output, exit_code), records an audit row, and the primitive hook chains the outcome into result_into (typically Cascade.RecordResult), joinable by id."
    identified_by :id

    attribute :id,        Id
    attribute :cmd,       Cmd
    attribute :output,    Output
    attribute :exit_code, ExitCode
    attribute :ok_status, Ok

    value_object "Id" do
      # Invocation id — the originating command's aggregate id (the
      # aggregate whose emitted event the firing policy reacted to).
      # The primitive hook threads this same id into the result_into
      # cascade so the outcome joins the originating invocation by id.
      attribute :value, String
    end

    value_object "Cmd" do
      # The literal program string to run, verbatim — e.g.
      # "bash bin/fibroblast_sweep.sh". Split on whitespace into
      # program + args by the exec leaf (no shell ; no pipes /
      # redirects — put compound logic inside a script file). cwd +
      # env are inherited from the runtime process.
      attribute :value, String
    end

    value_object "Output" do
      # Captured stdout from the spawn ; on non-zero exit the leaf
      # appends stderr so the failure is legible. Capped at 100 KB by
      # the leaf, same as the web_tool / exec dispatchers.
      attribute :value, String
    end

    value_object "ExitCode" do
      # Process exit code. 0 conventionally means success.
      attribute :value, Integer
    end

    value_object "Ok" do
      # Coarse-grained success flag — true iff exit_code == 0.
      attribute :value, Boolean
    end

    # ── Process : Spawn (the generic process-spawn primitive) ──
    command "Spawn" do
      role "System"
      goal "Run a literal program to completion, capture (ok, output, exit_code), and chain the outcome into result_into. The runtime's generic primitive hook (resolve_primitive_spawn) performs the spawn via the kernel-floor exec leaf and cascades the captured outcome into the result_into target carrying the same id. Emits Spawned so the audit row is a first-class event."
      attribute :id,          Id
      attribute :cmd,         Cmd
      attribute :result_into, ResultInto
      emits "Spawned"
      sets :id
      sets :cmd
    end

    value_object "ResultInto" do
      # The cascade landing target — the FQN-or-short-form command the
      # primitive hook chains the captured outcome into (typically
      # "HecksPlayground::Framework::Cascade::Cascade.RecordResult"). Carried on the Spawn command only ;
      # not persisted onto Process state (it is routing, not data).
      attribute :value, String
    end
  end

  aggregate "Compute" do
    description "One local compute-function side-effect — the pure-local sibling of Process. Invoke resolves a named function from the runtime's compute_functions registry, runs it against the caller-supplied attrs (+ data_dir), records an audit row, and the primitive hook chains the returned text into response_into_target(response_into_attr) joinable by id. The :compute hecksagon adapter family is SUGAR over this primitive (reaction.rs resolve_compute_adapters synthesizes Invoke per matched binding), exactly as :exec is sugar over Process.Spawn — this declaration retires the bespoke resolve_compute_adapters_with_excluded resolver that lived in runtime/mod.rs. Name + signature match the seeded Storehouse::Primitive record Compute.Invoke (kind compute, impl compute_dispatcher)."
    identified_by :id

    attribute :id,            Id
    attribute :function_name, FunctionName

    value_object "Id" do
      # Invocation id — the originating command's aggregate id (the
      # aggregate whose dispatch the sugar reacted to). The primitive
      # hook threads this same id into the response_into cascade so the
      # outcome joins the originating invocation, exactly as Process.Spawn.
      attribute :value, String
    end

    value_object "FunctionName" do
      # Registry key into the runtime's compute_functions library
      # (e.g. "tokenize_dream_corpus"). An unregistered name is a
      # Skipped outcome — no cascade fires — mirroring the hecksagon
      # adapter family's Skipped path.
      attribute :value, String
    end

    command "Invoke" do
      role "System"
      goal "Run a named registry function to completion and chain the returned text into response_into_target carrying response_into_attr. The generic primitive hook (reaction.rs resolve_primitive_compute) resolves the function through the compute_dispatcher leaf — reused unchanged, the only imperative Rust on this path — and cascades the response with the same id, exactly as Process.Spawn does for programs. Emits ComputeInvoked so the audit row is a first-class event."
      attribute :id,                   Id
      attribute :function_name,        FunctionName
      attribute :response_into_target, ResponseIntoTarget
      attribute :response_into_attr,   ResponseIntoAttr
      emits "ComputeInvoked"
      sets :id
      sets :function_name
    end

    value_object "ResponseIntoTarget" do
      # The cascade landing target ("Aggregate.Command") the hook chains
      # the returned text into. Routing, not data — carried on the Invoke
      # command only, never persisted onto Compute state.
      attribute :value, String
    end

    value_object "ResponseIntoAttr" do
      # The attribute name on the landing command that carries the
      # returned text. Routing, not data — not persisted.
      attribute :value, String
    end
  end

  aggregate "McpTool" do
    description "One MCP tool-call side-effect — the remote-protocol sibling of Process and Compute. Invoke resolves the named server (a .world-declared server routes as an mcp_dispatch_requested event to the harness-side transport ; a locally-spawnable server runs through the stdio MCP session), calls the tool with the FINAL substituted arguments JSON, records an audit row, and the primitive hook chains (id, tool, output, exit_code, ok) into result_into. The :mcp hecksagon adapter family is SUGAR over this primitive (reaction.rs resolve_mcp_adapters substitutes {attr} placeholders from upstream state + dispatch attrs, then synthesizes Invoke per matched binding) — this declaration retires the bespoke resolve_mcp_adapters resolver that lived in runtime/mod.rs. Name + signature match the seeded Storehouse::Primitive record McpTool.Invoke (kind mcp_tool, impl mcp_dispatcher)."
    identified_by :id

    attribute :id,     Id
    attribute :server, Server
    attribute :tool,   Tool

    value_object "Id" do
      # Invocation id — the originating command's aggregate id. The
      # primitive hook threads this same id into the result_into cascade
      # so the outcome joins the originating invocation, exactly as
      # Process.Spawn and Compute.Invoke.
      attribute :value, String
    end

    value_object "Server" do
      # The MCP server the tool call routes to — either declared in a
      # project's .world `mcp` block (transport-C : the harness-side
      # subscriber owns the session) or a locally-spawnable stdio server.
      # A server that is neither logs a warning and skips — the dispatch
      # still lands, mirroring the retired resolver's graceful guard.
      attribute :value, String
    end

    value_object "Tool" do
      # The MCP tool name (`tools/call` target) on the resolved server.
      attribute :value, String
    end

    command "Invoke" do
      role "System"
      goal "Call an MCP tool to completion and chain (id, tool, output, exit_code, ok) into result_into. The generic primitive hook (reaction.rs resolve_primitive_mcp) routes a .world-declared server to the harness transport or a spawnable server through the kernel-floor mcp_dispatcher leaf — reused unchanged, the only imperative Rust on this path — and cascades the outcome with the same id. arguments carries the FINAL JSON payload (placeholder substitution is the sugar's composition step, not the primitive's). Emits McpToolInvoked so the audit row is a first-class event."
      attribute :id,          Id
      attribute :server,      Server
      attribute :tool,        Tool
      attribute :arguments,   Arguments
      attribute :result_into, ResultInto
      emits "McpToolInvoked"
      sets :id
      sets :server
      sets :tool
    end

    value_object "Arguments" do
      # The JSON-encoded MCP `arguments` payload, ALREADY substituted —
      # the primitive receives the final call, never a template. Routing
      # payload, not persisted onto McpTool state.
      attribute :value, String
    end

    value_object "ResultInto" do
      # The cascade landing target ("Aggregate.Command") the hook chains
      # the tool outcome into. Routing, not data — not persisted.
      attribute :value, String
    end
  end

  aggregate "ClaudeTool" do
    description "One native tool-call side-effect — shell / edit / read / write / grep / glob, the Tools.* primitives. Invoke runs the named tool against the caller-supplied attrs (shell_command, file_path, …), records an audit row, and the primitive hook chains (id, tool, output, exit_code, ok) into result_into. The :claude_tool hecksagon adapter family is SUGAR over this primitive (reaction.rs resolve_claude_tool_adapters builds the attrs from upstream state + dispatch overlay, then synthesizes Invoke per matched binding) — this declaration retires the bespoke resolve_claude_tool_adapters resolver that lived in runtime/mod.rs. Name + signature match the seeded Storehouse::Primitive record ClaudeTool.Invoke (kind claude_tool, impl claude_tool_dispatcher)."
    identified_by :id

    attribute :id,   Id
    attribute :tool, Tool

    value_object "Id" do
      # Invocation id — the originating command's aggregate id, threaded
      # into the result_into cascade so the outcome (typically
      # Cascade.RecordResult) joins the originating invocation, exactly
      # as Process.Spawn / Compute.Invoke / McpTool.Invoke.
      attribute :value, String
    end

    value_object "Tool" do
      # The native tool name : bash | edit | read | write | grep | glob.
      # An unknown name returns ok=false through the dispatcher — never a
      # panic — mirroring the retired resolver's contract.
      attribute :value, String
    end

    command "Invoke" do
      role "System"
      goal "Run a native tool to completion and chain (id, tool, output, exit_code, ok) into result_into. The generic primitive hook (reaction.rs resolve_primitive_claude_tool) runs the kernel-floor claude_tool_dispatcher leaf — reused unchanged, the only imperative Rust on this path — and cascades the outcome with the same id. The tool's own inputs (shell_command, file_path, old_string, …) ride the Invoke dispatch attrs verbatim. Emits ClaudeToolInvoked so the audit row is a first-class event."
      attribute :id,          Id
      attribute :tool,        Tool
      attribute :result_into, ResultInto
      emits "ClaudeToolInvoked"
      sets :id
      sets :tool
    end

    value_object "ResultInto" do
      # The cascade landing target ("Aggregate.Command") the hook chains
      # the tool outcome into. Routing, not data — not persisted.
      attribute :value, String
    end
  end

  aggregate "Llm" do
    description "One LLM completion side-effect — the language-model sibling of Process / Compute / McpTool / ClaudeTool. Invoke resolves the backend provider, runs the FINAL prompt to completion, records an audit row, and the primitive hook chains the response text into response_into_target(response_into_attr). The :llm hecksagon adapter family is SUGAR over this primitive (reaction.rs resolve_llm_adapters composes — cross-aggregate {{placeholder}} substitution via the adapter's prompt_template — then invokes ; the keystone effect-binding switch and the fired-set chain recursion live in the sugar) — this declaration retires the bespoke resolve_llm_adapters_with_excluded resolver that lived in runtime/mod.rs. Name + signature match the seeded Storehouse::Primitive record Llm.Invoke (kind llm, impl llm_dispatcher)."
    identified_by :id

    attribute :id,      Id
    attribute :backend, Backend

    value_object "Id" do
      # Invocation id — the originating command's aggregate id, threaded
      # into the response cascade so the outcome joins the originating
      # invocation, exactly as the sibling primitives.
      attribute :value, String
    end

    value_object "Backend" do
      # The provider the completion routes to (claude / ollama / test /
      # fixture). Absent -> the dispatcher's default backend.
      attribute :value, String
    end

    command "Invoke" do
      role "System"
      goal "Run a prompt to completion on the resolved backend and chain the response text into response_into_target carrying response_into_attr. The generic primitive hook (reaction.rs resolve_primitive_llm) runs the kernel-floor llm_dispatcher leaf — reused unchanged, the only imperative Rust on this path — and cascades the response. prompt carries the FINAL text (placeholder substitution is the sugar's composition step) ; model / backend are optional overrides. Emits LlmInvoked so the audit row is a first-class event."
      attribute :id,                   Id
      attribute :prompt,               Prompt
      attribute :model,                Model
      attribute :backend,              Backend
      attribute :response_into_target, ResponseIntoTarget
      attribute :response_into_attr,   ResponseIntoAttr
      emits "LlmInvoked"
      sets :id
      sets :backend
    end

    value_object "Prompt" do
      # The FINAL prompt text — already substituted. The primitive never
      # sees a template ; composition is the sugar's job.
      attribute :value, String
    end

    value_object "Model" do
      # Optional model override (sonnet / opus / a local tag). Absent ->
      # the provider's default.
      attribute :value, String
    end

    value_object "ResponseIntoTarget" do
      # The cascade landing target ("Aggregate.Command") for the response
      # text. Routing, not data — not persisted.
      attribute :value, String
    end

    value_object "ResponseIntoAttr" do
      # The attribute name on the landing command that carries the
      # response text. Routing, not data — not persisted.
      attribute :value, String
    end
  end
end
