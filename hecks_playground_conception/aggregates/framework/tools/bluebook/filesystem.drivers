# Driving/driven adapter declarations moved out of filesystem.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word and no success/failure
# routing on spawned_by binds. Kept verbatim as the spec for an upstream hecks
# feature. Nothing loads this file.

# spawned_by success/failure routing (the bare bind stays in the .hecksagon):
  Filesystem::Filesystem.spawned_by("FsFileMove", on: "FileMoved") do
    success "Cascade::Cascade.RecordResult"
    failure "Cascade::Cascade.RecordResult"
  end

  Filesystem::Filesystem.spawned_by("FsFileRemove", on: "FileRemoved") do
    success "Cascade::Cascade.RecordResult"
    failure "Cascade::Cascade.RecordResult"
  end

  Filesystem::Filesystem.spawned_by("FsFileReadRange", on: "FileRangeRead") do
    success "Cascade::Cascade.RecordResult"
    failure "Cascade::Cascade.RecordResult"
  end

  Filesystem::Filesystem.spawned_by("FsDirCreate", on: "DirectoryCreated") do
    success "Cascade::Cascade.RecordResult"
    failure "Cascade::Cascade.RecordResult"
  end

  Filesystem::Filesystem.spawned_by("FsDirRemove", on: "DirectoryRemoved") do
    success "Cascade::Cascade.RecordResult"
    failure "Cascade::Cascade.RecordResult"
  end

  Filesystem::Filesystem.spawned_by("FsDirList", on: "DirectoryListed") do
    success "Cascade::Cascade.RecordResult"
    failure "Cascade::Cascade.RecordResult"
  end
