Hecks.hecksagon "Filesystem" do
  uses_framework "Governance"
  Filesystem::Filesystem.persisted_by("Heki")

  # Impure edges, hecksagon-first : each Filesystem command shells its OS op and
  # cascades the output. Re-expressed (i780, 2026-08-17) from the retired
  # `adapter :exec` kwargs form onto the spawn effect port. The bind stays on
  # the PARENT aggregate (Filesystem::Filesystem) even though the triggering
  # commands are entity-scoped (File.Move / Directory.Remove) — events are
  # attributed to the owning aggregate, not the entity, same as every other
  # emitted event here.
  Filesystem::Filesystem.spawned_by("FsFileMove", on: "FileMoved")
  Filesystem::Filesystem.spawned_by("FsFileRemove", on: "FileRemoved")
  Filesystem::Filesystem.spawned_by("FsFileReadRange", on: "FileRangeRead")
  Filesystem::Filesystem.spawned_by("FsDirCreate", on: "DirectoryCreated")
  Filesystem::Filesystem.spawned_by("FsDirRemove", on: "DirectoryRemoved")
  Filesystem::Filesystem.spawned_by("FsDirList", on: "DirectoryListed")
end
