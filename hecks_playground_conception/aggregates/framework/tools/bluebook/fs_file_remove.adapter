# FsFileRemove — a concrete async SPAWN adapter (i780) : re-expresses a retired
# `adapter :exec` kwargs binding on the spawn effect port. handler is the
# exact shell command the old :exec field carried, unchanged --
# bin/adapter-host runs it via `/bin/sh -c`.
#
# Resolves IFF this adapter's declared port (spawn) carries the
# `spawned_by` verb.
Hecks.adapter "FsFileRemove" do
  port "spawn"
  handler "bin/filesystem_file_remove"
end
