# Driving/driven adapter declarations moved out of tools.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word (no interval/cron
# drivers, no `driven on` reactions). Kept verbatim as the spec for an
# upstream hecks feature. Nothing loads this file.

  adapter :memory

  adapter :web_tool, command: "HecksPlayground::Framework::Tools::WebTool.WebFetch",  tool: :web_fetch,  result_into: "HecksPlayground::Framework::Cascade::Cascade.RecordResult"

  adapter :web_tool, command: "HecksPlayground::Framework::Tools::WebTool.WebSearch", tool: :web_search, result_into: "HecksPlayground::Framework::Cascade::Cascade.RecordResult"

# spawned_by success/failure routing (the bare bind stays in the .hecksagon):
  Tools::Sidequest.spawned_by("SidequestRun", on: "SidequestDispatched") do
    success "Cascade::Cascade.RecordResult"
    failure "Cascade::Cascade.RecordResult"
  end
