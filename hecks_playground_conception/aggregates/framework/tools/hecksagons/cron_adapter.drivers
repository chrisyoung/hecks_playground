# Driving/driven adapter declarations moved out of cron_adapter.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word (no interval/cron
# drivers, no `driven on` reactions). Kept verbatim as the spec for an
# upstream hecks feature. Nothing loads this file.

  adapter "CronAdapter" do
    driving on cron "*/5 * * * *" do |signal|
      dispatch "Tools::TaskTool.Get",
               id: "cron-adapter-smoke",
               task_id: "cron-adapter-smoke-task",
               description: "Cron adapter smoke check"
    end
  end
