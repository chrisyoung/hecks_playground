# Driving/driven adapter declarations moved out of interval_adapter.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word (no interval/cron
# drivers, no `driven on` reactions). Kept verbatim as the spec for an
# upstream hecks feature. Nothing loads this file.

  adapter "IntervalAdapter" do
    driving on interval "2s" do |signal|
      dispatch "Tools::TaskTool.Get",
               id: "interval-adapter-smoke",
               task_id: "interval-adapter-smoke-task",
               description: "Interval adapter smoke check"
    end
  end
