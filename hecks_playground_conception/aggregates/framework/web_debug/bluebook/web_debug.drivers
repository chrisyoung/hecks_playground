# Driving/driven adapter declarations moved out of web_debug.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word and no success/failure
# routing on spawned_by binds. Kept verbatim as the spec for an upstream hecks
# feature. Nothing loads this file.

# bind success/failure routing (the bare bind stays in the .hecksagon):
  WebDebug::Screenshot.buffered_by("DiskBuffer", on: "FrameCaptured") do
    success "Screenshot.RecordStored"
  end
