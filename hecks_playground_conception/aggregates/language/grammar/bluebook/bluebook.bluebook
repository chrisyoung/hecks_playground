Hecks.bluebook "BluebookGrammar", version: "2026.05.12.1" do
  # RENAMED from "Bluebook" during hecksagain migration (task 4): a genuine
  # domain-name collision with aggregates/framework/bluebook/bluebook.bluebook
  # (the meta-bluebook that reads/renders bluebooks -- a different domain
  # from this self-hosted grammar description). hecksagain's Registry
  # requires globally-unique domain names when composed together; the old
  # Rust runtime never caught this. See migration plan Part 4/Part 5.
  vision "Bluebook describing itself — the IR shape every parser must produce"

  # ============================================================
  # The IR contract.
  # ============================================================
  #
  # This bluebook is the canonical description of what a parsed .bluebook
  # IR contains. Both the Ruby DSL parser (lib/hecks_playground/dsl/) and the Rust
  # parser (rust/src/parser.rs) must produce structures matching
  # the shape declared here.
  #
  # The Domain aggregate is the sole root of the IR tree. Every other
  # IR concept is an entity owned by Domain — they have identity within
  # a Domain boundary but are not independently dispatchable aggregates.
  # This matches Evans's DDD : a single aggregate root with reachable
  # entities, not a flat list of peer aggregates.
  #
  # When parity drift surfaces (see parity/parity_test.rb), the
  # divergence is either a parser bug or — more rarely — a change to
  # this file. Update this file FIRST when adding a real new IR concept,
  # then teach both parsers to produce it.
  #
  # This domain is not booted as a runtime organ — it carries no live
  # state. It documents shape.
  #
  # 2026-05-12 : Domain's own surface attributes (name, category,
  # vision) wrapped in typed value-objects per the no-primitive-envy
  # rule, mirroring the macrophage / antibody / mindstream sweeps.
  # Per-aggregate VO sets — no bluebook-level VOs. Entity inner
  # attributes (Aggregate.name, Attribute.type, etc.) are
  # intentionally left as primitives : the no_primitive_envy
  # validator only scans aggregate-root and command surfaces, and
  # those inner attrs describe the SHAPE of the IR — they ARE the
  # primitive contract every parser must produce.

  aggregate "Domain" do
    description "The top of the IR tree — name + all aggregates + cross-cutting policies/fixtures"
    identified_by :name

    attribute :name,     Name
    attribute :category, Category
    attribute :vision,   Vision

    # ── Value-objects : the meta-bluebook's own language ──

    value_object "Name" do
      # The Domain's identifier — the string passed to
      # `Hecks.bluebook "<Name>"`. Used as the identified_by key
      # in the IR and as the canonical name every parser must
      # round-trip unchanged.
      attribute :value, String
    end

    value_object "Category" do
      # The Domain's category label (e.g. 'framework', 'language',
      # 'meta', 'capability'). A coarse classifier the workshop UI
      # uses to group aggregates ; not enforced as an enum here
      # because new categories are added freely.
      attribute :value, String
    end

    value_object "Vision" do
      # Free-form prose stating what the domain is for. Surfaces
      # in dashboards and the conceive flow so a reader knows the
      # purpose of the bluebook before reading its structure.
      attribute :value, String
    end

    # Single-field value objects for entity attributes: hecks 1.3.0 allows
    # primitives only inside value objects.
    value_object "AggregateNameText" do
      attribute :value, String
    end

    value_object "AttributesText" do
      attribute :value, String
    end

    value_object "CommandText" do
      attribute :value, String
    end

    value_object "DefaultText" do
      attribute :value, String
    end

    value_object "DescriptionText" do
      attribute :value, String
    end

    value_object "DomainText" do
      attribute :value, String
    end

    value_object "EmitsText" do
      attribute :value, String
    end

    value_object "ExpressionText" do
      attribute :value, String
    end

    value_object "FieldText" do
      attribute :value, String
    end

    value_object "FromStateText" do
      attribute :value, String
    end

    value_object "ListText" do
      attribute :value, String
    end

    value_object "MessageText" do
      attribute :value, String
    end

    value_object "OnEventText" do
      attribute :value, String
    end

    value_object "OpText" do
      attribute :value, String
    end

    value_object "ProducesText" do
      attribute :value, String
    end

    value_object "RefText" do
      attribute :value, String
    end

    value_object "RoleText" do
      attribute :value, String
    end

    value_object "TargetDomainText" do
      attribute :value, String
    end

    value_object "TargetText" do
      attribute :value, String
    end

    value_object "ToStateText" do
      attribute :value, String
    end

    value_object "TriggerCommandText" do
      attribute :value, String
    end

    value_object "TypeText" do
      attribute :value, String
    end

    value_object "ValueText" do
      attribute :value, String
    end


    entity "Aggregate" do
      identified_by :name
      description "A DDD aggregate root — attributes, value objects, commands, queries, lifecycle"
      attribute :name, Name
      attribute :description, DescriptionText
    end

    entity "Attribute" do
      identified_by :name
      description "A typed field on an aggregate, value object, or command"
      attribute :name, Name
      attribute :type, TypeText
      attribute :list, ListText
      attribute :default, DefaultText
    end

    entity "ValueObject" do
      identified_by :name
      description "An immutable embedded structure within an aggregate"
      attribute :name, Name
      attribute :description, DescriptionText
    end

    entity "Reference" do
      identified_by :name
      description "A typed pointer from one aggregate or command to another aggregate"
      attribute :name, Name
      attribute :target, TargetText
      attribute :domain, DomainText
    end

    entity "Command" do
      identified_by :name
      description "A transition on an EXISTING aggregate instance — load by universal id, operate, emit. Births belong to Factory, the sibling entity ; a Command never mints."
      attribute :name, Name
      attribute :description, DescriptionText
      attribute :role, RoleText
      attribute :emits, EmitsText
    end

    entity "Factory" do
      identified_by :name
      description "A birth — mints a NEW aggregate instance, error if the id already exists. Declared with the `factory` keyword inside the aggregate that OWNS creation (Evans : creation lives where the knowledge lives, not necessarily on the created thing). Carries its own attributes and creation givens ; supersedes the Command.creates bool and the is_create name-heuristic (2026-06-12 locked design : docs/designs/first-class-factories.md)."
      attribute :name, Name
      attribute :description, DescriptionText
      attribute :role, RoleText
      # produces : the aggregate this factory births. Defaults to the
      # ENCLOSING aggregate ; `produces:` names another (Backlog drafts
      # Story) — the cross-aggregate case the creates-bool could not say.
      attribute :produces, ProducesText
      attribute :emits, EmitsText
    end

    entity "Query" do
      identified_by :name
      description "A read-side projection on an aggregate — pure, no side effects"
      attribute :name, Name
      attribute :description, DescriptionText
    end

    entity "Given" do
      identified_by :ref
      description "A precondition checked before a command executes — pure UL expression"
      attribute :ref, RefText
      attribute :expression, ExpressionText
      attribute :message, MessageText
    end

    entity "Mutation" do
      identified_by :ref
      description "A declared state change — set, append, increment, decrement, toggle"
      attribute :ref, RefText
      attribute :field, FieldText
      attribute :op, OpText
      attribute :value, ValueText
    end

    entity "Lifecycle" do
      identified_by :field
      description "The state machine of an aggregate — field, default state, transitions"
      attribute :field, FieldText
      attribute :default, DefaultText
    end

    entity "Transition" do
      identified_by :command
      description "One arrow in a lifecycle — command, source state(s), target state"
      attribute :command, CommandText
      attribute :to_state, ToStateText
      attribute :from_state, FromStateText
    end

    entity "Policy" do
      identified_by :name
      description "A reactive wire — when EVENT fires on aggregate A, trigger COMMAND on aggregate B"
      attribute :name, Name
      attribute :on_event, OnEventText
      attribute :trigger_command, TriggerCommandText
      attribute :target_domain, TargetDomainText
    end

    entity "Fixture" do
      identified_by :aggregate_name
      description "A canonical instance of an aggregate seeded with the bluebook"
      attribute :aggregate_name, AggregateNameText
      attribute :attributes, AttributesText
    end
  end

  # ============================================================
  # Mutation operation kinds — the only legal `op` values.
  # ============================================================

end
