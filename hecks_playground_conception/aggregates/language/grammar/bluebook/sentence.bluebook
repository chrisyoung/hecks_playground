Hecks.bluebook "Sentence", version: "2026.05.12.1" do
  vision "One thing a being can say that maps to a command — a single executable utterance, addressed Realm[::Subrealm…]::Domain::Aggregate.command (the folder tree IS the namespace IS the storage key)"
  category "language"

  # ============================================================
  # SENTENCE — a single executable utterance
  # ============================================================
  #
  # Lifted out of vocabulary.bluebook in i112. Sibling aggregates
  # moved to language/ : composition, acl, lexicon. The CompileOnDefine
  # policy follows its trigger target (Compile) into lexicon.bluebook.
  #
  # 2026-05-12 : primitives wrapped in typed value-objects per the
  # no-primitive-envy discipline.

  aggregate "Sentence" do
    description "One thing a being can say that maps to a command"
    identified_by :phrase
    attribute :phrase, Phrase
    attribute :realm, RealmName
    attribute :subrealms, list_of(SubrealmName)
    attribute :domain, DomainName
    attribute :command, CommandName
    attribute :aggregate, AggregateName
    attribute :actor, ActorName
    attribute :parameters, list_of(ParameterName)
    attribute :translations, list_of(NaturalPhrase)

    # ── Value-objects : the sentence's vocabulary ──

    value_object "Phrase" do
      # The dotted sayable form — e.g. "Order.Place". The
      # identified_by key for one Sentence.
      attribute :value, String
    end

    value_object "RealmName" do
      # The outermost namespace segment — the project / top folder
      # (HecksPlayground, Miette, MietteAi). First segment of the realm-qualified
      # address Realm[::Subrealm…]::Domain::Aggregate.command, derived from
      # the top of the folder tree.
      attribute :value, String
    end

    value_object "SubrealmName" do
      # One intermediate folder between the Realm and the Domain — a nested
      # realm. Zero or more, ordered outermost-first ; the variable middle
      # of the address. Realms nest recursively, like folders / packages.
      attribute :value, String
    end

    value_object "DomainName" do
      # The bluebook domain the sentence originates from (the bounded
      # context) — the second-to-last address segment.
      attribute :value, String
    end

    value_object "CommandName" do
      # The aggregate's verb this sentence maps to — one of the THREE
      # utterance kinds : a command (transition on an existing instance),
      # a query (pure read), or a factory (birth — mints a new instance ;
      # first-class as of the 2026-06-12 factories design).
      attribute :value, String
    end

    value_object "AggregateName" do
      # The aggregate the sentence is rooted in.
      attribute :value, String
    end

    value_object "ActorName" do
      # The Role / actor permitted to say this sentence (Chris,
      # System, Miette, etc.).
      attribute :value, String
    end

    value_object "ParameterName" do
      # The name of one parameter the sentence carries — a member
      # of the bluebook command's attribute list.
      attribute :value, String
    end

    value_object "NaturalPhrase" do
      # A natural-language way a human might actually utter this
      # sentence ; one per translation entry.
      attribute :value, String
    end

    command "Define" do
      role "System"
      goal "Register a single valid sentence from a bluebook command"
      attribute :phrase, Phrase
      attribute :realm, RealmName
      attribute :subrealms, list_of(SubrealmName)
      attribute :domain, DomainName
      attribute :command, CommandName
      attribute :aggregate, AggregateName
      attribute :actor, ActorName
      attribute :parameters, list_of(ParameterName)
      emits "SentenceDefined"
      sets :phrase
      sets :realm
      sets :subrealms
      sets :domain
      sets :command
      sets :aggregate
      sets :actor
      sets :parameters
    end

    command "Translate" do
      role "Linguist"
      goal "Add a natural language translation — how a human would actually say it"
      reference_to(Sentence)
      attribute :natural_phrase, NaturalPhrase
      emits "TranslationAdded"
      sets :translations, append: { value: :natural_phrase }
    end
  end
end
