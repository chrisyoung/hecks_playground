Hecks.bluebook "LocalModel", version: "2026.04.28.1" do
  vision "The locally-running model that receives the context — ollama, llama.cpp, or vllm"

  # ============================================================
  # LOCAL MODEL — the LLM serving inference
  # ============================================================
  #
  # Lifted out of inference.bluebook in i112. Sibling aggregates
  # moved to language/ : context_window, few_shot, prompt.

  aggregate "LocalModel" do
    description "The locally-running model that receives the context"
    identified_by :name
    attribute :name,           Name
    attribute :context_length, ContextLength
    attribute :serving,        ServingState
    attribute :backend,        Backend

    value_object "Name" do
      # Model identifier (e.g. 'llama3.1:8b') — the value the backend recognises.
      attribute :value, String
    end

    value_object "ContextLength" do
      # Max number of tokens the model accepts in a single inference call.
      attribute :value, Integer
    end

    value_object "ServingState" do
      # Lifecycle marker ('running' / 'stopped') for the local process.
      attribute :value, String
    end

    value_object "Backend" do
      # Which local serving stack hosts the model — 'ollama', 'llama.cpp', 'vllm'.
      attribute :value, String
    end

    command "StartModel" do
      role "System"
      goal "Launch the local model — ollama, llama.cpp, or vllm"
      attribute :name,           Name
      attribute :context_length, ContextLength
      attribute :backend,        Backend
      emits "ModelStarted"
      sets :name
      sets :context_length
      sets :backend
      sets :serving,        to: "running"
    end
  end
end
