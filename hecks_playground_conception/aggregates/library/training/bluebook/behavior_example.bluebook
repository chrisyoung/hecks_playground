Hecks.bluebook "BehaviorExample", version: "2026.04.28.1" do
  vision "A specific behavior Miette exhibits — paired with the organ that governs it"
  category "meta"

  # Lifted out of training_corpus.bluebook in i112 split.

  aggregate "BehaviorExample" do
    description "A specific behavior Miette exhibits — paired with the organ that governs it"
    identified_by :behavior
    attribute :behavior,       Behavior
    attribute :organ_name,     OrganName
    attribute :trigger,        Trigger
    attribute :example_input,  ExampleInput
    attribute :example_output, ExampleOutput

    value_object "Behavior" do
      # Short slug naming the behavior (e.g. 'reply_in_french').
      attribute :value, String
    end

    value_object "OrganName" do
      # The organ that governs this behavior.
      attribute :value, String
    end

    value_object "Trigger" do
      # What event / phrase / state triggers this behavior.
      attribute :value, String
    end

    value_object "ExampleInput" do
      # A representative input that would elicit the behavior.
      attribute :value, String
    end

    value_object "ExampleOutput" do
      # The behavior's expected output for the example input.
      attribute :value, String
    end

    command "RecordBehavior" do
      role "System"
      goal "Capture a behavior-to-organ mapping as training data"
      attribute :behavior,       Behavior
      attribute :organ_name,     OrganName
      attribute :trigger,        Trigger
      attribute :example_input,  ExampleInput
      attribute :example_output, ExampleOutput
      emits "BehaviorRecorded"
      sets :behavior
      sets :organ_name
      sets :trigger
      sets :example_input
      sets :example_output
    end
  end
end
