Hecks.behaviors "TrainingCorpus" do
  vision "Behavioral tests for the TrainingCorpus domain — exercises every command and query in memory"

  # ── Corpus aggregate ──────────────────────────────────────────

  test "BuildCorpus sets total_domains + format" do
    tests "BuildCorpus", on: "Corpus"
    input  name: "sample", total_domains: 1, format: "sample"
    expect name: "sample", total_domains: 1, format: "sample"
  end

  test "BuildCorpus cascades through policy chain" do
    tests "TrainingCorpus::Corpus.BuildCorpus", on: "Corpus", kind: :cross_cascade
    input  name: "sample-cascade", total_domains: 1, format: "sample"
    expect emits: ["CorpusBuilt", "DomainsEnriched"]
  end


  # ── QualityTier aggregate ──────────────────────────────────────────

  test "DefineTier sets name + source + description" do
    tests "QualityTier::QualityTier.DefineTier", on: "QualityTier", kind: :cross_cascade
    input  name: "sample", source: "sample", description: "sample"
    expect name: "sample", source: "sample", description: "sample"
  end


  # ── TrainingPair aggregate ──────────────────────────────────────────

  test "MintPair sets bluebook_source + ir_json + valid + tier" do
    tests "TrainingPairCorpus::TrainingPair.MintPair", on: "TrainingPair", kind: :cross_cascade
    input  ref: "sample", bluebook_source: "sample", ir_json: "sample", valid: "sample", tier: "sample"
    expect ref: "sample", bluebook_source: "sample", ir_json: "sample", valid: "sample", tier: "sample"
  end


  # ── Enrichment aggregate ──────────────────────────────────────────

  test "EnrichDomains sets strategy + domains_enriched" do
    tests "Enrichment::Enrichment.EnrichDomains", on: "Enrichment", kind: :cross_cascade
    input  name: "enrichment", strategy: "sample", domains_enriched: 1
    expect name: "enrichment", strategy: "sample", domains_enriched: 1
  end


  # ── ModelSpec aggregate ──────────────────────────────────────────

  test "DefineModel sets name + capabilities + input_format + output_format" do
    tests "ModelSpec::ModelSpec.DefineModel", on: "ModelSpec", kind: :cross_cascade
    input  name: "sample", capabilities: ["sample"], input_format: "sample", output_format: "sample"
    expect name: "sample", capabilities: ["sample"], input_format: "sample", output_format: "sample"
  end


  # ── ConversationTranscript aggregate ──────────────────────────────────────────

  test "RecordTranscript sets person + turns + domains_conceived" do
    tests "ConversationTranscript::ConversationTranscript.RecordTranscript", on: "ConversationTranscript", kind: :cross_cascade
    input  ref: "sample", person: "sample", turns: 1, domains_conceived: 1
    expect ref: "sample", person: "sample", turns: 1, domains_conceived: 1
  end


  # ── BehaviorExample aggregate ──────────────────────────────────────────

  test "RecordBehavior sets behavior + organ_name + trigger + example_input + example_output" do
    tests "BehaviorExample::BehaviorExample.RecordBehavior", on: "BehaviorExample", kind: :cross_cascade
    input  behavior: "sample", organ_name: "sample", trigger: "sample", example_input: "sample", example_output: "sample"
    expect behavior: "sample", organ_name: "sample", trigger: "sample", example_input: "sample", example_output: "sample"
  end

end
