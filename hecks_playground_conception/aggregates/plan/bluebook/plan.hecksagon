Hecks.hecksagon "Plan" do
  uses_framework "Governance"
  Plan::Sprint.persisted_by("Heki")
  Plan::Story.persisted_by("Heki")
  Plan::Task.persisted_by("Heki")
  Plan::Board.persisted_by("Heki")
  Plan::Backlog.persisted_by("Heki")
  Plan::UseCase.persisted_by("Heki")
  Plan::Epic.persisted_by("Heki")
  Plan::Project.persisted_by("Heki")

  # Impure edges, hecksagon-first : on Story.RunCheck (emits
  # StoryChecksRequested), run the four done-is-done checks — all four
  # subscribe to the SAME event, fanning out via OutboundEvent's documented
  # "one Record per subscribing adapter". Re-expressed (i780, 2026-08-17)
  # from the retired `adapter :exec` kwargs form onto the spawn effect port.
  Plan::Story.spawned_by("CheckWorktree", on: "StoryChecksRequested")
  Plan::Story.spawned_by("CheckMerged", on: "StoryChecksRequested")
  Plan::Story.spawned_by("CheckTests", on: "StoryChecksRequested")
  Plan::Story.spawned_by("CheckVerbResolves", on: "StoryChecksRequested")
end
