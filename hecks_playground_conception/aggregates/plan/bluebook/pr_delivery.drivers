# Driving/driven adapter declarations moved out of pr_delivery.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word (no interval/cron
# drivers, no `driven on` reactions). Kept verbatim as the spec for an
# upstream hecks feature. Nothing loads this file.

  adapter "EnqueueOnApproved" do
    driven on "Plan::Story.StoryApproved" do |event|
      dispatch "Conductor::MergeQueue.Enqueue", with: { id: "main", story_ref: "{id}" }
    end
  end

  adapter "StartMergeOnEnqueued" do
    driven on "Conductor::MergeQueue.MergeEnqueued" do |event|
      dispatch "Conductor::MergeQueue.StartMerge", with: { story_ref: "{story_ref}" }
    end
  end
