Hecks.hecksagon "PrDelivery" do
  # pr-delivery-merge-on-accept (sprint 20). Approve is the human gate ; the
  # merge is the automated consequence. StoryApproved -> enqueue -> start ->
  # REAL gh merge -> complete. Story identity rides events as {story_ref} ;
  # same-type MergeQueue cascades preserve the queue id (the target branch).
  adapter "EnqueueOnApproved" do
    driven on "Plan::Story.StoryApproved" do |event|
      dispatch "Conductor::MergeQueue.Enqueue", with: { id: "main", story_ref: "{id}" }
    end
  end
  adapter "StartMergeOnEnqueued" do
    driven on "Conductor::MergeQueue.MergeEnqueued" do |event|
      dispatch "Conductor::MergeQueue.StartMerge", with: { story_ref: "{story_ref}" }
    end
  end
  # THE MERGE LEG MOVED (i787) -> hecks_playground_conception/aggregates/conductor/
  # bluebook/pr_delivery_merge.hecksagon.
  #
  # What used to be here: an `adapter "MergeAndCompleteOnStarted"` whose
  # driven block ran a bare `run "gh pr merge sq/{story_ref} --squash
  # --delete-branch"` and then dispatched CompleteMerge unconditionally,
  # right after, regardless of what the merge actually did -- the gap this
  # file's own comment used to admit ("failure handling needs conditional-
  # dispatch, no DSL branch yet"). i782 established that `run` is a hard
  # no-op in the vendored gem (`DrivenCapture#run(_cmd, result_into: nil)
  # = nil`), so the merge never once executed and the CompleteMerge was
  # firing on a merge that had not happened.
  #
  # It is now a `spawned_by` bind with real success/failure ports, and it
  # lives in conductor/ because a spawned_by bind is declared in the domain
  # that owns the aggregate -- the trigger (MergeQueue.MergeStarted) and
  # both verdict commands are Conductor::MergeQueue's, not Plan's.
  #
  # DELETED RATHER THAN LEFT DORMANT, on purpose. This file still sits in a
  # sibling hecksagons/ directory, which i782 proved is never globbed by
  # Folder#load_domain at any boot depth -- so everything in it is
  # structurally invisible today. Had the dead leaf been left in place, the
  # `git mv` into bluebook/ that the two bindings above still need would
  # have woken it alongside the new bind and fired CompleteMerge twice per
  # merge: once unconditionally from here, once from the real verdict.
  #
  # STILL OPEN (not i787's scope): the two bindings above are themselves
  # invisible for the same hecksagons/ reason, so MergeStarted is only ever
  # emitted by a manual StartMerge dispatch and the merge leg stays dormant
  # in practice. Moving this file into plan/bluebook/ is what turns
  # merge-on-approval on end to end, and that is a deliberate behaviour
  # change (every StoryApproved would auto-enqueue, auto-start, and now
  # really merge) -- left for an explicit decision rather than folded in
  # silently here.
end
