# Driving/driven adapter declarations moved out of activate_sprint_on_project.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word (no interval/cron
# drivers, no `driven on` reactions). Kept verbatim as the spec for an
# upstream hecks feature. Nothing loads this file.

  adapter "ActivateSprintOnProjectActivation" do
    driven on "Plan::Project.SprintActivatedByProject" do |event|
      dispatch "Plan::Sprint.Activate", with: { sprint: "{sprint_ref}" }
    end
  end
