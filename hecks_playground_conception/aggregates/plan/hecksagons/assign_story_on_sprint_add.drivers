# Driving/driven adapter declarations moved out of assign_story_on_sprint_add.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word (no interval/cron
# drivers, no `driven on` reactions). Kept verbatim as the spec for an
# upstream hecks feature. Nothing loads this file.

  adapter "AssignStoryOnSprintAdd" do
    driven on "Plan::Sprint.StoryAddedToSprint" do |event|
      dispatch "Plan::Story.AssignToSprint", with: { id: "{story}", sprint_ref: "{id}" }
    end
  end
