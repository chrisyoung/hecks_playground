# Driving/driven adapter declarations moved out of auto_check_on_ready.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word (no interval/cron
# drivers, no `driven on` reactions). Kept verbatim as the spec for an
# upstream hecks feature. Nothing loads this file.

  adapter "AutoCheckOnReady" do
    driven on "Plan::Story.StoryReadyRequested" do |event|
      dispatch "Plan::Story.RunCheck"
    end
  end
