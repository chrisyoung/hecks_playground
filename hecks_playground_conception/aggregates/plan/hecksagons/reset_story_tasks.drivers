# Driving/driven adapter declarations moved out of reset_story_tasks.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word (no interval/cron
# drivers, no `driven on` reactions). Kept verbatim as the spec for an
# upstream hecks feature. Nothing loads this file.

  adapter "ReopenTasksOnStoryReset" do
    driven on "Plan::Story.StoryReset" do |event|
      dispatch "Plan::Task.Reopen", for_each: { from: "Plan::Task.ForStory", where: { story: "{id}" } }, with: { id: "{id}" }
    end
  end
