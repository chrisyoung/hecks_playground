# Driving/driven adapter declarations moved out of resolve_deps.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word (no interval/cron
# drivers, no `driven on` reactions). Kept verbatim as the spec for an
# upstream hecks feature. Nothing loads this file.

  adapter "ResolveDepsOnStoryApproved" do
    driven on "Plan::Story.StoryApproved" do |event|
      dispatch "Plan::Story.DecUnresolvedDeps", for_each: { from: "Plan::Story.DependentsOf", where: { dep: "{id}" } }, with: { id: "{ref}" }
    end
  end

  adapter "ResolveDepsOnStoryCancelled" do
    driven on "Plan::Story.StoryCancelled" do |event|
      dispatch "Plan::Story.DecUnresolvedDeps", for_each: { from: "Plan::Story.DependentsOf", where: { dep: "{id}" } }, with: { id: "{ref}" }
    end
  end
