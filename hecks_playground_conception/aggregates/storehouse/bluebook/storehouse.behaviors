Hecks.behaviors "Storehouse" do
  vision "Behavioral tests for the two registries in Storehouse, the runtime's self-knowledge domain. Storehouse::Primitive — the META aggregate that registers runtime imperative leaves as first-class bluebook citizens : Conceive (mint a declaration), Amend (re-describe), Retire (soft-delete). Storehouse::Gate — the inbound-wrapper registry the runtime hydrates its synchronous before/after MiddlewareStack from : Declare brings a Gate into being (idempotent on name), Retire soft-detaches it, Active is the boot-time hydration read. Each test exercises one command's state contract : the attributes recorded, the lifecycle token settled, the event emitted."

  # ── Storehouse::Primitive — Conceive ───────────────────────────

  test "Conceive mints a Primitive in active status" do
    tests "Conceive", on: "Primitive"
    input  name:           { value: "HecksPlayground::Framework::Primitive::Process.Spawn" },
           kind:           { value: "process" },
           signature:      { value: "id:String,cmd:String,result_into:String" },
           implementation: { value: "exec_dispatcher::dispatch" }
    expect status: "active"
  end

  test "Conceive emits PrimitiveConceived" do
    tests "Conceive", on: "Primitive"
    input  name:           { value: "HecksPlayground::Framework::Primitive::Process.Spawn" },
           kind:           { value: "process" },
           signature:      { value: "id:String,cmd:String,result_into:String" },
           implementation: { value: "exec_dispatcher::dispatch" }
    expect emits: ["PrimitiveConceived"]
  end

  test "Conceive records the implementation key on state" do
    tests "Conceive", on: "Primitive"
    input  name:           { value: "WebTool.Fetch" },
           kind:           { value: "web_tool" },
           signature:      { value: "url:String" },
           implementation: { value: "web_tool_dispatcher::web_fetch" }
    expect implementation: { value: "web_tool_dispatcher::web_fetch" }
  end

  # ── Storehouse::Primitive — Amend ──────────────────────────────

  test "Amend updates the implementation key" do
    tests "Amend", on: "Primitive"
    setup  "Conceive",
           name:           { value: "Compute.Invoke" },
           kind:           { value: "compute" },
           signature:      { value: "function_name:String" },
           implementation: { value: "old::path" }
    input  name:           { value: "Compute.Invoke" },
           kind:           { value: "compute" },
           signature:      { value: "function_name:String" },
           implementation: { value: "compute_dispatcher::dispatch" }
    expect implementation: { value: "compute_dispatcher::dispatch" }
  end

  test "Amend emits PrimitiveAmended" do
    tests "Amend", on: "Primitive"
    setup  "Conceive",
           name:           { value: "Compute.Invoke" },
           kind:           { value: "compute" },
           signature:      { value: "function_name:String" },
           implementation: { value: "old::path" }
    input  name:           { value: "Compute.Invoke" },
           kind:           { value: "compute" },
           signature:      { value: "function_name:String" },
           implementation: { value: "compute_dispatcher::dispatch" }
    expect emits: ["PrimitiveAmended"]
  end

  # ── Storehouse::Primitive — Retire ─────────────────────────────

  test "Retire moves status to retired" do
    tests "Retire", on: "Primitive"
    setup  "Conceive",
           name:           { value: "Sms.Send" },
           kind:           { value: "sms" },
           signature:      { value: "to:String,body:String" },
           implementation: { value: "sms_dispatcher::send_message" }
    input  name: { value: "Sms.Send" }
    expect status: "retired"
  end

  test "Retire emits PrimitiveRetired" do
    tests "Retire", on: "Primitive"
    setup  "Conceive",
           name:           { value: "Sms.Send" },
           kind:           { value: "sms" },
           signature:      { value: "to:String,body:String" },
           implementation: { value: "sms_dispatcher::send_message" }
    input  name: { value: "Sms.Send" }
    expect emits: ["PrimitiveRetired"]
  end

  # ════════════════════════════════════════════════════════════
  # Storehouse::Gate — the inbound-wrapper registry (folded in 2026-06-27)
  # ════════════════════════════════════════════════════════════
  # ── Declare : bring a Gate into being through the storehouse door ──────
  test "Declare brings a before-gate into being in the active state" do
    tests "Declare", on: "Gate"
    input  name: "Authorize", phase: "before", check: "sample-gate", pattern: "*", order: 20
    expect name: "Authorize", phase: "before", check: "sample-gate", status: "active"
  end

  test "Declare emits Declared" do
    tests "Declare", on: "Gate"
    input  name: "Authorize", phase: "before", check: "sample-gate", pattern: "*", order: 20
    expect_event "Declared"
  end

  # ── Active : the boot-time hydration read (projection target) ────────
  test "Active lists a declared gate" do
    tests "Active", on: "Gate", kind: :query
    setup  "Declare", name: "Authorize", phase: "before", check: "sample-gate", pattern: "*", order: 20
    expect count: 1
  end

  # Declare upserts on identity : re-declaring (as the parser re-emits the
  # same `gating on dispatch` block every boot) re-affirms the same gate
  # rather than duplicating it. Two Declares of the same name leave exactly
  # one active record. Mirrors Driver's re-declare-on-name idempotency.
  test "Declare is idempotent — re-declaring the same name keeps one record" do
    tests "Active", on: "Gate", kind: :query
    setup  "Declare", name: "Authorize", phase: "before", check: "sample-gate", pattern: "*", order: 20
    setup  "Declare", name: "Authorize", phase: "before", check: "sample-gate", pattern: "*", order: 20
    expect count: 1
  end

  # ── Retire : soft-detach ──────────────────────────────────────
  test "Retire detaches the gate" do
    tests "Retire", on: "Gate"
    setup  "Declare", name: "Authorize", phase: "before", check: "sample-gate", pattern: "*", order: 20
    input  name: "Authorize"
    expect status: "retired"
  end

  test "Retire emits Retired" do
    tests "Retire", on: "Gate"
    setup  "Declare", name: "Authorize", phase: "before", check: "sample-gate", pattern: "*", order: 20
    input  name: "Authorize"
    expect_event "Retired"
  end

  # A retired gate is dropped from the hydration read, so the next boot (or
  # in-session re-hydrate) drops it from the runtime stack.
  test "Active excludes a retired gate" do
    tests "Active", on: "Gate", kind: :query
    setup  "Declare", name: "Authorize", phase: "before", check: "sample-gate", pattern: "*", order: 20
    # Qualified : Retire is shared with Storehouse::Primitive (same bluebook),
    # so a bare setup would resolve first-match-wins to Primitive. Address it.
    setup  "Gate.Retire",  name: "Authorize"
    expect count: 0
  end
end
