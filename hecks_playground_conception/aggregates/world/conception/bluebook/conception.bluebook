Hecks.bluebook "Conception", version: "2026.04.16.1" do
  vision "The spark — domain conception, always multi-domain"

  # Lifted out of conception.bluebook in i112 split. The spark itself —
  # one aggregate per bluebook. Carries no policies; the conception
  # event (DomainConceived) is observed by Gestation, NurseryCorpus,
  # and others across bluebook boundaries.

  aggregate "Conception" do
    description "The spark — always multi-domain, never a monolith"
    identified_by :name
    attribute :name,             Name
    attribute :vision,           Vision
    attribute :requested_by,     RequestedBy
    attribute :source,           Source
    attribute :bounded_contexts, list_of(BoundedContextName)
    attribute :category,         Category
    attribute :status,           Status, default: { value: "spark" }

    value_object "Name" do
      # Identifier of the conceived domain (Hecks.bluebook "<Name>").
      attribute :value, String
    end

    value_object "Vision" do
      # Free-form prose describing what the conceived domain is for.
      attribute :value, String
    end

    value_object "RequestedBy" do
      # Who asked for the conception (user identifier or 'self').
      attribute :value, String
    end

    value_object "Source" do
      # Origin of the conception (e.g. 'conversation', 'inbox', 'pitch').
      attribute :value, String
    end

    value_object "BoundedContextName" do
      # One bounded context belonging to the multi-domain project.
      attribute :value, String
    end

    value_object "Category" do
      # Coarse classifier (e.g. 'framework', 'discipline', 'world').
      attribute :value, String
    end

    value_object "Status" do
      # Lifecycle state ('spark' or 'conceived').
      attribute :value, String
    end

    command "ConceiveDomain" do
      role "Miette"
      goal "Conceive a multi-domain project — identify bounded contexts from the start"
      attribute :name,             Name
      attribute :vision,           Vision
      attribute :requested_by,     RequestedBy
      attribute :source,           Source
      attribute :category,         Category
      attribute :bounded_contexts, list_of(BoundedContextName)
      emits "DomainConceived"
      sets :name
      sets :vision
      sets :requested_by
      sets :source
      sets :category
      sets :bounded_contexts
    end

    lifecycle :status, default: "spark" do
      transition "ConceiveDomain" => "conceived", from: "spark"
    end
  end
end
