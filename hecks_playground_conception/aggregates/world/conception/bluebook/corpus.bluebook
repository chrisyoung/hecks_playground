Hecks.bluebook "NurseryCorpus", version: "2026.04.16.1" do
  vision "The nursery vector space — every domain's shape, indexed for similarity search"

  # Lifted out of conception.bluebook in i112 split. The aggregate
  # name stays "Corpus" (preserves corpus.heki path); the bluebook
  # namespace is "NurseryCorpus" to avoid collision with the
  # existing top-level Hecks.bluebook "Corpus" (vocabulary corpus
  # in mind/). Pattern follows AwarenessMoment in PR #499.
  #
  # Carries three policies : IndexOnBirth (Delivery.RegisterBirth →
  # IndexDomain), IndexOnDevelopment (Development.DevelopDomain →
  # IndexDomain), and RebuildOnConception (Conception.ConceiveDomain →
  # QueryNearest).

  aggregate "Corpus" do
    description "The nursery vector space — every domain's shape, indexed for similarity search"
    identified_by :name
    attribute :name,            Name
    attribute :domain_count,    DomainCount
    attribute :total_vectors,   VectorCount
    attribute :last_indexed_at, Timestamp

    value_object "Name" do
      # Stable slug for this corpus index.
      attribute :value, String
    end

    value_object "DomainName" do
      # Identifier of the domain being indexed (Hecks.bluebook "<Name>").
      attribute :value, String
    end

    value_object "DomainCount" do
      # Number of domains currently indexed in the corpus.
      attribute :value, Integer
    end

    value_object "VectorCount" do
      # Number of vectors stored across all indexed domains.
      attribute :value, Integer
    end

    value_object "Timestamp" do
      # ISO-8601 timestamp of the last index operation.
      attribute :value, String
    end

    value_object "VectorComponent" do
      # One component of an embedding vector — Float so list_of preserves shape.
      attribute :value, Float
    end

    value_object "K" do
      # Number of nearest neighbours to return from a QueryNearest call.
      attribute :value, Integer
    end

    command "OpenCorpus" do
      role "System"
      goal "Open the nursery vector space — the corpus exists before any domain is indexed into it"
      attribute :name, Name
      emits "CorpusOpened"
      sets :name
      sets :domain_count,  to: 0
      sets :total_vectors, to: 0
    end

    command "IndexDomain" do
      role "System"
      goal "Add a domain's structural vector to the corpus"
      reference_to(Corpus)
      attribute :domain_name, DomainName
      attribute :vector,      list_of(VectorComponent)
      emits "DomainIndexed"
      sets :domain_count,  increment: 1
      sets :total_vectors, increment: 1
    end

    command "QueryNearest" do
      role "System"
      goal "Find k nearest domains by cosine similarity to a target vector"
      reference_to(Corpus)
      attribute :target_vector, list_of(VectorComponent)
      attribute :k,             K
      emits "NearestFound"
    end

    command "RebuildCorpus" do
      role "System"
      goal "Rescan all nursery and catalog domains, recompute all vectors"
      reference_to(Corpus)
      emits "CorpusRebuilt"
    end
  end

  policy "IndexOnBirth" do
    on "BirthRegistered"
    trigger Corpus::IndexDomain, with: { name: "nursery", domain_name: :domain_name, vector: [] }
  end

  policy "IndexOnDevelopment" do
    on "DomainDeveloped"
    trigger Corpus::IndexDomain, with: { name: "nursery", domain_name: :domain_name, vector: [] }
  end

  policy "RebuildOnConception" do
    on "DomainConceived"
    trigger Corpus::QueryNearest, with: { name: "nursery", target_vector: [], k: 1 }
  end
end
