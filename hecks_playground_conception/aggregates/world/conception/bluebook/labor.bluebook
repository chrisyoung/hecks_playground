Hecks.bluebook "Labor", version: "2026.04.16.1" do
  vision "Validation and naming — the domain is ready to be born"

  # Lifted out of conception.bluebook in i112 split. Carries one
  # policy : ParityOnValidation (Labor.ValidateBluebook →
  # Labor.CheckParity).

  aggregate "Labor" do
    description "Validation and naming — the domain is ready to be born"
    identified_by :domain_name
    attribute :domain_name,     DomainName
    attribute :bluebook_source, BluebookSource
    attribute :valid,           Validity, default: { value: "pending" }
    attribute :errors,          list_of(ErrorMessage)
    attribute :parity,          ParityResult

    value_object "DomainName" do
      # Identifier of the domain in labor (Hecks.bluebook "<Name>").
      attribute :value, String
    end

    value_object "BluebookSource" do
      # Raw bluebook source text being validated.
      attribute :value, String
    end

    value_object "Validity" do
      # Lifecycle marker ('pending' / 'checking' / 'yes' / 'no').
      attribute :value, String
    end

    value_object "ErrorMessage" do
      # One validation error message recorded against the labor.
      attribute :value, String
    end

    value_object "ParityResult" do
      # Either 'pass' or 'fail' for Ruby/Rust read parity.
      attribute :value, String
    end

    command "ValidateBluebook" do
      role "Midwife"
      goal "Check the domain is well-formed — verb naming, references, structure"
      attribute :domain_name,     DomainName
      attribute :bluebook_source, BluebookSource
      emits "BluebookValidated"
      sets :domain_name
      sets :bluebook_source
    end

    command "CheckParity" do
      role "Midwife"
      goal "Verify Ruby and Rust read the domain identically"
      reference_to(Labor)
      attribute :parity, ParityResult
      emits "ParityChecked"
      sets :parity
    end

    command "PassLabor" do
      role "Midwife"
      goal "Domain passes all checks — ready for delivery"
      reference_to(Labor)
      emits "LaborPassed"
      sets :valid, to: "yes"
    end

    command "FailLabor" do
      role "Midwife"
      goal "Domain has errors — needs more gestation"
      reference_to(Labor)
      attribute :errors, list_of(ErrorMessage)
      emits "LaborFailed"
      sets :valid, to: "no"
      sets :errors
    end

    lifecycle :valid, default: "pending" do
      transition "ValidateBluebook" => "checking", from: "pending"
      transition "PassLabor"        => "yes",      from: "checking"
      transition "FailLabor"        => "no",       from: "checking"
    end
  end

  policy "ParityOnValidation" do
    on "BluebookValidated"
    trigger CheckParity
  end
end
