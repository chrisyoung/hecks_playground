Hecks.bluebook "Postpartum", version: "2026.04.16.1" do
  vision "After birth — the domain's first days in the nursery"

  # Lifted out of conception.bluebook in i112 split. Carries one
  # policy : CheckOnBirth (Delivery.RegisterBirth →
  # Postpartum.CheckHealth).

  aggregate "Postpartum" do
    description "After birth — the domain's first days in the nursery"
    identified_by :domain_name
    attribute :domain_name,    DomainName
    attribute :healthy,        HealthStatus
    attribute :first_pulse_at, Timestamp

    value_object "DomainName" do
      # Identifier of the newborn domain (Hecks.bluebook "<Name>").
      attribute :value, String
    end

    value_object "HealthStatus" do
      # Postpartum status ('yes' / 'concern').
      attribute :value, String
    end

    value_object "Timestamp" do
      # ISO-8601 timestamp of the newborn's first pulse.
      attribute :value, String
    end

    value_object "Concern" do
      # Free-form description of a postpartum concern.
      attribute :value, String
    end

    command "CheckHealth" do
      role "Midwife"
      goal "Verify the newborn domain — Rust validation, parity, census updated"
      attribute :domain_name, DomainName
      emits "HealthChecked"
      sets :domain_name
    end

    command "DeclareHealthy" do
      role "Midwife"
      goal "The domain is healthy — living in the nursery"
      reference_to(Postpartum)
      emits "DeclaredHealthy"
      sets :healthy, to: "yes"
    end

    command "FlagConcern" do
      role "Midwife"
      goal "Something is wrong — needs attention"
      reference_to(Postpartum)
      attribute :concern, Concern
      emits "ConcernFlagged"
      sets :healthy, to: "concern"
    end
  end

  policy "CheckOnBirth" do
    on "BirthRegistered"
    trigger CheckHealth
  end
end
