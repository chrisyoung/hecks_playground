Hecks.bluebook "ChangeTracker", version: "2026.05.16.1" do
  vision "Track what changed since last beat — only process the delta. Part of how Miette stays fast at 100,000 domains."

  # ============================================================
  # CHANGE TRACKER
  # ============================================================
  #
  # Lifted out of aggregates/scale.bluebook in i112 (scale-split).
  # The delta-detector in the scale infrastructure : compare file
  # mtimes against last known state and report what's changed since
  # last beat. The ProcessedOnBatch policy lives here because its
  # trigger (MarkProcessed) fires on this aggregate after a batch
  # completes elsewhere.

  aggregate "ChangeTracker" do
    description "Track what changed since last beat — only process the delta"
    identified_by :name
    attribute :name,               TrackerName
    attribute :tracked_files,      FileCount
    attribute :changed_since_last, ChangeCount
    attribute :last_scan_at,       ScanTimestamp

    value_object "TrackerName" do
      # Identifies this tracker instance — typically the root path being watched.
      attribute :value, String
    end

    value_object "FileCount" do
      # Total number of files under observation.
      attribute :value, Integer
    end

    value_object "ChangeCount" do
      # Number of files that changed since the last processed beat.
      attribute :value, Integer
    end

    value_object "ScanTimestamp" do
      # ISO-8601 timestamp of the most recent scan.
      attribute :value, String
    end

    command "ScanForChanges" do
      role "System"
      goal "Compare file mtimes against last known state — find the delta"
      attribute :tracked_files,      FileCount
      attribute :changed_since_last, ChangeCount
      emits "ChangesScanned"
      sets :tracked_files
      sets :changed_since_last
    end

    command "MarkProcessed" do
      role "System"
      goal "Record that changes have been processed — reset the delta"
      reference_to(ChangeTracker)
      emits "ChangesProcessed"
      sets :changed_since_last, to: 0
    end
  end

  policy "ProcessedOnBatch" do
    on "BatchCompleted"
    trigger MarkProcessed
  end
end
