Hecks.bluebook "Call", version: "2026.04.28.1" do
  vision "One invocation of an LLM — the recorded-event half of LLM spend tracking."

  # ============================================================
  # CALL — split from spend.bluebook (i112)
  # ============================================================
  #
  # Was one half of the original Spend bluebook, paired with Budget
  # (now in world/budget.bluebook). Call is the recorded event ;
  # Budget is the cap. No policies between them in the original
  # (Spend is pure accounting — the dispatcher gates new invocations
  # by reading Call + Budget, but that wiring lives outside the
  # bluebook). Split is structural-only.
  #
  # Multi-record: every RecordCall is a new row. Enables hourly /
  # daily / monthly rollups without replaying the whole history.
  # command_ref links the spend record back to whatever Miette was
  # doing when she shelled out (e.g., "Speech.Speak:speech_42").

  aggregate "Call" do
    description "One invocation of an LLM — provider, token counts, cost, and what command triggered it"
    identified_by :ref
    attribute :ref,         Ref
    attribute :provider,    ProviderName
    attribute :tokens_in,   TokenCount
    attribute :tokens_out,  TokenCount
    attribute :cost_usd,    UsdAmount
    attribute :command_ref, CommandRef
    attribute :recorded_at, Timestamp

    value_object "Ref" do
      # Stable identifier for this call record.
      attribute :value, String
    end

    value_object "ProviderName" do
      # LLM provider name (e.g. 'anthropic', 'openai').
      attribute :value, String
    end

    value_object "TokenCount" do
      # A token count (input or output).
      attribute :value, Integer
    end

    value_object "UsdAmount" do
      # Cost in U.S. dollars (Float for fractional cents).
      attribute :value, Float
    end

    value_object "CommandRef" do
      # The command that triggered the call (e.g. 'Speech.Speak:speech_42').
      attribute :value, String
    end

    value_object "Timestamp" do
      # ISO-8601 timestamp of when the call was recorded.
      attribute :value, String
    end

    command "RecordCall" do
      role "System"
      goal "Record a single LLM invocation — provider, token counts, cost, and the command that triggered it"
      attribute :provider,    ProviderName
      attribute :tokens_in,   TokenCount
      attribute :tokens_out,  TokenCount
      attribute :cost_usd,    UsdAmount
      attribute :command_ref, CommandRef
      attribute :recorded_at, Timestamp
      emits "CallRecorded"
      sets :provider
      sets :tokens_in
      sets :tokens_out
      sets :cost_usd
      sets :command_ref
      sets :recorded_at
    end
  end
end
