Hecks.bluebook "DataPrep", version: "2026.04.28.1" do
  vision "Transform Bluebooks and transcripts into training format"

  # Lifted out of training_pipeline.bluebook in i112 split. Carries
  # the SplitOnPrep policy — DataPrepared → SplitDataset — both
  # event source and trigger live on this aggregate.

  aggregate "DataPrep" do
    description "Transform Bluebooks and transcripts into training format"
    identified_by :name
    attribute :name,        Name
    attribute :format,      Format
    attribute :total_pairs, PairCount
    attribute :status,      Status

    value_object "Name" do
      # Identifier of this data-prep run.
      attribute :value, String
    end

    value_object "Format" do
      # Output format (e.g. 'jsonl', 'alpaca').
      attribute :value, String
    end

    value_object "PairCount" do
      # Total instruction-response pairs produced.
      attribute :value, Integer
    end

    value_object "Status" do
      # Lifecycle marker ('pending' / 'prepared' / 'split').
      attribute :value, String
    end

    command "PrepareData" do
      role "System"
      goal "Convert bluebooks to instruction-response pairs for fine-tuning"
      attribute :format, Format
      emits "DataPrepared"
      sets :format
      sets :status, to: "prepared"
    end

    command "SplitDataset" do
      role "System"
      goal "Split into train/validation/test sets"
      reference_to(DataPrep)
      emits "DatasetSplit"
    end
  end

  policy "SplitOnPrep" do
    on "DataPrepared"
    trigger SplitDataset
  end
end
