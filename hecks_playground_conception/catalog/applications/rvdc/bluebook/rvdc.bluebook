Hecks.bluebook "RVDC" do
  vision "RV electrical system designer — wire sizing, fuse selection, load balancing, and a printable wiring sheet"

  aggregate "App" do
    description "The RVDC application — maps four domains into one runnable web app"
    identified_by :name
    attribute :name, Name
    attribute :status, Status
    attribute :domains, list_of(Domain)

    value_object "Name" do
      attribute :value, String
    end

    value_object "Status" do
      attribute :value, String
    end

    value_object "Domain" do
      attribute :value, String
    end

    command "Boot" do
      role "Owner"
      goal "Start the RVDC application with all four domains — boots Electrical, RVPower, RVCircuits, and RVWiringSheet as a single runtime"
      attribute :port, Integer
      emits "AppBooted"
    end

    command "RegisterDomains" do
      role "System"
      goal "Map the nursery domains this app depends on — RVDC uses Electrical (fundamentals), RVPower (sources), RVCircuits (wiring), RVWiringSheet (reference)"
      attribute :domains, list_of(Domain)
      sets :domains
      emits "DomainsRegistered"
    end

  end

end
