  # i101 — `where(resolved: "false")` filters out records whose `resolved`
  # attribute hasn't been set. Annotate doesn't set it, so the seeded
  # record correctly fails the filter. count: 0 verifies the query runs ;
  # a richer test would seed via a Resolve-then-reopen path.
  test "Unresolved returns matching records" do
    tests "Unresolved", on: "Annotation", kind: :query
    setup  "Annotate", annotation_id: "sample", element_type: "sample", element_name: "sample", body: "sample"
    expect count: 0
  end


