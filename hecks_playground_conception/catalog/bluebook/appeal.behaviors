  # PENDING: under the published gem the chain stops after TabSelected.
  # SwitchToEditorOnFileOpen selects the "editor" tab, and
  # ShowDiagramOnTabSelect only fires for the "diagrams" tab (its `where`
  # is honoured now), so DiagramGenerated is not part of this chain. The
  # fork ignored the `where`. Restore (as :cascade, expecting
  # DiagramGenerated) once the design decides FileOpened should also
  # generate a diagram; the TabSelected -> DiagramGenerated link itself is
  # covered by "SelectTab cascades through policy chain".
  test "OpenFile cascades through policy chain" do
    tests "OpenFile", on: "Explorer", kind: :pending
    setup  "OpenProject", path: "sample"
    setup  "Appeal::Explorer.LoadDomain", project: "sample", domain_name: "sample"
    setup  "Appeal::Layout.OpenPanel", name: "layout", panel_name: "sample"
    setup  "Appeal::Diagram.GenerateDiagram", view_type: "sample", path: "sample", domain: "sample"
    input  explorer: "sample", project: "sample", path: "sample", domain: "sample"
    expect emits: ["FileOpened", "TabSelected", "DiagramGenerated"]
  end

