  # attribute hasn't been set. Notify doesn't set it, so count: 0
  # verifies query plumbing post first-class IR.
  test "Active returns matching records" do
    tests "Active", on: "Notification", kind: :query
    setup  "Appeal::Notification.Notify", notification_id: "sample", severity: "sample", message: "sample", context: "sample"
    expect count: 0
