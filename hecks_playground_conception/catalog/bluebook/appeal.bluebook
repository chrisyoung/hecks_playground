    end

    value_object "Status" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "OutputPath" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Filename" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "Build domain code for a target language. Preview output, diff against existing."
  attribute :target, Target
  attribute :status, Status
  attribute :output_path, OutputPath
  attribute :artifacts, list_of(Artifact)

  value_object "Artifact" do
