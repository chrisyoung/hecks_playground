  attribute :adapter_mode, AdapterMode, default: { value: "memory" }

  attribute :thinking, Thinking, default: { value: "idle" }

  attribute :messages, list_of(Message)
  attribute :suggestions, list_of(Suggestion)
  attribute :loaded_domain, LoadedDomain

  value_object "Message" do
    # "A conversation message -- user or assistant"
    attribute :role, String
    attribute :content, String
    attribute :timestamp, String
  end

  value_object "Suggestion" do
    # "A proposed domain change with rationale and diff preview"
    attribute :title, String
    attribute :rationale, String
    attribute :diff_preview, String
    attribute :status, String
  end

  command "SendMessage" do
    goal "Send a message to the AI assistant about the domain"
    attribute :content, Content
    emits "MessageReceived"
  end

  command "ToggleAdapter" do
    goal "Switch between memory and live LLM adapter"
    attribute :mode, Mode
    emits "AdapterChanged"
  end

  command "ClearConversation" do
    goal "Reset the conversation history"
    emits "ConversationCleared"
  end

  command "ApplySuggestion" do
    goal "Accept and apply a suggested domain change"
    attribute :title, Title
    emits "SuggestionApplied"
  end

  command "RequestReview" do
    goal "Ask the AI to review the current domain"
    emits "ReviewRequested"
  end

  command "LoadDomainContext" do
    goal "Set which domain the agent introspects for tools and system prompt"
    attribute :domain_name, DomainName
    emits "DomainContextLoaded"
  end

  lifecycle :adapter_mode, default: "memory" do
    transition "ToggleAdapter" => "live", from: "memory"
    transition "ToggleAdapter" => "memory", from: "live"
  end

  lifecycle :thinking, default: "idle" do
    transition "SendMessage" => "thinking", from: "idle"
    transition "ReceiveResponse" => "idle", from: "thinking"
  end
end

  aggregate "Insight" do
    identified_by :name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "InsightName" do
      attribute :value, String
      invariant "must be the singleton 'insight'" do
        value == "insight"
      end
    end

    value_object "Score" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "Scope" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Rule" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "ElementName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Enabled" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "Domain health analysis -- coupling metrics, design smells, completeness checks."
  attribute :name, InsightName, default: { value: "insight" }
  attribute :findings, list_of(Finding)
  attribute :score, Score

  value_object "Finding" do
    # "A single analysis finding with severity and recommendation"
    attribute :rule, String
    attribute :severity, String
    attribute :element_name, String
    attribute :message, String
    attribute :recommendation, String
  end

  command "AnalyzeDomain" do
    goal "Run all analysis rules against the current domain"
    attribute :scope, Scope
  end

  command "DismissInsight" do
    goal "Acknowledge and hide a specific finding"
    attribute :rule, Rule
    attribute :element_name, ElementName
  end

  command "ConfigureRules" do
    goal "Enable or disable specific analysis rules"
    attribute :rule, Rule
    attribute :enabled, Enabled
  end
end

  aggregate "Migration" do
    identified_by :migration_id

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "MigrationId" do
      # from_version/to_version aren't both set together by any single
      # command (to_version is never set at all) -- caller-supplied.
      attribute :value, String
      invariant "must not be empty" do
        !value.empty?
      end
    end

    value_object "FromVersion" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "ToVersion" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Status" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "Breaking change detection and migration path generation."
  attribute :migration_id, MigrationId
  attribute :from_version, FromVersion
  attribute :to_version, ToVersion
  attribute :status, Status
  attribute :changes, list_of(DomainChange)

  value_object "DomainChange" do
    # "A detected change -- added, removed, renamed, or modified element"
    attribute :kind, String
    attribute :element_type, String
    attribute :element_name, String
    attribute :detail, String
  end

  command "DetectChanges" do
    goal "Compare current bluebook against a previous version"
    attribute :migration_id, MigrationId
    attribute :from_version, FromVersion
    sets :migration_id
  end

  command "GenerateMigration" do
    goal "Produce a migration script for the detected changes"
    end

  command "ApplyMigration" do
    goal "Execute the migration against a target environment"
    end
end

  aggregate "Comparison" do
    identified_by :left_version, :right_version

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "LeftVersion" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "RightVersion" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "Side-by-side diff of two domain versions."
  attribute :left_version, LeftVersion
  attribute :right_version, RightVersion
  attribute :differences, list_of(Difference)

  value_object "Difference" do
    # "A single difference between two domain versions"
    attribute :element_type, String
    attribute :element_name, String
    attribute :change_kind, String
    attribute :left_value, String
    attribute :right_value, String
    attribute :breaking, String
  end

  command "CompareVersions" do
    goal "Diff two versions of the domain"
    attribute :left_version, LeftVersion
    attribute :right_version, RightVersion
  end

  command "HighlightBreaking" do
    goal "Filter the comparison to show only breaking changes"
    end
end

policy "ShowDiagramOnTabSelect" do
  on "TabSelected"
  trigger GenerateDiagram
  # `condition do |event| ... end` was never a real PolicyBuilder verb --
  # `where` is (evaluated against the triggering event's own payload
  # directly, no manual event.to_h/.data unwrapping needed -- same
  # canonical-expression form every `given` block in this corpus uses).
  where { active_tab == "diagrams" }
end

  aggregate "Diagram" do
    identified_by :view_type

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "ViewType" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Path" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Domain" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Scope" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "AggregateName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "Generated domain visualizations -- aggregate maps, event flows, command graphs."
  attribute :view_type, ViewType
  attribute :nodes, list_of(DiagramNode)
  attribute :edges, list_of(DiagramEdge)

  value_object "DiagramNode" do
    # "An element in the diagram -- aggregate, command, event, or value object"
    attribute :name, String
    attribute :kind, String
    attribute :metadata, String
  end

  value_object "DiagramEdge" do
    # "A relationship between two nodes"
    attribute :from_node, String
    attribute :to_node, String
    attribute :relationship, String
  end

  command "GenerateDiagram" do
    goal "Build a diagram for a file. Uses Explorer.last_opened_path when path is not provided."
    attribute :view_type, ViewType
    attribute :path, Path
    attribute :domain, Domain
    emits "DiagramGenerated"
  end

  command "GenerateOverview" do
    goal "Build a cross-domain relationship diagram showing all domains and their connections"
    attribute :scope, Scope
    emits "OverviewGenerated"
  end

  command "SelectView" do
    goal "Switch between aggregate map, event flow, or command graph"
    attribute :view_type, ViewType
    emits "ViewSelected"
  end

  command "FilterByAggregate" do
    goal "Show only nodes related to a specific aggregate"
    attribute :aggregate_name, AggregateName
    emits "DiagramFiltered"
  end

  command "RunAnalysis" do
    goal "Analyze domain patterns — coupling, cohesion, naming issues"
    emits "AnalysisCompleted"
  end
end

  aggregate "EventStorm" do
    identified_by :name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Name" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Status" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Label" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Kind" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "PositionX" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "PositionY" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

  description "Interactive event storming session. Stickies represent domain concepts."
  attribute :name, Name
  attribute :status, Status
  attribute :stickies, list_of(Sticky)

  value_object "Sticky" do
    # "A virtual sticky note -- event, command, policy, hotspot, or external system"
    attribute :label, String
    attribute :kind, String
    attribute :color, String
    attribute :position_x, Integer
    attribute :position_y, Integer
    attribute :notes, String
  end

  command "StartStorm" do
    goal "Begin a new event storming session"
    attribute :name, Name
  end

  command "AddSticky" do
    goal "Place a new sticky note on the board"
    attribute :label, Label
    attribute :kind, Kind
  end

  command "MoveSticky" do
    goal "Reposition a sticky on the board"
    attribute :label, Label
    attribute :position_x, PositionX
    attribute :position_y, PositionY
  end

  command "ConvertToDomain" do
    goal "Transform stickies into Bluebook DSL aggregates, commands, and events"
    end

end

  aggregate "Glossary" do
