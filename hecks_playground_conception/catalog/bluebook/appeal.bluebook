    attribute :name, String
    attribute :definition, String
    attribute :category, String
    attribute :aliases, String
  end

  command "ShowGlossary" do
    goal "Display the full glossary of domain terms"
    emits "GlossaryShown"
  end

  command "DefineTerm" do
    goal "Add a new term to the glossary"
    attribute :name, Name
    attribute :definition, Definition
    attribute :category, Category
  end

  command "RenameTerm" do
    goal "Rename a term and update all references"
    attribute :old_name, OldName
    attribute :new_name, NewName
  end

  command "FlagAmbiguity" do
    goal "Mark a term as ambiguous -- needs clarification"
    attribute :term_name, TermName
    attribute :reason, Reason
  end

  command "LinkTerms" do
