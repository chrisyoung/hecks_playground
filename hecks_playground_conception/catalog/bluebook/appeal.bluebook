  aggregate "Console" do
    identified_by :name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "ConsoleName" do
      attribute :value, String
      invariant "must be the singleton 'console'" do
        value == "console"
      end
    end

    value_object "SelectedAggregate" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "SelectedCommand" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Status" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "LastResult" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "AggregateName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "CommandName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Values" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "Interactive command runner GUI. Select aggregate and command, fill form, execute."
  attribute :name, ConsoleName, default: { value: "console" }
  attribute :selected_aggregate, SelectedAggregate
  attribute :selected_command, SelectedCommand
  attribute :status, Status
  attribute :last_result, LastResult
  attribute :event_log, list_of(ConsoleEvent)
  attribute :form, list_of(FormField)

  value_object "FormField" do
    # "A generated input field from a command attribute"
    attribute :name, String
    attribute :field_type, String
    attribute :required, String
    attribute :input_value, String
    attribute :error, String
  end

  value_object "ConsoleEvent" do
    # "An event recorded from command execution in the console"
    attribute :event_name, String
    attribute :payload, String
    attribute :timestamp, String
  end

  command "OpenConsole" do
    goal "Open the console -- loads available aggregates and commands"
    emits "ConsoleOpened"
  end

  command "SelectCommand" do
    goal "Pick an aggregate and command -- generates the input form"
    attribute :aggregate_name, AggregateName
    attribute :command_name, CommandName
    emits "CommandSelected"
  end

  command "SubmitForm" do
    goal "Execute the selected command with the filled form values"
    attribute :values, Values
    # Was "CommandExecuted" -- collided with Workbench.ExecuteCommand's own
    # emit of the same name with a different field set (command_name, args
    # vs values here). An event is one fact ; renamed to its own name since
    # nothing subscribes to either (zero blast radius, checked).
    emits "FormSubmitted"
  end

  command "ViewResult" do
    goal "Display the result of the last command execution"
    emits "ResultViewed"
  end
end

  aggregate "AcceptanceTest" do
    identified_by :name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "AcceptanceTestName" do
      attribute :value, String
      invariant "must be the singleton 'acceptance_test'" do
        value == "acceptance_test"
      end
    end

    value_object "Status" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Passed" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "Failed" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "Total" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "AggregateName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "CommandName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "Automated test runner. Dispatches every domain command and validates the event log."
  attribute :name, AcceptanceTestName, default: { value: "acceptance_test" }
  attribute :status, Status, default: { value: "idle" }

  attribute :results, list_of(TestResult)
  attribute :passed, Passed
  attribute :failed, Failed
  attribute :total, Total

  value_object "TestResult" do
    # "Result of a single command dispatch test"
    attribute :command_name, String
    attribute :aggregate_name, String
    attribute :status, String
    attribute :event_name, String
    attribute :error, String
  end

  command "RunAll" do
    goal "Dispatch every command and validate events are emitted"
    emits "AllTestsCompleted"
  end

  command "RunCommand" do
    goal "Test a single command dispatch"
    attribute :aggregate_name, AggregateName
    attribute :command_name, CommandName
    emits "CommandTested"
  end

  command "Reset" do
    goal "Clear all test results"
    emits "TestsReset"
  end

  lifecycle :status, default: "idle" do
    transition "RunAll" => "running", from: "idle"
    transition "AllTestsCompleted" => "idle", from: "running"
    transition "Reset" => "idle"
  end
end

  aggregate "EventStream" do
