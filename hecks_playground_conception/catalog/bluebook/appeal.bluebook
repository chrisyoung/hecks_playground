    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "PlaygroundName" do
      attribute :value, String
      invariant "must be the singleton 'playground'" do
        value == "playground"
      end
    end

    value_object "StateSnapshot" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "AggregateName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "CommandName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Attributes" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "Interactive sandbox for running domain commands and inspecting state."
  attribute :name, PlaygroundName, default: { value: "playground" }
  attribute :events, list_of(PlaygroundEvent)
  attribute :state_snapshot, StateSnapshot

  value_object "PlaygroundEvent" do
    # "A recorded event from command execution"
    attribute :name, String
    attribute :payload, String
    attribute :timestamp, String
  end

  command "ExecuteCommand" do
    goal "Run a domain command in the sandbox"
    attribute :aggregate_name, AggregateName
    attribute :command_name, CommandName
    attribute :attributes, Attributes
  end

  command "InspectState" do
    goal "View current aggregate state in the sandbox"
    attribute :aggregate_name, AggregateName
  end

  command "ResetPlayground" do
    goal "Clear all sandbox state and events"
    end

  # RecentEvents removed (i751 sweep). Same shape as Explorer.ByKind :
  # `timestamp` only ever existed nested inside PlaygroundEvent (inside
  # `list_of(events)`), never as a top-level Playground field --
  # `where(timestamp: "recent")` asked for a field that doesn't exist.
  # Also dead by the ORIGINAL author's own admission (appeal.behaviors'
  # own comment, kept here for the record) : "where(timestamp: "recent")
  # is a literal-value filter ; ExecuteCommand doesn't set timestamp to
  # "recent" so the record [never matches]" -- and ExecuteCommand never
  # even appends to `events` in the first place (no then_set at all).
  # Removed rather than patched -- there was never a real value behind it.
end

  aggregate "Workbench" do
    identified_by :name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "WorkbenchName" do
      attribute :value, String
      invariant "must be the singleton 'workbench'" do
        value == "workbench"
      end
    end

    value_object "ActiveProject" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "ActiveAggregate" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "ProjectName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "AggregateName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "CommandName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Args" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "RecordId" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "Live domain interaction. Select a project, execute commands, inspect state."
  attribute :name, WorkbenchName, default: { value: "workbench" }
  attribute :active_project, ActiveProject
  attribute :active_aggregate, ActiveAggregate

  command "ShowWorkbench" do
    goal "Open the workbench REPL for this domain"
    emits "WorkbenchShown"
  end

  command "SelectProject" do
    goal "Set the active project for command dispatch"
    attribute :project_name, ProjectName
    emits "ProjectSelected"
  end

  command "SelectAggregate" do
    goal "Set the active aggregate for inspection"
    attribute :aggregate_name, AggregateName
    emits "AggregateSelected"
  end

  command "ExecuteCommand" do
    goal "Dispatch a command against the active project's runtime"
    attribute :command_name, CommandName
    attribute :args, Args
    emits "CommandExecuted"
  end

  command "InspectRepository" do
    goal "List all records in an aggregate's repository"
    attribute :aggregate_name, AggregateName
    emits "RepositoryInspected"
  end

  command "FindRecord" do
    goal "Find a single record by ID"
    attribute :aggregate_name, AggregateName
    attribute :record_id, RecordId
    emits "RecordFound"
  end

  command "ShowEventHistory" do
    goal "Show all events for the active project"
    emits "EventHistoryShown"
  end
end

  aggregate "Session" do
    identified_by :name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "IdeSessionName" do
      attribute :value, String
      invariant "must be the singleton 'session'" do
        value == "session"
      end
    end

    value_object "Mode" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "ConnectionStatus" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "IDE session with sketch/play modes and WebSocket connection state."
  attribute :name, IdeSessionName, default: { value: "session" }
  attribute :mode, Mode
  attribute :connection_status, ConnectionStatus

  command "EnterSketch" do
    goal "Switch to sketch mode for editing domain structure"
    emits "SketchEntered"
  end

  command "EnterPlay" do
    goal "Switch to play mode for executing domain commands"
    emits "PlayEntered"
  end

  command "Connect" do
    goal "Establish WebSocket connection to the IDE server"
    emits "Connected"
  end

  command "Disconnect" do
    goal "Close the WebSocket connection"
    emits "Disconnected"
  end

  command "RestoreConnection" do
    goal "Drop and re-establish the WebSocket connection"
    emits "ConnectionRestored"
  end
end

  aggregate "Layout" do
    identified_by :name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "LayoutName" do
      attribute :value, String
      invariant "must be the singleton 'layout'" do
        value == "layout"
      end
    end

    value_object "ActiveTab" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "SidebarCollapsed" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "EventsPanelCollapsed" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "PanelName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "TabName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Width" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "Height" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

  description "IDE panel and tab state. Tracks which panels are open, active tabs, sizes, and arrangement."
  attribute :name, LayoutName, default: { value: "layout" }
  attribute :panels, list_of(PanelState)
  attribute :active_tab, ActiveTab
  attribute :sidebar_collapsed, SidebarCollapsed
  attribute :events_panel_collapsed, EventsPanelCollapsed

  value_object "PanelState" do
    # "State of a single IDE panel -- name, visibility, dimensions"
    attribute :name, String
    attribute :open, String
    attribute :width, Integer
    attribute :height, Integer
    attribute :position, String
  end


  command "OpenPanel" do
    goal "Show a hidden panel"
    attribute :panel_name, PanelName
    emits "PanelOpened"
  end

  command "ClosePanel" do
    goal "Hide a panel"
    attribute :panel_name, PanelName
    emits "PanelClosed"
  end

  command "SelectTab" do
    goal "Switch the active tab in the main area"
    attribute :tab_name, TabName
    emits "TabSelected"
  end

  command "ResizePanel" do
    goal "Change a panel's dimensions"
    attribute :panel_name, PanelName
    attribute :width, Width
    attribute :height, Height
    emits "PanelResized"
  end

  command "ToggleSidebar" do
    goal "Collapse or expand the sidebar"
    emits "SidebarToggled"
  end

  command "ToggleEventsPanel" do
    goal "Collapse or expand the bottom events panel"
    emits "EventsPanelToggled"
  end

  command "HideProjects" do
    goal "Hide the projects sidebar panel"
    emits "ProjectsHidden"
  end

  command "ShowProjects" do
    goal "Show the projects sidebar panel"
    emits "ProjectsShown"
  end

end

  aggregate "LayoutState" do
    identified_by :name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "LayoutStateName" do
      attribute :value, String
      invariant "must be the singleton 'layout_state'" do
        value == "layout_state"
      end
    end

    value_object "CurrentFile" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "CurrentDomain" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Path" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Domain" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "Persisted layout preferences — current file, saved panel arrangement."
  attribute :name, LayoutStateName, default: { value: "layout_state" }
  attribute :current_file, CurrentFile
  attribute :current_domain, CurrentDomain

  command "TrackCurrentFile" do
    goal "Record the currently open file and domain for context"
    attribute :path, Path
    attribute :domain, Domain
    emits "CurrentFileTracked"
  end

  command "SaveState" do
    goal "Persist the current layout state to disk"
    emits "StateSaved"
  end

  command "RestoreState" do
    goal "Load persisted layout state from disk"
    emits "StateRestored"
  end
end

  aggregate "Menu" do
    identified_by :name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    # Named MenuInstanceName, not MenuName -- "MenuName" is already taken
    # by this aggregate's own VO for "which dropdown is open" (File/View/
    # Domain), used by OpenMenu/SelectMenuItem. Deviates from the usual
    # <Aggregate>Name convention to avoid colliding with that.
    value_object "MenuInstanceName" do
      attribute :value, String
      invariant "must be the singleton 'menu'" do
        value == "menu"
      end
    end

    value_object "OpenMenu" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "MenuName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Action" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "IDE menu bar with File, View, and Domain menus."
  attribute :name, MenuInstanceName, default: { value: "menu" }
  attribute :open_menu, OpenMenu
  attribute :items, list_of(MenuItem)

  value_object "MenuItem" do
    # "A single menu entry -- label, action, keyboard shortcut, enabled state"
    attribute :label, String
    attribute :action, String
    attribute :shortcut, String
    attribute :enabled, String
    attribute :separator, String
  end

  command "OpenMenu" do
    goal "Open a menu dropdown -- File, View, or Domain"
    attribute :menu_name, MenuName
    emits "MenuOpened"
  end

  command "CloseMenu" do
    goal "Close any open menu dropdown"
    emits "MenuClosed"
  end

  command "SelectMenuItem" do
    goal "Execute a menu item action"
    attribute :menu_name, MenuName
    attribute :action, Action
    emits "MenuItemSelected"
  end
end

  aggregate "KeyboardShortcut" do
    identified_by :key

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Key" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Modifiers" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "CommandAggregate" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "CommandName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "Keyboard shortcut binding. Maps key combinations to domain commands."
  attribute :key, Key
  attribute :modifiers, Modifiers
  attribute :command_aggregate, CommandAggregate
  attribute :command_name, CommandName

  command "BindShortcut" do
    goal "Register a keyboard shortcut for a command"
    attribute :key, Key
    attribute :modifiers, Modifiers
    attribute :command_aggregate, CommandAggregate
    attribute :command_name, CommandName
    emits "ShortcutBound"
  end

  command "TriggerShortcut" do
    goal "Fire the command associated with a key combination"
    attribute :key, Key
    attribute :modifiers, Modifiers
    emits "ShortcutTriggered"
  end
end

  aggregate "Notification" do
    identified_by :notification_id

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "NotificationId" do
      # No natural field on a notification is unique -- caller-supplied.
      attribute :value, String
      invariant "must not be empty" do
        !value.empty?
      end
    end

    value_object "Severity" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Message" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Context" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Dismissed" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "Feedback messages -- errors, warnings, success confirmations, progress updates."
  attribute :notification_id, NotificationId
  attribute :severity, Severity
  attribute :message, Message
  attribute :context, Context
  attribute :dismissed, Dismissed

  command "Notify" do
    goal "Create a notification for the user"
    attribute :notification_id, NotificationId
    attribute :severity, Severity
    attribute :message, Message
    attribute :context, Context
    emits "Notified"
    sets :notification_id
  end

  command "DismissNotification" do
    goal "Mark a notification as seen"
    emits "NotificationDismissed"
  end

  query "Active" do
    where(dismissed: "false")
  end
end

  aggregate "Screenshot" do
    identified_by :name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "ScreenshotName" do
      attribute :value, String
      invariant "must be the singleton 'screenshot'" do
        value == "screenshot"
      end
    end

    value_object "BufferSize" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "CaptureInterval" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "Status" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "FrameData" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Timestamp" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "Rolling buffer of browser screenshots for visual debugging."
  attribute :name, ScreenshotName, default: { value: "screenshot" }
  attribute :buffer_size, BufferSize
  attribute :capture_interval, CaptureInterval
  attribute :status, Status

  command "CaptureScreen" do
    goal "Save a screenshot frame from the browser"
    attribute :frame_data, FrameData
    attribute :timestamp, Timestamp
    emits "ScreenshotCaptured"
  end

  command "PauseCapture" do
    goal "Stop capturing screenshots"
    emits "CapturePaused"
  end

  command "ResumeCapture" do
    goal "Resume capturing screenshots"
    emits "CaptureResumed"
  end
end

  aggregate "Search" do
    identified_by :name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "SearchName" do
      attribute :value, String
      invariant "must be the singleton 'search'" do
        value == "search"
      end
    end

    value_object "QueryText" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "ResultCount" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "ElementType" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "Full-text search across domains, aggregates, commands, and attributes."
  attribute :name, SearchName, default: { value: "search" }
  attribute :query_text, QueryText
  attribute :results, list_of(SearchResult)
  attribute :result_count, ResultCount

  value_object "SearchResult" do
    # "A single search match with context"
    attribute :element_type, String
    attribute :element_name, String
    attribute :domain_name, String
    attribute :context, String
    attribute :relevance, Integer
  end

  command "SearchDomain" do
    goal "Search across all domain elements for a query string"
    attribute :query_text, QueryText
    emits "SearchCompleted"
  end

  command "ClearSearch" do
    goal "Reset search results"
    emits "SearchCleared"
  end

  command "FilterSearchResults" do
    goal "Narrow results by element type"
    attribute :element_type, ElementType
    emits "SearchResultsFiltered"
  end
end

policy "SwitchToEditorOnFileOpen" do
  on "FileOpened"
  # `defaults` was never a real PolicyBuilder verb (undefined method,
  # caught by validate -- i751 sweep). `map` was a later attempted fix
  # that ALSO retired -- `with:` moved onto `trigger` itself as a keyword
  # arg (ADR 0025).
  trigger SelectTab, with: { tab: "editor" }
end

end
