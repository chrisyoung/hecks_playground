    value_object "Name" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Definition" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Category" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "OldName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "NewName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "TermName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Reason" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "FromTerm" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "ToTerm" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Relationship" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "Ubiquitous language dictionary. Defines terms, enforces naming consistency."
  attribute :name, GlossaryName, default: { value: "glossary" }
