Hecks.bluebook "Appeal", version: "2026.05.12.1" do
  vision "Browser-based IDE for domain modeling"
  category "framework"

  aggregate "Project" do
    identified_by :path

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Name" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Path" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Status" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "SearchPath" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "A domain project workspace. Loads, creates, and manages domain directories."
  attribute :name, Name
  attribute :path, Path
  attribute :status, Status

  command "OpenProject" do
    goal "Load an existing domain from a directory"
    attribute :path, Path
    emits "ProjectOpened"
  end

  command "InitProject" do
    goal "Initialize a new domain with a name"
    attribute :name, Name
    attribute :path, Path
    emits "ProjectInitialized"
  end

  command "CloseProject" do
    goal "Close the current project and release resources"
    emits "ProjectClosed"
  end

  command "DiscoverProjects" do
    goal "Scan a directory for hecks_playground apps -- looks for hecks_playground/*.bluebook"
    attribute :search_path, SearchPath
    emits "ProjectsDiscovered"
  end

  command "LoadProjects" do
    goal "Discover and open all projects in a directory"
    attribute :search_path, SearchPath
    emits "ProjectsLoaded"
  end

end

  aggregate "Explorer" do
    identified_by :domain_name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "DomainName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "LastOpenedPath" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "LastOpenedDomain" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "AggregateName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "CommandName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Path" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Domain" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Format" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "Browse and inspect parsed domain structure -- aggregates, commands, references."
  attribute :domain_name, DomainName
  attribute :aggregate_names, list_of(ExplorerEntry)
  attribute :last_opened_path, LastOpenedPath
  attribute :last_opened_domain, LastOpenedDomain

  value_object "ExplorerEntry" do
    # "A named item in the domain structure"
    attribute :name, String
    attribute :kind, String
  end

  reference_to(Project)

  command "LoadDomain" do
    goal "Parse the project domain and populate the explorer tree"
    reference_to(Project)
    attribute :domain_name, DomainName
    emits "DomainLoaded"
    sets :domain_name
  end

  command "InspectAggregate" do
    goal "Show details of an aggregate"
    attribute :aggregate_name, AggregateName
    emits "AggregateInspected"
  end

  command "InspectCommand" do
    goal "Show details of a command"
    attribute :aggregate_name, AggregateName
    attribute :command_name, CommandName
    emits "CommandInspected"
  end

  command "OpenFile" do
    goal "Open a file from the project tree and record it as the last opened"
    reference_to(Project)
    attribute :path, Path
    attribute :domain, Domain
    emits "FileOpened"
  end

  command "GetLastOpened" do
    goal "Return the last opened file path and domain"
    emits "LastOpenedReturned"
  end

  command "ExportBluebook" do
    goal "Export the current domain as a .bluebook file"
    attribute :format, Format
    emits "BluebookExported"
  end

  # ByKind removed (i751). It asked `where(kind: kind)` at the Explorer
  # level, but `kind` only ever existed nested inside ExplorerEntry, one
  # level down inside `aggregate_names` -- Explorer itself never declared
  # a top-level `kind`. Investigated rather than patched blind: no real
  # caller anywhere in the repo (grepped clean -- only this declaration,
  # its own generic behaviors smoke test, and doc/template copies of the
  # same appeal.bluebook in chapters/, hecks_playground_genetics/, ruby/hecks_playground/).
  # The query DSL does support dotted list-nested paths at the
  # DECLARATION/validator level (QuerySpecification::FieldPath.leaf_attribute
  # walks through a list_of's member type fine), but NOT at the VALUE
  # side -- FieldPath.dig reduces a dotted path segment-by-segment via
  # plain Hash/record reads, which cannot descend into an Array to filter
  # its elements. Building nested-list-filter semantics into `where` to
  # make `"aggregate_names.kind" => kind` genuinely work would be real,
  # unscoped runtime work.
  #
  # Moot regardless : `aggregate_names` is never populated by ANY command
  # on Explorer today (LoadDomain emits DomainLoaded with no then_set at
  # all) -- filed separately as its own gap, not fixed here (see inbox).
  # A where-clause over a field that both doesn't exist AND has no real
  # data path behind it is dead code twice over -- removed, not patched
  # to satisfy the validator with semantics nobody could exercise.
end

  aggregate "Document" do
    identified_by :filename

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Filename" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Content" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Dirty" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "A source file open for editing. Tracks content, parse state, and dirty status."
  attribute :filename, Filename
  attribute :content, Content
  attribute :dirty, Dirty
  attribute :diagnostics, list_of(Diagnostic)

  value_object "Diagnostic" do
    # "A validation finding at a source location"
    attribute :line, Integer
    attribute :column, Integer
    attribute :severity, String
    attribute :message, String
  end

  reference_to(Project)

  command "OpenDocument" do
    goal "Load a .bluebook / .hecksagon / .world file into the editor"
    reference_to(Project)
    attribute :filename, Filename
    emits "DocumentOpened"
    sets :filename
  end

  command "EditDocument" do
    goal "Apply a text change to the document"
    attribute :content, Content
    emits "DocumentEdited"
  end

  command "SaveDocument" do
    goal "Persist the document back to disk"
    emits "DocumentSaved"
  end

  command "ValidateDocument" do
    goal "Parse and validate the document, producing diagnostics"
    emits "DocumentValidated"
  end

end

  aggregate "Timeline" do
    identified_by :timeline_id

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "TimelineId" do
      # No natural field on a timeline is unique -- caller-supplied.
      attribute :value, String
      invariant "must not be empty" do
        !value.empty?
      end
    end

    value_object "Cursor" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "Action" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Detail" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

  description "Edit history with undo/redo. Tracks document changes as a linear sequence."
  attribute :timeline_id, TimelineId
  attribute :entries, list_of(TimelineEntry)
  attribute :cursor, Cursor

  value_object "TimelineEntry" do
    # "A recorded change with before/after content"
    attribute :action, String
    attribute :detail, String
    attribute :timestamp, String
  end

  reference_to(Document)

  command "RecordChange" do
    goal "Append a change to the timeline"
    reference_to(Document)
    attribute :timeline_id, TimelineId
    attribute :action, Action
    attribute :detail, Detail
    sets :timeline_id
  end

  command "Undo" do
    goal "Move the cursor back one step and revert the change"
    end

  command "Redo" do
    goal "Move the cursor forward and reapply the change"
    end
end

  aggregate "Generator" do
    identified_by :target

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
