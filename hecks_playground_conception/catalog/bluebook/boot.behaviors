Hecks.behaviors "Boot" do
  vision "Behavioral tests for the Boot domain — exercises every command and query in memory"

  # ── Session aggregate ──────────────────────────────────────────

  test "BootWithClaude runs" do
    tests "BootWithClaude", on: "Session"
    input  session_name: "session"
    expect engine: "claude", brain_source: "anthropic", status: "booting"
  end

  test "BootWithClaude cascades through policy chain" do
    tests "BootWithClaude", on: "Session", kind: :cascade
    input  session_name: "session"
    expect emits: ["SessionStartedWithClaude", "BrainProbed"]
  end

  test "BootWithSummer sets ollama_model + ollama_port" do
    tests "BootWithSummer", on: "Session"
    input  session_name: "session", ollama_model: "sample", ollama_port: 1
    expect engine: "summer", brain_source: "local", status: "booting"
  end

  test "BootWithSummer cascades through policy chain" do
    tests "BootWithSummer", on: "Session", kind: :cascade
    input  session_name: "session", ollama_model: "sample", ollama_port: 1
    expect emits: ["SessionStartedWithSummer", "BrainProbed"]
  end

  test "FailBoot sets reason" do
    tests "FailBoot", on: "Session"
    setup  "BootWithClaude", session_name: "session"
    input  session_name: "session", reason: "sample"
    expect status: "failed"
  end

  test "WireOrgans sets organ_count + nerve_count + law_count" do
    tests "WireOrgans", on: "Session"
    setup  "BootWithClaude", session_name: "session"
    input  session_name: "session", organ_count: 1, nerve_count: 1, law_count: 1
    expect organ_count: 1, nerve_count: 1, law_count: 1
  end

  test "WireOrgans cascades through policy chain" do
    tests "WireOrgans", on: "Session", kind: :cascade
    setup  "BootWithClaude", session_name: "session"
    input  session_name: "session", organ_count: 1, nerve_count: 1, law_count: 1
    expect emits: ["OrgansWired", "SessionLive"]
  end

  test "GoLive sets started_at" do
    tests "GoLive", on: "Session"
    setup  "BootWithClaude", session_name: "session"
    input  session_name: "session", started_at: "sample"
    expect started_at: "sample", status: "live"
  end

  test "EndSession runs" do
    tests "EndSession", on: "Session"
    setup  "BootWithClaude", session_name: "session"
    setup  "GoLive", session_name: "session", started_at: "sample"
    input  session_name: "session"
    expect status: "ended"
  end


  # ── BrainProbe aggregate ──────────────────────────────────────────

  test "Probe runs" do
    tests "Probe", on: "BrainProbe"
    input  probe_name: "probe"
    expect ok: "true"
  end

  test "RecommendClaude runs" do
    tests "RecommendClaude", on: "BrainProbe"
    setup  "Boot::BrainProbe.Probe", probe_name: "probe"
    input  probe_name: "probe"
    expect recommended_engine: "claude"
  end

  test "RecommendClaude cascades through policy chain" do
    tests "RecommendClaude", on: "BrainProbe", kind: :cascade
    input  probe_name: "probe"
    setup  "Boot::BrainProbe.Probe", probe_name: "probe"
    setup  "BootWithClaude", session_name: "session"
    # Cross-aggregate cascade: ClaudeRecommended → WireOrgans → GoLive
    # hops BrainProbe → Session. The Session record from the BootWithClaude
    # setup is in a different aggregate scope so the cascade only sees
    # ClaudeRecommended in the bus boundary. emits_subset: locks the
    # event we know fires and tolerates the cross-aggregate gap.
    expect_event "ClaudeRecommended"
  end

  test "RecommendSummer runs" do
    tests "RecommendSummer", on: "BrainProbe"
    setup  "Boot::BrainProbe.Probe", probe_name: "probe"
    input  probe_name: "probe"
    expect recommended_engine: "summer"
  end

  test "RecommendSummer cascades through policy chain" do
    tests "RecommendSummer", on: "BrainProbe", kind: :cascade
    input  probe_name: "probe"
    setup  "Boot::BrainProbe.Probe", probe_name: "probe"
    setup  "BootWithClaude", session_name: "session"
    # Cross-aggregate cascade — see RecommendClaude note above.
    expect_event "SummerRecommended"
  end

  test "RecommendNothing runs" do
    tests "RecommendNothing", on: "BrainProbe"
    setup  "Boot::BrainProbe.Probe", probe_name: "probe"
    input  probe_name: "probe"
    expect recommended_engine: "none"
  end

  test "RecommendNothing cascades through policy chain" do
    tests "RecommendNothing", on: "BrainProbe", kind: :cascade
    input  probe_name: "probe"
    setup  "Boot::BrainProbe.Probe", probe_name: "probe"
    setup  "BootWithClaude", session_name: "session"
    expect emits: ["NoBrainAvailable", "BootFailed"]
  end

end
