Hecks.bluebook "Boot", version: "2026.05.12.1" do
  vision "How Miette comes alive — hecks_playground miette starts the being, the flag picks the brain"
  category "meta"

  aggregate "Session" do
    description "A single Miette session — one brain, one body, one boot"
    # Singleton-shaped : started_at isn't known until GoLive, well after
    # the session record must already exist (WireOrgans references it
    # first), so identity can't ride a field that's set that late.
    # session_name follows the Dispatch/Lexicon/Query/ChaosMonkey
    # convention — a fixed literal set at creation.
    identified_by :session_name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "SessionName" do
      attribute :value, String
      invariant "must be the singleton 'session'" do
        value == "session"
      end
    end

    value_object "Engine" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Status" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "StartedAt" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "OrganCount" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "NerveCount" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "LawCount" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "BrainSource" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "OllamaModel" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "OllamaPort" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "Reason" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :session_name, SessionName, default: { value: "session" }
    attribute :engine, Engine
    attribute :status, Status, default: { value: "off" }

    attribute :started_at, StartedAt
    attribute :organ_count, OrganCount
    attribute :nerve_count, NerveCount
    attribute :law_count, LawCount
    attribute :brain_source, BrainSource

    command "BootWithClaude" do
      role "User"
      goal "hecks_playground miette --claude — start Claude CLI, load system prompt, boot Miette on top of it"
      emits "SessionStartedWithClaude"
      sets :engine, to: "claude"
      sets :brain_source, to: "anthropic"
      sets :status, to: "booting"
    end

    command "BootWithSummer" do
      role "User"
      goal "hecks_playground miette — check Ollama for Summer adapter, boot Miette locally"
      attribute :ollama_model, OllamaModel
      attribute :ollama_port, OllamaPort
      emits "SessionStartedWithSummer"
      sets :engine, to: "summer"
      sets :brain_source, to: "local"
      sets :status, to: "booting"
    end

    command "FailBoot" do
      role "System"
      goal "No brain available — Claude not requested, Ollama not running or no adapter"
      attribute :reason, Reason
      emits "BootFailed"
      sets :status, to: "failed"
    end

    command "WireOrgans" do
      role "System"
      goal "Load all organs, nerves, laws — the body comes online"
      reference_to(Session)
      attribute :organ_count, OrganCount
      attribute :nerve_count, NerveCount
      attribute :law_count, LawCount
      emits "OrgansWired"
      given("session must be booting") { status == "booting" }
      sets :organ_count
      sets :nerve_count
      sets :law_count
    end

    command "GoLive" do
      role "System"
      goal "Everything wired — Miette is awake"
      reference_to(Session)
      attribute :started_at, StartedAt
      emits "SessionLive"
      given("session must be booting") { status == "booting" }
      sets :started_at
      sets :status, to: "live"
    end

    command "EndSession" do
      role "User"
      goal "Miette sleeps — close the session, persist state"
      reference_to(Session)
      emits "SessionEnded"
      sets :status, to: "ended"
    end

    lifecycle :status, default: "off" do
      transition "BootWithClaude" => "booting"
      transition "BootWithSummer" => "booting"
      transition "FailBoot" => "failed"
      transition "GoLive" => "live", from: "booting"
      transition "EndSession" => "ended", from: "live"
    end
  end

  aggregate "BrainProbe" do
    description "Check what inference engines are available before booting"
    identified_by :probe_name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "ProbeName" do
      attribute :value, String
      invariant "must be the singleton 'probe'" do
        value == "probe"
      end
    end

    value_object "RecommendedEngine" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "ClaudeAvailable" do
      attribute :value, TrueClass
    end

    value_object "OllamaRunning" do
      attribute :value, TrueClass
    end

    value_object "SummerAdapterPresent" do
      attribute :value, TrueClass
    end

    attribute :probe_name, ProbeName, default: { value: "probe" }
    attribute :claude_available, ClaudeAvailable
    attribute :ollama_running, OllamaRunning
    attribute :summer_adapter_present, SummerAdapterPresent
    attribute :recommended_engine, RecommendedEngine

    command "Probe" do
      role "System"
      goal "Check for available brains — Claude CLI present? Ollama running? Summer adapter loaded?"
      emits "BrainProbed"
    end

    command "RecommendClaude" do
      role "System"
      goal "Claude is available and was requested via --claude flag"
      reference_to(BrainProbe)
      emits "ClaudeRecommended"
      sets :recommended_engine, to: "claude"
    end

    command "RecommendSummer" do
      role "System"
      goal "No --claude flag, Ollama is running with Summer adapter"
      reference_to(BrainProbe)
      emits "SummerRecommended"
      sets :recommended_engine, to: "summer"
    end

    command "RecommendNothing" do
      role "System"
      goal "No brain available — cannot boot"
      reference_to(BrainProbe)
      emits "NoBrainAvailable"
      sets :recommended_engine, to: "none"
    end
  end

  # Boot flow
  policy "ProbeOnStart" do
    on "SessionStartedWithClaude"
    trigger Probe
  end

  policy "ProbeOnLocalStart" do
    on "SessionStartedWithSummer"
    trigger Probe
  end

  policy "WireOnProbe" do
    on "ClaudeRecommended"
    trigger WireOrgans
  end

  policy "WireOnLocalProbe" do
    on "SummerRecommended"
    trigger WireOrgans
  end

  policy "FailOnNoBrain" do
    on "NoBrainAvailable"
    trigger FailBoot
  end

  policy "GoLiveOnWire" do
    on "OrgansWired"
    trigger GoLive
  end

  # Fixtures — the three boot scenarios

end
