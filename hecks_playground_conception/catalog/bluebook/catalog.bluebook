Hecks.bluebook "Catalog", version: "2026.05.12.1" do
  vision "Born domains with version history — every development leaves a trail"
  category "meta"

  aggregate "Entry" do
    description "A domain in the catalog — current version plus full history"
    identified_by :name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "Name" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Version" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Path" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "AggregateCount" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "CommandCount" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "PolicyCount" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "Lines" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "Status" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :name, Name
    attribute :version, Version
    attribute :path, Path
    attribute :aggregate_count, AggregateCount
    attribute :command_count, CommandCount
    attribute :policy_count, PolicyCount
    attribute :lines, Lines
    attribute :status, Status, default: { value: "pending" }


    command "RegisterDomain" do
      role "Miette"
      goal "Add a born domain to the catalog"
      attribute :name, Name
      attribute :version, Version
      attribute :path, Path
      attribute :aggregate_count, AggregateCount
      attribute :command_count, CommandCount
      attribute :policy_count, PolicyCount
      attribute :lines, Lines
      emits "DomainRegistered"
      sets :name
      sets :version
      sets :path
      sets :aggregate_count
      sets :command_count
      sets :policy_count
      sets :lines
      sets :status, to: "active"
    end

    command "DevelopDomain" do
      role "Miette"
      goal "Domain developed — bump version, snapshot the old one, update entry"
      reference_to(Entry)
      attribute :version, Version
      attribute :aggregate_count, AggregateCount
      attribute :command_count, CommandCount
      attribute :policy_count, PolicyCount
      attribute :lines, Lines
      emits "DomainDeveloped"
      sets :version
      sets :aggregate_count
      sets :command_count
      sets :policy_count
      sets :lines
    end

    command "RetireDomain" do
      role "Miette"
      goal "A domain is no longer in active use"
      reference_to(Entry)
      emits "DomainRetired"
      sets :status, to: "retired"
    end

    lifecycle :status, default: "pending" do
      transition "RegisterDomain" => "active", from: "pending"
      transition "RetireDomain" => "retired", from: "active"
    end
  end

  aggregate "Version" do
    description "A snapshot of a domain at a point in time — development history"
    # Composite : many versions per domain, so domain_name alone isn't
    # unique — the (domain, version-string) pair is.
    identified_by :domain_name, :version

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "DomainName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Version" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Snapshot" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "DevelopedFrom" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "DevelopedAt" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "AggregateCount" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "CommandCount" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "Vector" do
      # Typed wrapper around the underlying Float on this aggregate.
      attribute :value, Float
    end

    value_object "FromVersion" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "ToVersion" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :domain_name, DomainName
    attribute :version, Version
    attribute :snapshot, Snapshot
    attribute :developed_from, DevelopedFrom
    attribute :developed_at, DevelopedAt
    attribute :aggregate_count, AggregateCount
    attribute :command_count, CommandCount
    attribute :vector, list_of(Vector)

    command "SnapshotVersion" do
      role "System"
      goal "Capture the full bluebook content at this version — preserves the exact shape"
      attribute :domain_name, DomainName
      attribute :version, Version
      attribute :snapshot, Snapshot
      attribute :developed_from, DevelopedFrom
      attribute :aggregate_count, AggregateCount
      attribute :command_count, CommandCount
      attribute :vector, list_of(Vector)
      emits "VersionSnapshotted"
      sets :domain_name
      sets :version
      sets :snapshot
      sets :developed_from
      sets :aggregate_count
      sets :command_count
      sets :vector
    end

    command "CompareVersions" do
      role "Miette"
      goal "Diff two versions of a domain — see what changed in development"
      attribute :domain_name, DomainName
      attribute :from_version, FromVersion
      attribute :to_version, ToVersion
      emits "VersionsCompared"
    end
  end

  aggregate "Mirror" do
    description "Auto-sync catalog from cannon — always current, never stale"
    identified_by :mirror_name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "MirrorName" do
      attribute :value, String
      invariant "must be the singleton 'mirror'" do
        value == "mirror"
      end
    end

    value_object "CannonPath" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "LastSyncedAt" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "DomainsSynced" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    attribute :mirror_name, MirrorName, default: { value: "mirror" }
    attribute :cannon_path, CannonPath
    attribute :last_synced_at, LastSyncedAt
    attribute :domains_synced, DomainsSynced

    command "SyncFromCannon" do
      role "System"
      goal "Copy bluebooks from cannon to catalog, bump versions on changes, snapshot old versions"
      attribute :cannon_path, CannonPath
      emits "CatalogSynced"
      sets :cannon_path
    end

    command "DetectDrift" do
      role "System"
      goal "Compare catalog versions against cannon — find what changed"
      emits "DriftDetected"
    end
  end

  aggregate "Index" do
    description "The full index — catalog and nursery combined"
    identified_by :index_name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "IndexName" do
      attribute :value, String
      invariant "must be the singleton 'index'" do
        value == "index"
      end
    end

    value_object "CatalogCount" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "NurseryCount" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "TotalAggregates" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "TotalCommands" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    attribute :index_name, IndexName, default: { value: "index" }
    attribute :catalog_count, CatalogCount
    attribute :nursery_count, NurseryCount
    attribute :total_aggregates, TotalAggregates
    attribute :total_commands, TotalCommands

    command "RebuildIndex" do
      role "System"
      goal "Scan catalog and nursery, recount everything"
      attribute :catalog_count, CatalogCount
      attribute :nursery_count, NurseryCount
      attribute :total_aggregates, TotalAggregates
      attribute :total_commands, TotalCommands
      emits "IndexRebuilt"
      sets :catalog_count
      sets :nursery_count
      sets :total_aggregates
      sets :total_commands
    end
  end

  # Every development snapshots the old version first
  policy "SnapshotOnDevelop" do
    on "DomainDeveloped"
    trigger SnapshotVersion
  end

  # Every registration gets a snapshot too — version 1
  policy "SnapshotOnRegister" do
    on "DomainRegistered"
    trigger SnapshotVersion
  end

  # Development triggers reindexing
  policy "ReindexOnDevelop" do
    on "DomainDeveloped"
    trigger RebuildIndex
  end

  # Sync detects drift and develops
  policy "DevelopOnDrift" do
    on "DriftDetected"
    trigger DevelopDomain
  end

  # Registration triggers index
  policy "IndexOnRegister" do
    on "DomainRegistered"
    trigger RebuildIndex
  end
end
