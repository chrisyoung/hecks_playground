Hecks.bluebook "Court", version: "2026.05.12.1" do
  vision "Judge specific actions against the Law book — every tool use, commit, conception, and deployment is a case that receives a ruling"

  aggregate "Case" do
    description "A specific action submitted for judgment — what happened, who did it, what evidence exists"
    # Many cases over time — nothing else on a case is unique, so the
    # caller mints case_id at File time (Finding already references
    # case_id as a foreign key ; Case itself never declared the field).
    identified_by :case_id

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "CaseId" do
      attribute :value, String
      invariant "must not be empty" do
        !value.empty?
      end
    end

    value_object "ActionType" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Actor" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Target" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Detail" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "OccurredAt" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Status" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "LawsApplicable" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "LawsPassed" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "LawsViolated" do
      # Typed wrapper around the underlying Integer on this aggregate.
      attribute :value, Integer
    end

    value_object "Ruling" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :case_id, CaseId
    attribute :action_type, ActionType
    attribute :actor, Actor
    attribute :target, Target
    attribute :detail, Detail
    attribute :occurred_at, OccurredAt
    attribute :status, Status, default: { value: "unfiled" }

    attribute :laws_applicable, LawsApplicable
    attribute :laws_passed, LawsPassed
    attribute :laws_violated, LawsViolated
    attribute :ruling, Ruling

    command "File" do
      role "Enforcer"
      goal "File a case — submit an action for review against applicable laws"
      attribute :case_id, CaseId
      attribute :action_type, ActionType
      attribute :actor, Actor
      attribute :target, Target
      attribute :detail, Detail
      attribute :occurred_at, OccurredAt
      emits "CaseFiled"
      sets :case_id
      sets :action_type
      sets :actor
      sets :target
      sets :detail
      sets :occurred_at
      sets :laws_applicable, to: 0
      sets :laws_passed, to: 0
      sets :laws_violated, to: 0
    end

    command "Hear" do
      role "Judge"
      goal "Begin hearing the case — identify which laws apply to this action type"
      reference_to(Case)
      attribute :laws_applicable, LawsApplicable
      emits "CaseHeard"
      given("case must be filed") { status == "filed" }
      sets :laws_applicable
    end

    command "CheckLaw" do
      role "Judge"
      goal "Check one applicable law against the action — pass or violate"
      reference_to(Case)
      attribute :passed, TrueClass
      emits "LawCheckedInCase"
    end

    command "RuleInnocent" do
      role "Judge"
      goal "All applicable laws passed — the action was lawful"
      reference_to(Case)
      emits "RuledInnocent"
      given("no violations") { laws_violated == 0 }
      sets :ruling, to: "innocent"
    end

    command "RuleGuilty" do
      role "Judge"
      goal "One or more laws were violated — the action was unlawful"
      reference_to(Case)
      emits "RuledGuilty"
      sets :ruling, to: "guilty"
    end

    command "Appeal" do
      role "Architect"
      goal "Reopen a closed case for re-examination — new evidence or amended law"
      reference_to(Case)
      emits "CaseAppealed"
    end

    lifecycle :status, default: "unfiled" do
      transition "File" => "filed"
      transition "Hear" => "hearing", from: "filed"
      transition "RuleInnocent" => "closed", from: "hearing"
      transition "RuleGuilty" => "closed", from: "hearing"
      transition "Appeal" => "appealed", from: "closed"
      transition "Hear" => "hearing", from: "appealed"
    end
  end

  aggregate "Finding" do
    description "One law checked against one action — the atomic unit of judgment"
    # Composite : one finding per law checked per case.
    identified_by :case_id, :law_name

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "CaseId" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "LawName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "CheckExpression" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Evidence" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Explanation" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Passed" do
      attribute :value, TrueClass
    end

    attribute :case_id, CaseId
    attribute :law_name, LawName
    attribute :check_expression, CheckExpression
    attribute :evidence, Evidence
    attribute :passed, Passed
    attribute :explanation, Explanation

    command "RecordFinding" do
      role "Judge"
      goal "Record whether a specific law was satisfied or violated for this action"
      attribute :case_id, CaseId
      attribute :law_name, LawName
      attribute :check_expression, CheckExpression
      attribute :evidence, Evidence
      attribute :passed, Passed
      attribute :explanation, Explanation
      emits "FindingRecorded"
      sets :case_id
      sets :law_name
      sets :check_expression
      sets :evidence
      sets :passed
      sets :explanation
    end
  end

  aggregate "Precedent" do
    description "A ruling that informs future judgments — when a case establishes a pattern"
    # Composite : one live precedent per law+action-type combination.
    identified_by :law_name, :action_type

    # ── Value-objects : wrapped primitives (no-primitive-envy, 2026-05-12) ──
    # Per i555 VOs live inside their aggregate ; one wrapper per
    # surface primitive, each carrying `attribute :value, <Primitive>`.

    value_object "LawName" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "ActionType" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Ruling" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "Reasoning" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    value_object "EstablishedAt" do
      # Typed wrapper around the underlying String on this aggregate.
      attribute :value, String
    end

    attribute :law_name, LawName
    attribute :action_type, ActionType
    attribute :ruling, Ruling
    attribute :reasoning, Reasoning
    attribute :established_at, EstablishedAt

    command "Establish" do
      role "Judge"
      goal "Record a precedent — this ruling should apply to similar future actions"
      attribute :law_name, LawName
      attribute :action_type, ActionType
      attribute :ruling, Ruling
      attribute :reasoning, Reasoning
      attribute :established_at, EstablishedAt
      emits "PrecedentEstablished"
      sets :law_name
      sets :action_type
      sets :ruling
      sets :reasoning
      sets :established_at
    end

    command "Overturn" do
      role "Architect"
      goal "A precedent no longer applies — the law was amended or the reasoning was wrong"
      reference_to(Precedent)
      attribute :reasoning, Reasoning
      emits "PrecedentOverturned"
      sets :ruling, to: "overturned"
      sets :reasoning
    end
  end

  # Court flow
  policy "HearOnFiling" do
    on "CaseFiled"
    trigger Hear
  end

  policy "FindingUpdatesCase" do
    on "FindingRecorded"
    trigger CheckLaw
  end

  policy "ViolationToLaw" do
    on "RuledGuilty"
    trigger RecordViolation
  end

  # === Case fixtures — real actions judged ===

  # Miette edits a file — was it lawful?

  # Summer conceives a domain — was it lawful?

  # Miette conceives DomainCompression — lawful

  # Precedent examples
end
