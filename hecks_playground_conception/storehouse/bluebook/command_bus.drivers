# Driving/driven adapter declarations moved out of command_bus.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word (no interval/cron
# drivers, no `driven on` reactions). Kept verbatim as the spec for an
# upstream hecks feature. Nothing loads this file.

  adapter :fs, root: "information"

  adapter :memory

  adapter :shell, name: :delegate,
    command: "storehouse",
    args: ["storehouse", "route", "{{phrase}}", "{{params_kv}}"],
    output_format: :text,
    timeout: 60
