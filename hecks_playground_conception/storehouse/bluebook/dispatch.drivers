# Driving/driven adapter declarations moved out of dispatch.hecksagon:
# hecks 1.3.0's hecksagon grammar has no `adapter` word (no interval/cron
# drivers, no `driven on` reactions). Kept verbatim as the spec for an
# upstream hecks feature. Nothing loads this file.

  adapter :memory

  adapter :shell, name: :invoke,
    command: "storehouse",
    args: ["run", "{{target.bluebook_path}}", "entrypoint={{phrase}}"],
    output_format: :text,
    timeout: 60
