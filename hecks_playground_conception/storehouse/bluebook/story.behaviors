Hecks.behaviors "Story" do
  vision "Behavioral tests for the Story domain — Conceive mints a draft Story from a card_ref, ComposeStep appends ordered steps, Run flips the Story complete."

  # ── Story aggregate ──────────────────────────────────────────

  test "Conceive mints a draft Story keyed on the card_ref" do
    tests "Conceive", on: "Story"
    input  id: "i724", title: "Explicit cascade as storehouse entity"
    expect title: "Explicit cascade as storehouse entity", status: "draft"
  end

  test "ComposeStep appends one ordered step" do
    tests "ComposeStep", on: "Story"
    setup  "Conceive", id: "i724", title: "Explicit cascade as storehouse entity"
    input  id: "i724", order: 0, phrase: "Voice::Voice.Speak", args: "{\"text\":\"hi\"}"
    expect steps: [{ order: 0, phrase: "Voice::Voice.Speak", args: "{\"text\":\"hi\"}" }]
  end

  test "ComposeStep accretes two steps in order" do
    tests "ComposeStep", on: "Story"
    setup  "Conceive", id: "i724", title: "Explicit cascade as storehouse entity"
    setup  "ComposeStep", id: "i724", order: 0, phrase: "Voice::Voice.Speak", args: "{}"
    input  id: "i724", order: 1, phrase: "Inbox::Inbox.Check", args: "{}"
    expect steps: [{ order: 0, phrase: "Voice::Voice.Speak", args: "{}" }, { order: 1, phrase: "Inbox::Inbox.Check", args: "{}" }]
  end

  test "Run flips the Story complete" do
    tests "Run", on: "Story"
    setup  "Conceive", id: "i724", title: "Explicit cascade as storehouse entity"
    input  id: "i724", step_count: 2
    expect status: "complete"
  end

end
