#!/usr/bin/env ruby
# hecksagain-cli — the storehouse-mcp-facing entrypoint over HecksagainRuntime.
# Replaces rust/cli's `storehouse` binary as the thing STOREHOUSE_BIN points
# at. Each subcommand prints ONE line of JSON to stdout and exits 0/1 --
# no cascade/timeline text, no stdout-log-scraping contract to honor (see
# Part 5 of the migration plan: this is a deliberate simplification, not a
# preserved-shape compatibility layer).
#
# Subcommands (mirrors what tooling/storehouse-mcp's .mjs defs call):
#   hecksagain-cli dispatch <root> <FQN> [k=v ...]
#   hecksagain-cli query    <root> <FQN> [k=v ...]
#   hecksagain-cli state    <root> <Aggregate::FQN> <id>
#   hecksagain-cli catalog  <root>
#   hecksagain-cli describe <root> <Aggregate::FQN>
#   hecksagain-cli list     <root>
#   hecksagain-cli adapter-handler <root> <adapter-name>  (i746 step 7 --
#                                               replaces bin/adapter-host's
#                                               old dump-hecksagon shell-out)
#   hecksagain-cli validate <root>
#   hecksagain-cli macrophage <root>          (reads tool-call JSON from stdin)
#   hecksagain-cli governed-door <root> <tool-name>
#   hecksagain-cli behaviors <path>           (path: a .behaviors file, or a
#                                               dir to sweep -- i745)
#   hecksagain-cli conceive-behaviors <path>  (NOT YET SUPPORTED -- see below)
#   hecksagain-cli statusline                 (prints a PLAIN line, not JSON --
#                                               statusline-command.sh's exec contract)

# hecksagain-cutover PRD, slice 2.1: `hecksagain` now resolves through the
# Bundler `git:` dependency pinned in ../../Gemfile (hecks-hecksagain,
# ref-pinned), not the hand-maintained ../../vendor/hecksagain/lib copy.
# BUNDLE_GEMFILE is set explicitly (not left to Dir.pwd) because this
# script is spawned directly (tooling/storehouse-mcp's cli_dispatch.mjs
# execs the file, not `bundle exec ruby ...`) from whatever cwd the
# spawning process happens to have.
ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../../Gemfile", __dir__)
require "bundler/setup"

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecksagain_runtime"
require "hecksagain_runtime/governed_door"
require "hecksagain_runtime/macrophage_bridge"
require "hecksagain_runtime/statusline"
require "json"

# `statusline` short-circuits before the JSON-envelope machinery below --
# Claude Code's statusLine harness execs this and renders stdout VERBATIM
# (rust/src/run_statusline/mod.rs's own contract, ported faithfully; see
# HecksagainRuntime::Statusline's own header). Every other subcommand
# answers `{ok, ...}` JSON on one line; this one answers a plain rendered
# status line instead, so it can't share that path.
if ARGV.first == "statusline"
  HecksagainRuntime::Statusline.run
  exit 0
end

# Splits each "k=v" CLI arg into a raw string pair -- NO JSON-guessing here
# any more (that used to blindly `JSON.parse` every value, which silently
# corrupted a JSON-shaped `content=...` string written through
# Tools::FileTool.Write into a decoded Hash before it ever reached the
# adapter -- see HecksagainRuntime::AttrDecode). `dispatch`/`query` decide
# per attribute, against the verb's own declared schema, once they know
# which command or query is being called.
def parse_kv(pairs)
  pairs.to_h { |pair| pair.split("=", 2) }
end

subcommand, root, *rest = ARGV

result =
  case subcommand
  when "dispatch"
    verb, *kv = rest
    HecksagainRuntime.dispatch(root, verb, parse_kv(kv))
  when "query"
    verb, *kv = rest
    HecksagainRuntime.query(root, verb, parse_kv(kv))
  when "state"
    aggregate_fqn, id = rest
    HecksagainRuntime.state(root, aggregate_fqn, id)
  when "catalog"
    HecksagainRuntime.catalog(root)
  when "describe"
    HecksagainRuntime.describe_aggregate(root, rest.first)
  when "list"
    HecksagainRuntime.list_aggregates(root)
  when "adapter-handler"
    # hecksagain-cli adapter-handler <root> <adapter-name> -- what
    # bin/adapter-host now calls instead of its old `dump-hecksagon | jq
    # '.adapters[0].handler'` shell-out (dump-hecksagon was never a real
    # hecksagain-cli subcommand, i746 step 7).
    HecksagainRuntime.adapter_handler(root, rest.first)
  when "validate"
    HecksagainRuntime.validate(root)
  when "macrophage"
    payload = JSON.parse($stdin.read)
    HecksagainRuntime::MacrophageBridge.call(root, payload)
  when "governed-door"
    HecksagainRuntime::GovernedDoor.lookup_door(root, rest.first)
  when "behaviors"
    # i745 -- ported from rust/src/behaviors_runner.rs + behaviors_parser.rs
    # (build the behaviors runtime BEFORE the Rust parser is deleted, per
    # Chris's explicit order ; see HecksagainRuntime::BehaviorsRunner's own
    # header for the ported semantics and the one disclosed deviation --
    # hecksagain's dispatcher has no cascade-off mode). `root` is a single
    # `.behaviors` file OR a directory to sweep ; either way `ok:true`
    # always carries `files_swept`/`summary` counts so a green result says
    # how much it actually looked at, not just that it found nothing wrong.
    if root && File.file?(root) && root.end_with?(".behaviors")
      r = HecksagainRuntime::BehaviorsRunner.run_file(root)
      { ok: true, files_swept: 1, files: [r], summary: HecksagainRuntime::BehaviorsRunner.summarize([r]) }
    elsif root && File.directory?(root)
      { ok: true }.merge(HecksagainRuntime::BehaviorsRunner.run_corpus(root))
    else
      { ok: false, error: "#{root.inspect} is not a .behaviors file or a directory" }
    end
  when "conceive-behaviors"
    # NOT ported -- a DIFFERENT subsystem from `behaviors` above (rust/src/
    # behaviors_conceiver/ GENERATES a suite from a bluebook's own commands
    # ; this CLI verb only RUNS an existing suite). Scoped out of i745 on
    # purpose: verifying the new parser's correctness needed a runner, not
    # a generator. Honest stub, not a silent no-op.
    { ok: false, supported: false,
      error: "hecksagain has no behaviors CONCEIVER yet (rust/src/behaviors_conceiver, not ported -- distinct from `behaviors`, which now runs an existing suite, i745). Write .behaviors files by hand for now." }
  else
    { ok: false, error: "unknown subcommand #{subcommand.inspect}" }
  end

puts JSON.generate(result)
# EXIT CODE, not the same question as the JSON's own `ok` field for every
# subcommand -- found live this pass (storehouse-mcp rewrite, migration
# plan Part 5 "correction" pass): `state`'s `ok` deliberately carries
# "was a record found?" (HecksagainRuntime.state's own doc comment : "A
# missing record returns ok:false ... not an error — 'no such record' is
# a normal answer to a state query"), a DIFFERENT question from "did this
# CLI invocation itself fail?" every other subcommand's `ok` answers. A
# blanket `exit(ok == false ? 1 : 0)` conflated the two, so a plain miss
# (no `error_class`, nothing actually raised) exited 1 same as a real
# crash -- state.mjs's `toMcpResponse` reads that exit code straight into
# `isError`, so a normal "no such record" answer surfaced as an MCP tool
# ERROR. Scoped to `state` alone : `describe`'s own "no such aggregate"
# miss deliberately DOES want isError=true (a caller correction, not a
# graceful empty answer -- see describe_aggregate.mjs's own miss-message
# design), so the general `ok`-driven rule stays correct everywhere else.
# `behaviors` gets its OWN branch, same shape as `state`'s : `ok:true`
# deliberately stays true even when the sweep found real failures (the
# INVOCATION succeeded -- it correctly determined some tests failed, same
# as `validate`'s ok:true/valid:false distinction). Without this, exit code
# only ever reflected "did the sweep crash", never "did it find anything" --
# a CI gate built on `hecksagain-cli behaviors` would have been GREEN no
# matter how many tests failed, the exact always-green shape this whole
# arc exists to end. Found live wiring test.yml (parser-removal plan,
# Phase 2), before it shipped, not after.
exit_code =
  if subcommand == "state"
    result[:error_class] ? 1 : 0
  elsif subcommand == "behaviors"
    summary = result[:summary]
    bad = result[:ok] == false ||
          (summary && ((summary[:failed] || 0) + (summary[:errored] || 0) + (summary[:parse_errors] || 0) > 0))
    bad ? 1 : 0
  else
    result[:ok] == false ? 1 : 0
  end
exit(exit_code)
