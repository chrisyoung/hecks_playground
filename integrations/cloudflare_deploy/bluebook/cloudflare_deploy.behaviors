Hecks.behaviors "CloudflareDeploy" do
  vision "Behavioral tests for the CloudflareDeploy domain — runtime push (Deployment lifecycle: provision → migrate → deploy → live)"

  # The pipeline's policies settle inside the first dispatch: ProvisionD1 runs the
  # whole chain, so the record read back is already `live`. A mid-chain command cannot
  # be reached on its own (its lifecycle guard refuses it once the chain has finished),
  # so those tests are pending below, each with the reason.

  # ── Deployment aggregate ──────────────────────────────────────────

  test "ProvisionD1 sets database_name" do
    tests "ProvisionD1", on: "Deployment"
    input  database_name: "sample"
    expect status: "live"
  end

  test "ProvisionD1 cascades through policy chain" do
    tests "ProvisionD1", on: "Deployment", kind: :cascade
    input  database_name: "sample"
    expect emits: ["D1Provisioned", "MigrationsApplied", "WorkerDeployed", "PagesDeployed", "AppLive"]
  end

  # PENDING: hecks 3.10 fires the bluebook's policies in every test, so the ProvisionD1
  # setup already drives the record to `live` and ApplyMigrations (from: provisioned) is
  # refused. Restore when the runner can seed a record at a lifecycle state or run a
  # test with policies off (runner change, not a bluebook change).
  test "ApplyMigrations runs" do
    tests "ApplyMigrations", on: "Deployment", kind: :pending
    setup  "ProvisionD1", database_name: "sample"
    input  name: "deploy"
    expect status: "migrated"
  end

  # PENDING: same reason as "ApplyMigrations runs" - the setup settles the whole chain.
  test "ApplyMigrations cascades through policy chain" do
    tests "ApplyMigrations", on: "Deployment", kind: :pending
    setup  "ProvisionD1", database_name: "sample"
    input  name: "deploy"
    expect emits: ["MigrationsApplied", "WorkerDeployed", "PagesDeployed", "AppLive"]
  end

  # PENDING: same reason as "ApplyMigrations runs" - the setups settle the whole chain.
  test "DeployWorker runs" do
    tests "DeployWorker", on: "Deployment", kind: :pending
    setup  "ProvisionD1", database_name: "sample"
    input  name: "deploy"
    expect status: "api_live"
  end

  # PENDING: same reason as "ApplyMigrations runs" - the setups settle the whole chain.
  test "DeployWorker cascades through policy chain" do
    tests "DeployWorker", on: "Deployment", kind: :pending
    setup  "ProvisionD1", database_name: "sample"
    input  name: "deploy"
    expect emits: ["WorkerDeployed", "PagesDeployed", "AppLive"]
  end

  # PENDING: same reason as "ApplyMigrations runs" - the setups settle the whole chain.
  test "DeployPages runs" do
    tests "DeployPages", on: "Deployment", kind: :pending
    setup  "ProvisionD1", database_name: "sample"
    input  name: "deploy"
    expect status: "ui_live"
  end

  # PENDING: same reason as "ApplyMigrations runs" - the setups settle the whole chain.
  test "DeployPages cascades through policy chain" do
    tests "DeployPages", on: "Deployment", kind: :pending
    setup  "ProvisionD1", database_name: "sample"
    input  name: "deploy"
    expect emits: ["PagesDeployed", "AppLive"]
  end

  # PENDING: same reason as "ApplyMigrations runs" - the setups settle the whole chain
  # (MarkLive has already run, with no URLs, by the time the test calls it).
  test "MarkLive sets worker_url + pages_url" do
    tests "MarkLive", on: "Deployment", kind: :pending
    setup  "ProvisionD1", database_name: "sample"
    input  name: "deploy", worker_url: "sample", pages_url: "sample"
    expect worker_url: "sample", pages_url: "sample", status: "live"
  end

end
