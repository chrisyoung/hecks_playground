Hecks.bluebook "MiettePhone", version: "2026.05.12.1" do
  vision "Talk to Miette from your phone — chat UI on Cloudflare Pages, inference proxied to Summer, password-gated"

  # ============================================================
  # MIETTE PHONE
  # ============================================================
  #
  # A mobile chat interface to Miette, deployed on the edge:
  #
  #   Pages  — responsive chat UI, works on any phone browser
  #   Worker — authenticates, proxies to Summer, streams responses
  #   KV     — session tokens + conversation history
  #
  # The password is simple and intentional — this is a family tool.
  # One person uses it. No accounts, no OAuth, no email.
  # Type the pin, talk to Miette.

  # === Authentication — pin gate ===

  aggregate "Gate" do

    description "Simple password gate — type the pin, get a session"
    identified_by :gate_id
    attribute :gate_id, GateId

    value_object "GateId" do
      # One gate session's identity - the caller names it; it keys the conversation that follows.
      attribute :value, String
    end
    attribute :pin_hash, PinHash
    attribute :session_token, SessionToken
    attribute :expires_at, Timestamp
    attribute :locked, Locked, default: { value: true }

    value_object "Locked" do
      # true until a pin unlocks the gate.
      attribute :value, Boolean
    end

    # ── Value-objects : the gate's vocabulary ──
    #
    # 2026-05-12 : wrapped primitives per no-primitive-envy.

    value_object "PinHash" do
      # The hashed form of the user's pin — stored, never the
      # plaintext.
      attribute :value, String
    end

    value_object "Pin" do
      # The plaintext pin the user types on the phone keypad ;
      # compared against pin_hash, never persisted.
      attribute :value, String
    end

    value_object "SessionToken" do
      # Opaque session token issued on successful auth and stored
      # in KV with a TTL.
      attribute :value, String
    end

    value_object "Timestamp" do
      # ISO 8601 UTC stamp — when the session expires.
      attribute :value, String
    end

    command "Authenticate" do
      goal "Check the pin, issue a session token stored in KV"
      attribute :gate_id, GateId
      attribute :pin, Pin
      sets :gate_id
      emits "SessionGranted"
    end

    command "RevokeSession" do
      goal "Kill an active session — logout from the phone"
      reference_to(Gate)
      emits "SessionRevoked"
    end

    lifecycle :locked, default: true do
      transition "Authenticate"   => false, from: true
      transition "RevokeSession"  => true,  from: false
    end
  end

  # === Conversation — chat history ===

  aggregate "Conversation" do

    description "A chat thread between the user and Miette"
    identified_by :conversation_id
    attribute :conversation_id, ConversationId

    value_object "ConversationId" do
      # One chat thread's identity - the gate session that opened it.
      attribute :value, String
    end
    attribute :turns, list_of(Turn)
    attribute :started_at, Timestamp
    attribute :last_active, Timestamp
    attribute :turn_count, Count
    # session_active flips true when the gate is unlocked; both
    # StartConversation and SendMessage gate on it. Default false so
    # tests must walk through ActivateSession first (the planner picks
    # ActivateSession as the producer).
    attribute :session_active, ActiveFlag, default: { value: false }

    # ── Value-objects : the conversation's vocabulary ──

    value_object "Turn" do
      attribute :role, String
      attribute :content, String
      attribute :timestamp, String
    end

    value_object "Timestamp" do
      # ISO 8601 UTC stamp — used for both started_at and
      # last_active.
      attribute :value, String
    end

    value_object "Count" do
      # Non-negative count of turns in this thread.
      attribute :value, Integer
    end

    value_object "ActiveFlag" do
      # Boolean — true once the gate is unlocked. Both
      # StartConversation and SendMessage require ActiveFlag(true).
      attribute :value, Boolean
    end

    value_object "MessageContent" do
      # The body of one turn — user message or Miette reply.
      attribute :value, String
    end

    value_object "LatencyMs" do
      # Round-trip latency in milliseconds from SendMessage to
      # ReceiveReply ; useful for observability.
      attribute :value, Integer
    end

    command "ActivateSession" do
      goal "Mark the conversation's session as active — fired after Authenticate"
      reference_to(Conversation)
      emits "SessionActivated"
      sets :session_active, to: true
    end

    command "StartConversation" do
      goal "Begin a new chat thread"
      attribute :conversation_id, ConversationId
      sets :conversation_id
      emits "ConversationStarted"
    end

    command "SendMessage" do
      goal "User sends a message — routed to Summer for inference"
      reference_to(Conversation)
      attribute :content, MessageContent
      given("the session is active") { session_active == true }
      emits "MessageSent"
    end

    command "ReceiveReply" do
      goal "Summer's response arrives — appended to the thread"
      reference_to(Conversation)
      attribute :content, MessageContent
      attribute :latency_ms, LatencyMs, optional: true
      emits "ReplyReceived"
    end
  end

  # === Inference Proxy — bridges the edge to Summer ===

  aggregate "InferenceProxy" do

    description "Worker-side proxy that calls Summer's serve.py"
    identified_by :proxy_id
    attribute :proxy_id, ProxyId

    value_object "ProxyId" do
      # Which proxy this is - the Summer endpoint it fronts, named by the caller.
      attribute :value, String
    end
    value_object "ConversationId" do
      attribute :value, String
    end
    attribute :summer_origin, Origin
    attribute :status, Status
    attribute :timeout_ms, TimeoutMs

    # ── Value-objects : the proxy's vocabulary ──

    value_object "Origin" do
      # The Summer endpoint URL — local tunnel or cloud URL.
      attribute :value, String
    end

    value_object "Status" do
      # Proxy health label : up / down / unknown.
      attribute :value, String
    end

    value_object "TimeoutMs" do
      # Outbound request timeout in milliseconds.
      attribute :value, Integer
    end

    value_object "MessageContent" do
      # Forwarded user message — same shape as Conversation's, but
      # the proxy carries its own vocabulary (per-aggregate VO sets).
      attribute :value, String
    end

    command "ConfigureProxy" do
      goal "Set the Summer endpoint — local tunnel or cloud URL"
      attribute :proxy_id, ProxyId
      attribute :summer_origin, Origin
      attribute :timeout_ms, TimeoutMs
      emits "ProxyConfigured"
      sets :proxy_id
      sets :summer_origin
      sets :timeout_ms
    end

    command "RelayMessage" do
      goal "Forward user message to Summer /conceive, stream response back"
      reference_to(InferenceProxy)
      attribute :conversation_id, ConversationId
      attribute :content, MessageContent
      emits "MessageRelayed"
    end

    command "CheckHealth" do
      goal "Ping Summer /health — verify the model is up"
      reference_to(InferenceProxy)
      emits "HealthChecked"
    end
  end

  # === Phone UI — the chat screen ===

  aggregate "ChatScreen" do

    description "Responsive mobile-first chat interface on Pages"
    identified_by :conversation_id
    attribute :conversation_id, ConversationId

    value_object "ConversationId" do
      # The conversation this screen renders.
      attribute :value, String
    end
    attribute :theme, Theme
    attribute :dark_mode, Flag, default: { value: false }
    attribute :streaming, Flag, default: { value: false }

    value_object "Flag" do
      attribute :value, Boolean
    end

    # ── Value-objects : the chat screen's vocabulary ──

    value_object "Theme" do
      # The active theme name — currently light / dark, but
      # held as a typed value so additional themes can land
      # without primitive-bleed.
      attribute :value, String
    end

    command "OpenScreen" do
      goal "Open the chat screen for a conversation - the creating step the render and stream commands act on"
      attribute :conversation_id, ConversationId
      sets :conversation_id
      emits "ScreenOpened"
    end

    command "RenderChat" do
      goal "Build the chat HTML — message bubbles, input bar, send button"
      reference_to(ChatScreen)
      emits "ChatRendered"
    end

    command "StreamResponse" do
      goal "Show tokens as they arrive via SSE — feels alive"
      reference_to(ChatScreen)
      emits "StreamStarted"
    end

    command "ToggleTheme" do
      goal "Switch between light and dark mode"
      reference_to(ChatScreen)
      emits "ThemeToggled"
    end
  end

  # ============================================================
  # DEPLOYMENT — edge-native, no server needed
  # ============================================================
  #
  #   Worker  — handles /api/auth, /api/chat, /api/health
  #   Pages   — serves the chat UI (static HTML + JS)
  #   KV      — stores sessions (TTL 24h) and conversation history
  #   Tunnel  — cloudflared tunnel to Summer on the laptop
  #             (or Summer runs on Modal/Fly when laptop is off)
  #
  #   Phone → Pages → Worker → Tunnel → Summer → response
  #                                                  ↓
  #                            SSE stream ← ← ← ← ←

  # ============================================================
  # POLICIES
  # ============================================================

  policy "StartChatOnAuth" do
    on "SessionGranted"
    trigger Conversation::StartConversation, with: { conversation_id: :gate_id }
  end

  policy "RelayOnSend" do
    on "MessageSent"
    trigger InferenceProxy::RelayMessage, with: { proxy_id: "summer", conversation_id: :conversation_id, content: :content }
  end

  policy "ReplyOnRelay" do
    on "MessageRelayed"
    trigger Conversation::ReceiveReply, with: { conversation_id: :conversation_id, content: :content }
  end

  policy "RenderOnReply" do
    on "ReplyReceived"
    trigger ChatScreen::RenderChat, with: { conversation_id: :conversation_id }
  end

  policy "StreamOnSend" do
    on "MessageSent"
    trigger ChatScreen::StreamResponse, with: { conversation_id: :conversation_id }
  end

  # ============================================================
  # GLOSSARY
  # ============================================================

  # Glossary (kept as a comment: hecks 1.3.0 has no `glossary` word).
  # glossary do
  #   define "gate", as: "Simple pin-based auth — no accounts, no OAuth"
  #   define "turn", as: "One user message + one Miette reply"
  #   define "tunnel", as: "cloudflared tunnel bridging edge to laptop"
  #   define "proxy", as: "Worker that forwards chat to Summer's HTTP API"
  #   define "stream", as: "Server-sent events for token-by-token display"
  #   prefer "pin", not: ["password", "passcode", "code"]
  #   prefer "gate", not: ["login", "auth wall", "sign in"]
  #   prefer "turn", not: ["message pair", "exchange"]
  # end
end
