Hecks.bluebook "CloudflareArtifacts", version: "2026.05.12.1" do
  vision "Compile a bluebook into Cloudflare-shaped artifacts — worker.js, Pages site, D1 migrations, wrangler.toml"
  category "capability"

  # ============================================================
  # CLOUDFLARE ARTIFACTS
  # ============================================================
  #
  # This is the codegen half of the Cloudflare deploy pipeline.
  # Given a bluebook IR, emit every file the deploy step needs :
  #
  #   Compilation     — parse bluebook IR
  #   WorkerScript    — generate worker.js (commands as POST, queries as GET)
  #   PagesSite       — generate the website (forms + panels)
  #   Migration       — generate CREATE TABLE per aggregate (D1/SQLite)
  #   WranglerConfig  — generate wrangler.toml (D1 binding + Pages project)
  #
  # The runtime push (provision D1, apply migrations, deploy worker,
  # deploy pages) lives in cloudflare_deploy.bluebook — this bluebook
  # only produces the bytes ; deploy.bluebook moves them to the edge.
  #
  #   aggregate  →  D1 table + UI panel + API endpoints
  #   command    →  POST /api/:aggregate/:command + form on page
  #   query      →  GET  /api/:aggregate/:query + data display
  #   event      →  returned in response + live update on page

  # === Compilation ===

  aggregate "Compilation", "Parse bluebook IR into deployment artifacts" do
    attribute :domain_name, DomainName
    attribute :aggregate_count, ItemCount
    attribute :command_count, ItemCount
    attribute :query_count, ItemCount
    attribute :source_path, SourcePath

    # ── Value-objects : the domain's language ──

    value_object "DomainName" do
      # Name of the bluebook domain being compiled.
      attribute :value, String
    end

    value_object "ItemCount" do
      # A non-negative count of one structural item kind (aggregate, command, query).
      attribute :value, Integer
    end

    value_object "SourcePath" do
      # Filesystem path to the source bluebook being compiled.
      attribute :value, String
    end

    command "Compile" do
      role "System"
      description "Parse a bluebook and build the IR for code generation"
      attribute :source_path, SourcePath
      emits "DomainCompiled"
      then_set :source_path, to: :source_path
    end
  end

  # === Worker Generation — the API ===

  aggregate "WorkerScript", "The Cloudflare Worker — commands as POST, queries as GET" do
    attribute :routes, list_of(Route)
    attribute :generated_at, Timestamp

    # ── Value-objects : the domain's language ──

    value_object "Timestamp" do
      # ISO-8601 timestamp the worker script was generated at.
      attribute :value, String
    end

    value_object "Route" do
      attribute :method, String
      attribute :path, String
      attribute :handler, String
      attribute :aggregate, String
      attribute :operation, String
    end

    command "GenerateWorker" do
      role "System"
      description "Emit worker.js — route every command and query to D1"
      emits "WorkerGenerated"
    end
  end

  # === Pages Site — the UI ===

  aggregate "PagesSite", "The website — generated by WebApplicationCreation, deployed to Pages" do
    attribute :pages, list_of(Page)
    attribute :assets, list_of(AssetPath)
    attribute :api_base_url, ApiBaseUrl

    # ── Value-objects : the domain's language ──

    value_object "AssetPath" do
      # Path to one packaged static asset (one entry of assets).
      attribute :value, String
    end

    value_object "ApiBaseUrl" do
      # The base URL of the Worker API the pages will call.
      attribute :value, String
    end

    value_object "Page" do
      attribute :path, String
      attribute :aggregate, String
      attribute :template, String
    end

    command "GenerateSite" do
      role "System"
      description "Use WebApplicationCreation to build the UI — forms for commands, panels for aggregates"
      emits "SiteGenerated"
    end

    command "WireApiCalls" do
      role "System"
      description "Point all form submissions and data fetches at the Worker API"
      reference_to(PagesSite)
      attribute :api_base_url, ApiBaseUrl
      emits "ApiWired"
      then_set :api_base_url, to: :api_base_url
    end
  end

  # === D1 Migrations ===

  aggregate "Migration", "D1 schema — one table per aggregate" do
    attribute :table_name, TableName
    attribute :columns, list_of(Column)
    attribute :sql, SqlText

    # ── Value-objects : the domain's language ──

    value_object "TableName" do
      # The name of one D1 table — one per aggregate.
      attribute :value, String
    end

    value_object "SqlText" do
      # The CREATE TABLE statement the migration will run.
      attribute :value, String
    end

    value_object "Column" do
      attribute :name, String
      attribute :sql_type, String
      attribute :nullable, String
      attribute :default_value, String
    end

    command "GenerateMigrations" do
      role "System"
      description "Emit CREATE TABLE for each aggregate — attributes become columns"
      emits "MigrationsGenerated"
    end
  end

  # Type mapping: bluebook → D1/SQLite
  #   String   → TEXT
  #   Integer  → INTEGER
  #   Float    → REAL
  #   Boolean  → INTEGER (0/1)
  #   Date     → TEXT (ISO 8601)
  #   DateTime → TEXT (ISO 8601)
  #   list_of  → TEXT (JSON array)

  # === Wrangler Config ===

  aggregate "WranglerConfig", "wrangler.toml — binds worker to D1, configures Pages" do
    attribute :project_name, ProjectName
    attribute :d1_database_name, D1DatabaseName
    attribute :d1_database_id, D1DatabaseId
    attribute :pages_project_name, ProjectName
    attribute :compatibility_date, CompatibilityDate

    # ── Value-objects : the domain's language ──

    value_object "ProjectName" do
      # The wrangler project name — worker side or pages side.
      attribute :value, String
    end

    value_object "D1DatabaseName" do
      # The human-readable name of the D1 database wrangler binds.
      attribute :value, String
    end

    value_object "D1DatabaseId" do
      # The D1 database id wrangler emits after provisioning.
      attribute :value, String
    end

    value_object "CompatibilityDate" do
      # The wrangler `compatibility_date` field — pinning runtime behavior.
      attribute :value, String
    end

    command "GenerateConfig" do
      role "System"
      description "Emit wrangler.toml with D1 binding, worker config, and Pages project"
      attribute :project_name, ProjectName
      emits "ConfigGenerated"
      then_set :project_name, to: :project_name
    end
  end

  # ============================================================
  # POLICIES — the codegen fan-out
  # ============================================================

  # After compile, generate everything in parallel
  policy "WorkerAfterCompile" do
    on "DomainCompiled"
    trigger "GenerateWorker"
  end

  policy "SiteAfterCompile" do
    on "DomainCompiled"
    trigger "GenerateSite"
  end

  policy "MigrationsAfterCompile" do
    on "DomainCompiled"
    trigger "GenerateMigrations"
  end

  # Config after worker (needs routes to know the API shape)
  policy "ConfigAfterWorker" do
    on "WorkerGenerated"
    trigger "GenerateConfig"
  end

  # Wire the UI to the API after both exist
  policy "WireAfterSiteAndWorker" do
    on "SiteGenerated"
    trigger "WireApiCalls"
  end

  # ============================================================
  # GLOSSARY
  # ============================================================

  glossary do
    define "worker", as: "Cloudflare Worker — the API, commands and queries over HTTP"
    define "pages", as: "Cloudflare Pages — the website, generated from the domain"
    define "D1", as: "Cloudflare's edge SQLite — one table per aggregate"
    define "compilation", as: "Parsing bluebook IR into all deployment artifacts"
    define "route", as: "An HTTP endpoint mapped to a command or query"
    define "wire", as: "Connecting the Pages UI to the Worker API"
    prefer "compile", not: ["build", "transpile"]
    prefer "worker", not: ["function", "lambda", "handler"]
    prefer "pages", not: ["site", "frontend", "client"]
  end
end
