Hecks.bluebook "CloudflareDeploy", version: "2026.05.11.1" do
  vision "One bluebook, one deploy — push the artifacts (worker.js, Pages site, D1 migrations, wrangler.toml) to the edge"
  category "capability"

  # ============================================================
  # CLOUDFLARE DEPLOY
  # ============================================================
  #
  # This is the runtime-push half of the Cloudflare pipeline. The
  # codegen half (cloudflare_artifacts.bluebook) produces the bytes ;
  # this bluebook moves them to the edge through a singleton
  # Deployment lifecycle :
  #
  #   pending → provisioned → migrated → api_live → ui_live → live
  #
  # Every step is a `wrangler` shell-out, recorded as a state
  # transition on the same Deployment record. The whole pipeline
  # operates on one row so callers don't thread an id through every
  # step.
  #
  # The DomainCompiled → ConfigGenerated chain in artifacts fans out
  # into ProvisionD1 here ; the policy `ProvisionAfterConfig` is the
  # only cross-bluebook event-subscription, and it's the natural seam
  # of the whole split — codegen finishes, deploy begins.

  # === Deployment — one command, full stack ===

  aggregate "Deployment", "The full deploy — D1 + Worker + Pages in one shot" do
    identified_by :name
    # Singleton key — deploys are one-at-a-time per environment ; the
    # whole pipeline operates on the same Deployment record so the
    # provisioned → migrated → ... lifecycle advances. Defaults to
    # "deploy" so callers don't have to thread the id through every
    # step ; the runtime's singleton fallback finds the row.
    attribute :name, String, default: "deploy"
    attribute :status, String
    attribute :worker_url, String
    attribute :pages_url, String
    attribute :d1_database_id, String
    attribute :deployed_at, String

    command "ProvisionD1" do
      role "System"
      description "Run wrangler d1 create — provision the database"
      attribute :database_name, String
      emits "D1Provisioned"
    end

    command "ApplyMigrations" do
      role "System"
      description "Run wrangler d1 migrations apply — create tables"
      emits "MigrationsApplied"
    end

    command "DeployWorker" do
      role "System"
      description "Run wrangler deploy — push the API to Workers"
      emits "WorkerDeployed"
    end

    command "DeployPages" do
      role "System"
      description "Run wrangler pages deploy — push the site to Pages"
      emits "PagesDeployed"
    end

    command "MarkLive" do
      role "System"
      description "Everything deployed — record the URLs and timestamp"
      reference_to(Deployment)
      attribute :worker_url, String
      attribute :pages_url, String
      emits "AppLive"
      then_set :status, to: "live"
      then_set :worker_url, to: :worker_url
      then_set :pages_url, to: :pages_url
    end

    lifecycle :status, default: "pending" do
      transition "ProvisionD1"     => "provisioned", from: "pending"
      transition "ApplyMigrations" => "migrated",    from: "provisioned"
      transition "DeployWorker"    => "api_live",    from: "migrated"
      transition "DeployPages"     => "ui_live",     from: "api_live"
      transition "MarkLive"        => "live",        from: "ui_live"
    end
  end

  # ============================================================
  # THE DEPLOY WORKFLOW — one bluebook, one command
  # ============================================================
  #
  # Steps 1–6 are commands from CloudflareArtifacts ; steps 7–11 are
  # this bluebook's. The workflow names commands by string so the
  # cross-bluebook reference is purely declarative — both bluebooks
  # must be loaded together for the full pipeline to dispatch.

  workflow "Deploy" do
    description "From bluebook to live app — API + UI + database on Cloudflare"
    step "Compile"
    step "GenerateWorker"
    step "GenerateSite"
    step "GenerateMigrations"
    step "GenerateConfig"
    step "WireApiCalls"
    step "ProvisionD1"
    step "ApplyMigrations"
    step "DeployWorker"
    step "DeployPages"
    step "MarkLive"
  end

  # ============================================================
  # POLICIES — the deploy sequence
  # ============================================================
  #
  # ProvisionAfterConfig is the cross-bluebook handoff — it subscribes
  # to ConfigGenerated (emitted by CloudflareArtifacts::WranglerConfig)
  # and kicks off the deploy chain here.

  policy "ProvisionAfterConfig" do
    on "ConfigGenerated"
    trigger "ProvisionD1"
  end

  policy "MigrateAfterProvision" do
    on "D1Provisioned"
    trigger "ApplyMigrations"
  end

  policy "WorkerAfterMigrate" do
    on "MigrationsApplied"
    trigger "DeployWorker"
  end

  policy "PagesAfterWorker" do
    on "WorkerDeployed"
    trigger "DeployPages"
  end

  policy "LiveAfterPages" do
    on "PagesDeployed"
    trigger "MarkLive"
  end

  # ============================================================
  # GLOSSARY
  # ============================================================

  glossary do
    define "deploy", as: "One command, full stack — API + UI + database on the edge"
    define "worker", as: "Cloudflare Worker — the API, commands and queries over HTTP"
    define "pages", as: "Cloudflare Pages — the website, generated from the domain"
    define "D1", as: "Cloudflare's edge SQLite — one table per aggregate"
    prefer "deploy", not: ["publish", "ship", "release"]
    prefer "worker", not: ["function", "lambda", "handler"]
    prefer "pages", not: ["site", "frontend", "client"]
  end
end
