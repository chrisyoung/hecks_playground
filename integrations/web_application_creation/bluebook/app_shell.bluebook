Hecks.bluebook "AppShell", version: "2026.05.12.1" do
  vision "The overall application frame — navigation, layout, theme"

  # === Application Shell ===

  aggregate "AppShell" do

    description "The overall application frame — navigation, layout, theme"
    identified_by :app_name
    attribute :app_name, AppName
    attribute :navigation, list_of(NavItem)
    attribute :layout_type, LayoutType
    attribute :theme, ThemeName

    # ── Value-objects : the domain's language ──

    value_object "AppName" do
      # Human-readable name of the generated app (shown in the chrome).
      attribute :value, String
    end

    value_object "LayoutType" do
      # Which layout the shell uses — sidebar | topbar | grid | …
      attribute :value, String
    end

    value_object "ThemeName" do
      # Name of the style-guide theme applied to the shell.
      attribute :value, String
    end

    value_object "NavItem" do
      attribute :label, String
      attribute :route, String
      attribute :icon, String
      attribute :aggregate_name, String
    end

    command "GenerateShell" do
      role "System"
      goal "Create the app shell — nav from aggregates, layout from domain structure"
      attribute :app_name, AppName
      attribute :layout_type, LayoutType
      emits "ShellGenerated"
      sets :app_name
      sets :layout_type
    end

    command "BuildNavigation" do
      role "System"
      goal "Generate navigation from aggregates — each aggregate gets a nav item"
      reference_to(AppShell)
      emits "NavigationBuilt"
    end

    command "ApplyTheme" do
      role "Designer"
      goal "Apply the style guide to the shell — colors, fonts, spacing"
      reference_to(AppShell)
      attribute :theme, ThemeName
      emits "ThemeApplied"
      sets :theme
    end
  end

  # === Policies ===

  policy "NavOnShell" do
    on "ShellGenerated"
    trigger AppShell::BuildNavigation, with: { app_name: :app_name }
  end
end
