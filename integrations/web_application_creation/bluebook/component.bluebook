Hecks.bluebook "Component", version: "2026.05.12.1" do
  vision "Reusable UI components — domain-tagged, accessible, stylable"

  # === Component Library ===

  aggregate "Component" do

    description "A reusable UI component — domain-tagged, accessible, stylable"
    identified_by :name
    attribute :name, ComponentName
    attribute :component_type, ComponentType
    attribute :maps_to, MapsTo
    attribute :props, list_of(Prop)
    attribute :accessible, YesNo

    # ── Value-objects : the domain's language ──

    value_object "ComponentName" do
      # The library-facing name of the component (FormField, DataTable, …).
      attribute :value, String
    end

    value_object "ComponentType" do
      # Which kind of component this is — form_field | data_table | card | …
      attribute :value, String
    end

    value_object "MapsTo" do
      # Which domain concept the component renders (aggregate, command, value_object).
      attribute :value, String
    end

    value_object "YesNo" do
      # "true" | "false" — symbolic boolean ; here, accessibility flag.
      attribute :value, String
    end

    value_object "Prop" do
      attribute :name, String
      attribute :prop_type, String
      attribute :domain_attribute, String
      attribute :required, String
    end

    command "DefineComponent" do
      role "System"
      goal "Create a component — form field, data table, card, lifecycle badge, action button"
      attribute :name, ComponentName
      attribute :component_type, ComponentType
      attribute :maps_to, MapsTo
      emits "ComponentDefined"
      sets :name
      sets :component_type
      sets :maps_to
      sets :accessible, to: "true"
    end

    command "CustomizeComponent" do
      role "Designer"
      goal "Override a component's appearance — your design, not AI default"
      reference_to(Component)
      emits "ComponentCustomized"
    end
  end
end
