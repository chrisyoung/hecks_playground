Hecks.bluebook "PageCompliance", version: "2026.05.12.1" do
  vision "Generate pages from aggregates and validate them against the bluebook — no orphan elements"

  # 2026-05-12 : primitives wrapped in typed value-objects per the
  # no-primitive-envy discipline. Per-aggregate VO sets ; duplication
  # between DomainCompliance and Page is fine.

  # === Validation ===

  aggregate "DomainCompliance" do

    description "Validate that the web app follows its bluebook — no orphan elements"
    identified_by :app_path
    attribute :app_path, Path
    attribute :bluebook_path, Path
    attribute :total_elements, Count
    attribute :tagged_elements, Count
    attribute :orphan_elements, Count
    attribute :missing_commands, list_of(CommandName)
    attribute :compliance_score, Score

    # ── Value-objects : the compliance scanner's vocabulary ──

    value_object "Path" do
      # Filesystem path — either to the web app directory or to its
      # source bluebook.
      attribute :value, String
    end

    value_object "Count" do
      # Non-negative count of HTML elements bucketed by tagging
      # status (total / tagged / orphan).
      attribute :value, Integer
    end

    value_object "CommandName" do
      # The dotted Aggregate.Command name (e.g. "Order.Place") of a
      # bluebook command that has no corresponding form in the app.
      attribute :value, String
    end

    value_object "Score" do
      # Compliance score in [0.0, 1.0] — tagged_elements / total.
      attribute :value, Float
    end

    value_object "ElementMarkup" do
      # The raw HTML markup of a flagged element — recorded so the
      # designer can grep it back to its source.
      attribute :value, String
    end

    value_object "Location" do
      # Source location of a flagged element ; file path + line
      # number in "<path>:<line>" form.
      attribute :value, String
    end

    command "ScanApp" do
      role "System"
      goal "Parse every HTML element, extract domain tags, compare against bluebook"
      attribute :app_path, Path
      attribute :bluebook_path, Path, optional: true
      emits "AppScanned"
      sets :app_path
      sets :bluebook_path
    end

    command "ReportCompliance" do
      role "System"
      goal "Calculate compliance score — tagged elements / total elements"
      reference_to(DomainCompliance)
      attribute :total_elements, Count, optional: true
      attribute :tagged_elements, Count, optional: true
      attribute :orphan_elements, Count, optional: true
      attribute :missing_commands, list_of(CommandName), optional: true
      emits "ComplianceReported"
      sets :total_elements
      sets :tagged_elements
      sets :orphan_elements
      sets :missing_commands
    end

    command "FlagOrphan" do
      role "System"
      goal "An HTML element has no domain tag — it's outside the spec"
      reference_to(DomainCompliance)
      attribute :element, ElementMarkup
      attribute :location, Location
      emits "OrphanFlagged"
    end

    command "FlagMissingCommand" do
      role "System"
      goal "A command exists in the bluebook but has no form in the app"
      reference_to(DomainCompliance)
      attribute :command_name, CommandName
      emits "MissingCommandFlagged"
    end
  end

  # === Page Generation ===

  aggregate "Page" do

    description "A generated page — one per aggregate or dashboard"
    identified_by :name
    attribute :name, Name
    attribute :page_type, PageType
    attribute :aggregate_name, AggregateName
    attribute :route, Route
    attribute :components, list_of(ComponentName)
    attribute :status, Status, default: { value: "pending" }

    # ── Value-objects : the page's vocabulary ──

    value_object "Name" do
      # Display name of the generated page (e.g. "Orders index").
      attribute :value, String
    end

    value_object "PageType" do
      # The page archetype : index / show / form / dashboard. Picks
      # the renderer's template.
      attribute :value, String
    end

    value_object "AggregateName" do
      # The bluebook aggregate this page is generated from.
      attribute :value, String
    end

    value_object "Route" do
      # The URL path the page is mounted at (e.g. "/orders/:id").
      attribute :value, String
    end

    value_object "ComponentName" do
      # The name of a UI component slotted into the page (form,
      # table, banner, etc.). list_of(ComponentName) walks composition.
      attribute :value, String
    end

    value_object "Status" do
      # Lifecycle token : pending / generated / customized / validated.
      attribute :value, String
    end

    command "GeneratePage" do
      role "System"
      goal "Create a page from an aggregate — index, show, form, dashboard"
      attribute :name, Name
      attribute :page_type, PageType
      attribute :aggregate_name, AggregateName
      attribute :route, Route
      emits "PageGenerated"
      sets :name
      sets :page_type
      sets :aggregate_name
      sets :route
    end

    command "CustomizePage" do
      role "Designer"
      goal "Override the generated layout — slot in custom components"
      reference_to(Page)
      emits "PageCustomized"
    end

    command "ValidatePage" do
      role "System"
      goal "Check all domain tags, ensure every element maps to the bluebook"
      reference_to(Page)
      emits "PageValidated"
    end

    lifecycle :status, default: "pending" do
      transition "GeneratePage" => "generated", from: "pending"
      transition "CustomizePage" => "customized", from: "generated"
      transition "ValidatePage" => "validated", from: "generated"
      transition "ValidatePage" => "validated", from: "customized"
    end
  end

  # === Policies ===

  policy "ValidateOnGenerate" do
    on "PageGenerated"
    # A scan is keyed by the route of the page whose generation triggered it.
    trigger DomainCompliance::ScanApp, with: { app_path: :route }
  end

  policy "ComplianceOnScan" do
    on "AppScanned"
    trigger DomainCompliance::ReportCompliance, with: { app_path: :app_path }
  end
end
