Hecks.behaviors "WebComponents" do
  vision "Behavioral tests for the collapsed WebComponents domain — one root aggregate, one RenderComponent command exercised across every supported component kind"

  # ── WebComponents — RenderComponent dispatched per kind ──────

  test "RenderComponent renders Shell" do
    tests "RenderComponent", on: "WebComponents"
    input  kind: "Shell"
    expect ok: "true"
  end

