# 24 — payload-gate canonical fields (2026-07-18) : aggregate
# identified_by, attribute `required: true`, and VO-level invariants
# (names-only in the canonical IR — the Ruby side holds the predicate as
# a Proc, so the shared contract is the name ; each runtime enforces the
# predicate from its own parse). Both parsers must emit byte-equal
# canonical JSON for all three.
Hecks.bluebook "GateShed" do
  aggregate "Tool" do
    description "A tool with a mandatory, invariant-guarded fee"
    identified_by :name
    attribute :name, ToolName
    attribute :daily_fee, Fee

    value_object "ToolName" do
      attribute :value, String
    end

    value_object "Fee" do
      attribute :cents, Integer
      invariant "must be non-negative" do
        cents >= 0
      end
    end

    command "AddTool" do
      role "Owner"
      attribute :name, ToolName, required: true
      attribute :daily_fee, Fee
    end
  end
end
