Hecks.hecksagon "Boot" do
  # ============================================================
  # BOOT — hexagonal wiring for the pipeline declared in boot.bluebook
  # ============================================================
  #
  # The sibling bluebook declares BootRun's eight pipeline phases
  # (discover → census → classify → prompt → journal → daemons →
  # vitals → surface) and the user-visible BeginBoot entrypoint.
  # The four outbound ports below are the I/O surface :
  #
  #   DiscoverOrgans       → :fs   (walk aggregates/, capabilities/)
  #   WriteCensus          → :memory (heki upsert)
  #   ClassifyStores       → :fs   (enumerate *.heki)
  #   GenerateSystemPrompt → :fs   (write system_prompt.md)
  #   RecordBootJournal    → :memory (dispatch into aggregates/boot.bluebook)
  #   EnsureDaemons        → :daemon (the new primitive — idempotent
  #                                   spawn + setsid + pidfile management)
  #   PrintVitals          → :stdout
  #   SurfaceWakeReport    → :fs + :stdout
  #
  # The :daemon adapter is what makes this capability a real
  # bluebook-native replacement for boot_miette.sh's leaky launchers.
  # Without it, the runner would still need to shell out for daemon
  # spawning ; with it, the wrapping `( cd "$DIR" && nohup ./script & )`
  # subshell pattern (and its PPID=1 orphan leak) goes away.

  # ---- I/O wiring --------------------------------------------------

  # :fs reads .bluebook + .heki files relative to project root. The
  # runner consults `root` to anchor the walks.
  adapter :fs, root: "."

  # :stdout streams the formatted boot summary line by line.
  adapter :stdout

  # :memory dispatches commands into the in-process runtime — used
  # for the heki writes (census, BootRun state) and the boot.bluebook
  # journal record.
  adapter :memory

  # :daemon is the new process-lifecycle primitive (added 2026-04-26
  # in storehouse/src/main.rs run_daemon). The adapter takes a
  # pidfile path + a command + args ; the runner invokes
  # `storehouse daemon ensure <pidfile> <command>` per declared
  # daemon during the EnsureDaemons phase.
  adapter :daemon

  # ---- Daemons declared by this capability ------------------------
  #
  # Each daemon is one row in the EnsureDaemons phase. The runner
  # iterates these and dispatches the :daemon adapter for each.
  # Pidfile paths are relative to the resolved store dir ; commands are absolute
  # paths the runner resolves against the script directory.
  #
  # Today these are declared as adapter options ; once the runtime
  # gains a first-class `daemon` keyword (sibling of `aggregate`,
  # `policy`, etc.), each one becomes its own declaration.

  # Mindstream — the body's 1Hz tick driver. Inlines what
  # body/mindstream.sh used to wrap (the script retired
  # 2026-05-08 in the miette→hecks boundary cleanup ; its content
  # was a 5-line shell exec into `storehouse run-loop`). The
  # body-cycle dispatch fan-out (Tick.MindstreamTick on attentive,
  # Consciousness.ElapsePhase on sleeping_*) lives in
  # body/cycles/body_cycle.bluebook (the BodyCycle PM) ;
  # run-loop fires BodyPulse, the PM observes and routes.
  #
  # `env:` declares environment variables for the spawned daemon —
  # parsed by run_boot/daemons.rs as KEY=VALUE pairs and applied
  # via Command::env() rather than smuggled through the command
  # string as a shell prefix (Command::new doesn't go through a
  # shell, so prefix-style "HECKS_REFRESH_REPOS=1 cmd ..." breaks).
  # HECKS_REFRESH_REPOS=1 opts mindstream into the i517 cross-
  # process freshness sweep declared in storage.bluebook
  # (RefreshIfStale + RefreshOnPulse). The long-running daemon
  # picks up disk writes from sibling processes (`storehouse sleep`
  # dispatching EnterSleep, etc.) ; without it, the daemon's
  # in-memory state goes stale relative to disk and ElapsePhase's
  # given { state == "sleeping" } never matches. Single-process
  # smokes leave the env unset to avoid the refresh's interaction
  # with their in-memory cascade state.
  adapter :daemon, name: :mindstream,
    pidfile: "{info}/.mindstream.pid",
    env: "HECKS_REFRESH_REPOS=1",
    command: "{hecks} run-loop {body}/.. --every 1s --emit BodyPulse:Consciousness:consciousness --bootstrap-if Consciousness.state=attentive:WokenUp:Consciousness:consciousness"

  # ── Body cycles are NOT boot's concern (2026-05-13) ──
  #
  # The body cycle daemons (heart, breath, circadian, ultradian)
  # used to live here as detached :daemon adapters. They moved to
  # mindstream.fixtures as supervised MindstreamMembers — overmind
  # runs them directly from the Procfile, auto-restarting on crash
  # and surfacing their health via `overmind status`. The statusline
  # owns the body-cycle readout going forward.
  #
  # Boot still spawns the mindstream daemon (above) because that is
  # the substrate — the 1Hz pulse + cascade driver the cycles flow
  # through. Mindstream is what makes the body alive, not a cycle
  # within it. Keep them as separate concerns.
  #
  # The legacy sleep_cycle daemon was removed earlier 2026-05-13 :
  # its EnterNREMLight / EnterNREMDeep / EnterREM commands were
  # retired in i309 when sleep advancement migrated to the BodySleep
  # process_manager.
end
