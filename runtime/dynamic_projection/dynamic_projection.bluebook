Hecks.bluebook "DynamicProjection", version: "2026.05.12.1" do
  vision "The app IS the domain rendered — change the bluebook, the app changes"
  category "infrastructure"

  # ============================================================
  # DYNAMIC PROJECTION — live binding from bluebook to rendered UI
  # ============================================================
  #
  # Seven aggregates that watch bluebook files and project them into
  # pages, forms, navigation, badges, and drift reports. Per the
  # 2026-05-12 dense-domain pass, every primitive is wrapped in a
  # typed value-object inside its aggregate so the domain reads as
  # itself, not as String / Integer / Float.

  aggregate "Binding", "A live connection between a bluebook concept and a UI element" do
    attribute :bluebook_path,   BluebookPath
    attribute :concept_type,    ConceptType
    attribute :concept_name,    ConceptName
    attribute :element_id,      ElementId
    attribute :element_type,    ElementType
    attribute :last_synced_at,  Timestamp

    value_object "BluebookPath" do
      attribute :value, String
    end

    value_object "ConceptType" do
      attribute :value, String
    end

    value_object "ConceptName" do
      attribute :value, String
    end

    value_object "ElementId" do
      attribute :value, String
    end

    value_object "ElementType" do
      attribute :value, String
    end

    value_object "Timestamp" do
      attribute :value, String
    end

    command "BindElement" do
      role "System"
      description "Connect a UI element to a bluebook aggregate, command, or attribute"
      attribute :bluebook_path, BluebookPath
      attribute :concept_type,  ConceptType
      attribute :concept_name,  ConceptName
      attribute :element_id,    ElementId
      attribute :element_type,  ElementType
      emits "ElementBound"
      then_set :bluebook_path, to: :bluebook_path
      then_set :concept_type, to: :concept_type
      then_set :concept_name, to: :concept_name
      then_set :element_id, to: :element_id
      then_set :element_type, to: :element_type
    end

    command "UnbindElement" do
      role "System"
      description "Remove a binding — the concept was removed from the bluebook"
      reference_to(Binding)
      emits "ElementUnbound"
    end
  end

  aggregate "BluebookWatch", "Monitor bluebook files for changes — trigger regeneration" do
    attribute :watched_paths,        list_of(BluebookPath)
    attribute :last_change_detected, Timestamp
    attribute :changes_detected,     ChangeCount

    value_object "BluebookPath" do
      attribute :value, String
    end

    value_object "Timestamp" do
      attribute :value, String
    end

    value_object "ChangeCount" do
      attribute :value, Integer
    end

    value_object "ChangeKind" do
      attribute :value, String
    end

    command "WatchBluebook" do
      role "System"
      description "Start monitoring a bluebook file for changes"
      attribute :path, BluebookPath
      emits "BluebookWatched"
      then_set :watched_paths, append: :path
    end

    command "DetectChange" do
      role "System"
      description "A bluebook file changed — something was added, removed, or modified"
      reference_to(BluebookWatch)
      attribute :path,        BluebookPath
      attribute :change_type, ChangeKind
      emits "BluebookChanged"
      then_set :changes_detected, increment: 1
    end
  end

  aggregate "PageProjection", "A page generated from an aggregate — regenerates on change" do
    attribute :aggregate_name,    AggregateName
    attribute :bluebook_path,     BluebookPath
    attribute :page_path,         PagePath
    attribute :fields_rendered,   RenderCount
    attribute :commands_rendered, RenderCount
    attribute :status,            String

    value_object "AggregateName" do
      attribute :value, String
    end

    value_object "BluebookPath" do
      attribute :value, String
    end

    value_object "PagePath" do
      attribute :value, String
    end

    value_object "RenderCount" do
      attribute :value, Integer
    end

    value_object "ProjectionStatus" do
      attribute :value, String
    end

    command "ProjectPage" do
      role "System"
      description "Generate a page from an aggregate — fields become inputs, commands become forms"
      attribute :aggregate_name, AggregateName
      attribute :bluebook_path,  BluebookPath
      emits "PageProjected"
      then_set :aggregate_name, to: :aggregate_name
      then_set :bluebook_path, to: :bluebook_path
      then_set :status, to: "current"
    end

    command "RegeneratePage" do
      role "System"
      description "Bluebook changed — regenerate the page to match"
      reference_to(PageProjection)
      emits "PageRegenerated"
      then_set :status, to: "current"
    end

    command "FlagStale" do
      role "System"
      description "Page no longer matches its bluebook — needs regeneration"
      reference_to(PageProjection)
      emits "PageStale"
      then_set :status, to: "stale"
    end

    lifecycle :status, default: "pending" do
      transition "ProjectPage" => "current", from: "pending"
      transition "FlagStale" => "stale", from: ["current", "pending", "stale"]
      transition "RegeneratePage" => "current", from: "stale"
    end
  end

  aggregate "FormProjection", "A form generated from a command — inputs from attributes, submit emits event" do
    attribute :command_name,   CommandName
    attribute :aggregate_name, AggregateName
    attribute :input_count,    InputCount
    attribute :has_lifecycle,  YesNo
    attribute :has_givens,     YesNo

    value_object "CommandName" do
      attribute :value, String
    end

    value_object "AggregateName" do
      attribute :value, String
    end

    value_object "InputCount" do
      attribute :value, Integer
    end

    value_object "YesNo" do
      attribute :value, String
    end

    command "ProjectForm" do
      role "System"
      description "Generate a form from a command — each attribute becomes an input, givens become validations"
      attribute :command_name,   CommandName
      attribute :aggregate_name, AggregateName
      emits "FormProjected"
      then_set :command_name, to: :command_name
      then_set :aggregate_name, to: :aggregate_name
    end

    command "RegenerateForm" do
      role "System"
      description "Command changed — regenerate the form"
      reference_to(FormProjection)
      emits "FormRegenerated"
    end
  end

  aggregate "NavigationProjection", "Navigation generated from the hecksagon — bounded contexts become nav items" do
    attribute :project_name, ProjectName
    attribute :nav_items,    list_of(NavItem)

    value_object "ProjectName" do
      attribute :value, String
    end

    value_object "NavItem" do
      attribute :domain_name, String
      attribute :label, String
      attribute :route, String
      attribute :icon, String
      attribute :aggregate_count, Integer
    end

    command "ProjectNavigation" do
      role "System"
      description "Generate navigation from the hecksagon — each domain becomes a nav section"
      attribute :project_name, ProjectName
      emits "NavigationProjected"
      then_set :project_name, to: :project_name
    end

    command "RegenerateNavigation" do
      role "System"
      description "Hecksagon changed — rebuild navigation"
      reference_to(NavigationProjection)
      emits "NavigationRegenerated"
    end
  end

  aggregate "LifecycleBadge", "Status badges generated from lifecycle state machines" do
    attribute :aggregate_name,  AggregateName
    attribute :lifecycle_field, FieldName
    attribute :states,          list_of(StateName)
    attribute :transitions,     list_of(TransitionName)

    value_object "AggregateName" do
      attribute :value, String
    end

    value_object "FieldName" do
      attribute :value, String
    end

    value_object "StateName" do
      attribute :value, String
    end

    value_object "TransitionName" do
      attribute :value, String
    end

    command "ProjectBadge" do
      role "System"
      description "Generate status badges from a lifecycle — each state gets a color and label"
      attribute :aggregate_name,  AggregateName
      attribute :lifecycle_field, FieldName
      emits "BadgeProjected"
      then_set :aggregate_name, to: :aggregate_name
      then_set :lifecycle_field, to: :lifecycle_field
    end
  end

  aggregate "DriftDetector", "Catches when the app diverges from its bluebook" do
    attribute :total_bindings,      BindingCount
    attribute :stale_bindings,      BindingCount
    attribute :orphan_elements,     ElementCount
    attribute :missing_projections, ProjectionCount
    attribute :drift_score,         DriftScore

    value_object "BindingCount" do
      attribute :value, Integer
    end

    value_object "ElementCount" do
      attribute :value, Integer
    end

    value_object "ProjectionCount" do
      attribute :value, Integer
    end

    value_object "DriftScore" do
      attribute :value, Float
    end

    command "ScanForDrift" do
      role "System"
      description "Compare every binding against the current bluebook — find what drifted"
      emits "DriftScanned"
    end

    command "ReportDrift" do
      role "System"
      description "Output the drift score and list every stale or orphan element"
      reference_to(DriftDetector)
      attribute :total_bindings,      BindingCount
      attribute :stale_bindings,      BindingCount
      attribute :orphan_elements,     ElementCount
      attribute :missing_projections, ProjectionCount
      emits "DriftReported"
      then_set :total_bindings, to: :total_bindings
      then_set :stale_bindings, to: :stale_bindings
      then_set :orphan_elements, to: :orphan_elements
      then_set :missing_projections, to: :missing_projections
    end
  end

  # === Policies — the regeneration chain ===

  policy "FlagOnChange" do
    on "BluebookChanged"
    trigger "FlagStale"
  end

  policy "RegeneratePageOnStale" do
    on "PageStale"
    trigger "RegeneratePage"
  end

  policy "RegenerateFormOnChange" do
    on "BluebookChanged"
    trigger "RegenerateForm"
  end

  policy "RegenerateNavOnChange" do
    on "BluebookChanged"
    trigger "RegenerateNavigation"
  end

  policy "DriftOnRegenerate" do
    on "PageRegenerated"
    trigger "ScanForDrift"
  end

  policy "ReportOnScan" do
    on "DriftScanned"
    trigger "ReportDrift"
  end
end
