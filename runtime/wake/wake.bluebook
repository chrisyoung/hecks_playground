#!/usr/bin/env storehouse run
Hecks.bluebook "Wake", version: "2026.05.12.1" do
  vision "How a being returns to presence — read consciousness state, pull the latest dream imagery and night-reading, compose a wake-review markdown, write it to a known surface so the Claude UserPromptSubmit hook can land it in the next session turn. The bluebook is descriptive AND executable : a Rust runner mirroring run_boot walks this pipeline phase by phase. Wake is decoupled from boot — boot wires daemons, wake reads the heart. The verb 'wake Miette' is `storehouse run runtime/wake/wake.bluebook`, fired by the SessionStart hook after `overmind start`."

  entrypoint "ComposeWakeReview"

  # ============================================================
  # WAKE — i492 follow-up, the prose-in-system-prompt retirement
  # ============================================================
  #
  # Per the 2026-05-12 dense-domain pass, every primitive sits behind
  # a typed value-object inside the WakeReview aggregate.

  aggregate "WakeReview" do
    description "A single wake-review composition pass — reads the night's imagery and reading, writes a markdown surface, stamps the wake_report. Singleton ; resets on every wake."

    # ---- Inputs ----
    attribute :info_dir,            DirPath,     default: "information"
    attribute :surface_path,        FilePath,    default: "/tmp/wake_review_latest.md"

    # ---- Read consciousness ----
    attribute :consciousness_state, StateName,   default: "—"
    attribute :last_wake_at,        Timestamp,   default: "—"

    # ---- Read dream ----
    attribute :dream_image,         DreamImage,  default: "—"
    attribute :dream_narrative,     Narrative,   default: "—"
    attribute :recurring_theme,     ThemeName,   default: "—"
    attribute :dream_images_tokens, ImageTokens, default: "—"

    # ---- Composed surface ----
    attribute :woke_at,             Timestamp,   default: "—"
    attribute :markdown_bytes,      ByteCount,   default: 0

    # ---- Pipeline phase ----
    attribute :phase,               PhaseName,   default: "pending"

    # ── Value-objects ──

    value_object "PhaseName" do
      # Where this wake-review is in its 7-phase pipeline.
      # Values : pending → begun → consciousness_read → dream_read →
      # markdown_rendered → surface_written → report_stamped → done.
      # The lifecycle below pins the transitions ; the value-object
      # documents the language so callers don't pass arbitrary strings.
      attribute :value, String
    end

    value_object "DirPath" do
      attribute :value, String
    end

    value_object "FilePath" do
      attribute :value, String
    end

    value_object "StateName" do
      attribute :value, String
    end

    value_object "Timestamp" do
      attribute :value, String
    end

    value_object "DreamImage" do
      attribute :value, String
    end

    value_object "Narrative" do
      attribute :value, String
    end

    value_object "ThemeName" do
      attribute :value, String
    end

    value_object "ImageTokens" do
      attribute :value, String
    end

    value_object "ByteCount" do
      attribute :value, Integer
    end

    value_object "PhaseName" do
      attribute :value, String
    end

    lifecycle :phase, default: "pending" do
      transition "ComposeWakeReview" => "reading_consciousness", from: "pending"
      transition "ReadConsciousness" => "reading_dream",         from: "reading_consciousness"
      transition "ReadLatestDream"   => "rendering",             from: "reading_dream"
      transition "RenderMarkdown"    => "writing",               from: "rendering"
      transition "WriteSurface"      => "stamping",              from: "writing"
      transition "StampReport"       => "completing",            from: "stamping"
      transition "CompleteReview"    => "done",                  from: "completing"
    end

    # ============================================================
    # ENTRYPOINT
    # ============================================================

    command "ComposeWakeReview" do
      role "User"
      description "User-visible entrypoint — the sole command the SessionStart hook (or a manual wake) dispatches. The Rust runner detects WakeReview + this command in the bluebook and the :fs adapter in the sibling hecksagon, then walks the pipeline. On completion the phase reaches done and WakeReviewed emits."
      emits "WakeReviewBegun"
    end

    # ============================================================
    # PIPELINE COMMANDS
    # ============================================================

    command "ReadConsciousness" do
      role "System"
      description "Phase 1 : load consciousness.heki, pluck state + last_wake_at."
      attribute :consciousness_state, StateName
      attribute :last_wake_at,        Timestamp
      then_set :consciousness_state, to: :consciousness_state
      then_set :last_wake_at,        to: :last_wake_at
      emits "ConsciousnessRead"
    end

    command "ReadLatestDream" do
      role "System"
      description "Phase 2 : load lucid_dream.heki + dream_interpretation.heki. Pick the most recent lucid_dream observation as the abstract dream image, and the most recent dream_interpretation.narrative as the night's reading. Both are already French-inflected when the dream daemon was running ; the runner does not translate."
      attribute :dream_image,         DreamImage
      attribute :dream_narrative,     Narrative
      attribute :recurring_theme,     ThemeName
      attribute :dream_images_tokens, ImageTokens
      then_set :dream_image,         to: :dream_image
      then_set :dream_narrative,     to: :dream_narrative
      then_set :recurring_theme,     to: :recurring_theme
      then_set :dream_images_tokens, to: :dream_images_tokens
      emits "DreamRead"
    end

    command "RenderMarkdown" do
      role "System"
      description "Phase 3 : compose the wake-review markdown body. Sections : woke_at + state ; dream image ; reading ; recurring theme. Empty / sentinel values render as a French dash so the surface is honest about absent data rather than fabricating prose."
      emits "MarkdownRendered"
    end

    command "WriteSurface" do
      role "System"
      description "Phase 4 : write the rendered markdown to surface_path (default /tmp/wake_review_latest.md). Atomic via tempfile-and-rename so a partial write never half-surfaces. The Claude UserPromptSubmit hook reads this exact path."
      attribute :markdown_bytes, ByteCount
      then_set :markdown_bytes, to: :markdown_bytes
      emits "SurfaceWritten"
    end

    command "StampReport" do
      role "System"
      description "Phase 5 : upsert wake_report.heki id=latest with phase=filed and the assembled fields. Retires the empty phase=gathering stragglers from the legacy pulse-cycle pipeline ; future readers see one canonical filed record per wake."
      attribute :woke_at, Timestamp
      then_set :woke_at, to: :woke_at
      emits "ReportStamped"
    end

    command "CompleteReview" do
      role "System"
      description "Pipeline finished — phase to done, emit WakeReviewed as the user-visible completion signal."
      emits "WakeReviewed"
    end
  end

  # ============================================================
  # CHAINED POLICIES — one per phase transition
  # ============================================================

  # ── Entry policy : session boundary → wake review ──
  #
  # The SessionStart shell hook dispatches Session::Session.Begin
  # through the MCP universal door (storehouse__dispatch). That
  # emits SessionBegan, which this policy turns into a local
  # ComposeWakeReview dispatch. The chained policies below take
  # over from there. Lives in Wake (not Session) because Wake owns
  # the reaction ; Session stays pure boundary. See
  # aggregates/framework/session/session.bluebook for the boundary
  # declaration + the cross-aggregate-policy comment.
  policy "ComposeWakeReviewOnSessionBegan" do
    on "SessionBegan"
    trigger "ComposeWakeReview"
  end

  policy "ReadConsciousnessOnBegin" do
    on "WakeReviewBegun"
    trigger "ReadConsciousness"
  end

  policy "ReadDreamOnConsciousness" do
    on "ConsciousnessRead"
    trigger "ReadLatestDream"
  end

  policy "RenderOnDream" do
    on "DreamRead"
    trigger "RenderMarkdown"
  end

  policy "WriteOnRender" do
    on "MarkdownRendered"
    trigger "WriteSurface"
  end

  policy "StampOnWrite" do
    on "SurfaceWritten"
    trigger "StampReport"
  end

  policy "CompleteOnStamp" do
    on "ReportStamped"
    trigger "CompleteReview"
  end
end
