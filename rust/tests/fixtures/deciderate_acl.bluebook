Hecks.bluebook "Deciderate" do
  core
  aggregate "Decision" do
    identified_by :id
    attribute :id, DecisionId
    attribute :question, Question
    value_object "DecisionId" do
      attribute :value, String
    end
    value_object "Question" do
      attribute :value, String
    end
    command "Pose" do
      role "Seeker"
      attribute :id, DecisionId
      attribute :question, Question
    end
  end
  aggregate "Vote" do
    identified_by :id
    attribute :id, VoteId
    attribute :bubble, BubbleRef
    value_object "VoteId" do
      attribute :value, String
    end
    value_object "BubbleRef" do
      attribute :value, String
    end
    command "Cast" do
      role "Player"
      attribute :id, VoteId
      attribute :bubble, BubbleRef
    end
  end
  aggregate "Bubble" do
    identified_by :id
    attribute :id, BubbleId
    attribute :size, Size, default: 5
    value_object "BubbleId" do
      attribute :value, String
    end
    value_object "Size" do
      attribute :value, Integer
    end
    command "Launch" do
      attribute :id, BubbleId
      attribute :size, Size
      then_set :size, to: :size
    end
    command "Decay" do
      role "System"
      reference_to Bubble
      then_set :size, decrement: 1
    end
  end
end
