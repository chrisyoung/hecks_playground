Hecks.bluebook "Deciderate" do
  core
  aggregate "Submission" do
    identified_by :id
    attribute :id, SubmissionId
    attribute :decision, DecisionRef
    attribute :player, PlayerRef
    attribute :estimate, Estimate
    value_object "SubmissionId" do
      attribute :value, String
    end
    value_object "DecisionRef" do
      attribute :value, String
    end
    value_object "PlayerRef" do
      attribute :value, String
    end
    value_object "Estimate" do
      attribute :value, Integer
    end
    command "Make" do
      attribute :id, SubmissionId
      attribute :decision, DecisionRef
      attribute :player, PlayerRef
      attribute :estimate, Estimate
    end
    query "Mine" do
    end
    query "PerPlayer" do
    end
  end
  aggregate "Bubble" do
    identified_by :id
    attribute :id, BubbleId
    attribute :decision, DecisionRef
    attribute :size, Size, default: 0
    attribute :status, BubbleStatus, default: "floating"
    value_object "BubbleId" do
      attribute :value, String
    end
    value_object "DecisionRef" do
      attribute :value, String
    end
    value_object "Size" do
      attribute :value, Integer
    end
    value_object "BubbleStatus" do
      attribute :value, String
    end
    command "Launch" do
      attribute :id, BubbleId
      attribute :decision, DecisionRef
      attribute :size, Size
      then_set :size, to: :size
    end
    query "Standings" do |decision|
      where decision: :decision, status: "floating"
      order_by :size, :desc
    end
  end
  aggregate "Game" do
    identified_by :id
    attribute :id, GameId
    attribute :bracket, BracketRef
    attribute :status, GameStatus, default: "resolved"
    attribute :winner_ref, WinnerRef
    value_object "GameId" do
      attribute :value, String
    end
    value_object "BracketRef" do
      attribute :value, String
    end
    value_object "GameStatus" do
      attribute :value, String
    end
    value_object "WinnerRef" do
      attribute :value, String
    end
    command "Record" do
      attribute :id, GameId
      attribute :bracket, BracketRef
      attribute :winner_ref, WinnerRef
    end
    query "WinsByOption" do |bracket|
      where bracket: :bracket, status: "resolved"
    end
  end
end
