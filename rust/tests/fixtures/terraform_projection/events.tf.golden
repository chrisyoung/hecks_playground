# Generated from hecksagon "Events" — storehouse project terraform

provider "aws" {
  region = "us-east-1"
}

resource "aws_sqs_queue" "events_queue" {
  message_retention_seconds = 345600
  visibility_timeout        = 60
}

resource "aws_lambda_function" "events_worker" {
  handler     = "main.handle"
  memory_size = 256
  role        = "arn:aws:iam::123456789012:role/events-worker"
  runtime     = "nodejs20.x"
  timeout     = 30
}

resource "aws_s3_bucket" "events_store" {
  bucket     = "events-store-2026"
  versioning = "enabled"
}

