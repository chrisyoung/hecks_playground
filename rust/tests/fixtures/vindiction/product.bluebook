Hecks.bluebook "VinDiction", version: "2026.05.18.1" do
  vision "Product is one row of BAVSound's own Shopify catalog — an audiophile upgrade (Stage One Speaker / Ghost Sub / Amplifier / Accessory) plus the vehicle fitment BAVSound already maintains. Identity is shopifyId : the join key Tom named (\"he wants BAVSound products link to VIN\"). Catalog seeds rows from the BAVSound Shopify export (pricelist.json, 1624 rows: BMW/Mini/Rolls Royce/Toyota). The fits query IS the i4 match engine and the result the i5 storefront VIN box renders — add-to-cart by shopifyHandle."
  category "service"

  aggregate "Product", "A BAVSound catalog fitment row — one upgrade product paired with one vehicle configuration it fits (make/model/body/chassis/year-range/factory-audio-system). Identified by RowId, a deterministic digest of the fitment-defining fields ; shopifyId is the cart / VIN join key Tom named but is many-to-one over fitment rows (one product fits up to ~80 vehicle configs in the BAVSound export)." do

    value_object "RowId" do
      # Deterministic identity of one fitment row : a stable digest of
      # (shopifyId, make, model, body, chassis, audio_system, year_from,
      # year_to). Exact-duplicate export rows collapse to one record by
      # construction ; distinct fitments of the same shopifyId stay
      # distinct. Generated by the pricelist->fixtures seeder, not typed.
      attribute :value, String
      rule "must not be blank" do
        requires { !value.strip.empty? }
      end
    end

    value_object "ShopifyId" do
      attribute :value, String
      rule "must not be blank" do
        requires { !value.strip.empty? }
      end
    end

    value_object "Make" do
      attribute :value, String
      rule "must not be blank" do
        requires { !value.strip.empty? }
      end
    end

    value_object "Model" do
      attribute :value, String
      rule "must not be blank" do
        requires { !value.strip.empty? }
      end
    end

    value_object "Body" do
      attribute :value, String
    end

    value_object "Chassis" do
      attribute :value, String
    end

    value_object "AudioSystem" do
      # The factory audio system this upgrade is FOR — the `audio`
      # column. The decisive match dimension against Vehicle.audio_system.
      attribute :value, String
      rule "must not be blank" do
        requires { !value.strip.empty? }
      end
    end

    value_object "YearFrom" do
      attribute :value, String
      rule "must be a 4-digit year" do
        requires { value.match?(/\A\d{4}\z/) }
      end
    end

    value_object "YearTo" do
      attribute :value, String
      rule "must be a 4-digit year" do
        requires { value.match?(/\A\d{4}\z/) }
      end
    end

    value_object "Priority" do
      # Rank when several products match one vehicle. Nullable in the
      # source ; blank = unranked.
      attribute :value, String
    end

    value_object "ModelFullName" do
      # \"6 Series Coupe E63 (2004-2011)\" — display string from source.
      attribute :value, String
    end

    value_object "ShopifyType" do
      # Stage One Speaker Upgrade | Ghost Sub Upgrade | BMW Amplifier
      # Upgrade | Accessories | No Product Available | (blank).
      attribute :value, String
    end

    value_object "ShopifyHandle" do
      # Storefront slug — the add-to-cart link the i5 widget renders.
      attribute :value, String
      rule "must not be blank" do
        requires { !value.strip.empty? }
      end
    end

    value_object "Description" do
      # `desc` — HTML blurb shown with the recommendation. Large, optional.
      attribute :value, String
    end

    attribute RowId,         as: :row_id
    attribute ShopifyId
    attribute Make,          as: :make
    attribute Model,         as: :model
    attribute Body,          as: :body
    attribute Chassis,       as: :chassis
    attribute AudioSystem,   as: :audio_system
    attribute YearFrom,      as: :year_from
    attribute YearTo,        as: :year_to
    attribute Priority,      as: :priority
    attribute ModelFullName, as: :model_full_name
    attribute ShopifyType,   as: :shopify_type
    attribute ShopifyHandle, as: :shopify_handle
    attribute Description,    as: :description

    command "Catalog" do
      role "System"
      description "Seed or update one BAVSound catalog fitment row from the Shopify export. Import only — BAVSound owns this data ; VinDiction mirrors it as the match index. Identity is the derived RowId, so re-cataloging the same fitment row updates it (one shopifyId spans many rows)."
      attribute RowId,         as: :row_id
      attribute ShopifyId
      attribute Make,          as: :make
      attribute Model,         as: :model
      attribute Body,          as: :body
      attribute Chassis,       as: :chassis
      attribute AudioSystem,   as: :audio_system
      attribute YearFrom,      as: :year_from
      attribute YearTo,        as: :year_to
      attribute Priority,      as: :priority
      attribute ModelFullName, as: :model_full_name
      attribute ShopifyType,   as: :shopify_type
      attribute ShopifyHandle, as: :shopify_handle
      attribute Description,    as: :description
      emits "ProductCataloged"
      then_set :row_id,           to: :row_id
      then_set :shopify_id,       to: :shopify_id
      then_set :make,             to: :make
      then_set :model,            to: :model
      then_set :body,             to: :body
      then_set :chassis,          to: :chassis
      then_set :audio_system,     to: :audio_system
      then_set :year_from,        to: :year_from
      then_set :year_to,          to: :year_to
      then_set :priority,         to: :priority
      then_set :model_full_name,  to: :model_full_name
      then_set :shopify_type,     to: :shopify_type
      then_set :shopify_handle,   to: :shopify_handle
      then_set :description,      to: :description
    end

    query "fits" do
      description "The i4 match engine / i5 widget result : given a decoded vehicle's make + model + body + chassis + factory audio system, return the BAVSound upgrades that fit. Year-window ([year_from, year_to] vs the vehicle year) and Priority ranking are applied caller-side — a single equality `where` cannot express a range or a sort, and that ordering is the i4 ranking rule, not a storage concern."
      attribute Make,        as: :make
      attribute Model,       as: :model
      attribute Body,        as: :body
      attribute Chassis,     as: :chassis
      attribute AudioSystem, as: :audio_system
      where(make: :make, model: :model, body: :body, chassis: :chassis, audio_system: :audio_system)
    end

    query "by_make_model" do
      description "All catalog rows for one make+model — browse / coverage-audit support (which vehicles BAVSound covers)."
      attribute Make,  as: :make
      attribute Model, as: :model
      where(make: :make, model: :model)
    end
  end
end
