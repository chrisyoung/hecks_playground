Hecks.fixtures "VinDiction" do
  # Minimal vendored slice of the BAVSound catalog — enough for the i9
  # regression (by_make_model("BMW", "6 Series") must return rows). The real
  # catalog is seeded from pricelist.json by the vindiction repo's
  # pricelist->fixtures seeder ; these two rows are hand-authored so the test
  # is self-contained and gates in CI without a sibling checkout.
  aggregate "Product" do
    fixture "BmwSixStageOne",
            row_id:       "bmw-6series-e63-l7-stage-one",
            shopify_id:   "stage-one-speakers",
            make:         "BMW",
            model:        "6 Series",
            body:         "Coupe",
            chassis:      "E63",
            audio_system: "Logic7"
    fixture "BmwSixGhostSub",
            row_id:       "bmw-6series-e63-l7-ghost-sub",
            shopify_id:   "ghost-sub",
            make:         "BMW",
            model:        "6 Series",
            body:         "Coupe",
            chassis:      "E63",
            audio_system: "Logic7"
  end
end
