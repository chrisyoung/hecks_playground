#!/bin/sh
# Miette Governance — pre-commit enforcement
#
# Tracked hook source. Install with: tooling/install-hooks
#
# Gates in order:
#   1. Parity suite (Ruby/Rust parser IR agreement) — block on drift
#   2. Lifecycle validator — block on any unreachable transitions
#   2b. Validator gate — `storehouse validate` on every staged .bluebook
#       (catches duplicate command names, unknown policy targets,
#        structural shape bugs)
#   3. Conceiver parity test — block if either conceiver drifts
#   4. Miette enforce (storehouse governance) — advisory, never blocks
#   4b. Companion-file ratchet — bluebook moves bring .behaviors +
#       .fixtures with them ; new aggregates and commands need test
#       coverage in their .behaviors companion
#   5. Antibody: surface non-bluebook adds/mods (list only — the
#      commit-msg hook does the actual enforcement, since that's
#      the only hook that sees the message's exemption marker)
#   6. Smoke tests must pass
#   6b. Behaviors corpus — `storehouse test` over each root
#       (parallel to Gate 6 during the i500 migration window)
#   7. LoC ratchet — non-bluebook LoC may not increase vs origin/main
#   8. cargo check --tests — all integration test targets compile
#   9. Specializer byte-identity — codegen output equals rust/src/<name>.rs
#      for all 30 tracked shapes
#
# Exit 0 = commit allowed. Exit 1 = commit blocked.
# Set PARITY_SKIP=1 to bypass gate 1 (an antibody failure).
# Set LIFECYCLE_SKIP=1 to bypass gate 2 (also an antibody failure).
# Set VALIDATE_SKIP=1 to bypass gate 2b (also an antibody failure).
# Set COMPANION_SKIP=1 to bypass gate 4b (also an antibody failure).
# Set TESTS_SKIP=1 to bypass gate 6 (also an antibody failure).
# Set BEHAVIORS_SKIP=1 to bypass gate 6b (also an antibody failure).
# Set RATCHET_SKIP=1 to bypass gate 7 (also an antibody failure).
# Set CARGO_CHECK_SKIP=1 to bypass gate 8 (also an antibody failure).
# Set SPECIALIZER_SKIP=1 to bypass gate 9 (also an antibody failure).

# i637 — worktree-aware repo anchor. The hook script lives in the
# shared core.hooksPath (always the main repo's .git/hooks), so a
# $0-relative anchor resolves to the main checkout even when the
# commit is happening in a linked worktree — and every gate then runs
# against the main tree + its (possibly in-flight) binary instead of
# the tree being committed. Derive $REPO from the working tree git is
# actually committing (git runs hooks with cwd = that worktree root),
# falling back to the $0-relative path only if rev-parse is unavailable.
# Mirrors the i565 worktree-awareness already in the smoke script.
REPO="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -n "$REPO" ] || REPO="$(cd "$(dirname "$0")/../.." && pwd)"
STOREHOUSE="$REPO/rust/target/release/storehouse"
CONCEPTION_DIR="$REPO/hecks_conception"
PARITY_TEST="$REPO/parity/parity_test.rb"
HECKSAGON_PARITY_TEST="$REPO/parity/hecksagon_parity_test.rb"
WORLD_PARITY_TEST="$REPO/parity/world_parity_test.rb"

# ── Gate 1: parity ────────────────────────────────────────────────
# Ruby DSL parser and Rust storehouse parser must agree on every
# fixture not listed in parity/known_drift.txt.
if [ -z "$PARITY_SKIP" ] && [ -f "$PARITY_TEST" ]; then
    if ! (cd "$REPO" && ruby -Iruby "$PARITY_TEST" >/tmp/parity.out 2>&1); then
        echo "COMMIT BLOCKED: parity suite failed (unexpected drift)."
        echo ""
        tail -40 /tmp/parity.out
        echo ""
        echo "Either fix the drift, or — if it is a real semantic gap —"
        echo "add the fixture path to parity/known_drift.txt."
        echo ""
        echo "Re-run: ruby -Iruby parity/parity_test.rb"
        exit 1
    fi
fi

# ── Gate 1b: hecksagon + world parity ────────────────────────────
# Same contract as Gate 1, but for the .hecksagon and .world DSLs
# (see parity/{hecksagon,world}_known_drift.txt for allowed drift).
if [ -z "$PARITY_SKIP" ] && [ -f "$HECKSAGON_PARITY_TEST" ]; then
    if ! (cd "$REPO" && ruby -Iruby "$HECKSAGON_PARITY_TEST" >/tmp/hecksagon_parity.out 2>&1); then
        echo "COMMIT BLOCKED: hecksagon parity suite failed."
        echo ""
        tail -40 /tmp/hecksagon_parity.out
        echo ""
        echo "Re-run: ruby -Iruby parity/hecksagon_parity_test.rb"
        exit 1
    fi
fi
if [ -z "$PARITY_SKIP" ] && [ -f "$WORLD_PARITY_TEST" ]; then
    if ! (cd "$REPO" && ruby -Iruby "$WORLD_PARITY_TEST" >/tmp/world_parity.out 2>&1); then
        echo "COMMIT BLOCKED: world parity suite failed."
        echo ""
        tail -40 /tmp/world_parity.out
        echo ""
        echo "Re-run: ruby -Iruby parity/world_parity_test.rb"
        exit 1
    fi
fi

# ── Gate 2: lifecycle validator ───────────────────────────────────
# Every bluebook's lifecycle must be internally consistent —
# transitions can't have unreachable from_states. Catches the
# "default = 'active', transition from: 'none'" bug class.
if [ -z "$LIFECYCLE_SKIP" ] && [ -x "$STOREHOUSE" ]; then
    BAD=""
    for f in $(find "$CONCEPTION_DIR" -name "*.bluebook" \
                  ! -name "*_behavioral_tests.bluebook" 2>/dev/null); do
        if ! "$STOREHOUSE" check-lifecycle "$f" >/dev/null 2>&1; then
            BAD="$BAD\n  $f"
        fi
    done
    if [ -n "$BAD" ]; then
        echo "COMMIT BLOCKED: lifecycle validator found unreachable transitions."
        echo ""
        echo "Bluebooks with errors:"
        printf "$BAD\n"
        echo ""
        echo "Run for details: storehouse check-lifecycle <file>"
        echo ""
        echo "The transition's from: value is unreachable — either fix the"
        echo "lifecycle default, or change/remove the from: requirement."
        exit 1
    fi
fi

# ── Gate 2b: validator gate on staged .bluebook files ─────────────
# Runs `storehouse validate` on every staged .bluebook. Catches
# duplicate command names, unknown commands in policies, structural
# shape bugs — the class of error that the lifecycle validator (Gate
# 2) doesn't cover. Focuses on STAGED files only (not the whole
# corpus) so it stays fast on small commits.
#
# Set VALIDATE_SKIP=1 to bypass (an antibody failure for emergencies).
if [ -z "$VALIDATE_SKIP" ] && [ -x "$STOREHOUSE" ]; then
    staged_bluebooks=$(git diff --cached --name-only --diff-filter=ACM | grep '\.bluebook$' || true)
    invalid=""
    for bb in $staged_bluebooks; do
        # Skip behavioral-tests bluebooks (legacy, not validatable).
        case "$bb" in
            *_behavioral_tests.bluebook) continue ;;
        esac
        [ -f "$REPO/$bb" ] || continue
        out=$("$STOREHOUSE" validate "$REPO/$bb" 2>&1)
        if printf '%s' "$out" | grep -q "^INVALID"; then
            invalid="${invalid}\n  ✗ $bb\n$(printf '%s' "$out" | sed 's/^/      /')"
        fi
    done
    if [ -n "$invalid" ]; then
        echo "COMMIT BLOCKED: validator gate — staged .bluebook(s) failed validate."
        printf "$invalid\n"
        echo ""
        echo "  Re-run individually : storehouse validate <path>"
        echo "  Bypass (use only for emergencies) : VALIDATE_SKIP=1 git commit ..."
        exit 1
    fi
fi

# ── Gate 3: conceiver parity test ─────────────────────────────────
# Bluebook conceiver and behaviors conceiver must keep the same
# shape: same files, same Conceiver trait, same surface.
if [ -d "/rust" ]; then
    if ! (cd "/rust" \
            && cargo test --release --test conceiver_parity_test \
                 >/tmp/conceiver_parity.out 2>&1); then
        echo "COMMIT BLOCKED: conceiver parity test failed (drift between conceivers)."
        echo ""
        tail -30 /tmp/conceiver_parity.out
        echo ""
        echo "Re-run: (cd rust && cargo test --release --test conceiver_parity_test)"
        exit 1
    fi
fi

# ── Gate 4: Miette enforce ─────────────────────────────────────────
# Governance advisory. Never blocks (yet).
if [ -x "$STOREHOUSE" ] && "$STOREHOUSE" enforce "$CONCEPTION_DIR" 2>/dev/null; then
    :
fi

# ── Gate 4b: Companion-file ratchet — moving a .bluebook means moving
# its .behaviors and .fixtures too. ───────────────────────────────────
# The i112 anatomy reorg silently broke 44 .behaviors files because
# bluebooks were moved to clusters but their test companions stayed
# at root, where the `storehouse behaviors` runner's same-stem-in-
# same-dir lookup quietly failed. This gate refuses that exact mistake
# going forward : if a bluebook moves and its same-stem .behaviors /
# .fixtures sit at the old path, the commit blocks until they move
# too.
#
# Set COMPANION_SKIP=1 to bypass (an antibody failure for emergencies).
if [ -z "$COMPANION_SKIP" ]; then
    # `git diff --cached --diff-filter=R` lists staged renames as
    # `R<sim>\told\tnew`. We extract old/new for any .bluebook rename
    # and check whether old/<stem>.behaviors / .fixtures still exist
    # untracked (i.e. not in the same staged batch).
    moves=$(git diff --cached --name-status --diff-filter=R | awk -F'\t' '$2 ~ /\.bluebook$/')
    orphans=""
    while IFS=$'\t' read -r status old new; do
        [ -z "$old" ] && continue
        old_dir=$(dirname "$old")
        new_dir=$(dirname "$new")
        [ "$old_dir" = "$new_dir" ] && continue   # rename within dir
        stem=$(basename "$old" .bluebook)
        for ext in behaviors fixtures; do
            companion_old="$old_dir/$stem.$ext"
            companion_new="$new_dir/$stem.$ext"
            # If the companion exists at the OLD path AND isn't also
            # being moved, the bluebook is leaving its sibling behind.
            if [ -f "$REPO/$companion_old" ] && \
               ! git diff --cached --name-status | grep -q "$companion_old"; then
                orphans="${orphans}    $companion_old → should move to $companion_new\n"
            fi
        done
    done <<EOF
$moves
EOF
    if [ -n "$orphans" ]; then
        printf '\nCOMMIT BLOCKED: companion-file ratchet — bluebook moved but its .behaviors/.fixtures didn'"'"'t :\n'
        printf "$orphans"
        printf '\n  Move the companions in the same commit (git mv) or set COMPANION_SKIP=1.\n'
        printf '  This was the failure mode of the i112 anatomy reorg : 44 silently-orphaned\n'
        printf '  .behaviors files because bluebooks moved without them.\n\n'
        exit 1
    fi

    # ── Companion-file ratchet, second teeth : every NEW `aggregate "X"`
    # or `command "Y"` declaration in a staged .bluebook must have a
    # matching `tests` line in its .behaviors companion.
    #
    # Walk staged adds + modifications, parse the diff for newly-added
    # `aggregate "X"` / `command "X"` lines, and for each one verify the
    # companion .behaviors references it. Skip when the companion
    # doesn't exist yet — the rename-only branch above already handles
    # the companion-pending-create case for moves, and brand-new
    # bluebooks without companions surface in pre-push.
    untested=""
    staged_added_or_mod=$(git diff --cached --name-only --diff-filter=AM | grep '\.bluebook$' || true)
    for bb in $staged_added_or_mod; do
        case "$bb" in
            *_behavioral_tests.bluebook) continue ;;
        esac
        bb_dir=$(dirname "$bb")
        bb_stem=$(basename "$bb" .bluebook)
        companion="$bb_dir/$bb_stem.behaviors"
        # Skip if no companion exists — pre-push owns the orphan diagnostic.
        [ ! -f "$REPO/$companion" ] && continue

        # Pull the +added lines from the staged diff and parse out
        # newly-introduced `aggregate "X"` / `command "X"` names.
        added=$(git diff --cached -U0 -- "$bb" | grep '^+' | grep -v '^+++')

        # Aggregates : `aggregate "X"` (with optional second arg).
        new_aggs=$(printf '%s\n' "$added" \
            | grep -E '^\+[[:space:]]*aggregate[[:space:]]+"' \
            | sed -E 's/^\+[[:space:]]*aggregate[[:space:]]+"([^"]+)".*/\1/' \
            | sort -u)

        # Commands : `command "Y"` (typically nested inside an aggregate).
        new_cmds=$(printf '%s\n' "$added" \
            | grep -E '^\+[[:space:]]*command[[:space:]]+"' \
            | sed -E 's/^\+[[:space:]]*command[[:space:]]+"([^"]+)".*/\1/' \
            | sort -u)

        # Each new aggregate must show up as `on: "X"` in the .behaviors.
        for agg in $new_aggs; do
            [ -z "$agg" ] && continue
            if ! grep -qE "on:[[:space:]]*\"$agg\"" "$REPO/$companion"; then
                untested="${untested}    $bb : new aggregate \"$agg\" — add a test in $companion with on: \"$agg\"\n"
            fi
        done

        # Each new command must show up as `tests "Y"` in the .behaviors.
        for cmd in $new_cmds; do
            [ -z "$cmd" ] && continue
            if ! grep -qE "tests[[:space:]]+\"$cmd\"" "$REPO/$companion"; then
                untested="${untested}    $bb : new command \"$cmd\" — add a test in $companion with tests \"$cmd\"\n"
            fi
        done
    done

    if [ -n "$untested" ]; then
        printf '\nCOMMIT BLOCKED: companion-file ratchet — new aggregate(s) / command(s) without tests :\n'
        printf "$untested"
        printf '\n  Add the matching test(s) to the .behaviors companion, or set COMPANION_SKIP=1.\n'
        printf '  Every new aggregate needs `tests "<command>", on: "<aggregate>"` ;\n'
        printf '  every new command needs a `tests "<command>"` line in the same .behaviors.\n\n'
        exit 1
    fi
fi

# ── Gate 5: Antibody — flag non-bluebook files (informational) ────
# Actual enforcement happens in the commit-msg hook, which is the only
# hook that sees the commit message (where exemption markers live).
# Here we just surface the list so the author can decide before
# writing their message.
if [ -x "$REPO/bin/antibody-check" ]; then
    "$REPO/bin/antibody-check" --staged --list-only || true
fi

# ── Gate 6: Smoke tests must pass ──────────────────────────────────
# Lightweight gate covering the regression net. Skips heavyweight
# tests that kill+reboot daemons (round4_integration_smoke) — those
# are flaky under hook conditions when prior tests left daemons in a
# transitional state. Run them manually before push.
#
# Set TESTS_SKIP=1 to bypass (an antibody failure for emergencies).
#
# Without this gate, the i112 anatomy reorg silently broke 44 .behaviors
# files for months because nothing was watching the test count. Smoke
# is the cheapest catch-fast gate ; bigger suites can stack later.
if [ -z "$TESTS_SKIP" ] && [ -d "$CONCEPTION_DIR/tests" ]; then
    failed=0
    for t in "$CONCEPTION_DIR/tests"/*.sh; do
        [ -f "$t" ] || continue
        # Skip the integration-smoke under hook conditions ; it does
        # full daemon kill + reboot + wait-for-tick which races when
        # other tests in the gate are spawning daemons. Run manually :
        #   bash hecks_conception/tests/round4_integration_smoke.sh
        case "$(basename "$t")" in
            round4_integration_smoke.sh) continue ;;
        esac
        if ! bash "$t" >/tmp/smoke_$(basename "$t" .sh).out 2>&1; then
            failed=$((failed + 1))
            echo "  ✗ $(basename "$t") failed (output: /tmp/smoke_$(basename "$t" .sh).out)"
        fi
    done
    if [ "$failed" -gt 0 ]; then
        echo ""
        echo "COMMIT BLOCKED: $failed smoke test(s) failed."
        echo "  Run individually : bash hecks_conception/tests/<name>.sh"
        echo "  Bypass (use only for emergencies) : TESTS_SKIP=1 git commit ..."
        exit 1
    fi
fi

# ── Gate 6b: Behaviors corpus — `storehouse test` per root ─────────
# Parallel to Gate 6 during the i500 migration window. Walks each
# active code-surface root and runs `storehouse test`, which
# exercises every .behaviors file with a same-stem .bluebook in the
# same dir. Mirrors pre-push ROOTS so we catch behavior regressions
# at commit time, not only at push.
#
# Roots match tooling/git-hooks/pre-push : aggregates / adapters /
# catalog under hecks_conception, plus framework dirs at repo root
# (tools, discipline, runtime, cli, bluebook, codegen, integrations).
# examples/ is intentionally excluded — some examples are :pending
# under runner gaps and won't be all-green.
#
# Set BEHAVIORS_SKIP=1 to bypass (an antibody failure for emergencies).
if [ -z "$BEHAVIORS_SKIP" ] && [ -x "$STOREHOUSE" ]; then
    BEHAVIORS_ROOTS=""
    [ -d "$REPO/hecks_conception/aggregates" ] && BEHAVIORS_ROOTS="$BEHAVIORS_ROOTS $REPO/hecks_conception/aggregates"
    [ -d "$REPO/hecks_conception/adapters" ]   && BEHAVIORS_ROOTS="$BEHAVIORS_ROOTS $REPO/hecks_conception/adapters"
    [ -d "$REPO/hecks_conception/catalog" ]    && BEHAVIORS_ROOTS="$BEHAVIORS_ROOTS $REPO/hecks_conception/catalog"
    [ -d "$REPO/tools" ]                       && BEHAVIORS_ROOTS="$BEHAVIORS_ROOTS $REPO/tools"
    [ -d "$REPO/discipline" ]                  && BEHAVIORS_ROOTS="$BEHAVIORS_ROOTS $REPO/discipline"
    [ -d "$REPO/runtime" ]                     && BEHAVIORS_ROOTS="$BEHAVIORS_ROOTS $REPO/runtime"
    [ -d "$REPO/cli" ]                         && BEHAVIORS_ROOTS="$BEHAVIORS_ROOTS $REPO/cli"
    [ -d "$REPO/bluebook" ]                    && BEHAVIORS_ROOTS="$BEHAVIORS_ROOTS $REPO/bluebook"
    [ -d "$REPO/codegen" ]                     && BEHAVIORS_ROOTS="$BEHAVIORS_ROOTS $REPO/codegen"
    [ -d "$REPO/integrations" ]                && BEHAVIORS_ROOTS="$BEHAVIORS_ROOTS $REPO/integrations"

    behaviors_failed_roots=""
    for root in $BEHAVIORS_ROOTS; do
        out_file="/tmp/behaviors_$(basename "$root").out"
        if ! "$STOREHOUSE" test "$root" >"$out_file" 2>&1; then
            behaviors_failed_roots="$behaviors_failed_roots\n  ✗ $root (output: $out_file)"
        fi
    done
    if [ -n "$behaviors_failed_roots" ]; then
        echo ""
        echo "COMMIT BLOCKED: behaviors corpus failed."
        printf "$behaviors_failed_roots\n"
        echo ""
        echo "  Re-run individually : storehouse test <root>"
        echo "  Bypass (use only for emergencies) : BEHAVIORS_SKIP=1 git commit ..."
        exit 1
    fi
fi

# ── Gate 7: LoC ratchet — non-bluebook LoC may not increase ───────
# Mirrors the CI ratchet (`.github/workflows/ratchet.yml`). When a
# CI gate fires that local didn't, that's an antibody failure for
# the hook — the hook should keep growing until local = CI. Catches
# Rust / shell / YAML growth before push, not at PR time.
#
# The ratchet compares HEAD against origin/main, reports per-tree
# deltas, and blocks if any non-bluebook LoC grew without a
# [loc-ratchet-override: <reason>] marker on a branch commit.
#
# Set RATCHET_SKIP=1 to bypass (an antibody failure for emergencies).
if [ -z "$RATCHET_SKIP" ] && [ -x "$REPO/bin/loc-ratchet" ]; then
    if ! "$REPO/bin/loc-ratchet" --base "origin/main" >/tmp/loc_ratchet.out 2>&1; then
        cat /tmp/loc_ratchet.out
        echo ""
        echo "COMMIT BLOCKED: non-bluebook LoC increased."
        echo "  Re-run : bin/loc-ratchet --base origin/main --verbose"
        echo "  Authorise with a branch commit whose message carries"
        echo "    [loc-ratchet-override: <concrete reason>]"
        echo "  Bypass (use only for emergencies) : RATCHET_SKIP=1 git commit ..."
        exit 1
    fi
fi

# ── Gate 8: cargo check --tests — all integration tests compile ───
# The smoke gate (Gate 6) runs only the smoke_test binary ; other
# integration tests aren't built locally. Result : a Rust struct
# can grow a field and one of 30+ test files can lag behind for
# months without anything noticing — until a CI parity job tries
# the full cargo test build and fails. validator_rules_test.rs +
# validator_warnings_test.rs each carried this gap on origin/main
# until 2026-05-11.
#
# This gate builds every test target without running them. ~10-30s
# warm cache, ~60s cold. Catches missing struct fields, type
# mismatches, renamed exports — anything the compiler sees but the
# smoke binary doesn't reach.
#
# Set CARGO_CHECK_SKIP=1 to bypass (an antibody failure for
# emergencies).
if [ -z "$CARGO_CHECK_SKIP" ] && [ -f "$REPO/rust/Cargo.toml" ]; then
    if ! ( cd "$REPO/rust" && cargo check --tests --quiet ) >/tmp/cargo_check_tests.out 2>&1; then
        cat /tmp/cargo_check_tests.out
        echo ""
        echo "COMMIT BLOCKED: cargo check --tests failed."
        echo "  Re-run : cd rust && cargo check --tests"
        echo "  Bypass (use only for emergencies) : CARGO_CHECK_SKIP=1 git commit ..."
        exit 1
    fi
fi

# ── Gate 9: specializer byte-identity — codegen output matches tracked files ──
# The Rust specializer turns codegen fragments (`codegen/<shape>/snippets/*.rs.frag`)
# + shape contracts into `rust/src/<name>.rs`. Any drift between what the
# specializer produces and what's committed at `rust/src/<name>.rs` means
# the kernel surface is editable in two places — fragment OR final file —
# which silently breaks future regenerations. The gate enforces single-source
# of truth : the specializer's output IS the file.
#
# All 30 byte-identity tests must pass. Test runs in ~0.2s on a warm release
# cache (the `cargo build --release` from prior storehouse work). On a cold
# cache the gate compiles release artifacts first, which can be slow ; in
# practice everyone working on Hecks has a warm release target/ from running
# `storehouse` daily.
#
# Set SPECIALIZER_SKIP=1 to bypass (an antibody failure for emergencies).
if [ -z "$SPECIALIZER_SKIP" ] && [ -f "$REPO/rust/tests/specializer_golden_test.rs" ]; then
    if ! ( cd "$REPO/rust" && cargo test --release --test specializer_golden_test --quiet ) >/tmp/specializer_goldens.out 2>&1; then
        cat /tmp/specializer_goldens.out
        echo ""
        echo "COMMIT BLOCKED: specializer byte-identity goldens drifted."
        echo "  One or more rust/src/<name>.rs files no longer match what the"
        echo "  specializer would emit from codegen/<shape>/snippets/*.rs.frag."
        echo ""
        echo "  Fix : sync the codegen fragment(s) so the specializer's output"
        echo "  equals the production file. Never edit rust/src/<name>.rs by hand."
        echo ""
        echo "  Re-run : cd rust && cargo test --release --test specializer_golden_test"
        echo "  Bypass (use only for emergencies) : SPECIALIZER_SKIP=1 git commit ..."
        exit 1
    fi
fi

exit 0
