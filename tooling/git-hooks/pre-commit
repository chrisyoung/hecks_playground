#!/bin/sh
# Miette Governance — pre-commit enforcement
#
# Tracked hook source. Install with: tooling/install-hooks
#
# Gates in order:
#   1. Parity suite (Ruby/Rust parser IR agreement) — block on drift
#   2. Lifecycle validator — block on any unreachable transitions
#   2b. Validator gate — `storehouse validate` on every staged .bluebook
#       (catches duplicate command names, unknown policy targets,
#        structural shape bugs)
#   3. Conceiver parity test — block if either conceiver drifts
#   4. Miette enforce (storehouse governance) — advisory, never blocks
#   4b. Companion-file ratchet — bluebook moves bring .behaviors +
#       .fixtures with them ; new aggregates and commands need test
#       coverage in their .behaviors companion
#   5. Antibody: surface non-bluebook adds/mods (list only — the
#      commit-msg hook does the actual enforcement, since that's
#      the only hook that sees the message's exemption marker)
#   6. Smoke tests must pass
#   6b. Behaviors corpus — `storehouse test` over each root
#       (parallel to Gate 6 during the i500 migration window)
#   7. LoC ratchet — non-bluebook LoC may not increase vs origin/main
#   8. cargo check --tests — all integration test targets compile, in
#      hecks-hecksagain's storehouse/ (i768 slice 2.2c: rust/ retired
#      from hecks_playground ; gate now runs against the fork's checkout)
#   9. Specializer byte-identity — codegen output equals storehouse/src/<name>.rs
#      for all tracked shapes (same fork checkout as Gate 8)
#   10. wasm32 build guard — the storehouse lib still compiles for
#       wasm32-unknown-unknown (the deciderate / bin-buddy worker target),
#       skipped gracefully when rustup or the wasm32 target is absent,
#       or when no hecks-hecksagain checkout is found
#
# Gates 3/8/9/10 run against hecks-hecksagain's storehouse/ crate, not a
# path inside this repo (i768 slice 2.2c blocker C) — rust/ retired from
# hecks_playground in full ; the engine these gates test now lives in the fork,
# checked out as a sibling of this repo (HECKS_PLAYGROUND_HECKSAGAIN_REPO overrides
# the sibling-repo guess). Each gate SKIPS with a loud stderr line (not a
# silent no-op) when no such checkout is found, same discipline as
# pre-push's integrity gate.
#
# Exit 0 = commit allowed. Exit 1 = commit blocked.
# Set PARITY_SKIP=1 to bypass gate 1 (an antibody failure).
# Set LIFECYCLE_SKIP=1 to bypass gate 2 (also an antibody failure).
# Set VALIDATE_SKIP=1 to bypass gate 2b (also an antibody failure).
# Set COMPANION_SKIP=1 to bypass gate 4b (also an antibody failure).
# Set TESTS_SKIP=1 to bypass gate 6 (also an antibody failure).
# Set BEHAVIORS_SKIP=1 to bypass gate 6b (also an antibody failure).
# Set RATCHET_SKIP=1 to bypass gate 7 (also an antibody failure).
# Set CARGO_CHECK_SKIP=1 to bypass gate 8 (also an antibody failure).
# Set SPECIALIZER_SKIP=1 to bypass gate 9 (also an antibody failure).
# Set WASM_SKIP=1 to bypass gate 10 (also an antibody failure).

# i637 — worktree-aware repo anchor. The hook script lives in the
# shared core.hooksPath (always the main repo's .git/hooks), so a
# $0-relative anchor resolves to the main checkout even when the
# commit is happening in a linked worktree — and every gate then runs
# against the main tree + its (possibly in-flight) binary instead of
# the tree being committed. Derive $REPO from the working tree git is
# actually committing (git runs hooks with cwd = that worktree root),
# falling back to the $0-relative path only if rev-parse is unavailable.
# Mirrors the i565 worktree-awareness already in the smoke script.
REPO="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -n "$REPO" ] || REPO="$(cd "$(dirname "$0")/../.." && pwd)"

# hecksagain cutover (i768 slice 2.2c blocker C): rust/ retired from
# hecks_playground — the engine's own crate, and the binary Gate 4 shells out to,
# now live in hecks-hecksagain's storehouse/ instead. Same sibling-repo
# convention blocker B wired into pre-push (env override first, then a
# conventional on-disk path), so one HECKS_PLAYGROUND_HECKSAGAIN_REPO controls
# both hooks' lookup. HECKSAGAIN_STOREHOUSE is the crate's SOURCE tree
# (Gates 3/8/9/10 `cd` into it and run cargo directly against fork
# sources, not a path-dep) ; STOREHOUSE below is a built BINARY (Gate 4
# shells out to it, same as pre-push's integrity gate) — different
# artifacts, same repo.
HECKSAGAIN_REPO="${HECKS_PLAYGROUND_HECKSAGAIN_REPO:-$(dirname "$REPO")/hecks-hecksagain}"
HECKSAGAIN_STOREHOUSE="$HECKSAGAIN_REPO/storehouse"
STOREHOUSE="${HECKS_PLAYGROUND_HECKSAGAIN_BIN:-}"
if [ -z "$STOREHOUSE" ]; then
    for candidate in \
        "$HECKSAGAIN_STOREHOUSE/target/release/storehouse" \
        "$HECKSAGAIN_STOREHOUSE/target/debug/storehouse"; do
        if [ -x "$candidate" ]; then
            STOREHOUSE="$candidate"
            break
        fi
    done
fi
CONCEPTION_DIR="$REPO/hecks_playground_conception"
PARITY_TEST="$REPO/parity/parity_test.rb"
HECKSAGON_PARITY_TEST="$REPO/parity/hecksagon_parity_test.rb"
WORLD_PARITY_TEST="$REPO/parity/world_parity_test.rb"

# ── Gate 1: parity — RETIRED (hecksagain cutover, 2026-08-11) ─────
# This gate checked Ruby-DSL-parser/Rust-storehouse-parser agreement —
# a real, load-bearing check for the dual-runtime era this repo used
# to be in. That era is over: hecksagain is now the canonical runtime
# (see /Users/christopheryoung/.claude/plans/okay-so-could-we-elegant-goose.md),
# and the whole point of that migration is that the corpus no longer
# matches the old Rust parser's expectations — by design, not drift.
# Confirmed directly before retiring, not assumed: a real commit attempt
# on the migration branch hit 158/394 fixture matches (0/120 on real
# aggregates) — the gate would never pass again as long as this
# migration's content exists. Retired with Chris's explicit sign-off
# (asked directly, not inferred) rather than bypassed with PARITY_SKIP.
# The file `parity/parity_test.rb` itself is left in place, unused —
# a real replacement gate (hecksagain-cli validate, per the migration
# plan's own Part 5/Task 5 verification work) is the next real step,
# not written into this hook yet.

# ── Gate 1b: hecksagon + world parity — RETIRED alongside Gate 1 ──
# (hecksagain cutover, 2026-08-11) Same reasoning as Gate 1 immediately
# above: this checked Ruby/Rust .hecksagon and .world DSL agreement,
# an era-specific gate for the dual-runtime period now over.

# ── Gate 2: lifecycle validator ───────────────────────────────────
# Every bluebook's lifecycle must be internally consistent —
# transitions can't have unreachable from_states. Catches the
# "default = 'active', transition from: 'none'" bug class.
# RETIRED (hecksagain cutover, 2026-08-11, Chris's explicit sign-off):
# `storehouse check-lifecycle` is the retired Rust binary against
# hecksagain-shaped content it can't parse — same reasoning as Gates
# 1/1b. hecksagain's own DSL builders + Registry#verify! already catch
# lifecycle-shape errors inline at boot (a clean `HecksPlayground.boot` IS
# validity, per this migration's own Part 1 validator finding) — Gate
# 2b just below is being upgraded to a real hecksagain-cli check
# covering this ground with the new runtime instead.

# ── Gate 2b: validator gate — PER-ROOT (parser-removal plan, Phase 1b) ──
# UPGRADED again, past the 2026-08-11 hecksagain cutover: that pass fixed
# WHICH runtime validates (hecksagain-cli, not the retired Rust binary),
# but `hecksagain-cli validate <root>` still flattened the WHOLE corpus
# into ONE combined boot and reported ONE verdict — i745 found it saying
# valid:true while 36 of hecks_playground_conception's own 58 sub-roots were
# individually invalid (a crash anywhere makes the whole thing false with
# no "which root", and a name collision between two roots can make a
# broken root silently PASS). `HecksagainRuntime.validate` now sweeps
# every domain root individually for a multi-root corpus (HecksagainRuntime
# ::ValidateSweep) and the CLI's `validate` verb carries that straight
# through — same command, honest shape. Print how many roots it actually
# swept, so a green gate says how much it looked at, not just that it
# found nothing wrong (i745's own standing lesson).
HECKSAGAIN_CLI="$REPO/hecksagain_runtime/bin/hecksagain-cli"
if [ -z "$VALIDATE_SKIP" ] && [ -x "$HECKSAGAIN_CLI" ]; then
    staged_bluebooks=$(git diff --cached --name-only --diff-filter=ACM | grep '\.bluebook$' || true)
    if [ -n "$staged_bluebooks" ]; then
        out=$("$HECKSAGAIN_CLI" validate "$CONCEPTION_DIR" 2>/dev/null)  # stdout only: hecks prints [hecks] warnings on stderr, which would break the JSON parse
        ok=$(printf '%s' "$out" | ruby -rjson -e 'puts (JSON.parse(STDIN.read)["ok"] == true) rescue puts "false"' 2>/dev/null || echo 'false')
        swept=$(printf '%s' "$out" | ruby -rjson -e 'puts JSON.parse(STDIN.read)["roots_swept"]' 2>/dev/null || echo '?')
        invalid=$(printf '%s' "$out" | ruby -rjson -e 'j=JSON.parse(STDIN.read); puts j["invalid"] || (j["valid"] == false ? 1 : 0)' 2>/dev/null || echo '?')
        # `ok:false` covers the sweep finding ZERO domain roots (a bad path,
        # or the discovery glob itself broke) -- "invalid:0 because nothing
        # was checked" must never read as a clean pass, the same false-
        # positive-on-nothing-found shape this whole gate exists to end.
        if [ "$ok" != "true" ] || [ "$invalid" != "0" ]; then
            echo "COMMIT BLOCKED: hecksagain-cli validate found a real defect (swept=$swept invalid=$invalid ok=$ok)."
            echo ""
            echo "$out"
            echo ""
            echo "  Re-run : $HECKSAGAIN_CLI validate $CONCEPTION_DIR"
            echo "  Bypass (use only for emergencies) : VALIDATE_SKIP=1 git commit ..."
            exit 1
        fi
        echo "✓ validate: $swept domain root(s) swept, all clean"
    fi
fi

# == Gate 3: conceiver parity test ==
# Bluebook conceiver and behaviors conceiver must keep the same
# shape: same files, same Conceiver trait, same surface. Guard fixed
# on re-home -- the pre-extraction guard had decayed to `[ -d "/rust" ]`
# (literal root, always skipped) ; now anchored at hecks-hecksagain's
# storehouse/ (i768 slice 2.2c blocker C -- rust/ retired from hecks_playground,
# would otherwise have silently decayed to a no-op again the same way).
if [ -d "$HECKSAGAIN_STOREHOUSE" ]; then
if ! (cd "$HECKSAGAIN_STOREHOUSE" \
        && cargo test --release --test conceiver_parity_test \
             >/tmp/conceiver_parity.out 2>&1); then
    echo "COMMIT BLOCKED: conceiver parity test failed (drift between conceivers)."
    echo ""
    tail -30 /tmp/conceiver_parity.out
    echo ""
    echo "Re-run: (cd $HECKSAGAIN_STOREHOUSE && cargo test --release --test conceiver_parity_test)"
    exit 1
fi
else
    echo "pre-commit: Gate 3 (conceiver parity) skipped — no hecks-hecksagain/storehouse checkout found at $HECKSAGAIN_STOREHOUSE (set HECKS_PLAYGROUND_HECKSAGAIN_REPO?)."
fi

# ── Gate 4: Miette enforce ─────────────────────────────────────────
# Governance advisory. Never blocks (yet).
if [ -x "$STOREHOUSE" ] && "$STOREHOUSE" enforce "$CONCEPTION_DIR" 2>/dev/null; then
    :
fi

# ── Gate 4b: Companion-file ratchet — moving a .bluebook means moving
# its .behaviors and .fixtures too. ───────────────────────────────────
# The i112 anatomy reorg silently broke 44 .behaviors files because
# bluebooks were moved to clusters but their test companions stayed
# at root, where the `storehouse behaviors` runner's same-stem-in-
# same-dir lookup quietly failed. This gate refuses that exact mistake
# going forward : if a bluebook moves and its same-stem .behaviors /
# .fixtures sit at the old path, the commit blocks until they move
# too.
#
# Set COMPANION_SKIP=1 to bypass (an antibody failure for emergencies).
if [ -z "$COMPANION_SKIP" ]; then
    # `git diff --cached --diff-filter=R` lists staged renames as
    # `R<sim>\told\tnew`. We extract old/new for any .bluebook rename
    # and check whether old/<stem>.behaviors / .fixtures still exist
    # untracked (i.e. not in the same staged batch).
    moves=$(git diff --cached --name-status --diff-filter=R | awk -F'\t' '$2 ~ /\.bluebook$/')
    orphans=""
    while IFS=$'\t' read -r status old new; do
        [ -z "$old" ] && continue
        old_dir=$(dirname "$old")
        new_dir=$(dirname "$new")
        [ "$old_dir" = "$new_dir" ] && continue   # rename within dir
        stem=$(basename "$old" .bluebook)
        for ext in behaviors fixtures; do
            companion_old="$old_dir/$stem.$ext"
            companion_new="$new_dir/$stem.$ext"
            # If the companion exists at the OLD path AND isn't also
            # being moved, the bluebook is leaving its sibling behind.
            if [ -f "$REPO/$companion_old" ] && \
               ! git diff --cached --name-status | grep -q "$companion_old"; then
                orphans="${orphans}    $companion_old → should move to $companion_new\n"
            fi
        done
    done <<EOF
$moves
EOF
    if [ -n "$orphans" ]; then
        printf '\nCOMMIT BLOCKED: companion-file ratchet — bluebook moved but its .behaviors/.fixtures didn'"'"'t :\n'
        printf "$orphans"
        printf '\n  Move the companions in the same commit (git mv) or set COMPANION_SKIP=1.\n'
        printf '  This was the failure mode of the i112 anatomy reorg : 44 silently-orphaned\n'
        printf '  .behaviors files because bluebooks moved without them.\n\n'
        exit 1
    fi

    # ── Companion-file ratchet, second teeth : every NEW `aggregate "X"`
    # or `command "Y"` declaration in a staged .bluebook must have a
    # matching `tests` line in its .behaviors companion.
    #
    # Walk staged adds + modifications, parse the diff for newly-added
    # `aggregate "X"` / `command "X"` lines, and for each one verify the
    # companion .behaviors references it. Skip when the companion
    # doesn't exist yet — the rename-only branch above already handles
    # the companion-pending-create case for moves, and brand-new
    # bluebooks without companions surface in pre-push.
    untested=""
    staged_added_or_mod=$(git diff --cached --name-only --diff-filter=AM | grep '\.bluebook$' || true)
    for bb in $staged_added_or_mod; do
        case "$bb" in
            *_behavioral_tests.bluebook) continue ;;
        esac
        bb_dir=$(dirname "$bb")
        bb_stem=$(basename "$bb" .bluebook)
        companion="$bb_dir/$bb_stem.behaviors"
        # Skip if no companion exists — pre-push owns the orphan diagnostic.
        [ ! -f "$REPO/$companion" ] && continue

        # Pull the +added lines from the staged diff and parse out
        # newly-introduced `aggregate "X"` / `command "X"` names.
        added=$(git diff --cached -U0 -- "$bb" | grep '^+' | grep -v '^+++')

        # Aggregates : `aggregate "X"` (with optional second arg).
        new_aggs=$(printf '%s\n' "$added" \
            | grep -E '^\+[[:space:]]*aggregate[[:space:]]+"' \
            | sed -E 's/^\+[[:space:]]*aggregate[[:space:]]+"([^"]+)".*/\1/' \
            | sort -u)

        # Commands : `command "Y"` (typically nested inside an aggregate).
        new_cmds=$(printf '%s\n' "$added" \
            | grep -E '^\+[[:space:]]*command[[:space:]]+"' \
            | sed -E 's/^\+[[:space:]]*command[[:space:]]+"([^"]+)".*/\1/' \
            | sort -u)

        # Each new aggregate must show up as `on: "X"` in the .behaviors.
        for agg in $new_aggs; do
            [ -z "$agg" ] && continue
            if ! grep -qE "on:[[:space:]]*\"$agg\"" "$REPO/$companion"; then
                untested="${untested}    $bb : new aggregate \"$agg\" — add a test in $companion with on: \"$agg\"\n"
            fi
        done

        # Each new command must show up as `tests "Y"` in the .behaviors.
        for cmd in $new_cmds; do
            [ -z "$cmd" ] && continue
            if ! grep -qE "tests[[:space:]]+\"$cmd\"" "$REPO/$companion"; then
                untested="${untested}    $bb : new command \"$cmd\" — add a test in $companion with tests \"$cmd\"\n"
            fi
        done
    done

    if [ -n "$untested" ]; then
        printf '\nCOMMIT BLOCKED: companion-file ratchet — new aggregate(s) / command(s) without tests :\n'
        printf "$untested"
        printf '\n  Add the matching test(s) to the .behaviors companion, or set COMPANION_SKIP=1.\n'
        printf '  Every new aggregate needs `tests "<command>", on: "<aggregate>"` ;\n'
        printf '  every new command needs a `tests "<command>"` line in the same .behaviors.\n\n'
        exit 1
    fi
fi

# ── Gate 5: Antibody — flag non-bluebook files (informational) ────
# Actual enforcement happens in the commit-msg hook, which is the only
# hook that sees the commit message (where exemption markers live).
# Here we just surface the list so the author can decide before
# writing their message.
if [ -x "$REPO/bin/antibody-check" ]; then
    "$REPO/bin/antibody-check" --staged --list-only || true
fi

# ── Gate 6: Smoke tests — RETIRED (hecksagain cutover, 2026-08-11) ──
# Chris's explicit sign-off, same reasoning as Gates 1/1b/2: every
# `hecks_playground_conception/tests/*.sh` shells the retired Rust `storehouse`
# binary against content now rewritten for hecksagain — confirmed
# directly this pass (5 of them failed on a commit touching a SINGLE
# unrelated Ruby file, because they test the whole corpus's CURRENT
# on-disk state against the old binary's semantics, not what's
# staged). A real hecksagain-native regression suite is future work,
# not written into this hook yet — Gate 2b just above already covers
# "does the corpus still boot" for real, through the real runtime.

# ── Gate 6b: Behaviors corpus — RETIRED (hecksagain cutover, 2026-08-11) ──
# Chris's explicit sign-off, same reasoning as Gate 6. `storehouse test`
# is the retired Rust binary's `.behaviors` interpreter — hecksagain
# has no `.behaviors` interpreter of its own yet (checked directly this
# migration, both the vendored copy and the untouched original repo —
# `hecksagain-cli behaviors`/`conceive-behaviors` now return an honest
# `{ok:false,supported:false}` rather than pretending to run something
# that doesn't exist). Real replacement is future work (Part 1 item 5
# of the migration plan), not written into this hook yet.

# ── Gate 7: LoC ratchet — report deltas (informational) ───────────
# Mirrors the CI ratchet (`.github/workflows/ratchet.yml`). Actual
# enforcement happens in the commit-msg hook (Gate C), which is the
# only hook that sees the in-flight commit message (where the
# [loc-ratchet-override: <reason>] marker lives). Pre-commit runs
# before the message exists, so blocking here would deadlock the
# marker-carrying commit itself (the bootstrap gap, fixed 2026-07-02).
# Here we just surface the per-concern report so the author can add
# the marker BEFORE writing their message.
#
# DISABLED 2026-07-26 at Chris's request — the informational half of the same
# gate disabled in commit-msg (Gate C). Re-enable by removing the `false &&`.
#
# Set RATCHET_SKIP=1 to bypass (an antibody failure for emergencies).
if false && [ -z "$RATCHET_SKIP" ] && [ -x "$REPO/bin/loc-ratchet" ]; then
    "$REPO/bin/loc-ratchet" --base "origin/main" --verbose || true
fi

# == Gate 8: cargo check --tests -- all integration tests compile ==
# The smoke gate (Gate 6) runs only the smoke_test binary ; other
# integration tests aren't built locally. A Rust struct can grow a
# field and one of 30+ test files lag behind for months unnoticed --
# until a CI parity job tries the full cargo test build and fails.
# This gate builds every test target without running them (~10-30s
# warm, ~60s cold).
#
# Set CARGO_CHECK_SKIP=1 to bypass (an antibody failure for emergencies).
# Repointed at hecks-hecksagain's storehouse/ (i768 slice 2.2c blocker C) --
# rust/ retired from hecks_playground ; see HECKSAGAIN_STOREHOUSE's definition above.
if [ -z "$CARGO_CHECK_SKIP" ] && [ -f "$HECKSAGAIN_STOREHOUSE/Cargo.toml" ]; then
if ! ( cd "$HECKSAGAIN_STOREHOUSE" && cargo check --tests --quiet --workspace ) >/tmp/cargo_check_tests.out 2>&1; then
    cat /tmp/cargo_check_tests.out
    echo ""
    echo "COMMIT BLOCKED: cargo check --tests failed."
    echo "  Re-run : cd $HECKSAGAIN_STOREHOUSE && cargo check --tests --workspace"
    echo "  Bypass (use only for emergencies) : CARGO_CHECK_SKIP=1 git commit ..."
    exit 1
fi
else
    if [ -z "$CARGO_CHECK_SKIP" ]; then
        echo "pre-commit: Gate 8 (cargo check --tests) skipped — no hecks-hecksagain/storehouse checkout found at $HECKSAGAIN_STOREHOUSE (set HECKS_PLAYGROUND_HECKSAGAIN_REPO?)."
    fi
fi

# == Gate 9: specializer byte-identity -- codegen output matches tracked files ==
# The Rust specializer turns codegen fragments (codegen/<shape>/snippets/*.rs.frag)
# + shape contracts into rust/src/<name>.rs. Drift between what the
# specializer emits and what's committed means the kernel surface is
# editable in two places -- silently breaking future regenerations.
# The gate enforces single-source-of-truth : the specializer's output
# IS the file. Runs in ~0.2s on a warm release cache.
#
# Set SPECIALIZER_SKIP=1 to bypass (an antibody failure for emergencies).
# Repointed at hecks-hecksagain's storehouse/ (i768 slice 2.2c blocker C) --
# rust/ retired from hecks_playground ; see HECKSAGAIN_STOREHOUSE's definition above.
if [ -z "$SPECIALIZER_SKIP" ] && [ -f "$HECKSAGAIN_STOREHOUSE/tests/specializer_golden_test.rs" ]; then
if ! ( cd "$HECKSAGAIN_STOREHOUSE" && cargo test --release --test specializer_golden_test --quiet ) >/tmp/specializer_goldens.out 2>&1; then
    cat /tmp/specializer_goldens.out
    echo ""
    echo "COMMIT BLOCKED: specializer byte-identity goldens drifted."
    echo "  One or more $HECKSAGAIN_STOREHOUSE/src/<name>.rs files no longer match what the"
    echo "  specializer would emit from codegen/<shape>/snippets/*.rs.frag."
    echo ""
    echo "  Fix : sync the codegen fragment(s) so the specializer's output"
    echo "  equals the production file. Never edit src/<name>.rs by hand."
    echo "  Re-run : cd $HECKSAGAIN_STOREHOUSE && cargo test --release --test specializer_golden_test"
    echo "  Bypass (use only for emergencies) : SPECIALIZER_SKIP=1 git commit ..."
    exit 1
fi
else
    if [ -z "$SPECIALIZER_SKIP" ]; then
        echo "pre-commit: Gate 9 (specializer byte-identity) skipped — no hecks-hecksagain/storehouse checkout found at $HECKSAGAIN_STOREHOUSE (set HECKS_PLAYGROUND_HECKSAGAIN_REPO?)."
    fi
fi

# == Gate 10: wasm32 build guard -- the storehouse lib stays wasm-safe ==
# The deciderate / bin-buddy Cloudflare-worker target consumes the
# storehouse crate with default-features off, compiled for
# wasm32-unknown-unknown. A non-wasm dep sneaking into the no-default
# surface would break those workers at deploy, not here. Homebrew cargo
# has NO wasm32 std, so this uses the rustup stable toolchain ; if rustup
# or the wasm32 target is absent (an OSS contributor without it), the
# gate skips gracefully rather than blocking.
#
# Set WASM_SKIP=1 to bypass (an antibody failure for emergencies).
# Repointed at hecks-hecksagain's storehouse/ (i768 slice 2.2c blocker C) --
# rust/ retired from hecks_playground ; see HECKSAGAIN_STOREHOUSE's definition above.
if [ -z "$WASM_SKIP" ] && [ -f "$HECKSAGAIN_STOREHOUSE/Cargo.toml" ] && command -v rustup >/dev/null 2>&1 \
&& rustup target list --installed 2>/dev/null | grep -q '^wasm32-unknown-unknown$'; then
if ! ( cd "$HECKSAGAIN_STOREHOUSE" && rustup run stable cargo check --target wasm32-unknown-unknown -p storehouse --no-default-features --quiet ) >/tmp/wasm_check.out 2>&1; then
    cat /tmp/wasm_check.out
    echo ""
    echo "COMMIT BLOCKED: storehouse lib failed wasm32-unknown-unknown build."
    echo "  The deciderate / bin-buddy worker target consumes this crate."
    echo "  Re-run : cd $HECKSAGAIN_STOREHOUSE && rustup run stable cargo check --target wasm32-unknown-unknown -p storehouse --no-default-features"
    echo "  Bypass (use only for emergencies) : WASM_SKIP=1 git commit ..."
    exit 1
fi
else
    if [ -z "$WASM_SKIP" ] && [ ! -f "$HECKSAGAIN_STOREHOUSE/Cargo.toml" ]; then
        echo "pre-commit: Gate 10 (wasm32 build guard) skipped — no hecks-hecksagain/storehouse checkout found at $HECKSAGAIN_STOREHOUSE (set HECKS_PLAYGROUND_HECKSAGAIN_REPO?)."
    fi
fi

exit 0
