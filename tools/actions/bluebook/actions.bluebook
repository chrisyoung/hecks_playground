Hecks.bluebook "Actions", version: "2026.05.12.1" do
  vision "Miette's ability to plan, execute, verify, and reverse structural changes — every action is a Bluebook with before/after state"
  category "capability"

  # 2026-05-12 : primitives wrapped in typed value-objects per the
  # no-primitive-envy rule. Per-aggregate VO sets — ActionPlan and
  # ActionLog each carry their own typed vocabulary so the domain
  # reads as itself (a plan has a Rationale and a PlanStatus, not a
  # String and a String).

  aggregate "ActionPlan", "A structural change Miette intends to make — encoded as Bluebook before execution" do
    # ── Value-objects : the plan's vocabulary ──

    value_object "ActionName" do
      # Human-readable identifier for the action — what Miette calls
      # this structural change when she refers to it later.
      attribute :value, String
    end

    value_object "ActionDescription" do
      # Free-form description of the action — what it changes,
      # surface area touched, observable difference once executed.
      attribute :value, String
    end

    value_object "Rationale" do
      # Why this action is worth taking — the justification that
      # Court reviews against the active laws before granting
      # permission to execute.
      attribute :value, String
    end

    value_object "ActionBluebookPath" do
      # Filesystem path to the action Bluebook — the script that
      # carries the before / after state fixtures and the step
      # commands the executor walks.
      attribute :value, String
    end

    value_object "PlanStatus" do
      # Lifecycle position of the plan — draft, conceived, reviewed,
      # executed, reverse_tested, confirmed, verified, reversed.
      # Free-form string today ; the lifecycle declaration below
      # constrains transitions.
      attribute :value, String
    end

    value_object "StepCount" do
      # A count of action steps — total or completed. The plan tracks
      # progress by stepping this counter forward via CompleteStep.
      attribute :value, Integer
    end

    attribute :name,                 ActionName
    attribute :description,          ActionDescription
    attribute :rationale,            Rationale
    attribute :action_bluebook_path, ActionBluebookPath
    attribute :status,               PlanStatus
    attribute :steps_total,          StepCount
    attribute :steps_completed,      StepCount

    command "Conceive" do
      role "Miette"
      description "Conceive an action — write the action Bluebook with fixtures for before/after state"
      attribute :name,                 ActionName
      attribute :description,          ActionDescription
      attribute :rationale,            Rationale
      attribute :action_bluebook_path, ActionBluebookPath
      attribute :steps_total,          StepCount
      emits "ActionConceived"
      then_set :name,                 to: :name
      then_set :description,          to: :description
      then_set :rationale,            to: :rationale
      then_set :action_bluebook_path, to: :action_bluebook_path
      then_set :steps_total,          to: :steps_total
      then_set :steps_completed,      to: 0
      then_set :status,               to: "conceived"
    end

    command "ReviewWithCourt" do
      role "Miette"
      description "Submit the planned action to Court — check it against active laws before executing"
      reference_to(ActionPlan)
      given { status == "conceived" }
      emits "ActionSubmittedToCourt"
      then_set :status, to: "reviewed"
    end

    command "Execute" do
      role "Miette"
      description "Perform the action — the Bluebook is the script, the fixtures are the checkpoints"
      reference_to(ActionPlan)
      given { status == "reviewed" }
      emits "ActionExecuted"
      then_set :status, to: "executed"
    end

    command "CompleteStep" do
      role "Miette"
      description "Mark one step of the action as done"
      reference_to(ActionPlan)
      emits "StepCompleted"
      then_set :steps_completed, increment: 1
    end

    command "TestReverse" do
      role "Miette"
      description "Reverse the action to prove it's reversible — restore before-state, confirm it works"
      reference_to(ActionPlan)
      given { status == "executed" }
      emits "ReverseTestPassed"
      then_set :status, to: "reverse_tested"
    end

    command "ReExecute" do
      role "Miette"
      description "After successful reverse test, re-execute the action for real"
      reference_to(ActionPlan)
      given { status == "reverse_tested" }
      emits "ActionReExecuted"
      then_set :status, to: "confirmed"
    end

    command "Verify" do
      role "Miette"
      description "Confirm the action was clean — boot works, no dangling references, laws still pass"
      reference_to(ActionPlan)
      given { status == "confirmed" }
      emits "ActionVerified"
      then_set :status, to: "verified"
    end

    command "Reverse" do
      role "Miette"
      description "Undo the action for real — restore before-state from the action Bluebook's fixtures"
      reference_to(ActionPlan)
      emits "ActionReversed"
      then_set :status, to: "reversed"
      then_set :steps_completed, to: 0
    end

    lifecycle :status, default: "draft" do
      transition "Conceive" => "conceived"
      transition "ReviewWithCourt" => "reviewed", from: "conceived"
      transition "Execute" => "executed", from: "reviewed"
      transition "TestReverse" => "reverse_tested", from: "executed"
      transition "ReExecute" => "confirmed", from: "reverse_tested"
      transition "Verify" => "verified", from: "confirmed"
      transition "Reverse" => "reversed", from: ["confirmed", "verified"]
      transition "Conceive" => "conceived", from: "reversed"
    end
  end

  aggregate "ActionLog", "Permanent record of actions taken — the history of structural decisions" do
    # ── Value-objects : the log's vocabulary ──

    value_object "ActionName" do
      # The action's name (mirror of ActionPlan.ActionName for log
      # rows). Per-aggregate set : ActionLog carries its own copy so
      # the log domain reads self-contained.
      attribute :value, String
    end

    value_object "ExecutedAt" do
      # UTC ISO timestamp the action was executed at — stamped on
      # every Log event for audit chronology.
      attribute :value, String
    end

    value_object "EngineUsed" do
      # Which brain or runtime carried out the action (e.g.
      # 'miette', 'claude', 'manual'). The provenance the log row
      # surfaces.
      attribute :value, String
    end

    value_object "Ruling" do
      # What Court decided when the action was reviewed — the
      # captured ruling string (e.g. 'approved', 'rejected', 'with
      # caveats: foo'). Pure provenance, not policy.
      attribute :value, String
    end

    value_object "FileCount" do
      # Number of files the action changed — surfaces in the log row
      # so the operator can spot disproportionately large actions.
      attribute :value, Integer
    end

    value_object "Outcome" do
      # The action's terminal state from the log's point of view
      # (e.g. 'success', 'failure', 'reverted'). Free-form today ;
      # lifecycle on ActionPlan carries the formal vocabulary.
      attribute :value, String
    end

    attribute :action_name,   ActionName
    attribute :executed_at,   ExecutedAt
    attribute :engine_used,   EngineUsed
    attribute :ruling,        Ruling
    attribute :files_changed, FileCount
    attribute :outcome,       Outcome

    command "Log" do
      role "System"
      description "Record that an action was executed — who, when, with what brain, what Court ruled"
      attribute :action_name,   ActionName
      attribute :executed_at,   ExecutedAt
      attribute :engine_used,   EngineUsed
      attribute :ruling,        Ruling
      attribute :files_changed, FileCount
      attribute :outcome,       Outcome
      emits "ActionLogged"
      then_set :action_name,   to: :action_name
      then_set :executed_at,   to: :executed_at
      then_set :engine_used,   to: :engine_used
      then_set :ruling,        to: :ruling
      then_set :files_changed, to: :files_changed
      then_set :outcome,       to: :outcome
    end
  end

  # Wiring — actions go through Court before execution
  policy "CourtReviewOnConceive" do
    on "ActionConceived"
    trigger "ReviewWithCourt"
  end

  policy "LogOnExecute" do
    on "ActionExecuted"
    trigger "Log"
  end

  policy "LogOnReverse" do
    on "ActionReversed"
    trigger "Log"
  end

  # Connect to Conscience — actions are felt
  policy "SenseActionOnExecute" do
    on "ActionExecuted"
    trigger "ReviewAction"
  end

  policy "SenseOnReverse" do
    on "ActionReversed"
    trigger "Sense"
    map source: "action_reversal", valence: 0.0
  end

end
