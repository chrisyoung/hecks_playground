#!/usr/bin/env bash
# [antibody-exempt: tools/web_debug/disk-buffer-handler — the out-of-process
#  screenshot_buffer DiskBuffer adapter. Thin-shell glue : the kernel carries no
#  adapter, this handler IS the only adapter-specific code, invoked by the
#  adapter-host with the FrameCaptured payload on stdin. Cannot be bluebook
#  vocabulary (it runs as an OS process). Permanent — Chris chose the
#  registry/permanent path, 2026-06-25.]
# disk-buffer-handler — the screenshot_buffer DiskBuffer adapter, OUT-OF-PROCESS.
#
# The Rust port of the Ruby :web_debug ScreenshotBuffer. Plugged into the generic
# adapter-host / in-runtime outbound pump : the kernel carries no adapter, this
# thin handler is the ONLY adapter-specific code. Contract (mirrors
# examples/adapter_host_demo/stripe-handler) :
#   - the FrameCaptured event PAYLOAD (JSON) arrives on stdin :
#       { "frame_id": "…", "captured_at": "…", "frame_data": "<base64 jpeg>" }
#   - the .world block folds into the env as SCREENSHOT_BUFFER_DIR /
#     SCREENSHOT_BUFFER_CAPACITY (canonical <FAMILY>_<FIELD> names).
#   - it base64-decodes frame_data, writes frame_<id>.jpg + refreshes latest.jpg
#     under the dir, prunes the oldest past capacity (the circular buffer).
#   - it prints the written basename as `path=…` on stdout (the success verdict
#     threaded into Screenshot.RecordStored) and exits 0 ; non-zero on failure.
# Because it is a SEPARATE PROCESS, a slow or wedged write can NEVER block the
# synchronous domain core — the whole point of an effect port.
set -euo pipefail

DIR="${SCREENSHOT_BUFFER_DIR:-/tmp/ha_screenshots}"
CAP="${SCREENSHOT_BUFFER_CAPACITY:-100}"
mkdir -p "$DIR"

payload="$(cat)"
fid="$(printf '%s' "$payload" | jq -r '.frame_id // .aggregate_id // empty')"
data="$(printf '%s' "$payload" | jq -r '.frame_data // empty')"
[ -n "$data" ] || { echo "disk-buffer-handler: no frame_data on stdin" >&2; exit 1; }
[ -n "$fid" ] || fid="$(date +%s%N)"

# Strip an optional `data:image/jpeg;base64,` URL prefix, then decode to the frame.
frame="$DIR/frame_${fid}.jpg"
printf '%s' "$data" | sed 's#^data:image/[a-zA-Z]*;base64,##' | base64 -d > "$frame"
cp "$frame" "$DIR/latest.jpg"

# Prune : keep only the newest $CAP frame_*.jpg (the circular buffer depth).
ls -1t "$DIR"/frame_*.jpg 2>/dev/null | tail -n +"$((CAP + 1))" | xargs -r rm -f

echo "path=frame_${fid}.jpg"
