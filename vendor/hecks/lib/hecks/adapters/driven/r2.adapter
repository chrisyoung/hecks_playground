# Vendored addition, not (yet) upstream hecks (migration plan slice
# 1.5): no Ruby R2 adapter has ever existed anywhere in this lineage —
# not in the fork, not in hecks's own vendored snapshot. Built fresh
# here, modeled on d1.adapter (this same directory) as its closest
# structural sibling — a persistence adapter reached over HTTP rather
# than a local handle, just SigV4-signed instead of Bearer-token
# authenticated. See r2.rb for the implementation and
# lib/hecks/framework/bluebook/r2_adapter.bluebook for the ported
# wiring vision (hecks/adapters/storage/r2/r2.bluebook upstream).
#
# Shipped in the same commit as r2.rb on purpose — an `.adapter` file
# with no class behind it is a `WiringError` trap for whoever binds
# `persisted_by("R2")` first (see d1.adapter's own header for the same
# reasoning).
Hecks.adapter "R2" do
  port   "persistence"
  field  :bucket
  field  :account
  secret :access_key
  secret :secret_key
end
