# Vendored addition, not (yet) upstream hecks (migration plan slice
# 1.5) — ported from hecks/adapters/storage/r2/r2.bluebook, R2 is
# genuinely new to hecks's own lineage, not inherited from
# upstream: no Ruby R2 adapter has ever existed anywhere before this
# slice (not in the fork, not in hecks's own vendored snapshot).
#
# THIS FILE IS THE WIRING VISION, not the wiring itself — same relationship
# D1 has to its own persistence path in this fork: D1 has no bluebook at
# all (adapters/driven/d1.rb + d1.adapter ARE the whole wiring story,
# resolved through `Ports::Persistence::RepositoryFactory` from plain
# `field`/`secret` declarations, no aggregate-level Binding/Reference
# layer in between). This chapter documents the SAME conceptual shape
# hecks_conception's own R2Adapter carries there (a `Binding` aggregate
# mapping an aggregate name to an R2 object key, a `Reference` aggregate
# for singleton resolution) as a FRAMEWORK MEMBER — attach it with
# `uses_framework "R2Adapter"` the way `Framework.load!` loads Governance
# or Identity — but nothing in THIS runtime dispatches through it to
# reach `adapters/driven/r2.rb`; the real wiring is `persisted_by("R2")`
# plus a world's `r2 do bucket_env "..." account_env "..." ... end`
# block, resolved the same field/secret way D1 already is.
#
# hecks has no `.behaviors` DSL loader (confirmed: zero `.behaviors`
# files anywhere in this fork before this slice) — the upstream
# r2.behaviors sibling this vision came with has no home here.
# Equivalent behavioral coverage for the REAL adapter lives in
# spec/adapters/driven/r2_spec.rb instead.
Hecks.bluebook "R2Adapter" do
  vision "R2 persistence — aggregate state lives in Cloudflare R2 objects, addressed by bucket + key"
  supporting

  aggregate "Binding" do
    description "Maps an aggregate to an R2 object"

    identified_by :aggregate_name

    value_object "AggregateName" do
      # The aggregate's PascalCase name as declared in its own bluebook
      # (e.g. "Heartbeat", "Order").
      attribute :value, String
      invariant("must be non-empty") { !value.to_s.empty? }
    end

    value_object "StorePath" do
      # The R2 object key within the world-configured bucket. Convention
      # mirrors heki: PascalCase aggregate name converted to snake_case
      # plus the ".heki" extension, preserved for portability across
      # storage backends — a heki-format binary blob in R2 looks the
      # same as one on the filesystem (see adapters/driven/r2.rb).
      attribute :value, String
      invariant("must be non-empty") { !value.to_s.empty? }
    end

    value_object "IdStrategy" do
      # R2 inherits heki's :uuid strategy — the kernel generates a UUID
      # per record when it upserts; the bluebook never sees the id.
      attribute :value, String
      invariant("must be 'uuid'") { value == "uuid" }
    end

    value_object "SaveStrategy" do
      # R2 inherits heki's :upsert strategy — every aggregate is a
      # singleton, one object per aggregate, overwrites replace.
      attribute :value, String
      invariant("must be 'upsert'") { value == "upsert" }
    end

    attribute :aggregate_name, AggregateName
    attribute :store_path,     StorePath
    attribute :id_strategy,    IdStrategy
    attribute :save_strategy,  SaveStrategy

    command "BindAggregate" do
      role "System"
      goal "Wire an aggregate to its R2 object — store_path is the object key within the world-configured bucket"

      attribute :aggregate_name, AggregateName
      attribute :store_path,     StorePath

      sets :aggregate_name
      sets :store_path
      sets :id_strategy,    to: "uuid"
      sets :save_strategy,  to: "upsert"

      emits "AggregateBound"
    end
  end

  aggregate "Reference" do
    description "How references between aggregates resolve"

    identified_by :from_aggregate, :to_aggregate

    value_object "FromAggregate" do
      # PascalCase name of the aggregate holding the reference_to
      # declaration (e.g. "Notification" referencing a "Plan").
      attribute :value, String
      invariant("must be non-empty") { !value.to_s.empty? }
    end

    value_object "ToAggregate" do
      # PascalCase name of the referenced aggregate.
      attribute :value, String
      invariant("must be non-empty") { !value.to_s.empty? }
    end

    value_object "Resolution" do
      # R2 inherits heki's :singleton resolution — reference_to(Plan)
      # means "the plan" (the one singleton object), not "plan id X".
      attribute :value, String
      invariant("must be 'singleton'") { value == "singleton" }
    end

    attribute :from_aggregate, FromAggregate
    attribute :to_aggregate,   ToAggregate
    attribute :resolution,     Resolution

    command "ResolveReference" do
      role "System"
      goal "Resolve reference_to by finding the singleton object in the target aggregate's R2 location"

      attribute :from_aggregate, FromAggregate
      attribute :to_aggregate,   ToAggregate

      sets :from_aggregate
      sets :to_aggregate
      sets :resolution,     to: "singleton"

      emits "ReferenceResolved"
    end
  end

  # Every aggregate gets bound on boot — same lifecycle hook as heki.
  policy "BindOnBoot" do
    on "InterpreterBooted"
    trigger Binding::BindAggregate
  end

  # References resolve as singletons — no object keys in the bluebook.
  policy "ResolveOnDispatch" do
    on "CommandExecuted"
    trigger Reference::ResolveReference
  end
end
