# THE LANGUAGE IS A DOMAIN LIKE ANY OTHER, and this is the line that
# says so. `lib/hecksagain/language/bluebook/` describes what a bluebook
# IS — nine files, one chapter — and until MetaValidator.defer existed it
# could not be booted the ordinary way at all: each file was judged
# before its siblings had been read, so Aggregate's reference to Bluebook
# dangled and the load refused. It boots now, which means it can also be
# fuzzed, model-checked and inspected exactly like banking or pizzas.
#
# Memory because this chapter is read, never written to a store — nothing
# dispatches a command against the language in production. A binding
# still has to be DECLARED rather than defaulted, so that what answers is
# a stated fact rather than whatever the runtime happened to fall back on.
Hecks.hecksagon "Bluebook" do
  # Several constructs here declare `role "Language"` (Aggregate.Declare,
  # Entity.Declare, ...) — only real access control once Governance can
  # check it against something (S8).
  uses_framework "Governance"
  persisted_by "Memory"
end

Hecks.hecksagon "Governance" do
  Governance::RoleAssignment.persisted_by("Memory")
  Governance::RoleTransition.persisted_by("Memory")
end
